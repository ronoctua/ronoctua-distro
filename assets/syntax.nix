    {
      id = "rust";
      label = "Rust";
      kind = "code";
      mime = [ "text/rust" ];
      tags = [
        "rust"
        "rs"
      ];
      guessable = true;
      shebang = [ ];
      # A STRONG MARKER — something that almost only appears here. Counting
      # common words would have `if` deciding between six candidates.
      sniff = [
        "fn "
        "impl "
        "pub fn"
        "let mut "
        "#[derive"
      ];
      sniff-shape = "none";

      line-comment = [ "//" ];
      block-comment = {
        open = "/*";
        close = "*/";
        nests = true;
      };
      strings = [
        {
          open = "\"";
          close = "\"";
          escape = "\\";
          spans-lines = true;
          hashes = false;
          max = null;
        }
        # A CHARACTER, and `max` is what stops `&'a str` from opening a string
        # that never closes and painting the rest of the file one colour.
        {
          open = "'";
          close = "'";
          escape = "\\";
          spans-lines = false;
          hashes = false;
          max = 4;
        }
        # `r` AND NOT `r"`: with `hashes`, the marker is what comes BEFORE
        # them and the quote has to follow. `r#"a"b"#` closes at the outer
        # `"#`, and reading the hashes after the whole opener made it close at
        # the inner quote instead.
        {
          open = "r";
          close = "\"";
          escape = "";
          spans-lines = true;
          hashes = true;
          max = null;
        }
        {
          open = "b\"";
          close = "\"";
          escape = "\\";
          spans-lines = true;
          hashes = false;
          max = null;
        }
      ];
      interpolation = [ ];
      attribute = {
        prefix = "#[";
        close = "]";
      };
      numbers = "c";
      property = "none";
      shapes = [
        "capitalised-is-type"
        "screaming-is-constant"
