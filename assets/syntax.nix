      # `text/x-markdown` is an alias, and the alias table hands it over.
      mime = [
        "text/markdown"
        "text/x-rst"
        "text/org"
      ];
      tags = [
        "markdown"
        "md"
      ];
      # NEVER GUESSED. A markdown file is mostly prose, and colouring prose is
      # worse than not colouring: guessing it from content would paint an essay.
      guessable = false;
      shebang = [ ];
      sniff = [ ];
      sniff-shape = "none";
      line-comment = [ ];
      block-comment = {
        open = "<!--";
        close = "-->";
        nests = false;
      };
      strings = [
        {
          open = "`";
          close = "`";
          escape = "";
          spans-lines = false;
          hashes = false;
          max = null;
        }
      ];
      # THE TWO FENCES, and the state carries which one opened so a `~~~` does
      # not close a ``` block.
      fences = [
        "```"
        "~~~"
      ];
      interpolation = [ ];
      attribute = null;
      numbers = "none";
      property = "colon";
      shapes = [ ];
      call = false;
      keywords = [ ];
      types = [ ];
      constants = [ ];
    }

    {
      id = "diff";
      label = "Diff";
      kind = "diff";
      # `text/x-diff` is an alias of this one.
      mime = [ "text/x-patch" ];
      tags = [
        "diff"
        "patch"
      ];
      guessable = true;
      shebang = [ ];
      sniff = [
        "diff --git "
        "@@ -"
        "--- a/"
      ];
      sniff-shape = "none";
      line-comment = [ ];
      block-comment = null;
      strings = [ ];
      interpolation = [ ];
      attribute = null;
      numbers = "none";
      property = "none";
      shapes = [ ];
      call = false;
      fences = [ ];
      keywords = [ ];
      types = [ ];
      constants = [ ];
    }
  ];
}
