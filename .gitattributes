# ronoctua-distro — .gitattributes
#
# THE FONT FILES ARE NOT HERE, and never were: they are 4.1 GB of build output,
# published as assets of a Release of this repository and fetched by the flake,
# pinned by hash. So this repository is a few hundred KB and needs no LFS.

# --- end-of-line normalisation ----------------------------------------------
* text=auto eol=lf

# --- binaries that do not go to LFS (small, but not text) -------------------
*.png   binary
*.jpg   binary
*.webp  binary
*.ico   binary
*.wasm  binary
*.cwasm binary
*.fst   binary
*.bin   binary

# --- the VT corpus: THE CRLF IS THE TEST ------------------------------------
#
# `* text=auto eol=lf` would normalise these files on the first `git add`, and
# `02-crlf.vt` would stop containing a CR — the fixture would go on existing,
# would start testing something else, and nothing would report it. Five of the
# fixtures depend on this. `-text` turns off all normalisation for them.
tests/corpus-vt/*.vt  -text

# --- lockfiles: no auto-merge, no noisy diff --------------------------------
flake.lock  -diff merge=binary linguist-generated
Cargo.lock  -diff linguist-generated

# --- generated: out of the host's language statistics -----------------------
crates/ronoctua-tokens/src/generated/**  linguist-generated
crates/ronoctua-glyphdb/data/**          linguist-generated
