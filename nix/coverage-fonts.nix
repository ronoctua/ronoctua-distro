# The faces the renderer falls back to — section 6.4, the renderer's half.
#
# # Why they are not embedded like the other four
#
# Because they are 43 files and forty-odd megabytes, and the four in
# `crates/ronoctua-render/src/text.rs` are there by `include_bytes!`. Embedding
# these would put them in the binary, in every copy of it, and — worse — in the
# ENVIRONMENT of the derivation that compiles the workspace, where a store path
# is an input and any change to it rebuilds all thirty-three crates. That is the
# fourth incident in `docs/ARCHITECTURE.md`, and the answer it settled on is the
# one used here: the path travels on the WRAPPER, and the binary reads it at run
# time.
#
# # Why absence is not an error
#
# The installer and the rescue console run with the four embedded faces and no
# store to speak of. They draw our two languages, both Latin, and a chain they
# cannot reach is not a failure there — it is a machine that has not been
# installed yet. `Text::coverage` reports how many arrived so a screen can say
# so, which is the difference between a degraded interface and a silent one.
{
  lib,
  stdenvNoCC,
  python3,
  # The chain, generated by `nix/fontconfig.nix`. It is the ONE declaration:
  # fontconfig's generics, the per-script table, the Han unification and the
  # common tail all come out of that file, and `coverage` is derived from them.
  chainJson,
  # Where to look. Order does not matter — a family is claimed by whichever
  # file has it, and a file that answers for several is copied once.
  noto-fonts,
  noto-fonts-cjk-sans,
  noto-fonts-color-emoji,
}:

let
  py = python3.withPackages (ps: [ ps.fonttools ]);
in
stdenvNoCC.mkDerivation {
  name = "ronoctua-coverage-fonts";
  nativeBuildInputs = [ py ];
  dontUnpack = true;
  dontConfigure = true;

  buildPhase = ''
    runHook preBuild
    python3 ${./scripts/collect-coverage-fonts.py} \
      --chain-json ${chainJson} \
      --from ${noto-fonts}/share/fonts \
      --from ${noto-fonts-cjk-sans}/share/fonts \
      --from ${noto-fonts-color-emoji}/share/fonts \
      --out $out
    runHook postBuild
  '';

  dontInstall = true;

  meta = {
    description = "The faces the renderer's declared fallback chain names, one file each";
    platforms = lib.platforms.all;
  };
}
