# `libghostty-vt` — the terminal engine, built from a PINNED TAG.
#
# # A tag, as `AGENTS.md` asks — and the commit that came before it
#
# It was a commit (`53be7d03`, 2026-08-14) against the rule, because the last
# tag then, `v1.3.1`, carried nine headers and no `screen.h`: the screen could
# not cross the boundary. `v1.4.0` (2026-10-27) carries the whole C API the
# native terminal stands on — the render state with its dirty rows, the key,
# mouse, focus and paste encoders, kitty graphics, snapshots, `search.h`, and
# the program-status protocol (OSC 7501) that Claude Code speaks — so the pin
# is a tag again, and changes only when somebody edits this file.
#
# Upstream still marks the API "work-in-progress" and announces one more ABI
# break before a libghostty 1.0: the layouts the binding relies on are probed
# against a C compiler (`ghostty-layout-matches-c`), so a break fails with a
# number instead of a blank screen.
#
# # Why not `pkgs.ghostty`
#
# Its outputs are `out`, `man`, `shell_integration`, `terminfo` and `vim` — no
# `dev`, no library.
{
  lib,
  stdenv,
  fetchFromGitHub,
  fetchgit,
  fetchurl,
  fetchzip,
  runCommand,
  zstd,
  # 0.17.0: the pinned tag declares `minimum_zig_version = "0.17.0"` in its
  # `build.zig.zon`, and an older Zig refuses the file before compiling a line.
  zig,
}:

let
  version = "1.4.0";
  src = fetchFromGitHub {
    owner = "ghostty-org";
    repo = "ghostty";
    tag = "v${version}";
    hash = "sha256-ywmIjwix0P5TC8kD/zTmt82CNrLXMFETaWZj0NirpoM=";
  };

  # THE ZIG PACKAGES, each fetched by Nix by the hash Zig knows it by.
  #
  # It was a fixed-output derivation running `zig build --fetch=all` with the
  # network, and under Zig 0.17 that stopped being reproducible: the global
  # cache it captured also holds the build runner Zig compiles to read
  # `build.zig` (`b/`, `h/`, `o/`, `z/`), different bytes on every run —
  # two fetches of one tag hashed differently. Upstream ships the answer
  # with the tag: `build.zig.zon.nix`, generated by zon2nix, one `fetchurl`
  # or `fetchgit` per package and no network inside a build.
  #
  # KEPT HERE AS A COPY, and not imported out of `src`: importing a file out
  # of a fetched tree is import-from-derivation, which evaluation would have
  # to build to read. The copy is the upstream file as `nix fmt` writes it,
  # and `ghostty-vt-packages-are-upstreams` holds it to the pinned tag's:
  # moving the tag without regenerating it fails there, not in a build.
  #
  # IMPORTED, AND NOT CALLED: the file takes a `linkFarm ? null` it ignores,
  # and `callPackage` would fill it from pkgs (`callpackage-fills-no-default`).
  # Every argument it uses is handed here by name.
  zigPackages = import ./ghostty-vt-zig-packages.nix {
    inherit
      lib
      fetchgit
      fetchurl
      fetchzip
      runCommand
      zstd
      ;
    zig_0_17 = zig;
    name = "ghostty-vt-zig-packages-${version}";
  };
in
stdenv.mkDerivation {
  pname = "libghostty-vt";
  inherit version;
  inherit src;

  nativeBuildInputs = [ zig ];
  dontConfigure = true;

  # `-j"$NIX_BUILD_CORES"`, AND NOT ZIG'S DEFAULT: `zig build` runs a step
  # per processor whatever Nix gave it, so at one core it peaked at 2365 MiB
  # (its processes' `VmRSS` summed, 2026-10-19) — past the slot
  # `nix/build-sizing.nix` plans a derivation that is no unit at
  # (`peakMiB`, 1792); with the cores it was given, 1488 MiB, in 99 s
  # against 53.
  buildPhase = ''
    runHook preBuild
    # A cache of its own to compile the build runner into; the packages come
    # from the store (`--system`), never from the network.
    export ZIG_GLOBAL_CACHE_DIR="$TMPDIR/zig-cache"

    # ONLY the VT library, through the option upstream wrote for exactly this:
    # `-Demit-lib-vt` "sets defaults for a libghostty-vt-only build (disables
    # xcframework, macOS app, and docs)". Building all of Ghostty would drag in
    # GTK, the renderer and the application — none of which this needs, and each
    # of which is another way for the build to break for a reason that has
    # nothing to do with the terminal engine.
    #
    # There is NO `lib-vt` STEP, and looking for one costs a build: the library
    # is installed by the DEFAULT step, and the only `lib-vt` name in `build.zig`
    # belongs to `test-lib-vt`.
    # THE TARGET IS ZIG'S TRIPLE, not Nix's. `stdenv.hostPlatform.config` gives
    # `x86_64-unknown-linux-gnu`, and Zig reads the middle field as the OS —
    # answering `unknown OS: 'unknown'`, which sounds like a broken toolchain and
    # is only a spelling difference.
    zig build -j"$NIX_BUILD_CORES" \
      -Doptimize=ReleaseFast \
      -Dtarget=${
        {
          "x86_64-linux" = "x86_64-linux-gnu";
          "aarch64-linux" = "aarch64-linux-gnu";
        }
        .${stdenv.hostPlatform.system}
      } \
      -Demit-lib-vt=true \
      --system ${zigPackages} \
      --prefix "$out"
    runHook postBuild
  '';

  # The build installs into `--prefix` itself; an install phase would copy twice.
  dontInstall = true;

  # THE STATIC LIBRARY GOES, AND IT IS NOT HOUSEKEEPING: it is 1,70 GiB of
  # closure on every machine.
  #
  # `libghostty-vt.a` is the ONLY file in this output that names a Zig store
  # path (checked by grepping the whole tree), and a reference to Zig drags
  # `clang-lib` (0,79 GiB) and `llvm-lib` (0,53 GiB) with it. Since
  # `crates/ronoctua-term/build.rs` asks for `dylib=ghostty-vt`, the archive was
  # never linked against — it was paying for a compiler nobody runs.
  #
  # Deleting it rather than rewriting the paths with `remove-references-to`: a
  # static archive whose references have been blanked links, and then fails
  # somewhere else. Absent, it fails at the link line, which is the truth.
  postFixup = ''
    rm -f "$out/lib/libghostty-vt.a"
  '';

  passthru = { inherit zigPackages; };

  meta = {
    description = "Ghostty's terminal engine, the VT library alone";
    homepage = "https://github.com/ghostty-org/ghostty";
    license = lib.licenses.mit;
    platforms = lib.platforms.linux;
  };
}
