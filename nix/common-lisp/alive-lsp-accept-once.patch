-(defun listen-for-conns (server log port)
+;; ACCEPT-ONCE: the listener closes after the first client is accepted, and
+;; the server lives as long as that client's session. One editor behind a
+;; bridge is then the only client there can ever be.
+(defun listen-for-conns (server log port accept-once)
     (let ((socket (usocket:socket-listen "127.0.0.1" port :reuse-address T)))
         (format T "[~A][STARTING] Started on port ~A~%" (alive/utils:get-timestamp) (usocket:get-local-port socket))
 
