# Git hooks generated by Nix — section 8 of the prompt.
#
# "Git hooks (fmt, clippy) generated by Nix, **ready for when I
# initialise the repository**."
#
# # Why they are GENERATED and not installed
#
# Invariant 2 forbids initialising the repository: `.git` does not exist, and
# creating a hooks directory inside a repository that does not exist would be
# precisely "something imperative" (invariant 6).
#
# So Nix produces the hooks as a derivation, and `nix/devshell.nix` links them
# into `.git/hooks` **if and when** there is a `.git`. Until then they exist,
# they are built by `nix flake check`, and they do nothing.
#
# # Why the whole `nix flake check` does not work as a pre-commit
#
# It brings up VMs. A pre-commit that takes minutes is a pre-commit the person
# switches off the third time — and then there is no hook at all. Here only the two
# fast verifications section 8 names are run.
{
  lib,
  writeShellApplication,
  runCommand,
}:

let
  pre-commit = writeShellApplication {
    name = "ronoctua-pre-commit";
    # No `runtimeInputs`: the hook runs in the environment of whoever commits, and it is
    # their `nix` that knows how to find this flake's formatter and clippy.
    text = ''
      root_dir=$(git rev-parse --show-toplevel)
      cd "$root_dir"

      echo "pre-commit: formatting…"
      # `--check` covers both languages: the `.nix` files, the workspace and
      # the five buffer workspaces. And the message names the command that
      # WORKS — it used to say `nix fmt`, which until now hung reading stdin.
      # The formatter became a wrapper; the trap no longer exists.
      if ! nix fmt -- --check . >/dev/null 2>&1; then
        echo "ERROR: a file is out of format. Run: nix fmt" >&2
        exit 1
      fi

      echo "pre-commit: clippy…"
      if ! nix build .#checks."$(nix eval --raw --impure \
            --expr 'builtins.currentSystem')".rust-clippy --no-link 2>&1 | tail -20; then
        echo "ERROR: clippy complained. Fix it before committing." >&2
        exit 1
      fi

      echo "pre-commit: ok"
    '';
  };
  # NO AGENT SIGNS A COMMIT — the owner's rule (AGENTS.md, "Como trabalhar").
  # Tools that write commits add a trailer or a footer naming themselves, and
  # the rule has to hold whatever a tool's own instructions say, so it is
  # checked here, on the message itself.
  #
  # ONLY THE TRAILER BLOCK — the last paragraph, where git and every tool put
  # them. The first form looked at the whole message and refused the commit
  # that introduced it, whose body said what the rule forbids: a message is
  # allowed to talk about a signature, only not to carry one. And in that
  # paragraph only a line that STARTS as one (after an emoji, say), never a
  # sentence that mentions the words. Lines git strips (`#`) are skipped.
  commit-msg = writeShellApplication {
    name = "ronoctua-commit-msg";
    text = ''
      message=$1
      trailers=$(grep -v '^#' "$message" | awk '
        /^[[:space:]]*$/ { gap = 1; next }
        { if (gap) { block = ""; gap = 0 } ; block = block $0 "\n" }
        END { printf "%s", block }')
      if printf '%s' "$trailers" \
        | grep -qiE '^(co-authored-by|generated-by):|^[^[:alnum:]]*generated with'; then
        echo "ERROR: the message carries an agent's signature (Co-Authored-By, Generated with)." >&2
        echo "       Commits here carry none — AGENTS.md, \"Como trabalhar\". Take the line out." >&2
        exit 1
      fi
    '';
  };
in
runCommand "ronoctua-git-hooks" { } ''
  mkdir -p $out/hooks
  ln -s ${pre-commit}/bin/ronoctua-pre-commit $out/hooks/pre-commit
  ln -s ${commit-msg}/bin/ronoctua-commit-msg $out/hooks/commit-msg
''
