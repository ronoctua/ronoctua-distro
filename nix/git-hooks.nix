# Git hooks generated by Nix — section 8 of the prompt.
#
# "Git hooks (fmt, clippy) generated by Nix, **ready for when I
# initialise the repository**."
#
# # Why they are GENERATED and not installed
#
# Invariant 2 forbids initialising the repository: `.git` does not exist, and
# creating a hooks directory inside a repository that does not exist would be
# precisely "something imperative" (invariant 6).
#
# So Nix produces the hooks as a derivation, and `nix/devshell.nix` links them
# into `.git/hooks` **if and when** there is a `.git`. Until then they exist,
# they are built by `nix flake check`, and they do nothing.
#
# # Why the whole `nix flake check` does not work as a pre-commit
#
# It brings up VMs. A pre-commit that takes minutes is a pre-commit the person
# switches off the third time — and then there is no hook at all. Here only the two
# fast verifications section 8 names are run.
{
  lib,
  writeShellApplication,
  runCommand,
}:

let
  pre-commit = writeShellApplication {
    name = "ronoctua-pre-commit";
    # No `runtimeInputs`: the hook runs in the environment of whoever commits, and it is
    # their `nix` that knows how to find this flake's formatter and clippy.
    text = ''
      root_dir=$(git rev-parse --show-toplevel)
      cd "$root_dir"

      echo "pre-commit: formatacao…"
      if ! nix fmt -- --check . >/dev/null 2>&1; then
        echo "ERRO: ha arquivo fora de formato. Rode: nix fmt" >&2
        exit 1
      fi

      echo "pre-commit: clippy…"
      if ! nix build .#checks."$(nix eval --raw --impure \
            --expr 'builtins.currentSystem')".rust-clippy --no-link 2>&1 | tail -20; then
        echo "ERRO: o clippy reclamou. Corrija prior de commitar." >&2
        exit 1
      fi

      echo "pre-commit: ok"
    '';
  };
in
runCommand "ronoctua-git-hooks" { } ''
  mkdir -p $out/hooks
  ln -s ${pre-commit}/bin/ronoctua-pre-commit $out/hooks/pre-commit
''
