# `nix run .#dev` — the nested loop (section 7.12, speed 1).
#
# "Nested compositor — Niri as a window inside the host session (`Mod` becomes
# `Alt` in this mode). **90% of the shell/UI work happens here.**"
#
# It does not bring up a VM and does not rebuild the system: it is the real Niri
# running as a window, with our footer inside it. It is the difference between
# iterating in seconds and iterating in minutes, and section 15 puts the
# feedback loop as principle no. 1.
{
  lib,
  callPackage,
  gnused,
  runCommand,
  writeText,
  writeShellApplication,
  niri,
  xwayland-satellite,
  ronoctua-shell,
  fonts,
  noto-fonts-color-emoji,
  lucideFontFile,
  primaryFontFile,
  fontconfigConf,
  iconSuperpack,
  graphicsHost,
  reloadApp,
  singleFooter,
  rustToolchain,
  tokensRs,
  i18nRs,
  niriActions,
}:

let
  # The chords, generated from the shell's command table — the same ones as in
  # production, only with a different prefix.
  binds = callPackage ./niri-binds.nix { inherit ronoctua-shell; };

  # The colours come from the TOKENS, as in nix/modules/niri.nix — see the
  # comment over there. Here they matter twice over: the nested loop is where one
  # LOOKS at the screen, and a colour different from production's would make the
  # working loop validate something nobody is going to see.
  tokens = import ../assets/tokens/colors.nix;
  # The SAME layout as production: the nested loop is where one types to test, and
  # a different keyboard here would be testing something else.
  keyboard = import ./keyboard-xkb.nix;
  hex = t: "#" + lib.substring 2 6 t;

  # The embedded face, for hot reload's `cargo build` — the same path
  # `nix/rust.nix` uses, otherwise the recompiled binary would diverge from the
  # store's. The face embedded in the binary (see ronoctua-render): the installer
  # runs on a TTY before any GPU exists, and a minimal environment may not have
  # share/fonts mounted.
  #
  # It is the Iosevka WITHOUT the 75 codepoints whose default presentation is
  # emoji: the primary face wins the fallback chain, and with them it drew `UP!`
  # in monochrome next to a coloured `ATM`. See `nix/primary-font.nix`.
  regularFont = primaryFontFile;
  # THE EMOJI FACE, embedded alongside the Iosevka.
  #
  # The Iosevka draws 75 of the 1,184 single-codepoint emoji (6%), and none of the
  # 2,760 sequences — the rest would come out as tofu. This face is the only thing
  # on screen with colour outside the tokens, and the reason is that emoji are
  # CONTENT, like the clipboard's image preview, and not chrome.
  #
  # CBDT/CBLC bitmaps, which is the format `swash` decodes; `glyphon` already
  # has a separate colour atlas for it. See `crates/ronoctua-render/src/text.rs`.
  emojiFont = "${noto-fonts-color-emoji}/share/fonts/noto/NotoColorEmoji.ttf";
  # THE LUCIDE FACE, generated by `lucidegen.nix` rather than taken from a package.
  #
  # It is the Lucide font with its `cmap` REWRITTEN: the source codepoints
  # (`U+E038..U+E6BB`) collide with 634 of the Nerd Fonts ones inside the Iosevka,
  # and the primary face wins the fallback chain — the icons would come out drawn
  # as some other symbol, with no tofu to give it away. See `nix/lucidegen.nix`.
  lucideFont = lucideFontFile;

  # niri's config for nested mode.
  #
  # The DIFFERENCE from production is deliberate and small: no session
  # `spawn-at-startup`, and the leader becomes `Alt` because `Mod` belongs to the
  # HOST compositor when running nested — pressing `Mod` out there would not
  # reach in here.
  # THE CONFIG AS A DERIVATION, and not assembled by the script at run time.
  #
  # It used to be a heredoc + `sed` inside `ronoctua-dev`: assembled only at run
  # time, and for that reason NOTHING validated it. A `duplicate keybind` sailed
  # through the whole `nix flake check` and only showed up as a red box on screen —
  # with niri falling back to ITS OWN default config, that is, with no leader at all.
  #
  # As a derivation, it is a file `niri validate` can reach — see the
  # `niri-config-valid` check.
  nestedConfigText = ''
        // GENERATED by nix/dev.nix — ONLY for the nested loop.
        // The production config is in nix/modules/niri.nix.

        prefer-no-csd

        input {
            keyboard {
                xkb {
                    layout "${keyboard.layout}"
                    variant "${keyboard.variant}"
                    options "${keyboard.options}"
                }
            }
            touchpad { tap; natural-scroll; }
        }

        layout {
            // See the equivalent comment in nix/modules/niri.nix: with no
            // focus border, two open windows are indistinguishable.
            gaps 8
            border {
                width 2
                active-color "${hex tokens.state.accent}"
                inactive-color "${hex tokens.border.inactive}"
            }
            focus-ring { off; }
            // No shadow, no elevation, zero radius (invariant 15).
            shadow { off; }
            background-color "${hex tokens.surface.base}"
        }

        // The nested niri's window. A size that shows the two-line footer
        // comfortably without taking over the host's whole screen.
        output "winit" {
            mode "1600x900"
            scale 1
        }

        layer-rule {
            match namespace="^ronoctua-footer$"
            opacity 1.0
        }

        // THE SCREEN'S CORNERS DO NOTHING.
        //
        // The bottom-left corner used to open the workspace overview on hover.
        // That is hidden chrome: an action that fires with nobody asking, in a
        // place the cursor reaches in passing — dragging a window to the edge,
        // or just taking a hand off the keyboard.
        //
        // The overview is still reachable through `LEADER TAB TAB` and through
        // the locator, which are the two paths §13 asks for.
        gestures {
            hot-corners {
                off
            }
        }

        hotkey-overlay { skip-at-startup; }

        // THE FOOTER DOES NOT COME UP THROUGH `spawn-at-startup`.
        //
        // Two reasons, and both hurt: niri sends the output of what it spawns
        // to /dev/null (so the footer's log simply vanished), and there is no
        // way to restart it without restarting the compositor — which is
        // exactly what hot reload has to do. What brings it up is the script,
        // just below.

        binds {
            // ONE HAND-WRITTEN BIND — see the comment in nix/modules/niri.nix.
            // `Alt`, not `Mod`: in the nested loop `Mod` belongs to the host's
            // compositor.
            //
            // `Alt+Shift+E` is gone: leaving the session is `LEADER q q`, like
            // everything else. An emergency shortcut that exists only in the
            // nested loop would be a third table to remember.
            //
            // `repeat=false`: without it, HOLDING Alt+Space re-fires the bind at
            // the keyboard's repeat rate, and every fire reopens the sequence.
            // That is what made the list "keep showing up" with the key held.
            // What cannot be fixed here is the list appearing on the FIRST
            // fire: niri fires on key DOWN, and pressing Space with Alt held IS
            // the trigger. What tells a tap from a hold in production is keyd,
            // and it does not exist on the host — see docs/ARCHITECTURE.md. In
            // the nested loop, the chord is `Alt` ON ITS OWN.
            Alt+Space repeat=false { spawn "${ronoctua-shell}/bin/ronoctua-shell" "leader"; }
    @CHORDS@
        }
  '';
  # The finished file: the static one with the chords in place of the marker.
  #
  # The `grep` at the end is the safety net against a `sed` that does not match:
  # without it, a renamed marker would give a config WITHOUT chords and the
  # symptom would be "the keys stopped working", with no error anywhere.
  nestedConfig = runCommand "ronoctua-niri-nested.kdl" { } ''
    cp ${writeText "niri-nested-static.kdl" nestedConfigText} $out
    chmod +w $out
    ${gnused}/bin/sed -i -e "/@CHORDS@/r ${binds.forPrefix "Alt"}" -e "/@CHORDS@/d" $out
    grep -q "focus-column-left" $out || {
      echo "ERRO: os acordes nao entraram no config aninhado." >&2; exit 1; }
  '';
  app = writeShellApplication {
    name = "ronoctua-dev";

    runtimeInputs = [
      niri
      # niri tries to start ITS satellite at startup and warns if it does not find it.
      # That is compositor integration, distinct from the per-buffer-scope satellite
      # the footer spawns (section 9.1) — but the warning shows up in the project's
      # most-run command, and a warning that always shows up stops being read.
      xwayland-satellite
      # `cargo` for hot reload. It comes from the SAME toolchain `nix/rust.nix`
      # uses: a different `cargo` would rebuild the world on every switch
      # between `nix run .#dev` and `nix flake check`.
      rustToolchain
    ];

    text = ''
      echo "ronoctua-dev — niri aninhado + rodape"
      echo

      ${graphicsHost.prelude}

      # THE CONFIG ARRIVES READY AND VALIDATED — see this file's `let`.
      cfg=${nestedConfig}

      # The renderer does NOT use fontconfig (section 6.4), but the foreign apps that
      # run in here do — and they must see the SAME chain as the system.
      # THE COMPLETE FILE, and not the fragment.
      #
      # `FONTCONFIG_FILE` replaces the ENTIRE configuration. Pointing it at the
      # fragment — only the alias rules, with no `<dir>` at all — left fontconfig
      # with no font directory, and everything that goes through it turned into
      # TOFU: niri's error message came out in little boxes, precisely the one that
      # says what is wrong.
      export FONTCONFIG_FILE="${fontconfigConf.fullConf}"
      export XDG_DATA_DIRS="${fonts.noctua-iosevka-ttf-nerdfonts}/share:${iconSuperpack}/share:''${XDG_DATA_DIRS:-/usr/share}"
      export XDG_ICON_THEME=noctua

      # THE LEADER'S LABEL comes from the SAME place as the bind, just above: in the
      # nested loop the key is `Alt+Space`, because `Mod` belongs to the host's
      # compositor. The screen said `SPC` in both modes, and `SPC` is nobody's key
      # here.
      export RONOCTUA_LEADER="ALT SPC"
      # AND THE CHORD'S LABEL, which in the nested loop is NOT the same.
      #
      # The sequence starts with `Alt+Space`; the chord is `Alt` alone, held.
      # While the screen called both of them "the leader", holding "the leader" looked
      # like it included Space — and including Space fires the sequence. In production
      # both are `SUPER` and the distinction disappears; here it has to show.
      export RONOCTUA_LEADER_CHORD="ALT"

      # Useful logging by default; `RUST_LOG` from the environment wins.
      #
      # It is NOT exported: niri uses the SAME `EnvFilter`, and a filter that only
      # names our targets leaves it mute. It passes it to the footer when starting it.
      rustlog="''${RUST_LOG:-ronoctua_shell=debug,ronoctua_render=info}"
      # And the compositor gets its own, explicitly, so the log stays useful.
      export RUST_LOG=niri=info

      echo "  Alt+Space      leader (toque: abre a lista)"
      echo "  Alt+<tecla>    acorde (SEGURADO: o Alt sozinho, sem o Espaco)"
      echo "  Ctrl+Alt+L     leader alternativa, se a de cima falhar"
      echo "  Ctrl+Shift+L   restaura o teclado"
      echo "  Alt+Space q q  sair"
      echo
      echo "config: $cfg"
      echo

      # ------------------------------------------------------------------
      # Compositor
      # ------------------------------------------------------------------
      # In the background, and not `exec`: the script stays up to supervise
      # the footer and the watcher.
      niri_log=$(mktemp -t ronoctua-niri-XXXXXX.log)
      niri --config "$cfg" > "$niri_log" 2>&1 &
      niri_pid=$!
      tail -f -n +1 "$niri_log" & tailpid=$!

      # THE FOOTER'S PID LIVES IN A FILE, and not in a variable.
      #
      # Whoever starts it and whoever restarts it are different processes: this
      # script starts, hot reload's watcher restarts. A shell variable does not
      # cross a process boundary — and when it failed to, hot reload stopped
      # working in silence. See `nix/footer-single.nix`.
      export RONOCTUA_FOOTER_PID
      RONOCTUA_FOOTER_PID=$(mktemp -t ronoctua-footer-XXXXXX.pid)

      # THE FOOTER'S LOG GOES TO A FILE, and not only to the screen.
      #
      # Four times the shortcuts froze, and four times there was no evidence at
      # all: the log was in a terminal that had already been closed, and niri's
      # had the four lines from startup. `tail -f` still puts it on the
      # screen; the file is what survives, and it is what gets sent along with
      # "it happened again". See `nix/footer-single.nix`.
      export RONOCTUA_LOG
      RONOCTUA_LOG=$(mktemp -t ronoctua-footer-XXXXXX.log)
      tail -f -n +1 "$RONOCTUA_LOG" & taillogpid=$!

      watcher_pid=""
      shutdown() {
        [ -n "$watcher_pid" ] && kill "$watcher_pid" 2>/dev/null || true
        if [ -s "$RONOCTUA_FOOTER_PID" ]; then
          kill "$(cat "$RONOCTUA_FOOTER_PID")" 2>/dev/null || true
        fi
        kill "$niri_pid" 2>/dev/null || true
        kill "$tailpid" 2>/dev/null || true
        kill "$taillogpid" 2>/dev/null || true
        # ONLY THE PIDFILE. `$cfg` is a STORE path — immutable, shared by
        # every run and collected by Nix's garbage collector. It ended up on
        # this list back when the config was written to a temporary file; once it
        # came to be generated by Nix, the removal was left behind and became two
        # `Permission denied` messages in the face of whoever closes the session
        # with Ctrl+C.
        #
        # `-f` does not save it: it silences "does not exist", not "is not yours".
        rm -f "$RONOCTUA_FOOTER_PID"
        # THE LOGS STAY. Deleting them in the `trap` was deleting the evidence
        # exactly when it starts to matter — whoever ends the session after
        # something went wrong is the one who needs them most.
        echo "logs desta sessao:"
        echo "  niri:   $niri_log"
        echo "  rodape: $RONOCTUA_LOG"
      }
      # ONCE ONLY. With `trap encerrar EXIT INT TERM`, a Ctrl+C runs
      # `encerrar` through INT and the shell exits right after, running it again
      # through EXIT — that is why every shutdown message came out twice.
      #
      # EXIT is the only one that cleans up; INT and TERM only ask for the exit,
      # with the code convention demands (128 + signal).
      trap shutdown EXIT
      trap 'exit 130' INT
      trap 'exit 143' TERM

      # THE DISPLAY COMES FROM THE IPC SOCKET'S NAME, and not from niri's log.
      #
      # niri names it `niri.<display>.<pid>.sock`, so the pid we have just
      # spawned identifies the socket unambiguously — two niris on the same
      # machine do not get confused, and it does not depend on the directory
      # being quiet.
      #
      # READING THE LOG DOES NOT WORK. The `RUST_LOG` this script exports for the
      # FOOTER also reaches niri, which uses the same `EnvFilter`: with
      # `ronoctua_shell=debug` the compositor comes up perfectly and stays MUTE,
      # the grep never matches, and the message claims "niri did not start" —
      # which is false.
      display=""
      for _ in $(seq 60); do
        # `find` and not `ls`: shellcheck rejects `ls` on a glob (SC2012), and
        # here it happens to be right — `-quit` stops at the first one and does
        # not depend on sort order.
        s=$(find "''${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" -maxdepth 1 \
              -name "niri.*.$niri_pid.sock" -print -quit 2>/dev/null || true)
        if [ -n "$s" ]; then
          niri_sock="$s"
          # `niri.<display>.<pid>.sock` — the display is the middle field.
          display=$(basename "$s" | cut -d. -f2)
          break
        fi
        # If the process died, waiting the full 30 s only delays the error.
        kill -0 "$niri_pid" 2>/dev/null || break
        sleep 0.5
      done
      if [ -z "$display" ]; then
        echo "ERRO: o niri aninhado nao subiu." >&2
        tail -20 "$niri_log" >&2
        exit 1
      fi

      # ------------------------------------------------------------------
      # Footer
      # ------------------------------------------------------------------
      # THE FOOTER'S ENVIRONMENT GOES INTO THE ENVIRONMENT, and not into an `env`
      # at call time. What restarts the footer is the watcher, which is another
      # process: whatever the call needs to know is either exported or does not get there.
      export WAYLAND_DISPLAY="$display"
      export RUST_LOG="$rustlog"
      [ -n "''${niri_sock:-}" ] && export NIRI_SOCKET="$niri_sock"

      # Which binary: the store's until the first recompilation, yours after that.
      # That way startup is instant and does not need `cargo` just to have a look.
      ${singleFooter}/bin/ronoctua-footer-single \
        "$RONOCTUA_FOOTER_PID" "${ronoctua-shell}/bin/ronoctua-shell"

      # ------------------------------------------------------------------
      # Hot reload
      # ------------------------------------------------------------------
      # With `cargo`, and not `nix build`: minutes against seconds. Section 15 puts
      # the feedback loop as principle number 1, and a loop of minutes per
      # edit contradicts that in practice.
      root_dir="$PWD"
      if [ -f "$root_dir/Cargo.toml" ] && [ -d "$root_dir/crates" ]; then
        # OUTSIDE the tree. With `target/` inside, every evaluation of the flake copies
        # gigabytes into the store — it cost 793 GB to find out. See CLAUDE.md.
        export CARGO_TARGET_DIR="''${CARGO_TARGET_DIR:-''${XDG_CACHE_HOME:-$HOME/.cache}/ronoctua-distro/target}"
        mkdir -p "$CARGO_TARGET_DIR"
        export RONOCTUA_TOKENS_RS="${tokensRs}/tokens.rs"
        export RONOCTUA_I18N_DIR="${i18nRs}"
        export RONOCTUA_NIRI_ACTIONS="${niriActions}/niri-actions.rs"
        export RONOCTUA_FONT_REGULAR="${regularFont}"
        export RONOCTUA_FONT_EMOJI="${emojiFont}"
        export RONOCTUA_FONT_LUCIDE="${lucideFont}"
        # THE SUPERPACKAGE, for the app launcher's pixmap step.
        #
        # The `nix build` binary receives it through `nix/rust.nix`; the hot
        # reload one did not, and the symptom was exactly what
        # `apps-icon-from-superpack` exists to catch: the list opened with the
        # category glyphs and they were NEVER replaced by the app's icon.
        # Nothing in the log, nothing on screen — the list looks fine and is wrong.
        export RONOCTUA_ICONS="${iconSuperpack}/share/icons/noctua"

        # THIS FUNCTION RUNS IN ANOTHER PROCESS — the watcher's. It can only read
        # what is EXPORTED; a shell variable does not cross a process boundary, and
        # under the watcher's `set -u` a missing variable does not evaluate to false:
        # it gives `unbound variable`, which takes the whole shell down. That is how
        # hot reload ceased to exist after the first edit, in silence.
        rebuild() {
          echo "  compilando…"
          if cargo build --release -p ronoctua-shell --bin ronoctua-shell 2>&1 | tail -20; then
            ${singleFooter}/bin/ronoctua-footer-single \
              "$RONOCTUA_FOOTER_PID" "$CARGO_TARGET_DIR/release/ronoctua-shell"
            echo "  rodape reiniciado (o compositor continua de pe)"
          else
            echo "  compilacao falhou; o rodape anterior continua rodando"
          fi
        }
        export -f rebuild 2>/dev/null || true

        RONOCTUA_RELOAD_CMD='reconstruir'         ${reloadApp}/bin/ronoctua-reload "$root_dir/crates" "$root_dir/buffers" &
        watcher_pid=$!
        echo "hot reload ligado: editar .rs em crates/ recompila e reinicia o rodape"
      else
        echo "sem hot reload: rode de dentro da arvore do projeto para liga-lo"
      fi
      echo

      wait "$niri_pid"
    '';

    meta = {
      description = "Niri aninhado + rodape, para o loop de trabalho de UI";
      platforms = lib.platforms.linux;
    };
  };
in
# THE APP, with the CONFIG hanging off it.
#
# The `niri-config-valid` check needs the file, and exposing it here is what
# stops the nested config from going back to being assembled only at run time,
# where nothing reaches it — that is how a `duplicate keybind` got through the
# whole `nix flake check` and only showed up as a red box on screen.
app.overrideAttrs (previous: {
  passthru = (previous.passthru or { }) // {
    config = nestedConfig;
  };
})
