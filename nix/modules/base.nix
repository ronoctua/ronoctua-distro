# The distro's base — section 2 (identity) and section 9 (personal data).
#
# Invariant 16: `noctua` and `ronoctua-distro` are defined in ONE place only.
# This is that place.
{
  config,
  lib,
  pkgs,
  ronoctua,
  ...
}:

let
  cfg = config.ronoctua;
in
{
  options.ronoctua = {
    # Section 2: a single user per device, always with this name.
    user = lib.mkOption {
      type = lib.types.str;
      default = "noctua";
      readOnly = true;
      description = "The system's user. Fixed by design (section 2).";
    };

    distroName = lib.mkOption {
      type = lib.types.str;
      default = "ronoctua-distro";
      readOnly = true;
      description = "The distro's name. Fixed by design (section 2).";
    };

    hostnamePrefix = lib.mkOption {
      type = lib.types.str;
      default = "noctua-";
      readOnly = true;
      description = "Hostname pattern (section 2). E.g. noctua-z16.";
    };

    # WHERE THIS MACHINE'S OWN COPY OF THE REPOSITORY IS, when it has one.
    #
    # It is what makes "share this filter with everybody" possible: the shell
    # writes one file under `assets/shared/`, the next build turns it into part
    # of the distro, and the owner's commit publishes it.
    #
    # An OPTION and never a search. A program that goes hunting for a git
    # checkout finds somebody else's, and this one writes into what it finds —
    # so it is told, or it does not offer to share at all. Empty is the default,
    # which is right for every machine that installed this distro rather than
    # building it.
    repo = lib.mkOption {
      type = lib.types.str;
      default = "";
      example = "/home/noctua/ronoctua-distro";
      description = ''
        This machine's checkout of the distro's repository, if it builds from
        one. It is where "share a filter with everybody" writes, and the shell
        only offers that when the path is set and holds a `flake.nix`.
      '';
    };

    # Section 9: the hash NEVER enters the repository. The installer writes it to
    # /persist and this module only points there.
    hashedPasswordFile = lib.mkOption {
      type = lib.types.path;
      default = "/persist/etc/shadow/${cfg.user}";
      description = ''
        Path to the user's password hash, generated by the installer and
        kept in /persist. Section 9: no personal data in the configs.
      '';
    };

    # THE KEYBOARD, with `nix/keyboard-xkb.nix` as the DEFAULT.
    #
    # It used to be that file and nothing else, imported directly by the
    # compositor, by the console and by the nested loop — "the keyboard has ONE
    # place". That is still true of the DEFAULT, and it is the right default: it
    # is the layout of the machine this was written on.
    #
    # What it could not do was answer a different machine. Whoever installed
    # elsewhere typed on a layout that was not theirs, and the worst moment to
    # discover that is while typing the disk's passphrase — which is not echoed
    # and cannot be corrected afterwards.
    #
    # So the file became the default of an option, and the installer's sixth
    # question fills it in. The single place survives: nobody writes a layout
    # anywhere else, they override THIS.
    keyboard =
      let
        base = import ../keyboard-xkb.nix;
        field =
          name: value:
          lib.mkOption {
            type = lib.types.str;
            default = value;
            description = "xkb `${name}`. Default: nix/keyboard-xkb.nix.";
          };
      in
      {
        layout = field "layout" base.layout;
        variant = field "variant" base.variant;
        # THE COMPOSE KEY IS THE ANSWER; `options` IS WHAT XKB GETS.
        #
        # The installer fills in this one, and the other is built from it plus
        # what the system adds either way (`always`, in that same file). They
        # were a single option, and then the seventh question — which asks only
        # about accents — would have quietly taken the Caps Lock toggle away
        # from whoever answered it.
        compose = field "compose" base.compose;
        options = lib.mkOption {
          type = lib.types.str;
          default = builtins.concatStringsSep "," (
            (if config.ronoctua.keyboard.compose == "" then [ ] else [ config.ronoctua.keyboard.compose ])
            ++ base.always
          );
          defaultText = lib.literalMD "the chosen accent key, plus `nix/keyboard-xkb.nix`";
          description = "xkb `options`, complete. Default: derived from `compose`.";
        };
        console = field "console" base.console;
      };

    # THE DEV OPTIONS ARE DECLARED HERE, not in nix/modules/dev.nix.
    #
    # `base.nix` reads `ronoctua.dev.android` to decide `nixpkgs.config`, and a
    # VM test imports base without importing dev — over there the option would
    # not exist and evaluation dies with "attribute 'dev' missing". All the
    # `ronoctua.*` options live in one place anyway (invariant 16).
    dev = {
      android = lib.mkEnableOption "the Android SDK, Studio and Flutter" // {
        default = true;
      };
      androidNdk = lib.mkEnableOption "the NDK (a few GB more; only for native code)";
      toolchains = lib.mkEnableOption "the toolchains: rust, go, python, node, gcc" // {
        default = true;
      };
    };

    # WHICH OF THE TWO INSTALLATIONS THIS MACHINE IS.
    #
    # Declared here for the same reason written just above: what reads the
    # profile is `nix/modules/profile.nix`, which does not import this file.
    #
    # It is an OPTION, and not a second `nixosConfiguration`. The installer
    # still aims at `#noctua` in both cases, `host.nix` gains one line, and
    # changing one's mind later is a `nixos-rebuild` — not a reinstall.
    profile = lib.mkOption {
      type = lib.types.enum [
        "full"
        "minimal"
      ];
      default = "full";
      description = ''
        `full` brings everything (23.2 GiB of closure, measured) and is the recommended one.

        `minimal` leaves out Android, the compilers, the browser, the
        editor, the media, the font's 27 variants and the icon superpack —
        about 17 GiB. It leaves out nothing of what MAKES the distro: the compositor,
        the footer, the primary font, the keyboard, the network, impermanence and the terminal stay.

        Switching a group back on is one line in `host.nix`: for example
        `ronoctua.browser.enable = true;` to install just the browser.

        The table tying the profile to each key is in `nix/modules/profile.nix`.
      '';
    };

    # THE MACHINE'S TIME ZONE, and who owns it.
    #
    # # Why the default is `null`, which is to say "the person's"
    #
    # Because `LEADER s l` is where somebody looks for it, and for a whole
    # release that screen could change what the INTERFACE draws and nothing
    # about the computer. The owner said so in those words: the settings were
    # incomplete because only the interface's clock, date and zone could be
    # changed.
    #
    # With this `null`, `time.timeZone` is `null` too, NixOS leaves
    # `/etc/localtime` alone, and `systemd-timedated` owns it — which is the
    # escape hatch upstream documents, not a hole. The view then sets the zone
    # of the machine, through the narrow polkit rule below.
    #
    # # And why the option exists at all
    #
    # Because somebody may want it DECLARED — a machine rebuilt from the flake
    # and coming up in one zone whatever anybody typed. Set it, and NixOS
    # starts timedated with `NIXOS_STATIC_TIMEZONE=1`; the daemon then refuses
    # `SetTimezone`, and the row in `LEADER s l` is drawn REFUSING and says
    # where the value comes from. That is the shape the Syncthing view's
    # fourteen flake-owned rows already have, and the Tor view's.
    #
    # It is `time.timeZone` by another name, and it is a second name on purpose:
    # `time.timeZone = null` is the shape of an absence, and an absence cannot
    # carry the reason for itself.
    time.zone = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      example = "Europe/London";
      description = ''
        The machine's time zone, as an IANA name.

        `null` — the default — leaves it to the machine: `systemd-timedated`
        owns `/etc/localtime` and `LEADER s l` can change it, which is where
        somebody looks for it.

        Setting it here pins it in the flake instead. The zone then takes a
        rebuild to change, and the row in `LEADER s l` is drawn refusing and
        says so.
      '';
    };

    # THE THEME THE MACHINE COMES UP IN — the distro's default; the person's
    # own choice (`LEADER s t`) lives in `$XDG_CONFIG_HOME/ronoctua/theme.json`
    # and wins over it. The enum is the list in `assets/themes/themes.nix`,
    # imported once in the flake; naming a theme that is not there fails the
    # evaluation, which is where a typo in `host.nix` should fail.
    #
    # What it decides declaratively: the compositor's static border colours,
    # Ghostty's palette, the browser extension's colours and the environment
    # the footer starts with. Everything that follows the person's choice at
    # runtime is the shell's business.
    theme = lib.mkOption {
      type = lib.types.enum ronoctua.themes;
      default = ronoctua.defaultTheme;
      description = ''
        The colour theme the system is built with. The person can pick another
        at runtime with `LEADER s t`; this is what a fresh machine shows.
      '';
    };
  };

  config = {
    # -----------------------------------------------------------------
    # Identity
    # -----------------------------------------------------------------
    networking.hostName = lib.mkDefault "${cfg.hostnamePrefix}vm";

    assertions = [
      {
        assertion = lib.hasPrefix cfg.hostnamePrefix config.networking.hostName;
        message = ''
          The hostname has to start with "${cfg.hostnamePrefix}" (section 2).
          Currently: "${config.networking.hostName}".
        '';
      }
    ];

    # Section 9: no mutable users. No password in the repository.
    users.mutableUsers = false;
    users.users.${cfg.user} = {
      isNormalUser = true;
      description = "ronoctua";
      extraGroups = [
        "wheel"
        "video"
        "input"
        "audio"
        "networkmanager"
      ];
      # If the file does not exist (dev VM), it falls back to an empty password via
      # nix/modules/vm.nix. In production the installer always writes it.
      hashedPasswordFile = lib.mkDefault cfg.hashedPasswordFile;
    };

    users.users.root.hashedPassword = lib.mkDefault "!"; # root with no login

    # -----------------------------------------------------------------
    # Languages and formats
    # -----------------------------------------------------------------
    #
    # THE DEFAULT IS BRITISH ENGLISH, and the installer offers another. It is a
    # default and not a decision about who installs: `lib.mkDefault` means the
    # generated `host.nix` overrides every line below.
    #
    # WHY `en_GB` AND NOT `en_US`
    #
    # Because a locale is not only a language: it carries date order, decimal
    # separator, paper size and units. `en_US` brings inches, Fahrenheit and
    # Letter along with the English, and this system is used with none of the
    # three.
    i18n = {
      defaultLocale = lib.mkDefault "en_GB.UTF-8";
      # EVERY UI LANGUAGE GETS ITS glibc LOCALE, derived from the one list.
      #
      # These are two different axes and the module's own assertion says so —
      # but they meet here: `Texts::from_env` reads `LANG`, and a UI language
      # whose locale was never generated means `LANG` never carries its name,
      # so the interface falls back to English without a word. Deriving the
      # list is what keeps "declared" and "reachable" the same set.
      #
      # `en_US` is not a UI language and stays by hand: it is here for whoever
      # wants American formats, and `C.UTF-8` for the rescue console.
      supportedLocales =
        (map (l: "${lib.replaceStrings [ "-" ] [ "_" ] l}.UTF-8/UTF-8") (
          import ../../assets/i18n/languages.nix
        ))
        ++ [
          "en_US.UTF-8/UTF-8"
          "C.UTF-8/UTF-8"
        ];
      extraLocaleSettings = {
        LC_MESSAGES = lib.mkDefault "en_GB.UTF-8";
        LC_TIME = lib.mkDefault "en_GB.UTF-8";
        LC_NUMERIC = lib.mkDefault "en_GB.UTF-8";
        # THE METRIC SYSTEM, WHATEVER THE LANGUAGE. `LC_MEASUREMENT` is the only
        # key glibc has for this, and it is NOT `mkDefault`: choosing `en_US` in
        # the installer chooses a language, never inches.
        LC_MEASUREMENT = "en_GB.UTF-8";
        # Paper travels with the units, and for the same reason: A4 is what a
        # printer here takes.
        LC_PAPER = "en_GB.UTF-8";
      };
    };

    # THE ZONE IS THE PERSON'S UNLESS THE FLAKE CLAIMS IT — see
    # `ronoctua.time.zone` above, which carries the whole argument.
    #
    # `null` is what makes `timedatectl set-timezone` work: NixOS only puts
    # `/etc/localtime` in the store when this is a string, and it starts
    # timedated with `NIXOS_STATIC_TIMEZONE=1` when it does. The installer
    # seeds the answer it asked for by writing the symlink on the target, the
    # same way it seeds `~/.shellrc.local` — a file that is born ON the
    # machine, not one the repository carries (invariant 13).
    time.timeZone = cfg.time.zone;

    # AND THE SCREEN IS TOLD, when the flake claims it.
    #
    # `LEADER s l` draws the zone row REFUSING while this is set, and says
    # where the value comes from — the shape the Syncthing view's flake-owned
    # rows have. Without it the row would be offered, the key would reach
    # `timedated`, and the refusal would come back from the bus with the one
    # thing worth saying left out.
    #
    # BOTH PLACES, for `media.nix`'s reason: `sessionVariables` reaches a login
    # shell, and the footer is a systemd USER UNIT, which inherits the
    # manager's environment rather than the shell's.
    # `lib.optionalString` and not `mkIf`: the two attributes below are also
    # set for `playerctl` further down, and a `mkIf` here would be a second
    # definition of the whole set. An EMPTY string is the absence — which is
    # what `locale::zone_is_declared` tests for.
    environment.sessionVariables.RONOCTUA_TIME_ZONE = lib.optionalString (
      cfg.time.zone != null
    ) cfg.time.zone;
    systemd.user.services.ronoctua-footer.environment.RONOCTUA_TIME_ZONE = lib.optionalString (
      cfg.time.zone != null
    ) cfg.time.zone;

    # -----------------------------------------------------------------
    # Nix — section 7.1: everything through flakes, nothing imperative.
    # -----------------------------------------------------------------
    nix.settings = {
      experimental-features = [
        "nix-command"
        "flakes"
      ];
      auto-optimise-store = true;
      trusted-users = [
        "root"
        cfg.user
      ];
    };
    # No `nix.gc` timer: `nix/modules/store.nix` says why, and what does the
    # collecting instead (Nix's own floor, and the update's weekly step).

    # -----------------------------------------------------------------
    # Boot — section 7.2: systemd-boot, not GRUB.
    # -----------------------------------------------------------------
    boot.loader.systemd-boot = {
      enable = lib.mkDefault true;
      # The ESP is 1 GiB (section 7.2) because NixOS keeps kernel+initrd for
      # several generations in there. The cap is `nix/modules/store.nix`'s: the
      # menu lists no more generations than the system keeps.
      editor = false; # an editable cmdline at boot destroys the PCR 12 measurement
    };
    boot.loader.efi.canTouchEfiVariables = lib.mkDefault true;

    # Section 3: the system does not look like a traditional desktop. That starts
    # at boot: no logo, no progress bar.
    boot.plymouth.enable = false;
    boot.kernelParams = [
      "quiet"
      "loglevel=3"
    ];

    # -----------------------------------------------------------------
    # Minimalism — section 3: minimal NixOS.
    # -----------------------------------------------------------------
    documentation.nixos.enable = false;

    security.polkit.enable = true;

    # THE MACHINE'S CLOCK, AND THE THREE THINGS THIS PERSON MAY DO TO IT.
    #
    # # Why a rule is needed at all
    #
    # Because upstream's `org.freedesktop.timedate1.policy` answers
    # `auth_admin_keep` to all four of its actions, and there is no polkit
    # agent in this session — that is the owner's decision and the reason is
    # in `nix/modules/disks.nix`: a fingerprint prompt nobody sees becomes a
    # refusal in a report about something nobody watched. Without this, every
    # call from `LEADER s l` comes back refused, silently, and the screen is
    # drawing switches that cannot move.
    #
    # # And why it is exactly this wide
    #
    # ONE USER, THREE ACTIONS, and the fourth is left where upstream put it.
    # `set-local-rtc` decides whether the hardware clock runs in local time —
    # nothing in this tree asks for it, so granting it would be a door held
    # open for nobody. `ronoctua_clock::timedate::ACTIONS` is the other half
    # of the same list, and `timedate-polkit-is-narrow` reads both and refuses
    # a difference in either direction.
    #
    # `YES` and not `AUTH_SELF_KEEP`, by the rule the update and keyboard
    # rules already follow: nothing this system does on its own may ask.
    security.polkit.extraConfig = ''
      polkit.addRule(function (action, subject) {
        if ((action.id == "org.freedesktop.timedate1.set-ntp" ||
             action.id == "org.freedesktop.timedate1.set-time" ||
             action.id == "org.freedesktop.timedate1.set-timezone") &&
            subject.user == "${cfg.user}") {
          return polkit.Result.YES;
        }
      });
    '';

    security.rtkit.enable = true;
    services.pipewire = {
      enable = true;
      alsa.enable = true;
      pulse.enable = true;
    };

    # THE NETWORK IS NOT HERE. It belongs to `nix/modules/network.nix`, together
    # with the TCP stack tuning and the radio's regulatory domain — leaving the
    # `enable` here and the rest over there would give two places to answer "does
    # this machine use NetworkManager?", and the day they disagreed would be the
    # day the network comes up without the tuning and nobody notices.
    #
    # The user's `networkmanager` group stays in the list above: it belongs to the
    # person's identity, not to the service's configuration.

    environment.systemPackages = with pkgs; [
      git
      jq
      ripgrep
      fd
      # MPRIS: what a media key talks to.
      #
      # IT IS HERE AND NOT UNDER `ronoctua.media.enable` because the keys are
      # bound unconditionally — `actions::media` puts `XF86AudioPlay` and its
      # two neighbours in the compositor's config for every profile — and a key
      # that is bound to a program that is not installed is a key that does
      # nothing. The footer would say so, which is better than silence, but
      # saying "this build has no media player" on a machine that plays media
      # is a poor answer.
      #
      # MEASURED, and it is what made this a base package rather than a
      # sentence: `nix path-info -r` on `playerctl` against the same on
      # `dconf` — which every build already references, through
      # `RONOCTUA_DCONF` — differ by exactly ONE path, `playerctl` itself, at
      # **480.7 KiB**. Everything under it (glib and below) is already there.
      playerctl

      # THE ENCRYPTED VOLUME'S OWN TOOLS.
      #
      # `cryptsetup` was already in the closure and NOT on the PATH, which is
      # a distinction worth keeping straight: systemd pulls the LIBRARY in for
      # `systemd-cryptsetup`, which unlocks the disk at boot, and the `bin`
      # output is a separate one nothing asked for. So a machine that could
      # unlock a volume had no way to open one — no `luksDump` to read a
      # header, no `luksAddKey` to add a second key before travelling, no
      # `benchmark` to find out what this processor costs.
      #
      # `argon2` is the CLI for the KDF LUKS2 actually uses, which is what
      # makes it the companion and not a second tool: `cryptsetup benchmark`
      # says what this machine costs at the default cost, and this says what a
      # given `-t/-m/-p` would cost before it is written into a header. In
      # nixpkgs it lives in `libargon2` — there is no `argon2` attribute to
      # find it by, which is the whole reason the name is written here.
      #
      # MEASURED against the built system, the way `playerctl` above was:
      # cryptsetup's `bin` adds ONE path at 0.45 MiB and argon2 ONE at
      # 0.13 MiB. Everything else in both closures is already here.
      cryptsetup
      libargon2 # `argon2`
    ];

    # AND ITS PATH, for the footer. From the ENVIRONMENT and not baked with
    # `option_env!`: a store path in the compilation is a reference every
    # closure carries, which is the trap the icon superpack and Emacs each paid
    # to learn. `Footer::media` answers with a sentence when it is unset, which
    # is what `nix run .#dev` gets.
    environment.sessionVariables.RONOCTUA_PLAYERCTL = "${pkgs.playerctl}/bin/playerctl";
    systemd.user.services.ronoctua-footer.environment.RONOCTUA_PLAYERCTL =
      "${pkgs.playerctl}/bin/playerctl";

    system.stateVersion = lib.mkDefault "26.05";
  };
}
