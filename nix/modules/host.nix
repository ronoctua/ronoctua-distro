# What the installer fills in about THIS machine — sections 7.1 and 7.2.
#
# The `host.nix` generated by the installer defines three things and nothing
# else: `networking.hostName`, `ronoctua.disk` and `ronoctua.language` (plus
# `resume_offset`, which is NixOS's own `boot.kernelParams`). This module is
# what DECLARES our two options and wires them to disko and to the locale.
#
# # Why they are not in `base.nix`
#
# `base.nix` describes the distro — what holds on every machine. These two
# describe ONE machine, and the difference is the same one that separates the
# publishable repository from the gitignored `host.nix` (section 9).
#
# # Why disko is wired here and not in `disko/default.nix`
#
# That file is the LAYOUT: partitions, subvolumes, mount options. It takes
# `device` as an argument precisely so it does not have to know where the
# value comes from. Tying `config.ronoctua.disk` in there would make the
# layout depend on a NixOS module, and `disko --flake` would no longer be
# able to evaluate it on its own.
{
  config,
  lib,
  inputs,
  ...
}:

let
  cfg = config.ronoctua;
in
{
  imports = [ inputs.disko.nixosModules.disko ];

  options.ronoctua = {
    disk = lib.mkOption {
      type = lib.types.str;
      example = "/dev/nvme0n1";
      description = ''
        O disco INTEIRO desta máquina. O instalador o preenche no
        `host.nix`; o layout da seção 7.2 é aplicado sobre ele.

        Apagar o disco é o primeiro passo destrutivo da instalação — este
        value não tem default de propósito.
      '';
    };

    language = lib.mkOption {
      type = lib.types.enum [
        "pt-BR"
        "en-US"
      ];
      default = "pt-BR";
      description = ''
        Idioma da interface e da locale. Os dois valores são os mesmos do
        `ronoctua-i18n` — um terceiro aqui daria uma locale sem tradução.
      '';
    };

    # THE HARDWARE REPORT, generated ON the machine.
    #
    # `nixos-facter` reads the PCI/USB/DMI tree and writes a JSON that stands in
    # for `hardware-configuration.nix`: video driver, firmware, CPU microcode,
    # touchpad. It is INVENTORY OF THIS MACHINE — serials, board model — and so
    # it lives outside the repository (invariant 13), next to `host.nix`.
    #
    # Optional on purpose: without it the system still builds, and the VM and
    # the ISO have no use for a report about someone else's laptop.
    facterReport = lib.mkOption {
      type = lib.types.nullOr lib.types.path;
      default = null;
      description = ''
        Caminho do `facter.json` desta maquina, gerado por
        `sudo nixos-facter -o ~/facter.json`. Fica FORA do repositorio.
      '';
    };
  };

  config = {
    # `inherit (…) disko`, and not `disko = import …`: the layout file ALREADY
    # returns `{ disko.devices = …; }`. Assigning the whole attrset to `disko`
    # would give `disko.disko.devices` — and the error talks about `disko.disko`,
    # which looks like a typo rather than one level too many.
    inherit (import ../disko/default.nix { device = cfg.disk; }) disko;

    # The locale follows the chosen language: having the interface in pt-BR and
    # `LC_TIME` in English would be half a choice.
    i18n.defaultLocale = "${builtins.replaceStrings [ "-" ] [ "_" ] cfg.language}.UTF-8";

    # The recovery passphrase is ALWAYS enrolled alongside (section 7.2):
    # with no usable TPM, systemd falls back to the prompt instead of not booting.
    boot.initrd.systemd.enable = lib.mkDefault true;

    # The report drives the hardware side when it exists.
    facter.reportPath = lib.mkIf (cfg.facterReport != null) cfg.facterReport;
  };
}
