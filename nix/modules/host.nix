# What the installer fills in about THIS machine — sections 7.1 and 7.2.
#
# The `host.nix` generated by the installer (`plan::host_nix`) says what
# describes ONE machine: `networking.hostName`, `ronoctua.disk`,
# `ronoctua.language`, the locale, the keyboard, the profile, the theme, the
# hardware report, and the swapfile's size and hibernation when the disk caps
# them (plus `resume_offset`, which is NixOS's own `boot.kernelParams`). This
# module DECLARES the options that are about the machine and not the distro,
# and wires them to disko and to the locale.
#
# # Why they are not in `base.nix`
#
# `base.nix` describes the distro — what holds on every machine. These
# describe ONE machine, and the difference is the same one that separates the
# publishable repository from the machine's own `host.nix` (invariant 13).
#
# # Why disko is wired here and not in `disko/default.nix`
#
# That file is the LAYOUT: partitions, subvolumes, mount options. It takes
# `device` as an argument precisely so it does not have to know where the
# value comes from. Tying `config.ronoctua.disk` in there would make the
# layout depend on a NixOS module, and `disko --flake` would no longer be
# able to evaluate it on its own.
{
  config,
  lib,
  inputs,
  options,
  ...
}:

let
  cfg = config.ronoctua;
in
{
  imports = [ inputs.disko.nixosModules.disko ];

  options.ronoctua = {
    disk = lib.mkOption {
      type = lib.types.str;
      example = "/dev/nvme0n1";
      description = ''
        This machine's WHOLE disk. The installer fills it in at
        `host.nix`; the layout of section 7.2 is applied over it.

        Erasing the disk is the installation's first destructive step — this
        value has no default on purpose.
      '';
    };

    language = lib.mkOption {
      # FROM THE ONE LIST, and not written out again. The description below
      # used to warn that a third value here would give an untranslated screen;
      # it cannot now, because the values ARE the languages that have a
      # complete `.ftl` — `gen-i18n.py` refuses to build otherwise.
      type = lib.types.enum (import ../../assets/i18n/languages.nix);
      # THE BASE, and not a name written again. It is the same default
      # `ronoctua_i18n::DEFAULT` falls back to, and for the same reason: a
      # machine that fell back is probably not a Brazilian one.
      default = builtins.head (import ../../assets/i18n/languages.nix);
      description = ''
        The INTERFACE's language. The values come from
        `assets/i18n/languages.nix`, which is the same list `ronoctua-i18n`
        compiles in — so an untranslated screen is not reachable from here.

        It is not the locale, and the separation is deliberate: the locale decides the format of
        date, number and unit, and there are hundreds of those against the two translations
        this system has. Anyone who wants the interface in Portuguese with metric
        units picks the two things.
      '';
    };

    locale = lib.mkOption {
      type = lib.types.str;
      default = "en_GB.UTF-8";
      example = "pt_BR.UTF-8";
      description = ''
        The system's locale: date, number, paper. The default is British English,
        and the installer offers the list glibc knows how to generate.

        NOT an `enum` here, and the reason is technical: the true list is
        `glibcLocales`' `SUPPORTED`, and reading it at evaluation time would be
        import-from-derivation — the flake's evaluation would stop to wait for a
        build. A list written by hand in its place would be the second copy that
        ages.

        What checks it is the `locale-exists` check, which runs INSIDE a build, where
        reading the file is free. It is the same arrangement as the keyboard layout, and for the
        same reason: the wrong value breaks nothing at the time, and the symptom shows
        up far from the cause.
      '';
    };

    # THE HARDWARE REPORT, generated ON the machine.
    #
    # `nixos-facter` reads the PCI/USB/DMI tree and writes a JSON that stands in
    # for `hardware-configuration.nix`: video driver, firmware, CPU microcode,
    # touchpad. It is INVENTORY OF THIS MACHINE — serials, board model — and so
    # it lives outside the repository (invariant 13), next to `host.nix`.
    #
    # Optional on purpose: without it the system still builds, and the VM and
    # the ISO have no use for a report about someone else's laptop.
    # THE SWAPFILE'S SIZE, handed to disko (`nix/disko/default.nix`): the
    # machine's RAM, rounded up to whole gibibytes, read from the hardware
    # report — which the installer writes BEFORE disko runs, so the size is
    # the machine's on the day the disk is made. It used to be 16G on every
    # machine: a 32 GiB laptop could not hibernate, and an 8 GiB one gave
    # 8 GiB of its disk to nothing. Only the disk's creation reads it: disko
    # makes the file once, and `swapDevices` names the file, never its size.
    # ── anchor: L12 ──
    # ── anchor: L20 ──
    # WHETHER THIS MACHINE HIBERNATES — `false` in the `host.nix` of a
    # machine the installer could not give a swapfile that holds the RAM
    # with a measured offset: one capped by a small disk, or one whose
    # offset `btrfs` did not answer. Off, nothing on the machine asks for a
    # hibernation it cannot make (the config below): no resume device on the
    # kernel's command line, systemd refuses every sleep that writes the RAM
    # to the swapfile, and UPower powers off at its last percent instead.
    # On by default, and that is every machine installed before this option:
    # their `host.nix` carries the offset and says nothing about it.
    #
    # (`swapSize`, right below, is the option the comment above the anchors
    # describes.)
    hibernation = lib.mkOption {
      type = lib.types.bool;
      default = true;
      example = false;
      description = ''
        Whether this machine hibernates. The installer writes `false` into
        `host.nix` when the swapfile cannot hold a hibernation image: capped
        below the RAM by the disk's size, or with no resume offset measured.
      '';
    };
    # ── anchor: L25 ──
    hardware.deferUndistributable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Whether the hardware branches whose packages nobody may redistribute
        (the IPU6 camera, Parallels' guest tools) wait: true while the
        installer's marker (`hardware-deferred.json`) is in the machine
        directory, which `lib.machine` reads. `ronoctua-machine apply` takes
        the marker away once the machine builds without it.
      '';
    };

    swapSize = lib.mkOption {
      type = lib.types.strMatching "[1-9][0-9]*[MGT]";
      # THE MACHINE'S RAM, in bytes: the physical memory the hardware report
      # lists (`hardware.memory[].resources[]` of type `phys_mem`), rounded
      # UP to whole gibibytes — a swapfile a byte short of the RAM is a
      # hibernation that fails in use. `attrByPath`: a system that does not
      # import the facter module has no `facter` at all.
      default =
        let
          report = lib.attrByPath [ "facter" "report" ] { } config;
          memory = lib.filter builtins.isAttrs (report.hardware.memory or [ ]);
          ranges = lib.concatMap (
            m: map (r: r.range or 0) (lib.filter (r: (r.type or "") == "phys_mem") (m.resources or [ ]))
          ) memory;
          bytes = lib.foldl' builtins.add 0 ranges;
          gib = 1024 * 1024 * 1024;
        in
        if bytes > 0 then "${toString ((bytes + gib - 1) / gib)}G" else "16G";
      defaultText = lib.literalMD ''
        the machine's RAM, rounded up to whole gibibytes, from
        `ronoctua.facterReport`; `"16G"` without a report
      '';
      example = "32G";
      description = ''
        The swapfile's size (>= RAM, for hibernation), as disko takes it.
      '';
    };

    facterReport = lib.mkOption {
      type = lib.types.nullOr lib.types.path;
      default = null;
      description = ''
        Path to this machine's `facter.json`, generated by
        `sudo nixos-facter -o ~/facter.json`. It stays OUTSIDE the repository.
      '';
    };
  };

  config = {
    # `inherit (…) disko`, and not `disko = import …`: the layout file ALREADY
    # returns `{ disko.devices = …; }`. Assigning the whole attrset to `disko`
    # would give `disko.disko.devices` — and the error talks about `disko.disko`,
    # which looks like a typo rather than one level too many.
    inherit
      (import ../disko/default.nix {
        device = cfg.disk;
        inherit (cfg) swapSize;
        # A BIOS machine's GRUB needs a partition of its own for its core —
        # and disko, seeing it, hands GRUB this disk (`boot.loader.grub.devices`).
        bios = config.ronoctua.firmware == "bios";
      })
      disko
      ;

    # THE LOCALE IS ITS OWN ANSWER, and no longer derived from the language.
    #
    # It used to be `language` with the dash swapped for an underscore, which
    # tied two things that are not the same one: `pt-BR` is which of our two
    # translations to load, and `pt_BR.UTF-8` is how glibc writes a date. Tied,
    # there was no way to read the interface in Portuguese and keep the metric,
    # A4, day-month machine the owner actually uses.
    # THE SHAPE is checked here, and the EXISTENCE in the check.
    #
    # The shape catches the common mistake — `pt-BR` where `pt_BR.UTF-8`
    # belongs, which is the translation id written where the locale goes — and
    # catches it at evaluation, with the option name attached. Without this the
    # error comes out of glibc's locale generator, talking about a file nobody
    # wrote.
    assertions = [
      {
        assertion = builtins.match "[a-z]+_[A-Z]+(@[a-z]+)?\\.UTF-8" cfg.locale != null;
        message = ''
          ronoctua.locale = "${cfg.locale}" is not shaped like a locale.
          Expected something like "en_GB.UTF-8" or "pt_BR.UTF-8" — with an underscore and
          with the charset. The interface translation's id (`pt-BR`, with a hyphen) goes
          in `ronoctua.language`, which is a different option.
        '';
      }
    ];

    # Generated with every other: `base.nix` asks glibc for all of them.
    i18n.defaultLocale = cfg.locale;

    # THE SYSTEMD INITRD: it asks the disk's passphrase (the only key — the
    # TPM holds nothing for the disk, `nix/disko/default.nix` says why), and
    # the wipe of `@root` is one of its units (`nix/modules/persist.nix`).
    boot.initrd.systemd.enable = lib.mkDefault true;

    # WHERE HIBERNATION RESUMES FROM, and without this line it resumes from
    # nowhere.
    #
    # The installer writes `resume_offset=` into `boot.kernelParams`, which is
    # the offset of the swapfile INSIDE its filesystem. The kernel also needs the
    # device that filesystem is on — and with `boot.initrd.systemd.enable`,
    # nixpkgs only puts `resume=` on the command line when `boot.resumeDevice` is
    # set. It never was: the machine booted with half a resume path, and the
    # failure would appear the first time somebody closed the lid expecting to
    # come back.
    #
    # The mapper's name comes from `nix/disko/default.nix`, where the LUKS
    # container is `name = "cryptroot"`. By that path and not by UUID because the
    # UUID is created during the installation and this file is evaluated before
    # it exists.
    boot.resumeDevice = lib.mkIf cfg.hibernation "/dev/mapper/cryptroot";

    # A MACHINE THAT DOES NOT HIBERNATE SAYS SO wherever it would be asked
    # (`ronoctua.hibernation`): systemd refuses the three sleeps that write
    # the RAM to the swapfile — so logind answers `CanHibernate` with `na`
    # and nothing offers it — and UPower powers off at its last percent
    # (`nix/modules/power.nix` asks it to hibernate) instead of hibernating
    # into a file that cannot hold the RAM.
    systemd.sleep.settings.Sleep = lib.mkIf (!cfg.hibernation) {
      AllowHibernation = false;
      AllowHybridSleep = false;
      AllowSuspendThenHibernate = false;
    };
    services.upower.criticalPowerAction = lib.mkIf (!cfg.hibernation) (lib.mkForce "PowerOff");

    # The report drives the hardware side when it exists.
    facter.reportPath = lib.mkIf (cfg.facterReport != null) cfg.facterReport;

    # ── anchor: L25 ──
    # WHAT NOBODY MAY REDISTRIBUTE WAITS FOR THE FIRST NETWORK (the owner,
    # 2026-10-24). Two of the report's branches bring packages nixpkgs marks
    # unfree AND not redistributable — the IPU6 camera (`ipu6-camera-bins`,
    # `ivsc-firmware`, ISSL) and Parallels' guest tools (`prl-tools`) — which
    # no public cache holds and no published ISO may carry, so an
    # installation with no network cannot build them. A machine installed so
    # carries the installer's marker (`hardware-deferred.json`), and the
    # branches stay off at the detection while it is there; the machine's
    # first apply with a network builds without it, takes the marker away
    # when that works, and puts it back — the machine whole, the camera off,
    # said — when it does not (`ronoctua-machine`). The build says what waits.
    facter.detected.camera.ipu6.enable = lib.mkIf cfg.hardware.deferUndistributable (lib.mkForce false);
    facter.detected.virtualisation.parallels.enable = lib.mkIf cfg.hardware.deferUndistributable (
      lib.mkForce false
    );
    warnings = lib.optionals cfg.hardware.deferUndistributable (
      lib.optional options.facter.detected.camera.ipu6.enable.default "This machine's IPU6 camera waits for the first network: its driver needs ipu6-camera-bins, which nobody may redistribute."
      ++ lib.optional options.facter.detected.virtualisation.parallels.enable.default "This machine's Parallels guest tools wait for the first network: prl-tools may not be redistributed."
    );
  };
}
