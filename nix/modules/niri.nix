# Compositor — section 7.3.
#
# INVARIANT 3: Niri consumed as upstream. NO FORK, NO PATCH.
# Integration exclusively through IPC (event stream + actions) and wlr-layer-shell.
# If something looks like it requires a fork or a patch: STOP AND REPORT, do not work around it.
{
  config,
  lib,
  pkgs,
  ronoctua,
  ...
}:

let
  niriPkg = ronoctua.niri.packages.${pkgs.stdenv.hostPlatform.system}.niri;

  # THE COMPOSITOR'S COLOURS COME FROM THE TOKENS (invariant 9).
  #
  # They used to be three literals here — `#7AA2F7`, `#161616`, `#000000` —
  # coincidentally equal to the tokens of the same name. A coincidence kept up
  # by hand is what invariant 9 exists to forbid: changing `state.accent`
  # changed the footer and left the compositor's border on the old colour.
  #
  # No import-from-derivation: this is reading a Nix file, evaluated like any
  # other.
  tokens = import ../../assets/tokens/colors.nix;
  # The keyboard layout, from the OPTION — whose default is
  # `nix/keyboard-xkb.nix`. Reading the file directly would ignore what the
  # installer wrote into `host.nix`, and the machine would come up on someone
  # else's layout with nothing to say so.
  keyboard = config.ronoctua.keyboard;
  # `0xRRGGBBAA` (the tokens' format) -> `#RRGGBB` (what niri understands).
  # The alpha is dropped: niri accepts it, but none of these three colours is
  # translucent, and a border with alpha would be elevation (invariant 15).
  hex = t: "#" + lib.substring 2 6 t;

  # The chords, generated from the shell's command table — see nix/niri-binds.nix.
  binds = pkgs.callPackage ../niri-binds.nix {
    ronoctua-shell = ronoctua.shell;
  };

  staticConf = ''
          // GENERATED by nix/modules/niri.nix. Do not edit by hand.
          // Invariant 3: this file is configuration, never a patch.

          prefer-no-csd

          input {
              keyboard {
                  xkb {
                      layout "${keyboard.layout}"
                      variant "${keyboard.variant}"
                      // AltGr = Compose: `AltGr ' a` gives `á`. Why this
                      // option, and not the dead-key variants, is in
                      // nix/keyboard-xkb.nix.
                      options "${keyboard.options}"
                  }
              }
              touchpad {
                  tap
                  natural-scroll
              }
            }

          layout {
              // Some breathing room between windows. Zero glued one to the
              // next, and the boundary between two buffers went away along
              // with the focus.
              gaps 8

              // FOCUS HAS TO BE VISIBLE.
              //
              // With `border` and `focus-ring` off, two open windows were
              // indistinguishable: nothing on screen said which one took the
              // key. A 2 px line is NOT a card, a shadow or elevation
              // (invariant 15) — it is the same class as the one-line rule the
              // design already admits as the only separator besides whitespace.
              //
              // `border` and not `focus-ring`: the border counts inside the
              // window's size, so the content does not end up underneath it.
              //
              // THE INACTIVE ONE IS DARK RED, and the why is the owner's call.
              //
              // While the footer holds the keyboard (leader, locator, manual),
              // NO window is focused as far as the compositor is concerned —
              // and there is no way to ask otherwise: a window with no keyboard
              // is not active, and that is what the border reports. So the blue
              // ALWAYS disappears at that instant.
              //
              // What can be chosen is the color that takes its place. With
              // `border.inactive` in dark red, pressing the leader *changes*
              // the outline's color instead of erasing it, which is the effect
              // asked for. The price: an unfocused window is dark red too,
              // not grey. It is discreet enough not to shout "error", and the
              // blue still marks exactly one window.
              border {
                  width 2
                  active-color "${hex tokens.state.accent}"
                  inactive-color "${hex tokens.border.inactive}"
              }
              focus-ring { off; }

              // No shadow, no elevation, zero radius (section 5.1).
              shadow { off; }

              // The compositor's background: PURE BLACK, the same
              // `surface.base`. Without this the emptiness between windows
              // stays niri's default grey, and the system has two different
              // background colors.
              //
              // INSIDE this block, and not in a second `layout`: niri rejects
              // a duplicate node, and the whole config went down with it. It
              // had been a separate block from the start, and nothing accused
              // it because nothing validated the generated file — see the
              // `niri-config-valid` check.
              background-color "${hex tokens.surface.base}"
          }

          // The two-line footer. A single surface, anchored at the bottom,
          // with an exclusive zone of two lines (section 4.1).
          layer-rule {
              match namespace="^ronoctua-footer$"
              opacity 1.0
          }

          // NINE WORKSPACES, ALWAYS. The owner's decision.
          //
          // niri creates and destroys workspaces as they are used: `LEADER TAB
          // 7` on a system with three of them would have nowhere to go.
          // Declared, all nine exist from startup and the number on the key is
          // the number of the workspace — without this, the same key would lead
          // to different places depending on how many windows were open.
          workspace "1"
          workspace "2"
          workspace "3"
          workspace "4"
          workspace "5"
          workspace "6"
          workspace "7"
          workspace "8"
          workspace "9"

          // THE SCREEN'S CORNERS DO NOTHING.
          //
          // The bottom-left corner used to open the workspace overview on
          // hover. That is hidden chrome: an action that fires with nobody
          // asking, in a place the cursor reaches in passing — dragging a
          // window to the edge, or just taking a hand off the keyboard.
          //
          // The overview is still reachable through `LEADER TAB TAB` and
          // through the locator, which are the two paths §13 asks for.
          gestures {
              hot-corners {
                  off
              }
          }

          hotkey-overlay {
              skip-at-startup
          }

          // ONE BIND, AND ONLY ONE.
          //
          // Closing a window, switching focus, changing workspace, taking a
          // screenshot — all of that used to be a niri bind and now lives in
          // the shell's keymap, reaching the compositor as an IPC action. While
          // there were two tables, there were two notations, two places where a
          // key could collide, and which-key knew only half of the system's
          // shortcuts.
          //
          // Section 7.4 asks for one keymap. This is the only bind it cannot
          // absorb: it is the one that wakes the daemon.
          //
          // The CHORDS — leader held plus an arrow — go in place of the marker
          // below, GENERATED from the shell's command table. A chord never
          // reaches the footer's keymap (it only gets the keyboard after the
          // leader is released), so the compositor is what resolves it; but
          // what it DOES stays defined in a single place.
          // See nix/niri-binds.nix.
          binds {
              // THE LEADER IS THE SUPER KEY ON ITS OWN.
              //
              // `F13`, and not `Mod`: niri rejects a bind on a modifier alone
              // (`invalid key: Mod`) and has no release trigger. What tells
              // TAP from HOLD is keyd, below the compositor — see
              // nix/modules/keyboard.nix. Held, Super stays a modifier and the
              // chords below work; tapped and released with no other key, it
              // emits F13 and the sequence begins.
              //
              // `repeat=false`: without it, holding the key re-fires the bind
              // at the keyboard's repeat rate, and every fire opens the
              // sequence again.
              //
              // THE STORE PATH, and not the name. It used to be
              // `"ronoctua-shell"`, and the binary was not even installed: in
              // production the leader did nothing and nothing accused it,
              // because `nix flake check` does not bring up a real session.
              F13 repeat=false { spawn "${ronoctua.shell}/bin/ronoctua-shell" "leader"; }
    @CHORDS@
          }
  '';

  # THE CONFIG AS A DERIVATION, and not as `text`.
  #
  # It now has a generated part (the chords), and `text` would require reading
  # a derivation's output during evaluation — import-from-derivation, which
  # STOPS evaluation to wait for a build. By assembling the file here, Nix
  # only needs it when it builds the system.
  configNiri = pkgs.runCommand "ronoctua-niri-config.kdl" { } ''
    cp ${pkgs.writeText "niri-static.kdl" staticConf} $out
    chmod +w $out
    # The chords go INSIDE the `binds` block, in place of the marker.
    ${pkgs.gnused}/bin/sed -i -e "/@CHORDS@/r ${binds.forPrefix "Mod"}" -e "/@CHORDS@/d" $out
    grep -q "focus-column-left" $out || {
      echo "ERRO: os acordes nao entraram no config do niri." >&2; exit 1; }
  '';
in
{
  config = {
    environment.systemPackages = [
      niriPkg
      # THE FOOTER. It was not here, and the effect was the whole system with no
      # chrome at all in production: nothing brought the surface up and the
      # leader's bind spawned a name that did not exist in the session's PATH.
      # Only the nested loop worked, because there `nix/dev.nix` starts the binary by hand.
      ronoctua.shell
      # Section 9.1: Xwayland through satellite, ONE INSTANCE PER BUFFER
      # SCOPE. A shared satellite would break section 7.5's
      # PID -> cgroup correlation, because every X11 window would report
      # the satellite's pid.
      #
      # The correlation lives in `crates/ronoctua-shell/src/foreign.rs`; the
      # satellite joins the same scope once the shell starts spawning.
      pkgs.xwayland-satellite
    ];

    # Portals: needed for screenshot, screencast and the file picker of the
    # foreign buffers. They are not chrome (invariant 14) — they are the apps'
    # own dialogs.
    xdg.portal = {
      enable = true;
      extraPortals = [ pkgs.xdg-desktop-portal-gtk ];
      config.common.default = [
        "gnome"
        "gtk"
      ];
    };

    programs.dconf.enable = true;

    services.dbus.enable = true;
    services.dbus.packages = [ niriPkg ];

    # niri needs this to run without a full seat manager.
    security.polkit.enable = true;
    hardware.graphics.enable = true;

    systemd.user.services.niri = {
      description = "niri — compositor Wayland (upstream, sem patch)";
      bindsTo = [ "graphical-session.target" ];
      before = [ "graphical-session.target" ];
      wants = [ "graphical-session-pre.target" ];
      after = [ "graphical-session-pre.target" ];
      serviceConfig = {
        Type = "notify";
        ExecStart = "${niriPkg}/bin/niri --session";
        Restart = "on-failure";
        Slice = "session.slice";
      };
    };

    # THE FOOTER, as a user service of the graphical session.
    #
    # # Why not `spawn-at-startup` in niri's config
    #
    # niri sends the output of whatever it spawns to /dev/null, and there is
    # no way to restart the footer without restarting the compositor. As a
    # unit, it has its own journal, comes back on its own if it dies
    # (`Restart`) and can be restarted by hand — which matters in a piece
    # that is the system's ONLY chrome (invariant 14): without it there is no
    # modeline, no minibuffer and no leader.
    #
    # `after` and `partOf` `graphical-session.target`: once it is reached,
    # `niri --session` has already put `WAYLAND_DISPLAY` and `NIRI_SOCKET`
    # into the user systemd's environment, which is where the footer reads them.
    systemd.user.services.ronoctua-footer = {
      description = "ronoctua — o rodapé de duas linhas";
      partOf = [ "graphical-session.target" ];
      after = [ "graphical-session.target" ];
      wantedBy = [ "graphical-session.target" ];
      serviceConfig = {
        ExecStart = "${ronoctua.shell}/bin/ronoctua-shell";
        Restart = "on-failure";
        RestartSec = 1;
        Slice = "session.slice";
      };
    };

    # -----------------------------------------------------------------
    # niri's config.
    #
    # WHAT IS NOT HERE, ON PURPOSE:
    #  - no bar, dock, clock or launcher (invariant 14);
    #  - no blur (26.04 brought ext-background-effect; section 5.1
    #    forbids elevation — invariant 15);
    #  - no shadow, no border radius.
    #
    # The leader key (section 7.4) is NOT configured here as a state
    # machine: a single bind wakes the daemon, and the sequence runs over
    # there. What the config holds are the CHORDS, generated from the same
    # command table.
    # -----------------------------------------------------------------
    environment.etc."niri/config.kdl".source = configNiri;

    environment.sessionVariables = {
      # THE LEADER'S ON-SCREEN LABEL comes from the SAME place as the bind,
      # just above. Two truths would be the screen saying `SPC` while the key
      # is something else — which is exactly the previous state.
      RONOCTUA_LEADER = "SUPER";
      # THE CHORD'S LABEL. In production it is the SAME key as the sequence's —
      # and that is the beauty of keyd: tapping opens the list, holding is the
      # modifier. In the nested loop the two diverge (`ALT SPC` against `ALT`),
      # and that is why the screen needs both variables instead of deriving one
      # from the other.
      RONOCTUA_LEADER_CHORD = "SUPER";
      NIXOS_OZONE_WL = "1";
      # Section 6.4: the renderer does NOT use fontconfig. But the foreign apps
      # do, and they need to find our .conf.
      XDG_CURRENT_DESKTOP = "niri";
      XDG_SESSION_TYPE = "wayland";
    };
  };
}
