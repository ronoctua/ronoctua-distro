# Compositor — section 7.3.
#
# INVARIANT 3: consumed as upstream. NO FORK, NO PATCH — neither of the
# compositor nor of the wlroots it carries in `subprojects/`. Integration is
# exclusively through IPC and `wlr-layer-shell`, and the shell reaches the IPC
# through a CONTRACT: no crate of ours but the adapter knows which compositor
# this is.
#
# Putting `sh` and `swaybg` on the unit's PATH is not a patch; a `.patch` in
# the source is. If something looks like it requires a fork:
# STOP AND REPORT, do not work around it.
#
# # THE SESSION COMES UP DIFFERENTLY FROM WHAT A READER MAY EXPECT
#
# This compositor has no `--session` flag and no `sd_notify` — checked in its
# `--help` and in the built binary. So the unit cannot be `Type = "notify"`,
# and `graphical-session.target` cannot mean "the compositor is ready" by
# itself. What makes it mean that is the `exec` lines at the top of the
# generated config, which import the environment into the user manager and
# then start our own target. See `scroll-session` below.
{
  config,
  lib,
  pkgs,
  ronoctua,
  ...
}:

let
  compositor = ronoctua.scroll;

  # THE COMPOSITOR'S COLOURS COME FROM THE TOKENS (invariant 9).
  #
  # They used to be three literals here — `#7AA2F7`, `#161616`, `#000000` —
  # coincidentally equal to the tokens of the same name. A coincidence kept up
  # by hand is what invariant 9 exists to forbid: changing `state.accent`
  # changed the footer and left the compositor's border on the old colour.
  #
  # And now the tokens are SOLVED, per theme, by `nix/themes.nix`: the three
  # values are files in that derivation, for the theme `ronoctua.theme` names,
  # spliced into the config by the build below — never read at evaluation
  # (no import-from-derivation), the same way the chords get in.
  palette = "${ronoctua.themed}/${config.ronoctua.theme}";
  # The keyboard layout, from the OPTION — whose default is
  # `nix/keyboard-xkb.nix`. Reading the file directly would ignore what the
  # installer wrote into `host.nix`, and the machine would come up on someone
  # else's layout with nothing to say so.
  keyboard = config.ronoctua.keyboard;
  # The chords, generated from the shell's command table — see nix/compositor-binds.nix.
  binds = pkgs.callPackage ../compositor-binds.nix {
    ronoctua-shell = ronoctua.shell;
  };

  # The window rules, generated from the same binary and for the same reason:
  # the monitor's `app_id` is set in the Rust and read here.
  windowRules = pkgs.callPackage ../compositor-window-rules.nix {
    ronoctua-shell = ronoctua.shell;
  };

  # WHERE A CAPTURE LANDS, from the same file the home's directories come from.
  #
  # It is NOT a line in the compositor's config any more: this compositor
  # takes no screenshots at all. What takes one is `grim`, started by the
  # shell, and the name is built there — so the directory travels as an
  # environment variable instead of as a configuration line.
  #
  # `nix/user-dirs.nix` says who else reads the entry, and
  # `screenshots-land-in-a-declared-directory` compares the two ends.
  screenshotDir = (import ../user-dirs.nix).screenshot;

  staticConf = ''
    # GENERATED by nix/modules/scroll.nix. Do not edit by hand.
    #
    # WHAT IS NOT HERE, ON PURPOSE:
    #  - no `bar` block: there is no bar, dock, clock or launcher
    #    (invariant 14), and upstream's shipped config has one;
    #  - no shadow, no border radius, no blur (invariant 15);
    #  - no titlebar — `default_border pixel` draws none.

    # --- THE NAG WINDOW IS REFUSED ------------------------------------
    #
    # `-` is the spelling that turns it off (`cmd_swaynag_command`: any
    # other argument becomes the command, `-` leaves it NULL and
    # `swaynag_spawn` returns early).
    #
    # It has to be said out loud, because this compositor raises that window
    # ON ITS OWN in two places nothing here asks for: a configuration error
    # (`config.c:1036`) and a scale it considers non-recommended
    # (`output.c:612` — `verify_good_scale` nags AND silently adjusts). Either
    # one would put a floating window with its own buttons on a desktop whose
    # only chrome is the footer, which is invariant 14 exactly.
    #
    # NOT LEFT TO THE CLOSURE. `scrollnag` is not installed, so today the
    # spawn would fail and nothing would appear — an accident, not a decision,
    # and one that a profile adding the binary for some other reason would
    # quietly undo. A refusal that depends on a program being absent is not a
    # refusal.
    #
    # WHAT THE PERSON LOSES IS REAL, and it is worth naming rather than
    # waving away.
    #
    # A configuration error reaches NOTHING a client can hear on this
    # compositor: measured, `reload` answers `{"success": true}` for a broken
    # fragment and for a broken main file alike, and there is no event about
    # it. That window and the log were the only two places it appeared, and
    # this line takes one of them away.
    #
    # What answers instead is earlier and stronger: the grammar of everything
    # we generate is put in front of a real compositor at BUILD time
    # (`display-fragment-validates` and `compositor-config-valid`), with a
    # broken half beside it so the pass means something. An error that cannot
    # be built cannot reach a screen to be nagged about.
    #
    # The scale nag has its own answer, and it is the same shape: the display
    # view offers only the scales this panel divides into whole pixels, so
    # there is nothing for the compositor to silently adjust — see
    # `display::ladder_for`.
    scrollnag_command -

    # --- THE SESSION COMES UP HERE ------------------------------------
    #
    # This compositor has no `--session` and no `sd_notify`, so nothing else
    # can tell the user manager that a Wayland session exists. These three
    # lines are what does, and they run after the backend, the renderer and
    # the socket are all up — the compositor defers an `exec` until then.
    #
    # STORE PATHS AND NOT NAMES. A systemd unit comes up with a minimal PATH,
    # and a bare `systemctl` here fails far from the cause.
    #
    # `exec` AND NOT `exec_always`: the display view calls `reload` on every
    # screen change, and `exec_always` would restart the session target each
    # time.
    exec ${pkgs.systemd}/bin/systemctl --user import-environment WAYLAND_DISPLAY SCROLLSOCK SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
    exec ${pkgs.dbus}/bin/dbus-update-activation-environment --systemd WAYLAND_DISPLAY SCROLLSOCK SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
    exec ${pkgs.systemd}/bin/systemctl --user start scroll-session.target

    # --- input --------------------------------------------------------
    input type:keyboard {
        xkb_layout "${keyboard.layout}"
        xkb_variant "${keyboard.variant}"
        xkb_options "${keyboard.options}"
    }

    # NO `type:touchpad` BLOCK. Tapping and natural scrolling used to be
    # written here by hand; they are now the touchpad defaults in
    # `ronoctua-pointers` (`prefs.rs`), which writes them per device into the
    # pointers fragment included below — one home, and the screen at
    # `LEADER s i` can change them.

    # --- how it looks -------------------------------------------------
    #
    # A BORDER AND NOT A FOCUS RING: with no border, two open windows are
    # indistinguishable, and the ring is the thing invariant 15 refuses.
    #
    # The colours come from the TOKENS (invariant 9), spliced in by the
    # derivation below out of the solved palette. `client.focused` takes five
    # and only two are ours to choose; the rest are decorations that
    # `default_border pixel` never paints.
    default_border pixel 2
    titlebar_padding 1
    gaps inner 8
    gaps outer 0

    client.focused @BORDER_ACTIVE@ @BORDER_ACTIVE@ @BORDER_ACTIVE@ @BORDER_ACTIVE@ @BORDER_ACTIVE@
    client.focused_inactive @BORDER_INACTIVE@ @BORDER_INACTIVE@ @BORDER_INACTIVE@ @BORDER_INACTIVE@ @BORDER_INACTIVE@
    client.unfocused @BORDER_INACTIVE@ @BORDER_INACTIVE@ @BORDER_INACTIVE@ @BORDER_INACTIVE@ @BORDER_INACTIVE@

    # THE DESK. The only `output` field this file owns — see the guard in the
    # derivation below for why that matters.
    output * bg @BACKGROUND@ solid_color

    # NO SCALE IS WRITTEN, and that is a decision rather than an omission.
    # The compositor's own heuristic answers 1 on almost every panel, the
    # person chooses through `LEADER s d`, and what they choose is written to
    # the fragment included at the end of this file. A number here would be
    # the silent default the day that fragment is absent.

    # ANIMATIONS OFF, and it is not only about photographs.
    #
    # `animations enabled` defaults to YES here, with style `scale`: a new
    # window fades in from transparent while its CONTENT is scaled to the
    # animated size. Nothing else in this distro moves by itself, so motion
    # arriving from the compositor is chrome nobody asked for.
    #
    # AND IT DOES NOT ALWAYS END. Measured in a VM on the X11 backend, where
    # the test configs did NOT have this line: a new window sat at 45%
    # brightness with its text unreadable, identical four seconds apart,
    # because nothing drove the animation to completion. The screen shows a
    # window permanently half-drawn and nothing says why — `buffer-vm` read a
    # blank screen off one and blamed the renderer. This config was always
    # right; it was the prelude's that was not.
    animations {
        enabled no
    }

    # --- ONE BIND, AND ONLY ONE ---------------------------------------
    #
    # Closing a window, switching focus, changing workspace — all of that is
    # in the shell's keymap and reaches the compositor as a deed over the IPC.
    # While there were two tables there were two notations, two places where a
    # key could collide, and which-key knew only half of the shortcuts.
    #
    # Section 7.4 asks for one keymap. This is the only bind it cannot
    # absorb: it is the one that wakes the daemon.
    #
    # `F13`, and not Super: a bind on a modifier alone has no release
    # trigger. What tells TAP from HOLD is keyd, below the compositor — see
    # nix/modules/keyboard.nix. Held, Super stays a modifier and the chords
    # work; tapped and released with no other key, it emits F13.
    #
    # `--no-repeat`: without it, holding the key re-fires the bind at the
    # keyboard's repeat rate and every fire opens the sequence again.
    #
    # THE STORE PATH, and not the name. It used to be `"ronoctua-shell"`, and
    # the binary was not even installed: in production the leader did nothing
    # and nothing accused it, because `nix flake check` does not bring up a
    # real session.
    #
    # `bindcode 191` AND NOT `bindsym F13`. keyd emits the kernel's `KEY_F13`,
    # which xkb's `evdev` keycodes call `<FK13>` = 191 — and the `inet` symbols
    # every layout pulls in map `<FK13>` to `XF86Tools`, not to `F13`. A
    # `bindsym F13` therefore matched nothing: measured in `nix run .#vm` by
    # subscribing to the compositor's `binding` events, `Ctrl+Alt+l` fired and
    # neither a tap of Super nor a raw F13 did. The leader had not opened from
    # Super in production since the compositor changed. The code is what keyd
    # sends whatever the layout says it means.
    bindcode --no-repeat 191 exec "${ronoctua.shell}/bin/ronoctua-shell" leader

    # The CHORDS go in place of this marker, GENERATED from the shell's
    # command table — see nix/compositor-binds.nix. A chord never reaches the
    # footer's keymap (it only gets the keyboard after the leader is
    # released), so the compositor is what resolves it; what it DOES stays
    # defined in one place.
    @CHORDS@
  '';

  # THE CONFIG AS A DERIVATION, and not as `text`.
  #
  # It now has a generated part (the chords), and `text` would require reading
  # a derivation's output during evaluation — import-from-derivation, which
  # STOPS evaluation to wait for a build. By assembling the file here, Nix
  # only needs it when it builds the system.
  configScroll = pkgs.runCommand "ronoctua-scroll-config" { } ''
    cp ${pkgs.writeText "scroll-static.conf" staticConf} $out
    chmod +w $out
    # The chords go in place of the marker.
    ${pkgs.gnused}/bin/sed -i -e "/@CHORDS@/r ${binds.forPrefix "Super"}" -e "/@CHORDS@/d" $out
    grep -q "focus left" $out || {
      echo "ERROR: the chords did not get into the compositor's config." >&2; exit 1; }

    # The window rules go at the END, and not in a marker: `for_window` is a
    # top-level directive, so appending is the whole of it.
    cat ${windowRules} >> $out
    grep -q "floating enable" $out || {
      echo "ERROR: the window rules did not get into the config." >&2; exit 1; }

    # The three colours, from the solved palette. `#RRGGBB`, already: the
    # generator writes what the compositor reads, and none of the three is
    # translucent — a border with alpha would be elevation (invariant 15).
    substituteInPlace $out \
      --subst-var-by BORDER_ACTIVE "$(cat ${palette}/compositor-border-active)" \
      --subst-var-by BORDER_INACTIVE "$(cat ${palette}/compositor-border-inactive)" \
      --subst-var-by BACKGROUND "$(cat ${palette}/compositor-background)"
    grep -q "@[A-Z_]*@" $out && {
      echo "ERROR: a colour marker survived in the config." >&2; exit 1; }
    # ANCHORED AT THE LINE'S START: `client.focused #` is a substring of the
    # inactive line, and a substitution that came out empty would have passed.
    for line in 'client.focused #' 'client.unfocused #' 'output \* bg #'; do
      grep -qE "^[[:space:]]*$line" $out || {
        echo "ERROR: $line did not get into the config." >&2; exit 1; }
    done

    # THIS FILE OWNS EXACTLY ONE `output` FIELD, AND IT IS `bg`.
    #
    # Blocks that match one monitor are MERGED — the wildcard, then the
    # connector, then the identifier — and the later value wins field by
    # field. So a static `output *` is not a hazard the way a first-match
    # lookup would make it; what must not be here is a field the PERSON
    # chooses. A `scale` written up here would be correctly overridden today
    # and would become the silent default the day the fragment is absent,
    # which is a decision nobody made.
    if grep -nE '^[[:space:]]*output[[:space:]]' $out \
       | grep -vE '^[0-9]+:[[:space:]]*output \* (bg|mode) '; then
      echo "ERROR: the static config grew an \`output\` field that is not the desk." >&2
      exit 1
    fi

    # NO `bar` BLOCK, and the guard is worth having because upstream's own
    # shipped configuration HAS one — a copied line would spawn a bar, which
    # is the chrome invariant 14 exists to refuse.
    if grep -qE '^[[:space:]]*bar[[:space:]]*\{' $out; then
      echo "ERROR: the config declares a \`bar\` block." >&2
      exit 1
    fi

    # THE PERSON'S THEME AND SCREENS, included LAST.
    #
    # WITH THE VARIABLE AND NOT A RESOLVED PATH. `include` expands shell
    # syntax (`wordexp(3)`), so this is the same rule
    # `ronoctua_store::config_dir()` follows — which means the path the
    # compositor includes and the path the shell writes come from ONE source.
    # It used to be a literal `/home/<user>/…` at this end and a variable at
    # the other, which is a pair that agrees until somebody sets
    # `XDG_CONFIG_HOME`.
    #
    # A MISSING FILE IS NOT FATAL, by construction: the include command
    # ignores whether the file loaded. So there is no flag to remember and a
    # first boot is clean.
    #
    # `gen-theme.py` writes two theme fragments — one per desk, black or the
    # theme's own `surface.backdrop` — and the footer copies the chosen one
    # here. `ronoctua-display` writes the screens one. Both are re-read when
    # the shell asks for a re-read, and a refusal comes back to it on the same
    # call rather than as an event nobody is listening for.
    {
      echo 'include "''${XDG_CONFIG_HOME:-$HOME/.config}/ronoctua/scroll-theme.conf"'
      echo 'include "''${XDG_CONFIG_HOME:-$HOME/.config}/ronoctua/scroll-display.conf"'
      echo 'include "''${XDG_CONFIG_HOME:-$HOME/.config}/ronoctua/scroll-pointers.conf"'
    } >> $out
  '';
in
{
  config = {
    environment.systemPackages = [
      compositor
      # THE CURSORS, one theme per cursor colour (`nix/cursors.nix`), so an
      # app that asks for them by name finds them in the profile too.
      ronoctua.cursors
      # THE FOOTER. It was not here, and the effect was the whole system with no
      # chrome at all in production: nothing brought the surface up and the
      # leader's bind spawned a name that did not exist in the session's PATH.
      # Only the nested loop worked, because there `nix/dev.nix` starts the binary by hand.
      ronoctua.shell
      # THE CAPTURE, which is ours now: the compositor has no screenshot of
      # its own, so `grim` reads the screen and our own overlay
      # (`ronoctua-shell capture`) is where the region, the window or the
      # whole screen is chosen. It goes in the closure and its path travels
      # to the footer as a variable — see `RONOCTUA_GRIM` below, and the
      # reason `RONOCTUA_SWAPPY` is read the same way.
      pkgs.grim
    ];

    # Portals: needed for screenshot, screencast and the file picker of the
    # foreign buffers. They are not chrome (invariant 14) — they are the apps'
    # own dialogs.
    xdg.portal = {
      enable = true;
      extraPortals = [ pkgs.xdg-desktop-portal-gtk ];
      config.common.default = [
        "gnome"
        "gtk"
      ];
    };

    programs.dconf.enable = true;

    services.dbus.enable = true;
    services.dbus.packages = [ compositor ];

    # ── THE MACHINE BOOTS INTO ITSELF, AND ASKS NOTHING ─────────────────
    #
    # # What it was doing instead
    #
    # Booting to a `getty` and stopping there. There was no autologin and
    # nothing pulled the compositor in — `default.target.wants` in the built
    # system held `emacs.service` and the activation unit and nothing else —
    # so the machine asked for a user and a password and then handed over a
    # SHELL. The desktop had no way to start at all, and the same was true of
    # the compositor before this one: the gap is as old as the repository, and
    # what it took to notice was booting the VM.
    #
    # # Why the shell and not a display manager
    #
    # Because the compositor already has an owner — `scroll.service` — and it
    # has to keep it. The rescue path restarts THAT unit by name
    # (`ronoctua-rescue`), and `memory-policy-shape` reads its
    # `StartLimitIntervalSec=0`. A greeter launching the binary directly would
    # make two ways to run one compositor, and the rescue's restart would then
    # bring up a second.
    #
    # So the login is the one the machine already has, with the asking taken
    # out of it, and the shell starts the unit and waits on it.
    #
    # # Three things the guard is for
    #
    #   1. `XDG_VTNR` is 1 — `pam_systemd` sets it for a seat session and
    #      leaves it unset over SSH, so a remote login does not try to bring a
    #      compositor up on a machine with no screen in front of it. That
    #      matters here more than usual: the unit restarts on failure with NO
    #      ceiling, so without the guard an SSH login into a headless box is
    #      an endless restart.
    #   2. `WAYLAND_DISPLAY` is empty — a shell opened INSIDE the session is a
    #      terminal, not a second login.
    #   3. `start --wait` and never `exec`. The shell stays underneath, so a
    #      compositor that will not start leaves a prompt to find out why
    #      instead of a getty that autologs in and dies again forever.
    services.getty.autologinUser = config.ronoctua.user;

    environment.loginShellInit = ''
      if [ "''${XDG_VTNR:-}" = 1 ] && [ -z "''${WAYLAND_DISPLAY:-}" ]; then
        ${pkgs.systemd}/bin/systemctl --user start --wait scroll.service
      fi
    '';

    # The compositor needs this to run without a full seat manager.
    security.polkit.enable = true;
    hardware.graphics.enable = true;

    # NEITHER OF THE TWO UNITS BELOW CARRIES `OOMScoreAdjust`, and that is not an
    # oversight.
    #
    # `user@.service` ships `OOMScoreAdjust=100`, which everything in the session
    # inherits. A user unit cannot go BELOW its inherited value: the kernel
    # returns `EACCES` without `CAP_SYS_RESOURCE`, and systemd swallows it —
    # "Failed to adjust OOM setting, assuming containerized execution, ignoring",
    # at DEBUG level. The setting would build, deploy, and do nothing.
    #
    # The ordering is made the other way round, by raising the APPLICATIONS,
    # which needs no privilege: see `choom` in
    # `crates/ronoctua-shell/src/foreign.rs`. Apps 500, these two 100.
    # THE SESSION TARGET, which exists because the compositor cannot say it is
    # ready.
    #
    # A compositor that announces itself with `sd_notify` makes
    # `graphical-session.target` mean "it is up and has exported its
    # environment". This one has no such signal, so the meaning is restored
    # from the other side: the three `exec` lines at the
    # top of its config import the environment and then start THIS, and this
    # is what `graphical-session.target` waits for.
    systemd.user.targets.scroll-session = {
      description = "Scroll session — reached once the compositor is really up";
      # AND IT ENDS WITH THE COMPOSITOR: bound to it, so a compositor that
      # stops takes the session target — and the footer hanging off it — down
      # too, which is what the compositor's own `BindsTo=` used to give.
      bindsTo = [
        "graphical-session.target"
        "scroll.service"
      ];
      before = [ "graphical-session.target" ];
      wants = [ "graphical-session-pre.target" ];
      after = [
        "graphical-session-pre.target"
        "scroll.service"
      ];
    };

    systemd.user.services.scroll = {
      # NO CEILING ON RESTARTS. systemd's default gives up after 5 starts in
      # 10 s, and giving up here means a machine with no compositor — there is
      # no outcome worse than that, so there is no ceiling.
      startLimitIntervalSec = 0;
      description = "Scroll — Wayland compositor (upstream, unpatched)";
      # NOT BOUND TO `graphical-session.target`, and it was, and that was the
      # black screen of the first `nix run .#vm`. Bound and ordered `Before=`,
      # starting this unit pulled the target in and systemd called it reached
      # the instant the process had exec'd — before the config's `exec` lines
      # had exported `WAYLAND_DISPLAY`. Every unit hanging off the target (the
      # footer, the lifeline) then came up with no display, failed, and
      # restarted into the same answer forever. The target is pulled in by
      # `scroll-session.target`, which only the config starts, which is the
      # one moment the environment is known to be there.
      wants = [ "graphical-session-pre.target" ];
      after = [ "graphical-session-pre.target" ];
      # WHAT THE COMPOSITOR RUNS BY NAME. Every `exec` in its config goes
      # through `execlp("sh", …)` (`sway/commands/exec_always.c`), and the
      # background through `execvp("swaybg", …)`; a user unit's PATH has
      # neither. Without `sh`, the three session lines of the config died on
      # `execve failed: No such file or directory` and the session never came
      # up — the second half of the same black screen.
      path = [
        pkgs.bash
        pkgs.swaybg
      ];
      serviceConfig = {
        # `exec` AND NOT `notify`: this compositor has no `sd_notify` at
        # all, so `Type = "notify"` would sit for the full start timeout and
        # then be killed — a machine with no compositor, which is the one
        # outcome with no worse alternative.
        #
        # AND NOT `simple` EITHER: `simple` considers the unit started the
        # instant the fork returns, so a compositor that dies on a bad config
        # is reported as a SUCCESSFUL start. `exec` waits for the exec itself
        # to succeed, which is the most systemd can be told here.
        Type = "exec";
        # `-c` EXPLICITLY, and this is not belt and braces.
        #
        # The search order prefers `~/.scroll/config` and
        # `$XDG_CONFIG_HOME/scroll/config` over the one in `/etc`. Without the
        # flag, a file somebody leaves in their own config directory replaces
        # the ENTIRE generated configuration — every bind, every colour, the
        # footer's own session lines — with nothing on screen to say so. The
        # declared door for personal settings is the two includes at the end
        # of the generated file.
        ExecStart = "${compositor}/bin/scroll -c /etc/scroll/config";
        # WHERE THE CURSOR THEMES ARE, for the compositor itself: every seat
        # loads the theme `ronoctua-pointers` names by searching this path, and
        # a user unit is not given the login shell's variables. The profile's
        # own icons come after, for a theme somebody installed by hand.
        Environment = [
          "XCURSOR_PATH=${ronoctua.cursors}/share/icons:/run/current-system/sw/share/icons"
        ];
        Restart = "on-failure";
        Slice = "session.slice";
        # Written out although it is the default: it is what makes `Restart=`
        # apply after an OOM kill. The unit ends in the `oom-kill` failed state,
        # "after which Restart= may apply" (`systemd.service(5)`).
        OOMPolicy = "stop";
      };
    };

    # THE FOOTER, as a user service of the graphical session.
    #
    # # Why not `exec` in the compositor's config
    #
    # One reason that used to be on this list is gone: an `exec` does NOT send
    # its child to /dev/null — it inherits the compositor's own descriptors,
    # so a footer started that way would at least have a log. Three reasons
    # stand, and they are the load-bearing ones:
    #
    #  - no `Restart=`. A footer that dies stays dead, and the footer is the
    #    system's ONLY chrome (invariant 14) AND the notification daemon;
    #  - no `OnFailure=`, which is the whole of the lifeline mechanism;
    #  - no `systemctl --user restart ronoctua-footer`. Restarting it would
    #    mean restarting the compositor, which is what the unit exists to
    #    avoid — and its journal would be interleaved with the compositor's
    #    rather than being a stream of its own.
    #
    # `after` and `partOf` `graphical-session.target`: once it is reached, the
    # compositor's own `exec` lines have already imported `WAYLAND_DISPLAY`
    # and `SCROLLSOCK` into the user manager's environment, which is where the
    # footer reads them. That ordering is restored by `scroll-session.target`
    # above rather than by the compositor announcing itself.
    systemd.user.services.ronoctua-footer = {
      # Same reason, and one worse consequence: the footer is the system's ONLY
      # chrome (invariant 14) AND the notification daemon. Five kills in ten
      # seconds and the person is left with a bare screen and no way to be told
      # why.
      startLimitIntervalSec = 0;
      description = "ronoctua — the two-line footer";
      environment = {
        RONOCTUA_THEME = config.ronoctua.theme;
        RONOCTUA_THEMES = "${ronoctua.themed}";
        # WHERE THIS MACHINE'S REPOSITORY IS, when it has one — see
        # `ronoctua.repo`. Empty on a machine that installed the distro rather
        # than building it, and then sharing a filter is simply not offered.
        RONOCTUA_REPO = config.ronoctua.repo;
        # THE CAPTURE'S THREE, AND THEY HAVE TO BE HERE.
        #
        # They are in `environment.sessionVariables` too, and that is NOT what
        # reaches this process: a systemd user unit inherits the user
        # MANAGER's environment, not a login shell's, and `sessionVariables`
        # is the login shell's. The compositor imports five names by hand and
        # these are not among them.
        #
        # Without them `capture_path` returns `None`, `screen-capture` echoes
        # "nothing to do", and the key reads as broken rather than as
        # unconfigured — in production, with every check green. It is the same
        # trap `AGENTS.md` records for the photograph battery and the tag
        # reader, arriving by the same door.
        #
        # `screenshots-land-in-a-declared-directory` reads THIS unit, not the
        # source, which is what turns that from a comment into a gate.
        # THE MACHINE'S KEYBOARD, for a keyboard of its own in Independent
        # mode: its `input "<twin>"` block carries these whole, because the
        # compositor merges `type:keyboard` into a device's block only when
        # the device already exists as the config is read — and a twin made
        # after it would come up with no layout at all (`input.c`,
        # `store_input_config`).
        RONOCTUA_XKB_LAYOUT = keyboard.layout;
        RONOCTUA_XKB_VARIANT = keyboard.variant;
        RONOCTUA_XKB_OPTIONS = keyboard.options;
        RONOCTUA_SCREENSHOTS = screenshotDir;
        RONOCTUA_GRIM = "${pkgs.grim}/bin/grim";
      };
      partOf = [ "graphical-session.target" ];
      after = [ "graphical-session.target" ];
      wantedBy = [ "graphical-session.target" ];
      # AND WHEN IT FAILS, SOMEBODY SAYS SO.
      #
      # `Restart=on-failure` above brings the footer back, and for a year that
      # was the whole answer: the interface returned and nobody was told it had
      # gone. The owner named that as a defect of its own — *"a ronoctua-distro
      # não sabe lidar com isso, ou seja, acaba deixando o usuário sem
      # interface"* — after a crash left him with a bare screen in the nested
      # loop, where nothing restarts anything.
      #
      # MEASURED, because the received wisdom says otherwise: `OnFailure=` is
      # documented as firing when a unit enters the `failed` state, and a unit
      # with `Restart=` and no start limit is supposed never to reach it. Probed
      # here with two transient units — `Restart=on-failure`, `RestartSec=1`,
      # `StartLimitIntervalSec=0`, a child exiting 7 — the witness fired on
      # EVERY failure, three for three. So this is the mechanism, and it costs
      # nothing at all while nothing is wrong: no thread, no timer, no question.
      onFailure = [ "ronoctua-lifeline.service" ];
      serviceConfig = {
        ExecStart = "${ronoctua.shell}/bin/ronoctua-shell";
        Restart = "on-failure";
        RestartSec = 1;
        Slice = "session.slice";
        OOMPolicy = "stop";
      };
    };

    # THE LINE THAT OUTLIVES THE FOOTER.
    #
    # Two rows saying what happened and what can be done about it: see the
    # logs, restart the interface, ask an AI (drawn and refusing — it is not
    # built yet), close. It is a second `wlr-layer-shell` surface, and that is
    # not a second chrome against invariant 14: it is the footer's own row drawn
    # by another process, alive exactly while there is no chrome at all, and
    # gone on one key.
    #
    # NO `wantedBy`. Nothing starts this on purpose — it is started BY the
    # failure above and by nothing else, which is why a healthy session never
    # has this process at all.
    #
    # `Restart = "no"`, for the rescue console's reason one module along: a
    # rescue that restarts in a loop is a screen one cannot leave. And a crash
    # LOOP does not stack lines either — starting a unit that is already active
    # is a no-op, so there is one line however many times the footer falls.
    systemd.user.services.ronoctua-lifeline = {
      description = "ronoctua — the line that outlives the footer";
      environment = {
        # THE THEME, because this process is not the footer's child and
        # inherits nothing from it. Without these two the line would draw in
        # the fallback palette on a machine that chose another — a message
        # about the interface being gone is the one place the colours must not
        # be assumed.
        RONOCTUA_THEME = config.ronoctua.theme;
        RONOCTUA_THEMES = "${ronoctua.themed}";
      };
      after = [ "graphical-session.target" ];
      partOf = [ "graphical-session.target" ];
      serviceConfig = {
        ExecStart = "${ronoctua.shell}/bin/ronoctua-shell lifeline ronoctua-footer.service";
        Restart = "no";
        Slice = "session.slice";
        OOMPolicy = "stop";
      };
    };

    # -----------------------------------------------------------------
    # The compositor's config.
    #
    # `/etc/scroll/config` is where it lands, and the unit above passes it
    # with `-c` rather than relying on the search order — see there.
    #
    # WHAT IS NOT IN IT, ON PURPOSE:
    #  - no bar, dock, clock or launcher (invariant 14);
    #  - no shadow, no border radius, no blur (invariant 15).
    #
    # The leader key (section 7.4) is NOT configured as a state machine: a
    # single bind wakes the daemon and the sequence runs over there. What the
    # config holds are the CHORDS, generated from the same command table.
    # -----------------------------------------------------------------
    environment.etc."scroll/config".source = configScroll;

    environment.sessionVariables = {
      # THE LEADER'S ON-SCREEN LABEL comes from the SAME place as the bind,
      # just above. Two truths would be the screen saying `SPC` while the key
      # is something else — which is exactly the previous state.
      RONOCTUA_LEADER = "SUPER";
      # THE CHORD'S LABEL. In production it is the SAME key as the sequence's —
      # and that is the beauty of keyd: tapping opens the list, holding is the
      # modifier. In the nested loop the two diverge (`CTRL ALT SPC` against `ALT`),
      # and that is why the screen needs both variables instead of deriving one
      # from the other.
      RONOCTUA_LEADER_CHORD = "SUPER";
      # THE THEME the machine comes up in, and where the generator's fragments
      # are. The shell reads the first as the floor under the person's own
      # `theme.json`, and copies from the second when the theme changes. Both
      # places, for the reason `RONOCTUA_ICONS` gives: the footer is a user
      # unit and inherits the manager's environment, not a login shell's.
      RONOCTUA_THEME = config.ronoctua.theme;
      RONOCTUA_THEMES = "${ronoctua.themed}";
      # THE CAPTURE: where it goes, and what takes it.
      #
      # FROM THE ENVIRONMENT and not baked into the binary, for the reason
      # `RONOCTUA_SWAPPY` is: a store path compiled in is a reference no
      # profile switch can remove, and it would put the program in every
      # closure including the one that has no media at all.
      RONOCTUA_SCREENSHOTS = screenshotDir;
      RONOCTUA_GRIM = "${pkgs.grim}/bin/grim";
      NIXOS_OZONE_WL = "1";
      # Section 6.4: the renderer does NOT use fontconfig. But the foreign apps
      # do, and they need to find our .conf.
      # `scroll` FIRST because it is the truth, and `sway` in the list
      # because that is the name the portals and the wider ecosystem match
      # on. The compositor does not read this variable at all, so naming
      # both costs nothing inside and buys everything outside.
      XDG_CURRENT_DESKTOP = "scroll:sway:wlroots";
      XDG_SESSION_TYPE = "wayland";
    };
  };
}
