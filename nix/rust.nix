# Building the Rust workspace inside Nix — section 7.12.
#
# "`crane` to build the crates inside Nix."
#
# crane separates compiling the DEPENDENCIES from compiling our own code. That
# matters here more than usual: there are 204 pinned packages, and wgpu +
# cosmic-text alone take minutes. Without the separation, editing one of our
# lines would recompile everything — and principle no. 1 of section 15 is
# "feedback loop before any feature".
{
  lib,
  stdenv,
  pkgs,
  crane,
  rustToolchain,
  pkg-config,
  wayland,
  libxkbcommon,
  vulkan-loader,
  libGL,
  fonts,
  noto-fonts-color-emoji,
  tokensRs,
  i18nRs,
  niriActions,
  coreutils,
  util-linux,
  xdg-utils,
  systemd,
  niri,
  wl-clipboard,
  xwayland-satellite,
  bufferEditor,
  xkeyboard_config,
  glibcLocales,
  ghosttyVt,
  tzdata,
  bufferGlyphs,
  bufferUnicode,
  bufferLucide,
  iconSuperpack,
  lucideFontFile,
  primaryFontFile,
  src,
}:

let
  # `crane.mkLib` takes the whole `pkgs`, not an attrset with `system`.
  craneLib = (crane.mkLib pkgs).overrideToolchain rustToolchain;

  # The face embedded in the binary (see ronoctua-render): the installer runs on
  # a TTY before any GPU exists, and a minimal environment may not have
  # share/fonts mounted.
  #
  # It is the Iosevka WITHOUT the 75 codepoints whose default presentation is
  # emoji: the primary face wins the fallback chain, and with them it drew `UP!`
  # in monochrome next to a coloured `ATM`. See `nix/primary-font.nix`.
  regularFont = primaryFontFile;
  # THE EMOJI FACE, embedded alongside the Iosevka.
  #
  # The Iosevka draws 75 of the 1,184 single-codepoint emoji (6%), and none of the
  # 2,760 sequences — the rest would come out as tofu. This face is the only thing
  # on screen with colour outside the tokens, and the reason is that emoji are
  # CONTENT, like the clipboard's image preview, and not chrome.
  #
  # CBDT/CBLC bitmaps, which is the format `swash` decodes; `glyphon` already
  # has a separate colour atlas for it. See `crates/ronoctua-render/src/text.rs`.
  emojiFont = "${noto-fonts-color-emoji}/share/fonts/noto/NotoColorEmoji.ttf";

  # THE LUCIDE FACE, generated by `lucidegen.nix` rather than taken from a package.
  #
  # It is the Lucide font with its `cmap` REWRITTEN: the source codepoints
  # (`U+E038..U+E6BB`) collide with 634 of the Nerd Fonts ones inside the Iosevka,
  # and the primary face wins the fallback chain — the icons would come out drawn
  # as some other symbol, with no tofu to give it away. See `nix/lucidegen.nix`.
  lucideFont = lucideFontFile;

  # FILTERED source. Without this, any change under docs/ or nix/ would
  # invalidate the entire compilation cache.
  rustFont = lib.fileset.toSource {
    root = src;
    fileset = lib.fileset.unions [
      (src + "/Cargo.toml")
      (src + "/Cargo.lock")
      (lib.fileset.fileFilter (f: f.hasExt "rs") (src + "/crates"))
      (lib.fileset.fileFilter (f: f.name == "Cargo.toml") (src + "/crates"))
      # `buffers/` too: they are workspace members, and without them `cargo`
      # fails to resolve the root `Cargo.toml` — with a USAGE message, not a
      # missing-file one, which does not point at the cause.
      (lib.fileset.fileFilter (f: f.hasExt "rs") (src + "/buffers"))
      (lib.fileset.fileFilter (f: f.name == "Cargo.toml") (src + "/buffers"))
      # The `.wit` is invariant 11's boundary; without it `wit-bindgen` does not
      # generate and the buffer does not compile.
      (lib.fileset.fileFilter (f: f.hasExt "wit") (src + "/crates"))
      # The rectangle painter's `.wgsl`, embedded by `include_str!`.
      # The filter only let `.rs` through, and the error that gives —
      # "couldn't read quad.wgsl" — shows up in the NIX BUILD and not in the
      # local `cargo build`, which sees the whole tree.
      (lib.fileset.fileFilter (f: f.hasExt "wgsl") (src + "/crates"))
    ];
  };

  commonArgs = {
    src = rustFont;
    strictDeps = true;

    nativeBuildInputs = [ pkg-config ];
    buildInputs = [
      wayland
      libxkbcommon
      vulkan-loader
      libGL
    ];

    # The two generators. ronoctua-tokens's `build.rs` fails loudly if the
    # first is missing, instead of generating a fallback that would mask the error.
    RONOCTUA_TOKENS_RS = "${tokensRs}/tokens.rs";
    # The directory, not a file: the crate embeds the generated `keys.rs` AND the
    # `.ftl` files it came from.
    RONOCTUA_I18N_DIR = "${i18nRs}";
    # The compositor's action table, extracted from the PINNED niri. It is what
    # makes "every OS action has a command" true without a hand-written list.
    RONOCTUA_NIRI_ACTIONS = "${niriActions}/niri-actions.rs";
    RONOCTUA_FONT_REGULAR = regularFont;
    RONOCTUA_FONT_EMOJI = emojiFont;
    RONOCTUA_FONT_LUCIDE = lucideFont;

    # THE TWO PROGRAMS THE SHELL SPAWNS, BY PATH AND NOT BY NAME.
    #
    # Relying on `PATH` cost two VM tests: a systemd scope comes up with a
    # minimal `PATH`, and the failure shows up far from the cause — "cannot open
    # display" in the app, "failed to execute" on the terminal's SCREEN. With the
    # store path, the binary carries the reference and Nix guarantees it exists.
    RONOCTUA_SETSID = "${util-linux}/bin/setsid";
    # `choom` raises a foreign application's `oom_score_adj` so the kernel
    # reaches for it before it reaches for the compositor — see `foreign.rs`.
    RONOCTUA_CHOOM = "${util-linux}/bin/choom";
    # `keyboard-restore`'s `systemctl`. It runs from inside a user unit, where
    # PATH is minimal — see `crates/.../keyboard.rs`.
    RONOCTUA_SYSTEMCTL = "${systemd}/bin/systemctl";
    # The URL opener, for Syncthing's interface (`LEADER r s a`).
    # A store path, and not the name: inside a systemd unit PATH is
    # minimal and the failure would show up far from the cause.
    RONOCTUA_XDG_OPEN = "${xdg-utils}/bin/xdg-open";
    # What seals the Wi-Fi password into the TPM. A store path for the same reason
    # as the others: the agent runs as a systemd unit, where PATH is minimal.
    RONOCTUA_SYSTEMD_CREDS = "${systemd}/bin/systemd-creds";
    # THE COMPOSITOR'S OWN CLIENT, which runs the 141 mirrored actions.
    # It fills in arguments with defaults our JSON has no way of
    # knowing — see `ronoctua_niri::run_through_client`.
    RONOCTUA_NIRI = "${niri}/bin/niri";
    RONOCTUA_XWAYLAND_SATELLITE = "${xwayland-satellite}/bin/xwayland-satellite";
    # WHAT COPIES. `Efeito::Copiar` was a `tracing::info!` and nothing more: the
    # glyph browser's nine copy formats never put anything on the
    # clipboard.
    #
    # `wl-copy` and not a `wl_data_device` of our own because whoever OWNS the
    # selection has to stay alive to serve it, and the buffer's window dies when
    # the browser is closed — copying a glyph IN ORDER to close and paste is the
    # use case. `wl-copy` leaves a minimal process serving, which is what makes
    # the copy outlive the buffer.
    RONOCTUA_WL_COPY = "${wl-clipboard}/bin/wl-copy";
    # `wl-copy`'s PATH, and not ours.
    #
    # It does `exec cat` to serve the selection to whatever process pastes. Under a
    # systemd unit PATH is minimal, and `cat` is not there: the copy
    # failed with `exec cat: No such file or directory` — CLAUDE.md's trap one
    # level deeper, because what spawns by NAME is the program we
    # spawn by path.
    RONOCTUA_WL_COPY_PATH = lib.makeBinPath [ coreutils ];
    # What READS the clipboard, for `Ctrl+V`. Same package as
    # `wl-copy`, and the same reason for coming in by path.
    RONOCTUA_WL_PASTE = "${wl-clipboard}/bin/wl-paste";
    # The glyph browser's component, which the `glyphs.navigate` command
    # opens. A store path for the same reason as the two above — and a `.wasm`
    # is in no PATH at all.
    RONOCTUA_BUFFER_GLYPHS = "${bufferGlyphs}/lib/ronoctua_buffer_glyphs.wasm";
    # The file editor, which `LEADER f f` opens. Same reasoning: a `.wasm` is in
    # no PATH, so the store path is what the binary carries.
    RONOCTUA_BUFFER_EDITOR = "${bufferEditor}/lib/ronoctua_buffer_editor.wasm";
    # THE LIST OF xkb LAYOUTS, by store path.
    #
    # The installer validates the sixth answer against it, and it is the SAME
    # file the `keyboard-layout-exists` check reads — a hand-written list would
    # go stale and refuse a layout the system supports.
    #
    # A store path and not `/run/current-system/...`: the installer runs from the
    # ISO, where there is no current-system yet. Falling back to that path would
    # give an empty list, and validation would refuse everything.
    RONOCTUA_XKB_BASE_LST = "${xkeyboard_config}/share/X11/xkb/rules/base.lst";
    # THE LOCALE LIST, from glibc's own `SUPPORTED`, for the same reason and by
    # the same route: the installer offers what the system can generate, and a
    # list written by hand here would refuse a locale glibc supports.
    RONOCTUA_LOCALE_SUPPORTED = "${glibcLocales}/share/i18n/SUPPORTED";
    # THE TIMEZONE LIST, from tzdb's own table. Same route, same reason: the
    # installer offers what the system has, and never a list kept by hand.
    RONOCTUA_TZ_TAB = "${tzdata}/share/zoneinfo/zone1970.tab";
    # The console prompt, for the boot with nobody logged in. By PATH: a unit's
    # `PATH` is minimal and a bare name fails far from the cause.
    RONOCTUA_ASK_PASSWORD = "${systemd}/bin/systemd-ask-password";
    # The terminal engine. `ronoctua-term`'s `build.rs` reads this to find the
    # library; without it the crate compiles with the alacritty engine alone,
    # and the differential degrades to a golden file — which it says out loud.
    RONOCTUA_GHOSTTY_VT = "${ghosttyVt}";
    RONOCTUA_BUFFER_UNICODE = "${bufferUnicode}/lib/ronoctua_buffer_unicode.wasm";
    RONOCTUA_BUFFER_LUCIDE = "${bufferLucide}/lib/ronoctua_buffer_lucide.wasm";
    # THE ICON SUPERPACKAGE — the PIXMAP step of section 4.2's chain, for a
    # FOREIGN application that brings its own `Icon=`. It had existed since the
    # icons milestone and never had a path into the Rust: `Cadeia` has the field
    # `superpacote` and nobody filled it in.
    #
    # Invariant 10 still stands: what consults it is the HOST, and no
    # design system component reaches it — the WIT `world` has no
    # filesystem.
    RONOCTUA_ICONS = "${iconSuperpack}/share/icons/noctua";
  };

  # The dependencies, compiled once. Editing our code does not invalidate them.
  cargoArtifacts = craneLib.buildDepsOnly (commonArgs // { pname = "ronoctua-deps"; });
in
rec {
  inherit cargoArtifacts craneLib;
  # Exposed so the devshell can offer the SAME environment as crane — see the
  # comment over there.
  inherit regularFont emojiFont lucideFont;

  # The built workspace.
  workspace = craneLib.buildPackage (
    commonArgs
    // {
      inherit cargoArtifacts;
      pname = "ronoctua";
      doCheck = false; # the tests have a derivation of their own, so they fail separately

      # The binary has to find the graphics libraries at runtime. Without this,
      # `wgpu` does not find the Vulkan loader and falls back to software silently.
      postFixup = ''
        for b in $out/bin/*; do
          patchelf --add-rpath "${
            lib.makeLibraryPath [
              vulkan-loader
              wayland
              libxkbcommon
              libGL
            ]
          }" "$b" || true
        done
      '';
      nativeBuildInputs = commonArgs.nativeBuildInputs ++ [ stdenv.cc.bintools ];
    }
  );

  # ONLY `ronoctua-install`, and it is the ISO that wants it.
  #
  # # What the whole workspace was costing the ISO
  #
  # `nix/installer/iso.nix` used to install `workspace`, which is ONE derivation
  # holding EVERY binary — and a derivation references whatever its bytes
  # mention. `ronoctua-shell` mentions `libghostty-vt`, which drags Zig, clang
  # and LLVM (1,7 GiB measured), and through the `option_env!` paths set above it
  # mentions the icon superpack (0,61 GiB) and the fonts. A console installer has
  # no desktop and no compiler; none of that could ever run there.
  #
  # # Why copying one file is enough
  #
  # Nix scans the OUTPUT for store paths. What the copied bytes do not name stops
  # being a reference — so the extraction is the whole mechanism, not a hint to
  # the garbage collector.
  #
  # What it does still name is what it uses: `base.lst`, glibc's `SUPPORTED` and
  # `zone1970.tab`, which are the three lists the questions are built from.
  installer = pkgs.runCommand "ronoctua-installer" { nativeBuildInputs = [ pkgs.patchelf ]; } ''
    mkdir -p $out/bin
    cp ${workspace}/bin/ronoctua-install $out/bin/
    chmod +w $out/bin/ronoctua-install

    # `workspace` adds the graphics rpath to EVERY binary it produces, and
    # the installer draws no graphics. Left in place it would reference the
    # Vulkan loader and mesa for a program that runs on a TTY.
    patchelf --shrink-rpath $out/bin/ronoctua-install
  '';

  # Tests. A separate derivation so it can say WHAT broke.
  tests = craneLib.cargoTest (
    commonArgs
    // {
      inherit cargoArtifacts;
      pname = "ronoctua-tests";
    }
  );

  # Clippy with `-D warnings`: a warning becomes an error.
  clippy = craneLib.cargoClippy (
    commonArgs
    // {
      inherit cargoArtifacts;
      pname = "ronoctua-clippy";
      cargoClippyExtraArgs = "--all-targets -- --deny warnings";
    }
  );

  # Formatting.
  fmt = craneLib.cargoFmt {
    inherit (commonArgs) src;
    pname = "ronoctua-fmt";
  };
}
