# The cache policy, from Nix to Rust.
#
# `assets/cache.nix` is the one place the numbers live. This turns them into a
# Rust file three crates include, and — the part that matters — REFUSES THE
# BUILD when a relationship between them stops holding.
#
# # Why a whole derivation for four integers
#
# Because they are read from two languages and the relationship between two of
# them is load-bearing. `freshDays` must stay below `keepDays`: renewing a
# thumbnail at ten days is precisely what keeps one that somebody looks at from
# ever reaching twenty and being swept. Swap them and nothing fails, nothing
# logs, and a folder one opens every week loses its pictures on a schedule.
#
# It is deliberately NOT a token. `assets/tokens/*.nix` is generated by
# `gen-tokens.py`, which documents every `space.*` value as "in cells" — a day
# count filed there would ship with a comment that is simply false, and
# invariant 9 is about colour, font, size and spacing, not about policy.
#
# # Why no Python
#
# The update's `sequence.nix` needs a generator because a step is a command line with
# preconditions and an order to validate. This is four integers and a word. A
# generator would be a file to read before believing the numbers.
{
  lib,
  writeTextFile,
  cacheFile,
}:

let
  declared = import cacheFile;

  # THE WINDOWS THE BRAIN KNOWS, by the word `PartOfDay::word` answers with.
  # A fifth word here would be a row on the brain's screen drawing a bracketed
  # key, so the list is closed and the build says which word it did not know.
  windows = [
    "any"
    "night"
    "morning"
    "afternoon"
    "evening"
  ];

  positive =
    name: value:
    lib.assertMsg (
      lib.isInt value && value > 0
    ) "assets/cache.nix: `${name}` must be a positive whole number, not ${builtins.toJSON value}";

  # A PERCENTAGE OF A DISK, and the disk's percentages below are only ever
  # compared with each other: a whole number strictly between 0 and 100.
  percent =
    name: value:
    lib.assertMsg (lib.isInt value && value > 0 && value < 100)
      "assets/cache.nix: `${name}` must be a whole percentage between 1 and 99, not ${builtins.toJSON value}";
in
assert positive "keepDays" declared.keepDays;
assert positive "everyDays" declared.everyDays;
assert positive "freshDays" declared.freshDays;
assert positive "trashDays" declared.trashDays;
assert positive "trashEveryDays" declared.trashEveryDays;
assert lib.assertMsg (builtins.elem declared.partOfDay windows)
  "assets/cache.nix: `partOfDay` is ${builtins.toJSON declared.partOfDay}, which is not one of ${builtins.toJSON windows}";
# THE ONE RELATIONSHIP, and the reason this file is a derivation at all.
assert lib.assertMsg (declared.freshDays < declared.keepDays) ''
  assets/cache.nix: `freshDays` (${toString declared.freshDays}) must be smaller than
  `keepDays` (${toString declared.keepDays}).

  Renewing a thumbnail before it expires is what keeps one that somebody
  actually looks at from ever being swept. The other way round, a folder opened
  every week loses its pictures on a schedule, and nothing anywhere says why.
'';
# AND THE SWEEP HAS TO HAPPEN MORE OFTEN THAN THINGS EXPIRE, or a file lives up
# to `keepDays + everyDays` and the number on the screen is not the number.
assert lib.assertMsg (declared.everyDays < declared.keepDays)
  "assets/cache.nix: `everyDays` (${toString declared.everyDays}) must be smaller than `keepDays` (${toString declared.keepDays})";

# THE DISK'S NUMBERS, and the relationships that keep them meaning what
# `assets/cache.nix` says.
assert percent "diskFloorPercent" declared.diskFloorPercent;
assert percent "diskGoalPercent" declared.diskGoalPercent;
assert percent "cargoCeilingPercent" declared.cargoCeilingPercent;
assert positive "diskFloorCapGiB" declared.diskFloorCapGiB;
assert positive "diskGoalCapGiB" declared.diskGoalCapGiB;
assert positive "systemGenerations" declared.systemGenerations;
assert positive "buildLogDays" declared.buildLogDays;
assert positive "oldCompilerDays" declared.oldCompilerDays;
assert positive "reliefGapMinutes" declared.reliefGapMinutes;
# The goal above the floor, or a collection that reached its goal would be
# below the floor again at the next build — a relief every heartbeat.
assert lib.assertMsg (declared.diskFloorPercent < declared.diskGoalPercent)
  "assets/cache.nix: `diskFloorPercent` (${toString declared.diskFloorPercent}) must be smaller than `diskGoalPercent` (${toString declared.diskGoalPercent})";
# And the caps in the same order, or a big disk's goal would sit under its
# floor — the same relief every heartbeat, by another road.
assert lib.assertMsg (declared.diskFloorCapGiB < declared.diskGoalCapGiB)
  "assets/cache.nix: `diskFloorCapGiB` (${toString declared.diskFloorCapGiB}) must be smaller than `diskGoalCapGiB` (${toString declared.diskGoalCapGiB})";
# The cargo tree inside what the goal leaves, or the cargo tree alone could hold
# the disk under the floor with nothing else on it.
assert lib.assertMsg (declared.cargoCeilingPercent < 100 - declared.diskGoalPercent)
  "assets/cache.nix: `cargoCeilingPercent` (${toString declared.cargoCeilingPercent}) must be smaller than 100 - `diskGoalPercent` (${toString declared.diskGoalPercent})";
# An old compiler's build goes before an ordinary cache entry would.
assert lib.assertMsg (declared.oldCompilerDays < declared.keepDays)
  "assets/cache.nix: `oldCompilerDays` (${toString declared.oldCompilerDays}) must be smaller than `keepDays` (${toString declared.keepDays})";
# Two, at least: the rescue console's rollback (`nix/modules/rescue.nix`) goes to
# the PREVIOUS generation, and a count of one would leave it nowhere to go.
assert lib.assertMsg (declared.systemGenerations >= 2)
  "assets/cache.nix: `systemGenerations` (${toString declared.systemGenerations}) must be at least 2 — the rescue console's rollback needs the previous generation";
# An hour at least, the brain's activity-log rule: a machine short of disk must
# not spend what it has left on a relief every heartbeat.
assert lib.assertMsg (declared.reliefGapMinutes >= 60)
  "assets/cache.nix: `reliefGapMinutes` (${toString declared.reliefGapMinutes}) must be at least 60";
# THE "NEARLY FULL" LINE, UNDER THE FLOOR — and its cap under the floor's. At
# or above the floor, the modeline's mark would come up every time the relief
# starts and go away every time it works: a mark about something the machine
# is already handling.
assert percent "diskWarnPercent" declared.diskWarnPercent;
assert positive "diskWarnCapGiB" declared.diskWarnCapGiB;
assert lib.assertMsg (declared.diskWarnPercent < declared.diskFloorPercent)
  "assets/cache.nix: `diskWarnPercent` (${toString declared.diskWarnPercent}) must be smaller than `diskFloorPercent` (${toString declared.diskFloorPercent})";
assert lib.assertMsg (declared.diskWarnCapGiB < declared.diskFloorCapGiB)
  "assets/cache.nix: `diskWarnCapGiB` (${toString declared.diskWarnCapGiB}) must be smaller than `diskFloorCapGiB` (${toString declared.diskFloorCapGiB})";
# THE PLAYER'S SUBTITLES: a ceiling of nothing would read every track again at
# every lane change, which is the cost the cache exists to spare.
assert positive "playerSubtitlesMib" declared.playerSubtitlesMib;
# AND ITS CACHE ON DISK: a ceiling of nothing would take every cover out of
# its file again at every song.
assert positive "playerMib" declared.playerMib;
# THE TRANSLATIONS KEPT: a bound of nothing would ask the host again for every
# song that comes round, spending the person's quota on an answer the process
# had.
assert positive "wordsCacheEntries" declared.wordsCacheEntries;
# THE RATES' AGE: an age of nothing would ask the ECB again at every currency
# typed.
assert positive "ratesStaleHours" declared.ratesStaleHours;
# THE PLAYER'S CATALOGUE: a ceiling of nothing would refuse every ingest.
assert positive "playerCatalogMib" declared.playerCatalogMib;
# THE VIDEO-METRICS THUMBNAILS: a ceiling of nothing would fetch every picture
# again at every scan.
assert positive "videoMetricsThumbsMib" declared.videoMetricsThumbsMib;
# archive-luks: THE ARCHIVE LISTINGS KEPT and THE OPENED MEMBERS' CEILING — a
# bound of nothing would list an archive again at every step into it, and
# extract a member only to throw it away before it opened.
assert positive "archiveListings" declared.archiveListings;
assert positive "archiveOpenedMib" declared.archiveOpenedMib;
# THE GIT BROWSER'S OLD VERSIONS: a bound of nothing would remove every copy
# the moment it was made, before the program opening it had read it.
assert positive "gitVersionsMost" declared.gitVersionsMost;
# THE CALCULATOR'S HISTORY: a bound of nothing would keep no answer at all.
assert positive "calcHistoryEntries" declared.calcHistoryEntries;
# THE CATALOGUE'S POSTERS: a ceiling of nothing would fetch every poster again
# at every scroll.
assert positive "playerPostersMib" declared.playerPostersMib;
# FAST-ACCESS: a ceiling of nothing would fetch every picture of a search
# again, and a history of nothing would remember nothing it opened.
assert positive "webThumbsMiB" declared.webThumbsMiB;
assert positive "fastAccessRecentMost" declared.fastAccessRecentMost;
# THE LLM TOKEN COUNTS: a window of nothing counts nothing, and a memory of
# nothing counts every answer a resumed session copied twice.
assert positive "llmTokenDays" declared.llmTokenDays;
assert positive "llmSeenMost" declared.llmSeenMost;
# THE TLS GROUPS KEPT: a bound of nothing would keep no host, and the quantum
# section would have nothing to say about any of them.
assert positive "tlsGroupsHosts" declared.tlsGroupsHosts;

writeTextFile {
  name = "ronoctua-cache-rs";
  destination = "/cache.rs";
  text = ''
    // Generated from `assets/cache.nix`. Do not edit.
    //
    // The arguments for every number are in that file; what is here is the
    // number. See `nix/cache.nix` for what the build refuses.

    /// How old a cached file may get before the sweep takes it, in days.
    pub const KEEP_DAYS: u16 = ${toString declared.keepDays};

    /// How often the sweep runs, in days.
    pub const EVERY_DAYS: u16 = ${toString declared.everyDays};

    /// When in the day it runs, as one of the brain's window words.
    pub const PART_OF_DAY: &str = "${declared.partOfDay}";

    /// When the file manager remakes a thumbnail it already has, in days.
    pub const FRESH_DAYS: u16 = ${toString declared.freshDays};

    /// How long something stays in the trash, in days.
    ///
    /// Counted from `DeletionDate`, which the freedesktop spec writes into
    /// every `.trashinfo` — never from the file's own timestamps.
    pub const TRASH_DAYS: u16 = ${toString declared.trashDays};

    /// How often the trash is emptied of what is past that, in days.
    pub const TRASH_EVERY_DAYS: u16 = ${toString declared.trashEveryDays};

    /// Below this much free space, in per cent of the filesystem, space is made.
    pub const DISK_FLOOR_PERCENT: u8 = ${toString declared.diskFloorPercent};

    /// And until this much is free, in per cent.
    pub const DISK_GOAL_PERCENT: u8 = ${toString declared.diskGoalPercent};

    /// The floor is never more than this, in GiB.
    pub const DISK_FLOOR_CAP_GIB: u32 = ${toString declared.diskFloorCapGiB};

    /// Nor the goal more than this, in GiB.
    pub const DISK_GOAL_CAP_GIB: u32 = ${toString declared.diskGoalCapGiB};

    /// The most every cargo build directory under the cache may weigh together,
    /// in per cent of their filesystem.
    pub const CARGO_CEILING_PERCENT: u8 = ${toString declared.cargoCeilingPercent};

    /// A build by a compiler that is not the newest goes whole after this many
    /// days untouched.
    pub const OLD_COMPILER_DAYS: u16 = ${toString declared.oldCompilerDays};

    /// How long a relief waits after the last one, in minutes.
    pub const RELIEF_GAP_MINUTES: u32 = ${toString declared.reliefGapMinutes};

    /// Below this much free space, in per cent of the filesystem, the disk is
    /// nearly full and the modeline says so.
    pub const DISK_WARN_PERCENT: u8 = ${toString declared.diskWarnPercent};

    /// That line is never more than this, in GiB.
    pub const DISK_WARN_CAP_GIB: u32 = ${toString declared.diskWarnCapGiB};

    /// The most the player's daemon keeps, in memory, of the subtitle tracks
    /// it read, in MiB.
    pub const PLAYER_SUBTITLES_MIB: u32 = ${toString declared.playerSubtitlesMib};

    /// The most the player keeps in its cache directory on disk, in MiB.
    pub const PLAYER_MIB: u32 = ${toString declared.playerMib};

    /// The most translations a process keeps in memory, in entries.
    pub const WORDS_CACHE_ENTRIES: usize = ${toString declared.wordsCacheEntries};

    /// How old the cached exchange rates may be before a currency typed asks
    /// for fresh ones, in hours.
    pub const RATES_STALE_HOURS: u32 = ${toString declared.ratesStaleHours};

    /// The most the player's local catalogue (its two SQLite files) may hold,
    /// in MiB.
    pub const PLAYER_CATALOG_MIB: u32 = ${toString declared.playerCatalogMib};

    /// The most the video-metrics scanner keeps of its thumbnails, in MiB.
    pub const VIDEO_METRICS_THUMBS_MIB: u32 = ${toString declared.videoMetricsThumbsMib};

    /// How many archive listings a process keeps, in listings.
    pub const ARCHIVE_LISTINGS: usize = ${toString declared.archiveListings};

    /// The most the members opened out of archives may weigh, in MiB.
    pub const ARCHIVE_OPENED_MIB: u32 = ${toString declared.archiveOpenedMib};

    /// The most old versions the git browser keeps copied out, in copies.
    pub const GIT_VERSIONS_MOST: usize = ${toString declared.gitVersionsMost};

    /// The most answers the calculator's history keeps (`calc.json`).
    pub const CALC_HISTORY_ENTRIES: usize = ${toString declared.calcHistoryEntries};

    /// The most the player's catalogue keeps of its posters, in MiB.
    pub const PLAYER_POSTERS_MIB: u32 = ${toString declared.playerPostersMib};

    /// The most fast-access keeps of YouTube's pictures, in MiB.
    pub const WEB_THUMBS_MIB: u32 = ${toString declared.webThumbsMiB};

    /// The most entries fast-access remembers of what was opened from it.
    pub const FAST_ACCESS_RECENT_MOST: usize = ${toString declared.fastAccessRecentMost};

    /// How many days back the LLM accounts' token counts reach.
    pub const LLM_TOKEN_DAYS: u32 = ${toString declared.llmTokenDays};

    /// The most answers the token count remembers, so each is counted once.
    pub const LLM_SEEN_MOST: usize = ${toString declared.llmSeenMost};

    /// The most hosts whose agreed TLS group is kept (`tls-groups.json`).
    pub const TLS_GROUPS_HOSTS: usize = ${toString declared.tlsGroupsHosts};
  '';
}
