# direnv — enters the devshell on `cd`, once and never again.
#
# Without direnv, use `nix develop`. It is a program of YOUR system, not of the
# flake: the flake cannot provide it, because you would need it BEFORE being able
# to enter the environment.

if ! has nix_direnv_version || ! nix_direnv_version 3.0.4; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.4/direnvrc" \
    "sha256-DzlYZ33mWF/Gs8DDeyjr8mnVmQGx7ASYqA5WlxwvBG4="
fi

use flake

# Outside the tree, and not in `./target`. The reason is in `nix/devshell.nix`:
# what git does not filter, Nix copies whole into the store on every edit.
export CARGO_TARGET_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/ronoctua-distro/target"

# Re-enter the shell when what DEFINES it changes. Without these two, editing a
# dependency leaves you inside a shell built from the previous version, and the
# failure shows up far from the edit.
watch_file flake.nix
watch_file nix/devshell.nix
