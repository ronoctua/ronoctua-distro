  "com.aurora.store": {
   "metadata": {
    "added": 1555113600000,
    "categories": [
     "App Store & Updater",
     "System"
    ],
    "changelog": "https://gitlab.com/AuroraOSS/AuroraStore/blob/HEAD/CHANGELOG",
    "issueTracker": "https://gitlab.com/AuroraOSS/AuroraStore/issues",
    "lastUpdated": 1785492883879,
    "license": "GPL-3.0-or-later",
    "sourceCode": "https://gitlab.com/AuroraOSS/AuroraStore",
    "translation": "https://hosted.weblate.org/engage/aurora-store",
    "webSite": "http://auroraoss.com",
    "name": {
     "en-US": "Aurora Store"
    },
    "summary": {
     "en-US": "An unofficial FOSS client to Google Play with an elegant design and privacy",
     "pt-BR": "Um cliente FOSS do Google Play com privacidade e um design elegante"
    },
    "description": {
     "en-US": "Aurora Store is an unofficial, FOSS client to Google Play with an elegant design. Aurora Store allows users to download, update, and search for apps like the Play Store. It works perfectly fine with or without Google Play Services or microG.\n\n<b>Features:</b>\n\n• FOSS: Has GPLv3 licence\n• Beautiful design: Built upon latest Material 3 guidelines\n• Account login: You can login with either personal or an anonymous account\n• Device & Locale spoofing: Change your device and/or locale to access geo locked apps\n• Exodus Privacy integration: Instantly see trackers in app\n• Plexus integration: Instantly see app compatibility without Google Play Services or with microG\n• Updates blacklisting: Ignore updates for specific apps\n",
     "pt-BR": "A Aurora Store é um cliente FOSS não oficial do Google Play com um design elegante. A Aurora Store permite que usuários baixem, atualizem, e busquem apps assim como a Play Store. Ele funciona perfeitamente sem o Google Play Services ou o microG.\n\n<b>Recursos:</b>\n\n• FOSS (software livre): licença GPLv3\n• Interface bonita: construído com base nas diretrizes do Material Design 3 mais recentes\n• Conta: Você pode se conectar com uma conta pessoal ou anônima\n• Simulação de dispositivo e localidade: Altere seu dispositivo ou sua localidade para acessar apps bloqueados em certos lugares\n• Integração com o Exodus Privacy: Veja os rastreadores diretamente no app\n• Integração com o Plexus: Veja a compatibilidade dos apps sem o Google Play Services ou com o microG, diretamente no app\n• Bloqueio de atualizações: Ignore as atualizações de apps específicos\n"
    },
