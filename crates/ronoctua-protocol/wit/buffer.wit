// A native buffer's interface — sections 7.8 and 7.9.
//
// ONE interface, small on purpose. Every extra capability is surface
// that every future buffer gets to use, and invariant 11 lives
// precisely off what is NOT here: there is no Wayland import, no access to
// tokens by value, no translation.
package ronoctua:buffer@0.1.0;

interface types {
    // THE COLOUR ENUM IS GENERATED, and comes from `assets/tokens/colors.nix`.
    //
    // This used to be `record color { token: string }`, and a free string
    // means `color.inexistente` compiles and fails silently on screen.
    // With the enum, `wit-bindgen` generates a Rust enum in the guest: the wrong name
    // does not exist, and the error comes from the compiler.
    //
    // Section 7.6 asks for exactly this: "the build generates (a) the shell's Rust table
    // and (b) a WIT enum of valid names. A non-existent token becomes a compile
    // error in the guest."
    use ronoctua:tokens/tokens@0.1.0.{color, icon};

    // Data comes out literal; a label comes out as a key and the host translates; an icon is a
    // TOKEN, and what knows its codepoint is the host.
    //
    // `icon` came in for the same reason `color` is an enum: without it, a buffer
    // that wanted a magnifying glass would have to write the PUA character by hand — a
    // codepoint that changes between Nerd Fonts versions, embedded in a
    // component that has no way of knowing that. By naming the token, what resolves it
    // is whoever has the table (invariants 9, 10 and 11).
    variant text {
        data(string),
        key(string),
        icon(icon),
    }

    // TEXT SIZE, by NAME and never in pixels.
    //
    // Invariant 11 is explicit: a buffer does not receive a token value. It says
    // "large" and the host decides how many pixels that is worth — exactly as it does
    // with colour.
    //
    // Per RUN and not per buffer: it used to be a field of the descriptor, and that is why
    // the glyph browser's header and footer grew along with the
    // icons. What has to be large there is the GLYPH; the surrounding text is
    // text, and reading it at 32 point is uncomfortable.
    //
    // THE CELL GRID is still the normal size's. A large run
    // occupies more than one cell, and what spaces it is whatever draws — that is how
    // the browser's grid came to move two rows at a time.
    enum scale {
        // Smaller than the buffer's body. For whatever ACCOMPANIES the content without
        // competing with it — today the focused glyph's tags and the counter.
        small,
        // THE SYSTEM'S SIZE: the same as the footer's and the minibuffer's.
        //
        // For whatever is INTERFACE inside a buffer, and not its content —
        // today the browser's search field. A search field is the same
        // thing as the minibuffer, and seeing the two at different sizes on the
        // same screen is the kind of detail that makes a system look assembled
        // out of parts of different origins.
        base,
        // The buffer's content. LARGER than the system's on purpose: the
        // footer is peripheral reference, the buffer is what one reads.
        normal,
        large,
        // The screen's subject. Today only the glyph on the browser's sheet.
        huge,
    }

    record text-command {
        line: u16,
        column: u16,
        content: text,
        color: color,
        scale: scale,
        // How many cells this run may occupy. `0` = to the edge.
        //
        // # Why the BUDGET, and not the already-cut text
        //
        // A buffer cannot elide a `key`: what translates is the host, and the
        // sentence's length changes with the language — "Type to search for a Nerd
        // Fonts glyph" and "Digite para buscar um glyph das Nerd Fonts" are not
        // the same length. What the buffer knows is how much SPACE there is; whoever has
        // the string is whoever cuts.
        //
        // Without this, the invitation ran over the counter in a narrow
        // window: text over text, the worst possible result because
        // neither of the two stays legible.
        max-width: u16,
    }

    record line-command {
        line: u16,
        color: color,
    }

    // THE GRID IS A FIRST-CLASS NODE, and not a `raw-surface` (section 7.10).
    //
    // `raw-surface` would mean a second text rasteriser in the system,
    // with its own font resolution, metrics and theme — exactly what the
    // display list decision exists to prevent, and in the most-used buffer.
    //
    // The content arrives as already-formed lines; the host draws with the SAME font
    // and the SAME tokens as everything else.
    record grid-command {
        line: u16,
        column: u16,
        // One string per grid row, in order.
        lines: list<string>,
        color: color,
    }

    // A VECTOR DRAWING, in the given rectangle of cells.
    //
    // # The FIRST pixel primitive in this list, and why it exists
    //
    // Lucide's customisation changes the stroke's width, cap and colour, and a
    // GLYPH honours none of that: the width is baked into the drawing, and
    // Lucide publishes only one. Until now the only honest way out was to say the
    // screen does not show it — and the owner asked for it to be shown.
    //
    // The buffer sends the SAME document the copy would deliver. There is no
    // second builder, and that is what makes the preview the artefact instead of
    // an approximation of it.
    //
    // # What it does NOT open
    //
    // The host rasterises with `resvg` compiled WITHOUT a text engine: `<text>`
    // does not draw. And with no `resources-dir`: a reference to an external file does not
    // load. The surface is "a vector drawing", and not "a document".
    //
    // # Why it requires a capability
    //
    // Because it is the only primitive that produces arbitrary pixels, and this file's
    // header says that every extra surface is surface that EVERY
    // future buffer gets to use. Whoever emits this without declaring
    // `capability::vector` is refused at load time.
    record svg-command {
        line: u16,
        column: u16,
        // The rectangle, in CELLS. The host fits the drawing inside it without
        // stretching — the buffer knows neither pixels nor screen aspect ratio.
        lines: u16,
        columns: u16,
        // The document, as the copy would deliver it.
        svg: string,
        // The token that replaces `currentColor`.
        //
        // THE COLOUR DOES NOT CROSS AS A VALUE (invariant 11). Lucide's SVG comes
        // out with `currentColor` by default, and `currentColor` with no context is
        // BLACK: over the buffer's background, an invisible drawing — which is
        // indistinguishable from "not implemented yet". What resolves the value is
        // whoever has the table.
        //
        // When the person types a colour of their own, there is no `currentColor` to
        // replace and the drawing comes out in their colour. There it is CONTENT, not chrome.
        color: color,
    }

    variant command {
        text(text-command),
        rule(line-command),
        selection(line-command),
        grid(grid-command),
        svg(svg-command),
    }

    // What the buffer ASKS to happen. `tecla` used to return `bool` — the
    // buffer said "I changed", never what should happen, and that is why it could
    // not ask for a copy nor fire a command (sections 6.5 and 7.6).
    variant effect {
        // Redraw: the internal state changed.
        redraw,
        // Put this on the clipboard.
        copy(string),
        // Run the named command. It is the registry's id, not a function —
        // section 13 requires everything to be addressable by name.
        command(string),
        // Close this buffer.
        close,
        // Write this text to the file the buffer was opened with.
        //
        // WHY IT IS NOT `copy`: `copy` goes to the clipboard, and saving goes to
        // disk. Reusing it would put the file's whole content on the clipboard
        // as a side effect of saving — a surprise nobody would connect to the
        // key they pressed.
        //
        // The buffer STILL has no filesystem (invariant 11): it hands the text
        // over and the HOST writes, the same way `paste` is how text gets in.
        // That is what keeps a file editor from needing a new capability.
        save(string),
        // Ask the host to do something to the machine's memory or disk.
        //
        // Requires `capability::system`. NOT `command(string)`: that one is an
        // id from the registry and carries no argument, and "close pid 4321"
        // needs one. Smuggling the number inside the string would be the buffer
        // inventing a syntax and the host parsing it — which is the shape this
        // file refuses everywhere else.
        ask(demand),
        // Write a filesystem. Needs `capability::disks`.
        //
        // THE ONE EFFECT THAT DESTROYS SOMETHING NOBODY GETS BACK, which is why
        // it is not folded into `ask`: the reader of this file should see it
        // named, and the capability gate should have one arm to point at.
        format(plan),
        // "I AM IN THIS STATE NOW", after changing on my own.
        //
        // Typing a letter into the icon browser enters its search; nobody
        // pressed a key that means "enter search", so the host has no way to
        // know. Without this the modeline would be truthful only about the
        // changes the host itself caused — which is the same class of lie as a
        // cached branch name, and worse, because this one changes every time
        // somebody types.
        //
        // The id has to be one the descriptor declared. The host refuses any
        // other, rather than putting a word on the modeline that no key can
        // return from.
        state-changed(string),
    }

    // Capabilities a buffer may ASK for in the descriptor. The host refuses whoever
    // uses one without asking, and the list is short on purpose: each is
    // surface that every future buffer gets to use.
    enum capability {
        // Access to the PTY and the VT state machine, which live in the host.
        terminal,
        // An offscreen texture for whoever needs pixels: an image viewer,
        // video. "Rare and auditable" (section 7.6).
        raw-surface,
        // Emitting `command::svg` — a vector drawing rasterised by the host.
        //
        // Less than `raw-surface`: there is no texture, no pixel coming from the
        // guest, and what can be drawn is a vector the host interprets and
        // clips. It is the difference between "the buffer sends pixels" and "the buffer
        // sends a figure".
        vector,
        // Receiving `input::survey` and emitting `effect::ask` — how much memory
        // the machine has, who is eating it, and asking for something to be done
        // about it.
        //
        // # Why it is a capability and not just two more cases
        //
        // Because of this file's own header: every extra surface is surface that
        // EVERY future buffer gets to use. A buffer that never asked for this one
        // receives no survey and has its demand refused — the same shape as
        // `vector`, which exists so that "the buffer sends a figure" cannot
        // quietly become "any buffer sends pixels".
        //
        // # What it does NOT open
        //
        // The buffer still has no filesystem, no clock and no socket. It does not
        // read `/proc`, does not talk to systemd and does not run a command: it
        // receives numbers ALREADY READ and names what it wants done. Whoever
        // reads and whoever acts is the host — invariant 11 intact.
        system,
        // Receiving `input::queue` and asking for a job to be paused, resumed,
        // cancelled or forgotten.
        //
        // # Why not `system`
        //
        // Because they are different powers over different things, and one
        // capability covering both would give the memory panel the right to
        // cancel a copy of forty gibibytes. `system` closes processes and
        // sweeps the store; this one only touches a queue the host owns. A
        // buffer that wants both asks for both, and the descriptor says so.
        //
        // # What it does NOT open
        //
        // The same as `system`: no filesystem, no socket, no clock. The rows
        // arrive already read and already cut, and the buffer names an id it
        // was given — it cannot invent one that means anything, because the
        // host checks the id against the list it just sent.
        transfers,
        // Receiving `input::rack` and asking for a disk to be formatted.
        //
        // # Why a third one, and not `system`
        //
        // Because it is the largest power any buffer has ever asked for: it
        // ends with a partition being overwritten, and no other capability can
        // destroy anything a person cannot get back. `system` closes processes
        // and sweeps the store — both recoverable; `transfers` cancels a copy
        // that can be started again. Folding this into either would hand that
        // reach to the memory panel, which asked for neither.
        //
        // # What it does NOT open
        //
        // The same as the other two: no filesystem, no socket, no clock, no
        // parser. The devices arrive already read, already filtered and already
        // judged — including WHICH ONES THE RUNNING SYSTEM NEEDS — and the
        // buffer names an id it was given. The host checks that id against the
        // list it just sent AND refuses one the system needs, because a guard
        // that lives only inside the thing being guarded holds until somebody
        // writes a second buffer.
        disks,
    }

    // ------------------------------------------------------------------
    // The system's memory, for whoever declared `capability::system`.
    // ------------------------------------------------------------------

    // WHAT a number measures. An enum, and never a free string.
    //
    // The same reason `color` stopped being `record { token: string }`: a typo in
    // a string compiles and fails in silence on screen. And the harder rule from
    // `CLAUDE.md` — a buffer has no JSON parser, so no field carries raw
    // characters for the guest to take apart. The host reads `/proc`; what
    // crosses is already a number with a name.
    enum gauge {
        // /proc/meminfo, the part a person recognises.
        ram-total,
        ram-available,
        ram-free,
        // What the kernel can hand back under pressure: the reason "used" and
        // "unavailable" are different numbers, and why a machine with 90% "used"
        // may be perfectly healthy.
        ram-cached,
        ram-buffers,
        ram-shmem,
        ram-slab-reclaimable,
        ram-dirty,
        ram-anonymous,
        ram-kernel,
        // /proc/swaps and /sys/block/zram0/mm_stat.
        swap-total,
        swap-free,
        // The three that make compression legible: what was written, what it
        // occupies compressed, and the ceiling zram may take from RAM.
        zram-original,
        zram-compressed,
        zram-limit,
        // The cgroups the policy names (`nix/modules/memory.nix`): what is
        // RESERVED for the desktop and what the applications have actually spent.
        desktop-min,
        desktop-current,
        app-current,
        app-ceiling,
        system-current,
        // THE GRAPHICS MEMORY, when the driver reports it.
        //
        // On this machine's APU it comes OUT OF THE SAME RAM — which is why it
        // belongs on a screen about memory rather than on one about the screen.
        // A driver that does not publish it simply does not appear in the list.
        vram-total,
        vram-used,
        // Disk, from `statvfs` — which costs a syscall and may be read on the
        // clock like everything else here.
        //
        // THE STORE, THE JOURNAL AND THE CACHES ARE NOT GAUGES. Each of them
        // needs a process spawned or a walk, so they arrive as `consumer`s of a
        // scan instead. A gauge nothing ever fills is a row that never appears
        // and a field every buffer carries — which is what this enum is trying
        // not to be.
        disk-total,
        disk-free,
    }

    record reading {
        of: gauge,
        bytes: u64,
    }

    // Pressure (PSI) in PER MILLE: `12.3%` arrives as `123`.
    //
    // Integer and not float because per mille is exactly the precision the
    // screen shows, and because a rounding that happens in one place is a
    // rounding one can point at.
    record pressure {
        some10: u16,
        some60: u16,
        some300: u16,
        full10: u16,
        full60: u16,
    }

    enum consumer-kind {
        process,
        // A `systemd-run --scope` of ours — one per foreign buffer, which is
        // what makes "who is eating memory" answerable by BUFFER and not only by
        // process (section 7.5).
        scope,
        directory,
        filesystem,
        generation,
    }

    // Someone eating memory or disk, as a scan found them.
    record consumer {
        kind: consumer-kind,
        // As the system spells it: a process's `comm`, a path, a device. It is
        // DATA and comes out literal — the buffer does not translate it, and the
        // host does not invent a label for it either.
        name: string,
        bytes: u64,
        // The pid, when there is one. `0` when there is none.
        hint: u64,
    }

    // Which policy is in force. `unknown` is not a failure to be hidden: it is
    // what the screen must say when systemd answered something we do not
    // recognise, instead of drawing a state that is not in effect.
    enum guard-mode {
        unknown,
        off,
        strict,
        tolerant,
    }

    record guard {
        // What is in force NOW, read back from systemd — never what the flake
        // asked for. The two diverge exactly when the interesting thing happened.
        mode: guard-mode,
        // Per mille of a ten-second window spent stalled, and for how long it
        // has to stay there.
        pressure-limit: u16,
        pressure-seconds: u32,
        // `MemoryHigh` on the applications' slice, in per mille of RAM.
        ceiling: u16,
        // How many times it has acted since boot, and whether compressed swap is up.
        acted: u32,
        zram: bool,
        // What the machine's own file says, which is what survives a reboot.
        persisted: guard-mode,
    }

    record survey {
        // A LIST and not a record with one field per gauge, so that a machine
        // that does not have something simply does not report it: no zram, no
        // `zram-original` reading. A fixed record would have to send zero, and
        // zero is indistinguishable from "there is one and it is empty" —
        // which is the same silent-fallback shape this repository keeps paying
        // for elsewhere.
        readings: list<reading>,
        pressure: pressure,
        // Empty until a scan is asked for: reading `/proc/meminfo` costs
        // microseconds, walking a filesystem does not.
        consumers: list<consumer>,
        guard: guard,
        // A scan in flight, and how far it got, in per mille. Without this the
        // screen cannot tell "nothing found" from "still looking".
        scanning: bool,
        progress: u16,
    }

    // What the buffer asks the host to DO. An enum, for the same reason `gauge`
    // is one: a free string here would be a command language with no compiler.
    enum request {
        // Sample now, instead of waiting for the next tick.
        refresh,
        scan-ram,
        scan-disk,
        cancel-scan,
        // The policy: loosen it for this session, put it back, or write the
        // permanent option into the machine's own file.
        guard-tolerant,
        guard-default,
        guard-persist,
        // Close what `target` names. Irreversible, and the buffer only asks
        // after its own confirmation.
        stop-consumer,
        // Housekeeping. Each frees disk and none of them changes configuration:
        // the flake stays the truth.
        //
        // THE CACHE IS NOT HERE, and the omission is deliberate: `~/.cache`
        // shows up as a reading, and emptying it in one key is a button whose
        // damage varies by application — some rebuild it in seconds, others
        // lose a login. It is shown so it can be found, and left to be dealt
        // with deliberately.
        sweep-generations,
        sweep-store,
        sweep-journal,

        // The transfer queue, for whoever declared `capability::transfers`.
        // `target` is the JOB'S ID and never a row: the list reorders itself
        // as jobs finish, and a row number would act on whatever moved into
        // that position between the draw and the key.
        pause-job,
        resume-job,
        // Irreversible: it deletes the piece already written at the
        // destination. Like `stop-consumer`, the buffer only asks after its
        // own confirmation.
        cancel-job,
        // Drop a FINISHED job from the list. Touches no file.
        forget-job,
        // Drop every finished job at once. `target` is ignored.
        sweep-jobs,
    }

    // WHAT TO WRITE ON A DISK, and on which.
    //
    // # Why an effect of its own and not another `request`
    //
    // Because a `demand` is a verb plus an INDEX, and that shape fits every
    // request there is: pause job seven, close consumer three. Formatting is
    // not that — it carries a choice of filesystem, a name, and whether the
    // partition table goes too. Bending `demand` to hold them would put three
    // disk-shaped fields on the record every other buffer sends, and a record
    // whose fields are ignored by most of its senders is a record nobody can
    // read.
    record plan {
        // The device, by the id the host gave it in the last `rack`. Never one
        // the buffer built: the host checks it against that list, and refuses
        // one the running system needs whatever the buffer says.
        device: string,
        // What to write.
        recipe: recipe,
        // What to call it. Empty means no name, which is ordinary.
        label: string,
        // Wipe the partition table and lay down a single partition first.
        //
        // The gesture ninety percent of formatting is — "prepare this
        // pendrive" — as ONE choice rather than three. It is refused for
        // anything that is not a whole disk.
        whole-disk: bool,
    }

    record demand {
        what: request,
        // WHICH consumer, as a 1-based index into the list of the last survey;
        // `0` when the request needs no target.
        //
        // An index and not a pid: a scope has no pid, and it is the scope — one
        // per application — that one actually wants to close. Both sides are
        // looking at the same list, and the host checks the index before acting.
        target: u64,
    }

    // ------------------------------------------------------------------
    // The transfer queue, for whoever declared `capability::transfers`.
    //
    // THE FIELD ORDER OF `job` IS THE ORDER `ronoctua-runtime` LOWERS IT IN.
    // `wasmtime` zips a record POSITIONALLY against the WIT and only then
    // compares names — a field moved on one side alone fails when the function
    // is CALLED, with a message about a name.
    // ------------------------------------------------------------------

    // Who is doing the moving. One word each, and the same word the host uses
    // to find the text and the icon.
    enum engine {
        // This machine's own disk.
        local,
        // A plain link, through aria2.
        fetch,
        // A site's media, through yt-dlp.
        media,
        // BitTorrent, through the session the queue owns.
        torrent,
    }

    // Where a job is in its life.
    enum stage {
        weighing,
        running,
        paused,
        done,
        failed,
        cancelled,
    }

    // WHAT is being done. An enum and not a string for the reason `gauge` is
    // one: the buffer has no parser and is not getting one.
    enum errand {
        copy,
        move-it,
        delete,
        shred,
        trash,
        restore,
        compress,
        extract,
        measure,
        fetch,
        media,
        audio,
        subtitles,
        torrent,
    }

    // What `done` and `total` are counted in.
    enum amount {
        bytes,
        items,
    }

    record job {
        id: u64,
        engine: engine,
        errand: errand,
        stage: stage,
        amount: amount,
        done: u64,
        // ZERO MEANS NOT KNOWN — a download with no `Content-Length`, a torrent
        // whose metadata has not arrived. The buffer shows the stage instead of
        // a proportion, and never a bar that pretends.
        total: u64,
        // What it is working on RIGHT NOW: a file name, a torrent's name. Data
        // and not a key — the host already cut it, because the buffer has no
        // path type and no idea what a separator is.
        subject: string,
        // A failure, ALREADY TRANSLATED by the host. Empty when there is none.
        trouble: string,
        // What a `measure` answered, in bytes. Zero when there is no answer.
        answer: u64,
        // Whether this one went out as the PERSON rather than as nobody.
        //
        // On the row because it is the one property of a job that cannot be
        // undone after the fact: an anonymous download can be repeated as
        // oneself, and the reverse is not true — the request already carried
        // who was asking. A screen that did not say which of the two happened
        // would be asking the reader to remember.
        identified: bool,
    }

    record queue {
        jobs: list<job>,
    }

    // ============================================================
    // DISKS — what the formatting buffer draws, and never reads.
    // ============================================================

    // WHY THE BUFFER GETS A LIST AND NOT A WAY TO ASK.
    //
    // A component has no bus, no filesystem and no parser (invariant 11), and
    // giving it one would be giving it the machine. The host reads udisks,
    // applies the rules — what is a holder, what is quiet, what is somebody
    // else's loop — and hands over what is left, already cut and already
    // decided. The buffer draws it and names an id it was GIVEN; the host
    // checks that id against the list it just sent.
    //
    // WHAT IS NOT CUT IS WHAT THE RUNNING SYSTEM NEEDS. It arrives with
    // `needed` filled in, and it is drawn: somebody looking for their disk has
    // to FIND it and then read why it is not on offer. Omitting it would send
    // them looking for a row that is not there, and the next thing they reach
    // for is a terminal, which asks nothing.
    record device {
        // The id the host gave it. Opaque HERE and a udisks object path over
        // there — the buffer must not take it apart, and cannot: a device with
        // no partition table has no number to parse out of it.
        //
        // It is never drawn: a udisks object path embeds the drive's SERIAL
        // NUMBER, and this repository is public (invariant 13).
        id: string,
        // What to call it. Already chosen by the host: the label when there is
        // one, the device node otherwise.
        name: string,
        // `/dev/sda2`. Shown because it is what somebody compares against what
        // `lsblk` told them.
        node: string,
        // `vfat`, `ntfs`, `btrfs` — or empty, which is a partition with nothing
        // on it yet. Empty is a REASON to format, not a failure.
        kind: string,
        // How big, in bytes. The buffer has no formatter; the host sends the
        // number and the SENTENCE is built from a text key.
        bytes: u64,
        // Is a filesystem from it mounted right now?
        mounted: bool,
        // Can the drive it sits on be pulled out?
        removable: bool,
        // WHY THIS ONE MUST NOT BE TOUCHED, already resolved and already
        // translated — the mount point, or the word that decided. Empty means
        // it is spare.
        //
        // The buffer uses it to not offer, and the HOST refuses anyway. A guard
        // that lives only in the thing being guarded is a guard that holds
        // until somebody writes a second buffer.
        needed: string,
        // Is this the whole disk rather than one partition of it?
        //
        // The difference decides which questions are worth asking: a whole disk
        // can be given a fresh partition table, and a partition cannot.
        whole: bool,
    }

    // WHAT BECAME OF THE LAST `effect::format`.
    //
    // The same channel `copied(bool)` opened and for the same reason: an effect
    // that acts on the machine has to answer, or the buffer can only show an
    // optimistic "done!" — which lies exactly when it matters. A format that
    // worked shows up on its own, in the next `rack`; one that was REFUSED
    // shows up nowhere, and this is the only way the person hears about it.
    record outcome {
        // Did it work?
        done: bool,
        // What went wrong, ALREADY a sentence — empty when `done`.
        //
        // Built on the host from the refusal's NAME, because udisks' prose is
        // upstream's to reword and this buffer has no bundle to look a key up
        // in (invariant 11).
        trouble: string,
    }

    // Every disk the machine has, as the host last read it.
    record rack {
        devices: list<device>,
    }

    // A filesystem this build can actually CREATE.
    //
    // The list is not "what exists": it is what the slimmed udisks carries a
    // `mkfs` for. XFS is deliberately absent — its tooling is 212 MiB, most of
    // it a Python environment for `xfs_scrub`, and this distro is btrfs. The
    // buffer SAYS so rather than leaving a gap somebody has to guess about.
    enum recipe {
        // vfat. Opens on every computer there is.
        universal,
        // exfat. Like the above, without the four-gigabyte file limit.
        large-files,
        // ntfs. What Windows writes.
        windows,
        // ext4. The ordinary Linux one.
        linux,
        // btrfs. Snapshots and checksums; what this distro runs on.
        modern,
    }

    // A key binding, declared as DATA (section 7.9). The buffer never
    // captures a key imperatively.
    record binding {
        // The sequence, like `m f s`. Only under `SPC m`: the host REFUSES at load time
        // whoever tries to bind under a global prefix.
        keys: string,
        // The command's id, from the registry.
        command: string,
    }

    // What the buffer contributes to the modeline.
    record segment {
        id: string,
        content: text,
    }

    // THE TONE A STATE IS DRAWN IN — a name, never a value (invariant 11).
    //
    // `standard` is what every buffer uses and means "the host decides": the
    // base state comes out quiet and every other one comes out in the SINGLE
    // token the whole system reserves for an alternative state. That is the
    // point of it having a name of its own — a theme changes one line in
    // `assets/tokens/colors.nix` and every buffer follows.
    //
    // The other four exist for the day a state has to say something stronger
    // than "not the usual one" — a file manager waiting for a permission answer
    // is not the same kind of not-usual as a search field.
    enum tone {
        standard,
        accent,
        success,
        warning,
        error,
    }

    // ONE STATE THE BUFFER CAN BE IN.
    //
    // `buffer-state` and not `state`, because every component that has one calls
    // its own whole memory `State` — two things by that name in one file is how
    // a reader stops knowing which is which. The name is longer at the one place
    // it is written and unambiguous at every place it is read.
    //
    // The major mode says what KIND of buffer this is; the state says what it is
    // doing right now. Both existed before this record — the second one just had
    // no name, so typing a letter into the icon browser silently became a search
    // and the modeline went on saying the same word it said at rest.
    //
    // `id` is ENGLISH and kebab-case, like every other name in this repository
    // (invariant 18); what reaches the screen is `state-<id>` out of the i18n
    // (invariant 8). The first state a buffer declares is its BASE, its id has to
    // be `normal`, and `Esc` is what returns to it.
    record buffer-state {
        id: string,
        // The key that selects it directly under `SPC b s`. Unique within the
        // buffer — the host refuses a repeat at load, because two states on the
        // same letter is a menu where one of them is unreachable.
        letter: char,
        tone: tone,
    }

    // What the buffer says about itself in `init` (section 7.6).
    record descriptor {
        name: string,
        mode: string,
        // At least one, and the first is the base. A buffer with a single
        // `normal` is the normal case and costs it one line.
        states: list<buffer-state>,
        keymap: list<binding>,
        commands: list<string>,
        segments: list<segment>,
        capabilities: list<capability>,
    }

    // How many CELLS of height each scale occupies.
    //
    // This is NOT a token value (invariant 11): it is a cell count, the
    // same unit the buffer already counts rows and columns in. What computes it is
    // the host, which knows the font size and the line height.
    //
    // Without this, the buffer had to GUESS how many rows a large run
    // occupies — and it guessed wrong: the sheet's `huge` glyph came out clipped
    // at the bottom, touching the rule, because four cells were 116 px and its
    // line box is 168.
    record heights {
        small: u16,
        base: u16,
        normal: u16,
        large: u16,
        huge: u16,
    }

    record context {
        columns: u16,
        lines: u16,
        heights: heights,
    }

    // Where the pointer touched, in CELLS of the buffer's grid — never in pixels.
    //
    // Invariant 11 is not about units, it is about the boundary: a pixel is
    // a Wayland and screen-scale thing, and the buffer knows neither
    // of the two. What converts (and what subtracts the window's margin) is the host,
    // exactly as it already converts a key into `character`.
    //
    // The origin is the same as `text-command`'s: the buffer's (0,0) cell, and not
    // the window's corner.
    record position {
        column: u16,
        line: u16,
    }

    variant input {
        // A NAMED command, dispatched by the host when the buffer's keymap
        // key sequence completes. It is the other side of the descriptor's
        // `binding`: the buffer declares, the host resolves the key, and the
        // command comes back through here — the buffer never captures a key.
        command(string),
        // `character`, and not `char`: `char` is a WIT built-in type and cannot
        // name a case. The parser complains with "failed to resolve directory",
        // which points at the directory and not at the word.
        character(char),
        up,
        down,
        // A GRID buffer needs all four directions: with two, moving sideways
        // only happens by line overflow, and the cursor jumps
        // from one end of the screen to the other.
        left,
        right,
        confirm,
        cancel,
        delete,
        // What `Tab` means: TOGGLE whatever is toggleable on
        // screen — in the glyph browser, the filter panel.
        //
        // # Why it is a case, and not a character
        //
        // Because without this `Tab` falls into the host's `_` and arrives as
        // `character('\t')`. The buffer pushes it into the search like any
        // letter, and the result is an INVISIBLE tab in the field, which does
        // not match any glyph and cannot be seen. A key that
        // looks like it does nothing is worse than one that is not bound: there is no
        // way to find out what it did.
        //
        // The name is the INTENT, like the rest: `up` and not `Up`, `confirm` and
        // not `Enter`. What decides what to toggle is each buffer.
        toggle,
        // The RESULT of an `effect::copy` asked for earlier.
        //
        // What knows whether the copy worked is the HOST — it is what talks to the
        // clipboard. Without this way back, the buffer could only show
        // an optimistic "copied!", which lies exactly when it matters.
        copied(bool),
        // GO TO THIS STATE — the host's half of the state contract.
        //
        // It arrives when somebody pressed `Esc`, held it and used an arrow, or
        // chose a state under `SPC b s`. The buffer is told the id it declared,
        // never a key: the same rule as `command`, and for the same reason —
        // the component does not capture keys (invariant 11 and section 7.9).
        //
        // A buffer that changes state on its own says so with
        // `effect::state-changed`, which is the other half. Without both, the
        // modeline would be right only about the changes it caused itself.
        enter-state(string),
        // Text coming from the clipboard (`Ctrl+V`).
        //
        // Already resolved by the host: the buffer does not read the clipboard, just as it does not read a
        // file (invariant 11). It only receives the text.
        paste(string),
        // A left-button click on a cell.
        //
        // What resolves WHICH item is there is the buffer, because only it knows its
        // own layout — the glyph grid moves two rows at a time and
        // has its own header and footer. The host sending "item number N"
        // would be the host reimplementing the buffer's layout.
        click(position),
        // The machine's memory, ALREADY READ. Only for whoever declared
        // `capability::system`.
        //
        // It arrives on its own — a tick of the host's clock —, which is the
        // one input in this list that nobody pressed. A screen that shows how
        // much memory there is has to change while it is being looked at;
        // waiting for a key would make it a photograph.
        survey(survey),
        // The transfer queue, ALREADY READ. Only for whoever declared
        // `capability::transfers`.
        //
        // Like `survey`, nobody pressed it: it arrives when the queue changed.
        // Unlike `survey`, it is NOT a clock — the host is subscribed to the
        // queue's own socket on a thread, and a copy that moves no byte for a
        // minute sends nothing in that minute.
        queue(queue),
        // Every disk the machine has. Only for whoever declared
        // `capability::disks`; a buffer that did not gets no thread and no
        // signal, which is what makes the absence structural.
        rack(rack),
        formatted(outcome),
    }
}

// The world exports an INTERFACE, not loose functions. With loose functions
// `wit-bindgen` generates a `Guest` at the root scope and the name collides as soon as
// there is a second world; with an interface, each has its own module.
interface view {
    // ALL the types named, not only those in the signatures: `wit-bindgen` generates
    // in the interface's module only what it declares it uses, and a record
    // reachable only from inside a `variant` ends up out of scope.
    use types.{
        capability, command, grid-command, line-command, text-command,
        heights, context, color, descriptor, effect, input, binding, position, segment,
        text,
        // The system ones, for the same reason as all the others: `wit-bindgen`
        // generates in this module only what it declares it uses, and a record
        // reachable only from inside a `variant` ends up out of scope.
        gauge, reading, pressure, consumer-kind, consumer, guard-mode, guard,
        survey, request, demand,
        // And the queue's, for the same reason.
        engine, stage, errand, amount, job, queue,
        // And the disks'. `device` and `recipe` are reachable only from inside
        // `rack` and `plan`, which is precisely the case this list exists for.
        device, rack, recipe, plan, outcome,
        // And the state's — `state` is only reachable from inside `descriptor`,
        // which is exactly the case this list exists for.
        tone, buffer-state
    };

    // Who the buffer is: name, mode, keymap, commands and modeline segments.
    //
    // Called ONCE, at load. This is where the keymap arrives as data, and it is why
    // the host can refuse whoever binds outside `SPC m` before the
    // buffer runs anything at all.
    init: func() -> descriptor;

    // Draws. It does NOT rasterise: it returns the list, and the host draws.
    render: func(ctx: context) -> list<command>;

    // Receives an already-normalised key and returns what should happen.
    //
    // An empty list = nothing changed, do not redraw. This used to be `-> bool`, and the
    // buffer had no way to ask for a copy nor to fire a command.
    event: func(e: input) -> list<effect>;
}

world buffer {
    export view;
}
