// A native buffer's interface — sections 7.8 and 7.9.
//
// ONE interface, small on purpose. Every extra capability is surface
// that every future buffer gets to use, and invariant 11 lives
// precisely off what is NOT here: there is no Wayland import, no access to
// tokens by value, no translation.
package ronoctua:buffer@0.1.0;

interface types {
    // THE COLOUR ENUM IS GENERATED, and comes from `assets/tokens/colors.nix`.
    //
    // This used to be `record color { token: string }`, and a free string
    // means `color.inexistente` compiles and fails silently on screen.
    // With the enum, `wit-bindgen` generates a Rust enum in the guest: the wrong name
    // does not exist, and the error comes from the compiler.
    //
    // Section 7.6 asks for exactly this: "the build generates (a) the shell's Rust table
    // and (b) a WIT enum of valid names. A non-existent token becomes a compile
    // error in the guest."
    use ronoctua:tokens/tokens@0.1.0.{color, icon};

    // Data comes out literal; a label comes out as a key and the host translates; an icon is a
    // TOKEN, and what knows its codepoint is the host.
    //
    // `icon` came in for the same reason `color` is an enum: without it, a buffer
    // that wanted a magnifying glass would have to write the PUA character by hand — a
    // codepoint that changes between Nerd Fonts versions, embedded in a
    // component that has no way of knowing that. By naming the token, what resolves it
    // is whoever has the table (invariants 9, 10 and 11).
    variant text {
        data(string),
        key(string),
        icon(icon),
    }

    // TEXT SIZE, by NAME and never in pixels.
    //
    // Invariant 11 is explicit: a buffer does not receive a token value. It says
    // "large" and the host decides how many pixels that is worth — exactly as it does
    // with colour.
    //
    // Per RUN and not per buffer: it used to be a field of the descriptor, and that is why
    // the glyph browser's header and footer grew along with the
    // icons. What has to be large there is the GLYPH; the surrounding text is
    // text, and reading it at 32 point is uncomfortable.
    //
    // THE CELL GRID is still the normal size's. A large run
    // occupies more than one cell, and what spaces it is whatever draws — that is how
    // the browser's grid came to move two rows at a time.
    enum scale {
        // Smaller than the buffer's body. For whatever ACCOMPANIES the content without
        // competing with it — today the focused glyph's tags and the counter.
        small,
        // THE SYSTEM'S SIZE: the same as the footer's and the minibuffer's.
        //
        // For whatever is INTERFACE inside a buffer, and not its content —
        // today the browser's search field. A search field is the same
        // thing as the minibuffer, and seeing the two at different sizes on the
        // same screen is the kind of detail that makes a system look assembled
        // out of parts of different origins.
        base,
        // The buffer's content. LARGER than the system's on purpose: the
        // footer is peripheral reference, the buffer is what one reads.
        normal,
        large,
        // The screen's subject. Today only the glyph on the browser's sheet.
        huge,
    }

    record text-command {
        line: u16,
        column: u16,
        content: text,
        color: color,
        scale: scale,
        // How many cells this run may occupy. `0` = to the edge.
        //
        // # Why the BUDGET, and not the already-cut text
        //
        // A buffer cannot elide a `key`: what translates is the host, and the
        // sentence's length changes with the language — "Type to search for a Nerd
        // Fonts glyph" and "Digite para buscar um glyph das Nerd Fonts" are not
        // the same length. What the buffer knows is how much SPACE there is; whoever has
        // the string is whoever cuts.
        //
        // Without this, the invitation ran over the counter in a narrow
        // window: text over text, the worst possible result because
        // neither of the two stays legible.
        max-width: u16,
        // Counted from the window's RIGHT edge instead of from the left.
        //
        // The grid does not reach the border — `columns` is the floor of the
        // width over a cell — so a run in the last cell has a remainder of
        // nought to one cell after it that changes with the window. A control
        // that sits against the edge (the header's chevron) asks for this, and
        // the host places it in pixels from the border, as it does the
        // modeline's marks: the air after it is then fixed.
        edge: bool,
    }

    // A BAND ACROSS A ROW, OR ACROSS PART OF ONE.
    //
    // It was `line-command` — a row and a colour, nothing else — because the
    // rule written down was that a ground "paints the whole row, and that is
    // all". That closed something the owner never asked to close: two columns
    // side by side, each with its own selection, is an ordinary arrangement
    // and it needs a band that is a RECTANGLE rather than a stripe. A
    // separator under a heading inside one of those columns needs the same.
    //
    // `columns: 0` means "to the edge", which is what `0` already means for a
    // text run's budget — so every band that was full-bleed stays full-bleed
    // by writing the zero it always implied.
    record band-command {
        line: u16,
        column: u16,
        columns: u16,
        color: color,
    }

    // THE GRID IS A FIRST-CLASS NODE, and not a `raw-surface` (section 7.10).
    //
    // `raw-surface` would mean a second text rasteriser in the system,
    // with its own font resolution, metrics and theme — exactly what the
    // display list decision exists to prevent, and in the most-used buffer.
    //
    // The content arrives as already-formed lines; the host draws with the SAME font
    // and the SAME tokens as everything else.
    record grid-command {
        line: u16,
        column: u16,
        // One string per grid row, in order.
        lines: list<string>,
        color: color,
    }

    // A VECTOR DRAWING, in the given rectangle of cells.
    //
    // # The FIRST pixel primitive in this list, and why it exists
    //
    // Lucide's customisation changes the stroke's width, cap and colour, and a
    // GLYPH honours none of that: the width is baked into the drawing, and
    // Lucide publishes only one. Until now the only honest way out was to say the
    // screen does not show it — and the owner asked for it to be shown.
    //
    // The buffer sends the SAME document the copy would deliver. There is no
    // second builder, and that is what makes the preview the artefact instead of
    // an approximation of it.
    //
    // # What it does NOT open
    //
    // The host rasterises with `resvg` compiled WITHOUT a text engine: `<text>`
    // does not draw. And with no `resources-dir`: a reference to an external file does not
    // load. The surface is "a vector drawing", and not "a document".
    //
    // # Why it requires a capability
    //
    // Because it is the only primitive that produces arbitrary pixels, and this file's
    // header says that every extra surface is surface that EVERY
    // future buffer gets to use. Whoever emits this without declaring
    // `capability::vector` is refused at load time.
    record svg-command {
        line: u16,
        column: u16,
        // The rectangle, in CELLS. The host fits the drawing inside it without
        // stretching — the buffer knows neither pixels nor screen aspect ratio.
        lines: u16,
        columns: u16,
        // The document, as the copy would deliver it.
        svg: string,
        // The token that replaces `currentColor`.
        //
        // THE COLOUR DOES NOT CROSS AS A VALUE (invariant 11). Lucide's SVG comes
        // out with `currentColor` by default, and `currentColor` with no context is
        // BLACK: over the buffer's background, an invisible drawing — which is
        // indistinguishable from "not implemented yet". What resolves the value is
        // whoever has the table.
        //
        // When the person types a colour of their own, there is no `currentColor` to
        // replace and the drawing comes out in their colour. There it is CONTENT, not chrome.
        color: color,
    }

    // A SCROLLBAR, for a list a buffer is showing a window onto.
    //
    // # Why this had to exist, and why it is not "a scrollable region"
    //
    // `docs/PENDING.md` used to say a buffer could not have a container that
    // scrolls, because none of the five primitives was a scrollable region and
    // inventing one would be a sixth vocabulary every buffer had to learn. The
    // owner said that rule was wrong, and reading it again, so is the
    // reasoning: a buffer already draws whatever window of a list it likes —
    // it owns the offset, it emits the rows it wants, and the host clips
    // nothing. Nothing was missing from the DRAWING.
    //
    // Two things were missing, and neither is a region. This one is the BAR:
    // the buffer cannot draw a thumb, because a thumb is a fraction of a track
    // in pixels and a buffer counts in cells. A bar drawn out of block
    // characters would be a second scrollbar that looks nothing like the five
    // the shell already draws. The other is `input::wheel`, below — a bar
    // nobody can grab is a picture of a control.
    //
    // # What the host does with it
    //
    // Exactly what it does for its own lists: `ronoctua_design::Scroll`, which
    // has been compiled on both sides of this wall since it was written, with
    // the pixel residue the host owns because only the host knows the surface's
    // real height. So a buffer's bar IS the system's bar, and not a likeness.
    //
    // Nothing is drawn when the list fits — `Scroll::cut` answers that, and
    // the whole shell agrees a bar over a list that fits is a control that
    // does nothing.
    record bar-command {
        // The first row of the track.
        line: u16,
        // How many rows it covers.
        lines: u16,
        // Which column it sits in. The caller subtracts it from its own
        // content: a bar drawn over text is the defect `AGENTS.md` names —
        // "barra nenhuma desenha por cima do conteúdo".
        column: u16,
        // How many rows the list has, how many are shown, and which is first.
        // The three `Scroll` takes, in its own words, in the same unit: rows.
        total: u32,
        shown: u32,
        offset: u32,
        color: color,
    }

    // A SENTENCE, WRAPPED, in a rectangle of cells.
    //
    // # Why a buffer cannot do this itself
    //
    // Because it holds a KEY and not a sentence. `text-command` draws one row
    // and the host elides it at the budget, which is right for a label and
    // useless for a paragraph: a description cut at the width of a column is
    // a description nobody can read. And wrapping needs the TRANSLATED string
    // — a buffer never sees one, and could not measure it if it did.
    //
    // So the rectangle crosses and the host fills it: it looks the key up,
    // wraps to `columns` with the same `layout::wrap` the file manager's file
    // names use, draws up to `lines` rows and elides the last one if there is
    // more. Nothing new is decided on this side.
    //
    // It is what lets a buffer have a footer that explains the thing under the
    // cursor, which is the shape every view in the shell already has and no
    // buffer could have.
    record paragraph-command {
        line: u16,
        column: u16,
        // The rectangle, in cells.
        lines: u16,
        columns: u16,
        // What to write. A key is translated first; data is wrapped as it is.
        content: text,
        color: color,
        scale: scale,
        // THE FIRST WRAPPED ROW TO DRAW, which is how a sentence SCROLLS.
        //
        // # Why the offset crosses and the total does not
        //
        // Because only the host knows the total: it holds the translated
        // string and it is the one that wraps. A buffer that tried to keep a
        // scroll of its own would be counting rows of a sentence it has never
        // seen — so it keeps the OFFSET, which is a thing it can hold, and the
        // host clamps it, draws the window, and draws the thumb beside it when
        // there is more. The wheel and the drag over that rectangle come back
        // as `input::scrolled`, already clamped, so the number this side holds
        // is always one the host produced.
        //
        // `0` is the top, which is what every paragraph that does not scroll
        // says and always said.
        first-row: u16,
    }

    // FROM THIS LINE DOWN, THE FRAME IS ANCHORED TO THE WINDOW'S FOOT.
    //
    // # The residue, and why it is not the buffer's to fix
    //
    // A surface holds `floor(height / line)` whole rows plus a leftover of less
    // than one — nought to twenty-five pixels, changing with the window. It
    // falls under the LAST row, where a buffer that ends in a footer puts the
    // one thing that must sit at the bottom, and the owner read it as *"um
    // espaço após o `Last run` … que varia de tamanho conforme a altura
    // disponível"*. Measured on that screen: nine pixels.
    //
    // The ground already took the residue (`Scroll::track`'s rule, applied to
    // the last band); the INK never did. This is how the ink takes it: the host
    // places these lines counting UP from the bottom, so the leftover falls
    // between the block above and the block at the foot — inside the page's own
    // ground, where nothing is drawn. It is `Span::foot`, which exists for this
    // exact symptom on the file manager's transport.
    //
    // A buffer that never divides its window sends none of these, and nothing
    // about it changes.
    record anchor-command {
        // The first line that is anchored. Everything from here down moves
        // with the window's bottom edge.
        foot-from: u16,
    }

    variant command {
        text(text-command),
        anchor(anchor-command),
        paragraph(paragraph-command),
        rule(band-command),
        selection(band-command),
        grid(grid-command),
        svg(svg-command),
        bar(bar-command),
    }

    // What the buffer ASKS to happen. `tecla` used to return `bool` — the
    // buffer said "I changed", never what should happen, and that is why it could
    // not ask for a copy nor fire a command (sections 6.5 and 7.6).
    variant effect {
        // Redraw: the internal state changed.
        redraw,
        // Put this on the clipboard.
        copy(string),
        // Run the named command. It is the registry's id, not a function —
        // section 13 requires everything to be addressable by name.
        command(string),
        // Close this buffer.
        close,
        // Write this text to the file the buffer was opened with.
        //
        // WHY IT IS NOT `copy`: `copy` goes to the clipboard, and saving goes to
        // disk. Reusing it would put the file's whole content on the clipboard
        // as a side effect of saving — a surprise nobody would connect to the
        // key they pressed.
        //
        // The buffer STILL has no filesystem (invariant 11): it hands the text
        // over and the HOST writes, the same way `paste` is how text gets in.
        // That is what keeps a file editor from needing a new capability.
        save(string),
        // Ask the host to do something to the machine's memory or disk.
        //
        // Requires `capability::system`. NOT `command(string)`: that one is an
        // id from the registry and carries no argument, and "close pid 4321"
        // needs one. Smuggling the number inside the string would be the buffer
        // inventing a syntax and the host parsing it — which is the shape this
        // file refuses everywhere else.
        ask(demand),
        // Write a filesystem. Needs `capability::disks`.
        //
        // THE ONE EFFECT THAT DESTROYS SOMETHING NOBODY GETS BACK, which is why
        // it is not folded into `ask`: the reader of this file should see it
        // named, and the capability gate should have one arm to point at.
        format(plan),
        // "I AM IN THIS STATE NOW", after changing on my own.
        //
        // Typing a letter into the icon browser enters its search; nobody
        // pressed a key that means "enter search", so the host has no way to
        // know. Without this the modeline would be truthful only about the
        // changes the host itself caused — which is the same class of lie as a
        // cached branch name, and worse, because this one changes every time
        // somebody types.
        //
        // The id has to be one the descriptor declared. The host refuses any
        // other, rather than putting a word on the modeline that no key can
        // return from.
        state-changed(string),
        // Remember this preference. Needs `capability::brain`.
        //
        // NOT an `ask`: that one is a verb plus an index and carries no value,
        // and "every seven days" is a value. See `setting`.
        //
        // The buffer still touches no disk (invariant 11): it says what it
        // wants remembered and the HOST writes the file, the same way `save`
        // is how a file editor writes.
        tune(setting),
        // Make a key on ONE keyboard mean something else. Needs
        // `capability::keyboard`.
        //
        // NOT a `demand`: that one is a verb plus an index and carries no
        // value, and this carries three. The buffer touches nothing — it says
        // what it wants, and the host writes the file, asks keyd whether it
        // can read it, and restarts the daemon.
        remap(remap),
        // Switch how the keyboards work together. Needs
        // `capability::keyboard`. At once: a remapper that dies gives every
        // keyboard back to the compositor, and keyd takes over by itself.
        keyboard-mode(keyboard-mode),
        // One setting of one keyboard unit, in Independent mode. Needs
        // `capability::keyboard`.
        unit-change(unit-change),
    }

    // Capabilities a buffer may ASK for in the descriptor. The host refuses whoever
    // uses one without asking, and the list is short on purpose: each is
    // surface that every future buffer gets to use.
    enum capability {
        // Access to the PTY and the VT state machine, which live in the host.
        terminal,
        // An offscreen texture for whoever needs pixels: an image viewer,
        // video. "Rare and auditable" (section 7.6).
        raw-surface,
        // Emitting `command::svg` — a vector drawing rasterised by the host.
        //
        // Less than `raw-surface`: there is no texture, no pixel coming from the
        // guest, and what can be drawn is a vector the host interprets and
        // clips. It is the difference between "the buffer sends pixels" and "the buffer
        // sends a figure".
        vector,
        // Receiving `input::survey` and emitting `effect::ask` — how much memory
        // the machine has, who is eating it, and asking for something to be done
        // about it.
        //
        // # Why it is a capability and not just two more cases
        //
        // Because of this file's own header: every extra surface is surface that
        // EVERY future buffer gets to use. A buffer that never asked for this one
        // receives no survey and has its demand refused — the same shape as
        // `vector`, which exists so that "the buffer sends a figure" cannot
        // quietly become "any buffer sends pixels".
        //
        // # What it does NOT open
        //
        // The buffer still has no filesystem, no clock and no socket. It does not
        // read `/proc`, does not talk to systemd and does not run a command: it
        // receives numbers ALREADY READ and names what it wants done. Whoever
        // reads and whoever acts is the host — invariant 11 intact.
        system,
        // Receiving `input::queue` and asking for a job to be paused, resumed,
        // cancelled or forgotten.
        //
        // # Why not `system`
        //
        // Because they are different powers over different things, and one
        // capability covering both would give the memory panel the right to
        // cancel a copy of forty gibibytes. `system` closes processes and
        // sweeps the store; this one only touches a queue the host owns. A
        // buffer that wants both asks for both, and the descriptor says so.
        //
        // # What it does NOT open
        //
        // The same as `system`: no filesystem, no socket, no clock. The rows
        // arrive already read and already cut, and the buffer names an id it
        // was given — it cannot invent one that means anything, because the
        // host checks the id against the list it just sent.
        transfers,
        // Receiving `input::rack` and asking for a disk to be formatted.
        //
        // # Why a third one, and not `system`
        //
        // Because it is the largest power any buffer has ever asked for: it
        // ends with a partition being overwritten, and no other capability can
        // destroy anything a person cannot get back. `system` closes processes
        // and sweeps the store — both recoverable; `transfers` cancels a copy
        // that can be started again. Folding this into either would hand that
        // reach to the memory panel, which asked for neither.
        //
        // # What it does NOT open
        //
        // The same as the other two: no filesystem, no socket, no clock, no
        // parser. The devices arrive already read, already filtered and already
        // judged — including WHICH ONES THE RUNNING SYSTEM NEEDS — and the
        // buffer names an id it was given. The host checks that id against the
        // list it just sent AND refuses one the system needs, because a guard
        // that lives only inside the thing being guarded holds until somebody
        // writes a second buffer.
        disks,
        // Receiving `input::mind`, and asking the brain to run something or to
        // remember a preference.
        //
        // # Why a fourth one, and not `system`
        //
        // Because `system` means "how much memory, who is eating it, do
        // something about it", and this one ends with the machine REBUILDING
        // ITS OWN OPERATING SYSTEM. Folding it in would hand that reach to the
        // memory panel, which asked for neither. It is the same argument
        // `transfers` and `disks` already make above, one step further along.
        //
        // # What it does NOT open
        //
        // The same as the other three: no filesystem, no socket, no clock, no
        // parser. The whole mind arrives already read, already decided and
        // already formatted — including the DATES, which the component cannot
        // compute, having no zone. It names an id it was given, and the host
        // checks it against the list it just sent.
        brain,
        // Receiving `input::keyboards` and emitting `effect::remap` — which
        // keyboards the machine has, and what a key on one of them means.
        //
        // # Why it is its own capability
        //
        // Because of what it reaches. `system` ends processes and sweeps the
        // store, `disks` writes a filesystem — and this one writes the file a
        // daemon between the keyboard and everything else reads. A mistake
        // there is a keyboard that does not type, on a machine somebody is
        // holding. A buffer asks for exactly the power it uses.
        //
        // # What it does NOT open
        //
        // No filesystem, no daemon, no command. The buffer receives a list
        // already read and hands back three strings out of that same list; the
        // host is what renders, validates and restarts.
        keyboard,
    }

    // ------------------------------------------------------------------
    // The system's memory, for whoever declared `capability::system`.
    // ------------------------------------------------------------------

    // WHAT a number measures. An enum, and never a free string.
    //
    // The same reason `color` stopped being `record { token: string }`: a typo in
    // a string compiles and fails in silence on screen. And the harder rule from
    // `AGENTS.md` — a buffer has no JSON parser, so no field carries raw
    // characters for the guest to take apart. The host reads `/proc`; what
    // crosses is already a number with a name.
    enum gauge {
        // /proc/meminfo, the part a person recognises.
        ram-total,
        ram-available,
        ram-free,
        // What the kernel can hand back under pressure: the reason "used" and
        // "unavailable" are different numbers, and why a machine with 90% "used"
        // may be perfectly healthy.
        ram-cached,
        ram-buffers,
        ram-shmem,
        ram-slab-reclaimable,
        ram-dirty,
        ram-anonymous,
        ram-kernel,
        // /proc/swaps and /sys/block/zram0/mm_stat.
        swap-total,
        swap-free,
        // The three that make compression legible: what was written, what it
        // occupies compressed, and the ceiling zram may take from RAM.
        zram-original,
        zram-compressed,
        zram-limit,
        // The cgroups the policy names (`nix/modules/memory.nix`): what is
        // RESERVED for the desktop and what the applications have actually spent.
        desktop-min,
        desktop-current,
        app-current,
        app-ceiling,
        system-current,
        // THE GRAPHICS MEMORY, when the driver reports it.
        //
        // On this machine's APU it comes OUT OF THE SAME RAM — which is why it
        // belongs on a screen about memory rather than on one about the screen.
        // A driver that does not publish it simply does not appear in the list.
        vram-total,
        vram-used,
        // Disk, from `statvfs` — which costs a syscall and may be read on the
        // clock like everything else here.
        //
        // THE STORE, THE JOURNAL AND THE CACHES ARE NOT GAUGES. Each of them
        // needs a process spawned or a walk, so they arrive as `consumer`s of a
        // scan instead. A gauge nothing ever fills is a row that never appears
        // and a field every buffer carries — which is what this enum is trying
        // not to be.
        disk-total,
        disk-free,
    }

    record reading {
        of: gauge,
        bytes: u64,
    }

    // Pressure (PSI) in PER MILLE: `12.3%` arrives as `123`.
    //
    // Integer and not float because per mille is exactly the precision the
    // screen shows, and because a rounding that happens in one place is a
    // rounding one can point at.
    record pressure {
        some10: u16,
        some60: u16,
        some300: u16,
        full10: u16,
        full60: u16,
    }

    enum consumer-kind {
        process,
        // A `systemd-run --scope` of ours — one per foreign buffer, which is
        // what makes "who is eating memory" answerable by BUFFER and not only by
        // process (section 7.5).
        scope,
        directory,
        filesystem,
        generation,
    }

    // Someone eating memory or disk, as a scan found them.
    record consumer {
        kind: consumer-kind,
        // As the system spells it: a process's `comm`, a path, a device. It is
        // DATA and comes out literal — the buffer does not translate it, and the
        // host does not invent a label for it either.
        name: string,
        bytes: u64,
        // The pid, when there is one. `0` when there is none.
        hint: u64,
    }

    // Which policy is in force. `unknown` is not a failure to be hidden: it is
    // what the screen must say when systemd answered something we do not
    // recognise, instead of drawing a state that is not in effect.
    enum guard-mode {
        unknown,
        off,
        strict,
        tolerant,
    }

    record guard {
        // What is in force NOW, read back from systemd — never what the flake
        // asked for. The two diverge exactly when the interesting thing happened.
        mode: guard-mode,
        // Per mille of a ten-second window spent stalled, and for how long it
        // has to stay there.
        pressure-limit: u16,
        pressure-seconds: u32,
        // `MemoryHigh` on the applications' slice, in per mille of RAM.
        ceiling: u16,
        // How many times it has acted since boot, and whether compressed swap is up.
        acted: u32,
        zram: bool,
        // What the machine's own file says, which is what survives a reboot.
        persisted: guard-mode,
    }

    record survey {
        // A LIST and not a record with one field per gauge, so that a machine
        // that does not have something simply does not report it: no zram, no
        // `zram-original` reading. A fixed record would have to send zero, and
        // zero is indistinguishable from "there is one and it is empty" —
        // which is the same silent-fallback shape this repository keeps paying
        // for elsewhere.
        readings: list<reading>,
        pressure: pressure,
        // Empty until a scan is asked for: reading `/proc/meminfo` costs
        // microseconds, walking a filesystem does not.
        consumers: list<consumer>,
        guard: guard,
        // A scan in flight, and how far it got, in per mille. Without this the
        // screen cannot tell "nothing found" from "still looking".
        scanning: bool,
        progress: u16,
    }

    // What the buffer asks the host to DO. An enum, for the same reason `gauge`
    // is one: a free string here would be a command language with no compiler.
    enum request {
        // Sample now, instead of waiting for the next tick.
        refresh,
        scan-ram,
        scan-disk,
        cancel-scan,
        // The policy: loosen it for this session, put it back, or write the
        // permanent option into the machine's own file.
        guard-tolerant,
        guard-default,
        guard-persist,
        // Close what `target` names. Irreversible, and the buffer only asks
        // after its own confirmation.
        stop-consumer,
        // Housekeeping. Each frees disk and none of them changes configuration:
        // the flake stays the truth.
        //
        // THE CACHE IS NOT HERE, and the omission is deliberate: `~/.cache`
        // shows up as a reading, and emptying it in one key is a button whose
        // damage varies by application — some rebuild it in seconds, others
        // lose a login. It is shown so it can be found, and left to be dealt
        // with deliberately.
        sweep-generations,
        sweep-store,
        sweep-journal,

        // The transfer queue, for whoever declared `capability::transfers`.
        // `target` is the JOB'S ID and never a row: the list reorders itself
        // as jobs finish, and a row number would act on whatever moved into
        // that position between the draw and the key.
        pause-job,
        resume-job,
        // Irreversible: it deletes the piece already written at the
        // destination. Like `stop-consumer`, the buffer only asks after its
        // own confirmation.
        cancel-job,
        // Drop a FINISHED job from the list. Touches no file.
        forget-job,
        // Drop every finished job at once. `target` is ignored.
        sweep-jobs,
        // Open what the finished install `target` names put in the launcher.
        // The HOST finds the entry; the buffer knows only that there is one
        // (`job.opens`).
        launch-job,

        // The brain, for whoever declared `capability::brain`. `target` is a
        // 1-BASED index into the last `mind`'s task list — never a name the
        // buffer built: the host checks it against the list it just sent.
        run-task,
        // The same, changing nothing — the `nix run .#install` idiom.
        rehearse-task,
        // Stop what is running, or take it out of the queue.
        abort-task,
        // Do not wait the announcement out; start now. `target` is ignored.
        proceed,
        // Not now — it comes back at its next moment. `target` is ignored.
        postpone,
        // THE MODULES'. Each is still a verb plus ONE index into a list the
        // host just sent, and the host checks it against that list.
        //
        // Show this task's module screen: `target` is the 1-based task index,
        // `0` stops watching. The host asks the brain for the screen whenever
        // the task's `screen-generation` moves, and pushes it.
        watch-screen,
        // The action on a row: `target` is the 1-based index of the row in
        // the last `module-screen`, counted across its sections in order.
        act-row,
        // The row's SECOND action (`module-row::also`), by the same index.
        act-row-also,
        // One of the watched task's `actions`, by its 1-based index. One that
        // asks first opens the host's question line; the answer goes with it.
        act-page,
        // Put away, or put off by the first snooze it offers, the notice at
        // this 1-based index of the last `mind.notices`.
        dismiss-notice,
        snooze-notice,
        // The FIRST control the notice at this 1-based index offers — the
        // strip's own button, and `, n` on the page. A notice's controls are
        // actions of its module, and the watched task's `act-page` could not
        // reach one on the home page, where nothing is watched.
        act-notice,
    }

    // WHAT TO WRITE ON A DISK, and on which.
    //
    // # Why an effect of its own and not another `request`
    //
    // Because a `demand` is a verb plus an INDEX, and that shape fits every
    // request there is: pause job seven, close consumer three. Formatting is
    // not that — it carries a choice of filesystem, a name, and whether the
    // partition table goes too. Bending `demand` to hold them would put three
    // disk-shaped fields on the record every other buffer sends, and a record
    // whose fields are ignored by most of its senders is a record nobody can
    // read.
    record plan {
        // The device, by the id the host gave it in the last `rack`. Never one
        // the buffer built: the host checks it against that list, and refuses
        // one the running system needs whatever the buffer says.
        device: string,
        // What to write.
        recipe: recipe,
        // What to call it. Empty means no name, which is ordinary.
        label: string,
        // Wipe the partition table and lay down a single partition first.
        //
        // The gesture ninety percent of formatting is — "prepare this
        // pendrive" — as ONE choice rather than three. It is refused for
        // anything that is not a whole disk.
        whole-disk: bool,
        // Write it inside a LUKS2 container. A YES and nothing more: the
        // passphrase is asked by the HOST, twice, on its own line, and never
        // crosses into the component — a buffer holds no secret it could
        // draw, keep or send (invariant 11's spirit, and the design's).
        encrypt: bool,
    }

    record demand {
        what: request,
        // WHICH consumer, as a 1-based index into the list of the last survey;
        // `0` when the request needs no target.
        //
        // An index and not a pid: a scope has no pid, and it is the scope — one
        // per application — that one actually wants to close. Both sides are
        // looking at the same list, and the host checks the index before acting.
        target: u64,
    }

    // ------------------------------------------------------------------
    // The transfer queue, for whoever declared `capability::transfers`.
    //
    // THE FIELD ORDER OF `job` IS THE ORDER `ronoctua-runtime` LOWERS IT IN.
    // `wasmtime` zips a record POSITIONALLY against the WIT and only then
    // compares names — a field moved on one side alone fails when the function
    // is CALLED, with a message about a name.
    // ------------------------------------------------------------------

    // Who is doing the moving. One word each, and the same word the host uses
    // to find the text and the icon.
    enum engine {
        // This machine's own disk.
        local,
        // A plain link, through aria2.
        fetch,
        // A site's media, through yt-dlp.
        media,
        // BitTorrent, through the session the queue owns.
        torrent,
        // A region's streets: a download, then a baking.
        atlas,
        // The person's programs: the software center's command line.
        software,
        // A file sent to VirusTotal.
        scan,
        // The person's containers: a pull, a build, compose.
        container,
        // The person's belongings: their sync.
        belongings,
        // Encrypt anything: a file sealed or opened.
        seal,
        // Incus: a long operation of the daemon.
        incus,
        // The installer image for a stick.
        stick,
    }

    // Where a job is in its life.
    enum stage {
        weighing,
        running,
        paused,
        done,
        failed,
        cancelled,
    }

    // WHAT is being done. An enum and not a string for the reason `gauge` is
    // one: the buffer has no parser and is not getting one.
    enum errand {
        copy,
        move-it,
        delete,
        shred,
        trash,
        restore,
        compress,
        extract,
        measure,
        fetch,
        media,
        audio,
        subtitles,
        torrent,
        // An archive's own work: add to it, take out of it, test it, write
        // it again in another format.
        archive-add,
        archive-remove,
        archive-test,
        archive-convert,
        // A file encrypted or opened (the person's post-quantum identity or a
        // passphrase), an Incus job, the installer written to a stick: none
        // of them a download, which is what the row used to say.
        seal,
        unseal,
        incus,
        stick-write,
    }

    // What `done` and `total` are counted in.
    enum amount {
        bytes,
        items,
    }

    record job {
        id: u64,
        engine: engine,
        errand: errand,
        stage: stage,
        amount: amount,
        done: u64,
        // ZERO MEANS NOT KNOWN — a download with no `Content-Length`, a torrent
        // whose metadata has not arrived. The buffer shows the stage instead of
        // a proportion, and never a bar that pretends.
        total: u64,
        // What it is working on RIGHT NOW: a file name, a torrent's name. Data
        // and not a key — the host already cut it, because the buffer has no
        // path type and no idea what a separator is.
        subject: string,
        // A failure, ALREADY TRANSLATED by the host. Empty when there is none.
        trouble: string,
        // What a `measure` answered, in bytes. Zero when there is no answer.
        answer: u64,
        // Whether this one went out as the PERSON rather than as nobody.
        //
        // On the row because it is the one property of a job that cannot be
        // undone after the fact: an anonymous download can be repeated as
        // oneself, and the reverse is not true — the request already carried
        // who was asking. A screen that did not say which of the two happened
        // would be asking the reader to remember.
        identified: bool,
        // Whether it can be held and let go. A program's install is one run
        // nothing can freeze halfway, and a window offering to hold it would
        // offer a key the queue refuses.
        pauses: bool,
        // Whether it is a finished install that put an entry in the launcher,
        // which `launch-job` opens.
        opens: bool,
    }

    record queue {
        jobs: list<job>,
    }

    // ============================================================
    // DISKS — what the formatting buffer draws, and never reads.
    // ============================================================

    // WHY THE BUFFER GETS A LIST AND NOT A WAY TO ASK.
    //
    // A component has no bus, no filesystem and no parser (invariant 11), and
    // giving it one would be giving it the machine. The host reads udisks,
    // applies the rules — what is a holder, what is quiet, what is somebody
    // else's loop — and hands over what is left, already cut and already
    // decided. The buffer draws it and names an id it was GIVEN; the host
    // checks that id against the list it just sent.
    //
    // WHAT IS NOT CUT IS WHAT THE RUNNING SYSTEM NEEDS. It arrives with
    // `needed` filled in, and it is drawn: somebody looking for their disk has
    // to FIND it and then read why it is not on offer. Omitting it would send
    // them looking for a row that is not there, and the next thing they reach
    // for is a terminal, which asks nothing.
    record device {
        // The id the host gave it. Opaque HERE and a udisks object path over
        // there — the buffer must not take it apart, and cannot: a device with
        // no partition table has no number to parse out of it.
        //
        // It is never drawn: a udisks object path embeds the drive's SERIAL
        // NUMBER, and this repository is public (invariant 13).
        id: string,
        // What to call it. Already chosen by the host: the label when there is
        // one, the device node otherwise.
        name: string,
        // `/dev/sda2`. Shown because it is what somebody compares against what
        // `lsblk` told them.
        node: string,
        // `vfat`, `ntfs`, `btrfs` — or empty, which is a partition with nothing
        // on it yet. Empty is a REASON to format, not a failure.
        kind: string,
        // How big, in bytes. The buffer has no formatter; the host sends the
        // number and the SENTENCE is built from a text key.
        bytes: u64,
        // Is a filesystem from it mounted right now?
        mounted: bool,
        // Can the drive it sits on be pulled out?
        removable: bool,
        // WHY THIS ONE MUST NOT BE TOUCHED, already resolved and already
        // translated — the mount point, or the word that decided. Empty means
        // it is spare.
        //
        // The buffer uses it to not offer, and the HOST refuses anyway. A guard
        // that lives only in the thing being guarded is a guard that holds
        // until somebody writes a second buffer.
        needed: string,
        // Is this the whole disk rather than one partition of it?
        //
        // The difference decides which questions are worth asking: a whole disk
        // can be given a fresh partition table, and a partition cannot.
        whole: bool,
    }

    // WHAT BECAME OF THE LAST `effect::format`.
    //
    // The same channel `copied(bool)` opened and for the same reason: an effect
    // that acts on the machine has to answer, or the buffer can only show an
    // optimistic "done!" — which lies exactly when it matters. A format that
    // worked shows up on its own, in the next `rack`; one that was REFUSED
    // shows up nowhere, and this is the only way the person hears about it.
    record outcome {
        // Did it work?
        done: bool,
        // What went wrong, ALREADY a sentence — empty when `done`.
        //
        // Built on the host from the refusal's NAME, because udisks' prose is
        // upstream's to reword and this buffer has no bundle to look a key up
        // in (invariant 11).
        trouble: string,
    }

    // Every disk the machine has, as the host last read it.
    record rack {
        devices: list<device>,
    }

    // ONE KEYBOARD, as the kernel reports it and as the person has decided.
    //
    // `id` is `vendor:product`, which is what keyd matches on and is NOT
    // unique: two of the same model report the same pair. The screen says so
    // rather than pretending, because a person with two identical keyboards
    // configures them together whether they meant to or not.
    record board {
        id: string,
        name: string,
        // Built into this machine, rather than plugged or paired into it. A
        // list of "AT Translated Set 2 keyboard" and "Bluetooth Keyboard" is a
        // list where only one of them is obvious.
        built-in: bool,
        // What this keyboard has been told, as the keyd names of a key and of
        // what it becomes. Empty for a keyboard nobody has touched.
        decided: list<tuple<string, string>>,
    }

    // A WORD OF THE VOCABULARY: what keyd calls it, and the text key that
    // names it on screen.
    //
    // IT TRAVELS RATHER THAN BEING COMPILED IN, because invariant 11 stands:
    // the buffer holds no table of ours and does not translate. It receives
    // the ids and hands them back, and the HOST resolves both.
    record word {
        // keyd's own word. Empty, among the choices, means "leave it alone".
        keyd: string,
        // The text key. The host resolves it; the buffer never reads it.
        text: string,
        // Does the meaning depend on how long the key is held? Only a choice
        // answers this, and the screen says it out loud.
        holds: bool,
    }

    // EVERY KEYBOARD, AND WHAT A KEY CAN BE MADE INTO.
    //
    // The whole state, never a delta — the rule `rack` and `queue` follow, and
    // for the same reason: a buffer that assembled a picture out of changes
    // would be a second place where the truth lives.
    record boards {
        // Which keys are offered, in the order they are drawn.
        keys: list<word>,
        // What each can become. The FIRST is the way back.
        choices: list<word>,
        // The keyboards themselves.
        boards: list<board>,
        // The rules could not be written, and this says why — already a text
        // key. Empty when the last write went through.
        trouble: string,
        // keyd's name for the key the LEADER is made of.
        //
        // It travels because the screen has to warn before that one is moved:
        // every rendered file claims it, and a rule written after it wins — so
        // remapping it is how somebody loses the key that opens everything, on
        // that keyboard. The buffer holds no table of ours and could not know
        // which key it is.
        leader: string,
        // Together or Independent — what the switch shows.
        mode: keyboard-mode,
        // Every unit, plugged or remembered, for Independent mode.
        units: list<unit-board>,
        // The cursor numbers a unit can be put on: every cursor there is, and
        // the next one after them.
        cursors: list<u16>,
        // The layouts this machine's xkeyboard-config has.
        layouts: list<layout-word>,
    }

    // HOW THE KEYBOARDS WORK TOGETHER.
    enum keyboard-mode {
        // As one, through keyd, on the first cursor's seat — the default.
        together,
        // Each unit its own virtual twin, on its cursor's seat, with its own
        // layout, remaps and leader key.
        independent,
    }

    // ONE KEYBOARD UNIT, for Independent mode — a device, not a model: two of
    // the same model on one desk are two people there.
    record unit-board {
        // Who it is: the host's hash of where it is plugged and its address.
        identity: string,
        // What the kernel calls it.
        name: string,
        // Its model, `vendor:product`.
        model: string,
        // Built into this machine.
        built-in: bool,
        // Plugged in right now. A unit that is not is still listed, with what
        // was decided about it, and its rows refuse.
        plugged: bool,
        // The cursor it types through.
        cursor: u16,
        // Its xkb layout and variant, empty for the machine's. The variant's
        // field says `layout-variant` because `variant` is a WIT keyword.
        layout: string,
        layout-variant: string,
        // keyd's name for the key whose tap is its leader.
        leader: string,
        // Repeat rate (per second) and delay (ms); zero is the compositor's.
        repeat-rate: u16,
        repeat-delay: u16,
        // What its keys become, as `board.decided`.
        decided: list<tuple<string, string>>,
    }

    // AN XKB LAYOUT the machine has: its code, the name xkeyboard-config gives
    // it (data, like a device's name), and the variant codes it offers.
    record layout-word {
        code: string,
        name: string,
        variants: list<string>,
    }

    // ONE SETTING OF A UNIT.
    variant unit-setting {
        cursor(u16),
        layout(string),
        layout-variant(string),
        leader(string),
        repeat-rate(u16),
        repeat-delay(u16),
        // keyd's key name, and what it becomes; empty undoes.
        remap(tuple<string, string>),
    }

    // WHICH UNIT, AND WHAT CHANGES.
    record unit-change {
        unit: string,
        setting: unit-setting,
    }

    // WHAT A KEY ON A KEYBOARD SHOULD BECOME.
    //
    // A demand cannot carry this: it is a verb plus an INDEX, and "capslock
    // becomes escape on the keyboard whose id is 3554:f605" is three values.
    // It is the same reason `setting` exists beside `demand`.
    record remap {
        // `vendor:product`, out of the `board` this came from.
        device: string,
        // keyd's name for the key, out of `boards.keys`.
        key: string,
        // keyd's name for what it becomes, out of `boards.choices`. Empty
        // leaves the key alone, and is how a remap is undone.
        becomes: string,
    }

    // A filesystem this build can actually CREATE.
    //
    // The list is not "what exists": it is what the slimmed udisks carries a
    // `mkfs` for. XFS is deliberately absent — its tooling is 212 MiB, most of
    // it a Python environment for `xfs_scrub`, and this distro is btrfs. The
    // buffer SAYS so rather than leaving a gap somebody has to guess about.
    enum recipe {
        // vfat. Opens on every computer there is.
        universal,
        // exfat. Like the above, without the four-gigabyte file limit.
        large-files,
        // ntfs. What Windows writes.
        windows,
        // ext4. The ordinary Linux one.
        linux,
        // btrfs. Snapshots and checksums; what this distro runs on.
        modern,
    }

    // A key binding, declared as DATA (section 7.9). The buffer never
    // captures a key imperatively.
    // ============================================================
    // THE BRAIN — what the machine does by itself, for whoever declared
    // `capability::brain`.
    //
    // THE FIELD ORDER OF EVERY RECORD BELOW IS THE ORDER `ronoctua-runtime`
    // LOWERS IT IN. `wasmtime` zips a record POSITIONALLY against the WIT and
    // only then compares names — a field moved on one side alone fails when the
    // function is CALLED, with a message about a name.
    // ============================================================

    // WHAT a reading of the pulse measures.
    enum vital {
        // RAM in use, in per cent of the total.
        ram-used,
        // Stall waiting for memory, in per mille of a ten-second window.
        memory-stall,
        // Stall waiting for a processor, in the same unit.
        cpu-stall,
        // Running off the battery: `1` for yes, `0` for no.
        on-battery,
    }

    record vital-sign {
        of: vital,
        amount: u16,
    }

    // How busy the machine is, as the gate last read it.
    //
    // A LIST and not a record with a field per reading, for the reason
    // `survey.readings` is one: what the machine does not measure does not
    // report, and zero is a real reading. A kernel with no `/proc/pressure/cpu`
    // simply has no `cpu-stall` here, and the screen draws a dash instead of a
    // number nobody took.
    record pulse {
        at: u64,
        signs: list<vital-sign>,
    }

    enum standing {
        idle,
        queued,
        running,
    }

    // What is in the way. `none` is not a failure being hidden: it is what a
    // row says when nothing is holding it, the same shape `guard-mode::unknown`
    // has.
    enum hold-kind {
        none,
        ram,
        cpu,
        battery,
        busy,
        network,
        asleep,
    }

    // How loud one line of the brain's own log is — the log's own levels.
    enum log-level {
        error,
        warn,
        info,
        debug,
        trace,
    }

    // ONE LINE OF THE BRAIN'S OWN LOG. The text is DATA — the daemon's words as
    // it wrote them — and the time is formatted by the host, which has the zone
    // (invariant 11).
    record log-line {
        // Its place in the daemon's log, counted from the daemon's start.
        seq: u64,
        // `HH:MM:SS`.
        at-text: string,
        level: log-level,
        // `target: message key=value …`, as the log prints it.
        text: string,
    }

    // `skipped` FIRST, and deliberately the harmless one: a record built from a
    // file that lost a field must not read as "it worked".
    enum outcome-kind {
        skipped,
        done,
        failed,
        // NOTHING RAN, because the machine was in no state for it.
        //
        // It is not a failure and it is not a run: the moment came, the gate
        // said no, and the next moment will be along. It is recorded ONCE per
        // episode and not once per tick — the runner looks every thirty
        // seconds, and a log that wrote a line each time would be a wall of
        // "RAM is busy" with everything that actually happened underneath it.
        held,
        // NOTHING RAN: a module wrote down something it NOTICED — a process
        // the kernel killed, an error in the journal. Like `held`, not a run;
        // what it says is the record's `says`, already made into a sentence in
        // `says-text`.
        noted,
    }

    // Whether a task repeats, or happens once and is then gone.
    //
    // Every task the brain has today is a routine. One-shots are coming, and
    // the list has to be able to say which is which BEFORE they arrive:
    // otherwise the day one lands, every row on the page changes meaning at
    // once. A glyph says it, and a colour says it again — a glyph two cells
    // wide is a small thing to hang a distinction on.
    enum task-kind {
        routine,
        once,
        // A MODULE THAT ONLY LISTENS — a journal, a path, a clock — and runs
        // nothing on a schedule. Its row says "watching" instead of a date.
        watch,
    }

    // Which stretch of the person's day a task prefers. The hours each one
    // covers are the brain's, with the reason written beside them.
    enum day-part {
        any,
        night,
        morning,
        afternoon,
        evening,
    }

    record step-outcome {
        id: string,
        ok: bool,
        seconds: u32,
        trouble: string,
    }

    // One run, as the journal keeps it.
    //
    // `run-record` and NOT `run`: the layout vocabulary every component now
    // imports (`ronoctua-design`) already has a `Run` — one line of a screen —
    // and a buffer that imported both would resolve one of them silently. The
    // name is longer at the one place it is written and unambiguous everywhere
    // it is read, which is the same argument `buffer-state` makes.
    record run-record {
        // WHICH TASK THIS WAS, and it crosses because the home page shows one
        // list of everything the brain has done. Inside a task's own page it
        // is redundant and costs a string; on the home page there is no other
        // way to say whose run a row is.
        task: string,
        // And its name, translated, for the same reason `task-state` carries
        // one: the log reserves a column for it and could not measure it.
        task-text: string,
        began: u64,
        ended: u64,
        // WHEN IT RAN, already formatted by the host, in ISO. The component has
        // no zone and no calendar (invariant 11), so the number is for the
        // arithmetic this side does and the text is for the date it cannot
        // compute.
        when-text: string,
        outcome: outcome-kind,
        // The step it failed at, by id. Empty when there is none.
        at: string,
        // A WORD of the brain's own — `runaway`, `aborted`, `off` — drawn
        // through `brain-why-<word>`. Empty when the reason came from the
        // machine, in which case `trouble` carries it. They are two fields
        // because they are drawn differently: one through the bundle, the other
        // exactly as it arrived.
        why: string,
        // What the machine said, verbatim. Empty when it said nothing.
        trouble: string,
        steps: list<step-outcome>,
        // THE KEYS, so the component never builds one out of an id — a
        // module's words are its own (`<module>-why-<word>`), and a key built
        // by convention on this side is a key nobody declared.
        //
        // The task's name.
        task-key: string,
        // The name of the step it stopped at. Empty when `at` is.
        at-key: string,
        // The key of `why`. Empty when `why` is.
        why-key: string,
        // What a `noted` record says, as a key, and the sentence the host
        // made of it with its values — the component cannot format a size or
        // a moment, and a key with holes in it is not something it can draw.
        // Both empty for every other kind.
        says: string,
        says-text: string,
    }

    // One thing a task runs, as the screen draws it.
    record task-step {
        id: string,
        // What it really runs. DATA — a command line is not translated.
        command: string,
        needs-root: bool,
        // Whether it will run.
        on: bool,
        // WHETHER THE DISTRO SHIPS IT ON, which is the DECLARED fact and the
        // only one of the two that is not derived.
        //
        // This used to be `changed: bool` — "does `on` differ from the
        // default" — computed on the daemon's side and sent. The default
        // itself never crossed, and that cost two things. On screen, a page
        // could say "you changed this" and could not say what it had been
        // changed FROM. And in the host, the key that flips a step had no way
        // to work out what flipping meant, because the person's file holds
        // exceptions to a default nobody had told it.
        //
        // Sending the DEFAULT instead makes "changed" a subtraction anybody
        // can do (`on != on-by-default`) and leaves exactly one authority for
        // it: the update's `steps.nix`, where it is declared.
        on-by-default: bool,
        // The keys of its name and of the line under the cursor, declared by
        // the module that owns the step — never `update-<id>` built here.
        name-key: string,
        does-key: string,
    }

    // SOMETHING A PERSON CAN ASK OF A MODULE BY NAME — the registry command
    // `<module>-<id>`, offered on its page, beside a notice, or on a row.
    record module-action {
        // Its id inside the module: what `act-page`, `act-row` and a notice's
        // control hand back.
        id: string,
        // `cmd-<module>-<id>`.
        label-key: string,
        // Whether it acts on a ROW of the module's screen.
        row: bool,
        // The key of the question it asks first; empty when it asks none.
        asks-key: string,
    }

    record task-state {
        // English, kebab-case. `brain-task-<id>` names it on screen.
        id: string,
        // THE SAME NAME, ALREADY TRANSLATED, and it is for MEASURING.
        //
        // The component draws the KEY — so a language changed at run time
        // still reaches the screen — and it reserves a column for the name.
        // Reserved BLIND that column was twenty-six cells for a word five
        // cells wide, which is the gap the owner photographed across the top
        // of the page and down the log's second column.
        //
        // Same rule as `next-text` and `when-text` beside it: the number is
        // for the arithmetic this side cannot do, the text for the thing it
        // cannot compute. A host that sends nothing gets the old reservation,
        // because the component falls back to it.
        name-text: string,
        // Whether it repeats or happens once.
        kind: task-kind,
        standing: standing,
        enabled: bool,
        interval-days: u16,
        part-of-day: day-part,
        // The next moment it will be considered, in epoch seconds. `0` when
        // there is none — it is switched off, or it only runs when asked.
        next: u64,
        // The same moment, already formatted. Empty when there is none.
        next-text: string,
        hold: hold-kind,
        // Why it is not due at all, as a word. Empty when it is.
        why-not: string,
        // Whether `last` means anything: a record cannot be absent, and
        // `began: 0` would be a moment in 1970.
        ran: bool,
        last: run-record,
        // The last few runs, NEWEST FIRST — `last` is `history[0]` when there
        // is one.
        //
        // Both, and not one derived from the other: `last` is what a row on the
        // list shows and `ran` is what says it means anything, and an empty
        // list would have made every reader of `last` check the length first.
        // The ceiling is the brain's, not this record's: what crosses is what
        // it decided to keep.
        history: list<run-record>,
        steps: list<task-step>,
        // Whether it keeps a calendar. A page draws the cadence and the window
        // only when it does: a relief that comes due when the disk is short
        // has neither.
        calendar: bool,
        // `brain-task-<id>` and its `-does`, and the key of `why-not` — what
        // the component draws, instead of keys it would build itself.
        name-key: string,
        does-key: string,
        why-key: string,
        // THE MODULE'S PAGE MOVED when this does: a page that shows the
        // module's screen asks for it again (`request::watch-screen`), and
        // never on a clock. The screen itself is not in the mind.
        screen-generation: u64,
        // What a person can ask of it by name, in the manifest's order.
        actions: list<module-action>,
    }

    // The warning that something is about to happen.
    //
    // `task` EMPTY means there is none — the same shape `mind.running` uses.
    // What crosses is the DEADLINE and never a ticking number: whoever draws
    // already beats a one-second clock, and a daemon that pushed a digit every
    // second would wake three processes to redraw one.
    record announcement {
        task: string,
        total-seconds: u16,
        deadline: u64,
        why: string,
    }

    // SOMETHING A MODULE WANTS SAID, without anybody having asked.
    //
    // The brain's strip under the minibuffer says the loudest one, and the
    // brain's page lists every one of them (`mind.notices`). A WATCH's whole
    // output is a sentence, and a sentence that only appeared on a screen
    // somebody had to open would be a watch nobody hears.
    //
    // A KEY AND ITS SENTENCE: the key for whoever translates, the sentence the
    // host made of it with its values — a component cannot format a size or a
    // moment, and a key with holes in it is not something it can draw. An
    // empty `controls` is a notice that only tells, which is not a lesser
    // kind: what a module cannot know is safe to do, it does not offer.
    record notice {
        // Whose it is, and its id inside the module.
        module: string,
        id: string,
        // What it says, as a text key.
        says: string,
        // The sentence, made by the host out of `says` and `args` in the
        // person's language: the component draws it and measures it.
        says-text: string,
        // Each value, already formatted — for a component that lays the
        // values out one per row.
        args: list<notice-arg>,
        level: notice-level,
        // Since when it has been true: the number for the arithmetic, the
        // text for the date the component cannot compute.
        since: u64,
        since-text: string,
        // Actions offered beside it.
        controls: list<module-action>,
        // Whether it may be put away, and the snoozes it offers, in minutes
        // (the first is the strip's).
        dismissable: bool,
        snooze: list<u16>,
    }

    // HOW LOUD A NOTICE IS. The order is the strip's precedence, quietest
    // first: an alarm beats even the countdown.
    enum notice-level {
        info,
        warn,
        danger,
        alarm,
    }

    // One value of a notice's sentence, by its name, formatted by the host.
    record notice-arg {
        name: string,
        text: string,
    }

    // ONE ROW OF THE ACTIVITY LOG: consecutive records that say the same
    // thing, folded. Forty holds for a busy RAM are one row — "Last: <when>",
    // how many, and the first — that opens into all of them.
    record activity-row {
        // What the row draws.
        newest: run-record,
        // How many records it folds; `1` is one that stands alone.
        repeats: u32,
        // When the newest and the oldest of them happened, formatted.
        last-text: string,
        first-text: string,
        // All of them, newest first, `newest` included.
        members: list<run-record>,
    }

    record gate {
        ram-ceiling-pct: u16,
        cpu-stall-per-mille: u16,
        abort-on-battery: bool,
    }

    // Everything the brain knows, all at once.
    //
    // Whole and never a delta, for the reason `queue` is whole: a delta needs
    // both sides to agree on what they last saw, and what is being agreed about
    // here is when the machine will rebuild itself.
    record mind {
        // The daemon's clock, in epoch seconds. It crosses because the
        // component has none (invariant 11): a countdown is `deadline - now`,
        // and without the second number the first is a moment this side cannot
        // place.
        now: u64,
        pulse: pulse,
        tasks: list<task-state>,
        queue: list<string>,
        // What is running, by id. Empty when nothing is.
        running: string,
        // The task whose next run is a rehearsal. Empty when none is.
        rehearsing: string,
        announcement: announcement,
        gate: gate,
        // The cadences one key steps through, in days.
        //
        // The LADDER crosses instead of living in the component, because which
        // steps are worth having is a policy with its reason written in
        // `ronoctua-brain` — and a screen that stepped by one would take
        // twenty-three presses to get from a month to a week.
        cadence: list<u16>,
        // EVERYTHING THE BRAIN HAS DONE, newest first, across every task —
        // FOLDED: consecutive records that say the same thing are one row
        // (`journal::grouped`, in the brain), and the row opens into them.
        //
        // A task's own `history` answers "how has this one been going"; this
        // answers "what has this machine been doing", which is the question
        // somebody opens the page with. They are two lists and not one view of
        // one list, because the per-task one has a floor — a task that runs
        // monthly keeps its last ten however much else happens — and this one
        // has a ceiling. Neither can be cut out of the other.
        activity-rows: list<activity-row>,
        // HOW MANY RECORDS THAT LIST FOLDS AT MOST, which is not how many it
        // holds today.
        //
        // It crosses for the reason `cadence` does: it is a POLICY, decided in
        // `ronoctua-brain` with its argument beside it, and the screen names it
        // — the activity block's title says what it is a window ONTO, and "the
        // last hundred" is a different promise from "these fourteen". Written
        // into the two translations instead, it would be a number in four
        // places that can disagree with the one that does the cutting.
        remembers: u32,
        // AND HOW MANY OF ITS OWN A TASK KEEPS, which its `history` is the
        // whole of.
        //
        // The same argument, one list down: the `History` heading on a task's
        // page is a window onto this number, and the owner asked it to say so
        // — *"algo como (last 10)"*. It is `journal::RECENT`, the brain's own
        // floor on pruning, and a screen that wrote `10` into two translations
        // would be a fourth place for the number to disagree with the one that
        // does the keeping.
        recent: u32,
        // EVERY NOTICE every module raised, in the order the strip ranks them:
        // an alarm first, then danger, warn and info, the newest first among
        // equals. Empty is a machine with nothing to say.
        notices: list<notice>,
    }

    // One step, switched on or off by the id the last `mind` gave.
    record step-switch {
        id: string,
        on: bool,
    }

    // WHICH preference, and its VALUE.
    variant knob {
        interval-days(u16),
        part-of-day(day-part),
        enabled(bool),
        step(step-switch),
        // Every step back to what the distro ships. It carries nothing: there
        // is one default and it is the flake's.
        reset-steps,
    }

    // A preference the person changed.
    //
    // # Why it is not a `demand`
    //
    // Because a `demand` is a verb plus an INDEX, and that shape fits every
    // request there is: pause job seven, close consumer three. A preference is
    // not that — it carries a VALUE the person chose. Bending `demand` to hold
    // one would put brain-shaped fields on the record every other buffer sends,
    // which is the argument `plan` already carries a few hundred lines above.
    record setting {
        // Which task it belongs to, by the id the last `mind` gave.
        task: string,
        knob: knob,
    }

    // ------------------------------------------------------------------
    // A MODULE'S OWN PAGE, as rows of DATA — asked for when its task's
    // `screen-generation` moves (`request::watch-screen`) and pushed by the
    // host through `input::module-screen`. Never carried in the `mind`: a page
    // nobody is looking at costs nothing.
    //
    // The component draws every module's page the same way and names none.
    // ------------------------------------------------------------------

    // The colour of a row, by MEANING — one token each on the host's side.
    enum brain-tone {
        quiet,
        watching,
        warning,
        danger,
        accent,
    }

    // A moment: the number for the arithmetic, the text for the date.
    record timed {
        at: u64,
        text: string,
    }

    // A size: the number for the arithmetic, the text in the person's units
    // and decimal mark.
    record measured {
        bytes: u64,
        text: string,
    }

    // One cell of a row.
    variant screen-cell {
        empty,
        // A text key.
        key(string),
        // Data, drawn as it is — including what a person typed.
        data(string),
        moment(timed),
        count(u64),
        bytes(measured),
    }

    record module-row {
        // Its id inside the module — DATA; the host hands it back to the
        // module when the row's action is asked for.
        id: string,
        label: screen-cell,
        value: screen-cell,
        note: screen-cell,
        tone: brain-tone,
        // The id of the action a press runs; empty is a row that only tells.
        act: string,
        // The id of its SECOND action, on a key of its own; empty when it
        // has none.
        also: string,
    }

    record module-section {
        // Its title, as a key.
        heading: string,
        rows: list<module-row>,
    }

    record module-screen {
        // Whose, by the task's id in the last `mind`.
        module: string,
        // The `screen-generation` it answers.
        generation: u64,
        sections: list<module-section>,
        // WHY THERE IS NO PAGE, as a sentence the host made — the brain refused
        // it, or did not answer. Empty when the page came. A page with nothing
        // on it and a page refused must not look the same.
        refused: string,
    }

    record binding {
        // The sequence, like `m f s`. Only under `SPC m`: the host REFUSES at load time
        // whoever tries to bind under a global prefix.
        keys: string,
        // The command's id, from the registry.
        command: string,
    }

    // What the buffer contributes to the modeline.
    record segment {
        id: string,
        content: text,
    }

    // THE TONE A STATE IS DRAWN IN — a name, never a value (invariant 11).
    //
    // `standard` is what every buffer uses and means "the host decides": the
    // base state comes out quiet and every other one comes out in the SINGLE
    // token the whole system reserves for an alternative state. That is the
    // point of it having a name of its own — a theme changes one line in
    // `assets/tokens/colors.nix` and every buffer follows.
    //
    // The other four exist for the day a state has to say something stronger
    // than "not the usual one" — a file manager waiting for a permission answer
    // is not the same kind of not-usual as a search field.
    enum tone {
        standard,
        accent,
        success,
        warning,
        error,
    }

    // ONE STATE THE BUFFER CAN BE IN.
    //
    // `buffer-state` and not `state`, because every component that has one calls
    // its own whole memory `State` — two things by that name in one file is how
    // a reader stops knowing which is which. The name is longer at the one place
    // it is written and unambiguous at every place it is read.
    //
    // The major mode says what KIND of buffer this is; the state says what it is
    // doing right now. Both existed before this record — the second one just had
    // no name, so typing a letter into the icon browser silently became a search
    // and the modeline went on saying the same word it said at rest.
    //
    // `id` is ENGLISH and kebab-case, like every other name in this repository
    // (invariant 18); what reaches the screen is `state-<id>` out of the i18n
    // (invariant 8). The first state a buffer declares is its BASE, its id has to
    // be `normal`, and `Esc` is what returns to it.
    record buffer-state {
        id: string,
        // The key that selects it directly under `SPC w s`. Unique within the
        // buffer — the host refuses a repeat at load, because two states on the
        // same letter is a menu where one of them is unreachable.
        letter: char,
        tone: tone,
    }

    // What the buffer says about itself in `init` (section 7.6).
    record descriptor {
        name: string,
        mode: string,
        // At least one, and the first is the base. A buffer with a single
        // `normal` is the normal case and costs it one line.
        states: list<buffer-state>,
        keymap: list<binding>,
        commands: list<string>,
        segments: list<segment>,
        capabilities: list<capability>,
        // Keys whose TEXT this buffer needs as STATE, not as drawing.
        //
        // Anything it only shows goes out as `text::key` and is translated when
        // the host draws it. This list is for the other case: text the buffer
        // holds, parses or writes back — see `phrase`. The host answers with
        // `input::phrases` before the first frame.
        phrases: list<string>,
    }

    // How many CELLS of height each scale occupies.
    //
    // This is NOT a token value (invariant 11): it is a cell count, the
    // same unit the buffer already counts rows and columns in. What computes it is
    // the host, which knows the font size and the line height.
    //
    // Without this, the buffer had to GUESS how many rows a large run
    // occupies — and it guessed wrong: the sheet's `huge` glyph came out clipped
    // at the bottom, touching the rule, because four cells were 116 px and its
    // line box is 168.
    record heights {
        small: u16,
        base: u16,
        normal: u16,
        large: u16,
        huge: u16,
    }

    record context {
        columns: u16,
        lines: u16,
        heights: heights,
        // THE "NO HEADER" MODE is on — the person asked for every window to
        // give up its top line (`ronoctua_shell_kit::header`). A buffer that
        // draws a header of its own (a glyph, a name, its taught keys) must
        // then draw NONE and lay its content from row 0: the keys move to the
        // footer's minibuffer, where `LEADER Alt` surfaces them. A buffer with
        // no header of its own ignores it.
        hide-header: bool,
    }

    // Where the pointer touched, in CELLS of the buffer's grid — never in pixels.
    //
    // Invariant 11 is not about units, it is about the boundary: a pixel is
    // a Wayland and screen-scale thing, and the buffer knows neither
    // of the two. What converts (and what subtracts the window's margin) is the host,
    // exactly as it already converts a key into `character`.
    //
    // The origin is the same as `text-command`'s: the buffer's (0,0) cell, and not
    // the window's corner.
    record position {
        column: u16,
        line: u16,
    }

    // WHERE A POINTER IS, AND WHICH ONE.
    //
    // Every cursor is a seat, and the host answers every one of them
    // (`crate::seats` in the shell): two cursors can rest on a buffer at
    // once, each on its own row. `seat` is the cursor's COLOUR number, from 0
    // — what a buffer paints that cursor's hover with (`color::cursor-hover-*`
    // through `Role::HoverOf`), and nothing a buffer has to understand beyond
    // "two different numbers are two different hands".
    //
    // A RECORD AROUND `position` and not a third field on it: `position` is
    // what a click and a wheel carry too, and those do not need to say which
    // hand. `wasmtime` lowers a record POSITIONALLY, so the nesting is the
    // shape, and the runtime writes it exactly this way.
    record pointed {
        at: position,
        seat: u16,
    }

    // ONE key the buffer declared, with the text the host resolved for it.
    //
    // # Why a buffer receives a translated string at all
    //
    // Because `text::key` only reaches the person: it is resolved when the
    // host DRAWS, and the buffer never holds what came out. That covers
    // everything a buffer only shows — and it does not cover text the buffer
    // also HOLDS and READS BACK.
    //
    // The three browsers' search field is that: the buffer keeps the string,
    // parses it, and the person edits it. Written as `text::data` it opened
    // `familia:emoji` in an en-GB session; written as a `text::key` the buffer
    // could not have re-read what it drew.
    //
    // So the host hands the text over, exactly as it hands over a clipboard in
    // `paste`. The buffer still cannot WRITE a phrase of UI in any language —
    // it can only echo one it was given.
    // A turn of the wheel, at a cell.
    record wheel-event {
        // Where the pointer was, in the buffer's own cells.
        at: position,
        // How many lines, and which way. NEGATIVE is towards the top of the
        // list — the direction a list's offset moves, not the direction the
        // fingers went, because every caller of this subtracts it from an
        // offset and a sign that flipped on the way in would flip there.
        lines: s16,
    }

    // A BAR THAT WAS DRAGGED, answered as the first row to draw.
    //
    // The host knows where it painted every `bar` — it built the thumb out of
    // the three numbers the command carried — so it is the only side that can
    // turn a pointer at a height into a row. What it cannot know is WHICH
    // list: a page may have several, and only the buffer knows where its
    // blocks are. So the position crosses for the same reason it does on a
    // wheel, and the answer is a row rather than a delta: a drag is absolute,
    // and a sum of deltas drifts away from the hand.
    record scroll-event {
        // Where the pointer is, in the buffer's own cells. The COLUMN and the
        // LINE both: the line says which block, and the column tells a page
        // with two lists side by side which of the two was grabbed.
        at: position,
        // The row that should now be the first one drawn in that block.
        first: u32,
    }

    record phrase {
        key: string,
        text: string,
    }

    variant input {
        // A NAMED command, dispatched by the host when the buffer's keymap
        // key sequence completes. It is the other side of the descriptor's
        // `binding`: the buffer declares, the host resolves the key, and the
        // command comes back through here — the buffer never captures a key.
        command(string),
        // `character`, and not `char`: `char` is a WIT built-in type and cannot
        // name a case. The parser complains with "failed to resolve directory",
        // which points at the directory and not at the word.
        character(char),
        up,
        down,
        // A GRID buffer needs all four directions: with two, moving sideways
        // only happens by line overflow, and the cursor jumps
        // from one end of the screen to the other.
        left,
        right,
        confirm,
        cancel,
        delete,
        // What `Tab` means: TOGGLE whatever is toggleable on
        // screen — in the glyph browser, the filter panel.
        //
        // # Why it is a case, and not a character
        //
        // Because without this `Tab` falls into the host's `_` and arrives as
        // `character('\t')`. The buffer pushes it into the search like any
        // letter, and the result is an INVISIBLE tab in the field, which does
        // not match any glyph and cannot be seen. A key that
        // looks like it does nothing is worse than one that is not bound: there is no
        // way to find out what it did.
        //
        // The name is the INTENT, like the rest: `up` and not `Up`, `confirm` and
        // not `Enter`. What decides what to toggle is each buffer.
        toggle,
        // The RESULT of an `effect::copy` asked for earlier.
        //
        // What knows whether the copy worked is the HOST — it is what talks to the
        // clipboard. Without this way back, the buffer could only show
        // an optimistic "copied!", which lies exactly when it matters.
        copied(bool),
        // GO TO THIS STATE — the host's half of the state contract.
        //
        // It arrives when somebody pressed `Esc`, held it and used an arrow, or
        // chose a state under `SPC w s`. The buffer is told the id it declared,
        // never a key: the same rule as `command`, and for the same reason —
        // the component does not capture keys (invariant 11 and section 7.9).
        //
        // A buffer that changes state on its own says so with
        // `effect::state-changed`, which is the other half. Without both, the
        // modeline would be right only about the changes it caused itself.
        enter-state(string),
        // Text coming from the clipboard (`Ctrl+V`).
        //
        // Already resolved by the host: the buffer does not read the clipboard, just as it does not read a
        // file (invariant 11). It only receives the text.
        paste(string),
        // The keys this buffer declared in `descriptor.phrases`, resolved.
        //
        // ALL of them at once, and before the first frame: a buffer that has
        // to draw with them cannot be handed them one at a time and redraw in
        // between. The declaration is the gate — whoever declares nothing gets
        // nothing, which is the same shape `capability` gives the inputs below
        // without a capability of its own: a phrase is the translation of a key
        // the buffer itself named, not a reading of the machine.
        phrases(list<phrase>),
        // A left-button click on a cell.
        //
        // What resolves WHICH item is there is the buffer, because only it knows its
        // own layout — the glyph grid moves two rows at a time and
        // has its own header and footer. The host sending "item number N"
        // would be the host reimplementing the buffer's layout.
        click(position),
        // THE WHEEL, over a cell of the buffer's grid.
        //
        // The other half of `command::bar`: a scrollbar nobody can turn is a
        // picture of a control. It arrives in LINES and never in pixels, the
        // same wall `click` respects — a pixel is a Wayland and screen-scale
        // thing, and the buffer knows neither (invariant 11).
        //
        // The arithmetic that turns a wheel into lines is the host's, and
        // there is one of it: `surface::axis_lines` and `wheel_lines`, which
        // carry the leftover fraction between events. Five windows once wrote
        // `(pixels / line) as i64 * 3` each, which throws the fraction away
        // and then multiplies what is left by three — a slow gesture moved
        // nothing and then jumped.
        //
        // The POSITION is here for the same reason `click` carries one: a
        // screen with two lists has to know which one the pointer was over,
        // and only the buffer knows where its lists are.
        wheel(wheel-event),
        // A BAR DRAGGED WITH THE MOUSE. The other half of a scrollbar: one
        // that is drawn and cannot be grabbed is a picture of a control, which
        // is the sentence this repository already keeps about the wheel.
        scrolled(scroll-event),
        // The machine's memory, ALREADY READ. Only for whoever declared
        // `capability::system`.
        //
        // It arrives on its own — a tick of the host's clock —, which is the
        // one input in this list that nobody pressed. A screen that shows how
        // much memory there is has to change while it is being looked at;
        // waiting for a key would make it a photograph.
        survey(survey),
        // The transfer queue, ALREADY READ. Only for whoever declared
        // `capability::transfers`.
        //
        // Like `survey`, nobody pressed it: it arrives when the queue changed.
        // Unlike `survey`, it is NOT a clock — the host is subscribed to the
        // queue's own socket on a thread, and a copy that moves no byte for a
        // minute sends nothing in that minute.
        queue(queue),
        // Every disk the machine has. Only for whoever declared
        // `capability::disks`; a buffer that did not gets no thread and no
        // signal, which is what makes the absence structural.
        rack(rack),
        formatted(outcome),
        // Every keyboard, and what a key can be made into. Only for whoever
        // declared `capability::keyboard`.
        //
        // Like `rack`, nobody pressed it: the host reads the kernel and the
        // person's file, and what arrives is the whole picture.
        keyboards(boards),
        // What the machine is going to do by itself, ALREADY READ. Only for
        // whoever declared `capability::brain`.
        //
        // Like `queue`, nobody pressed it: the host is subscribed to the
        // brain's own socket on a thread, and what arrives is the whole mind.
        mind(mind),
        // THE BRAIN'S OWN LOG, whole, oldest first. Only for whoever declared
        // `capability::brain`, and like `mind` nobody pressed it: the host
        // follows the daemon's log on a thread.
        log(list<log-line>),
        // A MODULE'S OWN PAGE, for whoever declared `capability::brain` and
        // asked for one (`request::watch-screen`): pushed when its generation
        // moves, never on a clock.
        module-screen(module-screen),
        // WHERE THE POINTER IS RESTING, in the buffer's own cells.
        //
        // It used to be refused, and the reason written down was that
        // "highlighting the item under the mouse would ask for a frame per
        // pixel of movement". That is false as stated: the pointer moves in
        // PIXELS and this side counts CELLS, so the host delivers only when the
        // CELL changes — a few dozen events crossing a whole screen, not one
        // per pixel. Every other window in the shell has tracked the pointer
        // this way since it was written; the buffer window was the exception,
        // and the exception was an author's assumption rather than a
        // measurement.
        //
        // It carries a `position` and not two fields for the same reason
        // `click` does: `wasmtime` lowers a record POSITIONALLY, and a flat
        // pair here would lower cleanly into the wrong shape.
        hover(pointed),
        // The pointer LEFT. Distinct from a hover nobody can place, because
        // absence and "somewhere I cannot name" are different answers: one
        // clears the highlight and the other keeps it. It names WHICH pointer
        // — one cursor leaving must not put out another's highlight.
        unhover(u16),
        // THE NEXT KEYS ARE THIS SEAT'S. Sent before a key whenever the seat
        // typing into this window changes — one number, the cursor's colour,
        // as `pointed.seat` — so a buffer can keep one selection or one field
        // PER KEYBOARD. A buffer that ignores it treats every keyboard as one,
        // which is what every buffer did before it.
        keyboard-seat(u16),
        // That seat's keyboard LEFT this window.
        keyboard-left(u16),
    }
}

// The world exports an INTERFACE, not loose functions. With loose functions
// `wit-bindgen` generates a `Guest` at the root scope and the name collides as soon as
// there is a second world; with an interface, each has its own module.
interface view {
    // ALL the types named, not only those in the signatures: `wit-bindgen` generates
    // in the interface's module only what it declares it uses, and a record
    // reachable only from inside a `variant` ends up out of scope.
    use types.{
        band-command, capability, command, grid-command, text-command,
        heights, context, color, descriptor, effect, input, binding, position, pointed, segment,
        text,
        // `phrase` is reachable only from inside `input`, which is exactly the
        // case this list exists for.
        phrase,
        // The system ones, for the same reason as all the others: `wit-bindgen`
        // generates in this module only what it declares it uses, and a record
        // reachable only from inside a `variant` ends up out of scope.
        gauge, reading, pressure, consumer-kind, consumer, guard-mode, guard,
        survey, request, demand,
        // And the queue's, for the same reason.
        engine, stage, errand, amount, job, queue,
        // And the disks'. `device` and `recipe` are reachable only from inside
        // `rack` and `plan`, which is precisely the case this list exists for.
        device, rack, recipe, plan, outcome,
        // And the state's — `state` is only reachable from inside `descriptor`,
        // which is exactly the case this list exists for.
        tone, buffer-state,
        // And the brain's. `vital-sign`, `run-record`, `task-step` and the rest are
        // reachable only from inside `mind`, which is precisely the case this
        // list exists for.
        vital, vital-sign, pulse, standing, hold-kind, outcome-kind, day-part,
        step-outcome, run-record, task-step, task-state, announcement, gate, mind,
        log-level, log-line,
        step-switch, knob, setting,
        // And the modules' — reachable only from inside `mind` and `input`.
        module-action, notice, notice-level, notice-arg, activity-row,
        brain-tone, timed, measured, screen-cell, module-row, module-section,
        module-screen,
        // And the independent keyboards', reachable only from inside `boards`
        // and `effect`.
        keyboard-mode, unit-board, layout-word, unit-setting, unit-change
    };

    // Who the buffer is: name, mode, keymap, commands and modeline segments.
    //
    // Called ONCE, at load. This is where the keymap arrives as data, and it is why
    // the host can refuse whoever binds outside `SPC m` before the
    // buffer runs anything at all.
    init: func() -> descriptor;

    // Draws. It does NOT rasterise: it returns the list, and the host draws.
    render: func(ctx: context) -> list<command>;

    // Receives an already-normalised key and returns what should happen.
    //
    // An empty list = nothing changed, do not redraw. This used to be `-> bool`, and the
    // buffer had no way to ask for a copy nor to fire a command.
    event: func(e: input) -> list<effect>;
}

world buffer {
    export view;
}
