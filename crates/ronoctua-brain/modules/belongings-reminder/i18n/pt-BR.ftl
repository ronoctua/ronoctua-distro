# O lembrete dos pertences: o nome e a linha sob ele, as dicas das quatro
# marcas e a página.
brain-task-belongings-reminder = Seus pertences
brain-task-belongings-reminder-does = Lembra de sincronizar seus pertences — sua configuração, guardada cifrada no seu próprio repositório — depois que passa o período que você escolheu desde a última sincronização, com um relógio armado só para esse instante. Enquanto uma sincronização espera suas decisões, depois de uma que falhou e antes da primeira de uma máquina nova, uma marca na modeline diz isso; um clique nela abre os pertences, pedindo a senha. Ele não roda nada sozinho: sincronizar pede a sua senha.
belongings-reminder-mark-due = É hora de sincronizar seus pertences
belongings-reminder-mark-conflicts = { $count ->
    [one] Uma sincronização dos seus pertences espera uma decisão
   *[other] Uma sincronização dos seus pertences espera { $count } decisões
    }
belongings-reminder-mark-failed = A última sincronização dos seus pertences não funcionou
belongings-reminder-mark-restore = Restaure seus pertences nesta máquina
belongings-reminder-heading = Seus pertences
belongings-reminder-row-repository = O repositório
belongings-reminder-row-set = definido
belongings-reminder-row-last = Última sincronização
belongings-reminder-row-never = nunca nesta máquina
belongings-reminder-row-next = Lembra de novo
belongings-reminder-row-waiting = Decisões esperando
belongings-reminder-row-failed = A última sincronização não funcionou
belongings-reminder-row-unset = Nenhum repositório definido: não há do que lembrar.
