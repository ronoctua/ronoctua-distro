        print(f"ERROR: {w}", file=sys.stderr)
    if wrong:
        raise SystemExit(1)
    print("OK: lofty and the Matroska programs are named only by ronoctua-tags")
    END
  '';

  # ONE CRATE READS WHERE YT-DLP IS.
