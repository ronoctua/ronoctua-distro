                parts.append(f"{held}.rs")
                parts += [shell_name(f) for f in shell_files(held + "_*.rs")]

        for f in shell_files(stem + "_*.rs"):
            theirs = without_tests(code_of(f.read_text()))
            if re.search(r"^(?:pub )?struct View\b", theirs, re.M):
                continue
