    filled = must(body_of(pen, "fill"), "`Pen::fill`")
    floor(len(filled), 40, "characters of `Pen::fill`")
    if "self.ground = Some(role);" not in filled:
        wrong.append("`Pen::fill` no longer records the role; every resolution below reads `None`")

