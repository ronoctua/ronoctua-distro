  # onto another's line. The flattening that remains is `cfg(test)`, and says so.
  sections-do-not-share-a-line = mkCheck "sections-do-not-share-a-line" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: `struct Section` and the three functions are module-level, and
    # the offence — a flattening function coming back — is one appearing
    # anywhere in the file.
    home = pathlib.Path("${self}/crates/ronoctua-shell/src")
    files = code_of((home / "files.rs").read_text())
    floor(len(files), 10000, "characters of files.rs")

    # THE BUILDER IS THE ONLY ONE. `Section` has to exist and carry its own
    # content, or this check is guarding nothing.
    for needed in ("pub struct Section", "pub content: Vec<Row>", "pub fn sections("):
        if needed not in files:
            print(f"ERROR: files.rs lost `{needed}` — the sections stopped being the source.",
                  file=sys.stderr)
            sys.exit(1)

    # AND THE FLATTENING IS A TEST TOOL, never production.
    for name in ("fn drawn_at(", "fn drawn("):
        at = files.find(name)
        if at == -1:
            continue
        before = files[max(0, at - 400) : at]
        if "#[cfg(test)]" not in before:
            print(f"ERROR: `{name.strip('(')}` is not under #[cfg(test)] —"
                  " the flattening came back into production.", file=sys.stderr)
            sys.exit(1)

    # AND NOBODY BRINGS IT BACK UNDER ANOTHER NAME: a public function that
    # returns a flat list of rows for the whole region is the shape that was
    # removed.
    banned = re.compile(r"pub fn (region_rows|rows_from|rows)\s*\(")
    hit = banned.search(files)
    if hit:
        line = files[: hit.start()].count("\n") + 1
        print(f"ERROR: files.rs:{line} gives back the region's lines flattened"
              f" (`{hit.group(1)}`).", file=sys.stderr)
        print("       The manager has FOUR sections; each door draws them one by one.",
              file=sys.stderr)
        sys.exit(1)

    # AND THE DOORS DRAW SECTIONS.
    for door in ("surface.rs", "files_window.rs"):
        src = code_of((home / door).read_text())
        floor(len(src), 10000, "characters of " + door)
        if ".sections(" not in src:
            print(f"ERROR: {door} does not draw by section.", file=sys.stderr)
            sys.exit(1)
    print("OK: every section draws itself, and nothing composes one line out of several")
    PY
  '';

  # EVERY STATE A BUFFER DECLARES HAS A WORD, IN BOTH LANGUAGES.
  #
  # Same shape as `buffer-modes-have-text`, and the same failure it prevents: the
  # id is English by invariant 18 and what the modeline draws comes from
  # `state-<id>` by invariant 8, so a state added without its two lines puts a
  # bracketed key on screen. It ALSO checks the base, because the colour rule
  # reads it — `normal` is drawn quiet and everything else in the alternative
  # token, and a buffer whose base were called something else would draw itself
  # as permanently not-normal.
  buffer-states-have-text = mkCheck "buffer-states-have-text" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    root_dir = pathlib.Path("${self}")
    ID = re.compile(r'^\s+id: "([a-z][a-z0-9-]*)"\.into\(\),')
    LETTER = re.compile(r"^\s+letter: '(.)',")
    seen_files = 0

    # FILE-WIDE: a descriptor is module-level, and the `states: vec![` block is
    # the narrowing. `uncommented` and never `code_of` here — BOTH needles are
    # literals, and `code_of` would turn every `letter: 'n'` into `letter: _`,
    # which is the whole of the second half of this check.

    # Read the `states:` block of each descriptor. The same shape
    # `english-names` and `buffer-modes-have-text` read, and for the same
    # reason: nothing ties the literal to the key.
    per_buffer = {}
    for rs in sorted((root_dir / "buffers").rglob("*.rs")):
        if "target" in rs.parts:
            continue
        inside = False
        found = []
        pending = None
        seen_files += 1
        for line in uncommented(rs.read_text()).splitlines():
            if "states: vec![" in line:
                inside = True
                continue
            if inside and line.strip() == "],":
                inside = False
                continue
            if not inside:
                continue
            m = ID.match(line)
            if m:
                pending = m.group(1)
                continue
            m = LETTER.match(line)
            if m and pending:
                found.append((pending, m.group(1)))
                pending = None
        if found:
            per_buffer[rs.parts[-3]] = found

    floor(seen_files, 8, "buffer sources swept for a `states:` block")
    floor(len(per_buffer), 5, "buffers declaring a state")

    gaps = []
    for buffer, states in sorted(per_buffer.items()):
        if not states or states[0][0] != "normal":
            gaps.append(buffer + ": the base state is " + repr(states[:1]) + ", not `normal`")
        ids = [i for i, _ in states]
        letters = [l for _, l in states]
        if len(set(ids)) != len(ids):
            gaps.append(buffer + ": a repeated state id")
        if len(set(letters)) != len(letters):
            gaps.append(buffer + ": two identical letters would leave a state unreachable")

    wanted = {i for states in per_buffer.values() for i, _ in states}
    for language in ${builtins.toJSON languages}:
        ftl = (root_dir / "assets/i18n" / (language + ".ftl")).read_text()
        have = set(re.findall(r"^([a-z][a-z0-9-]*) *=", ftl, re.M))
        for ident in sorted(wanted):
            if "state-" + ident not in have:
                gaps.append(language + ": state-" + ident + " is missing")

    if gaps:
        print("ERROR: a badly declared buffer state.", file=sys.stderr)
        for g in gaps:
            print("       " + g, file=sys.stderr)
        raise SystemExit(1)
    total = sum(len(v) for v in per_buffer.values())
    print("OK: " + str(total) + " states in " + str(len(per_buffer)) + " buffers, with text in both languages")
    END
  '';

  transfers-instance-fast = mkCheck "transfers-instance-fast" [ ] ''
    ${rust.workspace}/bin/ronoctua-bench-instance \
      ${buffers.transfers}/lib/ronoctua_buffer_transfers.wasm 200
  '';

  # FORMATTING A DISK, driven the way the host drives it.
  #
  # The two things it proves are the two the host cannot see: from out there a
  # refusal and a crashed component both look like no plan arriving.
  format-driven = mkCheck "format-driven" [ ] ''
    ${rust.workspace}/bin/ronoctua-test-format \
      ${buffers.format}/lib/ronoctua_buffer_format.wasm \
      ${../assets/i18n}
  '';

  format-instance-fast = mkCheck "format-instance-fast" [ ] ''
    ${rust.workspace}/bin/ronoctua-bench-instance \
      ${buffers.format}/lib/ronoctua_buffer_format.wasm 200
  '';

  # ===================================================================
  # THE TORRENT BORDER, and the two things about it that cannot be read.
  # ===================================================================

  # THE LAYOUT, COMPARED AGAINST THE C++ COMPILER'S OWN MEASUREMENT.
  #
  # `#[repr(C)]` promises to ARRANGE what it was told and never to check it: a
  # wrong width is a register with the wrong contents and produces no
  # diagnostic at all. `AGENTS.md` records that this cost three wrong struct
  # layouts on `libghostty-vt`, found by hand with a twenty-line C program.
  #
  # `nix/torrent-shim.nix` now compiles the REAL header with the real C++
  # compiler and writes every `sizeof` and `offsetof` down; this compares that
  # file against the constants in the Rust. Neither side can drift alone.
  torrent-layout-matches-cxx = mkCheck "torrent-layout-matches-cxx" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import re, sys, pathlib
    exec(open("${pyPrelude}").read())

    # PARSED: the C++ side is a table the compiler WROTE — one name and one
    # number per line — and it is split on whitespace, not searched. There is
    # no comment in it for anything to hide in.
    measured = {}
    for row in pathlib.Path("${torrentShim}/share/ronoctua/layout.txt").read_text().split("\n"):
        if not row.strip():
            continue
        name, value = row.split()
        measured[name] = int(value)

    # FILE-WIDE: the numbers are in `assert_eq!`s of a test module, which is
    # where a layout is pinned; there is no one function to narrow to.
    #
    # `code_of`: a number written in a comment beside the assertion is prose
    # about the layout, and the only thing that may answer here is the
    # assertion the compiler checks.
    rust = code_of(pathlib.Path("${../crates/ronoctua-torrent/src/ffi.rs}").read_text())
    floor(len(rust), 1000, "characters of ffi.rs")
    declared = {}
    m = re.search(r"assert_eq!\(size_of::<Status>\(\), (\d+)", rust)
    if m:
        declared["size"] = int(m.group(1))
    m = re.search(r"assert_eq!\(align_of::<Status>\(\), (\d+)", rust)
    if m:
        declared["align"] = int(m.group(1))
    for field, value in re.findall(r"offset_of!\(Status, (\w+)\), (\d+)", rust):
        declared[field] = int(value)

    floor(len(declared), 3, "numbers the Rust declares about the layout")

    failed = 0
    for name, value in sorted(measured.items()):
        if name not in declared:
            print(f"ERROR: the C++ measures `{name}` = {value} and the Rust does not declare it", file=sys.stderr)
            failed = 1
        elif declared[name] != value:
            print(
                f"ERROR: `{name}`: C++ measures {value}, Rust says {declared[name]}."
                " An FFI with the wrong layout gives no diagnostic — it gives a register"
                " with the wrong content in it.",
                file=sys.stderr,
            )
            failed = 1
    for name in declared:
        if name not in measured:
            print(f"ERROR: the Rust declares `{name}` and the C++ does not measure it", file=sys.stderr)
            failed = 1
    if failed:
        sys.exit(1)
    print(f"OK: {len(measured)} measurements from the C++ compiler match the Rust's")
    PY
  '';

  # AND THAT v2 IS NOT A CLAIM.
  #
  # It makes a purely-v2 torrent, hands it to a real session, and demands a v2
  # info hash and NO v1 one — then does the same with a v1-only torrent, so a
  # flag that were simply always true fails here too. Entirely offline: the data
  # is already where the torrent says it is, so the session checks it against
  # the Merkle tree of SHA-256 hashes and goes straight to seeding.
  torrent-speaks-v2 = mkCheck "torrent-speaks-v2" [ ] ''
    ${rust.workspace}/bin/ronoctua-test-torrent "$TMPDIR/torrent"
  '';

  # ===================================================================
  # THE EXTENSION, and the fingerprint the owner asked about.
  # ===================================================================

  # THE FIVE WAYS A WEBSITE CAN SEE AN EXTENSION, refused in the manifest.
  #
  # The owner's question was exact: an extension nobody else has makes this
  # browser unique if every site can list it. The detection vectors are known
  # and every one of them is a manifest key — so the manifest is GENERATED with
  # none of them, and this fails the build the day one appears.
  extension-has-no-fingerprint = mkCheck "extension-has-no-fingerprint" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import json, pathlib, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a manifest is one object with no functions in it.
    # PARSED: this manifest is not searched, it is `json.loads`-ed, and JSON has
    # no comment for a false positive to hide in — the five keys below are
    # looked up in a dictionary. A stripper here would be a gesture.
    m = json.loads(pathlib.Path("${extension}/share/ronoctua-extension/manifest.json").read_text())
    floor(len(m), 4, "top-level keys of the manifest")
    forbidden = [
        ("web_accessible_resources", "any page can `fetch` from chrome-extension://"),
        ("content_scripts", "what it leaves in the DOM is a marker"),
        ("externally_connectable", "it hands `chrome.runtime` to an origin"),
        ("host_permissions", "standing access is what makes the rest possible"),
        ("declarative_net_request", "the page infers it from the request itself"),
    ]
    failed = 0
    for key, why in forbidden:
        if key in m:
            print(f"ERROR: the manifest gained `{key}` — {why}", file=sys.stderr)
            failed = 1
    # And the permissions: `activeTab` instead of standing access IS the whole
    # design. Without it the only alternative is `host_permissions`.
    if "activeTab" not in m.get("permissions", []):
        print("ERROR: with no `activeTab` the extension would need standing access", file=sys.stderr)
        failed = 1
    if m.get("manifest_version") != 3:
        print("ERROR: MV2 does not have `activeTab` with this meaning", file=sys.stderr)
        failed = 1
    if failed:
        sys.exit(1)
    print(f"OK: none of the five detection channels, and {len(m['permissions'])} permissions")
    PY
  '';

  # THE PO TOKEN MINTER RUNS AND EXITS, and there is no server half at all.
  #
  # The owner asked for a minter that runs only when needed and leaves nothing
  # behind. That is a promise about a SHAPE, so it is checked as one: upstream
  # ships two providers, an HTTP one that wants a resident server and a script
  # one that does not, and `nix/pot-provider.nix` installs only the second. A
  # future edit that installed the other half would give this system a port and
  # a process without anybody deciding to.
  #
  # It also runs the thing, OFFLINE. `--version` reaches the script through
  # Deno, resolves every bare import out of the vendored `node_modules`, and
  # exits — inside a sandbox with no network, which is what proves that the
  # runtime and its dependencies are all in the closure rather than fetched on
  # first use. And it compares the version with the plugin's, because a skew
  # between the two is a warning upstream prints and nobody reads.
  pot-provider-is-script-only =
    let
      closure = pkgs.closureInfo { rootPaths = [ potProvider ]; };
    in
    mkCheck "pot-provider-is-script-only"
      [
        pkgs.deno
        pkgs.gnugrep
        pkgs.coreutils
      ]
      ''
        home=${potProvider}/server
        plugin=${potProvider}/plugin/yt_dlp_plugins/extractor
        failed=0

        # ---- NO SERVER HALF ----
        if [ -e "$plugin/getpot_bgutil_http.py" ]; then
          echo "ERROR: the HTTP provider was installed — that asks for a server standing" >&2
          failed=1
        fi
        test -f "$plugin/getpot_bgutil_script.py" || {
          echo "ERROR: the script provider is gone" >&2
          failed=1
        }
        # A namespace package has no `__init__.py`; with one, yt-dlp's plugin
        # finder does not see it and the whole thing is silently absent.
        if [ -e ${potProvider}/plugin/yt_dlp_plugins/__init__.py ]; then
          echo "ERROR: yt_dlp_plugins stopped being a namespace package" >&2
          failed=1
        fi

        # ---- NODE IS NOT IN THE CLOSURE ----
        #
        # It is a build tool here: what runs is Deno. Measured — the reference
        # arrived through shebangs of command-line entry points nothing
        # executes, and it was 249 MiB.
        if found=$(grep -e "-nodejs-" ${closure}/store-paths); then
          echo "ERROR: the generator drags node in, which it never runs:" >&2
          echo "$found" >&2
          failed=1
        fi

        # ---- AND IT RUNS, WITH NO NETWORK ----
        export DENO_NO_PROMPT=1 DENO_NO_UPDATE_CHECK=1 FORCE_COLOR=false
        export DENO_DIR="$TMPDIR/deno" XDG_CACHE_HOME="$TMPDIR/cache"
        mkdir -p "$TMPDIR/cache/bgutil-ytdlp-pot-provider"
        got=$(deno run --allow-env --allow-net \
          --allow-ffi="$home/node_modules" \
          --allow-write="$TMPDIR/cache/bgutil-ytdlp-pot-provider" \
          --allow-read="$TMPDIR/cache/bgutil-ytdlp-pot-provider,$home/node_modules" \
          "$home/src/generate_once.ts" --version 2>&1 | tail -1) || {
          echo "ERROR: the generator does not run without a network — something is missing from the closure" >&2
          echo "$got" >&2
          exit 1
        }
        want=$(grep -oP "__version__ = '\K[^']+" "$plugin/getpot_bgutil.py")
        if [ "$got" != "$want" ]; then
          echo "ERROR: the script says $got and the plugin says $want; one warning per download" >&2
          failed=1
        fi

        [ "$failed" = 0 ] || exit 1
        echo "OK: only the script provider, version $got, and it runs without a network"
      '';

  # THE APP DOES NOT DEPEND ON THE EXTENSION.
  #
  # The owner's requirement, turned into a test: everything that can be done
  # from the browser's extension has to be doable without it. That is not a
  # thing one reads and believes — an entry added to the popup is one line, and
  # the key that would match it is in another file that nobody has to open.
  #
  # So this reads BOTH SIDES. What the extension can ask for comes out of its
  # own sources; what the keyboard can ask for comes out of the leader's table;
  # and every one of the first has to appear in the second, twice — once
  # anonymous and once as the person, because the extension can do both.
  downloads-do-not-need-the-extension =
    mkCheck "downloads-do-not-need-the-extension" [ pkgs.python3 ]
      ''
        python3 - <<'PY'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        # FILE-WIDE: what the extension OFFERS is a set of literals scattered
        # through two scripts, and what the keyboard binds is a module-level
        # table. Neither is a question about one function.
        #
        # `uncommented` and never `code_of`: every needle here is a string —
        # `want: 'audio'` in the JavaScript, `"transfers-add"` in the Rust — and
        # emptying the literals would leave both sets empty and the check mute.
        source = pathlib.Path("${../extension}")
        wanted = set()
        kinds = set()
        for name in ("popup.js", "worker.js"):
            text = uncommented((source / name).read_text())
            floor(len(text), 500, "characters of " + name)
            wanted |= set(re.findall(r"want:\s*'([a-z]+)'", text))
            kinds |= set(re.findall(r"kind:\s*'([a-z-]+)'", text))

        leader = uncommented(pathlib.Path("${../crates/ronoctua-shell/src/leader.rs}").read_text())
        floor(len(leader), 10000, "characters of leader.rs")
        bound = set(re.findall(r'\(\s*"[a-z ]+"\s*,\s*"(transfers-[a-z-]+)"', leader))
        floor(len(bound), 4, "transfer commands the keyboard binds")

        failed = 0
        # ---- WHAT THE MENU TAKES OFF A PAGE ----
        floor(len(wanted), 2, "media kinds the extension offers")
        for want in sorted(wanted):
            for command in (f"transfers-{want}", f"transfers-{want}-as-me"):
                if command not in bound:
                    print(
                        f"ERROR: the extension offers `{want}` and the keyboard has no `{command}`."
                        " Everything the extension does has to be possible without it.",
                        file=sys.stderr,
                    )
                    failed = 1

        # ---- AND THE PLAIN LINK ----
        if "fetch" in kinds:
            for command in ("transfers-add", "transfers-add-as-me"):
                if command not in bound:
                    print(
                        f"ERROR: the extension sends a link and the keyboard has no `{command}`",
                        file=sys.stderr,
                    )
                    failed = 1

        # ---- AND IDENTITY, ON BOTH SIDES ----
        #
        # The extension keeps it as a switch because interception has no moment
        # at which to ask; the keyboard has it as a PREFIX. Both must exist, or
        # one door does something the other cannot.
        if "toggle-identity" not in kinds:
            print("ERROR: the extension lost the identity key", file=sys.stderr)
            failed = 1
        if not any(c.endswith("-as-me") for c in bound):
            print("ERROR: the keyboard lost the `t i` group", file=sys.stderr)
            failed = 1

        if failed:
            sys.exit(1)
        print(
            f"OK: {len(wanted)} media kinds and the bare link, each with an anonymous key "
            "and an identified key"
        )
        PY
      '';

  # AND IT PARSES.
  #
  # A syntax error in a service worker is the quietest failure this extension
  # can have: Chrome loads the extension, the worker never starts, the button
  # does nothing, and the message is behind two clicks in a page nobody has
  # open. Eleven megabytes of esbuild at build time buys that away — and it
  # checks the GENERATED tree, so a broken `generated.js` fails here too.
  extension-parses = mkCheck "extension-parses" [ pkgs.esbuild ] ''
    failed=0
    for f in ${extension}/share/ronoctua-extension/*.js; do
      if ! esbuild --log-level=warning --format=esm --target=chrome116 "$f" > /dev/null; then
        echo "ERROR: $(basename "$f") does not compile — the service worker would never come up" >&2
        failed=1
      fi
    done
    [ "$failed" = 0 ] || exit 1
    echo "OK: the extension's four files compile for chrome116"
  '';

  # AND NO TEXT AND NO COLOUR WRITTEN BY HAND.
  #
  # Invariants 8 and 9 do not stop at the browser's edge. Every word comes from
  # `assets/i18n/*.ftl` and every colour from `assets/tokens/colors.nix`, both
  # through the generated table — so a hex code or a sentence in the extension's
  # own sources is a value outside the design system.
  extension-has-no-literal = mkCheck "extension-has-no-literal" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a colour or a word written by hand ANYWHERE in a file is the
    # offence, and these are scripts with no functions worth narrowing to.
    #
    # `uncommented` and never `code_of`: what is being hunted IS a literal — a
    # hex colour, a sentence assigned to `textContent` — so emptying the
    # strings would leave a check that can never find one. What the strip is
    # for here is the other half: a hex written in a `//` comment as an
    # example is prose, and used to fail the build.
    source = pathlib.Path("${../extension}")
    failed = 0
    swept = 0
    for entry in sorted(source.iterdir()):
        if entry.name == "generated.js":
            continue
        text = uncommented(entry.read_text())
        swept += 1
        # A colour by hand, in any notation a browser would accept.
        for m in re.finditer(r"#[0-9a-fA-F]{3,8}\b|\brgba?\(\s*\d+", text):
            row = text[: m.start()].count("\n") + 1
            print(
                f"ERROR: {entry.name}:{row} has a colour by hand (`{m.group(0)}`)."
                " Every colour comes from assets/tokens/colors.nix (invariant 9).",
                file=sys.stderr,
            )
            failed = 1
        # UI text. What a person reads arrives through `TEXT.*`; what is left
        # over are log messages, which nobody reads off a screen.
        for m in re.finditer(r"textContent\s*=\s*['\"`]([^'\"`]+)", text):
            if m.group(1).strip():
                row = text[: m.start()].count("\n") + 1
                print(
                    f"ERROR: {entry.name}:{row} writes text straight onto the screen."
                    " Every text comes from assets/i18n (invariant 8).",
                    file=sys.stderr,
                )
                failed = 1
    floor(swept, 4, "files of the extension swept for a literal")
    if failed:
        sys.exit(1)
    print("OK: the extension carries neither a word nor a colour of its own")
    PY
  '';

  # ===================================================================
  # AND WHAT IS BORN ON THE MACHINE — invariant 13.
  # ===================================================================
  #
  # Two things this work needs that may never be in a public repository: the
  # extension's signing key, which decides its id, and aria2's RPC token. Both
  # are generated by units declared in the flake, on the machine, and
  # `nix/modules/secrets.nix` is explicit that "but it is encrypted" is not an
  # argument for either.
  secrets-are-not-in-the-repo = mkCheck "secrets-are-not-in-the-repo" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import pathlib, re, sys

    root = pathlib.Path("${../.}")
    failed = 0
    # The extension's private key, in any PEM shape.
    private = re.compile(r"-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----")
    # And aria2's token WITH A VALUE: the line that generates it lives in the
    # module and ends in `$secret`, which is not a secret, and the line that
    # reads it lives in the Rust.
    token = re.compile(r"rpc-secret\s*=\s*[A-Za-z0-9+/=]{8,}")
    for entry in root.rglob("*"):
        if not entry.is_file():
            continue
        if any(part in {".git", "target", "result"} for part in entry.parts):
            continue
        try:
            text = entry.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        if private.search(text):
            print(f"ERROR: a private key in {entry.relative_to(root)}", file=sys.stderr)
            failed = 1
        if token.search(text):
            print(f"ERROR: aria2's secret in {entry.relative_to(root)}", file=sys.stderr)
            failed = 1
    if failed:
        sys.exit(1)
    print("OK: neither a private key nor a token — both are born ON the machine")
    PY
  '';

  # THE 5 MS BUDGET, on the third component too.
  lucide-instance-fast = mkCheck "lucide-instance-fast" [ ] ''
    ${rust.workspace}/bin/ronoctua-bench-instance \
      ${buffers.lucide}/lib/ronoctua_buffer_lucide.wasm 200
  '';

  # THE LUCIDE BROWSER, driven the way the host drives it.
  #
  # The name ended up narrow: besides the search and the filters, it covers the
  # whole sheet — the 19 forms of copy, the scrolling of the 24 lines, and the
  # two that were born with the vector preview:
  #
  #   - the affordance MARK matches the table the key reads, line by line. A mark
  #     that promises a key that does nothing is worse than no mark at all, and
  #     that was exactly the case of the color line;
  #   - the PREVIEW is byte for byte the SVG the copy delivers, before and after
  #     touching the stroke. A second constructor for the screen would drift
  #     silently, and the preview would stop being the artifact with nothing
  #     giving it away.
  lucide-filters = mkCheck "lucide-filters" [ ] ''
    ${rust.workspace}/bin/ronoctua-test-lucide \
      ${buffers.lucide}/lib/ronoctua_buffer_lucide.wasm \
      ${../assets/i18n}
  '';

  # WHICH FACE DRAWS WHAT — the promise the comment in `text.rs` had been making
  # since the second face and that had never been written down.
  #
  # It also witnesses the COLLISION that forced the remapping: as long as Iosevka
  # answers for `U+E0A0`, publishing Lucide in the origin range means drawing the
  # wrong symbol. The day that changes, the check fails and someone re-reads the
  # decision instead of rediscovering it through the screen.
  renderer-loads-four-faces = mkCheck "renderer-loads-four-faces" [ ] ''
    # THE COVERAGE FACES ARE SET HERE, and that is what makes this check the
    # guard for the declared chain rather than only for the four embedded
    # faces. Without the variable the binary says SKIPPED and passes, which is
    # correct for the installer and useless as a check — so the check supplies
    # it, exactly as the wrapper supplies it to the footer.
    export RONOCTUA_COVERAGE_FONTS=${rust.atRunTime.RONOCTUA_COVERAGE_FONTS}
    ${rust.workspace}/bin/ronoctua-test-faces
  '';

  # THE UNICODE SYMBOL BROWSER, by the same path: the real component, driven
  # the way the host drives it.
  #
  # It asserts three things the glyph one does not have to assert, and each one
  # corresponds to a real difference of the Unicode database:
  #
  #   - the EXACT total (7,529). The component's parser splits the records on
  #     `"},"`, and `}` is INSIDE this database (`U+007D`) — what saves it is
  #     the generator not emitting a string field with an arbitrary character;
  #   - the combining mark drawn over the dotted circle, and COPIED without it:
  #     pasting `◌́` into the user's document is the worst possible defect, and
  #     the only one that survives any visual inspection;
  #   - the doubled budget of the 23 double-width ones, otherwise the host
  #     elides a single character into `…`.
  symbols-filters = mkCheck "symbols-filters" [ ] ''
    ${rust.workspace}/bin/ronoctua-test-symbols \
      ${buffers.unicode}/lib/ronoctua_buffer_unicode.wasm \
      ${../assets/i18n}
  '';

  # The OTHER half of the GPU-independent metrics of section 9.3: the CPU work
  # that happens before any pixel.
  #
  # The gate is loose on purpose — today there is 5000x of headroom. It does not
  # exist to tighten the layout, it exists so that a regression of an ORDER OF
  # MAGNITUDE (measuring text instead of counting columns, allocating per
  # segment) shows up here and not in a bisection of stutter six months later.
  layout-fast = mkCheck "layout-fast" [ ] ''
    ${rust.workspace}/bin/ronoctua-bench-layout 5000
  '';

  # Text shaping must not go back to the regime of SECONDS.
  #
  # It cost 4,447 ms on the first frame because cosmic-text's `Family::Monospace`
  # points at a font that is not in our database. The check compares the four
  # arrangements and fails if the production one regresses — the ceiling is loose
  # (300 ms against a floor of 0.1 ms) because what it catches is the return of
  # the regime, not variation between machines.
  shaping-fast = mkCheck "shaping-fast" [ ] ''
    ${rust.workspace}/bin/ronoctua-bench-shaping
  '';

  # A SURFACE THE SIZE OF A MONITOR HAS TO FIT.
  #
  # `Limits::downlevel_defaults()` fixes `max_texture_dimension_2d` at 2048, and
  # the presentation surface IS a texture. The symptom had two faces, and neither
  # of them pointed at the limits:
  #
  #   - `Alt+=` on a 1920 monitor takes the column to 2112 px on the FIRST step,
  #     and the window CLOSES BY ITSELF. `Surface::configure` gives back no error:
  #     it kills the process, and the compositor sends the output of what it spawns to
  #     /dev/null;
  #   - any monitor wider than 2048 px never had a footer, because it takes the
  #     screen's width and died before the first pixel.
  #
  # The check asks for a device with the PRODUCTION limits and tries the texture.
  # Comparing numbers from `Limits` would be checking our arithmetic against
  # itself; here whoever answers is the driver.
  large-monitor-surface = mkCheck "large-monitor-surface" [ ] ''
    export VK_DRIVER_FILES=${xvfb.icd}
    export VK_ICD_FILENAMES=${xvfb.icd}
    export LIBGL_ALWAYS_SOFTWARE=1
    ${rust.workspace}/bin/ronoctua-test-large-surface
  '';

  # THE TOOL THAT MAKES "OPEN IT ON THE SCREEN" AFFORDABLE HAS TO KEEP WORKING.
  #
  # `nix run .#png` draws a buffer into a PNG in 0,2 s, and it exists because
  # the alternative — a NixOS VM, the compositor under Xvfb, a screenshot of the X root —
  # cost three minutes, which is how a title came to be drawn at twice the
  # body's size for months. A tool nobody checks is a tool that stops working
  # quietly, and the discovery happens on the day somebody needs it.
  #
  # # What is actually asserted, and why not "the file appeared"
  #
  # Because a PNG of the right size, filled edge to edge with the background
  # colour, is EXACTLY what a broken draw produces — and it would pass. So:
  #
  #   - every chunk's CRC is recomputed, and the `IDAT` goes through a real
  #     `zlib`. The writer is forty hand-rolled lines (making `png` a direct
  #     dependency would cost a rebuild of crane's whole dependency layer), and
  #     this is what stops those forty lines from being subtly wrong;
  #   - the size in the header has to be the size the tool PRINTED. A writer
  #     that lies about its own dimensions is the one failure a viewer would
  #     see as "the picture is a bit odd";
  #   - there has to be INK: pixels that are not the commonest colour. That is
  #     the assertion that separates "it drew" from "it cleared the screen";
  #   - and pt-BR and en-GB have to come out DIFFERENT. That one closes the
  #     whole chain in a single comparison — component, display list, i18n,
  #     tokens, wgpu, pixel — with no OCR and without naming a single colour
  #     here, which would be a second copy of a token (invariant 9).
  #
  # Under lavapipe, like `large-monitor-surface`: hermetic, no GPU. Section 9.3
  # forbids measuring frame time here, and nothing here measures time.
  png-tool-draws = mkCheck "png-tool-draws" [ pkgs.python3 ] ''
    export VK_DRIVER_FILES=${xvfb.icd}
    export VK_ICD_FILENAMES=${xvfb.icd}
    export LIBGL_ALWAYS_SOFTWARE=1

    for language in ${lib.concatStringsSep " " languages}; do
      ${rust.workspace}/bin/ronoctua-render-png \
        ${buffers.format}/lib/ronoctua_buffer_format.wasm \
        --columns 60 --lines 10 --language "$language" \
        --out "$PWD/$language.png" | tee "$PWD/$language.txt"
    done

    # AND THE SAME PICTURE AT SCALE 2. `--scale` is the flag the HiDPI
    # deliverable added so the shell's sharpness could be photographed at all,
    # and nothing exercised it: not the `1..=MOST_SCALE` bound, not the refusal
    # of a picture past the GPU's ceiling, and not the invariant the tool is
    # for — the same picture with more pixels in it, and the SAME number of
    # cells. A tool nobody tests is a proof nobody has.
    ${rust.workspace}/bin/ronoctua-render-png \
      ${buffers.format}/lib/ronoctua_buffer_format.wasm \
      --columns 60 --lines 10 --language en-GB --scale 2 \
      --out "$PWD/twice.png" | tee "$PWD/twice.txt"

    # AND A SCALE NO SCREEN HAS IS REFUSED, with a sentence rather than a
    # picture. `|| true` because a refusal is a non-zero exit, which is the
    # point.
    ${rust.workspace}/bin/ronoctua-render-png \
      ${buffers.format}/lib/ronoctua_buffer_format.wasm \
      --columns 60 --lines 10 --scale 9 --out "$PWD/never.png" \
      >"$PWD/refused.txt" 2>&1 || true

    python3 - <<'END'
    import pathlib, re, struct, sys, zlib

    # FILE-WIDE: what is read here is a picture and the tool's own printed
    # line, neither of which has a function in it.
    # PARSED: the PNG is DECODED — chunk by chunk, CRC by CRC, then inflated —
    # and the tool's line is matched for the size it printed. Nothing is
    # searched for a name, so there is no prose for a comment to hide in.
    exec(open("${pyPrelude}").read())

    def read(language):
        raw = pathlib.Path(f"{language}.png").read_bytes()
        assert raw[:8] == b"\x89PNG\r\n\x1a\n", f"{language}: wrong PNG signature"
        at, chunks = 8, {}
        while at < len(raw):
            size = struct.unpack(">I", raw[at : at + 4])[0]
            kind = raw[at + 4 : at + 8]
            body = raw[at + 8 : at + 8 + size]
            said = struct.unpack(">I", raw[at + 8 + size : at + 12 + size])[0]
            # THE CRC AGAINST A REAL IMPLEMENTATION. Our table is written by
            # hand; `zlib.crc32` is not.
            mine = zlib.crc32(kind + body)
            assert mine == said, f"{language}: CRC of {kind!r}: {mine:08x} != {said:08x}"
            chunks.setdefault(kind, b"")
            chunks[kind] += body
            at += 12 + size
        width, height, depth, colour, _, _, laced = struct.unpack(">IIBBBBB", chunks[b"IHDR"])
        assert (depth, colour, laced) == (8, 6, 0), (
            f"{language}: the header says {depth} bits, type {colour}, interlaced {laced}"
        )
        rows = zlib.decompress(chunks[b"IDAT"])
        # ONE FILTER BYTE PER ROW, and ours is always 0 — nothing compresses, so
        # nothing needs filtering. A row that arrived with another filter would
        # mean the writer changed and this reader did not.
        stride = width * 4 + 1
        assert len(rows) == stride * height, (
            f"{language}: {len(rows)} pixel bytes for {width}x{height}"
        )
        pixels = []
        for n in range(height):
            row = rows[n * stride : (n + 1) * stride]
            assert row[0] == 0, f"{language}: line {n} came with filter {row[0]}"
            pixels.extend(
                bytes(row[1 + i * 4 : 5 + i * 4]) for i in range(width)
            )
        said = pathlib.Path(f"{language}.txt").read_text()
        printed = re.search(r"(\d+)x(\d+) px", said)
        assert printed, f"{language}: the tool did not say the size: {said!r}"
        assert (width, height) == (int(printed[1]), int(printed[2])), (
            f"{language}: the header says {width}x{height} and the tool said "
            f"{printed[1]}x{printed[2]}"
        )
        return width, height, pixels

    shape, seen = None, {}
    for language in ${builtins.toJSON languages}:
        width, height, pixels = read(language)
        if shape is None:
            shape = (width, height)
        assert shape == (width, height), "the languages came out at different sizes"

        # THE INK. The commonest colour is the background by construction — it is
        # what the frame was cleared with — so anything else is something drawn.
        tally = {}
        for p in pixels:
            tally[p] = tally.get(p, 0) + 1
        background, _ = max(tally.items(), key=lambda kv: kv[1])
        ink = len(pixels) - tally[background]
        share = ink / len(pixels)
        print(f"{language}: {width}x{height}, {len(tally)} colours, {share:.2%} of ink")
        assert share > 0.005, (
            f"{language}: only {share:.3%} of the image is not the background — that is a clean "
            "screen, not a drawn buffer"
        )
        seen[language] = pixels

    floor(len(seen), 2, "languages photographed")

    # AND THE TRANSLATIONS DIFFER IN THE PIXEL — every pair of them.
    #
    # It used to compare exactly two, which is the shape a third language would
    # have walked straight past: it would have been drawn, measured, and never
    # once compared against anything. All pairs is the same assertion without
    # the assumption, and it names WHICH two collided rather than "they did".
    same = [
        (a, b)
        for i, a in enumerate(seen)
        for b in list(seen)[i + 1 :]
        if seen[a] == seen[b]
    ]
    assert not same, (
        "these came out pixel for pixel identical, so the key is not being "
        f"translated before it becomes a drawing: {same}"
    )
    # AND THE SCALE MULTIPLIES THE PIXELS AND NOT THE CELLS.
    twice_w, twice_h, twice_px = read("twice")
    one_w, one_h, one_px = read("en-GB")
    assert (twice_w, twice_h) == (one_w * 2, one_h * 2), (
        f"--scale 2 gave {twice_w}x{twice_h} where {one_w * 2}x{one_h * 2} was asked for"
    )
    said = pathlib.Path("twice.txt").read_text()
    assert "60 cells by 10" in said, (
        f"--scale changed the number of CELLS, which is the one thing it must not: {said!r}"
    )
    assert "scale 2" in said, f"the tool did not say what scale it drew at: {said!r}"

    # AND SOMETHING WAS DRAWN AT THE SCALE, which the three assertions above do
    # not say. They read the HEADER and the printed line; a blank 2x canvas
    # passes every one of them, and so does the 1x picture pasted into a corner
    # — proved by handing this Python exactly those two files. `--scale` is the
    # only way this repository can photograph HiDPI at all, so a silently
    # broken one makes every later "photographed at scale 2" false.
    def ink_of(pixels):
        tally = {}
        for p in pixels:
            tally[p] = tally.get(p, 0) + 1
        ground, _ = max(tally.items(), key=lambda kv: kv[1])
        return (len(pixels) - tally[ground]) / len(pixels)

    twice_ink, one_ink = ink_of(twice_px), ink_of(one_px)
    print(f"scale 1: {one_ink:.2%} of ink; scale 2: {twice_ink:.2%}")
    assert twice_ink > 0.005, (
        f"only {twice_ink:.3%} of the doubled picture is not the background — that is a "
        "clean screen, not a drawn buffer"
    )
    # THE SAME PICTURE WITH MORE PIXELS IN IT, so the SHARE of ink is about the
    # same. A 1x drawing in the corner of a 2x canvas covers a quarter of it,
    # which is what this band refuses.
    assert abs(twice_ink - one_ink) < one_ink / 2, (
        f"scale 1 lit {one_ink:.2%} of its picture and scale 2 lit {twice_ink:.2%}: that is "
        "not the same picture at another size"
    )

    # AND THE BOUND IS THE ONE `hidpi::followed` TAKES.
    refused = pathlib.Path("refused.txt").read_text()
    assert not pathlib.Path("never.png").exists(), (
        "a scale no compositor drives a screen at was photographed anyway"
    )
    assert "not a scale" in refused, f"--scale 9 was refused without saying why: {refused!r}"

    print("OK: the PNG is valid, has ink in it, the language reaches the pixel, and the scale")
    END
  '';

  # ENDING THE SESSION MUST NOT PRINT AN ERROR.
  #
  # # What this catches
  #
  # Two defects that lived together for months with nothing reporting them, and
  # that the owner saw every time they closed with Ctrl+C:
  #
  #   rm: cannot remove '/nix/store/…-ronoctua-nested.conf': Permission denied
  #   rm: cannot remove '/nix/store/…-ronoctua-nested.conf': Permission denied
  #
  # The first: `shutdown` tried to delete the CONFIG, which became a store path
  # when it started being generated by Nix — immutable by construction. The
  # `rm -f` does not save it, because it silences "does not exist" and not "is
  # not yours".
  #
  # The second, the duplicate: `trap … EXIT INT TERM` runs the cleanup on INT and
  # again on EXIT.
  #
  # # Why it runs the REAL app
  #
  # Because the criterion is "the output is clean", and a replica of `shutdown`
  # inside the check would prove nothing about the `shutdown` that runs on the
  # owner's machine — and the lesson at the top of this file is exactly that.
  # With no display the compositor does not come up, the script falls into the error path,
  # and it is the real `shutdown` that runs.
  dev-exits-clean = mkCheck "dev-exits-clean" [ devApp ] ''
    export HOME=$TMPDIR
    export XDG_RUNTIME_DIR=$TMPDIR
    # A DISPLAY THAT DOES NOT EXIST. With none at all, the script stops at the
    # graphical-session guard BEFORE installing the trap, and the path this check
    # wants to exercise never runs. With a fake name it carries on, the compositor dies at
    # startup, the waiting loop gives up — and `shutdown` really runs.
    export WAYLAND_DISPLAY=does-not-exist-1

    # AND SESSIONS TO CLEAN UP AFTER, planted before the run.
    #
    # `.#dev` prunes what earlier sessions left in `/tmp` — 65 files and 55 MB
    # had built up on the owner's machine — and this check could not see that
    # code at all: a build sandbox starts with an empty `/tmp`, the loops had
    # nothing to walk, and every one of them returned 0 by not running. The
    # rule went in green and took the session down on the first real machine
    # it met, right after the banner and with nothing said.
    #
    # FOURTEEN, ALL FRESH, and that is the reproduction rather than a round
    # number: the rule keeps the ten most recent AND only deletes what nothing
    # has written to for a day, so with eleven or more logs from TODAY the
    # oldest four fall past the count and fail the age test — which is the case
    # where the body's last command is a false one. Somebody who runs `.#dev`
    # more than ten times in a day meets it, and he does.
    for n in $(seq 1 14); do
      : > "/tmp/ronoctua-footer-plant$n.log"
      : > "/tmp/ronoctua-scroll-plant$n.log"
    done

    # It exits non-zero on purpose (the compositor does not come up here); what is measured
    # is what it PRINTS on ending.
    timeout 300 ronoctua-dev > out_text.txt 2> errors.txt || true

    # NOTHING FRESH WAS TAKEN. The count alone would have deleted four of these;
    # the age is the second half of the rule and this is where it is asserted.
    left=$( { ls /tmp/ronoctua-footer-plant*.log 2>/dev/null | wc -l; } || true )
    [ "$left" = 14 ] || {
      echo "ERROR: the prune took $left of 14 logs that were written today." >&2
      echo "      It keeps the ten most recent AND spares whatever was" >&2
      echo "      written to within the day — another session may be using" >&2
      echo "      one of them right now." >&2
      exit 1
    }

    if grep -qE "cannot remove|Permission denied" errors.txt; then
      echo "ERROR: shutting the session down printed a removal error:" >&2
      grep -E "cannot remove|Permission denied" errors.txt >&2
      echo "      A store path is not deleted, and '-f' does not silence that." >&2
      exit 1
    fi

    # AND ONLY ONCE. The log line comes out of `shutdown`; two means the cleanup
    # ran twice.
    #
    # HOW FAR THIS PROVES IT: here the script exits by the error path, so only the
    # EXIT trap fires. The duplicate the owner saw comes from Ctrl+C — INT cleans
    # up and EXIT cleans up again —, and reproducing it would require a compositor
    # standing to interrupt. This check catches `shutdown` running twice on a
    # normal exit; the other half is seen on screen, and its fix is the
    # `trap 'exit 130' INT` of dev.nix.
    #
    # The `|| true` is around the `grep -c`: with no match at all it exits 1, and
    # under `pipefail` that would bring the check down before it counted — which is
    # the same trap `pgrep` has already set twice in this file.
    n=$( { cat out_text.txt errors.txt | grep -c "logs of this session:"; } || true )
    [ "$n" = 1 ] || {
      echo "ERROR: the shutdown ran $n times; expected 1." >&2
      echo "      'trap … EXIT INT TERM' cleans up on INT and again on EXIT." >&2
      echo "--- output:" >&2; tail -20 out_text.txt >&2
      echo "--- errors:" >&2; tail -20 errors.txt >&2
      exit 1
    }

    echo "OK: shutting the session down comes out clean, and only once"
  '';

  # THE NESTED LOOP CALLS A COMMAND THAT EXISTS.
  #
  # # The defect this exists for, and it lasted from the first commit
  #
  # `nix/dev.nix` handed the watcher `RONOCTUA_RELOAD_CMD='rebuild'`, and
  # the function it defines and exports is called `rebuild`. The watcher `eval`s
  # the string, gets "command not found", and swallows it with `|| true` — which
  # is correct, because a compile error is the normal case in a loop. So HOT
  # RELOAD NEVER FIRED, not once, and nothing said so: the footer that stays on
  # screen is the store's, and it works perfectly.
  #
  # `reload-reloads`, just below, did not see it: it proves the MECHANISM with a
  # command of its own making. What was missing was a check on the WIRING.
  #
  # Both sides come from the built script, which is the artifact that runs.
  reload-command-is-defined =
    mkCheck "reload-command-is-defined"
      [
        pkgs.gnugrep
        pkgs.gnused
      ]
      ''
        script=${devApp}/bin/ronoctua-dev

        cmd=$(sed -n "s/.*RONOCTUA_RELOAD_CMD='\([a-z_]*\)'.*/\1/p" "$script" | head -1)
        [ -n "$cmd" ] || {
          echo "ERROR: could not find RONOCTUA_RELOAD_CMD in the loop's script" >&2
          exit 1
        }
        echo "the loop tells it to run: $cmd"

        grep -q "^  $cmd() {" "$script" || {
          echo "ERROR: '$cmd' is not a function defined in the script — the watcher will" >&2
          echo "      get 'command not found', swallow it with '|| true', and the hot" >&2
          echo "      reload will NEVER fire, with not one line of warning." >&2
          exit 1
        }
        # And exported: the watcher is ANOTHER process, and a function that is
        # not exported does not cross into it — same symptom, same silence.
        grep -qE "^  export -f .*\b$cmd\b" "$script" || {
          echo "ERROR: '$cmd' is not exported; the watcher runs in another process" >&2
          exit 1
        }

        echo "OK: the loop calls '$cmd', which exists and crosses over to the watcher"
      '';

  # AND IT COMPILES THE SAME BINARY THE BUILD WOULD.
  #
  # # The defect this exists for
  #
  # Everything in `nix/rust.nix`'s `generated` reaches the Rust through
  # `option_env!`, which resolves at COMPILE time. Hot reload compiles the binary
  # HERE, so a variable this script does not export is a variable that binary
  # does not have — and the failure is always the same shape: a feature that
  # works in production and answers "could not open" in the loop.
  #
  # It had already happened twice, and both were found by accident: the icon
  # superpack (the list drew category glyphs and never the app's icon) and the
  # five wasm components. Twenty-five more were waiting, `btop` and the
  # clipboard and `ghostty-vt` among them; what hid them was that the reload was
  # wired to a command that did not exist, so no edit ever replaced the store's
  # binary.
  #
  # The list is not written here: it is read from the table the compilation
  # gets — and from `atRunTime`, which is what the WRAPPER sets. That second
  # half used to be `bufferComponents` and covered the eight `.wasm` alone; the
  # coverage faces travel the same road and their absence would not have been
  # noticed, which is a nested loop drawing tofu where the installed system
  # draws Japanese.
  dev-exports-what-the-build-bakes = mkCheck "dev-exports-what-the-build-bakes" [ pkgs.gnugrep ] ''
    script=${devApp}/bin/ronoctua-dev
    failed=0

    for v in ${lib.concatStringsSep " " (lib.attrNames (rust.generated // rust.atRunTime))}; do
      grep -q "^  export $v=" "$script" || {
        echo "ERROR: the build bakes $v in and the loop does not export it — the hot" >&2
        echo "      reload goes without it, and the failure shows up far from here." >&2
        failed=1
      }
    done

    [ "$failed" = 0 ] || exit 1
    echo "OK: the $(grep -c '^  export RONOCTUA_' "$script") variables of the loop cover what the build bakes in"
  '';

  # ===================================================================
  # THE RESCUE CONSOLE — `Ctrl+Alt+Del`
  # ===================================================================

  # EVERY ROW OF THE CONSOLE HAS A SENTENCE, IN BOTH LANGUAGES.
  #
  # Invariant 8, on the one screen where breaking it would hurt most: a rescue
  # console that draws `[rescue-reboot]` is a console whose rows nobody can
  # read, opened by somebody whose machine is already broken.
  #
  # The ids come out of the Rust and not out of a list written here — a list
  # here would be a third copy, and the one that goes stale is always the copy.
  rescue-actions-have-text =
    mkCheck "rescue-actions-have-text"
      [
        pkgs.gnugrep
        pkgs.coreutils
      ]
      ''
        src=${../crates/ronoctua-rescue/src}
        failed=0

        keys=$(grep -ohE '"rescue-[a-z0-9-]+"' "$src"/lib.rs | tr -d '"' | sort -u)
        [ -n "$keys" ] || {
          echo "ERROR: no 'rescue-*' key in the registry — what does the grep match?" >&2
          exit 1
        }

        for k in $keys; do
          for language in ${lib.concatStringsSep " " languages}; do
            grep -qE "^$k = ." ${../assets/i18n}/$language.ftl || {
              echo "ERROR: '$k' is missing from $language.ftl — the screen would show [$k]" >&2
              failed=1
            }
          done
        done

        [ "$failed" = 0 ] || exit 1
        echo "OK: $(echo "$keys" | wc -l) rescue keys, in both languages"
      '';

  # THE MIME TABLE CAME OUT WHOLE.
  #
  # The floors are in the generator and the compile-time assertions are in
  # `mime.rs`; what this adds is that the derivation BUILT, which is the thing
  # a reordered `mime-glyphs.nix` or a bumped `shared-mime-info` would break.
  mime-table-generated = mkCheck "mime-table-generated" [ pkgs.gnugrep pkgs.coreutils ] ''
    table=${mimeDb}/mimedb.rs
    test -s "$table" || { echo "ERROR: the table came out empty" >&2; exit 1; }
    for name in GLOBS MAGIC SUBCLASS ALIASES GENERIC ICON_OF_GENERIC ICON_OF_MIME; do
      grep -qE "pub static $name" "$table" || {
        echo "ERROR: the $name table is missing" >&2
        exit 1
      }
    done
    # The counts, so a reader that quietly stopped understanding the format is
    # caught here as well as at compile time. A parser that breaks returns a
    # HANDFUL of rows, which reads as "the database is small".
    globs=$(grep -c 'Glob {' "$table")
    [ "$globs" -ge 900 ] || { echo "ERROR: only $globs globs" >&2; exit 1; }
    echo "OK: $globs name patterns, and the seven tables"
  '';

  # AND IT REFUSES A TABLE THAT DOES NOT ANSWER FOR EVERY GENERIC ICON.
  #
  # The negative fixture. Without it, a `shared-mime-info` release adding
  # `x-office-drawing` would draw the neutral square on a whole class of files
  # — and the neutral square is indistinguishable from "I did not resolve it",
  # so nothing would say so.
  mime-unknown-icon-fails = mkCheck "mime-unknown-icon-fails" [ ] ''
    test -s ${mimeDb.negativeFixture}/verdict
    cat ${mimeDb.negativeFixture}/verdict
  '';

  # AND THE PREFERENCE STILL PREFERS.
  #
  # `prefer` settles `*.obj` between `model/obj` and `application/x-tgif` by
  # REMOVING the loser's glob — so while it works, nothing in the table says it
  # is there, and the day upstream drops the ambiguity the row would stop
  # applying in silence. This breaks the row on purpose and watches the build
  # refuse; see `nix/mimegen.nix`.
  mime-preference-is-live = mkCheck "mime-preference-is-live" [ ] ''
    test -s ${mimeDb.preferenceFixture}/verdict
    cat ${mimeDb.preferenceFixture}/verdict
  '';

  # EVERY PLAYLIST TYPE IS EITHER READ OR REFUSED, AND NEVER NEITHER.
  #
  # `mesh-formats-are-total`'s argument, one medium along. A type on the
  # table's `playlist` row with no arm in `playlist::kind_of` resolves, reaches
  # the reader, and comes back with a sentence about a spelling nobody wrote —
  # or worse, is claimed by the `sound` row below it and handed to ffmpeg,
  # whose `hls` demuxer OPENS the first file the list names and reports THAT
  # file's codec and duration as the playlist's. Measured against the pinned
  # binary.
  #
  # So the three lists have to agree: what the table claims, what the parser
  # dispatches, and what the two languages can say about it.
  # EVERY DOCUMENT FORMAT THIS TREE CLAIMS HAS A READER, AND IS ASKED FIRST.
  #
  # The owner asked for the documents in his own folder — *"implementar o
  # suporte para eles talvez não seja tão difícil"* — and the reason it was not
  # is that most of them are one format: `.docx`, `.odt`, `.odp`, `.ods`,
  # `.xlsx`, `.pptx` and `.epub` are every one of them a zip of XML.
  #
  # # The three ways this can go quietly wrong
  #
  # ONE. A type matched on and not declared, or declared and not matched on.
  # `kind_of` answers by SUBCLASS, so what it claims cannot be read off it; the
  # list beside it is what a person reads, and the two have to agree in both
  # directions. `playlist::TYPES` makes the same argument one format along.
  #
  # TWO. The generic type asked FIRST. Every office format IS an
  # `application/zip` by the freedesktop database's reckoning, so a `kind_of`
  # that asked the generic question before the specific ones would answer "an
  # archive" for a Word document and the panel would list
  # `[Content_Types].xml` where the words should be. The check reads the ORDER.
  #
  # THREE. The document asked AFTER the text. `text/rtf` descends from
  # `text/plain`, so the text reader claims it — that is exactly how the panel
  # came to draw `{\rtf1\ansi\deff0{\fonttbl…`. Asking the document first is
  # what makes the `.rtf` a document, and it is one call site.
  document-formats-are-total = mkCheck "document-formats-are-total" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the table of types and the `enum Kind` are module-level, and
    # the variables a unit sets are lines of a Nix module. The three functions
    # this check is really about — `kind_of`, `read_it`, `Tool::variable` — are
    # narrowed by name below.
    #
    # `uncommented` for the Rust: every media type here is a STRING literal,
    # and `code_of` would empty the table, the arms and the answers all at
    # once, leaving three empty sets that agree with each other.
    src = pathlib.Path("${../crates/ronoctua-inspect/src}")
    module = uncommented((src / "document.rs").read_text())
    shell = uncommented(pathlib.Path("${../crates/ronoctua-shell/src}/files.rs").read_text())
    floor(len(module), 2000, "characters of document.rs")
    floor(len(shell), 10000, "characters of files.rs")
    bad = []

    # --- ONE. The list and the function claim the same set -----------------
    declared = re.search(r"pub const TYPES: \[&str; \d+\] = \[(.*?)\];", module, re.S)
    if declared is None:
        bad.append("document.rs no longer declares TYPES")
        claimed = []
    else:
        # A TYPE AND NOT A WORD: the list carries comments, and a quoted
        # phrase in one of them is not a claim. Every MIME type has a slash.
        claimed = [t for t in re.findall(r'"([^"]+)"', declared.group(1)) if "/" in t]
    arm = body_of(module, "kind_of")
    if arm is None:
        bad.append("document.rs no longer dispatches on the type")
        matched = []
    else:
        floor(len(arm), 200, "characters of `kind_of`")
        matched = re.findall(r'is\("([^"]+)"\)', arm)
    if set(matched) - set(claimed):
        bad.append("matched on but not declared: " + ", ".join(sorted(set(matched) - set(claimed))))
    if set(claimed) - set(matched):
        bad.append("declared but never matched on: " + ", ".join(sorted(set(claimed) - set(matched))))

    # --- TWO. The container is asked LAST, and asked ONCE ------------------
    #
    # ONCE is half the rule and it is the half a sabotage found: an EARLY
    # `is("application/zip")` leaves the fall-through at the end, so a check
    # that only looked at the last position went green over a `kind_of` that
    # answered "an archive" for every office format there is.
    zips = [n for n, t in enumerate(matched) if t == "application/zip"]
    if len(zips) > 1:
        bad.append(
            f"`application/zip` is asked {len(zips)} times, at positions "
            f"{[n + 1 for n in zips]}; every office format descends from it, so the "
            "first of them decides and the specific rows below are unreachable"
        )
    elif matched and matched[-1] != "application/zip":
        bad.append(
            "`application/zip` is asked at position "
            f"{matched.index('application/zip') + 1} of {len(matched)}; every office "
            "format descends from it, so anything after it is unreachable"
        )

    # --- Every Kind is reachable, and every Kind is READ --------------------
    #
    # OUT OF THE ENUM'S OWN BLOCK, and not off the whole file: a sweep of the
    # module's indented identifiers finds `Ok(`, `Err(` and `Some(` and reports
    # three variants that do not exist.
    block = scope(module, r"pub enum Kind\b")
    if block is None:
        bad.append("document.rs no longer declares `enum Kind`")
        kinds = set()
    else:
        kinds = {
            m.group(1)
            for m in re.finditer(r"^    ([A-Z]\w*)(?:\(|,)", block, re.M)
        }
    floor(len(kinds), 5, "kinds of document")
    for k in sorted(kinds):
        if not arm or f"Kind::{k}" not in arm:
            bad.append(f"Kind::{k} is declared and `kind_of` never answers it")
    read = body_of(module, "read_it")
    if read is None:
        bad.append("document.rs no longer has read_it")
    else:
        floor(len(read), 200, "characters of `read_it`")
        for k in sorted(kinds):
            if f"Kind::{k}" not in read:
                bad.append(f"Kind::{k} reaches read_it and read_it does not name it")
        if re.search(r"^\s+_ =>", read, re.M):
            bad.append(
                "read_it has a catch-all arm; a Kind added tomorrow would fall "
                "into somebody else's reader with nothing saying so"
            )

    # --- THREE. The document is asked before the text ----------------------
    doc_at = shell.find("ronoctua_inspect::document::of(")
    txt_at = shell.find("ronoctua_inspect::text::of(")
    if doc_at < 0:
        bad.append("the shell never asks `document::of` — no document has a preview")
    elif txt_at >= 0 and doc_at > txt_at:
        bad.append(
            "the shell asks `text::of` before `document::of`; `text/rtf` descends "
            "from `text/plain`, so an .rtf would be drawn as its own markup again"
        )

    # --- EVERY program the inspector can run is named, on every side -------
    #
    # It read a HAND-TYPED list of three — the OLE readers — so the four that
    # came before them were checked by nobody, and a tool added tomorrow would
    # be checked by nobody too. What the enum names is now the whole question,
    # in both directions: a variable the Rust can ask for and the Nix does not
    # set is a preview that refuses on a machine where the program is
    # installed, and a variable the Nix sets and the Rust never asks for is a
    # closure carrying a program nothing runs.
    ROOT = pathlib.Path("${self}")
    variables = sorted(
        set(re.findall(r'Self::\w+ => "(RONOCTUA_\w+)"', uncommented((src / "tools.rs").read_text())))
    )
    floor(len(variables), 6, "programs named by `Tool::variable`")
    for where in ("nix/modules/media.nix", "nix/rust.nix", "nix/dev.nix"):
        said = hashless((ROOT / where).read_text())
        floor(len(said), 500, "characters of " + where)
        for v in variables:
            if v not in said:
                bad.append(f"{where} does not set {v} — the reader would refuse with `missing`")
    # AND THE FOOTER'S OWN UNIT, which is the one that matters on an installed
    # machine: `environment.sessionVariables` reaches a login shell, and the
    # footer is a systemd USER UNIT, which inherits the manager's environment
    # and not the shell's. A tool named in one and not the other works in the
    # nested loop and refuses on the machine the distro is for.
    media = hashless((ROOT / "nix/modules/media.nix").read_text())
    unit = set(
        re.findall(
            r"systemd\.user\.services\.ronoctua-footer\.environment\.(RONOCTUA_\w+)", media
        )
    )
    for v in variables:
        if v not in unit:
            bad.append(
                f"the ronoctua-footer unit does not set {v}; the preview would refuse "
                "with `missing` on an installed machine while working in `nix run .#dev`"
            )
    # AND A VARIABLE IN THAT UNIT THAT IS NOT A TOOL HAS TO PROVE IT.
    #
    # There is one — `RONOCTUA_SWAPPY`, the editor a screenshot's notification
    # offers — and it is excused by MEASUREMENT rather than by name: the
    # inspector must never mention it, and the shell must. An excuse written as
    # a bare name would go on excusing a variable that had quietly become the
    # inspector's.
    #
    # READ AS CODE AND NOT AS PROSE: `tools.rs` names `RONOCTUA_SWAPPY` in its
    # own header, explaining that the variable is the SHAPE this module copied.
    # A sweep that counted that would excuse nothing and fail forever — which
    # is the mistake two checks in this file have already made.
    def code(where):
        # The prelude's stripper, over a whole tree. It used to drop only a
        # line that BEGAN with `//`, so a variable named in a comment after
        # code on the same line still counted as being read.
        return "\n".join(
            uncommented(f.read_text()) for f in sorted(pathlib.Path(where).rglob("*.rs"))
        )

    inspect = code(src)
    shell_said = code(ROOT / "crates/ronoctua-shell/src")
    for v in sorted(unit - set(variables)):
        if v in inspect:
            bad.append(f"the ronoctua-footer unit sets {v}; ronoctua-inspect reads it and no `Tool` names it")
        elif v not in shell_said:
            bad.append(f"the ronoctua-footer unit sets {v} and nothing in this workspace reads it")

    if bad:
        print("ERROR: a document format that is claimed and not served.", file=sys.stderr)
        print("", file=sys.stderr)
        for b in bad:
            print("       " + b, file=sys.stderr)
        raise SystemExit(1)
    print(
        f"OK: {len(claimed)} document types, every one with a reader, the container "
        f"asked last, and the document asked before the text"
    )
    END
  '';

  playlist-formats-are-total = mkCheck "playlist-formats-are-total" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: `TYPES`, `REFUSED` and the row of the table are module-level.
    # `kind_of` is narrowed by name below.
    #
    # `uncommented` for the Rust and `hashless` for the Nix: every needle here
    # is a media type in a string literal, and `code_of` would empty all three
    # sets at once — three empty sets that agree perfectly.
    src = pathlib.Path("${../crates/ronoctua-inspect/src}")
    i18n = pathlib.Path("${../assets/i18n}")
    module = uncommented((src / "playlist.rs").read_text())
    pixels = uncommented((src / "pixels.rs").read_text())
    floor(len(module), 500, "characters of playlist.rs")
    floor(len(pixels), 1000, "characters of pixels.rs")
    bad = []

    # --- what the module says it serves -----------------------------------
    declared = re.search(r"pub const TYPES: \[&str; \d+\] = \[(.*?)\];", module, re.S)
    if declared is None:
        bad.append("playlist.rs no longer declares TYPES")
        claimed = set()
    else:
        claimed = set(re.findall(r'"([^"]+)"', declared.group(1)))

    # --- what it can actually PARSE ---------------------------------------
    arm = body_of(module, "kind_of")
    read = set(re.findall(r'"([^"]+)"', arm)) if arm else set()
    if arm is None:
        bad.append("playlist.rs no longer dispatches on the type")

    # --- and the refusal each unread one gets -----------------------------
    if read - claimed:
        bad.append("parsed but not claimed: " + ", ".join(sorted(read - claimed)))
    named = re.search(r"pub const REFUSED: \[&str; \d+\] = \[(.*?)\];", module, re.S)
    refused = set(re.findall(r'"([^"]+)"', named.group(1))) if named else set()
    if named is None:
        bad.append("playlist.rs no longer declares which spellings it refuses")
    # THE THREE LISTS MUST PARTITION THE CLAIM. A type in none of them is the
    # omission this check exists for: it resolves, reaches the reader, and comes
    # back with a sentence written about somebody else's format.
    if claimed - read - refused:
        bad.append(
            "claimed and neither read nor refused: "
            + ", ".join(sorted(claimed - read - refused))
        )
    if read & refused:
        bad.append("read AND refused: " + ", ".join(sorted(read & refused)))
    if refused - claimed:
        bad.append("refused but not claimed: " + ", ".join(sorted(refused - claimed)))
    if "Refusal::Unsupported(key::PREVIEW_PLAYLIST_UNREAD)" not in module:
        bad.append("the refused spellings no longer carry a sentence of their own")

    # --- the table must claim exactly the same set, ABOVE the sound row ----
    row = re.search(
        r'id: "playlist",\s*types: &crate::playlist::TYPES,', pixels
    )
    if row is None:
        bad.append("pixels.rs's playlist row no longer claims playlist::TYPES")
    else:
        order = [m.group(1) for m in re.finditer(r'id: "([a-z-]+)"', pixels)]
        if "playlist" not in order or "sound" not in order:
            bad.append("the table lost one of the two rows this depends on")
        elif order.index("playlist") > order.index("sound"):
            bad.append(
                "the playlist row sits below the sound row, so `media: audio` "
                "claims it first and ffmpeg is handed a list of names"
            )

    # --- and no playlist type may be probed --------------------------------
    facts = uncommented((src / "facts.rs").read_text())
    floor(len(facts), 500, "characters of facts.rs")
    if "playlist::is_a_playlist(mime)" not in facts:
        bad.append("facts::needs no longer keeps ffprobe away from a playlist")

    # --- the sentence, in both languages ----------------------------------
    for name in ${builtins.toJSON languages}:
        text = (i18n / f"{name}.ftl").read_text()
        if "files-preview-playlist-unread =" not in text:
            bad.append(f"{name} cannot say why a spelling is not opened")

    # --- AND ALL OF THEM DRAW THE SAME GLYPH -------------------------------
    #
    # A playlist has six spellings and five of them live under `audio/`, so the
    # generic rule drew them as MUSIC — which says the file IS sound, and a
    # playlist is a name for sound somebody else holds. The sixth fell to the
    # application generic and came out a plain file.
    #
    # It matters more than tidiness because two of the six claim the SAME
    # names: `audio/x-mpegurl` and `application/vnd.apple.mpegurl` both take
    # `*.m3u` and `*.m3u8` at one weight, so which of them wins is decided by
    # the bytes (`mime::of_path`). With one glyph for both, that decision stops
    # being visible — and nobody looking at a listing can tell the two names
    # apart anyway.
    glyphs = hashless(pathlib.Path("${../assets/icons/mime-glyphs.nix}").read_text())
    floor(len(glyphs), 1000, "characters of mime-glyphs.nix")
    rows = dict(
        re.findall(r'mime = "([^"]+)";\s*\n\s*token = "([^"]+)";', glyphs)
    )
    tokens = set()
    for spelling in sorted(claimed):
        if spelling not in rows:
            bad.append(
                f"{spelling} has no row in mime-glyphs.nix — it falls to its media "
                "type's generic icon, and a playlist is not the thing it lists"
            )
        else:
            tokens.add(rows[spelling])
    if len(tokens) > 1:
        bad.append(
            f"the spellings draw {len(tokens)} different glyphs ({sorted(tokens)}); "
            "which name wins is decided by the bytes, so the drawing must not depend on it"
        )

    floor(len(claimed), 4, "playlist spellings claimed")
    if bad:
        print("\n".join(bad))
        sys.exit(1)
    print(
        f"OK: {len(read)} spellings read, {len(refused)} refused by name, "
        f"the row sits above the sound row, and all {len(claimed)} draw one glyph"
    )
    END
    touch $out
  '';

  # THE VIEW'S KEYS ARE NOT THE COMPOSITOR'S, AND NOTHING ABOVE US CLAIMS `Ctrl`.
  #
  # `crates/ronoctua-shell/src/files.rs` says, above its own table: *"`Ctrl` is
  # the family nothing above us claims … the check
  # `files-keys-are-not-the-compositors` is what keeps it that way"*.
  #
  # It did not exist. The comment promised a guarantee nothing provided, for as
  # long as the table has been there — found while reading the file for another
  # reason, and worth more than the check itself: a comment that names a check
  # is read as a check having been run.
  #
  # What it forbids is `M-`, and the reason is on the screen rather than in
  # theory: the first attempt at these keys used `M-`, and in the nested loop
  # the leader's chord family IS `Alt` — so `M-RET` never reached the footer, it
  # opened a terminal.
  files-keys-are-not-the-compositors =
    mkCheck "files-keys-are-not-the-compositors" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        # FILE-WIDE: `OF_THE_VIEW` is a module-level table, and the `re.search`
        # for it below is the narrowing.
        #
        # `uncommented` and not `code_of`, because a CHORD is a string literal
        # and emptying it would leave a list of bindings with no keys in it —
        # every assertion below would then be about nothing.
        raw = pathlib.Path("${../crates/ronoctua-shell/src/files.rs}").read_text()
        files = uncommented(raw)
        floor(len(files), 10000, "characters of files.rs")
        bad = []

        # THE TABLE ITSELF, and not the whole file: a comment may name `M-` while
        # explaining why it is not used, and this reads the bindings.
        block = re.search(r"OF_THE_VIEW[^=]*= &\[(.*?)\n\];", files, re.S)
        if block is None:
            bad.append("files.rs no longer declares OF_THE_VIEW as a table")
        else:
            body = block.group(1)
            # A THIRD ELEMENT IS ALLOWED, and the day one arrived this check
            # went BLIND: the manager's table grew a `Where` — which rows a key
            # is alive on — and a pattern that demanded the closing bracket
            # right after the second string matched nothing at all. It failed
            # loudly ("binds nothing"), which is the only reason it was not
            # silence; the lesson is that a table's SHAPE is not the contract,
            # its first two columns are.
            bound = re.findall(r'\(\s*"([^"]+)"\s*,\s*"([^"]+)"\s*[,)]', body)
            floor(len(bound), 10, "keys bound by the view")
            for chord, action in bound:
                if chord.startswith("M-") or "-M-" in chord:
                    bad.append(
                        f"{action} is bound to {chord}: `M-` is the compositor's "
                        "chord family and the key would never arrive"
                    )
                if chord.startswith("Mod") or "Super" in chord:
                    bad.append(f"{action} is bound to {chord}, which the compositor takes first")

        # AND THE COMMENT STAYS TRUE. This check is named in the file; if the
        # sentence goes, the reader loses the reason and this loses its subject.
        # AGAINST THE RAW TEXT, on purpose. This one assertion is about PROSE:
        # the rule is written in a comment above the table, and that is where a
        # reader meets it. Asked of the stripped text it could never be true.
        if "files-keys-are-not-the-compositors" not in raw:
            bad.append("files.rs stopped naming this check, so nothing explains the rule")

        if bad:
            print("\n".join(bad))
            sys.exit(1)
        print(f"OK: {len(bound)} of the view's keys, none of them the compositor's")
        END
        touch $out
      '';

  # A ROW'S LABEL IS A KEY, AND THE ONE EXCEPTION IS NARROW ON PURPOSE.
  #
  # `facts::Label::Named` exists so a tag the FILE wrote can be shown under the
  # name the file wrote — `BPM (beats per minute)` has no key and can have
  # none, because nobody has seen it before it is read. That is the same rule
  # a `Choice`'s label already follows, and it is right.
  #
  # It is also a hole in invariant 8's MECHANISM: nothing in the compiler stops
  # somebody writing `Label::Named("Bit rate".into())` and putting an English
  # string on a Portuguese screen. Nothing in `english-names` would either — it
  # reads declarations, and that is a value.
  #
  # So the hole is closed from the other side: the variant may be built at ONE
  # site, and never from a literal. Tests are exempt, and they are where a
  # literal is the point.
  inspect-labels-are-keys = mkCheck "inspect-labels-are-keys" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the census is "how many sites in this crate build a
    # `Label::Named`", and one anywhere is the offence. There is no function to
    # narrow to — the point is that there is exactly ONE function, and the
    # sweep is what finds out.
    src = pathlib.Path("${../crates/ronoctua-inspect/src}")
    shell = pathlib.Path("${../crates/ronoctua-shell/src}")
    bad = []

    def code_only(text):
        """The file with its test module cut away, and then stripped.

        The strip was `re.sub(r"//.*", "")`, which is wrong in the one way
        that matters here: a `//` inside a string literal ends the line, so a
        URL or a path would hide whatever followed it. `code_of` knows the
        difference, and it empties the literals too — which is right, because
        what this check refuses is a label BUILT from one.
        """
        return code_of(re.split(r"\n#\[cfg\(test\)\]", text)[0])

    built, swept = [], 0
    for path in sorted(src.rglob("*.rs")):
        swept += 1
        for n, line in enumerate(code_only(path.read_text()).splitlines(), 1):
            if "Label::Named(" in line:
                built.append((path.name, n, line.strip()))
    floor(swept, 10, "sources of ronoctua-inspect swept for a label")

    if len(built) != 1:
        bad.append(
            "Label::Named is built at "
            + str(len(built))
            + " sites and must be built at exactly one: "
            + "; ".join(f"{f}:{n}" for f, n, _ in built)
        )

    for f, n, line in built:
        if re.search(r'Label::Named\(\s*"', line):
            bad.append(f"{f}:{n} builds a label from a literal, which is a key by another name")

    # AND THE ONE PLACE THAT RESOLVES ONE must still tell the two apart, or a
    # key reaches the screen as itself.
    files = code_of((shell / "files.rs").read_text())
    floor(len(files), 10000, "characters of files.rs")
    if "Label::Named(name) => name.clone()" not in files:
        bad.append("files.rs no longer shows a named label verbatim")
    if "Label::Key(k) => texts.t(k)" not in files:
        bad.append("files.rs no longer translates a keyed label")

    if bad:
        print("\n".join(bad))
        sys.exit(1)
    print(f"OK: one site builds Label::Named, and it reads a name rather than writing one")
    END
    touch $out
  '';

  # EVERY 3D FORMAT IS REACHABLE BY THE WHOLE PATH, AND NOT BY HALF OF IT.
  #
  # A format needs four things to work, in four files: a `Shape` variant, an
  # arm in `mesh::read`'s dispatch, a MIME type on the table's `mesh` row, and
  # a sentence in both languages. Three of the four and the file resolves,
  # decodes, draws — and the panel names the format with a raw key; or it
  # resolves and nothing draws; or nothing resolves at all and the reader that
  # was written for it is never called.
  #
  # That last one is not hypothetical. A `.obj` had a reader, a `Shape`, a key
  # and two sentences, and resolved to `application/x-tgif` because of a glob
  # nobody had looked at — it was found by hand, on the owner's screen.
  mesh-formats-are-total = mkCheck "mesh-formats-are-total" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: `enum Shape`, its `ALL` and the table of claims are all
    # module-level. `scope` narrows to the enum, by its braces.
    #
    # `uncommented`, because the media types this compares ARE string
    # literals — `code_of` would empty every claim in the table at once.
    src = pathlib.Path("${../crates/ronoctua-inspect/src}")
    i18n = pathlib.Path("${../assets/i18n}")
    mod = uncommented((src / "mesh" / "mod.rs").read_text())
    pixels = uncommented((src / "pixels.rs").read_text())
    floor(len(mod), 500, "characters of mesh/mod.rs")
    floor(len(pixels), 1000, "characters of pixels.rs")
    bad = []

    # --- the variants, from the enum itself -------------------------------
    block = scope(mod, r"pub enum Shape\b")
    if block is None:
        bad.append("no `pub enum Shape` — what does this check read?")
        variants = []
    else:
        variants = re.findall(r"^    ([A-Z][A-Za-z0-9]*),$", block, re.M)
    floor(len(variants), 10, "shapes declared by `enum Shape`")

    # --- each one has a key, and is in ALL --------------------------------
    keyed = dict(re.findall(r"Self::([A-Za-z0-9]+) => crate::key::([A-Z_0-9]+),", mod))
    listed = re.search(r"pub const ALL: \[Self; \d+\] = \[(.*?)\];", mod, re.S)
    inside = re.findall(r"Self::([A-Za-z0-9]+),", listed.group(1)) if listed else []
    for v in variants:
        if v not in keyed:
            bad.append(f"`Shape::{v}` has no arm in `Shape::key`")
        if v not in inside:
            bad.append(f"`Shape::{v}` is missing from `Shape::ALL`")

    # --- the key constants resolve, and both languages carry them ---------
    lib = (src / "lib.rs").read_text()
    names = dict(re.findall(r'pub const ([A-Z_0-9]+): &str = "([a-z0-9-]+)";', lib))
    for v, const in keyed.items():
        text = names.get(const)
        if text is None:
            bad.append(f"`key::{const}`, which `Shape::{v}` uses, does not exist")
            continue
        for language in ${builtins.toJSON languages}:
            body = (i18n / f"{language}.ftl").read_text()
            if not re.search(rf"^{re.escape(text)} = .", body, re.M):
                bad.append(f"`{text}` is missing from {language}.ftl")

    # --- the dispatch and the table claim the SAME types -------------------
    dispatch = re.search(r"match ronoctua_files::mime::canonical\(mime\) \{(.*?)\n    \}", mod, re.S)
    if dispatch is None:
        bad.append("no dispatch in `mesh::read` — what does this check read?")
        reads = set()
    else:
        reads = set(re.findall(r'"([a-z]+/[A-Za-z0-9.+-]+)" =>', dispatch.group(1)))
    row = re.search(r'id: "mesh",\s*types: &\[(.*?)\],', pixels, re.S)
    claimed = set(re.findall(r'"([a-z]+/[A-Za-z0-9.+-]+)"', row.group(1))) if row else set()
    if not claimed:
        bad.append("the table's `mesh` row claims nothing")
    for kind in sorted(reads - claimed):
        bad.append(f"`{kind}` is read but the table does not claim it — nothing resolves to it")
    for kind in sorted(claimed - reads):
        bad.append(f"`{kind}` is claimed but `read` has no arm — it draws nothing")

    if bad:
        print("ERROR: a 3D format is reachable by only part of its path.", file=sys.stderr)
        print("", file=sys.stderr)
        for b in bad:
            print("       " + b, file=sys.stderr)
        print("", file=sys.stderr)
        print("       A format takes four things: a `Shape`, an arm in `read`, a", file=sys.stderr)
        print("       type on the table's mesh row, and a sentence in both", file=sys.stderr)
        print("       languages. Three of them is a file that half works.", file=sys.stderr)
        raise SystemExit(1)
    print(f"OK: {len(variants)} shapes and {len(claimed)} types, whole path each")
    END
  '';

  # EVERY ROW OF THE FILE MANAGER'S MENU HAS TEXT, IN BOTH LANGUAGES.
  #
  # The same shape as the rescue console's, and for the same reason: a row with
  # no translation draws `[files-open]` on screen, which is exactly the
  # silent-fallback class invariant 8 exists to refuse — `Texts::t` gives back
  # `[key]` rather than bringing the shell down, so somebody has to be looking
  # for it.
  files-actions-have-text =
    mkCheck "files-actions-have-text"
      [
        pkgs.gnugrep
        pkgs.coreutils
      ]
      ''
        src=${../crates/ronoctua-files/src}
        failed=0

        # FROM THE ID, and not from the label. The label is a CONSTANT
        # (`key::FILES_OPEN`), so grepping for a `"files-…"` literal here finds
        # only the prefix — which is what the first version of this check did,
        # and it would have gone green on a table with no translations at all.
        #
        # Deriving the key from the id is also the discipline itself: the
        # registry refuses a row whose label is not `files-<id>`, and this is
        # the same rule reaching the `.ftl`.
        ids=$(grep -oE '^ *id: "[a-z0-9-]+"' "$src"/menu.rs | grep -oE '"[^"]+"' | tr -d '"')
        [ -n "$ids" ] || {
          echo "ERROR: no row in the action table — what does the grep match?" >&2
          exit 1
        }
        # TWO KEYS PER ROW, and the second is the one that would rot quietly.
        #
        # `files-<id>` is the label, and it is missing loudly: the row draws its
        # own key on screen. `files-does-<id>` is the technical answer that
        # reaches the message line under the cursor, and a missing one shows up
        # only when somebody happens to rest on that row — which is precisely
        # the register that was added for people who go looking.
        keys=$(for i in $ids; do echo "files-$i"; echo "files-does-$i"; done | sort -u)

        for k in $keys; do
          for language in ${lib.concatStringsSep " " languages}; do
            grep -qE "^$k = ." ${../assets/i18n}/$language.ftl || {
              echo "ERROR: $k is missing from $language.ftl — the screen would show the raw key" >&2
              failed=1
            }
          done
        done

        # AND THE SIDEBAR'S OWN MENU, which is a second table for a second kind
        # of subject: `menu.rs` is about an `Entry` in a directory, and every
        # one of its `Applies` asks a question only an entry can answer. The
        # rule is the same one — `sidebar-<id>` derived from the id — and so is
        # the reason it is derived and not grepped: the label is a constant.
        side=$(grep -oE '^ *id: "[a-z0-9-]+"' "$src"/sidebar_menu.rs \
          | grep -oE '"[^"]+"' | tr -d '"')
        [ -n "$side" ] || {
          echo "ERROR: no row in the sidebar's menu." >&2
          exit 1
        }
        sidekeys=$(for i in $side; do echo "sidebar-$i"; echo "sidebar-does-$i"; done | sort -u)
        for k in $sidekeys; do
          for language in ${lib.concatStringsSep " " languages}; do
            grep -qE "^$k = ." ${../assets/i18n}/$language.ftl || {
              echo "ERROR: $k is missing from $language.ftl — the sidebar menu's" >&2
              echo "      row would show the raw key." >&2
              failed=1
            }
          done
        done

        # AND THE VIEW'S OWN KEYS, which live in a second table for the reason
        # `leader::OF_CLIPBOARD_VIEW` gives: a key that only exists inside a
        # `match` arm is a key nothing can enumerate.
        # A TRAILING HYPHEN IS A PREFIX AND NOT A KEY. The file also contains
        # `"files-does-"` — a test asserting that the technical explanation
        # comes from the right table — and grepping it as a key sent this check
        # looking for a translation of the empty string.
        #
        # AND `files-strong-*` IS NOT A KEY EITHER, because it never reaches a
        # screen: those four are the shifted arrows, and `View::strong_meaning`
        # turns each of them into the id of a REAL action — whose sentence is
        # what the hint line then shows — before the table's `match` sees it.
        # A translation for them would be four sentences in two languages that
        # nothing can ever draw, which is the state this whole line of work
        # existed to get out of.
        #
        # THE EXEMPTION IS ONLY VALID WHILE THE RESOLVER IS, so it is checked
        # rather than trusted: delete `strong_meaning` and the four ids are
        # demanded again, loudly, on the next build.
        grep -q 'fn strong_meaning' ${../crates/ronoctua-shell/src}/files.rs || {
          echo "ERROR: files.rs no longer resolves the shifted arrows, so" >&2
          echo "       files-strong-* would reach the screen with no name." >&2
          failed=1
        }
        view=$(grep -ohE '"files-[a-z0-9-]+"' ${../crates/ronoctua-shell/src}/files.rs \
          | tr -d '"' | grep -vE -- '-$' | grep -vE '^files-strong-' | sort -u)
        for k in $view; do
          for language in ${lib.concatStringsSep " " languages}; do
            grep -qE "^$k = ." ${../assets/i18n}/$language.ftl || {
              echo "ERROR: $k is missing from $language.ftl — the key would have no name" >&2
              failed=1
            }
          done
        done

        [ "$failed" = 0 ] || exit 1
        echo "OK: $(echo "$keys" "$sidekeys" "$view" | tr ' ' '\n' | sort -u | wc -l) keys, in both languages"
      '';

  # NOTHING THE MOUSE DOES IS OUT OF THE KEYBOARD'S REACH.
  #
  # The owner's rule, mechanised. Two lists, compared in BOTH directions:
  #
  #   - every row of `menu.rs` has a key, and no two share one;
  #   - every `Hit` the drawing can produce is reachable by a key too.
  #
  # The second half is the one that would rot: adding a clickable field is one
  # line in `row_of`, and nothing about that line says a key has to exist for
  # it. A file manager where "change the owner" is a click and not a key is a
  # file manager somebody has to take their hand off the keyboard for.
  files-everything-has-a-key =
    mkCheck "files-everything-has-a-key"
      [
        pkgs.gnugrep
        pkgs.coreutils
      ]
      ''
        menu=${../crates/ronoctua-files/src}/menu.rs
        view=${../crates/ronoctua-shell/src}/files.rs
        failed=0

        # --- every menu row has a key, and the keys do not collide ----------
        keys=$(grep -oE '^ *key: "[^"]+"' "$menu" | grep -oE '"[^"]+"' | tr -d '"')
        [ -n "$keys" ] || { echo "ERROR: no key in the action table" >&2; exit 1; }
        repeated=$(echo "$keys" | sort | uniq -d)
        [ -z "$repeated" ] || {
          echo "ERROR: two menu rows on the same key: $repeated" >&2
          failed=1
        }

        # --- every clickable Hit is reachable by a key ----------------------
        #
        # The variants come from the enum itself, so a new one is caught the day
        # it is added rather than the day somebody notices it has no key.
        variants=$(sed -n '/^pub enum Hit {/,/^}/p' "$view" \
          | grep -oE '^ {4}[A-Z][A-Za-z]*' | tr -d ' ')
        [ -n "$variants" ] || { echo "ERROR: could not find the Hit enum" >&2; exit 1; }

        for v in $variants; do
          case "$v" in
            # These three are not a promise of an action: `Nothing` is the
            # absence of one, and `Menu` and `Choice` are rows of something
            # already on screen that the arrows and `Enter` already reach.
            Nothing|Menu|Choice) continue ;;
          esac
          grep -qE "Hit::$v" "$view" || {
            echo "ERROR: the variant Hit::$v is produced by nothing" >&2
            failed=1
          }
        done

        # --- and the view's key table agrees with its `match` ---------------
        #
        # The unit test beside the table presses every key in it. THIS half is
        # the other direction — a key HANDLED and never declared, which the
        # hint line would not teach and the manual would not list.
        #
        # It used to extract `declared` and compare it with nothing at all,
        # printing the count on the OK line while its own comment claimed it
        # caught that direction. A check against the criterion and not against
        # the code closes an empty milestone, which is AGENTS.md's own words.
        declared=$(sed -n '/^pub const OF_THE_VIEW/,/^];/p' "$view" \
          | grep -oE '^ *\("[^"]+"' | grep -oE '"[^"]+"' | tr -d '"')
        [ -n "$declared" ] || { echo "ERROR: could not find OF_THE_VIEW" >&2; exit 1; }

        # AND THE TABLE IS THE ONLY DOOR, which is what makes the other
        # direction impossible rather than merely absent.
        #
        # `View::key` does not `match` on a letter at all: it asks
        # `of_the_view(t)`, which resolves the pressed key against
        # `OF_THE_VIEW` — so a key the view answers to and the table does not
        # declare cannot exist by construction. That is the design, and this
        # is what holds it: the resolver has to be there, and no bare letter
        # arm may appear beside it.
        #
        # `Sym::Char('s')` in the SIDEBAR is not one: `sidebar_key` is a
        # second pane with its own table, read above as `sidekeys`.
        # THE BODY IS TAKEN ONCE, into a variable. Piping `sed` into `grep -q`
        # makes `grep` exit on the first match, `sed` die of a broken pipe and
        # `pipefail` call the whole thing a failure — a check that reports the
        # opposite of what it found.
        body=$(sed -n '/pub fn key(&mut self/,/^    }$/p' "$view")
        case "$body" in
          *of_the_view\(t\)*) ;;
          *)
            echo "ERROR: the view no longer resolves keys through OF_THE_VIEW," >&2
            echo "       so a key it answers to could exist with no line in the" >&2
            echo "       table — untaught by the hint line, unnamed by the manual." >&2
            failed=1
            ;;
        esac
        loose=$(printf '%s\n' "$body" | grep -nE "Sym::Char\('.'\)" || true)
        [ -z "$loose" ] || {
          echo "ERROR: a letter answered outside the table:" >&2
          echo "$loose" >&2
          failed=1
        }

        [ "$failed" = 0 ] || exit 1
        echo "OK: $(echo "$keys" | wc -l) menu keys, $(echo "$declared" | wc -l) of the view's resolved through the table, and every Hit has an owner"
      '';

  # THE PREVIEW'S PLAYER NEVER GUESSES A FRAME'S SIZE.
  #
  # This is the defect the owner photographed, pinned against the CODE rather
  # than against a screenshot. `play_video` used to deduce the height from how
  # many bytes happened to arrive in one 64 KiB read: at width 512 a row is
  # 2 048 bytes and 65 536 is exactly 32 of them, so the stream was declared
  # 512x32 and every frame after it was a horizontal slice of the film.
  #
  # Three claims, and each of them is what makes the size ours:
  #
  #   - the filter pads to a literal `W:H`, so what leaves the pipe is exactly
  #     what was asked for whatever the file says about itself;
  #   - `-2` appears in no scale filter — it is ffmpeg's "work this one out"
  #     marker, and the whole point is that nothing is left to it;
  #   - and nothing anywhere reads a dimension back out of the stream.
  motion-never-guesses-a-frame =
    mkCheck "motion-never-guesses-a-frame"
      [
        pkgs.gnugrep
        pkgs.coreutils
      ]
      ''
        probe=${../crates/ronoctua-inspect/src}/motion.rs
        player=${../crates/ronoctua-shell/src}/motion.rs
        failed=0

        # --- the size is stated, on both sides of the filter ----------------
        grep -q 'scale={w}:{h}' "$probe" || {
          echo "ERROR: the scale filter no longer names both dimensions" >&2
          failed=1
        }
        grep -q 'pad={w}:{h}' "$probe" || {
          echo "ERROR: the pad filter is gone — the frame's size is the file's again" >&2
          failed=1
        }

        # --- and NOTHING is left to ffmpeg ----------------------------------
        #
        # `-2` is its marker for "choose this one to keep the aspect". Under it
        # the height depends on the file, which is what the frame count cannot
        # survive.
        left=$(grep -nE 'scale=[^,"]*-2' "$probe" || true)
        [ -z "$left" ] || {
          echo "ERROR: a dimension was left to ffmpeg:" >&2
          echo "$left" >&2
          failed=1
        }

        # --- and the player does not read one back --------------------------
        #
        # The dead function by name, and the shape of what it did: a height
        # divided out of a byte count.
        #
        # THE COMMENTS COME OFF FIRST, and that is not tidiness — it is what
        # this check was measured to need. The player's own documentation
        # explains at length why the old arithmetic is gone, so a grep over the
        # whole file finds the explanation and fails on it. A check that cannot
        # tell code from a sentence about code is a check that forbids writing
        # down why.
        code=$(grep -vE "^[[:space:]]*(///|//|\*)" "$player")
        back=$(printf '%s' "$code" | grep -nE 'first_frame_height|/ *row|bytes_read */' || true)
        [ -z "$back" ] || {
          echo "ERROR: the player is working a dimension out of the bytes again:" >&2
          echo "$back" >&2
          failed=1
        }

        [ "$failed" = 0 ] || exit 1
        echo "OK: the frame's size is stated and nothing derives it"
      '';

  # A PICTURE WITH A FILM IN IT IS FOUND BY ITS BYTES, NOT BY A TABLE OF MAKERS.
  #
  # Phones from several makers record a second or two of video alongside the
  # shutter, and each writes it a little differently. The temptation is a parser
  # per maker — and this machine has files from exactly ONE of them, so every
  # other parser would be code written from a document and never run against a
  # file.
  #
  # What is here instead is one general route: an MP4 begins with an `ftyp` box,
  # so the tail is searched for one. It is exercised by the owner's own two
  # Pixel files, where it lands on the very byte their XMP declares.
  #
  # Three claims:
  #
  #   - the general route exists and is not commented out;
  #   - the film is read WHERE IT LIES, with ffmpeg's `subfile`, and never
  #     copied out to a temporary — a motion photo's video is megabytes;
  #   - and nothing decides by the file's NAME. `MVIMG_`, `PXL_` and `.MP.` are
  #     the makers' naming habits, not facts about the bytes, and a rename would
  #     turn the feature off with nothing saying why.
  motion-photo-is-found-by-bytes =
    mkCheck "motion-photo-is-found-by-bytes"
      [
        pkgs.gnugrep
        pkgs.coreutils
      ]
      ''
        probe=${../crates/ronoctua-inspect/src}/motion.rs
        failed=0

        # THE CODE, WITHOUT ITS TESTS OR ITS REASONING.
        #
        # Everything below asks about the code, and every one of these strings
        # also appears in a test that asserts it or a comment that explains it.
        # Measured with each defect planted back: the `subfile` claim passed on
        # the TEST's own copy of the word while the code had stopped using it.
        code=$(sed '/^mod tests {/,$d' "$probe" | grep -vE "^[[:space:]]*(///|//|\*)")

        # --- the general route -----------------------------------------------
        printf '%s' "$code" | grep -q 'fn tail_video' || {
          echo "ERROR: the scan for an appended film is gone — what covers a maker" >&2
          echo "      whose file nobody here has?" >&2
          failed=1
        }
        printf '%s' "$code" | grep -q 'b"ftyp"' || {
          echo "ERROR: nothing looks for an MP4's own first box any more" >&2
          failed=1
        }

        # --- read where it lies ----------------------------------------------
        printf '%s' "$code" | grep -q 'subfile,,start,' || {
          echo "ERROR: the film inside a picture is no longer read with subfile" >&2
          echo "      — the only other way is copying megabytes to a temporary." >&2
          failed=1
        }

        # --- and never by the name -------------------------------------------
        #
        # AND NEVER BY THE NAME. The reasoning above names the makers' file
        # prefixes and a fixture is called `IMG_1.MOV` because that is what an
        # iPhone calls one; neither is a decision.
        named=$(printf '%s' "$code" | grep -nE 'MVIMG|PXL_|\.MP\.|IMG_[0-9]' || true)
        [ -z "$named" ] || {
          echo "ERROR: a maker's naming habit is being read as a fact:" >&2
          echo "$named" >&2
          failed=1
        }

        [ "$failed" = 0 ] || exit 1
        echo "OK: the film is found by its bytes and read where it lies"
      '';

  # THE PLAYER NEVER LEAVES A CHILD, AND NEVER BLOCKS FOR EVER.
  #
  # Two properties one cannot see on a screenshot and that both end as a
  # process the owner finds later:
  #
  #   - a `read` with no deadline hangs the player's thread for the rest of the
  #     session, silently — the door keeps painting and `orders.recv()` never
  #     runs again;
  #   - and a `kill` written out at each exit leaks an ffmpeg the day somebody
  #     adds a fifth exit.
  motion-never-leaks-a-child =
    mkCheck "motion-never-leaks-a-child"
      [
        pkgs.gnugrep
        pkgs.coreutils
      ]
      ''
        player=${../crates/ronoctua-shell/src}/motion.rs
        failed=0

        # --- every read has a deadline --------------------------------------
        #
        # OVER THE CODE AND NOT THE COMMENTS. The player documents at length why
        # `read_exact` is gone, and a grep over the whole file finds that
        # sentence and fails on it — measured, before this check was written
        # down. A check that cannot tell code from a sentence about code is a
        # check that forbids writing down why.
        code=$(grep -vE "^[[:space:]]*(///|//|\*)" "$player")
        blocking=$(printf '%s' "$code" \
          | grep -nE 'read_exact\(|read_to_end\(|read_to_string\(' || true)
        [ -z "$blocking" ] || {
          echo "ERROR: a blocking read with no deadline in the player:" >&2
          echo "$blocking" >&2
          echo "      A source that stops answering takes the thread with it." >&2
          failed=1
        }
        grep -q 'rustix::event::poll' "$player" || {
          echo "ERROR: the player no longer polls — what bounds its reads?" >&2
          failed=1
        }

        # --- the child goes by a GUARD and not by hand ----------------------
        grep -q 'impl Drop for Reaped' "$player" || {
          echo "ERROR: the Drop guard is gone; every exit has to kill by hand again" >&2
          failed=1
        }
        # AND ITS OWN GROUP, so a signal reaches whatever ffmpeg started.
        grep -q 'process_group(0)' "$player" || {
          echo "ERROR: the child is not in a group of its own" >&2
          failed=1
        }

        [ "$failed" = 0 ] || exit 1
        echo "OK: every read has a deadline and every child has a guard"
      '';

  # NOTHING THE FILE MANAGER SPAWNS COMES BY NAME.
  #
  # `bsdtar`, `fstrim` and `pkexec`. Same two sides as the rescue console's:
  # the variables the crate reads, and the table `nix/rust.nix` sets.
  # ONE BOUNDARY WITH PIPEWIRE, and the same shape as `files-runs-by-path`:
  # every variable the crate reads has to be in `nix/rust.nix`, and no program
  # may be spawned by NAME. A `Command::new("wpctl")` works in the devshell and
  # fails inside a systemd scope, far from the cause.
  audio-runs-by-path = mkCheck "audio-runs-by-path" [ pkgs.gnugrep ] ''
    src=${../crates/ronoctua-audio/src}
    failed=0

    read_it=$(grep -ohE 'option_env!\("RONOCTUA_[A-Z_]+"\)' "$src"/*.rs \
      | grep -oE 'RONOCTUA_[A-Z_]+' | sort -u)
    [ -n "$read_it" ] || {
      echo "ERROR: the crate reads no variable at all — what does the grep match?" >&2
      exit 1
    }

    for v in $read_it; do
      grep -qE "^ *$v = " ${../nix/rust.nix} || {
        echo "ERROR: $v is read by the crate and is not in nix/rust.nix" >&2
        echo "      The program would fail far from the cause, with a minimal PATH." >&2
        failed=1
      }
    done

    bare=$(grep -nE 'Command::new\("[a-z]' "$src"/*.rs || true)
    [ -z "$bare" ] || { echo "ERROR: a program by NAME, not by path:" >&2; echo "$bare" >&2; failed=1; }

    [ "$failed" = 0 ] || exit 1
    echo "OK: $(echo "$read_it" | wc -l) programs, all by store path"
  '';

  # THE THREE PROGRAMS ARE NAMED IN ONE FILE, and `pw-cat` in one place.
  #
  # This is the rule `ronoctua-disks` writes a header about — one border, one
  # crate — turned into a check, because this repository has already broken it
  # once: `ronoctua-bluetooth` ran its own `pw-dump` and parsed the graph
  # itself, so there were two readers of one daemon and no way to say which was
  # right the day they disagreed.
  #
  # The microphone gets a rule of its own on top. `pw-cat --record` is the ONE
  # thing here that opens a recording device, and what keeps it honest is that
  # there is a single place to look at to know when it runs.
  # THE CAMERA'S BOUNDARY: one file speaks the V4L2 ioctls, and one opens a
  # camera for frames. A second of either is a second thing to be wrong about
  # a device that has a LIGHT on it.
  one-camera-boundary = mkCheck "one-camera-boundary" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a boundary is broken by a name anywhere outside it.
    # `uncommented`, because two needles are string literals (`-input_format`
    # is an argument ffmpeg is given) and a sentence ABOUT the boundary in a
    # comment is not a call.
    crates = pathlib.Path("${../crates}")
    ioctls = crates / "ronoctua-camera" / "src" / "v4l2.rs"
    door = crates / "ronoctua-camera" / "src" / "capture.rs"
    swept = 0
    wrong = []
    for f in sorted(crates.rglob("*.rs")):
        code = uncommented(without_tests(f.read_text()))
        swept += 1
        # THE V4L2 GROUP (`'V'`) is the ioctl family; nothing else in the tree
        # has a reason to build an opcode of it.
        if f != ioctls and re.search(r"opcode::\w+::<[^>]+>\(b'V'", code):
            wrong.append(f"{f.relative_to(crates)} builds a V4L2 ioctl outside v4l2.rs")
        if f != door and '"-input_format"' in code:
            wrong.append(f"{f.relative_to(crates)} opens a camera for frames outside capture.rs")
    floor(swept, 100, "sources of the workspace swept for a V4L2 call")
    body = uncommented(ioctls.read_text())
    floor(len(body), 2000, "characters of v4l2.rs")
    for needle in ("QUERYCAP", "ENUM_FMT", "QUERYCTRL", "S_CTRL"):
        if needle not in body:
            wrong.append(f"v4l2.rs no longer names {needle}; has the boundary moved?")
    for w in wrong:
        print(f"ERROR: {w}", file=sys.stderr)
    if wrong:
        sys.exit(1)
    print("OK: one file speaks V4L2, one file opens a camera")
    END
  '';

  # AND THAT DOOR IS A VALUE WITH A GUARD, the microphone's rule: dropping it
  # closes the device, and a signal to the studio cannot leave it open.
  the-camera-has-one-door = mkCheck "the-camera-has-one-door" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the guard, the struct and the death signal are each either
    # in their file or not. `uncommented`: `--pdeathsig` is a string literal.
    src = pathlib.Path("${../crates/ronoctua-camera/src}")
    door = uncommented((src / "capture.rs").read_text())
    frames = uncommented((src / "frames.rs").read_text())
    floor(len(door), 1500, "characters of capture.rs")
    wrong = []
    if "impl Drop for Reaped" not in frames:
        wrong.append("frames.rs lost the `Drop` that kills the child; nothing closes the camera")
    if "_child: Reaped" not in door:
        wrong.append("`Capture` no longer holds its ffmpeg in a `Reaped`")
    if "--pdeathsig" not in door or "RONOCTUA_SETPRIV" not in door:
        wrong.append("the capture no longer runs under a death signal; a killed studio would film on")
    for w in wrong:
        print(f"ERROR: {w}", file=sys.stderr)
    if wrong:
        sys.exit(1)
    print("OK: a camera opens through one value, and closes with it")
    END
  '';

  # THE STRUCTS THE KERNEL WRITES INTO, against the C compiler's `sizeof`. A
  # wrong size is the kernel writing past a struct with no symptom at all —
  # the trap AGENTS.md records from the libtorrent FFI.
  v4l2-layout-matches-c =
    mkCheck "v4l2-layout-matches-c" [ pkgs.python3 pkgs.stdenv.cc pkgs.linuxHeaders ]
      ''
        cat > probe.c <<'C'
        #include <stdio.h>
        #include <linux/videodev2.h>
        int main(void) {
          printf("Capability %zu\n", sizeof(struct v4l2_capability));
          printf("FmtDesc %zu\n", sizeof(struct v4l2_fmtdesc));
          printf("FrmSizeEnum %zu\n", sizeof(struct v4l2_frmsizeenum));
          printf("FrmIvalEnum %zu\n", sizeof(struct v4l2_frmivalenum));
          printf("QueryCtrl %zu\n", sizeof(struct v4l2_queryctrl));
          printf("QueryMenu %zu\n", sizeof(struct v4l2_querymenu));
          printf("Control %zu\n", sizeof(struct v4l2_control));
          printf("QUERYCAP %lu\n", (unsigned long)VIDIOC_QUERYCAP);
          printf("ENUM_FMT %lu\n", (unsigned long)VIDIOC_ENUM_FMT);
          printf("QUERYCTRL %lu\n", (unsigned long)VIDIOC_QUERYCTRL);
          printf("QUERYMENU %lu\n", (unsigned long)VIDIOC_QUERYMENU);
          printf("G_CTRL %lu\n", (unsigned long)VIDIOC_G_CTRL);
          printf("S_CTRL %lu\n", (unsigned long)VIDIOC_S_CTRL);
          printf("ENUM_FRAMESIZES %lu\n", (unsigned long)VIDIOC_ENUM_FRAMESIZES);
          printf("ENUM_FRAMEINTERVALS %lu\n", (unsigned long)VIDIOC_ENUM_FRAMEINTERVALS);
          return 0;
        }
        C
        cc -I${pkgs.linuxHeaders}/include probe.c -o probe
        ./probe > measured.txt
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        # PARSED: the C side is a table the compiler wrote, split on whitespace.
        measured = {}
        for row in pathlib.Path("measured.txt").read_text().splitlines():
            name, value = row.split()
            measured[name] = int(value)
        # FILE-WIDE: `code_of`, and the numbers are the compile-time assertions and
        # the opcode test; a number in a comment is prose, not a promise.
        rust = code_of(pathlib.Path("${../crates/ronoctua-camera/src/v4l2.rs}").read_text())
        floor(len(rust), 2000, "characters of v4l2.rs")
        declared = {n: int(v) for n, v in re.findall(r"size_of::<(\w+)>\(\) == (\d+)", rust)}
        for n, v in re.findall(r"assert_eq!\((\w+), (0x[0-9a-f_]+)\)", rust):
            declared[n] = int(v.replace("_", ""), 16)
        floor(len(declared), 12, "numbers v4l2.rs declares")
        wrong = [f"{n}: the C compiler says {v}, the Rust says {declared.get(n)}" for n, v in sorted(measured.items()) if declared.get(n) != v]
        for w in wrong:
            print(f"ERROR: {w}", file=sys.stderr)
        if wrong:
            sys.exit(1)
        print(f"OK: {len(measured)} sizes and opcodes agree with videodev2.h")
        END
      '';

  # LIBMPV'S STRUCTS AND NUMBERS, against the C compiler. The player's FFI is
  # written by hand (`crates/ronoctua-player-engine/src/mpv.rs`), and
  # `#[repr(C)]` promises to ARRANGE, never to check: a wrong size or a wrong
  # event number is libmpv writing past a struct, or an end of file read as a
  # seek, with nothing said anywhere. Every size the Rust asserts and every
  # constant it declares is measured here from the headers of the libmpv the
  # flake pins.
  mpv-layout-matches-c = mkCheck "mpv-layout-matches-c" [ pkgs.python3 pkgs.stdenv.cc ] ''
    cat > probe.c <<'C'
    #include <stdio.h>
    #include <mpv/client.h>
    #include <mpv/render.h>
    #include <mpv/stream_cb.h>
    int main(void) {
      printf("RawEvent %zu\n", sizeof(mpv_event));
      printf("RawProperty %zu\n", sizeof(mpv_event_property));
      printf("RawEndFile %zu\n", sizeof(mpv_event_end_file));
      printf("RawRenderParam %zu\n", sizeof(mpv_render_param));
      printf("RawStreamInfo %zu\n", sizeof(mpv_stream_cb_info));
      printf("FORMAT_NONE %d\n", MPV_FORMAT_NONE);
      printf("FORMAT_STRING %d\n", MPV_FORMAT_STRING);
      printf("FORMAT_FLAG %d\n", MPV_FORMAT_FLAG);
      printf("FORMAT_INT64 %d\n", MPV_FORMAT_INT64);
      printf("FORMAT_DOUBLE %d\n", MPV_FORMAT_DOUBLE);
      printf("EVENT_NONE %d\n", MPV_EVENT_NONE);
      printf("EVENT_SHUTDOWN %d\n", MPV_EVENT_SHUTDOWN);
      printf("EVENT_START_FILE %d\n", MPV_EVENT_START_FILE);
      printf("EVENT_END_FILE %d\n", MPV_EVENT_END_FILE);
      printf("EVENT_FILE_LOADED %d\n", MPV_EVENT_FILE_LOADED);
      printf("EVENT_SEEK %d\n", MPV_EVENT_SEEK);
      printf("EVENT_PLAYBACK_RESTART %d\n", MPV_EVENT_PLAYBACK_RESTART);
      printf("EVENT_PROPERTY_CHANGE %d\n", MPV_EVENT_PROPERTY_CHANGE);
      printf("END_FILE_EOF %d\n", MPV_END_FILE_REASON_EOF);
      printf("END_FILE_ERROR %d\n", MPV_END_FILE_REASON_ERROR);
      printf("RENDER_PARAM_API_TYPE %d\n", MPV_RENDER_PARAM_API_TYPE);
      printf("RENDER_PARAM_BLOCK_FOR_TARGET_TIME %d\n", MPV_RENDER_PARAM_BLOCK_FOR_TARGET_TIME);
      printf("RENDER_PARAM_SW_SIZE %d\n", MPV_RENDER_PARAM_SW_SIZE);
      printf("RENDER_PARAM_SW_FORMAT %d\n", MPV_RENDER_PARAM_SW_FORMAT);
      printf("RENDER_PARAM_SW_STRIDE %d\n", MPV_RENDER_PARAM_SW_STRIDE);
      printf("RENDER_PARAM_SW_POINTER %d\n", MPV_RENDER_PARAM_SW_POINTER);
      return 0;
    }
    C
    cc -I${pkgs.mpv-unwrapped.dev}/include probe.c -o probe
    ./probe > measured.txt
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # PARSED: the C side is a table the compiler wrote.
    measured = {}
    for row in pathlib.Path("measured.txt").read_text().splitlines():
        name, value = row.split()
        measured[name] = int(value)
    # FILE-WIDE: `code_of`, and the numbers are the compile-time assertions
    # and the constants; a number in a comment is prose, not a promise.
    rust = code_of(pathlib.Path("${../crates/ronoctua-player-engine/src/mpv.rs}").read_text())
    floor(len(rust), 2000, "characters of mpv.rs")
    declared = {n: int(v) for n, v in re.findall(r"size_of::<(\w+)>\(\) == (\d+)", rust)}
    declared |= {n: int(v) for n, v in re.findall(r"const (\w+): c_int = (\d+);", rust)}
    floor(len(declared), 25, "numbers mpv.rs declares")
    wrong = [f"{n}: the C compiler says {v}, the Rust says {declared.get(n)}" for n, v in sorted(measured.items()) if declared.get(n) != v]
    # AND NOTHING THE RUST DECLARES GOES UNMEASURED: a constant added to
    # mpv.rs and not to the probe is a number nobody checked.
    wrong += [f"{n} is declared in mpv.rs and the probe does not measure it" for n in sorted(set(declared) - set(measured))]
    for w in wrong:
        print(f"ERROR: {w}", file=sys.stderr)
    if wrong:
        sys.exit(1)
    print(f"OK: {len(measured)} sizes and numbers agree with libmpv's headers")
    END
  '';

  # EVERY DECODER THE PLAYER RUNS IS A PROGRAM THAT EXISTS. The table in
  # `decoders.rs` names a variable per decoder, and `nix/player-tools.nix` is
  # what sets them; a variable set by nobody is a family of formats that
  # plays nowhere, silently — the file is handed to mpv, which refuses it.
  player-decoders-exist = mkCheck "player-decoders-exist" [ pkgs.python3 ] ''
    python3 - <<'END'
    import json, os, pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # PARSED: the table is Nix turned to JSON by Nix itself.
    tools = json.loads(${
      lib.escapeShellArg (builtins.toJSON (import ../nix/player-tools.nix { inherit pkgs; }))
    })
    # FILE-WIDE: the table IS the file's point — every decoder is a row of
    # one `const`, and a variable read anywhere in it is a program the player
    # runs. `uncommented`: the variable names are string literals.
    table = uncommented(pathlib.Path("${../crates/ronoctua-player/src/decoders.rs}").read_text())
    wanted = set(re.findall(r'env: "(RONOCTUA_[A-Z0-9_]+)"', table))
    floor(len(wanted), 5, "decoders the table declares")
    # AND THE SOUNDFONT, the one path the table's arguments name besides the
    # programs (`{soundfont}`).
    wanted.add("RONOCTUA_SOUNDFONT")
    wrong = [f"`{v}` is read and `nix/player-tools.nix` does not set it" for v in sorted(wanted - set(tools))]
    for name, path in sorted(tools.items()):
        if not os.path.exists(path):
            wrong.append(f"`{name}` points at {path}, which does not exist")
    for w in wrong:
        print(f"ERROR: {w}", file=sys.stderr)
    if wrong:
        sys.exit(1)
    print(f"OK: {len(wanted)} variables, every one set to a program that exists")
    END
  '';

  # EVERY EFFECT AND EVERY PARAMETER HAS A NAME IN BOTH LANGUAGES. The keys
  # are built from the table (`camera-effect-<id>`, `camera-param-<name>`),
  # so the compiler cannot see a missing one: it would draw as `[key]`.
  camera-effects-have-text = mkCheck "camera-effects-have-text" [ pkgs.python3 ] ''
    python3 - <<'END'
    import json, pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # PARSED: the table is Nix turned to JSON by Nix itself.
    table = json.loads(${lib.escapeShellArg (builtins.toJSON (import ../assets/camera-effects.nix))})
    owed = {f"camera-effect-{e['id']}" for e in table["effects"]}
    owed |= {f"camera-param-{p['name']}" for e in table["effects"] for p in e["params"]}
    # AND THE THREE SCENES A FRESH MACHINE HAS, whose names are ids that the
    # views translate (`ronoctua_studio::scene::BUILT_IN`).
    # `uncommented`: the ids are string literals.
    studio = uncommented(pathlib.Path("${../crates/ronoctua-studio/src/scene.rs}").read_text())
    for name in re.findall(r'pub const (?:CAMERA|SCREEN|SCREEN_AND_CAMERA): &str = "([a-z-]+)";', studio):
        owed.add(f"studio-scene-{name}")
    floor(len(owed), 30, "keys the camera table owes")
    wrong = []
    for lang in ("en-GB", "pt-BR"):
        # FILE-WIDE: `hashless`, and a key is a line of the `.ftl`, and a key
        # written in a comment is not one.
        text = hashless(pathlib.Path(f"${../assets/i18n}/{lang}.ftl").read_text())
        have = set(re.findall(r"^([a-z][a-z0-9-]*) =", text, re.M))
        for k in sorted(owed - have):
            wrong.append(f"{lang} has no `{k}`")
    for w in wrong:
        print(f"ERROR: {w}", file=sys.stderr)
    if wrong:
        sys.exit(1)
    print(f"OK: {len(owed)} camera keys in both languages")
    END
  '';

  # THE STREAM KEY NEVER TRAVELS IN `argv`: every program on the machine can
  # read another's command line, and a stream key is a password to a channel.
  stream-key-is-never-an-argument = mkCheck "stream-key-is-never-an-argument" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: `uncommented`, and the needles are ffmpeg options, literals.
    body = uncommented(without_tests(pathlib.Path("${../crates/ronoctua-studio/src/outputs.rs}").read_text()))
    floor(len(body), 3000, "characters of outputs.rs")
    wrong = []
    if '"-/rtmp_playpath"' not in body:
        wrong.append("RTMP no longer reads its key from a file (`-/rtmp_playpath`)")
    if '"-/streamid"' not in body:
        wrong.append("SRT no longer reads its key from a file (`-/streamid`)")
    if "stream_key_path" not in body:
        wrong.append("the stream no longer takes the key's PATH")
    if "read_to_string(&key" in body or "fs::read(&key" in body:
        wrong.append("the stream reads the key's CONTENT, which is how it would reach argv")
    for w in wrong:
        print(f"ERROR: {w}", file=sys.stderr)
    if wrong:
        sys.exit(1)
    print("OK: the stream key reaches ffmpeg as a file, never as an argument")
    END
  '';

  one-pipewire-boundary = mkCheck "one-pipewire-boundary" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a boundary is broken by a NAME appearing anywhere outside it,
    # so the file is the question. The cut at `mod tests` is the narrowing.
    #
    # `uncommented` and never `code_of`: every name here is a string literal —
    # a program, a header, a path — and emptying the strings would leave a
    # sweep that can never find one. What the strip is for is the other half:
    # a name written in a comment is prose ABOUT the boundary, and three of
    # these files explain themselves that way.
    crates = pathlib.Path("${../crates}")
    boundary = crates / "ronoctua-audio" / "src" / "pipewire.rs"
    swept = 0
    wrong = []

    NAMES = ("pw-dump", "wpctl", "pw-cat", "RONOCTUA_PW_DUMP", "RONOCTUA_WPCTL",
             "RONOCTUA_PW_CAT")

    for f in sorted(crates.rglob("*.rs")):
        if f == boundary:
            continue
        text = f.read_text()
        # THE PRODUCT, NOT ITS TESTS — the rule `bluetooth-profiles-have-text`
        # already keeps. A test NAME (`wpctl_is_not_given_an_amplitude`) and a
        # fixture holding what a missing program prints are both the right
        # thing to write and neither is a call.
        #
        # The TRAILING module, matched with its `mod tests`, so a `cfg(test)`
        # on something else does not hide the rest of the file.
        cut = list(re.finditer(r"^#\[cfg\(test\)\]\s*\nmod tests", text, re.M))
        if cut:
            text = text[: cut[-1].start()]
        # AND COMMENTS ARE PROSE. Several files explain at length why the
        # programs live where they do, and a rule that could not tell a
        # sentence from a call would be a rule nobody could write near.
        # AND `uncommented` IS WHAT TELLS A SENTENCE FROM A CALL. It was a
        # `re.sub` over `//.*`, which cuts at a `//` inside a STRING as
        # readily as at a comment — a URL or a path would have hidden
        # everything after it on that line.
        code = uncommented(text)
        swept += 1
        for name in NAMES:
            if name in code:
                wrong.append(f"{f.relative_to(crates)} names `{name}` outside the boundary")

    floor(swept, 100, "sources of the workspace swept for a PipeWire program")
    if not boundary.exists():
        wrong.append("crates/ronoctua-audio/src/pipewire.rs is gone; what is this checking?")
    else:
        body = uncommented(boundary.read_text())
        floor(len(body), 1000, "characters of pipewire.rs")
        for name in ("pw-dump", "wpctl", "pw-cat"):
            if name not in body:
                wrong.append(f"the boundary no longer names `{name}` — has it moved?")
        opens = body.count('"--record"')
        if opens != 1:
            wrong.append(f"`--record` is built {opens} times; it has to be exactly one")

    for w in wrong:
        print(f"ERROR: {w}", file=sys.stderr)
    if wrong:
        sys.exit(1)
    print("OK: one crate, one module and one door to the microphone")
    END
  '';

  # THE VOLUME IS CONVERTED ONCE, AND IN BOTH DIRECTIONS.
  #
  # `channelVolumes` is linear amplitude and `wpctl` speaks its cube root.
  # Measured on the owner's laptop: stored 0.056895 reads back as 0.38, and
  # `set-volume 0.384614` stores 0.056895 again. A second copy of that rule, or
  # one side of it losing the root, makes every volume in the system wrong in a
  # way that reads as a miscalibrated slider — and a one-sided test still passes.
  volume-is-perceived = mkCheck "volume-is-perceived" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys

    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a second cube root anywhere in the workspace is the offence,
    # and the two functions that ARE the conversion are module-level.
    crates = pathlib.Path("${../crates}")
    lib = crates / "ronoctua-audio" / "src" / "lib.rs"
    wrong = []
    swept = 0

    body = code_of(lib.read_text())
    floor(len(body), 500, "characters of ronoctua-audio's lib.rs")
    if "pub fn perceived" not in body or "pub fn stored" not in body:
        wrong.append("`perceived` and `stored` are what the conversion IS; one of them is gone")
    if "cbrt" not in body:
        wrong.append("the cube root left `lib.rs`, which is where the boundary converts")

    # AND NOWHERE ELSE. A second `cbrt` on a volume is a second answer, free to
    # drift; the tokens crate has one for a colour, which is another thing.
    for f in sorted(crates.rglob("*.rs")):
        if f == lib or "ronoctua-tokens" in str(f):
            continue
        code = code_of(f.read_text())
        swept += 1
        if "cbrt" in code:
            wrong.append(f"{f.relative_to(crates)} takes a cube root of its own")
    floor(swept, 100, "sources of the workspace swept for a cube root")

    if "fn the_round_trip_holds" not in body:
        wrong.append("the round-trip test is gone; a one-sided one would still pass")

    for w in wrong:
        print(f"ERROR: {w}", file=sys.stderr)
    if wrong:
        sys.exit(1)
    print("OK: one conversion, both directions, one test")
    END
  '';

  # THE MEDIA KEYS COME OUT BARE, AND THEY COME OUT AT ALL.
  #
  # `nix/scripts/gen-default-binds.py` refuses the `XF86*` family by
  # construction, saying they "wait for the system to handle media keys" — and
  # for a year the system did not: measured, there was not one `XF86` string in
  # the repository, so the volume keys of every laptop running this did nothing.
  #
  # Now they are declared in `actions::media` and printed by
  # `export-scroll-binds`. Two ways for that to go silently wrong: one of them
  # comes out with the leader's PREFIX, which makes it a chord nobody would
  # guess; or the list stops being printed at all, and the keys are dead again
  # with nothing saying so.
  media-keys-are-bare =
    let
      # THE REAL OUTPUT, and not a reading of the table that produces it.
      # `nix/compositor-binds.nix` is what the compositor's config splices in, so
      # this asks the same derivation the same question — a table that is
      # right and a printer that puts a prefix on it would pass a source scan
      # and fail here.
      binds =
        (pkgs.callPackage ../nix/compositor-binds.nix {
          ronoctua-shell = rust.shell;
        }).forPrefix
          "Super";
    in
    mkCheck "media-keys-are-bare" [ pkgs.gnugrep ] ''
      # NOT `out`. `mkCheck` ends in `touch $out`, and a shell variable of that
      # name points it at the store path this reads — the check then PASSES and
      # the derivation fails on a permission error, which reads as a broken
      # check rather than a broken product.
      conf=${binds}
      failed=0

      for key in XF86AudioRaiseVolume XF86AudioLowerVolume XF86AudioMute \
                 XF86AudioMicMute XF86AudioPlay XF86AudioNext XF86AudioPrev; do
        if ! grep -qE "^bindsym( --[a-z-]+)* $key " "$conf"; then
          echo "ERROR: the media bind $key did not come out." >&2
          echo "      The key would do nothing, which is what it did before." >&2
          failed=1
        fi
        if grep -qF "Super+$key " "$conf"; then
          echo "ERROR: $key came out with the leader's prefix." >&2
          echo "      A media key held behind a leader is worse than the key alone." >&2
          failed=1
        fi
      done

      # AND THEY REACH OUR OWN COMMANDS, not the compositor's. A bind that
      # ran the wrong id would be a `warn` in a log and a dead key.
      for id in volume-up volume-down volume-mute mic-mute media-play; do
        grep -qF "command $id" "$conf" || {
          echo "ERROR: no bind runs \`$id\`." >&2
          failed=1
        }
      done

      [ "$failed" = 0 ] || exit 1
      echo "OK: seven media keys, all bare, all reaching a command"
    '';

  # THE MICROPHONE HAS ONE DOOR, AND THE DOOR HAS A GUARD.
  #
  # `pw-cat --record` is the only thing in this system that opens a recording
  # device. `one-pipewire-boundary` keeps it to one FILE; this keeps it to one
  # decision: the meter is a VALUE whose `Drop` closes the child, and it is
  # started from an order that the view sends when the cursor lands on a
  # microphone and unsends when it leaves.
  #
  # What it would catch is the guard being quietly loosened — the meter
  # becoming a flag, or the view opening one without the cursor being on it.
  the-microphone-has-one-door = mkCheck "the-microphone-has-one-door" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the `Drop` guard, the two functions and the two orders are
    # each a thing that is either in its file or not; none is a question about
    # the inside of a function.
    #
    # `uncommented` and not `code_of`: two of the needles are string literals —
    # the `--pdeathsig` flag and the variable that names `setpriv`.
    crates = pathlib.Path("${../crates}")
    meter = crates / "ronoctua-audio" / "src" / "meter.rs"
    view = crates / "ronoctua-shell" / "src" / "audio.rs"
    wrong = []

    body = uncommented(meter.read_text())
    floor(len(body), 500, "characters of meter.rs")
    # A VALUE WITH A GUARD, not a flag. Dropping it is what closes the device,
    # and that is what ties "nobody is looking" to "nothing is listening".
    if "impl Drop for Reaped" not in body:
        wrong.append("the meter's child lost its `Drop` guard; nothing closes the device")
    if "fn listen_to" not in body:
        wrong.append("`Meter::listen_to` is gone; what starts the recording now?")

    # AND THE GUARD A SIGNAL CANNOT DEFEAT. The `Drop` covers every ordinary
    # path and nothing at all covers `SIGKILL`, because nothing in the process
    # runs after one. MEASURED before this was here: the footer killed, and
    # `pw-cat` still sitting in `epoll_wait` with the microphone open, for as
    # long as the machine stayed up.
    # THE CODE, NOT THE COMMENT. Written without this strip, the rule read the
    # very paragraph above `record` that explains the death signal — so
    # deleting the argument left the check green over prose about an argument
    # that was no longer passed. It is the "a check that reads its own
    # evidence" trap, caught by sabotage.
    spawn = uncommented((crates / "ronoctua-audio" / "src" / "pipewire.rs").read_text())
    floor(len(spawn), 1000, "characters of pipewire.rs")
    if "--pdeathsig" not in spawn or "RONOCTUA_SETPRIV" not in spawn:
        wrong.append(
            "the recorder no longer runs under a death signal; a killed footer "
            "would leave a microphone open"
        )

    # AND THE VIEW DECIDES BY THE CURSOR. `listening` is answered from the row
    # the cursor is on and from nothing else.
    seen = uncommented(view.read_text())
    floor(len(seen), 1000, "characters of audio.rs")
    if "Spot::Source(id) => Some(id)" not in seen:
        wrong.append("the view no longer derives the open microphone from the cursor's row")
    if "pub const fn listening" not in seen:
        wrong.append("`View::listening` is gone; the doors would have to guess")

    # THE DOORS SEND THE ORDER, and both of them send the closing one.
    for door in ("surface.rs", "audio_window.rs"):
        text = uncommented((crates / "ronoctua-shell" / "src" / door).read_text())
        floor(len(text), 1000, "characters of " + door)
        if "Order::Listen(None)" not in text:
            wrong.append(f"{door} never closes the microphone")
        if "follow_the_microphone" not in text:
            wrong.append(f"{door} does not move the meter with the cursor")

    for w in wrong:
        print(f"ERROR: {w}", file=sys.stderr)
    if wrong:
        sys.exit(1)
    print("OK: one door, one guard, and both doors shut it")
    END
  '';

  files-runs-by-path = mkCheck "files-runs-by-path" [ pkgs.gnugrep ] ''
    src=${../crates/ronoctua-files/src}
    failed=0

    read_it=$(grep -ohE 'option_env!\("RONOCTUA_[A-Z_]+"\)' "$src"/*.rs "$src"/bin/*.rs \
      | grep -oE 'RONOCTUA_[A-Z_]+' | sort -u)
    [ -n "$read_it" ] || {
      echo "ERROR: the crate reads no variable at all — what does the grep match?" >&2
      exit 1
    }

    for v in $read_it; do
      grep -qE "^ *$v = " ${../nix/rust.nix} || {
        echo "ERROR: $v is read by the crate and is not in nix/rust.nix" >&2
        echo "      The program would fail far from the cause, with a minimal PATH." >&2
        failed=1
      }
    done

    # NO BARE NAME. A `Command::new("bsdtar")` would work in the devshell and
    # fail inside a systemd scope — the trap AGENTS.md records.
    bare=$(grep -nE 'Command::new\("[a-z]' "$src"/*.rs "$src"/bin/*.rs || true)
    [ -z "$bare" ] || {
      echo "ERROR: a program by NAME, not by path:" >&2
      echo "$bare" >&2
      failed=1
    }

    [ "$failed" = 0 ] || exit 1
    echo "OK: $(echo "$read_it" | wc -l) programs, all by store path"
  '';

  # THE PRIVILEGED DOOR IS AS NARROW AS THE CODE SAYS IT IS.
  #
  # Two directions, the same shape as `rescue-polkit-is-narrow`:
  #
  #   - the unit the crate names is the one the polkit rule allows;
  #   - the rule allows nothing else, and the verb is `start`.
  #
  # And one more, which is what this door has and the console's does not: the
  # list of VERBS. `Verb::ALL` is four, and none of them destroys anything —
  # a `remove` or a `move` slipped in there is exactly what nobody would notice
  # reviewing a diff.
  files-polkit-is-narrow =
    mkCheck "files-polkit-is-narrow"
      [
        pkgs.gnugrep
        pkgs.coreutils
      ]
      ''
        crate=${../crates/ronoctua-files/src}/act.rs
        module=${../nix/modules/files.nix}
        failed=0

        unit=$(grep -oE 'pub const UNIT: &str = "[^"]+"' "$crate" | grep -oE '"[^"]+"' | tr -d '"')
        [ -n "$unit" ] || { echo "ERROR: the crate does not name the unit" >&2; exit 1; }

        grep -qE "unit = \"$unit\"" "$module" || {
          echo "ERROR: the crate asks for '$unit' and the module does not define it" >&2
          failed=1
        }
        grep -qE 'action.lookup\("unit"\) == "\$\{unit\}"' "$module" || {
          echo "ERROR: the polkit rule does not compare the unit with the module's" >&2
          failed=1
        }
        grep -qE 'action.lookup\("verb"\) == "start"' "$module" || {
          echo "ERROR: the polkit rule does not limit the verb to 'start'" >&2
          echo "      Without that it stops, restarts and reloads anything at all." >&2
          failed=1
        }
        grep -qE 'subject.user == "\$\{user\}"' "$module" || {
          echo "ERROR: the polkit rule does not limit the user" >&2
          failed=1
        }

        # NO SECOND UNIT. A rule that names one unit and a module that declares
        # two is privilege granted to something nobody audited.
        units=$(grep -cE '^ *systemd.services.ronoctua-files' "$module" || true)
        [ "$units" = 1 ] || {
          echo "ERROR: the module declares $units privileged units; the rule names one" >&2
          failed=1
        }

        # AND THE FOUR VERBS, none of which destroys.
        for bad in '"rm"' '"remove"' '"mv"' '"move"' '"delete"' '"unlink"'; do
          grep -qE "Self::[A-Za-z]+ => $bad" "$crate" && {
            echo "ERROR: a destructive verb on the privileged door: $bad" >&2
            failed=1
          }
        done

        [ "$failed" = 0 ] || exit 1
        echo "OK: one unit ($unit), the verb start, one user, four verbs that do not delete"
      '';

  # A KEY SEQUENCE IS NEVER TEXT IN A `.ftl`.
  #
  # Two things go wrong at once when it is, and both were on screen:
  #
  #   - THE SEQUENCE GOES STALE. `notif-act-in-the-footer` used to carry
  #     `n h` as words, and it went on teaching `n h` after the key became
  #     `n n`. Its fix is the shape this check demands: the keys arrive as a
  #     `{ $keys }` argument built from a constant (`leader::NOTIF_OPEN_KEYS`).
  #   - THE WORD "LEADER" IS NOBODY'S KEY. `nix/modules/scroll.nix` sets
  #     `RONOCTUA_LEADER` to `SUPER` and `nix/dev.nix` to `CTRL ALT SPC`; that
  #     file's own comment says why two truths would be a screen saying `SPC`
  #     while the key is something else. Every surface renders `crate::leader()`
  #     — except, until this check, `power-answer-in-the-footer`, which said
  #     the literal word in both languages.
  #
  # It is about VALUES and not keys: `cmd-notif-open` may say what a command
  # does, and a value may name a key by NOTATION (`RET`, `TAB`) — what it may
  # not do is spell out a leader sequence, which is what goes stale.
  keys-are-never-text = mkCheck "keys-are-never-text" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # PROSE: this check's subject IS the prose. It reads the VALUE of every
    # sentence in the catalogue and refuses one that spells a key sequence out
    # in words, so the words are the thing being examined.
    # FILE-WIDE: a catalogue has no functions, and every line of it is read.
    wrong = []
    seen = 0
    for language in "${lib.concatStringsSep " " languages}".split():
        for line in pathlib.Path(f"${../assets/i18n}/{language}.ftl").read_text().splitlines():
            if line.startswith("#") or "=" not in line:
                continue
            key, _, value = line.partition("=")
            key, value = key.strip(), value.strip()
            if not re.fullmatch(r"[a-z0-9][a-zA-Z0-9_-]*", key):
                continue
            seen += 1
            # THE LEADER'S NAME FOLLOWED BY A SEQUENCE — a single letter, or
            # several. The bare word is allowed and has to be: the manual's
            # own section headings say "HOLDING THE LEADER" and "WHEN THE
            # LEADER DOES NOT ANSWER", which name the CONCEPT and teach no
            # key. What goes stale is `LEADER s p k`.
            if re.search(r"\b(LEADER|SPC|SUPER)\b(\s+[A-Za-z]\b)+", value):
                wrong.append(f"{language}: `{key}` spells a leader key: {value[:60]}")
    floor(seen, 1000, "values read out of the catalogue")

    if wrong:
        print("ERROR: a key sequence written as text.", file=sys.stderr)
        print("", file=sys.stderr)
        for w in wrong:
            print("       " + w, file=sys.stderr)
        print("", file=sys.stderr)
        print("       The keys are an ARGUMENT: a constant beside the binding, plus", file=sys.stderr)
        print("       `crate::leader()`, interpolated into a `{ $keys }`. A sequence", file=sys.stderr)
        print("       written here goes stale the day the key moves, and the word", file=sys.stderr)
        print("       LEADER is not a key on anybody's keyboard.", file=sys.stderr)
        raise SystemExit(1)

    print(f"OK: {seen} values, and none of them spells a key")
    END
  '';

  # EVERY KEY REACHES AN ARM THAT EXISTS.
  #
  # `leader::reachable(&tree)` is every id some key in this system can run.
  # What HANDLES an id is the `match` inside `surface::run_with`, plus the two
  # generated families (`actions::kdl_of` for the compositor's mirrored
  # actions, `actions::with_argument` for the two that carry a number).
  #
  # THE UNIT TEST BESIDE THE TABLE COMPARES AGAINST A HAND-KEPT LIST
  # (`leader::WITH_ACTION`), and its own comment says the repetition is on
  # purpose. The repetition is exactly what let `network-lan` through: the id
  # was in the registry, in the tree, in the list — and in no arm of the
  # `match`. `LEADER s n l` printed "network-lan does nothing yet" while the
  # letter `l` inside the open view worked, so the feature existed and only
  # the leader's door was dead.
  #
  # A list is a claim about the code. This reads the code.
  run-command-handles-every-key = mkCheck "run-command-handles-every-key" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    shell = pathlib.Path("${../crates/ronoctua-shell/src}")
    # FILE-WIDE: the keymap and the generated actions are module-level tables.
    # `run_with` is narrowed by name below.
    #
    # `uncommented` and never `code_of`: a command id is a string literal on
    # every one of the three sides, and emptying them would leave three empty
    # sets that agree with each other perfectly.
    surface = uncommented((shell / "surface.rs").read_text())
    keymap = uncommented((shell / "leader.rs").read_text())
    actions = uncommented((shell / "actions.rs").read_text())
    floor(len(surface), 100000, "characters of surface.rs")
    floor(len(keymap), 10000, "characters of leader.rs")
    floor(len(actions), 1000, "characters of actions.rs")

    # 1) WHAT THE `match` HANDLES. Arms are `"id" => …` and `"a" | "b" => …`,
    #    at the arm's own indentation inside `run_with`.
    # BY NAME AND BRACES. The signature was written out here, and the capture
    # ran to the next `\n    }` — which a nested block closes early, hiding
    # every arm below it and letting a key that leads nowhere pass.
    body = must(body_of(surface, "run_with"), "`run_with`")
    floor(len(body), 1000, "characters of `run_with`")
    handled = set()
    for line in body.splitlines():
        stripped = line.strip()
        head = stripped.split("=>", 1)[0] if "=>" in stripped else ""
        if not head:
            continue
        # Only a run of string literals joined by `|` is an arm's pattern; a
        # `match` on something else inside the body has no bare literals here.
        if re.fullmatch(r'(\s*"[a-z0-9-]+"\s*\|?)+', head):
            handled |= set(re.findall(r'"([a-z0-9-]+)"', head))

    floor(len(handled), 100, "arms of `run_with`")

    # 2) THE CURATED JOIN, which has no arm and does not need one.
    #
    # `actions::all_of` maps OUR id to the compositor's deed —
    # `("window-left", "wm-focus-left")` — and `run_with` dispatches the whole
    # table in ONE fall-through arm (`actions::deed_of`, then the generated
    # table) rather than in twenty-three arms.
    #
    # READING THE TABLE, and not exempting a prefix. `window-*` as a rule would
    # have gone green on the defect this check actually caught: the
    # fall-through was asking the GENERATED table with OUR id, which answers
    # `None` for every one of these, so thirteen keys drew a row and did
    # nothing. What makes the exemption honest is that it names the pairs — an
    # id that leaves `all_of` stops being exempt the same day.
    generated = set(re.findall(r'\(\s*"([a-z0-9-]+)",\s*"(?:wm-[a-z0-9-]+)"\s*\)', actions))
    floor(len(generated), 20, "pairs in `actions::all_of`")

    # 3) AND EVERY ID THE LEADER'S TREE POINTS AT.
    #
    # THE TREE AND NOT `reachable()`: `reachable` also unions the views' own
    # tables (`files-down`, `transfers-pause`), and those are answered by the
    # VIEW's key handler while it has the keyboard — not by `run_with`, which
    # they never reach. What has to have an arm here is what a LEADER SEQUENCE
    # runs, because that arrives with no view open and this `match` is the
    # only thing between it and nothing at all.
    #
    # Each row of `BINDINGS` is `("s n l", "network-lan", …)`.
    bound = set(re.findall(r'^\s*\("[^"]*", "([a-z0-9-]+)"', keymap, re.M))
    floor(len(bound), 60, "bindings in the keymap")

    gaps = sorted(bound - handled - generated)
    # A `wm-*` id is the compositor's own, reached by NAME from `LEADER :` and
    # dispatched by the same fall-through. It has no key, so it should not be
    # in `bound` at all; the filter is the belt to that brace.
    gaps = [g for g in gaps if not g.startswith("wm-")]
    if gaps:
        print("ERROR: a key that leads nowhere.", file=sys.stderr)
        print("", file=sys.stderr)
        for g in gaps:
            print(f"       `{g}` has a key and no arm in `surface::run_with`", file=sys.stderr)
        print("", file=sys.stderr)
        print("       From the leader it prints \"<id> does nothing yet\" and logs", file=sys.stderr)
        print("       a command with no registered action. The hand-kept list in", file=sys.stderr)
        print("       `leader::WITH_ACTION` cannot see this: it is a claim about", file=sys.stderr)
        print("       the code, and this reads the code.", file=sys.stderr)
        raise SystemExit(1)

    print(f"OK: {len(bound)} ids a leader sequence runs, {len(handled)} arms, no gap")
    END
  '';

  # THE FOOTER DRAWS WHAT THE KEYBOARD DRIVES.
  #
  # There are three questions about a modal view — which one gets the key,
  # which one gets the region, and which one may open — and for a long time
  # each was answered in a different place, in a different order:
  #
  #   - `Footer::view()` ranked the manual third and the notification manager
  #     last;
  #   - the key branch ranked the manager THIRD and the manual tenth;
  #   - `expansion()` ranked the theme chooser first and the clipboard fourth;
  #   - `region_is_free` asked about the file manager and nothing else.
  #
  # So clicking the bell with the power view up gave the keyboard to the
  # manager and left the power view drawn: the arrows moved a cursor nobody
  # could see, `d` forgot a notification, and `Esc` closed the invisible one.
  # A pairing question could be drawn with `y`/`n` reaching the manager
  # instead. Three reviewers found the same defect in three different views,
  # which is what a rule kept by hand in three places looks like.
  #
  # THE FIX IS STRUCTURAL, and this is what pins it: `view()` is the ONE place
  # the precedence is written, and every branch of the other two asks it. Then
  # at most one branch can match and the ORDER the branches happen to appear
  # in stops being an answer at all.
  #
  # Which is why this check is about the GUARDS and not about the order: it
  # refuses any top-level branch of the two functions that reads a view's own
  # field, and it demands that every view `view()` can return is named in both.
  the-footer-draws-what-the-keyboard-drives =
    mkCheck "the-footer-draws-what-the-keyboard-drives" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import pathlib, re, sys

        exec(open("${pyPrelude}").read())

        # FILE-WIDE: what is asked is that every view the keyboard can drive is
        # NAMED in each of four branches — a question about the whole of each
        # branch, and the branches themselves are narrowed by name below.
        #
        # STRIPPED ONCE, AT THE TOP. The rules below used to read a mixture:
        # two of them stripped and one searched the raw text, and a rule a
        # SENTENCE can satisfy is worse than no rule — writing
        # `// ViewState::Display draws through its own window` above a branch
        # that has been turned off was enough to make the view count as named
        # in both places, while the keyboard drove it and nothing drew it.
        # `uncommented` and never `code_of`: rule 4 counts the doors by the ID
        # each one passes to `region_is_free`, and those ids are STRING
        # literals — emptied, every door disappears and the floor fails on a
        # correct file. What is being refused here is a COMMENT answering for
        # the code, and taking the comments off is the whole of that.
        src = uncommented(pathlib.Path("${../crates/ronoctua-shell/src}/surface.rs").read_text())
        floor(len(src), 100000, "characters of surface.rs")
        wrong = []


        def span_of(name):
            """One method's body, as lines.

            It counted braces PER LINE and matched a whole SIGNATURE, so a
            brace inside a string ended a body early and adding a parameter
            reported that the method had gone away. `body_of` walks the
            characters and takes the bare name; the lines are what the
            indentation rule below reads.
            """
            return must(body_of(src, name), "`" + name + "`").splitlines()

        # 1) THE ORDER, from the one place it is written.
        order = re.findall(r"ViewState::([A-Z]\w*)", "\n".join(span_of("view")))
        order = [v for v in dict.fromkeys(order)]
        # NOT A FLOOR — THE ENUM ITSELF. A number written here is a number
        # that goes stale: it said twelve for two rounds after the screens'
        # view arrived, which was two views' worth of slack. And a floor could
        # never have caught the shape that actually happens, which is a
        # FIFTEENTH view added to the enum and forgotten in `view()` — the
        # sweep below iterates `order`, so a view that never enters it is
        # invisible to every rule in this check.
        declared = re.findall(
            r"^\s{4}([A-Z]\w*),",
            must(scope(src, r"enum ViewState\b"), "`enum ViewState`"),
            re.M,
        )
        missing = [v for v in declared if v not in order]
        if missing:
            wrong.append(
                "`view()` does not rank " + ", ".join(missing)
                + " — a view outside the precedence is drawn by nothing and "
                "driven by nothing, and every rule below iterates what "
                "`view()` names"
            )

        # 2) NO BRANCH READS A VIEW'S OWN FIELD.
        #
        # The fields are listed rather than inferred, because that is the list that
        # has to be maintained beside the enum, and a new view that forgets to add
        # its field here still gets caught by check 3.
        # BY NAME, AND NOT BY SPELLING. This list held one written-out
        # expression per view — `self\.display\.is_some\(\)` and so on — so it
        # matched the way the branch happened to be written that day and
        # nothing else. `if let Some(_) = self.display.as_ref()` is the
        # IDIOMATIC Rust for the same question, reads the view's own field at
        # the top level of `typed`, and no entry in the old list touched it;
        # `as_mut()` and a bare `match self.display` escaped it too.
        #
        # Naming the FIELD catches every spelling there can be, and it is also
        # the shorter list to keep beside the enum.
        FIELDS = [
            r"self\.%s\b" % name
            for name in (
                "files",
                "clipboard_open",
                "transfers",
                "manual",
                "apps",
                "network",
                "theme_chooser",
                "bluetooth",
                "power",
                "audio",
                "pointer_view",
                "display",
                "notifications_open",
                "mx",
                "leader",
            )
        ]
        # THE KEY BRANCH IS `took_a_key`, AND NOT `typed`.
        #
        # `typed` is a two-line wrapper now — take the key, then follow the
        # cursor if the page moved — and the dispatch moved down into
        # `took_a_key` on the day the scroll learned to follow a person's key.
        # This check went on reading `typed`, found not one view named inside
        # it, and reported all eighteen as missing: loud, but about the wrong
        # thing, and it would have been just as loud on a tree with nothing
        # wrong with it.
        #
        # So the DISPATCHER is named here and the wrapper is checked to still
        # reach it. A third name would otherwise be the same drift again, and
        # the next reader would be told eighteen lies instead of one truth.
        wrapper = "\n".join(span_of("typed"))
        if "self.took_a_key(event)" not in wrapper:
            wrong.append(
                "`typed` no longer hands the key to `took_a_key`, so the branch "
                "this check reads is not the one the keyboard drives"
            )

        for name, room in (
            ("took_a_key", "the key branch"),
            ("expansion", "the region"),
        ):
            lines = span_of(name)
            for n, line in enumerate(lines):
                # Top level of the method body is eight spaces; anything deeper is
                # inside a branch that has already asked.
                if len(line) - len(line.lstrip()) != 8:
                    continue
                stripped = line.strip()
                if not (stripped.startswith("if ") or stripped.startswith("} else if ")):
                    continue
                # THE ONE WRITTEN EXCEPTION, and it is in AGENTS.md: the
                # minibuffer's QUESTION is a LINE and not a region, so it is
                # deliberately outside the precedence `view()` ranks. It is
                # named here rather than left to a narrow pattern — the old
                # list spelled this field `self.mx.active()`, which let
                # `asking_for()` through by accident and would have let a real
                # second door through the same way.
                if "self.mx.asking_for()" in stripped:
                    continue
                for field in FIELDS:
                    if re.search(field, stripped):
                        wrong.append(
                            f"{room}: `{stripped[:60]}` reads a view's own field "
                            "instead of asking `view()`"
                        )

        # 3) AND EVERY VIEW IS NAMED IN BOTH.
        #
        # A view with no branch in one of them is a view that is drawn and not
        # driven, or driven and not drawn — the same defect from the other side.
        keys = "\n".join(span_of("took_a_key"))
        region = "\n".join(span_of("expansion"))
        for view in order:
            if view == "NoneOf":
                continue
            # THE LEADER IS THE TAIL, not a branch: a key that no view claimed
            # falls through to `leader.key(&tree, key)` at the end of `typed`,
            # which is what makes the sequence reachable from every view that
            # does not want the key. A branch for it would be a second door.
            if f"ViewState::{view}" not in keys and view != "Leader":
                wrong.append(f"the key branch never names ViewState::{view}")
            if f"ViewState::{view}" not in region:
                wrong.append(f"the region never names ViewState::{view}")

