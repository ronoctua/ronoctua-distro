  every-hint-key-explains-itself = mkCheck "every-hint-key-explains-itself" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: `OF_THE_*` tables are module-level, and the census is of every
    # one of them in every door. The two `means` functions and `strong_of` are
    # narrowed by name below.
    #
    # `uncommented` and never `code_of`: an id IS a string literal, and there
    # would be no ids at all to check if the strings were emptied.
    shell = pathlib.Path("${../crates/ronoctua-shell/src}")
    i18n = pathlib.Path("${../assets/i18n}")

    # BOTH SPELLINGS OF THE ROW. The tables are `&str` where the ids are only
    # read and `&'static str` where they travel on to the pointer as the id of
    # a shortcut, and a pattern that knew one of the two would silently walk
    # half of them.
    STR = r"&(?:'static )?str"
    TABLE = re.compile(
        r"pub const (OF_THE_[A-Z_]+):\s*&\[\(" + STR + r",\s*" + STR
        + r"(?:,\s*\w+)?\)\]\s*=\s*&\[(.*?)\n\];",
        re.S,
    )
    ROW = re.compile(r'\(\s*"[^"]*"\s*,\s*"([a-z0-9-]+)"')

    ids, tables = {}, []
    for f in sorted(shell.glob("*.rs")):
        for m in TABLE.finditer(uncommented(f.read_text())):
            found = ROW.findall(m.group(2))
            tables.append((f.name, m.group(1), len(found)))
            for i in found:
                ids.setdefault(i, f"{f.name}:{m.group(1)}")

    # A FLOOR, never the count: a table that stops being recognised takes the
    # sweep below it and says so, where a number equal to what was found would
    # prove nothing.
    floor(len(tables), 14, "hint tables recognised as `OF_THE_*`")

    # AND WHAT THE TWO `means` FUNCTIONS CAN ANSWER — see the header.
    # BY NAME, and by braces. The two were written out as the head of a regex
    # that then ran to the next `\n    }`, which a nested block closes early.
    MEANS = [("files.rs", "strong_meaning"), ("notifications.rs", "means")]
    answered = 0
    for name, head in MEANS:
        body = uncommented((shell / name).read_text())
        m = body_of(body, head)
        if not m:
            print(f"ERROR: {name}: the `means` function this check reads is gone;", file=sys.stderr)
            print("       the ids it can answer are no longer being covered.", file=sys.stderr)
            raise SystemExit(1)
        floor(len(m), 100, "characters of " + name + "'s `" + head + "`")
        for i in re.findall(r'"([a-z0-9-]+)"', m):
            answered += 1
            ids.setdefault(i, f"{name}:means")

    floor(answered, 10, "ids read out of the `means` functions")

    # THE IDS A `means` ALWAYS REPLACES, derived and never listed.
    #
    # `files::strong_of` is what maps a table id to a direction, and an id it
    # maps is an id the line never says on its own: `hint_of_marked` asks the
    # `means` first and always gets an answer for those four. Everything else
    # reaches the screen as itself.
    always = set(
        re.findall(
            r'"([a-z0-9-]+)"\s*=>\s*Some\(',
            must(
                body_of(uncommented((shell / "files.rs").read_text()), "strong_of"),
                "`files::strong_of`",
            ),
        )
    )
    floor(len(always), 1, "ids a `means` always replaces")

    wrong, skipped, covered = [], [], 0
    for language in ${builtins.toJSON languages}:
        text = (i18n / f"{language}.ftl").read_text()
        have = set(re.findall(r"^([a-z][a-z0-9-]*)\s*=", text, re.M))
        for i, where in sorted(ids.items()):
            if i not in have:
                # A SHORT WORD IS WHAT THE LINE DRAWS. `chrome::hint_of` asks
                # `texts.t(<id>)`, so an id with no key of that name comes out
                # as `[the-id]` — the missing-key marker, in the middle of the
                # hint. That is how this check found ten: eight of the
                # Syncthing view's ten keys, and two of the locale view's.
                if i in always:
                    skipped.append(i)
                    continue
                wrong.append(
                    f"{language}: `{i}` ({where}) has no short word, so the "
                    f"hint line draws `[{i}]`"
                )
                continue
            long = [k for k in (f"cmd-{i}", f"about-{i}") if k in have]
            if not long:
                wrong.append(
                    f"{language}: `{i}` ({where}) has neither `cmd-{i}` nor "
                    f"`about-{i}` — pointing at it explains nothing"
                )
            elif len(long) == 2:
                wrong.append(
                    f"{language}: `{i}` ({where}) has BOTH `cmd-{i}` and "
                    f"`about-{i}`; only the first is ever read"
                )
            else:
                covered += 1

    if wrong:
        print("ERROR: a shortcut on a hint line that cannot explain itself.", file=sys.stderr)
        print("", file=sys.stderr)
        for w in wrong:
            print("       " + w, file=sys.stderr)
        print("", file=sys.stderr)
        print("       `chrome::hint_sentence` reads `cmd-<id>` for a command of", file=sys.stderr)
        print("       the registry and `about-<id>` for a view's own key, and", file=sys.stderr)
        print("       draws nothing when neither is there — so a missing one is", file=sys.stderr)
        print("       a line that never appears rather than a marker on screen.", file=sys.stderr)
        raise SystemExit(1)

    print(
        f"OK: {len(tables)} hint tables, {len(ids)} ids, "
        f"{covered // max(len(${builtins.toJSON languages}), 1)} with a word and a sentence in "
        f"every language ({len(set(skipped))} never said on their own)"
    )
    END
  '';

  # NO TWO LABELS OF ONE VIEW SAY THE SAME THING.
  #
  # THE DEFECT, read off the screen: *"há duas labels com nome `tailnet` e
  # duas `address`, nada específicas e beginner friendly"*. There were THREE
  # `tailnet`s — the section's title, the machine's state on it and the
  # tailnet's own name — and THREE `address`es: this machine's, its address on
  # the tailnet, and the one a VPN file would hand it. Each of the three was a
  # different fact wearing the same word, in a list where the word is the only
  # thing telling you which fact you are looking at.
  #
  # WHY A CHECK AND NOT CARE. Because a label is added by whoever adds the row,
  # months apart, and the collision is only visible when the two rows happen to
  # be on screen together. Nothing else in this tree can see it: `i18n-complete`
  # asks whether a key HAS a value, never whether two keys have the same one.
  #
  # SCOPED PER VIEW, and that is the whole rule: two views may both say `on`,
  # and they do. What may not happen is one list saying the same word twice.
  # THE CURSOR IS A COLOUR, because nothing else in this system draws it.
  #
  # `files::Row` has a `focused` field, every view fills it in, and NO DOOR
  # READS IT: neither the footer nor any window paints a band behind the
  # cursor. So a view that sets the flag and stops has drawn a screen on which
  # no line says the keyboard is on it — which is what the owner reported about
  # `LEADER s h`. The sync section of `LEADER c` had the same, and writing this
  # found a third in `LEADER t t`, where the job's name was `text.primary`
  # whether the keys were about it or not.
  #
  # # What it demands, and why in two clauses
  #
  # A view is swept when one of its `files::Row`s carries a LIVE `focused` — a
  # bound name, an expression, or the field's shorthand — and skipped when every
  # one is the literal `false`. `theme_chooser.rs` is the only one skipped, and
  # correctly: its two lists are drawn by `surface.rs`, which holds the cursor.
  #
  # A swept view passes by naming `TEXT_HERE_ACTS` or `TEXT_HERE_READ`. Those
  # two exist for one purpose — `colors.nix` calls the family `text.here`, "the
  # keyboard is here" — so naming one is already the whole statement, and
  # nothing else in this tree has a reason to. Being a whole-module test is
  # what lets the colour live in a HELPER: `history::View::accent` sits thirty
  # lines from the `if focused` that calls it, and a first version of this
  # measured in LINES failed the very fix it was written for.
  #
  # IT USED TO ACCEPT A SECOND SHAPE — `state.accent` in a function that also
  # said "cursor" — because `notifications.rs` painted BOTH halves of its rows
  # with the accent. That is the shape `network.rs` left behind, and the reason
  # is in its comment: a door and a fact become one row at the very moment the
  # cursor is on them. The owner asked for it to be fixed rather than tolerated,
  # so the clause is gone and the check is the stronger for it: a loophole any
  # view could fall into became a rule with one exception, named below.
  #
  # # The one exception, and it proves itself
  #
  # `files.rs` draws no cursor colour and is right not to: the manager's cursor
  # is a BAND (`surface.selection`) with the focused panel's rule lit
  # (`chrome::divider_lit`), which is the arrangement AGENTS.md records and the
  # only one of the thirteen that has it. An exception nobody rechecks is a
  # hole, so this one is not a name on a list — the check goes and READS the
  # two doors that draw the manager, and fails if the band or the lit rule has
  # gone. Then the exception would be a view with no cursor at all, wearing a
  # reason that stopped being true.
  #
  # # What it does not catch
  #
  # A view that names `text.here` somewhere and paints the wrong row with it.
  # Making that exact would mean building each view's rows twice and comparing
  # the fields — thirteen constructors of glue. This is the cheap half, and
  # what it catches is a view with NO cursor colour anywhere, which has now
  # happened three times.
  the-cursor-is-a-colour = mkCheck "the-cursor-is-a-colour" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    shell = pathlib.Path("${../crates/ronoctua-shell/src}")

    # THE VIEWS ARE FOUND BY THEIR `struct View`, never by a list typed here.
    # `labels-of-a-view-are-distinct` scanned a hand-written six while eight
    # existed, and the two it never opened were the two with the defect.
    # FILE-WIDE: a view is a FILE here — the census is "every source with a
    # `struct View`" — and the colour it names may be named anywhere in it.
    # The cut at `mod tests` is the narrowing.
    VIEWS = sorted(
        f.name
        for f in shell.glob("*.rs")
        if re.search(r"^(?:pub )?struct View\b", code_of(f.read_text()), re.M)
    )
    floor(len(VIEWS), 12, "views found by their `struct View`")

    HERE = re.compile(r"\bTEXT_HERE_[A-Z]+\b")

    # THE MANAGER'S CURSOR IS A BAND, and this is where that is re-measured.
    # `files.rs` is excused from naming a colour only for as long as its two
    # doors go on drawing one.
    BAND = "SURFACE_SELECTION"
    LIT = "divider_lit"
    EXCUSED = {
        "files.rs": ("files_window.rs", "surface.rs"),
    }
    # A `focused` field that is not the literal `false`: `focused,` (shorthand),
    # `focused: here`, `focused: n == at`. THE SHORTHAND IS NOT A DETAIL — both
    # views the owner reported use it, so a pattern that wanted a colon would
    # have swept every view except the two that were broken.
    LIVE = re.compile(r"focused\s*(?:,|:\s*(?!false\b))")

    # AND A VIEW THAT DRAWS `label: value` ROWS IS SWEPT WHETHER OR NOT IT
    # KEEPS THE FLAG.
    #
    # `Row::focused` is read by no door, so a view can do the right thing —
    # colour the row — and never fill it; `geo.rs` is written that way, and it
    # fell straight through this sweep into the "carries none" bucket. The flag
    # was the only thing being looked for, so the hole is exactly the shape of
    # a view that skipped it: one with rows, a cursor, and no colour saying
    # where it is. `chrome::field_pair` is what such a view calls to draw a row
    # at all, and every view in this system that calls it names a cursor colour
    # today — so requiring it costs nothing and closes the hole.
    PAIRS = "chrome::field_pair("

    wrong, swept, skipped = [], [], []
    for name in VIEWS:
        body = code_of((shell / name).read_text())
        # THE TRAILING TEST MODULE IS NOT THE SCREEN. A colour named in an
        # assertion is a thing the test says, not a thing the view draws.
        cut = re.search(r"^#\[cfg\(test\)\]\s*\nmod tests", body, re.M)
        code = body[: cut.start()] if cut else body
        if not LIVE.search(code) and PAIRS not in code:
            skipped.append(name)
            continue
        swept.append(name)
        if HERE.search(code):
            continue
        if name in EXCUSED:
            # THE REASON IS RE-MEASURED, never taken on trust. If the band and
            # the lit rule have gone, the excuse has gone with them.
            for door in EXCUSED[name]:
                said = code_of((shell / door).read_text())
                for mark in (BAND, LIT):
                    if mark not in said:
