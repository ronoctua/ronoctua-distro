        # which is one keystroke and reads like tidiness. For one round
        # `followed` dropped what `resized` answered and every door went on
        # laying out against the size it had before the scale changed; the
        # check could not see it, because the throw-away was in `hidpi.rs` and
        # this sweep only reads files with a `CompositorHandler`.
        if "let _ = crate::hidpi::" in body:
            wrong.append(
                f"{f.name}: throws away what `hidpi` answered; what the buffer "
                "can show is the number the door has to keep"
            )

        # AND EACH HALF IS HANDED THE COMPOSITOR'S SIZE, never the door's kept
        # one. `resized` ANSWERS what the buffer can show, so feeding its own
        # answer back in is a ratchet: a window clamped once at scale 3 asks
        # for the size it was cut down to and can never grow back. The
        # compositor's number is what the door keeps in `asked`.
        for call in ("hidpi::resized(", "hidpi::followed("):
            at = 0
            while (at := body.find(call, at)) != -1:
                span = shut_at(body, at + len(call))
                # AND `asked` IS NOT JUST A NAME. `let asked = (self.width,
                # self.height);` above the call satisfies "the token is in the
                # span" while handing over exactly what the field exists to
                # keep out.
                if "asked" not in span or any(
                    v in span for v in ("self.width", "self.height", "shown")
                ):
                    wrong.append(
                        f"{f.name}: `{call}…)` is not given the size the "
                        "COMPOSITOR configured (`asked`); its own answer fed "
                        "back in is a size that can only ever shrink"
                    )
                at += len(call)

        # AND THE SCALE PATH KEEPS THE ANSWER AND COUNTS AGAIN. A door that
        # follows the scale and leaves its size alone is the round-3 defect
        # exactly: on a clamped buffer the scale is what moves the number of
        # columns, and a window dragged between two monitors gets no
        # `configure` to repair it.
        scaled = span_of(body, "scale_factor_changed")
        if scaled:
            # AND WHAT IS KEPT IS THE ANSWER, by the NAMES the `Some((…))`
            # bound. `.width =` alone passes `self.width = self.asked.0`,
            # which throws the answer away exactly as the round-3 defect did
            # and reads like tidiness.
            bound = re.search(r"Some\(\(\s*([A-Za-z_]\w*)\s*,\s*([A-Za-z_]\w*)\s*\)\)", scaled)
            if not bound:
                wrong.append(
                    f"{f.name}: `scale_factor_changed` does not take the size "
                    "`followed` answers"
                )
            elif (
                f".width = {bound.group(1)};" not in scaled
                or f".height = {bound.group(2)};" not in scaled
            ):
                wrong.append(
                    f"{f.name}: `scale_factor_changed` does not keep what the "
                    "buffer can show, so a clamped door lays out in a space it "
                    "does not have"
                )
            # AND IT RE-DERIVES WHAT IT DREW FROM THE OLD SIZE. EIGHT doors
            # `recount`; the buffer host asks its COMPONENT again
            # (`request_redraw`), and the footer redraws (`draw`) — three verbs
            # for one rule, and the rule is that a repaint of the list you
            # already have is not enough. This is NOT gated on the door having
            # a `recount`, which is how the one door without one went a whole
            # round with only a `paint()`.
            #
            # `request_redraw()` IS SPELLED OUT, not left to `draw()` matching
            # inside it: the check passed the buffer host for the wrong reason
            # for a round, because `"draw()"` is a substring of it — so the
            # verb the comment named was not the verb that matched.
            # AND `ask_paint()` IS ONE OF THEM. It is the one-frame model's
            # verb: it marks a frame OWED, and the loop's callback settles the
            # debt with `re_render()` and then `paint()`. So it says the same
            # thing as `re_render()` here, deferred by exactly one turn of the
            # queue — and `one-frame-model` is what keeps that true, by
            # refusing a door with `ask_paint` and no `settle`.
            if not any(
                v in scaled
                for v in (
                    "recount()",
                    "re_render()",
                    "request_redraw()",
                    "ask_paint()",
                    "self.draw()",
                )
            ):
                wrong.append(
                    f"{f.name}: `scale_factor_changed` keeps a new size and "
                    "draws what it had, so the columns are the ones taken for "
                    "the size before it"
                )
        # AND SO DOES THE CONSTRUCTOR. `Gpu::new` clamps too, and `configure`
        # counts the columns before there is a GPU to clamp anything.
        built = span_of(body, "assemble_gpu") or span_of(body, "ensure_gpu")
        if built and "fn recount" in body and "recount()" not in built:
            wrong.append(
                f"{f.name}: the GPU is assembled and the columns are not "
                "counted again, though the first buffer can come back smaller "
                "than the window asked for"
            )

        # `physical` AT THE CONSTRUCTOR IS RIGHT, and is not tested for:
        # `Gpu::new` needs a size before there is a `Gpu` to hand `resized`,
        # and `resized` runs immediately afterwards to cut and to answer. What
        # is tested is that the second call is there at all, just above.

        # AND THE TEXT GETS THE PHYSICAL VIEWPORT, which is the other half of
        # the unit question and the one nothing asked for. A door handing
        # `text.prepare` the logical pair draws every glyph at logical size
        # into a physical buffer — half-size text in the top-left quarter,
        # which `Text::new`'s own doc calls the worse-than-blur failure.
        # EVERY OCCURRENCE, not the first. `find` answered the first one and
        # nothing else; no door has two today, and the day one grows a second
        # the rule stops working with no sign.
        at = 0
        while (at := body.find("text.prepare(", at)) != -1:
            span = shut_at(body, at + len("text.prepare("))
            # BOTH DIMENSIONS, IN ORDER. `"gpu.config." in span` was satisfied
            # by handing the two the other way round, which draws the picture
            # transposed into a viewport of the wrong shape.
            if "gpu.config.width" not in span or "gpu.config.height" not in span:
                wrong.append(
                    f"{f.name}: `text.prepare(…)` is not given the PHYSICAL "
                    "viewport, so the glyphs are placed in the window's space "
                    "and drawn into the buffer's"
                )
            elif span.index("gpu.config.width") > span.index("gpu.config.height"):
                wrong.append(
                    f"{f.name}: `text.prepare(…)` is given its height where the "
                    "width goes"
                )
            at += len("text.prepare(")

        # AND THE UNITS ARE NOT MIXED. The rectangles and the pictures are
        # measured in the window's own pixels; the text is placed in the
        # buffer's. Handing the PHYSICAL viewport to `Quads::prepare` or
        # `Images::prepare` puts the scrollbar at a fraction of its place on a
        # screen the compositor scales — the defect the design is about, and
        # one the string tests above cannot see.
        # BY THE TYPE, NOT BY THE LOCAL'S NAME.
        #
        # This list was two literal spellings, `q.prepare(` and `im.prepare(`,
        # so a door whose renderer locals are called anything else got ZERO
        # coverage of the rule the whole HiDPI design is about — and a NEW door
        # is unchecked from birth, with the `doors < 10` floor still satisfied.
        # Rename one local and the scrollbar may land at a fraction of its
        # place on every scaled screen with nothing to say so.
        #
        # EVERY `.prepare(` EXCEPT THE TEXT'S. Guessing the local's name from
        # its binding was the second version of this and it was still a guess:
        # `let Some(quads) = self.quads.as_mut()` matches no pattern for a
        # TYPE, so the rename still escaped. There are exactly two kinds of
        # `prepare` in a door — the text's, which is measured in the buffer's
        # own pixels and has its own rules above, and everything else, which is
        # measured in the window's. So scan everything else, whatever it is
        # called, and the rule covers a door nobody has written yet.
        calls = sorted(
            {m.group(1) + ".prepare(" for m in re.finditer(r"\b(\w+)\.prepare\(", body)}
            - {"text.prepare("}
        )
        for call in calls:
            at = 0
            while (at := body.find(call, at)) != -1:
                span = shut_at(body, at + len(call))
                if "gpu.config." in span:
                    wrong.append(
                        f"{f.name}: `{call}…)` is given the PHYSICAL viewport; "
                        "a `Quad` and an `Area` are in the window's own pixels"
                    )
                # THE DOOR'S OWN TWO NUMBERS, which since `resized` answers
                # what the buffer can show ARE the right ones — `self.width`
                # and `self.height` are no longer the compositor's unclamped
                # size. What is refused is a literal or an expression, which is
                # a third number nobody keeps.
                names = [n for n in ("logical_w", "logical_h", "width", "height") if n in span]
                if not names:
                    wrong.append(
                        f"{f.name}: `{call}…)`'s viewport is a literal or an "
                        "expression, not the size the door keeps"
                    )
                at += len(call)

        # AND THE SHAPER IS BUILT WITH THE SCALE. `Text::new` takes it, so a
        # door that leaves it out does not compile — but a door can still hand
        # it a literal, and a scale that arrived before the shaper existed is
        # then never applied: `followed` short-circuits on the same factor for
        # ever after, and the window draws half-size text in its top-left
        # quarter. What has to be there is the FIELD.
        # THE CALL'S OWN SPAN, matched by parentheses. Every door writes
        # `match … Text::new(…) {`, so the call closes with `) {` and never
        # with `);` — a scan that looked for `");"` ran on past it by up to
        # nine hundred characters, into code that happens to contain the word
        # it was looking for. `surface.rs` carries `tailscale` twice.
        at = 0
        while (at := body.find("Text::new(", at)) != -1:
            if "scale" not in shut_at(body, at + len("Text::new(")):
                wrong.append(
                    f"{f.name}: `Text::new(…)` is not given this door's `scale`, "
                    "so a scale that arrived before the shaper is never applied"
                )
            at += len("Text::new(")

        # AND `told_before_present` IS INSIDE THE FRAME. Anywhere else and it
        # is decorative: `set_buffer_scale` is double-buffered, so sent outside
        # the commit that carries the buffer it waits for whichever bare commit
        # comes next — which is the whole of why `Gpu::frame` grew a hook.
        at = 0
        while (at := body.find("gpu.frame(", at)) != -1:
            if "told_before_present" not in shut_at(body, at + len("gpu.frame(")):
                wrong.append(
                    f"{f.name}: `told_before_present` is not inside the "
                    "`gpu.frame(…)` call, so the scale does not travel in the "
                    "commit that carries the buffer"
                )
            at += len("gpu.frame(")

    # AND THE MODULE ITSELF IS READ. The sweep above skips any file without a
    # `CompositorHandler`, which is every file but the doors — so `hidpi.rs`,
    # the one place the rule actually lives, was the one file the check never
    # opened. That is where the round-3 defect sat: `followed` called `resized`
    # and dropped the answer, and ten doors that each passed every rule above
    # went on drawing against a size the buffer no longer had.
    rule = shell / "hidpi.rs"
    if not rule.is_file():
        wrong.append("hidpi.rs is not there; the rule has no one place")
    else:
        text = code_of(rule.read_text())
        # THE ANSWER TRAVELS. A `bool` cannot carry the number, and while it
        # was one the number could not be kept.
        if "-> Option<(u32, u32)>" not in text:
            wrong.append("hidpi.rs: `followed` does not answer a size")
        for half in ("pub fn resized", "pub fn followed"):
            at = text.find(half)
            if at == -1 or "#[must_use]" not in text[max(0, at - 200) : at]:
                wrong.append(
                    f"hidpi.rs: `{half}` is not `#[must_use]`; dropping what it "
                    "answers is then a silent line rather than a build error"
                )
        # AND `followed` RESIZES AT ALL.
        #
        # This rule is first because without it the two below are decoration:
        # they say the answer must not be dropped and the call must not be in
        # statement position, and BOTH are satisfied by a `followed` that never
        # calls `resized` — `Some(_) => asked` compiles, keeps every
        # `#[must_use]` happy, and leaves the door laying out against the size
        # it had before the scale changed. That is the whole defect this module
        # exists for, passing every rule written about it.
        inside = span_of(text, "followed")
        if "resized(" not in inside:
            wrong.append(
                "hidpi.rs: `followed` never calls `resized`; it then answers a "
                "size nothing recomputed, which is the defect the module exists "
                "to make impossible"
            )
        # AND `followed` KEEPS WHAT `resized` ANSWERS. A call in statement
        # position is one whose answer goes nowhere — which is exactly how the
        # defect was written, and `#[must_use]` on `resized` is what makes it
        # impossible to write again inside this file.
        for line in inside.splitlines():
            if re.match(r"\s*resized\(", line):
                wrong.append(
                    "hidpi.rs: `followed` calls `resized` and keeps nothing; the "
                    "door then lays out against the size it had before the scale "
                    "changed"
                )
        # AND THE BOUND IS NOT WRITTEN HERE. It is
        # `ronoctua_render::MOST_SCALE`, which `render-png --scale` reads too.
        if "MOST_SCALE" not in text:
            wrong.append("hidpi.rs: the scale bound is written here instead of read")

    # AND THE CHECK ITSELF IS NOT VACUOUS: it has to have found the doors.
    # TEN, and it is a FLOOR rather than the count: an eleventh door is
    # checked like the rest, and a door that loses its `CompositorHandler`
    # takes the sweep below the number and says so. It was nine, which is the
    # count from before the screens grew a window of their own.
    floor(doors, 10, "compositor handlers found")

    if wrong:
        print("ERROR: a door that does not know how sharp its screen is.", file=sys.stderr)
        print("", file=sys.stderr)
        for w in wrong:
            print("       " + w, file=sys.stderr)
        print("", file=sys.stderr)
        print("       Three things have to agree or the compositor stretches the", file=sys.stderr)
        print("       buffer: what the surface says its scale is, how big the", file=sys.stderr)
        print("       buffer is, and how big the glyphs in it are — and the", file=sys.stderr)
        print("       first of them has to travel in the commit that carries", file=sys.stderr)
        print("       the buffer. `crate::hidpi` is where each half lives, and", file=sys.stderr)
        print("       a door calls them and works out nothing of its own.", file=sys.stderr)
        raise SystemExit(1)

    print(f"OK: {doors} doors, and every one of them follows its screen's scale")
    END
  '';

  # EVERY DOOR HEARS EVERY CURSOR.
  #
  # A cursor is a SEAT (`ronoctua-pointers` puts every pointing device on
  # one), and a Wayland client is offered every seat. Every door of this shell
  # used to keep ONE pointer — `if cap == Capability::Pointer &&
  # self.pointer.is_none()` — so a second mouse moved a cursor that no window
  # of ours answered: no hover, no click. The owner measured exactly that.
  #
  # So a door that takes pointers takes them through `crate::seats`: it hands
  # each one to `Seats::took`, and its frame starts with `switch_to`, which is
  # what keeps one cursor's drag, hover and wheel out of another's.
  every-door-hears-every-seat = mkCheck "every-door-hears-every-seat" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a door is a file, and the question is whether ANY pointer it
    # is offered is dropped — about the file, not one function. The frame is
    # narrowed with `body_of`, because `switch_to` has to be where the events
    # are handled and not merely somewhere in the file.
    wrong = []
    doors = 0
    for path in sorted(pathlib.Path("${../crates/ronoctua-shell/src}").glob("*.rs")):
        code = code_of(without_tests(path.read_text()))
        if not re.search(r"impl SeatHandler for \w+", code):
            continue
        if "Capability::Pointer" not in code:
            continue  # a door with no pointer at all — the terminal
        doors += 1
        name = path.name
        if re.search(r"\bpointer\s*:\s*Option<\s*wl_pointer::WlPointer\s*>", code):
            wrong.append(f"{name}: keeps ONE pointer (`pointer: Option<WlPointer>`)")
        # The branch that takes a pointer asks WHAT was offered and nothing
        # else: any second clause — `self.pointer.is_none()` was the old one —
        # is a condition under which a cursor is dropped.
        for cond in re.findall(r"\bif\s+([^{]*Capability::Pointer[^{]*)\{", code):
            if not re.fullmatch(r"\s*\w+\s*==\s*Capability::Pointer\s*", cond):
                wrong.append(f"{name}: takes a pointer only when `{cond.strip()}`")
        if ".took(&seat" not in code:
            wrong.append(f"{name}: never hands a pointer to `Seats::took`")
        frame = body_of(code, "pointer_frame")
        if frame is None or "switch_to(" not in frame:
            wrong.append(f"{name}: its `pointer_frame` does not start from `switch_to`")
    floor(doors, 15, "doors that take pointers")
    if wrong:
        print("ERROR: a door that drops a cursor:", file=sys.stderr)
        for w in wrong:
            print("  " + w, file=sys.stderr)
        print("      Every pointer goes through `crate::seats`, or a second mouse", file=sys.stderr)
        print("      moves a cursor this window does not answer.", file=sys.stderr)
        sys.exit(1)
    print(f"OK: {doors} doors, and every one hears every cursor")
    END
  '';

  # EVERY DOOR TAKES EVERY KEYBOARD, the keyboard twin of the check above.
  #
  # In Independent mode every keyboard is its own seat, on its cursor's; a
  # door that took only the first keyboard it was offered answered one person
  # and dropped the rest — measured in the VM: a second keyboard on cursor 4's
  # seat typed into a terminal of ours and nothing arrived.
  every-door-hears-every-keyboard = mkCheck "every-door-hears-every-keyboard" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a door is a file, and the question is whether ANY keyboard it
    # is offered is dropped. The handlers are narrowed with `body_of`, because
    # the switch has to be where the events are handled.
    wrong = []
    doors = 0
    for path in sorted(pathlib.Path("${../crates/ronoctua-shell/src}").glob("*.rs")):
        code = code_of(without_tests(path.read_text()))
        if not re.search(r"impl KeyboardHandler for \w+", code):
            continue
        doors += 1
        name = path.name
        if re.search(r"\bkeyboard\s*:\s*Option<\s*wl_keyboard::WlKeyboard\s*>", code):
            wrong.append(f"{name}: keeps ONE keyboard (`keyboard: Option<WlKeyboard>`)")
        # `(?<!::)`: the SEAT's capability, never `ronoctua_protocol::Capability`,
        # which is a buffer's and has nothing to do with a keyboard device.
        for cond in re.findall(r"\bif\s+([^{]*(?<!::)Capability::Keyboard[^{]*)\{", code):
            if not re.fullmatch(r"\s*\w+\s*==\s*Capability::Keyboard\s*", cond):
                wrong.append(f"{name}: takes a keyboard only when `{cond.strip()}`")
        if not re.search(r"\.\w+\.took\(&seat,\s*k\b", code):
            wrong.append(f"{name}: never hands a keyboard to `Seats::took`")
        start = code.index("impl KeyboardHandler for")
        handler = code[start:]
        for fn in ("enter", "leave", "press_key", "release_key", "update_modifiers"):
            body = body_of(handler, fn)
            if body is None or "switch_to(" not in body:
                wrong.append(f"{name}: its `{fn}` does not start from the keyboard that spoke")
    floor(doors, 17, "doors that take keyboards")
    if wrong:
        print("ERROR: a door that drops a keyboard:", file=sys.stderr)
        for w in wrong:
            print("  " + w, file=sys.stderr)
        print("      Every keyboard goes through `crate::seats`, or a second keyboard", file=sys.stderr)
        print("      types into a window that does not listen to it.", file=sys.stderr)
        sys.exit(1)
    print(f"OK: {doors} doors, and every one hears every keyboard")
    END
  '';

  # THE KEYS DAEMON'S RULE IS AS NARROW AS TOR'S: two units — keyd and the
  # remapper the mode switch trades it for —, `start` and `stop`, one user,
  # and `YES`, because nothing in this session may ask.
  keys-polkit-is-narrow =
    let
      rules = self.nixosConfigurations.vm.config.security.polkit.extraConfig;
    in
    mkCheck "keys-polkit-is-narrow" [ pkgs.python3 ] ''
      export RONOCTUA_USER=${self.nixosConfigurations.vm.config.ronoctua.user}
      cat > rules.js <<'RULES'
      ${rules}
      RULES
      python3 - <<'END'
      import os, re, sys

      user = os.environ["RONOCTUA_USER"]
      text = open("rules.js").read()
      wrong = []
      rules = re.split(r"polkit\.addRule", text)[1:]
      ours = [r for r in rules if "ronoctua-keys.service" in r]
      if len(ours) != 1:
          wrong.append(f"{len(ours)} rules mention ronoctua-keys.service; there may be one")
      for rule in ours:
          if set(re.findall(r"polkit\.Result\.(\w+)", rule)) != {"YES"}:
              wrong.append("the rule answers something other than YES")
          if set(re.findall(r'action\.id\s*==\s*"([^"]+)"', rule)) != {"org.freedesktop.systemd1.manage-units"}:
              wrong.append("the rule is about another action")
          units = set(re.findall(r'lookup\("unit"\)\s*==\s*"([^"]+)"', rule))
          if units != {"keyd.service", "ronoctua-keys.service"}:
              wrong.append(f"the rule names the units {sorted(units)}")
          verbs = set(re.findall(r'lookup\("verb"\)\s*==\s*"([^"]+)"', rule))
          if verbs != {"start", "stop"}:
              wrong.append(f"the rule allows the verbs {sorted(verbs)}")
          if set(re.findall(r'subject\.user\s*==\s*"([^"]+)"', rule)) != {user}:
              wrong.append("the rule is for another user")
          body = re.search(r"if\s*\((.*?)\)\s*\{", rule, re.S)
          left = body.group(1) if body else "?"
          for known in (
              r'action\.id\s*==\s*"[^"]+"',
              r'action\.lookup\("verb"\)\s*==\s*"[^"]+"',
              r'action\.lookup\("unit"\)\s*==\s*"[^"]+"',
              r'subject\.user\s*==\s*"[^"]+"',
          ):
              left = re.sub(known, "", left)
          leftover = re.sub(r"[\s()&|]", "", left)
          if leftover:
              wrong.append(f"the condition tests something else as well: {leftover!r}")
      if wrong:
          print("ERROR: the keyboard mode's polkit rule is not narrow:", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: one rule, keyd and ronoctua-keys, start and stop, {user}, and YES")
      END
    '';

  # ONE CRATE OPENS THE KERNEL'S INPUT DEVICES: `ronoctua-keys`, which grabs a
  # keyboard and makes its twin. A second place that read `/dev/input` would
  # be a keylogger nobody audited; one that wrote `/dev/uinput` could type as
  # anybody.
  # THE VIRTUAL KEYBOARD HAS ONE DOOR. `zwp_virtual_keyboard_v1` is the
  # owner's approved exception to invariant 3 (2026-09-25), and an exception
  # is only one while it stays where it was approved: the on-screen keyboard's
  # `virtual_keys.rs`. A second file making keys appear in other people's
  # windows is a second thing nobody reviewed.
  one-virtual-keyboard = mkCheck "one-virtual-keyboard" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: whether ANY other file names the protocol, anywhere in it.
    # `code_of` because the needle is a path in CODE; the prose around the
    # exception (AGENTS.md, a comment) is allowed to say its name.
    crates = pathlib.Path("${../crates}")
    wrong, looked = [], 0
    for path in sorted(crates.rglob("*.rs")):
        looked += 1
        if path.name == "virtual_keys.rs" and "ronoctua-shell" in path.parts:
            continue
        if "zwp_virtual_keyboard" in code_of(path.read_text()):
            wrong.append(str(path.relative_to(crates)))
    floor(looked, 300, "Rust files read")
    door = code_of(pathlib.Path("${../crates/ronoctua-shell/src}/virtual_keys.rs").read_text())
    if "create_virtual_keyboard" not in door:
        print("ERROR: virtual_keys.rs no longer makes the keyboard where this looks", file=sys.stderr)
        sys.exit(1)
    if wrong:
        print("ERROR: a file other than ronoctua-shell/src/virtual_keys.rs names the virtual keyboard:", file=sys.stderr)
        for w in wrong:
            print("       " + w, file=sys.stderr)
        sys.exit(1)
    print("OK: only virtual_keys.rs types into other windows")
    END
  '';

  one-input-device-boundary = mkCheck "one-input-device-boundary" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the question is whether ANY file outside the crate names an
    # input device, anywhere in it. `uncommented` because the needles ARE
    # literals: a path, an ioctl's name.
    crates = pathlib.Path("${../crates}")
    wrong, looked = [], 0
    for path in sorted(crates.rglob("*.rs")):
        looked += 1
        text = uncommented(path.read_text())
        if "ronoctua-keys" in path.parts:
            continue
        for needle in ("/dev/uinput", "/dev/input/", "EVIOCGRAB", "UI_DEV_CREATE"):
            if needle in text:
                wrong.append(f"{path.relative_to(crates)} names {needle}")
    floor(looked, 300, "Rust files read")
    keys = uncommented(pathlib.Path("${../crates/ronoctua-keys/src}/device.rs").read_text())
    if "EVIOCGRAB" not in keys:
        print("ERROR: ronoctua-keys no longer grabs a keyboard where this looks", file=sys.stderr)
        sys.exit(1)
    if wrong:
        print("ERROR: a crate other than ronoctua-keys touches an input device:", file=sys.stderr)
        for w in wrong:
            print("       " + w, file=sys.stderr)
        sys.exit(1)
    print("OK: only ronoctua-keys opens /dev/input and /dev/uinput")
    END
  '';

  # EVERY KEYBOARD OF THE REMAPPER CARRIES THE LEADER, the sibling of
  # `keyd-rules-carry-the-leader`: in Independent mode each keyboard has a
  # leader key of its own, and a keyboard without one is a keyboard that
  # cannot open anything.
  keys-rules-carry-the-leader = mkCheck "keys-rules-carry-the-leader" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, sys
    exec(open("${pyPrelude}").read())

    src = pathlib.Path("${../crates/ronoctua-keys/src}")
    engine = code_of(without_tests((src / "engine.rs").read_text()))
    config = code_of(without_tests((src / "config.rs").read_text()))
    floor(len(engine), 2000, "characters of the engine")
    floor(len(config), 1000, "characters of the config")
    new = body_of(engine, "new")
    wrong = []
    if new is None or "ronoctua_keyboards::LEADER.1" not in new:
        wrong.append("`Engine::new` does not install the leader's rule")
    # THE LEADER GOES IN FIRST, so a remap of its key — which somebody chose —
    # still wins, as it does in keyd's files.
    elif new.index("ronoctua_keyboards::LEADER.1") > new.index("remaps"):
        wrong.append("`Engine::new` installs the leader after the remaps")
    rules_of = body_of(config, "rules_of")
    if rules_of is None or "ronoctua_keyboards::LEADER.0" not in rules_of:
        wrong.append("a unit nobody named does not take the distro's leader key")
    render = body_of(config, "render")
    if render is None or "unit_leader" not in render:
        wrong.append("`render` does not give every unit its leader key")
    if wrong:
        print("ERROR: a keyboard of the remapper could come up without a leader:", file=sys.stderr)
        for w in wrong:
            print("       " + w, file=sys.stderr)
        sys.exit(1)
    print("OK: every keyboard the remapper holds has a leader")
    END
  '';

  every-window-repeats = mkCheck "every-window-repeats" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a door asks for its keyboard wherever it builds its seat, and
    # the question is whether the call is in the file at all. The strip is what
    # stops a comment ABOUT `get_keyboard_with_repeat` — and the two excused
    # doors have one — from answering for the call.
    shell = pathlib.Path("${../crates/ronoctua-shell/src}")
    # TWO DOORS ARE EXCUSED, AND EACH ONE PROVES ITS OWN EXCUSE.
    #
    # A name on a list is a hole: the reason stops being true and nobody
    # rechecks it. `the-cursor-is-a-colour` makes the same argument about the
    # file manager and re-measures its excuse rather than trusting it, and these
    # two are re-measured here.
    #
    #   surface.rs   the footer creates BOTH — one keyboard that repeats for
    #                the views and a plain one for the leader, because
    #                repeating the leader is an error. So it has to contain
    #                both calls; one of them gone and the excuse is gone.
    #
    #   lifeline.rs  the line that outlives the footer walks NOTHING. Four
    #                letters, each a single press, and a held `r` would restart
    #                the interface four times. So it has to contain no list at
    #                all: no bar to drag, no wheel, no offset to move.
    EXCUSED = {
        "surface.rs": {"must": ["get_keyboard_with_repeat", "get_keyboard("], "must_not": []},
        "lifeline.rs": {
            "must": [],
            "must_not": ["list_bar", "PointerEventKind::Axis", "offset"],
        },
    }
    wrong = []
    handlers = 0

    for f in sorted(shell.rglob("*.rs")):
        body = code_of(f.read_text())
        if "impl KeyboardHandler for" not in body:
            continue
        handlers += 1
        if f.name in EXCUSED:
            # THE REASON IS RE-MEASURED, never taken on trust.
            for word in EXCUSED[f.name]["must"]:
                if word not in body:
                    wrong.append(
                        f"{f.name} is excused from repeating, and the reason was that it "
                        f"names `{word}` — it does not any more"
                    )
            for word in EXCUSED[f.name]["must_not"]:
                if word in body:
                    wrong.append(
                        f"{f.name} is excused from repeating because it walks no list, "
                        f"and it now names `{word}`"
                    )
            # AND IT STILL HAS THE METHOD. The trait is not optional, and a
            # door that lost it would not compile — this is here so the excuse
            # cannot quietly become "it has no keyboard at all".
            if "fn repeat_key" not in body:
                wrong.append(f"{f.name}: has no `repeat_key` at all")
            continue
        if "get_keyboard_with_repeat" not in body:
            wrong.append(
                f"{f.name}: implements KeyboardHandler and asks for a keyboard "
                "that does NOT repeat"
            )
        if "fn repeat_key" not in body:
            wrong.append(f"{f.name}: has no `repeat_key` at all")

    # AND THE EXCUSED ONES EXIST AT ALL. A renamed file would leave its name
    # here excusing nothing, and the door it names swept by nobody.
    for name in sorted(EXCUSED):
        if not (shell / name).is_file():
            wrong.append(f"{name} is excused and is not there any more")

    # AND THE CHECK ITSELF IS NOT VACUOUS: it has to have found the windows.
    floor(handlers, 6, "keyboard handlers found")

    if wrong:
        print("ERROR: a keyboard that does not repeat.", file=sys.stderr)
        print("", file=sys.stderr)
        for w in wrong:
            print("       " + w, file=sys.stderr)
        print("", file=sys.stderr)
        print("       SCTK only sends repeat events for a keyboard made with", file=sys.stderr)
        print("       `get_keyboard_with_repeat`. Without it `repeat_key` is dead", file=sys.stderr)
        print("       code and holding an arrow moves exactly one row — which is", file=sys.stderr)
        print("       indistinguishable, from the outside, from a list that ends.", file=sys.stderr)
        raise SystemExit(1)

    print(f"OK: {handlers} keyboards, and every one that drives a list repeats")
    END
  '';

  # EVERY POLKIT RULE THIS SYSTEM HAS, counted.
  #
  # Six modules write one: `files`, `rescue`, `update`, `keyboard`, `memory`
  # and `tor`. Four of them have a check of their own about how WIDE they are,
  # and not one of them could see a SEVENTH appearing — the only sweep that
  # existed (`disks-adds-no-polkit-rule-of-its-own`, step 3) looks for a udisks
  # action and nothing else, and its step 4 asserted the presence of four of
  # the six.
  #
  # So a module could grow `security.polkit.extraConfig` with a wide action and
  # a `YES`, and every check in this repository would stay green. The owner's
  # rule is "nothing asks", and a rule that returns `YES` is exactly the thing
  # that makes something not ask — which is why the SET of them has to be
  # named somewhere, and this is that place.
  #
  # IT READS THE MERGED CONFIG, not the module files: a rule smuggled in from
  # anywhere reaches `security.polkit.extraConfig` all the same, and so does
  # one whose `mkIf` never turns on. `tor-polkit-is-narrow` is the precedent.
  polkit-rules-are-the-ones-we-know =
    let
      rules = self.nixosConfigurations.vm.config.security.polkit.extraConfig;
      # AND EVERY OTHER WAY A RULE CAN LAND IN THAT DIRECTORY. `extraConfig`
      # is the door this repository uses, and it was the only one this check
      # looked at — so a module could write `environment.etc."polkit-1/rules.d/
      # 49-….rules"` and be invisible to it. Nothing does; the point is that
      # nothing CAN without saying so here.
      etcRules = builtins.filter (p: builtins.match ".*polkit-1/rules\\.d/.*" p != null) (
        builtins.attrNames self.nixosConfigurations.vm.config.environment.etc
      );
    in
    mkCheck "polkit-rules-are-the-ones-we-know" [ pkgs.python3 ] ''
      cat > rules.js <<'RULES'
      ${rules}
      RULES
      cat > etc.txt <<'ETC'
      ${builtins.concatStringsSep "\n" etcRules}
      ETC
      python3 - <<'END'
      import pathlib, re, sys
      exec(open("${pyPrelude}").read())

      # FILE-WIDE: the merged rules of the whole system are one JavaScript
      # file with no function of ours to narrow to; each `if` and each `return`
      # is narrowed by its own parentheses, below.
      #
      # `uncommented` and never `code_of`: every action id, unit and verb this
      # audits is a STRING literal, and emptying them would leave a check that
      # audits an empty set and calls it agreed. What the strip buys is that a
      # `||` written in a comment is no longer read as an alternative.
      text = uncommented(pathlib.Path("rules.js").read_text())
      floor(len(text), 500, "characters of the merged polkit rules")

      # NOTHING SMUGGLES A RULE IN THROUGH `environment.etc`. The upstream
      # packages that ship their own live in the store and are read by polkit
      # from there; what this refuses is a rule OUR configuration writes by a
      # route this check cannot audit.
      # `10-nixos.rules` IS THE AUDITED ROUTE: it is the file nixpkgs writes
      # `security.polkit.extraConfig` into, and its content is `rules.js`
      # above. Any OTHER file is a second door.
      # AND NO CONDITION MIXES `&&` WITH A BARE `||`.
      #
      # `&&` binds tighter, so `id && user && unit == a || unit == b` reads as
      # `(id && user && unit == a) || unit == b` — every alternative after the
      # first granted for ANY action and ANY subject. `rescue.nix` shipped
      # exactly that: a fold wrote the disjunction and the brackets the sibling
      # block has were not there. Nothing else could see it — this check reads
      # action ids and result names, and both were on the audited list.
      #
      # THE INNER GROUPS COME OFF FIRST, repeatedly, so `action.lookup("unit")`
      # and a properly bracketed disjunction both disappear; what is left is
      # the condition's own top level.
      def top_of(condition):
          was = None
          while was != condition:
              was = condition
              condition = re.sub(r"\([^()]*\)", " ", condition)
          return condition

      # EVERY CONDITION, NOT EVERY `if (`.
      #
      # This scan keyed on the literal `if (`, and `nixfmt` does not format
      # JavaScript inside an indented string — so `if(` with no space, which is
      # an unremarkable way to write it, was never looked at. Nor was a
      # condition in `return a && b || c;` or in a `? :`, and both of those say
      # the same thing to polkit.
      #
      # So: read the condition of every `if`/`while` however it is spelled, and
      # every `return` expression, and put each through `top_of`.
      loose, conditions = [], 0
      for m in re.finditer(r"\b(?:if|while)\s*\(", text):
          deep, i = 0, m.end() - 1
          while i < len(text):
              if text[i] == "(":
                  deep += 1
              elif text[i] == ")":
                  deep -= 1
                  if deep == 0:
                      break
              i += 1
          top = top_of(text[m.end() : i])
          conditions += 1
          if "&&" in top and "||" in top:
              loose.append(text[m.start() : i + 1].strip().splitlines()[0])
      # AND A `return` THAT DECIDES BY ITSELF. `return a && b || c;` and
      # `return a && b || c ? YES : NO;` grant exactly what the bracketed
      # condition would, with no `if` anywhere near them.
      floor(conditions, 5, "conditions read out of the merged rules")
      for m in re.finditer(r"\breturn\b([^;]*);", text):
          top = top_of(m.group(1))
          if "&&" in top and "||" in top:
              loose.append(m.group(0).strip().splitlines()[0])

      if loose:
          print(
              "ERROR: a polkit condition mixes `&&` with an unbracketed `||`, so "
              "everything after the first alternative is granted for any action "
              "and any subject:",
              file=sys.stderr,
          )
          print("", file=sys.stderr)
          for l in loose:
              print("       " + l, file=sys.stderr)
          raise SystemExit(1)

      smuggled = [
          l.strip()
          for l in pathlib.Path("etc.txt").read_text().splitlines()
          if l.strip() and l.strip() != "polkit-1/rules.d/10-nixos.rules"
      ]
      if smuggled:
          print(
              "ERROR: a polkit rule is written into /etc by a route this check "
              "cannot audit:",
              file=sys.stderr,
          )
          for l in smuggled:
              print("       /etc/" + l, file=sys.stderr)
          print("", file=sys.stderr)
          print(
              "       Every rule this system adds goes through "
              "`security.polkit.extraConfig`, so that it is read here and named "
              "in AGREED below.",
              file=sys.stderr,
          )
          raise SystemExit(1)

      # THE ACTIONS EVERY RULE NAMES, and the module each belongs to. The
      # comment is the audit: adding a line here is claiming somebody read the
      # rule and decided the door is the right width.
      AGREED = {
          # OURS — eight modules, and every one of them names its units inside
          # the same action. `files` and `rescue` return `AUTH_SELF_KEEP` (they
          # ask, once, and remember); `keyboard`, `keys`, `memory`, `update` and
          # `tor` return `YES`, because nothing this system does on its own may
          # ask. `keys` is the one that names TWO units — keyd and its
          # replacement, which the mode switch trades. Each has a check of its
          # own about which unit and which verbs.
          "org.freedesktop.systemd1.manage-units":
              "ours: files, rescue, keyboard, keys, memory, update, tor, syncthing",
          # nix/modules/base.nix — the machine's own clock. THREE actions and
          # not four: `set-local-rtc` decides whether the hardware clock runs
          # in local time, nothing in this tree asks for it, and a fourth
          # would be a door held open for nobody. `timedate-polkit-is-narrow`
          # reads this rule and `ronoctua_clock::timedate::ACTIONS` in both
          # directions.
          "org.freedesktop.timedate1.set-ntp": "ours: base",
          "org.freedesktop.timedate1.set-time": "ours: base",
          "org.freedesktop.timedate1.set-timezone": "ours: base",
          # nix/modules/rescue.nix — the rescue console's way out, and the
          # `-multiple-sessions` twins that logind asks separately about.
          "org.freedesktop.login1.power-off": "ours: rescue",
          "org.freedesktop.login1.power-off-multiple-sessions": "ours: rescue",
          "org.freedesktop.login1.reboot": "ours: rescue",
          "org.freedesktop.login1.reboot-multiple-sessions": "ours: rescue",
          # UPSTREAM — nixpkgs' own `networking.networkmanager` module, and
          # the reason `network-adds-no-nm-polkit-rule` does not exist: the
          # rule the network view relies on is THIS one, written by nixpkgs
          # for the `networkmanager` group, and ours would only widen it.
          "org.freedesktop.NetworkManager.": "upstream: networkmanager",
          "org.freedesktop.ModemManager": "upstream: networkmanager",
      }

      found = set(re.findall(r'action\.id\s*==\s*"([^"]+)"', text))
      found |= set(re.findall(r'action\.id\.(?:startsWith|indexOf)\("([^"]+)"', text))
      results = set(re.findall(r"polkit\.Result\.([A-Z_]+)", text))
      rules = len(re.findall(r"polkit\.addRule\(", text))

      wrong = []
      if not rules:
          sys.exit("ERROR: the merged config has no rule at all; the sweep is not reaching it")

      # AND EVERY RULE NARROWS BY ACTION AT ALL.
      #
      # THIS IS THE RULE THAT MAKES THE CENSUS ABOVE MEAN ANYTHING. `found` is
      # built by looking for `action.id` written three ways, so a rule that
      # names no action contributes NOTHING to it: the difference against
      # AGREED is empty and the check passes. A reviewer wrote the four lines
      #
      #   polkit.addRule(function (action, subject) {
      #     if (subject.isInGroup("users")) { return polkit.Result.YES; }
      #   });
      #
      # into a module and watched this check print OK — every polkit action on
      # the system granted to every member of `users`, which is the exact
      # sentence in this check's own header about what it exists to stop.
      #
      # A rule may still be wide on purpose; what it may not be is wide and
      # unexamined. Naming an action is what puts it in the census, and the
      # census is what somebody has to sign.
      def rule_bodies(js):
          out = []
          for m in re.finditer(r"polkit\.addRule\(", js):
              opened = js.find("{", m.end())
              if opened == -1:
                  continue
              depth = 0
              for j in range(opened, len(js)):
                  if js[j] == "{":
                      depth += 1
                  elif js[j] == "}":
                      depth -= 1
                      if depth == 0:
                          out.append(js[opened : j + 1])
                          break
          return out

      bodies = rule_bodies(text)
      if len(bodies) != rules:
          wrong.append(
              f"{rules} rules were counted and {len(bodies)} could be read; the "
              "sweep below them is not seeing every rule"
          )
      for body in bodies:
          if "action.id" not in body:
              flat = " ".join(body.split())
              wrong.append(
                  "a rule that never looks at action.id, so it answers for EVERY "
                  "action on the system and the census above cannot see it: "
                  + flat[:140]
              )

      for action in sorted(found - set(AGREED)):
          wrong.append(f"an action nobody audited: {action}")
      for action in sorted(set(AGREED) - found):
          wrong.append(f"an audited action that is gone: {action} (was {AGREED[action]})")
      # AND NO RESULT WIDER THAN THE THREE THIS SYSTEM USES. `AUTH_ADMIN` and
      # `AUTH_ADMIN_KEEP` ask for the ROOT password, which nothing here may.
      for result in sorted(results - {"YES", "AUTH_SELF_KEEP", "NOT_HANDLED", "NO"}):
          wrong.append(f"a result nobody agreed to: polkit.Result.{result}")

      if wrong:
          print("ERROR: the system's polkit posture changed.", file=sys.stderr)
          print("", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          print("", file=sys.stderr)
          print("       There is no polkit AGENT in this session, so a rule that", file=sys.stderr)
          print("       returns YES is what makes something able to run at all —", file=sys.stderr)
          print("       and a rule nobody read is a door nobody measured.", file=sys.stderr)
          raise SystemExit(1)

      print(f"OK: {rules} rules, {len(found)} actions, all of them audited")
      END
    '';

  # THE ONE NEW POLKIT RULE IN THIS SYSTEM, and how wide it is.
  #
  # `nix/modules/tor.nix` lets the owner start and stop ONE unit. Everything
  # about that sentence is checked here, and it is checked against the MERGED
  # `security.polkit.extraConfig` of the whole system — not against the
  # module's text. The difference is the point: a rule smuggled in from
  # another module is invisible to a `grep` of one file, and so is a rule
  # whose `mkIf` never turns on.
  #
  # THE FIRST VERSION OF THIS CHECK PASSED FOUR WIDENING EDITS — `YES` turned
  # into `AUTH_ADMIN`, a second unit OR'd in, `try-restart` added, a second
  # user OR'd in — because it grepped for the presence of words and never for
  # the RESULT or for what else the rule allows. That is AGENTS.md's own trap:
  # a check against the code and not against the criterion closes an empty
  # milestone.

  # ONE BOUNDARY WITH SYNCTHING, and it is a crate.
  #
  # `one-pipewire-boundary`'s twin, and it exists for the defect that one
  # names: for a long time `ronoctua-bluetooth` ran its own `pw-dump`, and two
  # readers of one daemon's JSON is two places to fix the day it changes. The
  # Syncthing client used to live inside `ronoctua-shell`, hand-parsing JSON
  # with `str::find`; it is a crate now, and this is what keeps it one.
  one-syncthing-boundary = mkCheck "one-syncthing-boundary" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a boundary is broken by a NAME appearing anywhere outside it,
    # so the file is the question. The cut at `mod tests` is the narrowing.
    #
    # `uncommented` and never `code_of`: every name here is a string literal —
    # a program, a header, a path — and emptying the strings would leave a
    # sweep that can never find one. What the strip is for is the other half:
    # a name written in a comment is prose ABOUT the boundary, and three of
    # these files explain themselves that way.
    crates = pathlib.Path("${../crates}")
    boundary = crates / "ronoctua-syncthing" / "src" / "rest.rs"
    swept = 0
    unit = crates / "ronoctua-syncthing" / "src" / "unit.rs"
    wrong = []

    # THE PATHS AND THE FILE THE KEY LIVES IN. A second reader of either is a
    # second place that has to be right about Syncthing's shape.
    NAMES = ("/rest/", "config.xml", "RONOCTUA_SYNCTHING_CONFIG",
             "RONOCTUA_SYNCTHING_GUI", "X-API-Key")

    # A `tests.rs` IS a test module — `#[cfg(test)] mod tests;` in the file
    # beside it — and a test that asserts a path is the right thing to write.
    # The same argument `one-pipewire-boundary` makes about a test's NAME.
    # That it really is one is not taken on trust: the crate's own `lib.rs` has
    # to declare it under `cfg(test)`.
    for f in sorted(crates.rglob("tests.rs")):
        # WHOEVER DECLARES IT is `lib.rs` beside it, or the `<name>.rs` one
        # level up that owns the directory — both are how Rust 2018 spells a
        # module with a directory under it.
        owners = [f.with_name("lib.rs"), f.parent.with_suffix(".rs")]
        if not any(
            o.exists() and "#[cfg(test)]\nmod tests;" in o.read_text() for o in owners
        ):
            wrong.append(f"{f.relative_to(crates)} is skipped and nothing declares it a test module")

    for f in sorted(crates.rglob("*.rs")):
        if f in (boundary, unit) or f.name == "tests.rs":
            continue
        text = f.read_text()
        # THE PRODUCT, NOT ITS TESTS, and not its prose. Several files explain
        # at length why the boundary is where it is; a rule that could not tell
        # a sentence from a call would be a rule nobody could write near.
        cut = list(re.finditer(r"^#\[cfg\(test\)\]\s*\nmod tests", text, re.M))
        if cut:
            text = text[: cut[-1].start()]
        # AND `uncommented` IS WHAT TELLS A SENTENCE FROM A CALL. It was a
        # `re.sub` over `//.*`, which cuts at a `//` inside a STRING as
        # readily as at a comment — a URL or a path would have hidden
        # everything after it on that line.
        code = uncommented(text)
        swept += 1
        for name in NAMES:
            if name in code:
                wrong.append(f"{f.relative_to(crates)} names `{name}` outside the boundary")

    floor(swept, 100, "sources of the workspace swept for a Syncthing name")
    if not boundary.exists():
        wrong.append("crates/ronoctua-syncthing/src/rest.rs is gone; what is this checking?")
    else:
        body = uncommented(boundary.read_text())
        floor(len(body), 1000, "characters of rest.rs")
        for name in ("/rest/events", "/rest/system/status", "X-API-Key"):
            if name not in body:
                wrong.append(f"the boundary no longer names `{name}` — has it moved?")
        # AND THE KEY IS PRIVATE. It is read to sign a request and for nothing
        # else; a `pub fn key` is one careless row away from the screen.
        if re.search(r"pub\s+(const\s+)?fn\s+key\b", body):
            wrong.append("the API key has a public reader")

    for w in wrong:
        print(f"ERROR: {w}", file=sys.stderr)
    if wrong:
        raise SystemExit(1)
    print("OK: one crate speaks to Syncthing, and the key stays inside it")
    END
  '';

  # ONE HAND-WRITTEN HTTP, and it is a crate too.
  #
  # There were two: `ronoctua-tunnel` had one for Tailscale, and its own first
  # line said it was the shape `shell::syncthing` already had. The Syncthing
  # view would have made a third. What a third copy costs is not lines — it is
  # that the chunked decoder in `ronoctua-http` exists because a chunk boundary
  # inside a multi-byte character panicked a thread and killed every tunnel key
  # for a session, and a copy that has not learned that is a copy that will.
  # ONE WALK THROUGH A CENTRAL DIRECTORY, and the queue does not gain a
  # rasteriser for baking a region.
  #
  # Two promises in one check, because they are the same promise from two
  # sides. The zip reader MOVED out of `ronoctua-inspect` when a region pack
  # turned out to be a zip too — copying it would have been the second walk
  # through one, which is what this repository refuses everywhere else. And the
  # crate that bakes a pack is deliberately NOT allowed to know the globe: the
  # transfers daemon is extracted from the workspace precisely so the desktop's
  # closure does not follow it into the ISO, and a dependency on the drawing
  # would undo that without anything on screen saying so.
  # EVERY VIEW'S PAGE FOLLOWS ITS OWN CURSOR, and the arithmetic is in one
  # place.
  #
  # The footer's region is capped in lines and every view is longer than that,
  # so a cursor that walks past the last line without the page moving is a cursor
  # nobody can see — which reads as an arrow key that stopped working. It was
  # the state of THIRTEEN of the fifteen views: only the manager and the
  # clipboard called `follow_cursor`, each from inside its own errand handler,
  # and the owner reported it — *"ao mover a seleção para cima e para baixo com
  # as setas o scroll não acompanha … isso precisa ser corrigido de forma
  # global"*.
  #
  # Two halves, and neither is enough alone. `Footer::typed` is the ONE place
  # that knows a person pressed a key (an arrival must NOT follow — see
  # `settle_region`), and `list_cursor` is the ONE place that knows where each
  # view's cursor is. A view missing from that table follows nothing, silently.
  every-view-follows-its-cursor = mkCheck "every-view-follows-its-cursor" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    src = code_of(pathlib.Path("${../crates/ronoctua-shell/src/surface.rs}").read_text())
    floor(len(src), 100000, "characters of surface.rs")
    bad = []

    # THE VIEWS ARE READ FROM THE ENUM, never from a list typed here: a list
    # would be one more place to forget the next view.
    enum = must(scope(src, r"enum ViewState\b"), "`enum ViewState`")
    views = re.findall(r"^    (\w+),", enum, re.M)
    floor(len(views), 12, "views declared by `ViewState`")

    # THE THREE THAT HAVE NO CURSOR, and each is a claim about what it is.
    #
    #   `Manual`  — the shortcut list is READ, and paged by its own keys.
    #   `Leader`  — a sequence under way draws a table, not a list.
    #   `NoneOf`  — the region is closed.
    WITHOUT = {"Manual", "Leader", "NoneOf"}

    # BY BRACES, never by the next `\n    }`: a nested block that closes at
    # that indent ends the capture early, and everything after it reads as
    # absent. `body_of` counts the braces.
    table = must(body_of(src, "list_cursor"), "`list_cursor`")
    floor(len(table), 200, "characters of `list_cursor`")
    named = set(re.findall(r"ViewState::(\w+)", table))
    for v in views:
        if v in WITHOUT or v in named:
            continue
        bad.append(
            f"ViewState::{v} is not in `list_cursor`, so its page never follows "
            "its cursor — the arrow walks off the bottom of the region"
        )
    for v in sorted(WITHOUT):
        if v in named:
            bad.append(f"ViewState::{v} is excused from following and now does; the excuse is stale")

    # AND THE ONE CALLER THAT MAKES IT HAPPEN. `typed` is the human-key path;
    # if the call leaves it, every view stops following at once and no test of
    # a single view would say so.
    wrapper = must(body_of(src, "typed"), "`Footer::typed`")
    floor(len(wrapper), 100, "characters of `typed`")
    if "follow_cursor()" not in wrapper:
        bad.append(
            "`Footer::typed` no longer follows the cursor: it is the one place "
            "that knows a PERSON moved something, and an arrival must not"
        )
    # AND NOT FROM THE PAINT, which is the arrival's path.
    painting = must(body_of(src, "draw_and_paint"), "`draw_and_paint`")
    if "follow_cursor" in painting:
        bad.append(
            "`draw_and_paint` follows the cursor: a daemon's arrival redraws "
            "too, and that is the forced scroll the owner reported once already"
        )

    for b in bad:
        print(f"ERROR: {b}", file=sys.stderr)
    if bad:
        raise SystemExit(1)
    print(f"OK: {len(views) - len(WITHOUT)} views follow their cursor, from one place")
    END
  '';

  # A SELECTOR THAT BRANCHES ON NUMBERS IS FED A NUMBER, and never a string.
  #
  # Fluent picks a variant by the ARGUMENT'S TYPE: given the string `"1"` it
  # looks for a variant literally named `1`, does not find one, and falls
  # through to the default. The row then reads `1 screens` on the machine every
  # laptop is — or, the day this check was written, every digit of `644` saying
  # `can read, change and run it`, which is `777` in a sentence about
  # permissions.
  #
  # It is a KNOWN trap: `display.rs` records it in a comment ending *"with every
  # check green"*, and the months were fixed for it once. Then the octal's
  # digits walked into it anyway, and the only reason it was caught is that a
  # test PRINTED the three sentences. So the rule stops being folklore: a key
  # whose value has a numeric branch may only be resolved through `t_args`.
  numeric-selectors-get-numbers = mkCheck "numeric-selectors-get-numbers" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys

    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a call site may be anywhere in any crate, and what bounds the
    # search is the 400 characters of the CALL — its own parentheses — rather
    # than a function. The `.ftl` half is a catalogue with no functions at all.
    #
    # `code_of` on the Rust: a `t_with` written out in a comment as an example
    # is not a call, and this check names the file and the key when it fails.
    root = pathlib.Path("${self}")
    bad = []

    # THE KEYS ARE READ FROM THE `.ftl`, both languages: a selector that is
    # numeric in one and not in the other is a key that answers differently by
    # language, which this finds as well.
    numeric = {}
    for language in ${builtins.toJSON languages}:
        text = (root / "assets/i18n" / (language + ".ftl")).read_text()
        key, body = None, []
        def close(key, body):
            if key is None:
                return
            said = "\n".join(body)
            if re.search(r"\[\s*\d+\s*\]", said):
                numeric.setdefault(key, set()).update(re.findall(r"\{\s*\$(\w+)\s*->", said))
        # A MESSAGE'S VALUE CONTINUES ONLY ON INDENTED LINES, which is
        # Fluent's own rule — and the first version of this swept everything up
        # to the next `key =`, comments and all. It reported
        # `locale-date-mdy`, whose value is `{ $m }/{ $d }/{ $y }`, for the
        # numeric branches of the key TWO comment lines below it.
        for line in text.splitlines():
            m = re.match(r"^([a-z][a-z0-9-]*) =", line)
            if m:
                close(key, body)
                key, body = m.group(1), [line]
            elif key is not None and line[:1].isspace():
                body.append(line)
            else:
                close(key, body)
                key, body = None, []
        close(key, body)

    floor(len(numeric), 3, "keys with a numeric branch")

    # THE CONSTANT IS THE KEY IN THE SHAPE THE GENERATOR WRITES IT.
    consts = {k.upper().replace("-", "_"): k for k in numeric}
    swept = 0

    # AND THE CALL SITES. `t_with` and `t_marked` take `&str` arguments and can
    # only ever hand Fluent a string; `t_args` is the one that carries a type.
    for f in sorted(root.glob("crates/**/*.rs")):
        if "target" in f.parts:
            continue
        text = code_of(f.read_text())
        swept += 1
        for m in re.finditer(r"\bt_(with|marked)\s*\(", text):
            # THE CALL'S OWN PARENTHESES, and not four hundred characters cut
            # at the first `);`. Neither bound is the call: rustfmt ends a
            # nested one `),`, so the window ran past it into the NEXT call and
            # blamed `t_args` for what `t_with` was doing — and a `);` inside a
            # string literal cut it short the other way.
            window = shut_at(text, m.end())
            for const, key in consts.items():
                if re.search(rf"\b{const}\b", window):
                    bad.append(
                        f"{f.relative_to(root)}: `{key}` branches on numbers and is "
                        f"resolved through `t_{m.group(1)}`, which can only pass a "
                        "string — every number falls through to the default branch"
                    )

    floor(swept, 100, "sources of the workspace swept for a call site")
    for b in bad:
        print(f"ERROR: {b}", file=sys.stderr)
    if bad:
        raise SystemExit(1)
    print(
        f"OK: {len(numeric)} keys branch on numbers, and every call site hands "
        "them a number"
    )
    END
  '';

  # THE SWEEP ONLY EVER LOOKS AT A LINK, NEVER THROUGH ONE.
  #
  # This is the one thing in the tree that deletes a person's files by the
  # thousand, and the worst thing it could do is follow `~/.cache/x -> /home`.
  # The unit test plants exactly that and watches it survive; this is the other
  # half — the SOURCE rule, so the defect cannot come back through a call that
  # no fixture happens to exercise.
  #
  # `std::fs::metadata` follows links. `canonicalize` and `read_link` resolve
  # them. None of the three has any business here, and `symlink_metadata` is
  # what has to be present: a walk with neither would be one that does not look
  # at all.
  # THE BRAIN CAN BE PHOTOGRAPHED, and for a long time it could not.
  #
  # Its whole screen is the mind the host pushes in, and `render-png` had no
  # way to push one — so every picture of it was a title over the words "no
  # tasks yet", which the tool's own header called "the honest picture of what
  # they have". It was honest and it was useless: the buffer this repository
  # most needed to review was the one it could not open. The owner said so in
  # as many words.
  #
  # `--mind` closes it, and this is what keeps it closed. The fixture is the
  # DAEMON'S OWN JSON — one line off its socket is a valid argument — so it
  # cannot drift into a shape only the tool understands.
  #
  # WHAT IS ASSERTED, and the first two attempts at it were both wrong.
  #
  # "The two languages differ" does not catch an empty screen: without a mind
  # the page says `Nothing is set up yet` in one and `Nada configurado ainda`
  # in the other, which differ perfectly well. Neither does "there is ink" —
  # a header and one sentence is plenty of ink.
  #
  # What separates the two is how MUCH is on the screen, and the tool already
  # prints it: the number of runs in the frame it drew. An empty brain is a
  # header and a sentence; one with a mind is a list, a log, a footer and a
  # paragraph. The floor is set well under what this fixture produces and well
  # over what an empty screen can reach, and the two numbers are far enough
  # apart that nothing has to be tuned.
  #
  # The size and the difference between languages stay, because they are cheap
  # and they close the rest of the chain in one comparison — component,
  # display list, i18n, tokens, wgpu, pixel.
  the-brain-is-photographable = mkCheck "the-brain-is-photographable" [ pkgs.python3 ] ''
    export VK_DRIVER_FILES=${xvfb.icd}
    export VK_ICD_FILENAMES=${xvfb.icd}
    export LIBGL_ALWAYS_SOFTWARE=1
    export RONOCTUA_COVERAGE_FONTS=${rust.atRunTime.RONOCTUA_COVERAGE_FONTS}

    cat > mind.json <<'JSON'
    {"now":1789800000,
     "pulse":{"at":1789800000,"ram-used-pct":31,"memory-stall":4,"cpu-stall":40,"on-battery":false},
     "tasks":[
       {"id":"system-update","kind":"routine","standing":"idle","enabled":true,
        "interval-days":7,"part-of-day":"afternoon","next":1789886400,"hold":null,"why-not":"",
        "last":{"task":"system-update","began":1789540000,"ended":1789540291,"kind":"done",
                "at":"","why":"","trouble":"","steps":[]},
        "history":[{"task":"system-update","began":1789540000,"ended":1789540291,"kind":"done",
                    "at":"","why":"","trouble":"","steps":[]}],
        "steps":[{"id":"a-root-step","command":"nix flake update","needs-root":true,
                  "on":true,"on-by-default":true}]},
       {"id":"cache-sweep","kind":"once","standing":"idle","enabled":true,
        "interval-days":10,"part-of-day":"night","next":1789807200,"hold":null,"why-not":"",
        "last":null,"history":[],"steps":[]}],
     "queue":[],"running":"","announcement":null,"rehearsing":null,"postponed":null,
     "journal":[{"task":"cache-sweep","began":1789700000,"ended":1789700060,"kind":"held",
                 "at":"","why":"ram","trouble":"","steps":[]}],
     "prefs":{"gate":{"ram-ceiling-pct":70,"cpu-stall-per-mille":200,"abort-on-battery":true},
              "tasks":{}}}
    JSON

    : > runs.txt
    for language in ${lib.concatStringsSep " " languages}; do
      ${rust.workspace}/bin/ronoctua-render-png \
        ${buffers.brain}/lib/ronoctua_buffer_brain.wasm \
        --mind mind.json --columns 100 --lines 30 --language "$language" \
        --out "$PWD/$language.png" | tee -a runs.txt
      # AND THE PAGE BEHIND ONE, which is the half a mind is needed for twice:
      # without a task there is nothing to open.
      ${rust.workspace}/bin/ronoctua-render-png \
        ${buffers.brain}/lib/ronoctua_buffer_brain.wasm \
        --mind mind.json --columns 100 --lines 30 --language "$language" \
        --key enter --out "$PWD/$language-task.png" | tee -a runs.txt
      # AND THE POINTER AT REST, which is the third thing a photograph could
      # not reach. The wall carries a hover now, and a screen this tool cannot
      # drive is a screen nobody reviews — the hole is in the photographer,
      # never in the buffer.
      ${rust.workspace}/bin/ronoctua-render-png \
        ${buffers.brain}/lib/ronoctua_buffer_brain.wasm \
        --mind mind.json --columns 100 --lines 30 --language "$language" \
        --hover 30,3 --out "$PWD/$language-hover.png" | tee -a runs.txt
    done

    # THE HOVER LIGHTS A ROW, and a row the CURSOR is not on: the two are
    # different questions and wear different grounds. Asked of the display
    # list, because a tone this close is not a thing to assert from pixels.
    ${rust.workspace}/bin/ronoctua-render-png \
      ${buffers.brain}/lib/ronoctua_buffer_brain.wasm \
      --mind mind.json --columns 100 --lines 30 --language en-GB \
      --hover 30,3 --list > hovered.txt
    # BY THE TWO THINGS THAT MATTER, and not by the whole `Debug` spelling:
    # the row and the ground it wears. Written out in full it broke the day the
    # band gained a column and a width — a change this check has no opinion
    # about, and a check that argues with every edit argues with none of them.
    # A CURSOR'S OWN HOVER: a buffer paints every hand in its colour, and
    # it is the HOST that turns one lone cursor back into the neutral hover —
    # this list is what the buffer drew, before the host.
    grep -E 'Selection \{ line: 3,.*cursor-hover-one' hovered.txt > /dev/null \
      || { echo "ERROR: the pointer rested on a row and nothing lit under it." >&2; exit 1; }
    grep -q 'surface-selection' hovered.txt \
      || { echo "ERROR: the cursor's own band went away with the hover." >&2; exit 1; }

    python3 - <<'END'
    import pathlib, struct, sys, zlib
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: what is read here is a log this check itself produced and a
    # set of PNGs, neither of which has a function in it.
    # PARSED: the pictures are decoded — the IDAT chunks are inflated and the
    # bytes compared — and the log is split on a fixed word. Neither is
    # searched for a name, so there is no prose for a comment to hide in and
    # nothing for a stripper to take off.

    def pixels(name):
        raw = pathlib.Path(name).read_bytes()
        if raw[:8] != b"\x89PNG\r\n\x1a\n":
            sys.exit("ERROR: " + name + " is not a PNG")
        wide, tall = struct.unpack(">II", raw[16:24])
        # The IDAT, decompressed and un-filtered enough to count colours: every
        # row is one filter byte and then RGBA.
        data = b"".join(
            raw[i + 8 : i + 8 + struct.unpack(">I", raw[i : i + 4])[0]]
            for i in range(8, len(raw))
            if raw[i + 4 : i + 8] == b"IDAT"
            for _ in [0]
        )
        return wide, tall, zlib.decompress(data)

    # HOW MANY RUNS THE FRAME HAD. An empty brain draws about sixteen — the
    # header's ladder and one sentence. This fixture draws over forty.
    FLOOR = 30

    seen = {}
    for language in "${lib.concatStringsSep " " languages}".split():
        for what in (language, language + "-task"):
            wide, tall, body = pixels(what + ".png")
            if (wide, tall) == (0, 0):
                sys.exit("ERROR: " + what + " has no size")
            seen[what] = body

    floor(len(seen), 4, "pictures taken of the brain")
    drew = 0
    for line in pathlib.Path("runs.txt").read_text().splitlines():
        if " runs," not in line:
            continue
        drew += 1
        drawn = int(line.split(" runs,")[0].split()[-1])
        if drawn < FLOOR:
            sys.exit(
                "ERROR: a page drew only " + str(drawn) + " runs (" + line.strip() + "). "
                "The brain drew its empty screen, which is what `--mind` exists to stop."
            )
    floor(drew, 6, "pages whose run count was read back")

    for what in ("", "-task"):
        bodies = {l: seen[l + what] for l in "${lib.concatStringsSep " " languages}".split()}
        if len(set(map(bytes, bodies.values()))) != len(bodies):
            sys.exit(
                "ERROR: the brain's" + (what or " home") + " page is the same in every language — "
                "which is what an empty screen looks like"
            )

    print("OK: the brain's two pages draw, in every language, from a mind off the daemon's own socket")
    END
  '';

  # EVERY KEY THE BRAIN BINDS IS A KEY ITS SCREEN TEACHES.
  #
  # THE DEFECT THIS CATCHES is one the owner reported twice, in those words:
  # they asked for a way to run a task by hand and to switch one off, and both
  # times the answer was that the keys existed — `m r` and `m o` — and neither
  # appeared anywhere on the page. A key that is not on the screen is a key
  # nobody has.
  #
  # It went unnoticed because the page taught from a hand-written list, so the
  # list and the keymap were two truths. The buffer's own test asserts they
  # agree; this asserts the SHAPE that makes agreeing possible — the header is
  # built from tables of pairs and not from runs written out one by one, so a
  # key added to the keymap and not to a table is a test failure rather than a
  # silence.
  the-brain-header-is-generated = mkCheck "the-brain-header-is-generated" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: `KEYMAP` and the four `*_TEACHES` tables are module-level.
    # `rungs` is narrowed by name below.
    #
    # `uncommented` and never `code_of`: a KEY and a command id are string
    # literals, and emptying them would leave two empty sets that agree.
    src = uncommented((pathlib.Path("${self}") / "buffers" / "brain" / "src" / "lib.rs").read_text())
    floor(len(src), 10000, "characters of the brain buffer's lib.rs")

    bound = set(re.findall(r'\("([^"]+)", "brain-[^"]+"\),', src))
    floor(len(bound), 5, "keys the brain binds")

    # WHAT THE PAGES TEACH, out of the same shape.
    taught = set()
    for table in ("HOME_TEACHES", "TASK_TEACHES", "ANSWER_TEACHES", "NOTICE_TEACHES"):
        block = re.search(table + r": &\[Teach\] = &\[(.*?)\];", src, re.S)
        if not block:
            sys.exit("ERROR: `" + table + "` went away; the header is built from it")
        taught |= set(re.findall(r'\("([^"]+)",', block.group(1)))
    floor(len(taught), 5, "keys the pages teach")

    missing = sorted(k for k in bound if k not in taught)
    if missing:
        sys.exit(
            "ERROR: the brain binds keys no page teaches: " + ", ".join(missing)
            + ". A key that is not on the screen is a key nobody has."
        )

    # AND THE HEADER IS DRAWN FROM THE TABLES. A `put` of a literal notation in
    # the header's own builder is the hand-written list coming back.
    head = must(body_of(src, "header"), "`State::header`")
    floor(len(head), 400, "characters of the header's builder")
    for literal in re.findall(r'Run::datum\("([^"]+)"\)', head):
        sys.exit("ERROR: the header draws the literal `" + literal + "` instead of a table's pair")

    # AND IT IS LAID OUT ONCE. The height, the ink and the POINTER all read
    # `ladder`; three walks of the same table is how a rung comes to answer
    # for its neighbour — the same class of defect the scrollbar had, where
    # what paints and what catches were two arithmetics.
    ladder = must(body_of(src, "ladder"), "`State::ladder`")
    floor(len(ladder), 400, "characters of `ladder`")
    for who, why in (
        ("header", "the header paints a ladder it laid out itself"),
        ("header_rows", "the height counts a ladder of its own"),
        ("clicked", "a click on a shortcut is resolved by a second walk"),
    ):
        body = must(body_of(src, who), "`State::" + who + "`")
        if "ladder()" not in body:
            sys.exit("ERROR: " + why + " — one walk, read three times")

    print("OK: every key the brain binds is taught, and the header is one walk read three times")
    END
  '';

  # THE SWITCH ON THE UPDATE'S PAGE REACHES THE RUN.
  #
  # It did not. `m t` wrote an entry into `brain.json` and nothing on the
  # machine ever read it: what decides whether a step runs is
  # `/etc/ronoctua/updates.conf`, generated from a NixOS option, which needs a
  # rebuild. So the page offered a key, the key wrote a file, and the sequence
  # went on running exactly what it ran before — with nothing anywhere to say
  # so.
  #
  # The fix is a third layer in `turned_on`, read after the machine's table:
  # the person's own flips, written by the brain out of `brain.json`. This
  # refuses the two ways it could quietly come undone — the script dropping
  # the layer, and the brain dropping the file.
  the-step-switch-reaches-the-run =
    mkCheck "the-step-switch-reaches-the-run"
      [
        pkgs.bash
        pkgs.gnused
      ]
      ''
        # IT RUNS THE GENERATED FUNCTION, and does not read the generator.
        #
        # The first shape of this read the script's SOURCE for the name of the
        # person's file, and a sabotage walked straight past it: pointing the
        # guard at `/nonexistent` while leaving the redirect below it kept the
        # name in the text and broke the feature. A check that greps measures
        # how the source is spelled, which is not the property.
        #
        # So it lifts `turned_on` and `default_on` out of the real script and
        # asks them the four questions that matter, with tables planted under
        # them. If the person's layer stops being read, one of the four gives
        # the wrong answer.
        export HOME="$PWD/home"
        export XDG_STATE_HOME="$HOME/.local/state"
        mkdir -p "$XDG_STATE_HOME/ronoctua"

        script=${updateRunners}/bin/ronoctua-update
        [ -x "$script" ] || { echo "ERROR: the person's half was not built" >&2; exit 1; }

        # THE TWO FUNCTIONS, and nothing else: the rest of that file starts a
        # unit and updates a machine.
        {
          echo 'set -uo pipefail'
          sed -n '/^turned_on() {/,/^}/p' "$script"
          sed -n '/^default_on() {/,/^}/p' "$script"
        } > lifted.sh
        grep -q 'turned_on' lifted.sh || {
          echo "ERROR: \`turned_on\` is not in the generated script any more" >&2; exit 1; }

        ask() {
          # `$1` the step, `$2` what is expected. No `/etc` table here, so the
          # distro's own defaults answer until the person's file speaks.
          if bash -c ". ./lifted.sh; turned_on $1"; then said=on; else said=off; fi
          if [ "$said" != "$2" ]; then
            echo "ERROR: $1 is $said and should be $2 ($3)" >&2
            failed=1
          fi
        }

        failed=0
        : > "$XDG_STATE_HOME/ronoctua/update-steps.conf"
        ask tldr-cache on "the distro ships it on and nobody has said otherwise"
        ask rust-toolchains off "the distro ships it off and nobody has said otherwise"

        # AND NOW THE PERSON SAYS OTHERWISE, in both directions. This is the
        # whole feature: a key on the brain's page changing what the sequence
        # runs, with no rebuild.
        printf '%s\n' 'system-update rust-toolchains' > "$XDG_STATE_HOME/ronoctua/update-steps.conf"
        ask rust-toolchains on "the person switched it on"
        ask tldr-cache on "a flip on one step moved another"

        printf '%s\n' 'system-update tldr-cache' > "$XDG_STATE_HOME/ronoctua/update-steps.conf"
        ask tldr-cache off "the person switched it off"

        # AND A FLIP BELONGING TO ANOTHER TASK IS NOT THIS SEQUENCE'S.
        printf '%s\n' 'cache-sweep tldr-cache' > "$XDG_STATE_HOME/ronoctua/update-steps.conf"
        ask tldr-cache on "another task's flip was applied to this one"

        [ "$failed" = 0 ] || exit 1
        echo "OK: a step switched on the brain's page is a step the sequence runs"
      '';

  # THE BRAIN READS WHERE THE UNITS WRITE, and it did not.
  #
  # `ronoctua_brain::runner::reports_dir` said `/run/ronoctua-brain` and
  # NOTHING ON THE MACHINE EVER WROTE THERE: the person's units write into
  # `%t`, which for them is `$XDG_RUNTIME_DIR`, and the update's script kept a
  # TSV in a third place. `Report::watch` polls one path's mtime, so a path
  # that never appears never changes — every run the brain started sat there
  # until its patience ran out and came back `runaway`. Two hours, on a rebuild
  # that had worked.
  #
  # Nothing could have caught it. Every test points `Runner::reporting_in` at a
  # scratch directory, which is right — a test that wrote into the real one
  # would be a test that talks to the machine — and that is exactly why none of
  # them named it.
  #
  # So this reads the three places the name is spelled and refuses a
  # disagreement: the daemon's constant, the `--report` argument in the units,
  # and the generator that writes the update's own sheet.
  the-brain-reads-what-the-units-write =
    mkCheck "the-brain-reads-what-the-units-write" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        root = pathlib.Path("${self}")
        # THE CODE AND NOT THE PROSE. The comment beside `reports_dir` names the
        # old path on purpose — it is the whole story of the defect — and a check
        # that read it would refuse the explanation of what it is checking for.
        # FILE-WIDE: a constant, a unit's command line and a generator's
        # variable — all module-level, in three languages.
        #
        # The local `code` dropped a line that BEGAN with a comment marker.
        # `uncommented` and `hashless` are the prelude's, one per language, and
        # they take a comment off the end of a line too; `uncommented` also
        # knows that a `//` inside a string is not a comment, which matters
        # here because every needle below is a PATH.

        runner = uncommented((root / "crates" / "ronoctua-brain" / "src" / "runner.rs").read_text())
        module = hashless((root / "nix" / "modules" / "cache.nix").read_text())
        generator = hashless((root / "nix" / "scripts" / "gen-updates.py").read_text())
        floor(len(runner), 1000, "characters of runner.rs")
        floor(len(module), 500, "characters of nix/modules/cache.nix")
        floor(len(generator), 2000, "characters of gen-updates.py")

        said = re.search(r'pub const REPORTS_LEAF: &str = "([^"]+)";', runner)
        if not said:
            sys.exit("ERROR: `REPORTS_LEAF` went away; it is the name the units have to agree with")
        leaf = said.group(1)

        # THE DAEMON LOOKS IN THE RUNTIME DIRECTORY, and the unit's `%t` is that
        # directory. A daemon that resolved an absolute path of its own would be
        # back where this started.
        if "XDG_RUNTIME_DIR" not in runner:
            sys.exit("ERROR: the brain no longer resolves its reports under the runtime directory")
        for absolute in ("/run/ronoctua-brain", "/var/run/ronoctua-brain"):
            if absolute in runner:
                sys.exit(
                    "ERROR: the brain looks in " + absolute + ", which no unit of the person's can write"
                )

        # AND THE UNITS WRITE THERE. Both of them, and the rehearsal beside the
        # real one — `report_path` builds `<id>-rehearsal.json` for a rehearsal,
        # and a unit that wrote the plain name would have its rehearsal watched
        # against the last true run's file.
        wanted = "%t/" + leaf + "/"
        if module.count("--report " + wanted) != 2:
            sys.exit("ERROR: nix/modules/cache.nix does not write into `" + wanted + "` twice")
        for kind in ("cache-sweep", "trash-expire"):
            for name in (kind + ".json", kind + "-rehearsal.json"):
                if name not in module:
                    sys.exit("ERROR: no unit writes `" + name + "`")
        if "-rehearsal.json" not in runner and "rehearsal" not in runner:
            sys.exit("ERROR: the brain no longer watches a rehearsal's own file")

        # AND THE UPDATE'S SCRIPT WRITES ONE AT ALL, which is the half that was
        # missing entirely: it kept a TSV and the brain wanted JSON.
        if 'REPORTS_LEAF = "' + leaf + '"' not in generator:
            sys.exit("ERROR: the update's generator does not spell the same directory")
        for wanted in ("sheet_file", "sheet_ended", "finish()"):
            if wanted not in generator:
                sys.exit("ERROR: the update's script no longer writes the sheet the brain reads")

        print("OK: the brain reads the directory the units write into, rehearsals included")
        END
      '';

