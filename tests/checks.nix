        gaps.append("the window's `typed` does not read its key through `key_of` and `press_of_key`")
    if "utf8" in window:
        gaps.append("the window reads the TEXT a key typed — a chord is a control character there")
    if re.search(r"\bfn press_of\b", window):
        gaps.append("the window keeps a key reader of its own beside the shared one")

    # 5) AND A CLICK IS THE `RET` OF ITS ROW, in both doors and with the one
    #    exception. A pairing question opens over whatever was on the screen; a
    #    door that acted on a click there would put `yes` about an unknown
    #    device one movement of a hand away.
    arm = scope(footer, r"fn clicked_at\b")
    block = body_of(window, "clicked")
    if not arm or not block:
        sys.exit("ERROR: the click path of one of the two doors went away or changed shape")
    for door, text in [("footer", arm), ("window", block)]:
        if "Press::Enter" not in text:
            gaps.append(f"a click in the {door} no longer does what `RET` does")
        if "asking()" not in text:
            gaps.append(
                f"a click in the {door} acts while a pairing question is up — `yes` about an "
                "unknown device would be one click away"
            )

    if gaps:
        print("ERROR: the two doors of `LEADER s b` do not answer the same keys")
        for gap in gaps:
            print("  - " + gap)
        print("")
        print("       One view, two doors, one table, ONE READER: the footer and the")
        print("       window both hand the whole key to `bluetooth_words::press_of_key`.")
        sys.exit(1)
    print(f"OK: {len(rows)} keys, one reader, two doors")
    PY
  '';

  # AND EVERY WORD THE KEYBOARD BUFFER OFFERS SAYS SOMETHING.
  #
  # `LEADER s k` draws a ring of meanings for a key — nine of them — and every
  # one arrives as a TEXT KEY the buffer hands to the host (invariant 11: the
  # component translates nothing). A key with no sentence is
  # `[keyboard-choice-noop]` on a screen where somebody is about to change what
  # their Caps Lock does.
  #
  # The list comes out of `assets/keyboards.nix` itself, so a word added there
  # is demanded here on the next build — the arrangement `notifications-have-text`
  # established and `bluetooth-profiles-have-text` copied one file earlier.
  keyboard-choices-have-text = mkCheck "keyboard-choices-have-text" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a generated list of keys against a catalogue of sentences.
    # Neither file has a function in it.
    #
    # `hashless` on the `.ftl`, whose comment is `#`: a key that was commented
    # out is a key that is not there, and it used to read as present.
    keys = pathlib.Path("${keyboardsRs}/keys.txt").read_text().split()
    floor(len(keys), 12, "words in the vocabulary")

    failed = False
    for language in ${builtins.toJSON languages}:
        ftl = hashless(pathlib.Path("${texts}/" + language + ".ftl").read_text())
        have = set(re.findall(r"^([a-z][a-z0-9-]*) *=", ftl, re.M))
        floor(len(have), 500, "keys declared by " + language)
        missing = [k for k in keys if k not in have]
        if missing:
            print(f"ERROR: {language} does not have: {', '.join(missing)}")
            failed = True
        else:
            print(f"ok  {language}: the vocabulary's {len(keys)} words are there")

    if failed:
        sys.exit(1)
    print("OK: every key and every meaning speaks both languages")
    PY
  '';

  # KEYD REALLY REFUSES A FILE IT CANNOT READ.
  #
  # # Why this is measured and not assumed
  #
  # The whole safety of `LEADER s k` rests on one sentence: the rendered files
  # are validated BEFORE they are installed, because a keyd that refuses its
  # configuration is a keyboard with no leader on a machine somebody is
  # holding. That sentence is only true if `keyd check` says no — and how it is
  # spelled decides whether it says anything at all:
  #
  #     keyd check good.conf bad.conf   exit 255   what the crate uses
  #     keyd check -c <directory>       exit 255   `-c` is read as a filename
  #     keyd check <directory>          exit   0   a directory parses as nothing
  #
  # The first version of the crate used the middle spelling, which refuses
  # everything — the feature would have been a screen that never wrote. The
  # third is worse: a guard that says yes to a file that would kill the daemon.
  # So this runs the real binary, both ways, and reads the crate for the
  # spelling.
  keyd-refuses-what-it-cannot-read =
    mkCheck "keyd-refuses-what-it-cannot-read"
      [
        pkgs.keyd
        pkgs.gnugrep
      ]
      ''
        printf '[ids]\n*\n\n[main]\nleftmeta = overload(meta, f13)\n' > good.conf
        printf '[ids]\n*\n\n[main]\nleftmeta = nonsense_action(1,2,3)\n' > bad.conf

        keyd check good.conf || {
          echo "ERROR: keyd refused a configuration this system renders." >&2
          exit 1; }

        if keyd check bad.conf 2>/dev/null; then
          echo "ERROR: keyd accepted a configuration it cannot read." >&2
          echo "      The guard in front of every install is this command, and" >&2
          echo "      a guard that says yes to anything is not a guard." >&2
          exit 1
        fi

        # AND THE CRATE SPELLS IT THE WAY THAT WORKS. `-c` would refuse every
        # write; a bare directory would accept every one.
        crate=${../crates/ronoctua-keyboards/src}/lib.rs
        grep -q '\.arg("check")' "$crate" || {
          echo "ERROR: the crate no longer calls \`keyd check\`." >&2
          exit 1; }
        grep -q '\.args(files)' "$crate" || {
          echo "ERROR: the crate does not hand keyd the FILES it is about to install." >&2
          echo "      With no file, keyd checks what is already in /etc/keyd —" >&2
          echo "      the configuration that is running, not the one being written." >&2
          exit 1; }
        if grep -q '"check", "-c"' "$crate"; then
          echo "ERROR: the crate passes \`-c\`, which keyd reads as a filename." >&2
          echo "      Every install would be refused." >&2
          exit 1
        fi

        echo "OK: keyd takes the files, accepts what we render and refuses what it cannot read"
      '';

  # THE LEADER SURVIVES BEING CONFIGURED.
  #
  # # What would go wrong without this
  #
  # keyd takes a device id in ONE file. The distro's file claims `*`, so a
  # keyboard given rules of its own has to be taken OUT of that claim — and a
  # keyboard outside the catch-all has no rules at all unless its own file
  # repeats them. One of those rules is the leader.
  #
  # So the failure this holds back is precise and awful: somebody configures
  # their keyboard, and the key that opens every command in the system stops
  # working ON THAT KEYBOARD. Nothing errors; the file is valid; keyd is happy.
  #
  # # The three things it reads, and why all three
  #
  # The RULE is declared once (`assets/keyboards.nix`) — the module writes it
  # into the seed and the shell writes it into every file it renders, and a
  # second copy would drift. The SEED has to carry it, or a machine that has
  # never been configured has no leader on first boot. And the DIRECTORY has to
  # belong to the user, or the shell cannot write there at all and the whole
  # feature is a screen that refuses.
  keyd-rules-carry-the-leader =
    mkCheck "keyd-rules-carry-the-leader"
      [
        pkgs.python3
        pkgs.gnugrep
      ]
      ''
        python3 - <<'PY'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        # FILE-WIDE: a rendered keyd file and a tmpfiles line have no functions
        # in them, and the two facts asked of the crate — that it builds the
        # leader once and writes it into every file — are about the file.
        #
        # `hashless` for the Nix and the tmpfiles rules; `uncommented` for the
        # Rust, because `EVERYONE` is the string literal being read out.
        declared = hashless(pathlib.Path("${../assets/keyboards.nix}").read_text())
        floor(len(declared), 100, "characters of assets/keyboards.nix")
        key = re.search(r'key = "([a-z0-9]+)";', declared)
        action = re.search(r'action = "([^"]+)";', declared)
        if not key or not action:
            print("ERROR: assets/keyboards.nix declares no leader rule")
            sys.exit(1)
        rule = f"{key.group(1)} = {action.group(1)}"

        failed = False

        # THE SEED, out of the built system rather than out of the module's
        # source: what a machine boots with is the file, not the expression.
        seed = pathlib.Path("${seedOfTheKeyboard}").read_text()
        if rule not in seed:
            print(f"ERROR: the seeded keyd config does not carry `{rule}`")
            print(f"       it says: {seed!r}")
            failed = True
        if "[ids]" not in seed or "*" not in seed:
            print("ERROR: the seeded keyd config claims no keyboard")
            failed = True

        # AND THE CRATE PUTS IT IN EVERY FILE. Read out of the source, because
        # the unit test that proves it by rendering cannot run from here — and
        # what would break this is somebody writing the rule into the catch-all
        # only, which reads as correct until a keyboard is configured.
        crate = uncommented(pathlib.Path("${../crates/ronoctua-keyboards/src}/lib.rs").read_text())
        product = crate.split("#[cfg(test)]")[0]
        floor(len(product), 1000, "characters of the crate before its tests")
        if "let leader = format!" not in product:
            print("ERROR: the renderer no longer builds the leader's line once")
            failed = True
        # Every file gets it: the catch-all pushes it, and so does the loop.
        if product.count("push_str(&leader)") < 2:
            print("ERROR: the leader is not written into every rendered file —")
            print("       a keyboard with rules of its own would lose it.")
            failed = True

        # AND THE DIRECTORY IS OURS TO WRITE.
        rules = hashless(pathlib.Path("${tmpfilesOfTheKeyboard}").read_text())
        floor(len(rules), 40, "characters of the tmpfiles rules")
        if not re.search(r"^d /var/lib/ronoctua/keyd .* ${user} ", rules, re.M):
            print("ERROR: the keyd directory does not belong to the session's user")
            print(f"       {rules}")
            failed = True
        if "L+ /etc/keyd" not in rules:
            print("ERROR: /etc/keyd is not pointed at the directory the shell writes")
            failed = True

        # AND THE TWO HALVES AGREE ON ITS NAME. The module seeds a file and the
        # crate renders one; if they disagree, a machine boots with the seed
        # AND keeps it beside the shell's own — two catch-alls, both claiming
        # `*`, which is what keyd's manual forbids.
        seeded = re.search(r"^C (\S+)", rules, re.M)
        named = re.search(r'pub const EVERYONE: &str = "([^"]+)"', crate)
        if not seeded or not named:
            print("ERROR: could not read the catch-all's name from both sides")
            failed = True
        elif not seeded.group(1).endswith("/" + named.group(1)):
            print(f"ERROR: the module seeds `{seeded.group(1)}` and the shell")
            print(f"       renders `{named.group(1)}` — two catch-alls, both claiming `*`.")
            failed = True

        if failed:
            sys.exit(1)
        print(f"OK: `{rule}` is in the seed and in every file the shell renders")
        PY
      '';

  # The guard of section 6.3 is only worth anything if it is tested. This check
  # builds the negative fixture, which ONLY passes if the generator refused a
  # token that does not exist.
  icons-unknown-token-fails = mkCheck "icons-unknown-token-fails" [ ] ''
    test -f ${glyphdb.negativeFixture}/out_text.txt \
      || { echo "ERROR: the negative fixture produced no output" >&2; exit 1; }
    grep -q "icon tokens that do not resolve" ${glyphdb.negativeFixture}/out_text.txt \
      || { echo "ERROR: the negative fixture did not fail for the right reason" >&2; exit 1; }
    echo "OK: an icon token that does not exist takes the build down (section 6.3)"
  '';

  # THE SAME GUARD, DOWN THE OTHER BRANCH.
  #
  # `ours-<mark>` resolves against `marks.json` and the marks face, not against
  # `glyphnames.json` and the Nerd Font — a whole second resolution path, whose
  # three failure modes the fixture above cannot reach. It is the same argument
  # that fixture's own comment makes, applied to the branch added beside it.
  marks-unknown-token-fails = mkCheck "marks-unknown-token-fails" [ ] ''
    test -f ${glyphdb.negativeMarkFixture}/out_text.txt \
      || { echo "ERROR: the negative fixture produced no output" >&2; exit 1; }
    grep -q "is not declared in assets/icons/marks.nix" \
      ${glyphdb.negativeMarkFixture}/out_text.txt \
      || { echo "ERROR: the fixture did not fail for the right reason" >&2; exit 1; }
    echo "OK: a mark nobody drew takes the build down"
  '';

  # fontconfig <-> renderer parity — section 6.4.
  #
  # "The renderer does NOT use fontconfig... The shell needs its own fallback
  # chain, COHERENT with fontconfig's."
  #
  # Both come out of nix/fontconfig.nix, from a single list. This check proves
  # that they do agree: if they diverge, the same text renders with different
  # faces inside and outside our buffers, and the symptom ("the accent looks
  # strange in the terminal") is expensive to trace back to here.
  #
  # The renderer's side is simulated by the declared order — it only exists in
  # milestone 3, but the behavior is already determined by the data. When the
  # renderer exists, this script becomes the oracle it is measured against.
  fonts-renderer-parity =
    let
      fontDirs = [
        "${fonts.noctua-iosevka-ttf-nerdfonts}/share/fonts"
        "${pkgs.noto-fonts}/share/fonts"
        "${pkgs.noto-fonts-cjk-sans}/share/fonts"
        "${pkgs.noto-fonts-color-emoji}/share/fonts"
      ];
      # OUR system's fontconfig, not the host's: with our rules and only our
      # fonts. Comparing against the host's fontconfig would prove nothing
      # about the distro.
      #
      # A REAL conf.d, ordered by name — not a sequence of <include> by hand.
      #
      # This matters: including our conf before or after the block of defaults
      # gives different results, and neither of the two reproduces the real
      # system. fontconfig reads `conf.d` in order of file NAME, and that is how
      # `50-ronoctua.conf` positions itself among the default rules. Testing with
      # another order measures a configuration that is never going to exist.
      confd = pkgs.runCommand "ronoctua-test-confd" { } ''
        mkdir -p $out
        ln -s ${pkgs.fontconfig.out}/etc/fonts/conf.d/*.conf $out/ 2>/dev/null || true
        ln -s ${fontconfigConf.confDir}/etc/fonts/conf.d/50-ronoctua.conf $out/50-ronoctua.conf
      '';

      fontsConf = pkgs.writeText "fonts.conf" ''
        <?xml version="1.0"?>
        <!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
        <fontconfig>
          ${lib.concatMapStrings (d: "<dir>${d}</dir>\n  ") fontDirs}
          <cachedir>/tmp/fc-cache</cachedir>
          <include ignore_missing="yes">${confd}</include>
        </fontconfig>
      '';
    in
    mkCheck "fonts-renderer-parity"
      [
        py
        pkgs.fontconfig
      ]
      ''
        export FONTCONFIG_FILE=${fontsConf}
        mkdir -p /tmp/fc-cache
        fc-cache -f >/dev/null 2>&1 || true

        echo "### fc-match on the three generics ###"
        failed=0
        for g in monospace sans-serif serif; do
          m=$(fc-match -f '%{family}' "$g")
          echo "  $g -> $m"
          case "$m" in
            *"NoctuaIosevka Nerd Font Mono"*) ;;
            *) echo "ERROR: '$g' does not resolve to our font (section 6.4)" >&2; failed=1 ;;
          esac
        done
        [ $failed -eq 0 ] || exit 1
        echo

        python3 ${../nix/scripts/check-font-parity.py} \
          --chain-json ${fontconfigConf.chainJson} \
          --font-dir ${fonts.noctua-iosevka-ttf-nerdfonts}/share/fonts \
          --strict
      '';

  # Icon superpack — section 6.6. The manifest has to cover 100% of the names
  # that went in, and the origin licenses all have to be recorded: the
  # repository is publishable (section 9), so "where did this icon come from
  # and under what terms" needs an answer.
  icons-superpack = mkCheck "icons-superpack" [ pkgs.jq ] ''
    sp=${iconSuperpack}
    doc=$sp/share/doc/noctua-icons
    themeName=$sp/share/icons/noctua

    test -f $themeName/index.theme || { echo "ERROR: index.theme is missing" >&2; exit 1; }
    test -f $doc/manifest.json || { echo "ERROR: the manifest is missing" >&2; exit 1; }
    test -f $doc/coverage.md || { echo "ERROR: the coverage report is missing" >&2; exit 1; }

    # Inheritance: hicolor last, as the freedesktop spec requires.
    grep -q '^Inherits=hicolor$' $themeName/index.theme \
      || { echo "ERROR: index.theme does not inherit hicolor last" >&2; exit 1; }

    # Every entry declares a winner and a license — without that the manifest
    # does not answer the question it exists for.
    n=$(jq '.entry_count' $doc/manifest.json)
    complete_ones=$(jq '[.entries[] | select(.winner != null and .license != null)] | length' $doc/manifest.json)
    echo "entries in the manifest: $n"
    [ "$n" -eq "$complete_ones" ] || {
      echo "ERROR: $((n - complete_ones)) entries with no winner or no licence" >&2; exit 1; }

    # Every directory cited in index.theme really exists.
    absent=0
    for d in $(grep '^Directories=' $themeName/index.theme | cut -d= -f2 | tr ',' ' '); do
      [ -d "$themeName/$d" ] || { echo "ERROR: a directory declared but missing: $d" >&2; absent=1; }
    done
    [ $absent -eq 0 ] || exit 1

    # Origin licenses recorded, one per theme that went into the merge.
    for t in $(jq -r '.sources[].name' $doc/manifest.json); do
      test -s "$doc/LICENSES/$t.txt" \
        || { echo "ERROR: the source licence is missing for $t" >&2; exit 1; }
    done

    echo "OK: the manifest covers 100% of the entries, with a winner and a licence"
    echo "OK: source licences recorded for every merged theme"
  '';

  # THE CHAIN'S PIXMAP STEP, against the REAL superpack.
  #
  # The `icons-superpack` above proves that the PACKAGE is well formed; this
  # one proves that the chain REACHES it. They are different things, and the
  # second fails silently: without it, `procurar` would give back `None` for
  # everything, the application list would be left with only the category
  # glyphs — and a whole list of category glyphs LOOKS DELIBERATE. It is the
  # most expensive defect of this path, because it has no symptom at all.
  #
  # It counts OPAQUE pixels: finding the file is not drawing it, and an SVG
  # that rasterizes empty gives an invisible smudge on the dark background —
  # which is indistinguishable from "the icon has not arrived yet".
  apps-icon-from-superpack = mkCheck "apps-icon-from-superpack" [ ] ''
    ${rust.bins.ronoctua-test-icons}/bin/ronoctua-test-icons \
      ${iconSuperpack}/share/icons/noctua
  '';

  # ===================================================================
  # NETWORK AND SYNCTHING — does what was TUNED actually reach the system?
  #
  # These two checks evaluate the real NixOS configuration, and not the
  # module's text. The difference matters: a `grep` in the `.nix` would pass
  # with the value written and shadowed by an `mkIf` that never turns on, or
  # with an option renamed by nixpkgs — both cases give a system without the
  # adjustment and a green check. That is exactly how the tray table already
  # passed the build and never reached the Rust.
  # ===================================================================
  networkEval = (pkgs.nixos [ ../nix/modules/network.nix ]).config;
  syncthingEval =
    (pkgs.nixos [
      ../nix/modules/syncthing.nix
      # The Syncthing module reads `config.ronoctua.user`, which belongs to base.
      {
        options = { };
        config.ronoctua.user = "noctua";
      }
      { options.ronoctua.user = lib.mkOption { type = lib.types.str; }; }
    ]).config;

  # The Wi-Fi password sealed in the TPM, against a real TPM (swtpm).
  #
  # The defect it catches is THE PASSWORD STAYING ON DISK — not "the daemon
  # does not come up". A check that only looked at the unit would pass with
  # `psk=<password>` inside the keyfile, which is precisely what this work
  # eliminates.
  wifiTpmVm = import ./wifi-tpm-vm.nix {
    inherit pkgs lib;
    inherit (rust) networkConsole networkAgent;
  };

  # AN INSTALLED MACHINE JOINS WI-FI, over a simulated air: the first boot
  # with the installer's profile, the footer's join and "keep it", a wrong
  # password, the boot's console, and a reboot that keeps only what was kept
  # — the library's own calls, `#[ignore]`d tests run from their harness.
  wifiJoinsVm = import ./wifi-joins-vm.nix {
    inherit pkgs lib;
    inherit (rust) networkConsole networkAgent;
    networkTests = rust.test.testBins.ronoctua-network;
    installerTests = rust.test.testBins.ronoctua-installer;
  };

  # THE INSTALLER JOINS WI-FI — the ISO's TUI on the console, with no secret
  # agent: a wrong password refused, the right one joined in memory on a
  # WPA2 network and a WPA3 one in transition, and a network joined before
  # the installer said on its row.
  installerJoinsWifiVm = import ./installer-wifi-vm.nix {
    inherit pkgs lib;
    installer = rust.installer;
  };

  network-tuned = mkCheck "network-tuned" [ ] ''
    expected() {
      if [ "$2" != "$3" ]; then
        echo "FAILED: $1 = $2, expected $3" >&2
        echo "" >&2
        echo "This value is NOT decorative: it came out of measuring a" >&2
        echo "592 GB transfer between two machines of this project." >&2
        exit 1
      fi
    }
    # The single biggest gain from the radio. With power saving on, the
    # throughput halves and nothing on screen says why.
    expected "wifi.powersave"       "${lib.boolToString networkEval.networking.networkmanager.wifi.powersave}" "false"
    # BBR without `fq` works WORSE than cubic: it is the classic mistake of
    # turning on only half of it, and that is why both are checked together.
    expected "tcp_congestion_control"       "${
      toString networkEval.boot.kernel.sysctl."net.ipv4.tcp_congestion_control"
    }" "bbr"
    expected "default_qdisc"       "${
      toString networkEval.boot.kernel.sysctl."net.core.default_qdisc"
    }" "fq"
    # The costliest trap in a synchronization: Syncthing pauses between files,
    # and without this every file starts over in slow start.
    expected "tcp_slow_start_after_idle"       "${
      toString networkEval.boot.kernel.sysctl."net.ipv4.tcp_slow_start_after_idle"
    }" "0"
    # Without the module loaded, the BBR sysctl fails at boot — and the failure
    # shows up in the journal, not on the screen.
    case " ${lib.concatStringsSep " " networkEval.boot.kernelModules} " in
      *" tcp_bbr "*) ;;
      *) echo "FAILED: tcp_bbr is not in boot.kernelModules" >&2; exit 1 ;;
    esac
    # AND THE CONNECTIVITY CHECK REACHES THE DAEMON'S OWN FILE.
    #
    # It is `settings.connectivity` and not `connectivity`: the second is not
    # an option of the nixpkgs module, and writing it fails at EVALUATION —
    # which is how it was found, three modules later, with an error naming
    # three options that have nothing to do with it. This line is what stops
    # the value being written somewhere nothing reads.
    #
    # Without the check the daemon answers `full` for any route at all, and
    # the modeline's `no way out` mark could never appear.
    expected "connectivity.uri"       "${
      toString networkEval.networking.networkmanager.settings.connectivity.uri or ""
    }" "http://nmcheck.gnome.org/check_network_status.txt"
    expected "connectivity.interval"       "${
      toString networkEval.networking.networkmanager.settings.connectivity.interval or ""
    }" "300"
    echo "OK: powersave off, BBR+fq, slow start disarmed, the way out measured"
  '';

  syncthing-tuned = mkCheck "syncthing-tuned" [ ] ''
    # ================================================================
    # THE MOST IMPORTANT CHECK IN THIS FILE, and the least obvious.
    #
    # `overrideFolders` is `true` in nixpkgs, and `true` means "whatever is
    # not declared in Nix is DELETED on activation". This module declares no
    # folder at all, because a folder path is personal data (invariant 13) —
    # so the default would DELETE EVERY FOLDER on each `nixos-rebuild`,
    # including the ones the person has just added through the interface,
    # with no warning and no undo.
    #
    # There is no symptom before the damage. Hence the check.
    # ================================================================
    if [ "${lib.boolToString syncthingEval.services.syncthing.overrideFolders}" != "false" ]; then
      echo "FAILED: overrideFolders switched on ERASES the user's folders" >&2
      exit 1
    fi
    if [ "${lib.boolToString syncthingEval.services.syncthing.overrideDevices}" != "false" ]; then
      echo "FAILED: overrideDevices switched on ERASES the paired devices" >&2
      exit 1
    fi
    # UPnP failed every 30 minutes on the measured machine, forever.
    if [ "${lib.boolToString syncthingEval.services.syncthing.settings.options.natEnabled}" != "false" ]; then
      echo "FAILED: natEnabled switched on in a LAN synchronisation" >&2
      exit 1
    fi
    # The relay is a very slow fallback route: with it, a momentary discovery
    # failure drops the transfer to ~1 MB/s with nothing saying so.
    if [ "${lib.boolToString syncthingEval.services.syncthing.settings.options.relaysEnabled}" != "false" ]; then
      echo "FAILED: relaysEnabled lets the transfer fall back to the relay" >&2
      exit 1
    fi
    # The package comes from Nix; self-updating would try to write to /nix/store.
    if [ "${builtins.toString syncthingEval.services.syncthing.settings.options.autoUpgradeIntervalH}" != "0" ]; then
      echo "FAILED: auto-update switched on for a package in the store" >&2
      exit 1
    fi
    echo "OK: override off, no NAT, no relay, no auto-upgrade"
  '';

  # The token generator REFUSES a name that does not become a WIT identifier.
  #
  # The real defect: `wifi-0` was accepted here and broke the build three
  # derivations later, inside a WASM buffer, with the message "invalid
  # character in identifier '0'" pointing at the generated enum — which does
  # not say where the name came from. The check tests BOTH sides: the good
  # name passes, the bad one is refused.
  tokens-wit-name = mkCheck "tokens-wit-name" [ pkgs.python3 ] ''
    python3 - <<'END'
    import importlib.util
    spec = importlib.util.spec_from_file_location("gt", "${../nix/scripts/gen-tokens.py}")
    gt = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(gt)

    for good in ["wifi-weak", "network-secured", "surface.base", "app-firefox"]:
        gt.wit_ident(good)

    for bad in ["wifi-0", "signal-4", "colour-2x"]:
        try:
            gt.wit_ident(bad)
        except SystemExit:
            continue
        raise SystemExit(f"FAILED: `{bad}` passed, and the WIT would refuse it")
    print("OK: the generator refuses a name the WIT does not accept")
    END
  '';

  # THE COLOUR SCIENCE, PROVED — the module every theme value comes out of.
  #
  # `nix/scripts/colorspace.py` is what turns a seed (a hue, a relative chroma,
  # a contrast target) into the bytes on screen: Oklab with conditioned
  # matrices, the analytic sRGB boundary, gamut mapping, APCA, ΔE_ok and the
  # lightness solver. None of it is exercised by `cargo test` — it is Python
  # inside a derivation — so this is where its properties are checked: white
  # is L = 1 exactly, grey has no chroma, the boundary has no kink at the blue
  # primary, mapping is a fixed point, the APCA anchors are the published
  # ±106/108, and the solver re-derives today's accent from its anchor. A theme
  # would still BUILD with any of those broken; the defect would be a colour
  # nobody could trace back.
  colorspace-tests = mkCheck "colorspace-tests" [ pkgs.python3 ] ''
    # The module and its tests, by FILE: the whole `nix/scripts` would make
    # every other generator's edit a reason to run this again
    # (`generators-cite-their-scripts`).
    mkdir generator && cd generator
    cp ${../nix/scripts/colorspace.py} colorspace.py
    cp ${../nix/scripts/test_colorspace.py} test_colorspace.py
    # No pipe: under `set -o pipefail` a failing unittest ends the check at
    # once, with its whole log, which is what a failure should look like.
    python3 -m unittest -v test_colorspace
    echo "OK: the colour science holds"
  '';

  # ===================================================================
  # THEMES — declared once, solved by the generator, proved against the
  # palette they were derived from.
  # ===================================================================

  # Same closure as `languages-are-declared`: the list in
  # `assets/themes/themes.nix` and the seed files on disk are the same set —
  # a seed that is present and undeclared would be solved by nobody and shown
  # to nobody — and the first is the default.
  themes-are-declared = mkCheck "themes-are-declared" [ pkgs.coreutils pkgs.gnused pkgs.gnugrep ] ''
    declared=$(printf '%s\n' ${lib.escapeShellArgs themes} | sort)
    present=$(cd ${../assets/themes} && ls *.nix | grep -v '^themes\.nix$' | grep -v '\.reference\.nix$' | sed 's/\.nix$//' | sort)

    if [ "$declared" != "$present" ]; then
      echo "ERROR: the declared themes and the seed files on disk differ." >&2
      echo "  declared in assets/themes/themes.nix:" >&2
      printf '    %s\n' $declared >&2
      echo "  present in assets/themes:" >&2
      printf '    %s\n' $present >&2
      exit 1
    fi

    # A frozen reference belongs to a declared theme.
    for r in $(cd ${../assets/themes} && ls *.reference.nix 2>/dev/null); do
      id=''${r%.reference.nix}
      printf '%s\n' $declared | grep -qx "$id" || {
        echo "ERROR: $r is a reference for a theme that is not declared." >&2; exit 1; }
    done

    # THE DEFAULT IS DECLARED BY NAME, and it is no longer the first — see
    # `assets/themes/themes.nix`. So it has to be checked: a name that is not
    # in `order` would reach the NixOS option's enum as a default outside its
    # own type, and the failure would name the option rather than the file.
    base=${defaultTheme}
    printf '%s\n' $declared | grep -qx "$base" || {
      echo "ERROR: the default theme $base is not one of the declared ones." >&2; exit 1; }
    test -f ${../assets/themes}/$base.nix || {
      echo "ERROR: the default theme $base has no seed file" >&2; exit 1; }

    echo "OK: $(printf '%s\n' $declared | wc -l) themes, declared and present, default $base"
  '';

  # THE REGRESSION, AS A NAMED CHECK. The generator already fails the build
  # when a solved value drifts from a frozen reference by more than ΔE_ok 0.03
  # without a listed deviation; here the number is on screen for every theme
  # that carries one, so a drift is read as a distance and not as a missing
  # derivation.
  theme-references-hold =
    let
      # The themes that carry a frozen reference beside their seed — today the
      # one the palette was designed on; the check names none of them.
      withReference = builtins.filter (
        id: builtins.pathExists (../assets/themes + "/${id}.reference.nix")
      ) themes;
    in
    mkCheck "theme-references-hold" [ pkgs.python3 ] ''
      test -n "${lib.concatStringsSep " " withReference}" || {
        echo "ERROR: no theme carries a reference; the regression proves nothing" >&2; exit 1; }
      python3 - ${themed}/report.json ${lib.escapeShellArgs withReference} <<'PY'
      import json, sys
      report = json.load(open(sys.argv[1]))
      for theme in sys.argv[2:]:
          if theme not in report:
              sys.exit(f"ERROR: the report has no `{theme}`")
          # THE BASE PAGE'S ROWS. Every theme is solved on four pages
          # (`PAGES` in gen-theme.py) and the report keeps each page's rows
          # apart; the reference is the palette the theme was designed on,
          # its CHROME, so the regression runs there and nowhere else. The
          # report once kept one flat `findings` list per theme, and reading
          # that name after the pages came in was a KeyError, not a verdict.
          pages = report[theme].get("pages")
          if not isinstance(pages, dict) or "chrome" not in pages:
              sys.exit(f"ERROR: the report's `{theme}` has no base page; its shape moved: {sorted(report[theme])}")
          rows = [f for f in pages["chrome"]
                  if f["gate"] == "regression" and not f["subject"].endswith(" alpha")]
          if not rows:
              sys.exit(f"ERROR: no regression rows for {theme}: its reference is not being compared")
          bad = [f for f in rows if f["level"] == "Fail"]
          for f in bad:
              print(f"ERROR: {theme}: {f['subject']} drifted ΔE_ok {f['measured']:.4f} ({f['note']})", file=sys.stderr)
          if bad:
              sys.exit(1)
          worst = max(rows, key=lambda f: f["measured"])
          noted = [f["subject"] for f in rows if f["level"] == "Note"]
          print(f"OK: {theme}: {len(rows)} keys within ΔE_ok 0.03 of its reference, or a listed ceiling;"
                f" worst {worst['subject']} at {worst['measured']:.4f};"
                f" {len(noted)} listed deviation(s): {', '.join(noted) or 'none'}")
      PY
    '';

  # THE GATES BITE. A seed that puts the accent inside the band where it
  # collapses onto red under protanopia has to FAIL to build, with the gate
  # and the number on screen. The positive path is proved by every build; the
  # negative is what needs a check of its own — the same shape as the syntax
  # table's fixture.
  themes-negative =
    let
      # ANY declared seed will do — this one only needs a valid starting point
      # to spoil. It takes the first because there always is one, and NOT
      # because the first means anything: the default is declared by name now.
      base = import (../assets/themes + "/${builtins.head themes}.nix");
      bad = base // {
        families = base.families // {
          accent = base.families.accent // {
            hue = 165;
          };
        };
      };
      json = name: value: pkgs.writeText name (builtins.toJSON value);
    in
    mkCheck "themes-negative" [ pkgs.python3 ] ''
      mkdir generator
      cp ${../nix/scripts/colorspace.py} generator/colorspace.py
      cp ${../nix/scripts/gen-theme.py} generator/gen-theme.py
      if python3 generator/gen-theme.py \
          --themes ${json "themes.json" [ "bad" ]} \
          --seed bad=${json "bad.seed.json" bad} \
          --recipes ${json "colors.json" (import ../assets/tokens/colors.nix)} \
          --roles ${json "token-roles.json" tokenNames.roles} \
          --default bad \
          --out out > log 2>&1; then
        echo "ERROR: a seed with the accent at 165° built; the gates are not biting." >&2
        cat log >&2
        exit 1
      fi
      grep -q "protan band" log || {
        echo "ERROR: the build failed, but not on the hue gate:" >&2; cat log >&2; exit 1; }
      echo "OK: the generator refuses an accent in the protan band, naming the gate"
    '';

  # NO HEX IN THE TOKENS, AND NO SECOND SOURCE OF COLOUR.
  #
  # `assets/tokens/colors.nix` is recipes and the seeds are hues and chromas:
  # a `0xRRGGBBAA` in either is a colour that escaped the generator, which is
  # invariant 9 with one wall fewer. The frozen reference is a FIXTURE the
  # report compares against, and nothing but `nix/themes.nix` may import it —
  # a second reader would make it a second palette. And nobody imports
  # `colors.nix` at evaluation for its values: they do not exist there.
  # `nix/token-names.nix` reads its attribute NAMES (a parameter, not this
  # path); `tests/theme-data.nix` reads its TEXT, to edit copies and to know
  # its bytes, and is held to this like any other file — an `import` of it
  # there fails here too.
  colours-are-computed = mkCheck "colours-are-computed" [ pkgs.gnugrep ] ''
    seeds=$(ls ${../assets/themes}/*.nix | grep -v '\.reference\.nix$')
    if grep -nE '0x[0-9A-Fa-f]{8}' ${../assets/tokens/colors.nix} $seeds; then
      echo "ERROR: a colour literal in a recipe or a seed." >&2
      echo "      Colours are SOLVED by nix/scripts/gen-theme.py from hues and" >&2
      echo "      contrast targets; a hex here is one the gates never measured." >&2
      exit 1
    fi

    readers=$(grep -rnE '(import|readFile)[^;]*\.reference\.nix' ${self}/nix ${self}/tests ${self}/flake.nix ${self}/crates \
      | grep -v '^${self}/nix/themes.nix:' || true)
    if [ -n "$readers" ]; then
      echo "ERROR: the frozen reference is read outside nix/themes.nix:" >&2
      echo "$readers" >&2
      exit 1
    fi

    importers=$(grep -rnE 'import[^;]*assets/tokens/colors\.nix' ${self}/nix ${self}/tests ${self}/flake.nix \
      | grep -v '^${self}/nix/themes.nix:' | grep -v '^${self}/tests/checks.nix:' || true)
    if [ -n "$importers" ]; then
      echo "ERROR: colors.nix is imported at evaluation; it holds recipes, not values:" >&2
      echo "$importers" >&2
      exit 1
    fi
    echo "OK: no colour literal outside the generator, one reader of the reference"
  '';

  # THE FRAGMENTS EVERY THEME SHIPS FOR THE CONSUMERS OUTSIDE THE SHELL — and
  # the compositor's own parser on the compositor's six. The footer copies
  # these files verbatim when the theme or an answer about it changes
  # (`theme::fragments`); a fragment the compositor refused would be a border
  # that never follows, with the refusal in a log nobody reads and a nag
  # window this distro turns off.
  #
  # EACH ONE IS VALIDATED UNDER A CONFIG THAT ALREADY PAINTS A DESK, as the
  # system's does (`output * bg`). That is the line the whole arrangement
  # stands on: output settings here are MERGED, last-wins per field
  # (`get_output_config`), so the fragment's `output * bg` beats the one
  # already there instead of colliding with it. The previous compositor needed
  # this subtest for the opposite reason — it refused a duplicate `layout`
  # inside one file and merged an included one — and the shape of the proof is
  # the same either way: put the fragment under a config that already says the
  # thing it says.
  #
  # AND EACH SAYS WHAT ITS NAME SAYS, read against the palette's own bytes:
  # the desk (`surface.backdrop`, `surface.near`, or the absolute one —
  # `#000000` in a dark theme and `#FFFFFF` in a light one, whatever the
  # palette says), the
  # outlines (standard, or the discreet one on the focused window and the
  # desk's own faint one on every other), and the terminal's background.
  themes-have-fragments =
    mkCheck "themes-have-fragments"
      [
        scroll
        pkgs.gnugrep
        pkgs.jq
      ]
      ''
        # The compositor's own parser, in a sandbox — see
        # `compositor-config-valid` for the two variables that make that
        # possible and for why the verdict is the OUTPUT and never `$?`.
        export XDG_RUNTIME_DIR="$PWD/run"
        mkdir -p "$XDG_RUNTIME_DIR"
        export WLR_BACKENDS=headless
        export WLR_RENDERER=pixman

        compositor="scroll-backdrop-standard.conf scroll-backdrop-discreet.conf scroll-near-standard.conf scroll-near-discreet.conf scroll-absolute-standard.conf scroll-absolute-discreet.conf"
        terminal="ghostty-theme.conf ghostty-backdrop.conf ghostty-near.conf ghostty-absolute.conf"
        for id in ${lib.escapeShellArgs themes}; do
          d=${themed}/$id
          # THE BYTES OF A TOKEN, as `#RRGGBB`, from the palette the shell's
          # table is generated from.
          hex() { jq -r --arg k "$1" '.[$k]' "${themed}/$id.json" | sed -E 's/^0x([0-9A-F]{6})FF$/#\1/'; }
          for f in compositor-border-active compositor-border-inactive compositor-background $compositor $terminal mode; do
            test -s "$d/$f" || { echo "ERROR: the theme $id has no fragment $f" >&2; exit 1; }
          done
          # THE OLD NAMES ARE GONE: a footer that still copied one would copy
          # a desk nobody chose.
          for f in scroll-black.conf scroll-backdrop.conf ghostty.conf; do
            if [ -e "$d/$f" ]; then
              echo "ERROR: $id still ships $f, a name no answer copies any more" >&2; exit 1
            fi
          done
          for f in compositor-border-active compositor-border-inactive compositor-background; do
            grep -qE '^#[0-9A-F]{6}$' "$d/$f" || {
              echo "ERROR: $id/$f is not a #RRGGBB: $(cat "$d/$f")" >&2; exit 1; }
          done
          # THE STATIC CONFIG IS WHAT A FRESH MACHINE SHOWS, and a fresh
          # machine is on the default answers: the theme's own desk and the
          # standard borders (`theme::Choice::with_theme`, whose fragment is
          # `scroll-backdrop-standard.conf` — `theme.rs` tests that name). No
          # `theme.json`, no fragment copied, so the three static values are
          # the desk and the outlines on screen, and the footer's hidden rows
          # are painted in that default desk's page. A static desk that is not
          # the default answer's is a strip of another colour across it — it
          # was `surface.base` until 2026-09-28.
          default=$d/scroll-backdrop-standard.conf
          grep -qxF "output * bg $(cat "$d/compositor-background") solid_color" "$default" || {
            echo "ERROR: $id's static desk $(cat "$d/compositor-background") is not the default answer's:" >&2
            grep '^output' "$default" >&2; exit 1; }
          test "$(cat "$d/compositor-background")" = "$(hex surface.backdrop)" || {
            echo "ERROR: $id's static desk is not surface.backdrop, the desk of the default answer" >&2; exit 1; }
          for pair in "client.focused compositor-border-active" "client.unfocused compositor-border-inactive"; do
            set -- $pair
            grep -qE "^$1 $(cat "$d/$2")( |$)" "$default" || {
              echo "ERROR: $id's static $2 is not what the default answer's fragment says for $1:" >&2
              grep "^$1 " "$default" >&2; exit 1; }
          done
          # THE MODE IS NOT A COLOUR, so it is read rather than matched
          # against a hex: `nix/modules/foreign.nix` branches on this word and
          # an unknown one would leave GTK and Qt wearing the wrong side.
          mode=$(cat "$d/mode")
          case "$mode" in
            dark) absolute='#000000' ;;
            light) absolute='#FFFFFF' ;;
            *) echo "ERROR: the theme $id says its mode is '$mode'" >&2; exit 1 ;;
          esac
          # AND THE ABSOLUTE DESK IS THE EXTREME OF THAT MODE, in the palette
          # itself — black is not the name of the option any more.
          test "$(hex surface.absolute)" = "$absolute" || {
            echo "ERROR: $id is $mode and its surface.absolute is $(hex surface.absolute), not $absolute" >&2; exit 1; }
          for f in $compositor; do
            printf 'output * bg #123456 solid_color\ninclude "%s"\n' "$d/$f" > "$id.conf"
            scroll --validate --config "$id.conf" > said.txt 2>&1 || true
            if grep -q 'Error' said.txt; then
              echo "ERROR: the compositor refuses $id/$f under a config that already paints a desk:" >&2
              cat said.txt >&2; exit 1
            fi
            desk=$(echo "$f" | sed -E 's/^scroll-([a-z]+)-[a-z]+\.conf$/\1/')
            borders=$(echo "$f" | sed -E 's/^scroll-[a-z]+-([a-z]+)\.conf$/\1/')
            case "$desk" in
              backdrop) want=$(hex surface.backdrop) ;;
              near) want=$(hex surface.near) ;;
              absolute) want=$absolute ;;
            esac
            grep -qE "^output \* bg $want solid_color$" "$d/$f" || {
              echo "ERROR: $id/$f does not paint the $desk desk $want:" >&2
              grep 'output \*' "$d/$f" >&2; exit 1; }
            case "$borders" in
              standard) focused=$(hex border.active); others=$(hex border.inactive); resting=$others ;;
              # `focused_inactive` IS AN UNFOCUSED WINDOW with discreet
              # borders (`gen-theme.py`, `write_fragments`): every column is
              # a container, so nearly every window on the screen wears that
              # class, and in the discreet colour it read as focused.
              discreet) focused=$(hex border.discreet); others=$(hex "border.faint-$desk"); resting=$others ;;
            esac
            # ALL FIVE SLOTS, the indicator and the child border included: a
            # slot left at the compositor's default is a colour nobody chose.
            for line in "client.focused $focused" "client.focused_inactive $others" "client.unfocused $resting"; do
              grep -qxF "$line $(echo "$line" | awk '{print $2" "$2" "$2" "$2}')" "$d/$f" || {
                echo "ERROR: $id/$f does not say '$line' in all five slots:" >&2
                grep '^client\.' "$d/$f" >&2; exit 1; }
            done
            grep -qxF "client.selected $(hex border.selected) $(hex border.selected) $(hex border.selected) $(hex border.selected) $(hex border.selected)" "$d/$f" || {
              echo "ERROR: $id/$f changed the selected outline, which no answer about the borders touches" >&2; exit 1; }
          done
          for ground in theme backdrop near absolute; do
            f=ghostty-$ground.conf
            case "$ground" in
              theme) want=$(hex terminal.background) ;;
              backdrop) want=$(hex surface.backdrop) ;;
              near) want=$(hex surface.near) ;;
              absolute) want=$absolute ;;
            esac
            grep -qxF "background = $want" "$d/$f" || {
              echo "ERROR: $id/$f does not stand on $want:" >&2; grep '^background' "$d/$f" >&2; exit 1; }
            grep -q '^palette = 15=#' "$d/$f" || {
              echo "ERROR: $id/$f has no sixteenth ANSI colour" >&2; exit 1; }
          done
        done
        echo "OK: every theme carries its fragments — six desks-and-borders, four terminal grounds — each says what its name says, the compositor merges each over a desk already painted, and the static desk and outlines are the default answer's"
      '';

  # GHOSTTY STILL RELOADS ON THE SIGNAL THIS SYSTEM SENDS.
  #
  # "toolkits::wake_the_terminals" sends SIGUSR2 so a size chosen in
  # `LEADER s d` reaches the terminals that are ALREADY OPEN. Without it the
  # new file would only be read by the next window, and the person would have a
  # row of terminals in yesterday's size beside a footer in today's.
  #
  # THE SIGNAL IS NOT IN THE MANUAL. Neither man page mentions USR2; what
  # exists is the string below, in the binary, under Ghostty's own
  # "gtk_ghostty_application" log scope — so this is observed behaviour of the
  # version this system pins, not a promise anybody made. SIGUSR1, which is the
  # signal one would guess, appears nowhere.
  #
  # That is exactly why it needs a check rather than a comment: the day an
  # upgrade drops it, the terminal quietly keeps the old size and nothing else
  # in this repository would notice. Here it goes red and says what to do.
  ghostty-reloads-on-a-signal = mkCheck "ghostty-reloads-on-a-signal" [ pkgs.binutils ] ''
    # The wrapper is a small C program; the Zig binary beside it carries the
    # strings.
    real=${pkgs.ghostty}/bin/.ghostty-wrapped
    test -x "$real" || real=${pkgs.ghostty}/bin/ghostty
    strings -n 8 "$real" > said || { echo "ERROR: could not read $real" >&2; exit 1; }

    grep -q "received SIGUSR2, reloading configuration" said || {
      echo "ERROR: Ghostty ${pkgs.ghostty.version} no longer reloads on SIGUSR2." >&2
      echo "" >&2
      echo "       toolkits::wake_the_terminals sends that signal so a size" >&2
      echo "       chosen in the display view reaches terminals that are" >&2
      echo "       already open. Without it they keep the old size until they" >&2
      echo "       are reopened, and nothing on the screen says why." >&2
      echo "" >&2
      echo "       What to do: find what this version reloads on — a keybind" >&2
      echo "       action reload_config is documented — and change" >&2
      echo "       wake_the_terminals and this check together." >&2
      exit 1; }

    # AND THE SIGNAL IS THE ONE WE SEND. Reading the binary proves nothing if
    # the shell sends a different one, and SIGUSR1 is the guess.
    #
    # THE ARGUMENT, NOT THE WORD, AND WITH THE COMMENTS GONE. The first
    # version of this grepped the file for "USR2" and passed while the shell
    # sent USR1 — because the paragraph explaining the signal says USR2 four
    # times. A rule a sentence can satisfy is worse than no rule.
    . ${shellSh}
    toolkits=$(shell_file toolkits.rs)
    sed 's|//.*||' "$toolkits" | grep -q '"-USR2"' || {
      echo "ERROR: the shell does not send SIGUSR2, so open terminals keep their size" >&2
      exit 1; }

    echo "OK: Ghostty ${pkgs.ghostty.version} reloads on SIGUSR2, and that is what the shell sends"
  '';

  # GHOSTTY WEARS THE THEME: the palette solved for the machine's default, and
  # after it the person's own, optional — AFTER, because in Ghostty the later
  # file wins, and a machine that never chose has no second file at all.
  ghostty-config-includes-theme =
    let
      vm = self.nixosConfigurations.vm.config;
      text = vm.home-manager.users.${vm.ronoctua.user}.xdg.configFile."ghostty/config".text;
    in
    mkCheck "ghostty-config-includes-theme"
      [
        pkgs.gnugrep
        pkgs.ghostty
      ]
      ''
        cfg=${pkgs.writeText "ghostty-config" text}
        grep -n '^config-file = ' "$cfg" > lines || {
          echo "ERROR: Ghostty's config includes no palette" >&2; exit 1; }
        # THREE, AND IN THIS ORDER — the later file wins in Ghostty, so the
        # order IS the precedence: the machine's palette, then the theme the
        # person chose, then the size they chose. A size ahead of the palette
        # would be overwritten by a file that carries no size at all.
        test "$(wc -l < lines)" -eq 3 || {
          echo "ERROR: three config-file lines were expected:" >&2; cat lines >&2; exit 1; }
        # The machine's own palette is the theme's ground (`ghostty-theme.conf`
        # in the generator's output, a store path); the person's copy of the
        # same name, on the next line, is optional and lives in their home.
        sed -n 1p lines | grep -q ':config-file = /nix/store/.*/ghostty-theme\.conf$' || {
          echo "ERROR: the first include is not the generated palette:" >&2; cat lines >&2; exit 1; }
        sed -n 2p lines | grep -q '= ?/home/.*/.config/ronoctua/ghostty-theme.conf$' || {
          echo "ERROR: the second include is not the person's optional theme:" >&2; cat lines >&2; exit 1; }
        # AND THE SIZE, LAST. `LEADER s d` moves one number and the terminal
        # has to move with everything else; `toolkits::tell_them` writes this
        # file. It is separate from the theme's on purpose — that one is copied
        # WHOLE out of the store, so a size written into it would be erased by
        # the next change of theme.
        sed -n 3p lines | grep -q '= ?/home/.*/.config/ronoctua/ghostty-size.conf$' || {
          echo "ERROR: the third include is not the person's optional size:" >&2; cat lines >&2; exit 1; }

        # AND THE SIZE IN THE CONFIG IS THE TOKEN'S, not a number typed twice.
        # `toolkits::tell_them` scales `font::TERMINAL_POINTS`; if the module
        # wrote a different base the terminal would sit at a size of its own.
        grep -qE "^font-size = ${toString (import ../assets/tokens/typography.nix).size.terminalPoints}$" "$cfg" || {
          echo "ERROR: Ghostty's font-size is not font.size.terminalPoints:" >&2
          grep -n '^font-size' "$cfg" >&2; exit 1; }
        palette=$(head -1 lines | sed 's/.*= //')
        grep -qE '^palette = 0=#[0-9A-F]{6}$' "$palette" || {
          echo "ERROR: the generated palette has no ANSI 0: $palette" >&2; exit 1; }

        # AND THE BINARY READS IT. Ghostty's only default path is
        # `$XDG_CONFIG_HOME/ghostty/config`, which is where home-manager puts
        # this text on the machine; here the same layout is built in a scratch
        # home and the EFFECTIVE configuration is asked for — the text alone
        # proves nothing about what the program does with it. (`+show-config`
        # takes no config flags: a `--config-file` route could not be proved.)
        export HOME=$TMPDIR/home XDG_CONFIG_HOME=$TMPDIR/xdg
        mkdir -p "$HOME" "$XDG_CONFIG_HOME/ghostty"
        # THE TWO OPTIONAL INCLUDES ARE ABSOLUTE, with the person's user name
        # baked in at build time, so nothing a sandbox can set redirects them —
        # `docs/PENDING.md` 0.000017 records the same shape for the compositor
        # fragments. Their SPELLING is asserted above, off the module's own
        # text; here they are pointed at this scratch home so the MECHANISM can
        # be measured, which is the half no grep can reach.
        sed "s|= ?/home/[^/]*/\.config/ronoctua/|= ?$HOME/.config/ronoctua/|" "$cfg" \
          > "$XDG_CONFIG_HOME/ghostty/config"
        ghostty +show-config > effective 2> errors.txt || {
          echo "ERROR: Ghostty refused the system's config:" >&2; cat errors.txt >&2; exit 1; }
        grep -q '^window-decoration = none$' effective || {
          echo "ERROR: the decoration line did not reach Ghostty:" >&2; cat effective >&2; exit 1; }
        grep -qiE '^palette = 0=#[0-9a-f]{6}$' effective || {
          echo "ERROR: the palette did not reach Ghostty:" >&2; cat effective >&2; exit 1; }

        # AND THE SIZE THE PERSON CHOSE REACHES IT — MEASURED, not argued.
        #
        # This is the one end-to-end proof in the repository that a size chosen
        # in `LEADER s d` arrives at a foreign application. The shell writes
        # `ghostty-size.conf`; here that file is laid down exactly as
        # `toolkits::tell_them` writes it, and Ghostty is asked what its
        # EFFECTIVE font size is. If the include is wrong, if the order is
        # wrong, or if the later file stops winning, this number does not move.
        #
        # 200% is used because it is the ceiling of the range and doubles a
        # number no rounding can blur.
        base=$(grep '^font-size = ' "$cfg" | sed 's/.*= //')
        want=$(awk -v b="$base" 'BEGIN { printf "%.1f", b * 2 }')
        mkdir -p "$HOME/.config/ronoctua"
        printf '# GENERATED by ronoctua-shell. Do not edit — `LEADER s d` rewrites it.\nfont-size = %s\n' "$want" \
          > "$HOME/.config/ronoctua/ghostty-size.conf"
        ghostty +show-config > doubled 2> errors.txt || {
          echo "ERROR: Ghostty refused the size file:" >&2; cat errors.txt >&2; exit 1; }
        said=$(grep '^font-size = ' doubled | sed 's/.*= //')
        awk -v a="$said" -v b="$want" 'BEGIN { exit (a - b < 0.05 && b - a < 0.05) ? 0 : 1 }' || {
          echo "ERROR: the size the person chose did not reach Ghostty." >&2
          echo "       the file said $want and the binary reports $said" >&2
          echo "" >&2
          echo "       This is what makes the terminal follow LEADER s d. If the" >&2
          echo "       third config-file include, or its order, or the name of" >&2
          echo "       the file changes, the terminal silently keeps its own" >&2
          echo "       size while everything around it moves." >&2
          exit 1; }

        echo "OK: Ghostty reads the system's config, its palette, and the size the person chose ($base -> $said)"
      '';

  # GHOSTTY'S WINDOWS ARE PROCESSES THROUGH EVERY DOOR. The module's config says
  # `gtk-single-instance = false`; the upstream desktop entry says
  # `--gtk-single-instance=true` on its `Exec` lines, and a flag beats the
  # file; its `DBusActivatable=true` sends D-Bus-aware launchers through a
  # service that is single-instance by construction. `nix/modules/terminal.nix`
  # rewrites the entry; this measures the one that is installed, so an
  # upstream change cannot bring either back unseen — and it passes on the day
  # upstream drops them itself.
  ghostty-windows-are-processes =
    let
      package = self.nixosConfigurations.vm.config.ronoctua.terminal.package;
    in
    mkCheck "ghostty-windows-are-processes" [ pkgs.gnugrep ] ''
      entry=${package}/share/applications/com.mitchellh.ghostty.desktop
      test -e "$entry" || { echo "ERROR: no desktop entry at $entry" >&2; exit 1; }
      if grep -q -- 'gtk-single-instance=true' "$entry"; then
        echo "ERROR: the installed Ghostty entry still forces a single instance:" >&2
        grep -n 'Exec' "$entry" >&2
        exit 1
      fi
      if grep -q '^DBusActivatable=true' "$entry"; then
        echo "ERROR: the installed Ghostty entry still offers D-Bus activation, which is single-instance" >&2
        exit 1
      fi
      if test -e ${package}/share/dbus-1/services/com.mitchellh.ghostty.service; then
        echo "ERROR: the single-instance D-Bus service is still installed beside the entry" >&2
        exit 1
      fi
      test "$(grep -c '^Exec=' "$entry")" -ge 1 || {
        echo "ERROR: the rewritten entry lost its Exec line" >&2; exit 1; }
      grep -q '^Exec=/nix/store/.*/bin/ghostty' "$entry" || {
        echo "ERROR: the entry's Exec no longer points at Ghostty's binary:" >&2; grep -n '^Exec' "$entry" >&2; exit 1; }
      echo "OK: Ghostty's desktop entry opens a process per window, as the config says"
    '';

  # FOREIGN APPLICATIONS WEAR THE THEME'S SIDE, in the three places the toolkits
  # ask: GTK's two `settings.ini`, the settings portal's dconf, Qt's style.
  #
  # IT USED TO ASSERT A CONSTANT, and the constant was right nine times out of
  # nine — every theme was dark, so `prefer-dark` was both the answer and the
  # only answer. `flashbang` is the tenth and it is light, so what this has to
  # say is a RELATION: the three places agree with each other, and all three
  # agree with the `mode` fragment the generator wrote for the declared theme.
  # Written as a constant it would now be a check that passes while every
  # foreign window on a light desktop stays black.
  #
  # BOTH SIDES ARE BUILT, and that is the half that makes it a relation rather
  # than a coincidence: the system is evaluated twice, once with a dark theme
  # and once with the light one, and the answers have to differ.
  foreign-apps-prefer-dark =
    let
      dressed =
        name:
        let
          vm =
            (self.nixosConfigurations.vm.extendModules {
              modules = [ { ronoctua.theme = name; } ];
            }).config;
          scheme = lib.findFirst (v: v != null) null (
            map (
              db: db.settings."org/gnome/desktop/interface".color-scheme or null
            ) vm.programs.dconf.profiles.user.databases
          );
        in
        {
          inherit name scheme;
          mode = lib.removeSuffix "\n" (builtins.readFile "${themed}/${name}/mode");
          gtk3 = pkgs.writeText "gtk3-${name}" vm.environment.etc."xdg/gtk-3.0/settings.ini".text;
          gtk4 = pkgs.writeText "gtk4-${name}" vm.environment.etc."xdg/gtk-4.0/settings.ini".text;
          qt = if vm.ronoctua.foreign.qt then toString vm.qt.style else null;
        };
      # A dark one and the light one. Named by their MODE and not by their ids,
      # so the day another light theme is added this picks one of each on its
      # own rather than going on asserting something about two names.
      byMode = lib.groupBy (id: lib.removeSuffix "\n" (builtins.readFile "${themed}/${id}/mode")) themes;
      sides = map dressed [
        (builtins.head (byMode.dark or [ ]))
        (builtins.head (byMode.light or [ ]))
      ];
      says = one: ''
        echo "-- ${one.name} (${one.mode})"
        for f in ${one.gtk3} ${one.gtk4}; do
          test "$(grep -c '^\[Settings\]$' "$f")" -eq 1 || {
            echo "ERROR: $f has not exactly one [Settings] header" >&2; exit 1; }
          grep -q "^gtk-application-prefer-dark-theme=${if one.mode == "dark" then "1" else "0"}$" "$f" || {
            echo "ERROR: $f does not wear ${one.mode}" >&2; grep -n 'prefer-dark' "$f" >&2; exit 1; }
        done
        test "${toString one.scheme}" = "${
          if one.mode == "dark" then "prefer-dark" else "prefer-light"
        }" || {
          echo "ERROR: dconf answers ${toString one.scheme} to the portal for a ${one.mode} theme" >&2; exit 1; }
        ${lib.optionalString (one.qt != null) ''
          test "${one.qt}" = "${if one.mode == "dark" then "adwaita-dark" else "adwaita"}" || {
            echo "ERROR: Qt's style is ${one.qt} for a ${one.mode} theme" >&2; exit 1; }
        ''}
      '';
    in
    mkCheck "foreign-apps-prefer-dark" [ pkgs.gnugrep ] ''
      ${lib.optionalString (byMode.dark or [ ] == [ ] || byMode.light or [ ] == [ ]) ''
        echo "ERROR: this check needs one theme of each mode to compare; the fragments name only one side." >&2
        exit 1
      ''}
      ${lib.concatStringsSep "\n" (map says sides)}
      echo "OK: GTK, the portal and Qt wear the declared theme's own side — measured on one of each"
    '';

  # ===================================================================
  # INVARIANT 18 — every NAME is English; every COMMENT is English too.
  #
  # The `AGENTS.md` already said "identifiers in English" and it was never met:
  # there were 54 ids, 90 checks, ~35 files and 358 keys in Portuguese. A rule
  # with no check is a recommendation, and a recommendation is what produced
  # that distance between what the repository asserts and what it does.
  #
  # WHY A DENY LIST, AND NOT "detect Portuguese"
  # --------------------------------------------
  # Detecting a language in general is impossible in a check. Refusing EXACTLY
  # the words that have already been here is possible, honest, and it is what
  # stops the regression — which is the real risk: someone adds `rede-abrir`
  # again out of habit.
  #
  # IT SWEEPS NAMES, NOT PROSE. It looks at: file paths, the `.ftl` key column,
  # and — since the identifier pass — every Rust declaration: `fn`, `struct`,
  # `enum`, `trait`, `const`, `static` and `mod`.
  #
  # It does NOT sweep comments, and that is not because they are exempt —
  # the owner moved them to English, so the second half of the invariant now
  # covers only the four documents, the key VALUES and the search tags.
  # Detecting "this comment is in Portuguese" is the same impossible
  # language detection the deny list exists to avoid; what guards the
  # comments is the sweep that translated them, not a check.
  #
  # THE DECLARATION IS READ ON ITS OWN LINE, and the sweep is deliberately
  # blind to a use: `let rede = …` is not caught here. Catching every local
  # would mean parsing Rust, and a check that needs a parser to be right is a
  # check that goes wrong on its own. What it does catch is what OTHER code
  # sees — and that is where a Portuguese name spreads from.
  english-names = mkCheck "english-names" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # The stems this refactor removed. Adding here is cheap; taking one out
    # requires explaining why the word became acceptable again.
    FORBIDDEN = [
         "aberto", "abrir", "acao", "achada", "achados", "achou", "acoes",
         "carga", "criar", "globais", "leitura", "ordens",
         "abaixo", "acha", "achado", "acorde", "acordes", "alca", "alta", "alternar",
         "andando", "apagar", "arredondar", "atencao", "ativar", "atuais", "atual",
         "atualizando", "aviso", "barra", "branco", "bruta", "cabem", "caixa",
         "caixas", "candidatas", "caractere", "carinhas", "casa", "casal", "cerebro",
         "completos", "componente", "conexao", "conexoes", "conj",
         "contando", "copia", "copias", "custo", "dedo", "degrau", "desde", "desenhado",
         "dicas", "diferentes", "digita", "direto", "diretorio", "documento",
         "eixo", "embutido", "empurrar", "enormes", "envio", "erros", "escalada",
         "escopo", "escravo", "esq", "estende", "estilo", "estranho", "exclusiva",
         "exigida", "existente", "faltam", "fator", "fileira", "focado", "gatilho",
         "gerenciador", "grande", "grego", "identificador", "imagem", "indicador",
         "inexistente", "inicial", "instala", "instalar", "interno", "iteracao",
         "ligacoes", "ligado", "linguagem", "lupa", "marcador", "mau", "melhor",
         "mentes", "metodo", "metrica", "meu", "migalha", "minusculo", "moldagem",
         "montar", "mudou", "nascimento", "nivel", "nulo", "ocupados", "oferta",
         "onde", "ordenados", "orfaos", "ouvinte", "palavra", "parado", "pedido",
         "pendente", "pequeno", "pintou", "piscando", "piso", "pode", "postos",
         "postura", "preciso", "preparo", "preparos", "preto", "primeira", "procurando",
         "producao", "pronta", "realcadas", "recebimento", "recurso", "resolvido",
         "secao", "segunda", "selagem", "setas", "sistema", "sobreviventes",
         "subfiltros", "sujo", "tecla", "tentar", "termo", "trabalho", "tres",
         "treze", "trocada", "unicos", "usadas", "valores", "velho", "venceu",
         "vivas", "vizinha",
         "afinar", "agente", "agulha", "ajuda", "altura", "alvo", "anotacao",
         "anunciar", "aplicar",
         "anterior", "antes", "antigo", "argumento", "arquivo", "arquivos",
         "arrastar", "arvore", "atribuicao", "avanco", "baixo", "banda",
         "binario", "bloco", "bruto", "busca", "cadeia", "camada", "caminho",
         "capacidade", "captura", "capturando", "capturar", "carimbo", "caso",
         "comecar",
         "casou", "catalogo", "categoria", "categorias", "celula", "chave",
         "chaves", "cima", "cliente", "cobertura", "cofre", "colado",
         "colisao", "colocado", "coluna", "colunas", "comandar", "comando",
         "comandos", "combinante", "completa", "conectar", "configuracao",
         "conjunto", "contexto", "contrato", "controlar", "copiar", "cor",
         "corridas", "declarada", "depois", "desconectar", "descritor",
         "desloc", "detalhe", "diagnostico", "diario", "dimensoes", "direita",
         "discos", "dispositivo", "dispositivos", "dito", "dominio", "eco",
         "efeito", "efeitos", "elemento", "elidir", "emergencia", "encaixe",
         "encerrar", "encolhe", "enrolar", "entalhes", "entrada", "escala",
         "escrita", "escutar", "esperada", "esperado", "esquecer", "esquerda",
         "estado", "estatico", "estrangeiro", "eventos", "executar",
         "executar", "expandido", "expansao", "fabrica", "falhou", "falta", "faltando",
         "familia", "fechar", "ficha", "fila", "filhos", "filtro", "fluxo",
         "fonte", "fontes", "fora", "fragmento", "frase", "frequencia",
         # THE SIX A REVIEW FOUND that no stem and no ending caught: a local
         # in a build script (`dentro`), and five words inside `assert!`,
         # `bail!` and test fixtures — all of them places invariant 18 names.
         "dentro", "toques", "viraram", "terminam", "termina", "digite",
         "fundo", "gesto", "glifo", "glifos", "grade", "grafico", "gravada",
         "grupo", "guarda", "guardar", "heranca", "hospedeiro", "icone",
         "icones", "idioma", "imagens", "impermanencia", "instalador",
         "instanciar", "interatividade", "interativo", "janela", "juntos", "lado",
         "lancamento", "largo", "largura", "legivel", "levar", "lido",
         "ligacao", "limite", "limites", "limpar", "linha", "linhas",
         "localizador", "marca", "meio", "modelo", "modo", "morreu", "morto",
         "motor", "mover", "navegacao", "navegador", "nome", "nomes",
         "notificacao", "novo", "observador", "opcao", "orcamento", "ordem",
         "origem", "outra", "pacote", "padrao", "padroes", "painel", "partes",
         "passo", "passos", "pedaco", "pedacos", "pendencia", "perfil",
         "perfis", "pergunta", "pintura", "plano", "politica", "posicao",
         "prefixo", "preludio", "presente", "primeiro", "programa", "proibido",
         "proximo", "puxar", "quantos", "raiz", "ramo", "recarrega",
         "reconstruir", "rede", "redesenhar", "repeticao", "resolucao",
         "revarrer", "rodape", "rolagem", "rotulo", "ruim", "saida", "sair",
         "segmento", "segmentos", "segredo", "segundo", "selar", "senha",
         "sequencia", "servidor", "sigilo", "simbolo", "simbolos", "sobrando",
         "sobrou", "sono", "sorteia", "sorteio", "subida", "subir",
         "superficie", "surdo", "tabela", "tam", "tamanho", "teclado", "tela",
         "tema", "teto", "texto", "textos", "tipografia", "topo", "trecho",
         "trechos", "ultima", "ultimo", "unidade", "urgencia", "usuario",
         "valido", "valor", "variante", "variavel", "varrer", "vazia", "vazio", "versao",
         "vetorial", "vigia", "visao", "vista", "visto", "vivo", "volta",
         "voltou",
         # AND WHAT THE 2026-09-03 SWEEP FOUND that no ending can reach. A word
         # like `completo`, `registro` or `fim` has ordinary Portuguese shape
         # and ordinary Latin endings; only a list catches those, and each one
         # here was a real name or a real message in this tree on that day.
         "acentuados", "alguem", "aninhado", "apelido", "candidato", "coisa",
         "completo", "conteudo", "desmontar", "fase", "fim", "funil", "girar",
         "laco", "livre", "mostra", "ninguem", "pedir", "pessoa", "rasterizar",
         "reiniciar", "registro", "relogio", "responder", "salvar", "seguro",
         "sessao", "tolerante", "trocar", "tudo",
    ]
    RX = re.compile(r"(?<![a-z])(" + "|".join(FORBIDDEN) + r")s?(?![a-z])")

    # AND THE SHAPE OF A WORD, because a list is finite and Portuguese is not.
    #
    # Every stem above had to be SEEN before it could be listed, and the sweep
    # the owner asked for found thirteen identifiers and a hundred and fifty
    # messages whose stems simply were not on it: `pronto_tx`,
    # `doze_acentuados`, `IdDuplicado`, `n_motores`, `com_tags`, `fase`,
    # `lidas`, `mostra`. No amount of adding closes that; an ENDING does.
    #
    # These are the endings no English word takes — with the handful that do
    # underneath, because `avocado` and `crescendo` are English and a ruler
    # that does not know it would be a ruler nobody could keep green.
    #
    # `-ou` AND `-ei` ARE THE PAST TENSE, and they were missing: `escapou`
    # sat inside an `assert!` message for weeks with every check green, which
    # is what a ruler with a hole in it looks like. English takes both endings
    # (`you`, `sound`, `their`), so the list underneath had to grow with them
    # — that is the price, and it is one line per word.
    MORPH = re.compile(
        r"(?<![a-zà-ü])[a-zà-ü]{3,}"
        r"(?:ção|ções|cao|coes|mente|ência|encia|ância|ancia"
        r"|agem|idade|ndo|ado|ada|ados|adas|ido|ida|idos|idas"
        # `-MENTO`, one of the commonest noun endings in the language, and it
        # was not here. `deslocamento` sat in an assertion in the renderer and
        # the ruler read straight past it — found the day the check learned to
        # read a MESSAGE, which is the only reason anybody looked.
        r"|mento|mentos"
        # THE PLURALS OF THE THREE ABOVE, which were not: the group ends in
        # `(?![a-zà-ü])`, so the `s` blocks the singular from ever matching.
        # `ocorrencias` sat in a generator through every green battery for
        # exactly that reason, while `ocorrencia` would have been caught.
        r"|encias|ências|ancias|âncias|agens|idades"
        # THE DIMINUTIVE, and the compounds that end in one: `entrelinha` sat
        # in a signature because `FORBIDDEN`'s `linha` wants a word boundary
        # in front of it and there is an `l` there instead. No English word
        # ends in any of these four.
        r"|inha|inho|inhas|inhos"
        # THE IMPERFECT, which was missing and let a whole tense through:
        # `deviam`, `cabiam`, `estavam`. `-aram|-eram|-iram` above are the
        # PERFECT, and an assertion says what a thing OUGHT to do far more
        # often than what it did. Three letters have to come before, so
        # `priam` and the like do not reach it.
        r"|iam|avam"
        r"|ou|ei|eu|iu|aram|eram|iram)"
        r"(?![a-zà-ü])"
    )
    # Adding here is cheap and each one is a word this tree really uses;
    # taking one out means claiming English stopped having it.
    NOT_PORTUGUESE = {
        "avocado", "tornado", "tornados", "desperado", "bravado", "aficionado",
        "dorado", "colorado", "crescendo", "innuendo", "commando", "commandos",
        "cacao", "armada", "florida", "canada", "silverado", "eldorado",
        # THE ENGLISH WORDS THAT END IN `-ou`, `-ei`, `-eu` OR `-iu`. Every
        # one of them is in this tree; the ruler above is worth the list.
        "you", "your", "yours", "thou", "sou", "lieu", "milieu", "adieu",
        "bureau", "plateau", "tableau", "trousseau", "nouveau", "queue",
        "seiei", "their", "theirs", "seize", "seizure", "beige", "feint",
        "neighbour", "neighbours", "weird", "either", "neither", "leisure",
        "protein", "caffeine", "codeine", "eight", "eighth", "eighty",
        "height", "weight", "freight", "sleigh", "veil", "vein", "reign",
        "foreign", "sovereign", "counterfeit", "forfeit", "surfeit",
        # AND THE NAMES OF THINGS. `COLLADA` is a 3D format this tree reads,
        # and `-ada` is its last three letters by accident. `Kannada` is a
        # WRITING SYSTEM, named in the fallback chain beside thirty-six others,
        # and it is in the same accident — the ruler reads `-ada` as a
        # Portuguese participle.
        "collada", "kannada",
    }
    # THE TWO PROSE RULERS, and they are read by two passes.
    #
    # They lived beside pass 9, which is the only place that used them —
    # and pass 7, which reads every comment in this tree, was left asking
    # the NAME ruler about a SENTENCE. They are here, above both readers,
    # so that one cannot have a ruler the other has not.
    #
    # TWO RULES, because Portuguese slips in two ways.
    #
    # GRAMMAR: a sentence in Portuguese carries a function word, and the ones
    # below have no English homograph. `do` and `no` and `a` are left out for
    # exactly that reason — "do not run" and "no such file" are English.
    #
    # VOCABULARY: a one-word message has no grammar to catch. So the verbs and
    # nouns that were removed are listed, the same bargain `FORBIDDEN` above
    # already makes: adding one is cheap, and taking one out has to be argued.
    GRAMMAR = re.compile(
        r"(?:^| )(da|das|na|nas|ao|aos|uma|umas|pelo|pela|não|nao|são|sao"
        r"|sem|que|com|para|foi|pra|nem"
        # `em`, `dos`, `nos` and the demonstratives, added after a review
        # found three Portuguese assertions this pass could not see: "o
        # progresso termina EM 100%", "OS sete toques viraram". `do`, `no`
        # and `a` stay out for the reason above — they are English words.
        # `numa` is `em`+`uma` CONTRACTED, and the rule above cannot see it:
        # it asks for a space before `uma`, and there is an `n` there. "caber
        # numa pagina" went through every green battery.
        #
        # `num` STAYS OUT, and that is the whole reason this note names it: it
        # is an ordinary English abbreviation ("num rows", "the num of items"),
        # so putting it here would report correct English as Portuguese. The
        # feminine has no such twin.
        r"|dos|este|esta|isso|seus|suas|numa|numas|como)(?: |$)"
        # `em` NEEDS ITS OWN RULE, because it is also the typographic unit:
        # "0.600 em at the normal width" is English about a measurement. So it
        # counts only when a NUMBER does not come before it. `nos` is left out
        # entirely — the Unicode database has a field by that name.
        #
        # AND A NUMBER IS NOT THE ONLY THING THAT COMES BEFORE IT. Written out,
        # the unit takes an English determiner instead: "an em dash", "a full
        # em", "thousandths of an em", "1000 units per em". Six comments in
        # this tree say one of those, and they are correct English — the day
        # this pass started reading prose they all came back as Portuguese at
        # once, which is the shape of a ruler being wrong rather than six files
        # being wrong. Portuguese never puts any of these words before `em`.
        r"|(?<![0-9])(?<!\ban)(?<!\bthe)(?<!\bof)(?<!\bper)(?<!\bone)"
        r"(?<!\bfull)(?<!\bhalf)(?:^| )em(?: |$)"
    )
    VOCABULARY = re.compile(
        r"(?<![a-z])(ler|mudar|abrir|criar|gravar|apagar|mover|copiar|verbo|dono"
        r"|senha|invalido|desconhecid[oa]|duplicar|esvaziar|clonar|esperar"
        r"|consultar|pendurar|recusou|recusa|saiu|devolver|recriar|ajustar"
        r"|renomear|permissao|inicio|contagem|devia|fechou|abriu|mostrando"
        r"|hospedar|mandar|rodar|codificar|geracao|atualizacao|mestre|espacos"
        r"|colar|folga|escolheu|pediu|verificado|bandeira|distingue|uso"
        r"|diferencial|fatos|resgate|passou|razao|confirmacao|subiu|desceu"
        r"|nasceu|interruptor|clicar|avancou|modificador|sumiu|ausente|diferenca"
        r"|esperava|virou|tela|erro|linha|arquivo|pasta|qualquer"
        # AND THE ONES A REVIEW FOUND IN ASSERTIONS. An `assert!`'s message is
        # what a person reads when a battery goes red at three in the morning,
        # and invariant 18 names `assert` explicitly.
        r"|termina|terminam|progresso|toques|viraram|digite|glifo|glifos"
        # AND THE ONES OF THE SENTENCE THAT ESCAPED ALL THREE RULERS:
        # "dez itens deviam caber numa pagina". `devia` was already here and
        # did not reach `deviam`, because of the `(?![a-z])` that ends this
        # group — an ending needs the MORPH rule above, not this one.
        r"|deve|devem|deviam|itens|caber|pagina|paginas"
        # "o editor roda como a pessoa": the whole sentence was function words
        # and these two, and no ruler had either.
        r"|pessoa|pessoas|roda)(?![a-z])"
    )


    def portuguese(text):
        """The first Portuguese word in `text`, by the list OR by the ending."""
        m = RX.search(text)
        if m:
            return m.group(0)
        for m in MORPH.finditer(text):
            if m.group(0).lower() not in NOT_PORTUGUESE:
                return m.group(0)
        return None

    # AND A LINE MAY SAY WHY IT IS PORTUGUESE, and then it is.
    #
    # Four kinds of Portuguese belong in code, and all four are DATA: the VALUE
    # of a pt-BR key that a test asserts (`*sem nome*`), a search tag the
    # lexicon has to find (`seta para cima`), a fixture whose SUBJECT is the
    # accent (`let ação = 1;` for the highlighter), and the pt-BR half of a
    # generated table. Telling them apart from a slip is not something a list
    # in this file can do — the reason lives where the string is, so that is
    # where the note goes.
    ALLOWED = re.compile(r"(?://|#)\s*pt-BR:")

    def allowed_at(lines, first, last=None):
        """A `pt-BR:` note on the line, on the one above, or inside the span."""
        last = first if last is None else last
        return any(
            ALLOWED.search(lines[i])
            for i in range(max(0, first - 3), min(len(lines), last))
        )

    # Every Rust declaration that becomes a name OTHER code can see.
    DECL = re.compile(
        r"^\s*(?:pub(?:\([^)]*\))?\s+)?(?:async\s+|unsafe\s+|const\s+|extern\s+\S+\s+)*"
        r"(fn|struct|enum|trait|type|const|static|mod)\s+([A-Za-z_][A-Za-z0-9_]*)"
    )

    # PROSE: this check's subject IS the prose. Invariant 18 is about the
    # WORDS — a comment, a message, a flag's help — so the comments are read on
    # purpose and a stripper over the tree would take away most of what it
    # exists to examine. Where a pass is about NAMES instead, it strips the
    # line itself, one language at a time (`//` for Rust, `#` for Nix and
    # Python), which is the only correct way to do it here: the marker belongs
    # to the language, and a `#` inside a Rust string is not a comment.
    # FILE-WIDE: a Portuguese word anywhere in any file of the tree is the
    # offence, which is the whole of what the invariant says.
    root_dir = pathlib.Path("${self}")
    gaps = []
    swept = 0

    # 1) FILE AND DIRECTORY NAMES
    for p in root_dir.rglob("*"):
        if any(x in p.parts for x in (".git", "result", "target", ".direnv")):
            continue
        if portuguese(p.name.lower().replace("_", "-")):
            gaps.append(f"file: {p.relative_to(root_dir)}")

    # 2) THE .ftl KEY COLUMN — the value stays in pt-BR, only the name changes
    for ftl in pathlib.Path("${texts}").glob("*.ftl"):
        for n, line in enumerate(ftl.read_text().splitlines(), 1):
            m = re.match(r"^([a-z][a-z0-9-]*) *=", line)
            if m and portuguese(m.group(1)):
                gaps.append(f"key: {ftl.name}:{n}: {m.group(1)}")

    # 3) RUST DECLARATIONS — the half of the invariant the identifier pass closed
    #
    # A VARIANT IS A DECLARATION TOO, and reading only `enum Foo` missed it:
    # `Question::Senha`, `Question::Idioma` and `Question::WifiSenha` came through
    # the whole identifier refactor untouched, because the line that names them
    # has no keyword on it — just an indented capitalized word.
    VARIANT = re.compile(r"^\s+([A-Z][A-Za-z0-9_]*)\s*(?:[,({=]|$)")
    # A FIELD IS A DECLARATION TOO, and the same blind spot: the line that names
    # it carries no keyword, only an indented lowercase word and a colon. That is
    # how `Minibuffer.segredo` came through the whole identifier refactor.
    FIELD = re.compile(r"^\s+(?:pub(?:\([^)]*\))?\s+)?([a-z_][a-z0-9_]*)\s*:")
    # A `let` IS A NAME, and this check never read one.
    #
    # It read declarations, fields and variants — everything with a keyword in
    # front of it — so sixteen Portuguese bindings lived in `surface.rs` and
    # `browser.rs` through the whole identifier refactor and through every green
    # battery since: `barra_visivel`, `total_expansao`, `fracao`, `fundos`,
    # `proporcao`, `quantos`, `clicou`, `menor`, `margem`, `realce_do_ponteiro`.
    # The owner found them by reading a plan, not the code, and he was right
    # that a rule nothing enforces is not a rule.
    #
    # A `let` is scoped and short-lived, which is exactly why it is where a
    # language slips back in.
    # A BINDING IS A PATTERN, not a word. `let (tx_nome, rx_nome) = channel()`
    # names two things and matches no regex that expects an identifier right
    # after the keyword, which is why a simpler version of this check read the
    # line and saw nothing. Walk the pattern instead, and take every lowercase
    # name in it: `for` binds the same way and gets the same walk.
    OPENS = re.compile(r"\b(?:let|for)\b")
    WORD = re.compile(r"[a-z_][a-z0-9_]*")
    PATTERN_NOISE = {"mut", "ref", "in", "let", "for", "if", "else"}

    def bound_names(code):
        """Every name a `let` or a `for` on this line binds."""
        for kw in OPENS.finditer(code):
            i, depth = kw.end(), 0
            start = i
            while i < len(code):
                c = code[i]
                if c in "([{<":
                    depth += 1
                elif c in ")]}>":
                    depth -= 1
                # A TYPE IS NOT A BINDING, and neither is the value: the
                # pattern ends at the first `=` or `:` outside any bracket.
                elif depth == 0 and (c == "=" or c == ":"):
                    break
                elif depth == 0 and code[i : i + 4] == " in ":
                    break
                i += 1
            for w in WORD.finditer(code[start:i]):
                if w.group(0) not in PATTERN_NOISE:
                    yield w.group(0)

    # AND A `fn` AND ITS ARGUMENTS. `DECL` below already reads the free
    # functions, but not a method inside an `impl` and not one parameter of
    # either — which is how `colunas_da_tela` and `altura_da_tela` sat in the
    # signature of a function whose own name was English.
    def top_level(text):
        """The comma-separated pieces of a parameter list, brackets respected."""
        out, piece, depth = [], [], 0
        for ch in text:
            if ch in "([{<":
                depth += 1
            elif ch in ")]}>":
                if depth == 0:
                    break
                depth -= 1
            if ch == "," and depth == 0:
                out.append("".join(piece))
                piece = []
                continue
            piece.append(ch)
        out.append("".join(piece))
        return out

    FN_NAME = re.compile(r"\bfn\s+([a-z_][a-z0-9_]*)")
    FN_ARGS = re.compile(r"\bfn\s+[a-z_0-9]*\s*(?:<[^>]*>)?\s*\((.*)")
    ARG = re.compile(r"^\s*(?:mut\s+)?([a-z_][a-z0-9_]*)\s*:")
    for base in ("crates", "buffers"):
        for rs in (root_dir / base).rglob("*.rs"):
            if "target" in rs.parts:
                continue
            in_enum = 0
            in_struct = 0
            for n, line in enumerate(rs.read_text().splitlines(), 1):
                # WHAT IS INSIDE A STRING OR A COMMENT IS NOT A NAME. The six
                # documents are pt-BR by decision, and so is the text of a test's
                # assertion; only the identifier is bound by invariant 18.
                code = line.split("//")[0]
                if '"' in code:
                    code = re.sub(r'"[^"]*"', '""', code)
                for bound in bound_names(code):
                    if portuguese(bound.lower().replace("_", "-")):
                        rel = rs.relative_to(root_dir)
                        gaps.append(f"let: {rel}:{n}: {bound}")
                fname = FN_NAME.search(code)
                if fname:
                    word = fname.group(1).lower().replace("_", "-")
                    if portuguese(word):
                        rel = rs.relative_to(root_dir)
                        gaps.append(f"fn: {rel}:{n}: {fname.group(1)}")
                fargs = FN_ARGS.search(code)
                if fargs:
                    # One line, and the arguments that fit on it: a signature
                    # broken over several lines still shows every name after a
                    # comma, and each of those is read as its own field below.
                    #
                    # SPLIT AT DEPTH ZERO, not at the first bracket. It used to
                    # cut at the first `)` in the text, and in
                    # `fn aligned_tops(spans: &[(u16, f32)], line_height: f32)`
                    # that `)` closes the TUPLE — so the pass read one argument
                    # of two and `entrelinha` sat in the signature of a
                    # function whose own name was English.
                    for piece in top_level(fargs.group(1)):
                        a = ARG.match(piece)
                        if a:
                            word = a.group(1).lower().replace("_", "-")
                            if portuguese(word):
                                rel = rs.relative_to(root_dir)
                                gaps.append(f"arg: {rel}:{n}: {a.group(1)}")
                m = DECL.match(line)
                if m:
                    # CamelCase and SNAKE_CASE become the same ruler as the file name.
                    item_name = re.sub(r"(?<!^)(?=[A-Z])", "-", m.group(2)).lower().replace("_", "-")
                    if portuguese(item_name):
                        rel = rs.relative_to(root_dir)
                        gaps.append(f"{m.group(1)}: {rel}:{n}: {m.group(2)}")
                    in_enum = 1 if m.group(1) == "enum" else 0
                    in_struct = 1 if m.group(1) == "struct" else 0
                    continue
                if line.startswith("}"):
                    in_enum = 0
                    in_struct = 0
                    continue
                if in_struct:
                    f = FIELD.match(line)
                    if f:
                        item_name = f.group(1).replace("_", "-")
                        if portuguese(item_name):
                            gaps.append(f"field: {rs.relative_to(root_dir)}:{n}: {f.group(1)}")
                    continue
                if not in_enum:
                    continue
                # The body ends at the closing brace in column 0.
                if line.startswith("}"):
                    in_enum = 0
                    continue
                v = VARIANT.match(line)
                if not v:
                    continue
                item_name = re.sub(r"(?<!^)(?=[A-Z])", "-", v.group(1)).lower().replace("_", "-")
                if portuguese(item_name):
                    gaps.append(f"variant: {rs.relative_to(root_dir)}:{n}: {v.group(1)}")

    # 4) NIX AND PYTHON DEFINITIONS
    #
    # `english-names` used to stop at Rust, and the build layer drifted out of
    # sight behind it: `fonteEmoji`, `versaoDeclarada`, `hostGrafico`, plus every
    # variable inside the VM tests' embedded scripts. A `let` binding and a shell
    # assignment are names too, and this is the ruler that reaches them.
    # A NIX ATTRIBUTE IS ALLOWED A HYPHEN, and reading only `[A-Za-z0-9_]` is
    # how `fontconfig-completo` sat in `flake.nix` through every green battery
    # this repository has run: the class stopped at `fontconfig`, the `=` was
    # never reached, and the line simply did not match. Python has no hyphen in
    # an identifier, so widening the class costs that half nothing.
    # AND A PYTHON CLASS, which the build's own scripts declare (a unit
    # test's `class Keeps`, 2026-10-12): a name other code sees, like a `def`.
    DEF = re.compile(
        r"^\s*(?:def\s+([A-Za-z_][A-Za-z0-9_]*)\s*\("
        r"|class\s+([A-Za-z_][A-Za-z0-9_]*)\s*[(:]"
        r"|([A-Za-z_][A-Za-z0-9_-]*)\s*=(?!=))"
    )
    for suf in ("*.nix", "*.py"):
        for f in root_dir.rglob(suf):
            if any(x in f.parts for x in (".git", "result", "target", ".direnv")):
                continue
            swept += 1
            for n, line in enumerate(f.read_text(errors="replace").splitlines(), 1):
                # Prose, not a definition: `fontes (passa de 1 GB)` inside a
                # comment matches the same shape as a call.
                if line.lstrip().startswith(("#", "//")):
                    continue
                m = DEF.match(line)
                if not m:
                    continue
                got = m.group(1) or m.group(2) or m.group(3)
                item_name = re.sub(r"(?<!^)(?=[A-Z])", "-", got).lower().replace("_", "-")
                if portuguese(item_name):
                    gaps.append(f"def: {f.relative_to(root_dir)}:{n}: {got}")

    # 4b) THE MANIFESTS' NAMES. A TOML key is a name a build reads — the
    # build's own metadata (`[package.metadata.ronoctua]`: `env`, `run-env`,
    # `beside`, `data`, `bins` and the roles it gives, `[workspace.metadata.
    # ronoctua] build-features`), a feature, a profile, a dependency's alias —
    # and a role is a word the units' builder reads. Every table header,
    # every key (an inline table's too) and every role, in every `.toml`.
    TOML_HEADER = re.compile(r"^\s*\[\[?\s*([^\]]+?)\s*\]\]?\s*$")
    TOML_KEY = re.compile(r'(?:^|[{,])\s*"?([A-Za-z0-9_.-]+)"?\s*=')
    ROLE = re.compile(r'"[^"]+"\s*=\s*"([a-z-]+)"')
    tomls = 0
    for f in sorted(root_dir.rglob("*.toml")):
        if any(x in f.parts for x in (".git", "result", "target", ".direnv")):
            continue
        # The lexicon is search vocabulary (an English word and its pt-BR
        # tags), which invariant 18 leaves in both languages: no name.
        if f.relative_to(root_dir).parts[:2] == ("assets", "lexicon"):
            continue
        tomls += 1
        for n, line in enumerate(hashless(f.read_text(errors="replace")).splitlines(), 1):
            h = TOML_HEADER.match(line)
            names = [p.strip('"') for p in h.group(1).split(".")] if h else TOML_KEY.findall(line)
            if not h and line.lstrip().startswith("bins"):
                names += ROLE.findall(line)
            for name in names:
                for part in name.split("."):
                    if portuguese(part.lower().replace("_", "-")):
                        gaps.append(f"toml: {f.relative_to(root_dir)}:{n}: {part}")
    floor(tomls, 80, "TOML files swept for a name")

    # 5) THE CLI'S SUBCOMMANDS
    #
    # These live as STRINGS in a `match` arm, so no declaration rule reaches
    # them: `comando`, `satelite`, `verificar-keymap` and `exportar-binds-the compositor`
    # went through the whole refactor untouched. They are commands, which
    # invariant 18 names explicitly.
    for rs in (root_dir / "crates").rglob("main.rs"):
        if "target" in rs.parts:
            continue
        for n, line in enumerate(rs.read_text().splitlines(), 1):
            for m in re.finditer(r'Some\("([a-z][a-z0-9-]*)"\)', line):
                if portuguese(m.group(1)):
                    gaps.append(f"subcommand: {rs.relative_to(root_dir)}:{n}: {m.group(1)}")

    # 6) THE CLI'S FLAGS
    #
    # A flag is a NAME — it is what a person types and what a script writes —
    # and no rule above sees it: it lives as a bare string compared with `==`,
    # in any file, not only `main.rs`. `--executar` survived the whole refactor
    # in the installer AND in three places that documented it, while the very
    # docstring of the file that defined it already said `--run_command`. The
    # code and its own documentation disagreed, and nothing could say so.
    for rs in (root_dir / "crates").rglob("*.rs"):
        if "target" in rs.parts:
            continue
        for n, line in enumerate(rs.read_text().splitlines(), 1):
            for m in re.finditer(r'"--([a-z][a-z0-9-]*)"', line):
                if portuguese(m.group(1)):
                    gaps.append(f"flag: {rs.relative_to(root_dir)}:{n}: --{m.group(1)}")

    # 7) COMMENTS — the half of the invariant the message already claimed
    #
    # Invariant 18 says NAME, COMMENT and COMMIT, and the failure message below
    # said so too. The check did not: every pass above skips comment lines on
    # purpose, because prose has the same shape as a call. So a whole file of
    # Portuguese comments went in without a word — `tests/slow.nix` and
    # `tests/quick.nix` were written that way, and so were four blocks that had
    # been sitting in `nix/modules/base.nix`, `nix/modules/host.nix`,
    # `nix/git-hooks.nix` and this very file.
    #
    # Two things make prose testable with the same word list:
    #
    #   * COMMENT RUNS ARE JOINED. A backtick span often opens on one line and
    #     closes on the next, and line-by-line stripping leaves half a quoted
    #     identifier looking like Portuguese prose.
    #   * WHAT IS QUOTED DOES NOT COUNT. An English comment naming
    #     `Question::Senha` or the chapter `1. Fontes, glifos e icones` is
    #     correct English about a Portuguese thing. Backticks and double quotes
    #     come out before the ruler is applied.
    #
    #     AND THAT IS A REAL HOLE, measured: a whole Portuguese SENTENCE in
    #     quotes walks through it, and three did for a round — a rule quoted
    #     out of `AGENTS.md`, which has an English statement available and now
    #     carries it. It is left open deliberately. 113 comment runs in this
    #     repository quote the OWNER verbatim, and those words are evidence:
    #     "ela acaba desaparecendo e mudando de tamanho" is what a person said
    #     about a picture, and translating it would destroy the thing the
    #     comment exists to record. A ruler that told a citation from a
    #     sentence would have to know which, and nothing here can. What is
    #     asked of a writer instead: cite a RULE in English and a PERSON in
    #     their own words.
    #
    # The comment marker is per LANGUAGE, not shared: a `#` at the start of a
    # line inside a Rust string is not a comment, and `plan.rs` writes exactly
    # that — the header of the generated `host.nix`, in Portuguese, which is a
    # VALUE and stays.
    #
    # AND `.wgsl` IS A LANGUAGE TOO. This pass knew four extensions and the
    # shaders were not among them, so `quad.wgsl` and `image.wgsl` were written
    # in Portuguese from the first commit and stayed that way — comments AND
    # names. They are the code that runs on the GPU for every frame this
    # system draws, and nothing here had ever read a line of them.
    # AND PROSE IS MEASURED WITH THE PROSE RULERS.
    #
    # This pass used to ask `portuguese()`, which is the NAME ruler: `FORBIDDEN`
    # plus a word ending. A comment is not a name — it is a sentence, and the
    # two rulers written for sentences (`GRAMMAR`, the function words with no
    # English homograph, and `VOCABULARY`, the words a message uses) were never
    # applied to the largest body of prose in this tree. `# Ligue ou desligue
    # em ronoctua.update.steps.` went into `/etc/ronoctua/updates.conf` through
    # every green battery, with an English line directly above it.
    def comment_is_portuguese(prose):
        hit = GRAMMAR.search(prose) or VOCABULARY.search(prose)
        return hit.group(0) if hit else portuguese(prose)

    # AND `.toml` AND `.sh` ARE LANGUAGES TOO, by the same argument the shaders
    # were added by: `crates/ronoctua-apps/Cargo.toml` explained itself by
    # naming `estrangeiro::scope_from_cgroup`, a module that had been renamed
    # to `foreign` — Portuguese AND stale, in a file no pass opened. The shell
    # profile is the other one: it is a file a person reads, and invariant 18
    # names its aliases explicitly.
    #
    # THE LEXICON IS THE EXCEPTION, and it is the dictionary's exception:
    # `assets/lexicon/` is Portuguese on purpose, in the value AND in the
    # comments that argue about a translation.
    MARKER = { ".rs": "//", ".nix": "#", ".py": "#", ".wgsl": "//", ".toml": "#", ".sh": "#" }
    for suf in ("*.rs", "*.nix", "*.py", "*.wgsl", "*.toml", "*.sh"):
        for f in sorted(root_dir.rglob(suf)):
            if any(x in f.parts for x in (".git", "result", "target", ".direnv", "lexicon")):
                continue
            mark = MARKER[f.suffix]
            line_is = re.compile(r"^\s*" + re.escape(mark) + r"[!/]?\s?(.*)$")
            run, first = [], None
            for n, line in enumerate(f.read_text(errors="replace").splitlines(), 1) :
                m = line_is.match(line)
                if m:
                    if first is None:
                        first = n
                    run.append(m.group(1))
                    continue
                if run:
                    prose = " ".join(run)
                    prose = re.sub(r"`[^`]*`", " ", prose)
                    prose = re.sub(r'"[^"]*"', " ", prose)
                    hit = comment_is_portuguese(prose.lower())
                    if hit:
                        rel = f.relative_to(root_dir)
                        gaps.append(f"comment: {rel}:{first}: {hit}")
                run, first = [], None
            if run:
                prose = re.sub(r"`[^`]*`", " ", " ".join(run))
                prose = re.sub(r'"[^"]*"', " ", prose)
                hit = comment_is_portuguese(prose.lower())
                if hit:
                    gaps.append(f"comment: {f.relative_to(root_dir)}:{first}: {hit}")

            # AND THE TAIL OF A LINE THAT ALSO HAS CODE ON IT.
            #
            # The rule above anchors at `^\s*`, so it reads a comment only when
            # the whole line is one. A trailing comment is stripped by every
            # other pass in this check and read by none — so a line of code
            # with a Portuguese sentence after `//` on the end of it went
            # through the whole battery green, and invariant 18 names `//`
            # explicitly. (Written out rather than shown: an example here is a
            # comment in this file, and this rule reads those.)
            #
            # `//` MARKERS ONLY. In Nix, Python, TOML and shell the marker is
            # `#`, which appears inside interpolations, attributes and strings
            # often enough that a line-tail scan there would cry wolf; those
            # files keep the whole-line rule. Rust and WGSL are where the
            # invariant actually gets broken.
            if mark != "//":
                continue
            for n, line in enumerate(f.read_text(errors="replace").splitlines(), 1):
                if line_is.match(line):
                    continue
                quoted, escaped, tail = False, False, None
                for i, ch in enumerate(line):
                    if escaped:
                        escaped = False
                        continue
                    if ch == chr(92):
                        escaped = True
                    elif ch == '"':
                        quoted = not quoted
                    elif not quoted and line.startswith("//", i):
                        # `https://` is a scheme, not a comment.
                        if i and line[i - 1] == ":":
                            continue
                        tail = line[i + 2 :]
                        break
                if tail is None:
                    continue
                prose = re.sub(r"`[^`]*`", " ", tail)
                prose = re.sub(r'"[^"]*"', " ", prose)
                hit = comment_is_portuguese(prose.lower())
                if hit:
                    gaps.append(f"comment: {f.relative_to(root_dir)}:{n}: {hit}")

    # 8) THE DESCRIPTOR'S ids — the last Portuguese name that reached a screen
    #
    # A buffer's `name` and `mode` are STRING LITERALS inside the component, and
    # no rule above sees a string on the right of a colon. They became the window
    # 8) WHAT A MESSAGE SAYS OUT LOUD
    #
    # Invariant 18 names `assert`, `bail!` and `.context` by hand, and no pass
    # above reads one: every rule here is about a NAME, and a message is a
    # sentence. So an assertion reading `deslocamento {nudge}` sat in the
    # renderer through every green battery — one word, in the one file whose
    # failures a person reads when a glyph is in the wrong place.
    #
    # THE PROSE RULERS, not the name one, for the reason section 7 gives: a
    # message is written the way a comment is. And the same escape hatch, for
    # the same kinds of Portuguese that belong in code — an assertion whose
    # SUBJECT is the accent is correct, and says so with a `pt-BR:` note.
    #
    # THE STRING HAS TO BE THE MESSAGE and not an argument. `panic!`, `bail!`,
    # `.context`, `.expect`, `unreachable!` and `todo!` take one and nothing
    # else, so their first string is it; an `assert*` takes the message LAST,
    # after the values it compares, so only a trailing one counts. Reading
    # every literal on the line would have flagged the three fixtures whose
    # subject IS the accent — `fold('Configurações')` and its two neighbours.
    SPEAKS = re.compile(r'(?:panic!|bail!|unreachable!|todo!|anyhow!)\s*\(\s*"([^"\\]{6,})"')
    ASKS = re.compile(r'\.(?:context|expect)\(\s*"([^"\\]{6,})"')
    CLAIMS = re.compile(r'assert(?:_eq|_ne)?!\s*\(.*,\s*"([^"\\]{6,})"\s*[,)]')
    for rs in sorted((root_dir / "crates").rglob("*.rs")):
        if "target" in rs.parts:
            continue
        lines = rs.read_text(errors="replace").splitlines()
        for n, line in enumerate(lines, 1):
            if line.lstrip().startswith("//"):
                continue
            for ruler in (SPEAKS, ASKS, CLAIMS):
                for m in ruler.finditer(line):
                    hit = comment_is_portuguese(m.group(1))
                    if hit and not allowed_at(lines, n - 1):
                        gaps.append(f"message: {rs.relative_to(root_dir)}:{n}: {hit}")

    # TITLE and the `app_id`, both drawn raw — so `glifos`, `memoria`, `exemplo`
    # and `transferencias` went through the whole identifier refactor untouched
    # and were the only Portuguese left on a running screen, in every language.
    #
    # They are ids now, and what the screen shows comes from `buffer-<id>` and
    # `mode-<id>`. This is the ruler that keeps them ids.
    DESCRIPTOR_ID = re.compile(r'^\s+(name|mode):\s*"([a-z][a-z0-9-]*)"')
    for rs in sorted((root_dir / "buffers").rglob("*.rs")):
        if "target" in rs.parts:
            continue
        inside = False
        for n, line in enumerate(rs.read_text().splitlines(), 1):
            if "Descriptor {" in line:
                inside = True
                continue
            if inside and line.strip() in ("}", "};"):
                inside = False
                continue
            if not inside:
                continue
            m = DESCRIPTOR_ID.match(line)
            if m and portuguese(m.group(2)):
                rel = rs.relative_to(root_dir)
                gaps.append(f"descriptor: {rel}:{n}: {m.group(1)} = {m.group(2)}")

    # 9) THE MESSAGES THEMSELVES, and this half was open all along.
    #
    # Everything above reads DECLARATIONS. Not one of them looks inside a
    # string — so a hundred and eighty-five Portuguese messages lived in
    # `.context`, `bail!`, `expect` and `write!` through every green battery
    # this repository has ever run: `"ler o verbo"`, `"mudar o dono de {}"`,
    # `"o the compositor recusou {request}"`, `"registry do Wayland"`. They are the
    # sentences a person actually SEES when something goes wrong, which makes
    # them the half of invariant 18 that matters most.
    # The macros a message reaches a person through.
    #
    # THE LIST WAS TOO SHORT, and every absence was a whole vehicle. Twenty-six
    # `tracing::` lines put `"faxina concluida"` and `"o oomd encerrou um
    # cgroup"` in the journal; `Display for Cancelled` wrote `"cancelado"`; a
    # thread was NAMED `"notificacoes"`; and the manager's window called itself
    # `*arquivos*` on a real screen, in every language. None of them is a macro
    # from the first line, and that is the only reason they survived.
    SPEAKS = re.compile(
        r"\.(context|with_context)\b|\bbail!|\banyhow!|\bexpect\(|\bpanic!"
        r"|\be?println!|\bwrite(ln)?!|\bassert(_eq|_ne)?!"
        r"|\btracing::(?:info|warn|error|debug|trace)!"
        r"|\bformat!|\bwrite_str\(|\.name\(|\.set_title\(|\.set_app_id\("
    )
    LITERAL = re.compile(r'"([^"\\]*(?:\\.[^"\\]*)*)"')

    # LOWERCASE, because `said_in_portuguese` measures the lowered text —
    # written in capitals this pattern matched nothing at all, and the
    # mutation that proves it is `"o Google Chrome (0,42 GiB)"`.
    DECIMAL_COMMA = re.compile(
        r"[0-9],[0-9]{1,2}\s*(?:[gmk]i?b|ghz|mhz|khz|ms|px|pt)\b"
    )

    def morph_only(text):
        """The first word whose ENDING is Portuguese, or None."""
        for m in MORPH.finditer(text):
            if m.group(0).lower() not in NOT_PORTUGUESE:
                return m.group(0)
        return None

    def bare(x):
        """The text with its strings emptied, for counting brackets."""
        return re.sub(r'"[^"]*"', '""', x)

    def whole_call(lines, n):
        r"""The call that opens on line `n`, however many lines it runs over.

        A CALL IS NOT A LINE, and reading one line at a time cut every sentence
        that did not fit on one. Two shapes did it: Rust's `\` continuation
        inside a string, and a macro whose opening bracket is alone on its line
        (`format!(` and then the sentence underneath). Follow both — the
        backslash, and the brackets, counted OUTSIDE the strings.
        """
        span, i = lines[n - 1], n
        while i < len(lines) and i - n < 8:
            if span.rstrip().endswith("\\"):
                span = span.rstrip()[:-1] + " " + lines[i].lstrip()
            elif bare(span).count("(") > bare(span).count(")"):
                span += " " + lines[i]
            else:
                break
            i += 1
        return span, i

    def said_in_portuguese(s):
        """The Portuguese in something a person is shown, or None."""
        low = s.lower()
        if " " in s.strip():
            # A SENTENCE carries a function word, and the ones in `GRAMMAR`
            # have no English homograph. `FORBIDDEN` is deliberately NOT
            # applied here: it holds `comando` and `arquivo`, which is what the
            # pt-BR VALUE of a key says on purpose, and a test may assert it.
            m = GRAMMAR.search(low) or VOCABULARY.search(low) or DECIMAL_COMMA.search(low)
            return m.group(0) if m else morph_only(low)
        # ONE WORD has no grammar to catch it — but `FORBIDDEN` is still the
        # wrong ruler for it. Half the single-word literals in this tree are
        # the pt-BR half of the SEARCH LANGUAGE (`familia:`, `bloco:`,
        # `categoria:`), which the three browsers ACCEPT from whoever types it;
        # that is a tag, and invariant 18 keeps tags in both languages. So a
        # lone word is measured by the message vocabulary and by its ending.
        # (What a browser WRITES is English — see `INITIAL_FILTER`.)
        m = VOCABULARY.search(low)
        return m.group(0) if m else morph_only(low)

    # `whole_call` above is what reads a sentence written on more than one
    # line, and it is how `"desenhou vetor sem declarar `Vetor`"` and
    # `"o `SPC w s` oferece e ninguem entra"` are seen at all: the Portuguese
    # sat on a continuation, and a continuation is not a line matching `SPEAKS`.
    #
    # AND `buffers` READS THE SAME RULER. Pass 9 was written for `crates`, and
    # the seven components beside it were never read at all.
    for base in ("crates", "buffers"):
        for rs in sorted((root_dir / base).rglob("*.rs")):
            if "target" in rs.parts:
                continue
            lines = rs.read_text().splitlines()
            for n, line in enumerate(lines, 1):
                if not SPEAKS.search(line):
                    continue
                whole, i = whole_call(lines, n)
                for s in LITERAL.findall(whole):
                    # WHAT IS IN BACKTICKS IS DATA. Two tests search for
                    # `tag:pasta` and `bandeira brasil`: the query is the
                    # fixture and the sentence around it is English, so the
                    # quoted span comes out before the sentence is read.
                    s = re.sub(r"`[^`]*`", " ", s)
                    hit = said_in_portuguese(s)
                    if hit and not allowed_at(lines, n, i):
                        rel = rs.relative_to(root_dir)
                        gaps.append(f"message: {rel}:{n}: {s[:70]}")

    # 10) THE SHADERS' OWN NAMES.
    #
    # The comment pass above now opens `.wgsl`; this reads what one declares.
    # `struct Instancia`, `struct Saida`, `posicao`, `textura`, `amostrador`,
    # `direita`, `baixo`, `cor` — an entire language of this system written in
    # Portuguese and never seen, because no rule here had opened the file.
    # Only `vs` and `fs` cross into Rust, as the `entry_point` strings; every
    # other name in there has this check as its one reader.
    WGSL_DECL = re.compile(
        r"\b(?:struct|fn|let|var(?:<[^>]*>)?)\s+([A-Za-z_][A-Za-z0-9_]*)"
    )
    WGSL_MEMBER = re.compile(
        r"^\s*(?:@[a-z_]+\([^)]*\)\s*)*([A-Za-z_][A-Za-z0-9_]*)\s*:"
    )
    WGSL_ARG = re.compile(r"([A-Za-z_][A-Za-z0-9_]*)\s*:")
    for w in sorted(root_dir.rglob("*.wgsl")):
        lines = w.read_text().splitlines()
        for n, line in enumerate(lines, 1):
            code = line.split("//")[0]
            names = [m.group(1) for m in WGSL_DECL.finditer(code)]
            member = WGSL_MEMBER.match(code)
            if member:
                names.append(member.group(1))
            # A PARAMETER IS A NAME TOO, and it is the one place a shader
            # writes a name with no keyword in front of it.
            if "fn " in code:
                names += [a.group(1) for a in WGSL_ARG.finditer(code)]
            for name in names:
                item_name = re.sub(r"(?<!^)(?=[A-Z])", "-", name).lower().replace("_", "-")
                if portuguese(item_name) and not allowed_at(lines, n):
                    gaps.append(f"wgsl: {w.relative_to(root_dir)}:{n}: {name}")

    # 11) AND WHAT THE BUILD AND THE CHECKS SAY OUT LOUD.
    #
    # Pass 9 reads Rust. Nothing read a `.nix` or a `.py`, and those speak to a
    # person too: `echo "  compilando o buffer $name…"` in the loop the owner
    # runs every day, `echo "--- extraindo … ---"` while the fonts unpack,
    # `print(f"duracao: …")` in a VM test, `subtest("o wipe renova @root")` —
    # and `echo "validando $cfg"` inside this very file. Thirty-nine lines of
    # Portuguese on somebody's terminal, and not one rule looked at them.
    #
    # ONLY WHAT IS SHOWN, and the restriction is what makes the pass possible:
    # reading every literal would fail on `FORBIDDEN` and `VOCABULARY` above,
    # which are Portuguese on purpose, and on the pt-BR half of every generated
    # table. A message is an ARGUMENT of something that prints.
    #
    # AND `assert` IS ONE OF THEM, which it was not: the VM tests are Python
    # inside a `.nix`, their assertions are the sentence somebody reads when a
    # boot goes wrong at three in the morning, and `tests/rescue-vm.nix` had
    # half of one in Portuguese through every green battery this tree has run.
    # Invariant 18 names `assert` explicitly; this pass is the only reader that
    # reaches an assertion which is not written in Rust.
    # AND FOUR MORE VEHICLES, each one a whole class that had no reader.
    #
    #   `help=`   is COMMAND-LINE HELP, which invariant 18 names in so many
    #             words. Four generators described their own flags in
    #             Portuguese — `"inicio da faixa, em hexadecimal"` — while the
    #             identical English line already existed in a sibling.
    #   `mkEnableOption`/`description` are what `nixos-option` prints and what
    #             a person reads when deciding whether to turn something on.
    #             One language fits there, so it is English (invariant 18), and
    #             five options in four modules were Portuguese with English
    #             ones beside them in the SAME file.
    #   `say `    is the generated update script's own voice: it reaches the
    #             journal and the terminal, and half its lines were English.
    SHOWN = re.compile(
        r"\becho\s|\bprintf\s|\bprint\(|\bdie\(|\bcomplain\(|\bsys\.exit\("
        r"|\bsubtest\(|\bassert\s|\bhelp=|\bmkEnableOption\s|\bdescription\s*="
        r"|\bsay\s|\.append\("
    )
    # `.append(` IS HOW A CHECK SAYS WHAT IS WRONG. This file holds 249 of them
    # against 58 `print(…, file=sys.stderr)` summaries — so the HEADLINE of
    # every check was measured and the sentence naming the actual defect was
    # not. That is the half a person reads.
    # SINGLE QUOTES COUNT TOO. A VM test writes Python INSIDE a Nix string, so
    # its own assertions have to use the other quote — `f'sem resposta: …'` sat
    # in `tests/extension-vm.nix` for exactly that reason.
    SPOKEN = re.compile(r'"([^"\n]*)"')
    SPOKEN_SINGLE = re.compile(r"'([^'\n]*)'")

    for suf in ("*.nix", "*.py", "*.sh"):
        for f in sorted(root_dir.rglob(suf)):
            if any(x in f.parts for x in (".git", "result", "target", ".direnv")):
                continue
            swept += 1
            lines = f.read_text(errors="replace").splitlines()
            for n, line in enumerate(lines, 1):
                if line.lstrip().startswith("#") or not SHOWN.search(line):
                    continue
                # THE CALL MAY RUN OVER SEVERAL LINES, and in `gen-updates.py`
                # the Portuguese was on the third of them. Follow it until the
                # brackets close, counting them OUTSIDE the strings.
                span, i = whole_call(lines, n)
                # BOTH QUOTES, SCANNED SEPARATELY. As one alternation the
                # double-quoted span wins at the outer quote and swallows the
                # single-quoted one, which is where the Portuguese was.
                for s in SPOKEN.findall(span) + SPOKEN_SINGLE.findall(span):
                    s = re.sub(r"`[^`]*`", " ", s)
                    hit = said_in_portuguese(s)
                    if hit and not allowed_at(lines, n, i):
                        rel = f.relative_to(root_dir)
                        gaps.append(f"said: {rel}:{n}: {s[:70]}")

    if gaps:
        print("ERROR: a Portuguese name (invariant 18).", file=sys.stderr)
        print("", file=sys.stderr)
        # EVERY ONE OF THEM. A cap here hid 88 of 128 findings and cost a
        # whole round trip to discover; a check that knows the answer and
        # prints part of it is worse than one that prints nothing, because
        # the part reads like the whole. Saying the SAME one twice is not a
        # cap, and a line that quotes one string twice used to do exactly that.
        for f in dict.fromkeys(gaps):
            print(f"       {f}", file=sys.stderr)
        print("", file=sys.stderr)
        print("       Every NAME and every COMMENT is English.", file=sys.stderr)
        print("       In pt-BR, only the 4 docs, the VALUE of a key and the search tag.", file=sys.stderr)
        raise SystemExit(1)
    floor(swept, 200, "files of the tree swept for a Portuguese word")
    print("OK: nothing in Portuguese — name, key, comment, subcommand, flag,")
    print("    message, shader AND what the build says out loud")
    END
  '';

  # The flag a `.nix` PASSES has to be one the generator DECLARES.
  #
  # It is a name crossing the boundary as a string, exactly like the WIT: nothing
  # ties `add_argument("--teto-sem-pt")` to the `--teto-sem-pt` in the caller, so
  # renaming one side compiles, evaluates, and dies at build time with
  # `unrecognized arguments` — pointing at the script, not at the rename. It
  # happened twice in the same pass (`--teto-sem-pt`, `--categorias`), which is
  # what earned it a check.
  generator-flags-agree = mkCheck "generator-flags-agree" [ pkgs.python3 ] ''
    python3 - <<'END'
    import collections, pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a flag is declared at the top of a script and passed from a
    # line of a Nix file, and neither lives inside a function worth narrowing
    # to. The fifteen-line window after the script's name is the narrowing.
    #
    # `hashless` for both sides — `#` is the comment of Python and of Nix — and
    # it is what stops a flag that was COMMENTED OUT of a generator from still
    # counting as declared, or one mentioned in prose from counting as passed.
    root_dir = pathlib.Path("${self}")
    declared = collections.defaultdict(set)
    # AND A BRAIN MODULE'S OWN GENERATORS, which travel with its folder.
    scripts = sorted((root_dir / "nix/scripts").glob("*.py"))
    scripts += sorted((root_dir / "crates/ronoctua-brain/modules").glob("*/*.py"))
    for p in scripts:
        for m in re.finditer(r'add_argument\(\s*"(--[a-z0-9-]+)"', hashless(p.read_text())):
            declared[p.name].add(m.group(1))
    floor(len(declared), 5, "generators declaring a flag")

    # `cp --reflink` and friends: a flag of a coreutils call, not of the script.
    NOT_OURS = {"--reflink"}
    gaps = []
    swept = 0
    for p in root_dir.rglob("*.nix"):
        if any(x in p.parts for x in (".git", "result", "target", ".direnv")):
            continue
        t = hashless(p.read_text(errors="replace"))
        swept += 1
        # `[ \t]` AND NOT `\s`, because `\s` matches a newline: across a blank
        # line the "fifteen lines" became as many as the file had runs of
        # whitespace, and the window read an unrelated invocation below. It
        # only showed once the comments were stripped, which is what turns a
        # comment line into a whitespace-only one.
        for m in re.finditer(r"(gen-[a-z-]+\.py|scripts/[a-z-]+\.py)([^\n]*(?:\n[ \t]+[^\n]*){0,14})", t):
            script = m.group(1).split("/")[-1]
            if script not in declared:
                continue
            for f in re.findall(r"(--[a-z][a-z0-9-]+)", m.group(2)):
                if f not in declared[script] and f not in NOT_OURS:
                    n = t.count("\n", 0, m.start()) + 1
                    gaps.append(f"{p.relative_to(root_dir)}:{n}: {script} receives {f}")

    floor(swept, 30, "Nix files swept for a generator call")
    if gaps:
        print("ERROR: a flag passed that the generator does not declare.", file=sys.stderr)
        for g in sorted(set(gaps)):
            print(f"       {g}", file=sys.stderr)
        print("", file=sys.stderr)
        print("       A flag's name crosses the boundary as a STRING: both", file=sys.stderr)
        print("       sides change in the same pass, or nothing reports it until the build.", file=sys.stderr)
        raise SystemExit(1)
    print("OK: every flag passed is declared by the generator that receives it")
    END
  '';

  # A `{name}` inside an f-string with no `name` in scope.
  #
  # It is what a rename leaves behind when it reaches the capture and not the
  # assignment, and NOTHING catches it: Python only raises on the line that runs,
  # so it hid on the "not measured" path of `nix run .#bench` and on the summary
  # line the bench prints every time. Three of them were live at once.
  #
  # In a `.nix` file the embedded script has to be isolated from the Nix around
  # it — otherwise a Nix attribute `name = …` counts as a Python definition and
  # hides exactly the orphan being hunted. And the fence does not end at the
  # first `''`: `'''`, `''$` and `''\` are escapes.
  format-captures-resolve = mkCheck "format-captures-resolve" [ pkgs.python3 ] ''
    python3 - <<'END'
    import builtins, keyword, pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a capture with no name in scope is an offence wherever it is
    # written, and what bounds it is the SCOPE — the region and its `defined`
    # set — rather than one function.
    # PARSED: this check does not search its files, it parses them: `fences`
    # walks the Nix string delimiters and `fstrings` walks the Python quoting,
    # and both are what tell code from prose here. Running a stripper first
    # would cut the fences it exists to find — `hashless` would take a `#` out
    # of the middle of a shell script inside one — so the parse IS the strip.
    CAP = re.compile(r"\{([A-Za-z_][A-Za-z0-9_]*)")
    FSTR = re.compile(r"""(?:\bf|\bfr|\brf)(\"\"\"|'''|\"|')""")
    DEFINE = [
        re.compile(r"^\s*\(?([A-Za-z_*][A-Za-z0-9_,\s*\[\]().]*?)\)?\s*(?::[^=\n]+)?=[^=]", re.M),
        re.compile(r"^\s*(?:async\s+)?def\s+([A-Za-z_][A-Za-z0-9_]*)", re.M),
        re.compile(r"^\s*class\s+([A-Za-z_][A-Za-z0-9_]*)", re.M),
        re.compile(r"\bfor\s+\(?([A-Za-z_][A-Za-z0-9_,\s()\[\]]*?)\)?\s+in\b", re.M),
        re.compile(r"\bas\s+\(?([A-Za-z_][A-Za-z0-9_,\s()]*)", re.M),
        re.compile(r"^\s*import\s+([A-Za-z_][A-Za-z0-9_.]*)", re.M),
        re.compile(r"\bdef\s+[A-Za-z_][A-Za-z0-9_]*\s*\(([^)]*)\)", re.M),
        re.compile(r"\bglobal\s+([A-Za-z_][A-Za-z0-9_,\s]*)", re.M),
        re.compile(r"\b([A-Za-z_][A-Za-z0-9_]*)\s*:=", re.M),
        re.compile(r"\blambda\s+([A-Za-z_][A-Za-z0-9_,\s]*?):", re.M),
        # `from x import a, b as c` — the names it BINDS are on the right, and
        # the plain `import x` above does not see them. The gap showed up the
        # day a generator interpolated a constant it had imported: the name was
        # reported as an orphan, which was this check being wrong rather than
        # the code. (No example is written out here on purpose — an f-string in
        # a comment is an f-string this very scanner reads.)
        re.compile(r"^\s*from\s+[A-Za-z_.][A-Za-z0-9_.]*\s+import\s+(.+)$", re.M),
        # A CHAINED ASSIGNMENT binds every target, and the first pattern above
        # stops at the first `=`: two counters started at zero on one line
        # (`nix/scripts/texts.py`) had the second reported as an orphan, which
        # was this check being wrong rather than the code.
        re.compile(r"^\s*((?:[A-Za-z_][A-Za-z0-9_]*\s*=\s*){2,})(?!=)", re.M),
    ]
    DRIVER = {"machine", "subtest", "start_all", "nodes", "t", "polling_condition"}

    def defined(t):
        s = set(dir(builtins)) | DRIVER
        for p in DEFINE:
            for m in p.finditer(t):
                for part in re.split(r"[,\s()\[\]]+", m.group(1)):
                    part = part.split("=")[0].split(":")[0].split(".")[0].strip("*")
                    if part:
                        s.add(part)
        # A DEFAULT WITH PARENTHESES (`fails=()`) ends the parameter list for
        # the `def` pattern above, which stops at the first closing one: every
        # parameter after it was reported as an orphan (`tests/build-sizing.nix`),
        # which was this check being wrong rather than the code. The list is
        # read to the parenthesis that balances the opening one.
        for m in re.finditer(r"\bdef\s+[A-Za-z_][A-Za-z0-9_]*\s*\(", t):
            depth, j = 1, m.end()
            while j < len(t) and depth:
                depth += {"(": 1, ")": -1}.get(t[j], 0)
                j += 1
            for part in re.split(r"[,\s()\[\]]+", t[m.end() : j - 1]):
                part = part.split("=")[0].split(":")[0].strip("*")
                if part:
                    s.add(part)
        return s

    # The fence delimiter, built rather than written: a literal pair of quotes
    # in here would close the Nix string this script lives in.
    FENCE = chr(39) * 2

    def fences(t):
        """Every Nix fence. It does NOT end at the first delimiter: a tripled
        quote, and a delimiter followed by `$` or by a backslash, are escapes.
        Reading one of those as the terminator drops most of the script."""
        i = 0
        while True:
            a = t.find(FENCE, i)
            if a < 0:
                return
            j = a + 2
            while j < len(t):
                if not t.startswith(FENCE, j):
                    j += 1
                    continue
                if j + 2 < len(t) and t[j + 2] in chr(39) + "$" + chr(92):
                    j += 3
                    continue
                break
            yield a + 2, t[a + 2 : j]
            i = j + 2

    def fstrings(t):
        i = 0
        while True:
            m = FSTR.search(t, i)
            if not m:
                return
            q = m.group(1)
            j = m.end()
            while j < len(t):
                if t[j] == "\\":
                    j += 2
                    continue
                if t.startswith(q, j):
                    break
                j += 1
            yield m.end(), t[m.end() : j]
            i = j + len(q)

    root_dir = pathlib.Path("${self}")
    # Every VM test splices this prelude into its own script.
    pre = root_dir / "tests/compositor-xvfb.nix"
    prelude = "\n".join(b for _, b in fences(pre.read_text())) if pre.exists() else ""

    orphans, swept, scanned = [], 0, 0
    for p in sorted(root_dir.rglob("*")):
        if p.suffix not in (".nix", ".py") or not p.is_file():
            continue
        if any(x in p.parts for x in (".git", "result", "target", ".direnv")):
            continue
        t = p.read_text(errors="replace")
        regions = [(0, t)] if p.suffix == ".py" else list(fences(t))
        extra = prelude if p.suffix == ".nix" else ""
        known = defined("\n".join(b for _, b in regions) + "\n" + extra)
        swept += 1
        for base, region in regions:
            for off, body in fstrings(region):
                scanned += 1
                for m in CAP.finditer(body):
                    if m.group(1) in known:
                        continue
                    if keyword.iskeyword(m.group(1)):
                        continue  # `{not done}` opens an expression, not a name
                    if m.start() > 0 and body[m.start() - 1] == "{":
                        continue  # `{{` is a literal brace
                    if m.start() >= 1 and body[m.start() - 1] == "$":
                        continue  # Nix antiquotation, not a Python field
                    n = t.count("\n", 0, base + off + m.start()) + 1
                    orphans.append(f"{p.relative_to(root_dir)}:{n}: {m.group(1)}")

    floor(swept, 50, "Nix and Python files swept for a format capture")
    floor(scanned, 200, "format strings read")
    if orphans:
        print("ERROR: a format capture with no name in scope.", file=sys.stderr)
        for o in orphans:
            print(f"       {o}", file=sys.stderr)
        print("", file=sys.stderr)
        print("       Python only reports it on the line that RUNS: one of these lives on", file=sys.stderr)
        print("       the error path and only shows up when there is already another problem.", file=sys.stderr)
        raise SystemExit(1)
    print("OK: every format capture has its name in scope")
    END
  '';

  # The crates: tests, clippy and formatting, each in its own derivation so it
  # says WHAT broke instead of "Rust failed" — and each the aggregate of the
  # units (`nix/rust/units.nix`): one test run, one clippy and one rustfmt
  # per crate, so an edit runs again what it reaches and nothing else.
  # crane's three leaves of these names compiled the whole workspace for one
  # line (gone on 2026-10-12); the names stayed, for the editing loop
  # (`tests/quick.nix`) and the pre-commit hook.
  rust-tests = rust.tests;
  rust-clippy = rust.clippy;
  rust-fmt = rust.fmt;

  # The footer itself. The surface only comes up with a compositor, so what is
  # asserted here is what can be asserted without one: that the binary exists,
  # runs and loads the embedded face.
  shell-binary = mkCheck "shell-binary" [ ] ''
    # The palettes and the texts (`rust.keyed`): this binary is the unwrapped
    # one, and the colours and the words are data it reads at run time.
    export RONOCTUA_THEMES=${rust.keyed.RONOCTUA_THEMES}
    export RONOCTUA_TEXTS=${rust.keyed.RONOCTUA_TEXTS}
    # And the brain's catalogue (`rust.keyed`): the modules' marks and the
    # keymap's actions are data it reads at run time, refused (78) without it.
    export RONOCTUA_BRAIN_CATALOGUE=${rust.keyed.RONOCTUA_BRAIN_CATALOGUE}
    bin=${rust.bins.ronoctua-shell}/bin/ronoctua-shell
    test -x "$bin" || { echo "ERROR: the binary is missing" >&2; exit 1; }

    # With no WAYLAND_DISPLAY it must fail with a CLEAR message, not with a
    # panic. The message is the first thing anyone sees when the nested loop
    # does not come up.
    out_text=$("$bin" 2>&1 || true)
    echo "$out_text"
    echo "$out_text" | grep -q "Wayland compositor"       || { echo "ERROR: with no compositor, the error message does not explain why" >&2; exit 1; }

    echo "OK: the footer exists and fails legibly with no compositor"
  '';

  # THE FIVE COMPONENTS REACH THE SHELL THAT RUNS — the two sides, compared.
  #
  # # The defect this exists for
  #
  # The components used to be baked in by `option_env!`, and that made a whole
  # class of failure impossible: if the build had the variable, the binary had
  # the path. Taking them out of the compilation (`nix/rust.nix`, and the reason
  # is written there) trades that guarantee for minutes of iteration — and a
  # trade with nothing watching it is how `LEADER i n` becomes a key that opens
  # no window, with one line in a journal nobody is reading.
  #
  # So the two sides are compared against each other, and both come from real
  # artifacts rather than from a list kept by hand here:
  #
  #   - what the RUST reads: every `RONOCTUA_BUFFER_*` named in the shell's
  #     sources. A sixth buffer shows up here the moment its command is written;
  #   - what the WRAPPER carries: the strings `makeBinaryWrapper` compiled into
  #     the binary the module, the nested loop and the VMs all run.
  #
  # A name on one side and not on the other fails. That covers both directions:
  # the buffer nobody wired up, and the variable that stopped being set.
  shell-finds-its-buffers =
    mkCheck "shell-finds-its-buffers"
      [
        pkgs.gnugrep
        pkgs.coreutils
      ]
      ''
        failed=0

        # ---- WHAT THE RUST READS ----
        . ${shellSh}
        # EVERY FILE OF THE SHELL'S CRATES, a module's folder included
        # (`surface/`, `door/`): `shell_files '*.rs'` is the top of `src/`.
        lidas=$(grep -oh 'RONOCTUA_BUFFER_[A-Z_]*' \
          $(shell_files '*.rs') $(shell_files '*/*.rs') $(shell_files '*/*/*.rs') | sort -u)
        [ -n "$lidas" ] || {
          echo "ERROR: no RONOCTUA_BUFFER_* in the shell's code — what does the grep match?" >&2
          exit 1
        }
        echo "o shell le: $(echo "$lidas" | tr '\n' ' ')"

        # ---- WHAT THE WRAPPER CARRIES ----
        # `grep -a`: the wrapper is an ELF, and both the name and the store path
        # are string literals inside it.
        for v in $lidas; do
          grep -qa "$v" ${rust.shell}/bin/ronoctua-shell || {
            echo "ERROR: the shell reads $v and the wrapper does not set it — the key would open nothing" >&2
            failed=1
          }
        done

        # ---- AND EACH ONE POINTS AT A COMPONENT THAT EXISTS ----
        #
        # A variable set to a path that is not there fails at the far end, when
        # the window does not open, and the message blames the buffer.
        ${lib.concatStringsSep "\n" (
          lib.mapAttrsToList (name: path: ''
            grep -qa "${path}" ${rust.shell}/bin/ronoctua-shell || {
              echo "ERROR: ${name} does not point at ${path} in the wrapper" >&2; failed=1; }
            case "${path}" in
              *.wasm) [ -s "${path}" ] || {
                echo "ERROR: ${path} does not exist or is empty" >&2; failed=1; } ;;
              *) echo "ERROR: ${name} does not end in .wasm" >&2; failed=1 ;;
            esac
            echo "$lidas" | grep -qx "${name}" || {
              echo "ERROR: the wrapper sets ${name} and no .rs of the shell reads it" >&2; failed=1; }
          '') rust.bufferComponents
        )}

        [ "$failed" = 0 ] || exit 1
        echo "OK: both sides match, and the components are there"
      '';

  # Section 9 requires the repository to be publishable AS IT IS. A local-path
  # input only works for whoever has both trees side by side, so it must not
  # survive publication — and since the font files went out as a Release, it no
  # longer WARNS: it fails.
  #
  # The four names are spelled out and the set is compared whole. Scanning for a
  # `fonts-` prefix alone would mean a renamed input empties the loop and the
  # check passes having verified nothing — which is exactly how the previous
  # version of this check spent its whole life (see below).
  fonts-input-publishable = mkCheck "fonts-input-publishable" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import json, sys

    # THE URLS COME FROM `flake.lock`, and not from `inputs.<name>.original.url`.
    #
    # That attribute DOES NOT EXIST on a `flake = false` input — the value is the
    # fetched tree, with `outPath` and `narHash` and nothing else. The `or`
    # fallback that used to be here therefore answered for every run, and this
    # check spent its whole life reporting on a URL nobody had written. It landed
    # in the right branch by luck, and would have gone on saying "local path"
    # after the inputs became a Release. A silent fallback needs a check; this
    # one WAS the silent fallback.
    expected = {
        "fonts-ttf",
        "fonts-ttf-nerdfonts",
        "fonts-woff2",
        "fonts-woff2-nerdfonts",
    }

    nodes = json.load(open("${self}/flake.lock"))["nodes"]
    found = {n for n in nodes if n.startswith("fonts-")}
    if found != expected:
        print("ERROR: the flake.lock's font inputs are not the expected ones.",
              file=sys.stderr)
        print("      expected: " + ", ".join(sorted(expected)), file=sys.stderr)
        print("      found:    " + ", ".join(sorted(found)), file=sys.stderr)
        sys.exit(1)

    failed = False
    for name in sorted(expected):
        node = nodes[name]
        original = node["original"]
        url = original.get("url") or (original["type"] + ":" + original.get("path", ""))

        # `narHash` is what actually pins this. `fonts-v1` is a mutable pointer
        # like any git tag: GitHub lets an asset be deleted and re-uploaded under
        # the same name, and without the hash the build would just take the new
        # bytes.
        pinned = node.get("locked", {}).get("narHash")

        if url.startswith("https://") or url.startswith("http://"):
            if not pinned:
                print("ERROR: the input '" + name + "' is remote but is NOT locked "
                      "by narHash in flake.lock.", file=sys.stderr)
                failed = True
            else:
                print("OK: input '" + name + "' is a remote asset and pinned by "
                      "hash — " + url)
        elif url.startswith("path:") or url.startswith("/"):
            print("ERROR: the input '" + name + "' points at a local path:",
                  file=sys.stderr)
            print("        " + url, file=sys.stderr)
            print("      That works on your disk, but NOT for whoever clones it.",
                  file=sys.stderr)
            print("      The font files are 4.1 GB and do NOT go into git (nor",
                  file=sys.stderr)
            print("      LFS): they are an asset of a Release of this very repository. Run",
                  file=sys.stderr)
            print("      nix run .#fonts-release -- /path/with/noctua-iosevka,",
                  file=sys.stderr)
            print("      upload the four on the fonts-v1 tag and point the input at it.",
                  file=sys.stderr)
            failed = True
        else:
            print("ERROR: input '" + name + "' has an unexpected shape: " + url,
                  file=sys.stderr)
            failed = True

    sys.exit(1 if failed else 0)
    PY
  '';

  # The OFL requires redistributing the license text along with the files.
  fonts-license = mkCheck "fonts-license" [ ] ''
    test -f ${fonts.noctua-iosevka-ttf-nerdfonts}/share/doc/noctua-iosevka/LICENSE-OFL.txt \
      || { echo "ERROR: LICENSE-OFL.txt is missing from the package" >&2; exit 1; }
    grep -q "SIL OPEN FONT LICENSE" \
      ${fonts.noctua-iosevka-ttf-nerdfonts}/share/doc/noctua-iosevka/LICENSE-OFL.txt \
      || { echo "ERROR: LICENSE-OFL.txt does not contain the OFL text" >&2; exit 1; }
    echo "OK: the OFL text is redistributed alongside the files"
  '';

  # EVERY COMMAND A BUFFER PUBLISHES HAS A LABEL THE HOST CAN DRAW.
  #
  # `SPC m` lists the focused buffer's keymap, and each row's description comes
  # from `cmd-<id>` — the buffer declares the id, the HOST owns the text
  # (invariant 11: a buffer does not translate). When the key is missing,
  # `Texts::t` returns `[cmd-<id>]` and does not fail, so the defect reaches the
  # screen as brackets and nothing before that says a word. It is the same hole
  # `installer-dryrun` closes for the installer's own labels.
  #
  # The literals are read from the buffers' SOURCE. The ids built at runtime
  # (`lucide`'s formats and filters) are already covered by the panels that draw
  # them, and a check that ran the components would cost a wasm instantiation to
  # learn what a grep can see.
  # EVERY TEXT KEY A BUFFER NAMES EXISTS IN BOTH LANGUAGES.
  #
  # The sibling below covers a buffer's COMMAND ids. Nothing covered the keys it
  # writes on screen — and a buffer cannot check them itself: it does not
  # translate (invariant 11), it names a key and the host looks it up. A typo
  # becomes `[memory-guard-detial]` drawn in front of the person, and only when
  # that screen is opened.
  #
  # The shape read here is the `mod key` every buffer keeps: one `pub const` per
  # key, the value a literal. A key assembled with `format!` is invisible to
  # this check — which is why the panels keep their keys as whole literals.
  buffer-keys-have-text = mkCheck "buffer-keys-have-text" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    root_dir = pathlib.Path("${self}")
    owed, seen_files = {}, 0

    # FILE-WIDE: a buffer may declare its `mod key` anywhere in any of its
    # files, so there is no function to narrow to — the `mod key` block IS the
    # narrowing, and it is the one this check learned to make. What the strip
    # adds is that a key named in PROSE no longer counts: a comment showing the
    # old spelling of a constant would have demanded a `.ftl` line for it.
    #
    # `uncommented` and not `code_of`, because the key is the string literal.

    # INSIDE `mod key`, AND NOWHERE ELSE.
    #
    # This used to grep every `pub const NAME: &str = "…";` in a buffer, which
    # was true while the only such constants WERE text keys. The design crate
    # ended that: a `Table`'s columns are named, and a buffer now declares
    # `mod field { pub const COUNTER: &str = "counter"; }` — which is better
    # than a bare literal at the call site, and is not a sentence anybody
    # translates. The broad grep read four of those as missing translations.
    #
    # The module is the scope, so a constant is a promise about a bundle only
    # where the buffer says it is one.
    for rs in sorted((root_dir / "buffers").rglob("*.rs")):
        if "target" in rs.parts:
            continue
        source = uncommented(rs.read_text())
        seen_files += 1
        for block in re.findall(r"\nmod key \{(.*?)\n\}", source, re.S):
            for k in re.findall(r'pub const [A-Z_0-9]+: &str = "([a-z0-9-]+)";', block):
                # A TRAILING `-` MEANS PREFIX, NOT KEY: completed at run time
                # (a language's subtag, a record's id), and demanding a `.ftl`
                # line for the prefix itself would be demanding a key nothing
                # ever emits.
                if k.endswith("-"):
                    continue
                owed.setdefault(k, rs.relative_to(root_dir))

    # SIX BUFFERS since the three icon browsers left for the native app.
    floor(seen_files, 6, "buffer sources swept for a `mod key`")
    floor(len(owed), 40, "buffer text keys found")

    failed = 0
    for language in ${builtins.toJSON languages}:
        text = (pathlib.Path("${texts}") / f"{language}.ftl").read_text()
        have = set(re.findall(r"^([a-z][a-z0-9-]*)\s*=", text, re.M))
        for k, where in sorted(owed.items()):
            if k not in have:
                print(f"ERROR: {k} is missing from {language}.ftl ({where}) — the screen would show [{k}]", file=sys.stderr)
                failed = 1

    if failed:
        raise SystemExit(1)
    print(f"OK: {len(owed)} buffer keys, all translated in both languages")
    END
  '';

  # EVERY BUFFER ID HAS A LABEL, IN BOTH LANGUAGES.
  #
  # The descriptor's `name` and `mode` used to BE the label: the host wrote
  # `*{name}*` into the window title and `br.ronoctua.{mode}` into the app id,
  # and the modeline drew both raw. That is how `glifos` appeared on a screen
  # running in English — invariant 18 and invariant 8 broken by the same line,
  # through the one door no check was looking at.
  #
  # They are ids now: English, kebab-case, and what the screen reads is
  # `buffer-<id>` and `mode-<id>`. Without this check a rename compiles, runs,
  # and puts a literal bracketed key on the modeline — which is the failure the
  # i18n was built to make impossible everywhere else.
  buffer-modes-have-text = mkCheck "buffer-modes-have-text" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())
    exec(open("${shellPrelude}").read())

    root_dir = pathlib.Path("${self}")
    ID = re.compile(r'^\s+(name|mode):\s*"([a-z][a-z0-9-]*)"')
    seen_files = 0

    # FILE-WIDE: the question is "which ids does any component declare", and a
    # descriptor sits at module level in a file whose name is not the id. The
    # `Descriptor {` block and the `APP_ID` constant are the narrowings, and
    # they are what this check is made of.
    #
    # `uncommented`, because an id IS a string literal — and because a
    # descriptor written out in a comment as an example would otherwise demand
    # a key for an id no component has.

    # The ids as the COMPONENT declares them, read out of the descriptor block —
    # the same place `english-names` reads, and for the same reason: nothing ties
    # the literal to the key, so both sides have to be read from the source.
    wanted = set()
    for rs in sorted((root_dir / "buffers").rglob("*.rs")):
        if "target" in rs.parts:
            continue
        inside = False
        seen_files += 1
        for line in uncommented(rs.read_text()).splitlines():
            if "Descriptor {" in line:
                inside = True
                continue
            if inside and line.strip() in ("}", "};"):
                inside = False
                continue
            if not inside:
                continue
            m = ID.match(line)
            if m:
                wanted.add(("buffer" if m.group(1) == "name" else "mode", m.group(2)))

    # SIX BUFFERS since the three icon browsers left for the native app.
    floor(seen_files, 6, "buffer sources swept for a descriptor")
    floor(len(wanted), 6, "ids declared by a component")

    # AND THE NATIVE WINDOWS, which are not buffers and reach the same place.
    #
    # `daemon::mode_label` turns any `br.ronoctua.<id>` into `mode-<id>` — it
    # does not care whether the window is a wasm component or a process of ours
    # with a `wl_surface`. The file manager's window, the terminal's, the
    # monitor's and the rescue console's had NO key: the modeline drew
    # `[mode-files]`, in brackets, and had been doing it since they existed.
    #
    # Found while adding the fifth. One list, one rule, one place to add the
    # next one.
    APP_ID = re.compile(r'pub const APP_ID[A-Z_]*: &str = "br\.ronoctua\.([a-z][a-z0-9-]*)"')
    native = 0
    for rs in shell_files("**/*.rs"):
        for ident in APP_ID.findall(uncommented(rs.read_text())):
            wanted.add(("mode", ident))
            native += 1
    floor(native, 4, "native windows declaring an app id")

    missing = []
    for language in ${builtins.toJSON languages}:
        ftl = (pathlib.Path("${texts}") / (language + ".ftl")).read_text()
        have = set(re.findall(r"^([a-z][a-z0-9-]*) *=", ftl, re.M))
        for kind, ident in sorted(wanted):
            key = kind + "-" + ident
            if key not in have:
                missing.append(language + ": " + key)

    if missing:
        print("ERROR: a buffer id with no text — the screen would show the key in square brackets.", file=sys.stderr)
        for m in missing:
            print("       " + m, file=sys.stderr)
        raise SystemExit(1)
    print("OK: " + str(len(wanted)) + " buffer and window ids, with text in both languages")
    END
  '';

  buffer-commands-have-labels = mkCheck "buffer-commands-have-labels" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    root_dir = pathlib.Path("${self}")
    ids, seen_files = set(), 0

    # TWO SHAPES, because a buffer may BUILD its bindings instead of writing
    # them out.
    #
    # Seven components spell `command: "memory-full"` into a `Binding`. The
    # brain's builds them from a `KEYMAP` table of pairs, so `command:` there
    # reads `(*command).into()` — and a grep for the first shape saw nothing of
    # it. Its nine labels were unguarded, and a rename would have drawn
    # `[cmd-brain-run]` under `SPC m` with every check green.
    #
    # The second shape is read INSIDE the `KEYMAP` declaration and nowhere
    # else. A bare "pair of short strings" pattern matches half the tables in
    # these files — measured: it produced `cmd-t`, `cmd-u` and `cmd-v` out of
    # things that are not commands at all.
    # AND A THIRD: a buffer that binds a table it SHARES with its footer panel
    # (`ronoctua_protocol::TRANSFERS_KEYS`), under the local leader. Its
    # commands are the table's CHORDS, which are all `local_binding` binds —
    # read there, by the table's name the buffer names.
    protocol = uncommented((root_dir / "crates/ronoctua-protocol/src/lib.rs").read_text())
    shared = 0
    for rs in sorted((root_dir / "buffers").rglob("*.rs")):
        if "target" in rs.parts:
            continue
        # FILE-WIDE: and `uncommented`. A binding may be written anywhere in a
        # buffer, so there is no function to narrow to — but an id inside a
        # `//` comment is a MENTION of a command and not a command, and a file
        # that listed the old spelling in prose would have demanded a key for
        # it. The ids themselves are string literals, which is why the strings
        # stay.
        source = uncommented(rs.read_text())
        seen_files += 1
        ids.update(re.findall(r'command:\s*"([a-z0-9-]+)"', source))
        for table in re.findall(r"KEYMAP:\s*&\[\(&str, &str\)\]\s*=\s*&\[(.*?)\n\];", source, re.S):
            ids.update(re.findall(r'\(\s*"[^"]+"\s*,\s*"([a-z0-9-]+)"\s*\)', table))
        if "local_binding" in source:
            for name in sorted(set(re.findall(r"\b([A-Z][A-Z_]*_KEYS)\b", source))):
                m = re.search(
                    r"pub const " + name + r":\s*&\[\(&str, &str\)\]\s*=\s*&\[(.*?)\n\];",
                    protocol,
                    re.S,
                )
                if m:
                    found = re.findall(r'\(\s*"C-[^"]+"\s*,\s*"([a-z0-9-]+)"\s*\)', m.group(1))
                    shared += len(found)
                    ids.update(found)

    floor(shared, 5, "chords of a table a buffer shares with its footer panel")

    floor(seen_files, 6, "buffer sources swept for a binding")
    floor(len(ids), 30, "buffer commands found")

    failed = 0
    for language in ${builtins.toJSON languages}:
        text = (pathlib.Path("${texts}") / f"{language}.ftl").read_text()
        have = set(re.findall(r"^([a-z][a-z0-9-]*)\s*=", text, re.M))
        for i in sorted(ids):
            if f"cmd-{i}" not in have:
                print(f"ERROR: cmd-{i} is missing from {language}.ftl — SPC m would show [cmd-{i}]", file=sys.stderr)
                failed = 1

    if failed:
        raise SystemExit(1)
    print(f"OK: {len(ids)} buffer commands, all with a label in both languages")
    END
  '';

  # THE MEMORY POLICY HAS THE SHAPE IT CLAIMS, on the GENERATED units.
  #
  # Every line here failed against a plausible wrong version before it was
  # accepted, because every one of them is a way for this policy to look
  # configured and do nothing:
  #
  # - `systemd.oomd.enable` is ALREADY `true` in this nixpkgs, with every slice
  #   switch `false`. The daemon runs and its monitored list is empty. What arms
  #   it is `ManagedOOMMemoryPressure=kill` on a slice, and nothing else.
  # - `MemoryMin=` is capped by EVERY ancestor cgroup. Set on `session.slice`
  #   alone its effective value is ZERO — and the unit file looks right.
  # - `enableUserSlices` would install a drop-in that applies to every slice of
  #   that type, arming `session.slice`, whose only candidates are the compositor
  #   and the footer.
  # - `OOMScoreAdjust=` on a user unit is refused by the kernel and swallowed by
  #   systemd at debug level. Written here, it would build and do nothing.
  memory-policy-shape =
    let
      system = self.nixosConfigurations.vm.config.system.build.toplevel;
    in
    mkCheck "memory-policy-shape" [ pkgs.gnugrep pkgs.coreutils ] ''
      etc=$(readlink -f ${system}/etc)

      # `-R` AND NEVER `-r`. The whole of NixOS's `/etc` is symlinks into the
      # store, and `grep -r` does not follow a symlink it meets while recursing —
      # it skips it, silently, and reports nothing found. Every assertion below
      # would then be answered by the same wrong "no": the four missing ones
      # would fail correctly by accident, and the two that assert an ABSENCE
      # would pass without ever having looked.
      failed=0

      # THE CHAIN. Four levels, or the reservation is zero.
      for level in system/user.slice.d system/user-.slice.d \
                   system/user@.service.d user/session.slice.d; do
        grep -qR "MemoryMin=" "$etc/systemd/$level" 2>/dev/null || {
          echo "ERROR: no MemoryMin at $level — the chain breaks and the effective value is zero" >&2
          failed=1
        }
      done

      # The daemon is armed, and against the applications.
      grep -qR "ManagedOOMMemoryPressure=kill" "$etc/systemd/user/app.slice.d" 2>/dev/null || {
        echo "ERROR: app.slice is not armed — oomd runs watching nothing" >&2; failed=1; }

      # And NOT against the desktop. Both of these would put the compositor and
      # the footer in the candidate set.
      [ ! -d "$etc/systemd/user/slice.d" ] || {
        echo "ERROR: a drop-in by slice TYPE — it arms session.slice too" >&2; failed=1; }
      [ ! -e "$etc/systemd/system/-.slice.d/overrides.conf" ] || {
        echo "ERROR: -.slice is armed; its candidates include the desktop" >&2; failed=1; }

      # The upstream `session.slice` survived: a full-file override would have
      # discarded its CPUWeight without a word.
      grep -q "CPUWeight=100" "$etc/systemd/user/session.slice" 2>/dev/null || {
        echo "ERROR: session.slice became a whole file and lost upstream's" >&2; failed=1; }

      # The setting that would be a no-op is absent.
      if grep -qR "OOMScoreAdjust=" "$etc/systemd/user/" 2>/dev/null; then
        echo "ERROR: OOMScoreAdjust in a user unit is ignored in silence" >&2
        failed=1
      fi

      # The two units that must never give up.
      for unit in scroll.service ronoctua-footer.service; do
        grep -q "StartLimitIntervalSec=0" "$etc/systemd/user/$unit" || {
          echo "ERROR: $unit gives up after 5 deaths, and then the screen stays empty" >&2
          failed=1
        }
      done

      # THE TABLE THE PANEL READS, and it has to agree with the units.
      #
      # `LEADER s m` loosens the policy by applying the numbers from this file,
      # and the file is generated from the same options the drop-in above uses.
      # If the two ever drift, the panel would switch to numbers that are not
      # the ones a reboot brings back — and nothing else would say so.
      table="$etc/ronoctua/memory-profiles.conf"
      [ -e "$table" ] || {
        echo "ERROR: no profile table; the panel would have no way of loosening it" >&2; failed=1; }
      for profile in strict tolerant; do
        grep -q "^$profile ceiling=.* pressure=.* duration=" "$table" 2>/dev/null || {
          echo "ERROR: the table does not carry the $profile profile whole" >&2; failed=1; }
      done
      grep -q "^declared " "$table" 2>/dev/null || {
        echo "ERROR: the table does not say which profile comes back on restart" >&2; failed=1; }
      # And the strict profile's numbers ARE the ones in force on the slice —
      # the drop-in and the table come from the same options, and this is what
      # proves they were not wired to different ones.
      ceiling=$(grep '^strict ' "$table" | tr ' ' '\n' | grep '^ceiling=' | cut -d= -f2)
      grep -qR "MemoryHigh=$ceiling" "$etc/systemd/user/app.slice.d" 2>/dev/null || {
        echo "ERROR: the table's ceiling ($ceiling) is not app.slice's" >&2; failed=1; }

      # THE FIVE UNITS THE PANEL MAY START, and the rule that lets it.
      #
      # A panel that could start any unit would be a bigger door than the whole
      # policy above closes.
      for what in profile@ sweep@; do
        [ -e "$etc/systemd/system/ronoctua-memory-$what.service" ] || {
          echo "ERROR: the unit ronoctua-memory-$what is missing" >&2; failed=1; }
      done

      [ "$failed" = 0 ] || exit 1
      echo "OK: a chain of four levels, app.slice armed, the desktop out of reach, a table for both profiles"
    '';

  # THE ISO CARRIES WHAT THE TARGET MACHINE WOULD OTHERWISE COMPILE.
  #
  # Everything a NixOS closure inherits from nixpkgs comes prebuilt from the
  # public cache. Everything this repository makes does not exist there, and was
  # being built on the machine being installed: the shell, the compositor from the pinned
  # input, `libghostty-vt` and its Zig toolchain, the five wasm buffers, the
  # font family from a GitHub Release. That is where an install's afternoon went.
  #
  # This check is the LIST's half of the promise, and `iso-is-measured` is the
  # artefact's: what goes on the medium has to be enough, and it has to have
  # come out whole. Measured on 2026-08-15: 3702 MiB — and since the owner
  # removed the ceiling there is no number it has to stay under.
  #
  # The names are grepped in the seed's CLOSURE and not in the list, because
  # most of them arrive through `ronoctua-shell`'s baked store paths rather than
  # by being written out — and it is the closure that goes on the ISO.
  #
  # ALWAYS: the distro has no binary cache of its own (a person's own cache
  # is theirs, and this ISO knows no person), so the seed never leaves the
  # medium. `binary-cache-declared-once` holds the list to it at evaluation;
  # this reads what the ISO's closure holds.
  #
  # EVERY SHIPPED PROGRAM BY ITS STORE PATH (2026-10-12), where crane's whole
  # workspace (`ronoctua-0.1.0`) used to be the one name to look for: every
  # entry of `rust.shipped` (`nix/rust/outputs.nix`), the shell's bundle and
  # every `ship` program in the form a machine runs it. The path and not a
  # name: the bundle holds COPIES of the shell's and the tag writer's units,
  # so a unit's name says nothing of what the ISO carries, and a second
  # build under the same name would answer for a path the target does not
  # have. Which `ship` program is an entry or inside one is
  # `seed-holds-every-shipped-bin`'s question.
  iso-carries-the-seed =
    let
      seed = pkgs.closureInfo {
        rootPaths = self.nixosConfigurations.installer.config.isoImage.storeContents;
      };
      plain = builtins.unsafeDiscardStringContext;
      shipped = lib.toList rust.shipped;
      ofShipped =
        if !(rust ? shipped) then
          ''
            echo "ERROR: the build names no rust.shipped, what ships in the form a machine runs it" >&2
            failed=1
          ''
        else if !(lib.elem (plain rust.shell.drvPath) (map (d: plain d.drvPath) shipped)) then
          ''
            echo "ERROR: rust.shipped does not hold the footer's bundle (rust.shell): it is not what ships" >&2
            failed=1
          ''
        else
          lib.concatMapStrings (d: ''
            grep -qxF ${lib.escapeShellArg (plain d.outPath)} ${seed}/store-paths || {
              echo "ERROR: ${d.name} (rust.shipped) does not go into the ISO — the target machine will compile it" >&2
              failed=1
            }
          '') shipped;
    in
    mkCheck "iso-carries-the-seed" [ pkgs.gnugrep pkgs.coreutils ] ''
      failed=0
      ${ofShipped}
      # NOT libghostty-vt any more: it was on this list for crane's
      # workspace's sake, and the only program that links it is the terminal
      # differential (a driver), so nothing a machine runs needs it and the
      # target never builds it.
      for ours in -scroll- -ronoctua-iconset \
                  -ronoctua-buffer-memory- \
                  -ronoctua-buffer-keyboard- \
                  -ronoctua-buffer-transfers- \
                  -ronoctua-buffer-format- \
                  -ronoctua-buffer-brain- \
                  -noctua-icon-theme- \
                  -ronoctua-ambience- \
                  -noctua-iosevka-ttf-nerdfonts-; do
        grep -q -e "$ours" ${seed}/store-paths || {
          echo "ERROR: $ours does not go into the ISO — the target machine will compile it" >&2
          failed=1
        }
      done

      # The flake's inputs travel as SOURCES. Without them the target has the
      # built pieces and still has to reach the network to evaluate the flake
      # that names them — which is the same install, waiting on the same wire.
      grep -q -e "-source" ${seed}/store-paths || {
        echo "ERROR: the fonts from the flake's inputs do not go into the ISO" >&2; failed=1; }

      [ "$failed" = 0 ] || exit 1
      echo "OK: $(wc -l < ${seed}/store-paths) paths in the seed"
    '';

  # THE REDUCED PROFILE IS REDUCED, AND STILL IS THE DISTRO.
  #
  # Measured on 2026-08-14: `full` 22,76 GiB, `minimal` 6,90 GiB.
  #
  # # Why each name is checked on BOTH sides
  #
  # A check that only says "android-studio is not in the reduced closure" goes
  # green when the name is misspelled, when the package is renamed upstream, and
  # when the whole system fails to have any packages at all. Requiring it to be
  # PRESENT in the full one first makes the difference the thing being asserted,
  # which is what the profile actually promises.
  #
  # # And what may never leave
  #
  # The second list is the more important one. A reduced profile that dropped
  # the compositor or the footer would be smaller and would not be this system — the point
  # was never the gigabytes, it was installing in minutes what one can then add
  # to one line at a time.
  profile-minimal-closes =
    let
      closureOf =
        drv:
        pkgs.closureInfo {
          rootPaths = [ drv ];
        };
      minimal = closureOf self.nixosConfigurations.minimal.config.system.build.toplevel;
      full = closureOf self.nixosConfigurations.noctua.config.system.build.toplevel;
    in
    mkCheck "profile-minimal-closes" [ pkgs.gnugrep pkgs.coreutils ] ''
      failed=0

      # Applications: in the full one, out of the reduced one.
      #
      # `-ffmpeg-full-` USED TO BE ON THIS LIST and is now on the other one.
      # That is the owner's decision, and the line between the two lists is
      # what it changed: ffmpeg is not an application one installs to USE, it
      # is format SUPPORT, and a machine that cannot preview a video or read a
      # photograph is not a reduced distro. What stayed here is `-vlc-`, which
      # is a player — which is exactly the line.
      #
      # WAYDROID AND APPIMAGE-RUN are the software centre's two heavy supports
      # (0,72 GB and 1,53 GB on their own, measured), `mkDefault full` in
      # `nix/modules/profile.nix`. They are on this list because the CLI's
      # wrapper names a tool only when its module is on: if it ever named
      # one unconditionally, the reduced profile would carry it through the
      # update runner, and nothing else would say so.
      #
      # THE WORKSHOP (`workshop.enable`): Blender and OrcaSlicer, ~3,3 GiB
      # measured. The agents and rust LEFT this list (2026-10-05): working on
      # the distro is in both profiles, and they are on the other one.
      #
      # THE OFFICE AND THE CRAFTING APPS (2026-10-20, `office.enable` and
      # `crafts.enable`): ONLYOFFICE, LibreOffice and the distro's wrapped
      # AppImages, whose names all start `ronoctua-appimage-`. VS CODE
      # (`editor.vscode`), ~0,91 GiB: its FHS environment holds the program,
      # whose store name this is.
      for app in -android-studio- -google-chrome- -emacs-pgtk-30 -vlc- \
                 -flutter- -dart- -go-1 -noctua-iosevka-ttf-3 \
                 -noctua-icon-theme- -waydroid- -appimage-run \
                 -blender-5 -orca-slicer- \
                 -onlyoffice-desktopeditors- -libreoffice- -ronoctua-appimage- \
                 -vscode-1; do
        grep -q -e "$app" ${full}/store-paths || {
          echo "ERROR: $app is not in the full profile — did the name change?" >&2
          failed=1
          continue
        }
        if grep -q -e "$app" ${minimal}/store-paths; then
          echo "ERROR: $app is still in the minimal profile" >&2
          failed=1
        fi
      done

      # The superpack is on that list because the switch is REAL now. It used to
      # be excluded from the profile table for the opposite reason: the shell
      # carried its store path baked in, so turning the option off removed it
      # from `systemPackages` and left all 0,61 GiB in the closure. This line is
      # what would fail if the path were ever baked in again.

      # And what the reduced profile may NEVER lose, or it stops being this
      # system rather than becoming a smaller one.
      #
      # THE SIX COMPONENTS ARE ON THAT LIST for the same reason the superpack
      # is on the one above, and by the same mechanism: they no longer arrive by
      # carriage inside the binary (`nix/rust.nix`), they arrive through the
      # wrapper. If the module ever points at the unwrapped workspace again, the
      # system installs a shell whose every buffer key opens nothing — and it
      # installs FASTER, with nothing else giving it away.
      # THE DECODERS ARE ON THIS LIST, and they are the reason it grew. The
      # file manager's preview and info panels reach for `ffmpeg` and
      # `exiftool` by a path taken from the ENVIRONMENT, so nothing in the
      # binary would fail if they left — the panels would simply say the
      # program is missing, on every reduced machine, for ever. This line is
      # what turns that into a build failure instead.
      #
      # FLATPAK TOO: it is support and not an application, on in both
      # profiles — without it the reduced machine has no way to a graphical
      # program the flake does not carry.
      #
      # AND WORKING ON THE DISTRO (2026-10-05): the devshell's rust, QEMU and
      # OVMF kept for `nix develop`, and the two coding agents.
      #
      # AND COMMON LISP (2026-10-20), in the terminal of both: the three
      # Lisps, alive-lsp, qlot, the two editor servers among the libraries,
      # `quicklisp-install` and rlwrap.
      for kept in -scroll- -noctua-iosevka-ttf-nerdfonts- -ghostty- \
                  -networkmanager- -systemd- -ffmpeg-full- -exiftool- -flatpak- \
                  -rustc-1 -rust-std-1.*-wasm32-wasip2 -qemu-1 -OVMF- \
                  -claude-code- -codex- \
                  -sbcl-2 -ccl-1 -ecl-2 -alive-lsp -qlot- -sbcl-swank- -sbcl-slynk- \
                  -quicklisp-install -rlwrap- \
                  -ronoctua-iconset \
                  -ronoctua-buffer-memory- -ronoctua-buffer-keyboard- \
                  -ronoctua-buffer-transfers- \
                  -ronoctua-buffer-format- -ronoctua-buffer-brain-; do
        grep -q -i -e "$kept" ${minimal}/store-paths || {
          echo "ERROR: the minimal profile lost $kept, which is part of the distro" >&2
          failed=1
        }
      done

      # THE FOOTER, by its store path: `rust.shell`, what the modules run —
      # crane's workspace under a wrapper once, the shell and its neighbours
      # copied into one `bin/` now. Its path and not its programs' names: a
      # copy cites nothing of the unit it came from. The other shipped
      # programs are not asked here: a reduced machine leaves out on purpose
      # the ones of the modules it turns off (the player's daemon, the
      # browser's host, the Incus job), and the ISO is what has to carry
      # them all (`iso-carries-the-seed`).
      grep -qxF ${lib.escapeShellArg (builtins.unsafeDiscardStringContext rust.shell.outPath)} ${minimal}/store-paths || {
        echo "ERROR: the minimal profile lost the footer (${rust.shell.name}, rust.shell), which is part of the distro" >&2
        failed=1
      }

      [ "$failed" = 0 ] || exit 1

      m=$(wc -l < ${minimal}/store-paths)
      f=$(wc -l < ${full}/store-paths)
      [ "$m" -lt "$f" ] || {
        echo "ERROR: the minimal one has $m paths and the full one $f" >&2; exit 1; }
      echo "OK: minimal $m paths, full $f"
    '';

  # THE ISO CARRIES NOTHING THAT ONLY A DESKTOP OR A COMPILER COULD USE.
  #
  # It used to carry 2,94 GiB of exactly that, and nothing said so: the ISO
  # installed `rust.workspace`, the one derivation that holds EVERY binary of the
  # workspace. A derivation references whatever its bytes mention, so
  # `ronoctua-shell` was dragging in `libghostty-vt` — and with it Zig, clang and
  # LLVM, 1,7 GiB — plus the icon superpack and mesa through the `option_env!`
  # paths. A console installer can run none of it.
  #
  # The fix was to install only `bin/ronoctua-install` (`nix/rust.nix`), and the
  # measurement is what makes it worth a check: the installer's closure went from
  # 5,81 GiB to 2,87 GiB and the ISO from 2,1 GiB to 1,46 GiB. That is the budget
  # the seeded closure spends, so a silent regression here costs twice.
  #
  # `closureInfo` and not `nix path-info`: inside the sandbox there is no daemon
  # to ask, and the closure has to be an INPUT of the derivation to be readable.
  iso-has-no-toolchain =
    let
      closure = pkgs.closureInfo {
        rootPaths = [ self.nixosConfigurations.installer.config.system.build.toplevel ];
      };
    in
    mkCheck "iso-has-no-toolchain" [ pkgs.gnugrep ] ''
      # Each of the four was measured in the closure before the fix. `mesa` is
      # here because a TTY installer has no GL at all — if it ever comes back it
      # came back by accident.
      failed=0
      for unwanted in -zig- -clang- -llvm- -noctua-icon-theme- -mesa-; do
        if found=$(grep -e "$unwanted" ${closure}/store-paths); then
          echo "ERROR: the ISO carries $unwanted, which only a desktop or a compiler uses" >&2
          echo "$found" >&2
          failed=1
        fi
      done
      [ "$failed" = 0 ] || exit 1

      # And the installer binary IS there — a check that only forbids would go
      # green on an ISO that lost the installer altogether.
      grep -q -e "-ronoctua-installer" ${closure}/store-paths || {
        echo "ERROR: the installer itself is not in the ISO" >&2; exit 1; }

      echo "OK: $(wc -l < ${closure}/store-paths) paths, none of them desktop or compiler"
    '';

  # THE ISO IS MEASURED, AND THERE IS NO LONGER A CEILING.
  #
  # There was one of 4 GiB, and the number was never arbitrary: it is the
  # maximum FILE SIZE of FAT32. It only ever bit when the `.iso` was COPIED
  # onto a stick — Ventoy, or an ESP the firmware boots the file from. Written
  # with `dd`, which writes raw sectors and which is what `docs/INSTALL.md`
  # already tells a person to do, there is no limit at all.
  #
  # The owner removed the ceiling and chose `dd`. What the ceiling was
  # defending is gone with it: the image may now carry whatever the target
  # would otherwise have to compile, and the seed is the whole point of it.
  #
  # WHAT IS LEFT IS STILL AN ASSERTION, and not a number printed into a log.
  # An ISO that comes out tiny is a build that silently lost its contents —
  # the `storeContents` list evaluating to nothing produces a perfectly valid,
  # perfectly useless image, and that failure looks exactly like success.
  # A hundred mebibytes is far below anything this ISO has ever measured and
  # far above an empty one, which is what makes it a floor and not a target.
  iso-is-measured = mkCheck "iso-is-measured" [ pkgs.coreutils ] ''
    iso=$(find ${self.packages.${system}.iso}/iso -name '*.iso' | head -1)
    [ -n "$iso" ] || { echo "ERROR: no .iso came out of the derivation" >&2; exit 1; }
    bytes=$(stat -c %s "$iso")
    floor=$((100 * 1024 * 1024))
    echo "ISO: $((bytes / 1024 / 1024)) MiB"
    if [ "$bytes" -lt "$floor" ]; then
      echo "ERROR: an ISO under 100 MiB — it lost the content, and an" >&2
      echo "      an empty image is valid: check the storeContents." >&2
      exit 1
    fi
    echo "OK: the ISO came out whole (no ceiling: it is written with dd)"
  '';

  # THE SIX DOCUMENTS EXIST.
  #
  # `AGENTS.md` is the one file of instructions for agents. There used to be a
  # `CLAUDE.md` holding a single `@AGENTS.md` import, checked here so a broken
  # import could not drop every rule in silence; the assistant now reads
  # `AGENTS.md` by that name, so the pointer and its check are gone (2026-09-26).
  #
  # There WAS a 150-line ceiling on the `AGENTS.md`, on the reasoning that it is
  # the only file that goes into every agent's context on its own, and that
  # going past the ceiling does not make it more informative — it makes it less
  # read. The owner removed it, and the reason is the other half of that same
  # sentence: it being the only file that arrives on its own is exactly why the
  # working rules have to live in it. A rule kept somewhere cheaper is a rule
  # that reaches an agent who thought to go looking, which is the ones who did
  # not need it.
  #
  # What the ceiling was really defending is still true and is now nobody's
  # check: length costs attention. Whoever writes here cuts before adding.
  #
  # `PENDING.md` is on the list because the "what is missing" half disappears
  # if it is not demanded: a project with no place for a pending item to live
  # goes back to hiding an overdue promise in a code comment.
  docs-exist = mkCheck "docs-exist" [ pkgs.coreutils ] ''
    for f in ${../AGENTS.md} ${../README.md} \
             ${../docs/ARCHITECTURE.md} ${../docs/PENDING.md} \
             ${../docs/INSTALL.md} ${../docs/DEVELOPMENT.md}; do
      test -s "$f" || { echo "ERROR: $f is missing or empty" >&2; exit 1; }
    done

    echo "AGENTS.md: $(wc -l < ${../AGENTS.md}) lines"

    # The PENDING.md must not become a changelog. Its rule is "on finishing,
    # remove it"; a struck-through or done-marked item is the start of the rot.
    # Anchored on a LIST ITEM: the rule at the top itself cites the markers in
    # order to forbid them, and a loose grep would report the text that forbids them.
    if grep -qE '^ *[-*|] *(\[x\]|~~|✅)' ${../docs/PENDING.md}; then
      echo "ERROR: PENDING.md has an item struck through as done." >&2
      echo "      The rule is to remove, not to strike through — it keeps no history." >&2
      exit 1
    fi

    echo "OK: the six documents exist, and PENDING did not become a changelog"
  '';

  architecture-sections = mkCheck "architecture-sections" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # PROSE: this check's subject IS the prose.
    # FILE-WIDE: and every file of the tree is swept for it. What it asks is
    # whether a sentence — nearly always a `//` comment — points at a section
    # of a document that exists. Stripping the comments would leave it sweeping
    # a tree for a pattern that no longer occurs anywhere in it, and reporting
    # nothing wrong for ever. The floor below is what stands in for the strip:
    # a sweep that stopped finding references is refused.
    doc = pathlib.Path("${self}/docs/ARCHITECTURE.md").read_text()
    floor(len(doc), 10000, "characters of docs/ARCHITECTURE.md")

    # EXACT match, and not "contains": the chapter heading `1. Fontes, glifos e
    # icones` contains the word `Fontes`, so a substring test would go on
    # accepting a reference to a `Fontes` section that had been renamed away.
    # That is this check passing while the defect it exists for is present, and
    # it happened on the first run.
    titles = set()
    for m in re.finditer(r"^#{1,5} (.+)$", doc, re.M):
        t = m.group(1).strip()
        titles.add(t)
        titles.add(re.sub(r"^\d+\.\s*", "", t))  # chapters carry a number

    # `section "X"` in a comment, in any tracked source file.
    ref = re.compile(r'ARCHITECTURE\.md,\s*(?:section|secao|seção)\s*"([^"]+)"')
    broken, seen = [], 0
    for f in pathlib.Path("${self}").rglob("*"):
        if f.suffix not in {".rs", ".nix", ".py", ".md"} or not f.is_file():
            continue
        try:
            content = f.read_text()
        except (UnicodeDecodeError, OSError):
            continue
        for m in ref.finditer(content):
            seen += 1
            target = m.group(1)
            if target not in titles:
                broken.append(f"{f}: section \"{target}\" does not exist in ARCHITECTURE.md")

    floor(seen, 2, "cross-references by section name")
    if broken:
        print("ERROR: a cross-reference to a section that does not exist:", file=sys.stderr)
        for b in broken:
            print("  " + b, file=sys.stderr)
        sys.exit(1)
    print(f"OK: {seen} cross-references by section name, all of which resolve")
    PY
  '';
  # WHAT THE FOOTER READS AT RUNTIME IS EXPORTED BEFORE THE FOOTER STARTS.
  #
  # `dev-exports-what-the-build-bakes` covers the variables the COMPILATION
  # bakes. It says nothing about WHEN, and the two that are not build inputs —
  # `RONOCTUA_ICONS` and `RONOCTUA_FILES_START` — were exported inside the block
  # that sets up the hot reload, which runs AFTER the first footer is already up.
  #
  # So every session's first footer had neither, and only a footer restarted by
  # a recompilation did. Both failures are silent, because a missing variable is
  # a fallback and not an error: the launcher opened with category glyphs that
  # were never replaced by the app's icon, and `LEADER .` opened the home while
  # `~/main` sat right there. The second one was reported from the screen.
  #
  # The rule is about ORDER, so the check reads line numbers: the export has to
  # come before the line that launches the footer.
  dev-exports-before-it-starts = mkCheck "dev-exports-before-it-starts" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the question is the ORDER of two lines in a shell script —
    # which export comes before which launch — and a script has no functions to
    # narrow to.
    #
    # What the SHELL reads at runtime and no build bakes. A variable that
    # arrives late is a variable that did not arrive.
    AT_RUNTIME = [
        "RONOCTUA_ICONS",
        "RONOCTUA_FILES_START",
        "RONOCTUA_FILES_SIDEBAR",
        "RONOCTUA_THEME",
        "RONOCTUA_THEMES",
        # THE WORLD. A variable that arrives after the footer makes the globe
        # work on an installed machine and do nothing in the loop, which is the
        # first place anybody looks.
        "RONOCTUA_ATLAS",
        # AND ONE THE LOOP EMPTIES: the installed footer's children inherit the
        # units it restarts before the session ends, and the nested footer
        # quitting with them would restart the person's own daemons.
        "RONOCTUA_SESSION_END_RESTARTS",
    ]

    # `hashless` keeps one line per line, so the line NUMBERS this check
    # reports are still the file's — and it takes a `#` off the end of a line,
    # which the `startswith` test below let stand.
    text = hashless(pathlib.Path("${../nix/dev.nix}").read_text())
    floor(len(text), 2000, "characters of nix/dev.nix")
    lines = text.splitlines()

    launch = None
    for n, line in enumerate(lines, 1):
        if "ronoctua-footer-single" in line:
            launch = n
            break
    if launch is None:
        print("ERROR: could not find where the footer comes up in nix/dev.nix.", file=sys.stderr)
        raise SystemExit(1)

    gaps = []
    for name in AT_RUNTIME:
        where = [
            n
            for n, line in enumerate(lines, 1)
            if re.match(r"\s*export " + name + r"=", line)
        ]
        if not where:
                gaps.append(f"{name}: is not exported in nix/dev.nix")
        elif min(where) > launch:
            gaps.append(
                f"{name}: exported on line {min(where)}, and the footer comes up on {launch}"
            )

    if gaps:
        print("ERROR: a runtime variable arrives AFTER the footer.", file=sys.stderr)
        print("", file=sys.stderr)
        for g in gaps:
            print("       " + g, file=sys.stderr)
        print("", file=sys.stderr)
        print("       The session's first footer does not have it, and only a restart", file=sys.stderr)
        print("       gains it. A silent failure: a missing variable is a fallback, not an error.", file=sys.stderr)
        raise SystemExit(1)
    print(f"OK: the {len(AT_RUNTIME)} runtime variables come out before line {launch}")
    END
  '';

  # A `trap` THAT CALLS A FUNCTION THAT DOES NOT EXIST CLEANS NOTHING UP.
  #
  # `nix/bench-frames.nix` had `trap 'clean_up; rm -rf "$dir"' EXIT` next to a
  # function named `cleanup`: the rename to English reached the definition and
  # not the string. Nothing said so — a shell string is not code to shellcheck,
  # and the trap only runs at exit, when nobody is reading. The bench came back
  # with its numbers and left a nested compositor and a footer RUNNING, plus the
  # temp directory, because `rm -rf` came after the word that failed.
  #
  # That is the shape this project keeps paying for: the failure is at the end,
  # the message scrolls past, and what is left behind is somebody else's
  # problem. A word that has to name something is a name, and a name can be
  # checked.
  #
  # The allow-list is short on purpose. A trap normally kills something, removes
  # something, or calls a function of the script's own; anything else earns a
  # line here and the thought that goes with it.
  trap-calls-something-that-exists = mkCheck "trap-calls-something-that-exists" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys

    KNOWN = {
        "rm", "kill", "exit", "true", "false", "echo", "wait", "pkill",
        "umount", "rmdir", "sync", "printf", "stty", "tput", "clear",
        "killall", "chmod", "cp", "mv",
    }
    root_dir = pathlib.Path("${self}")
    gaps = []
    for f in sorted(root_dir.rglob("*.nix")):
        if any(x in f.parts for x in (".git", "result", "target", ".direnv")):
            continue
        # COMMENT LINES DO NOT COUNT — including this check's own, which
        # quotes the very trap that earned it and would flag itself.
        text = "\n".join(
            "" if l.lstrip().startswith("#") else l
            for l in f.read_text(errors="replace").splitlines()
        )
        defined = set(re.findall(r"^\s*([a-z_][a-z0-9_]*)\(\)\s*\{", text, re.M))
        for m in re.finditer(r"""trap\s+(['"])(.*?)\1""", text, re.S):
            for piece in re.split(r"[;&|\n]+", m.group(2)):
                word = piece.strip().split(" ")[0].strip()
                if not word or not re.fullmatch(r"[a-z_][a-z0-9_]*", word):
                    continue
                if word in defined or word in KNOWN:
                    continue
                line = text[: m.start()].count("\n") + 1
                rel = f.relative_to(root_dir)
                gaps.append(f"{rel}:{line}: o trap chama `{word}`")

    if gaps:
        print("ERROR: a trap calling what does not exist.", file=sys.stderr)
        print("", file=sys.stderr)
        for g in gaps:
            print("       " + g, file=sys.stderr)
        print("", file=sys.stderr)
        print("       It is neither a function defined in the file nor a command from the list.", file=sys.stderr)
        print("       The trap fails on exit, silently, and what it would clean up stays.", file=sys.stderr)
        raise SystemExit(1)
    print("OK: every trap calls a function that exists or a known command")
    END
  '';

  # THE GATE HAS TO FETCH WHAT NO CACHE HAS — and the wiring is the risk.
  #
  # `nix/prefetch.nix` exists because one source in the `full` profile cannot be
  # downloaded by `fetchurl` on a connection that resets: it retries without
  # resuming, so it restarts from zero and never finishes. The tool works; what
  # can quietly stop being true is that the gate CALLS it.
  #
  # Unwired, nothing breaks at evaluation and nothing breaks in the short loop.
  # The gate simply goes back to dying after minutes of work, with a message
  # (`cannot download ... from any mirror`) that points at Google instead of at
  # the missing call — which is exactly how an afternoon was lost once already.
  #
  # It also has to come FIRST. Fetching after the Rust build (phase 1) would
  # still work, and would still make everyone pay the compile before finding
  # out the network is the problem.
  gate-fetches-what-no-cache-has = mkCheck "gate-fetches-what-no-cache-has" [ pkgs.gnugrep ] ''
    script=${gateApp}/bin/ronoctua-gate
    tool=${prefetchApp}/bin/ronoctua-prefetch

    if ! grep -qF "$tool" "$script"; then
      echo "ERROR: the gate does not call the prefetch." >&2
      echo "      Without it, the gate dies after minutes with" >&2
      echo "      'cannot download ... from any mirror', which looks" >&2
      echo "      a file removed, and it is not — see nix/prefetch.nix." >&2
      exit 1
    fi

    # `|| true`: under pipefail a grep that finds nothing would end the check
    # here, silently, instead of at the sentence below.
    called_at=$(grep -nF "$tool" "$script" | head -1 | cut -d: -f1 || true)
    heavy_at=$(grep -n 'echo "== 1\. the Rust build' "$script" | head -1 | cut -d: -f1 || true)
    if [ -z "$heavy_at" ]; then
      echo "ERROR: could not find the gate's Rust build (phase 1) in the gate." >&2
      exit 1
    fi
    if [ "$called_at" -ge "$heavy_at" ]; then
      echo "ERROR: the prefetch comes AFTER the Rust build (line $called_at, against $heavy_at)." >&2
      echo "      That way the compiler runs whole before finding out that the" >&2
      echo "      problem is the network." >&2
      exit 1
    fi
    echo "OK: the gate downloads what no cache has, before compiling"
  '';

  the-explanation-has-its-own-register =
    mkCheck "the-explanation-has-its-own-register" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())
        exec(open("${shellPrelude}").read())

        # FILE-WIDE: a door draws the sentence wherever it lays out its hint
        # line, and what bounds the question is the 900 characters after the
        # call that produced it — a window, not a function.

        # THE SENTENCE UNDER THE HINT LINE HAD TWELVE PAINTERS, and it has three.
        #
        # It was `Register::Prose` — the hint's OWN words — in every one of the
        # twelve, and the owner read it off the screen: *"a cor do texto está igual
        # à dos textos dos outros atalhos, assim não criando uma boa distinção
        # visual"*. A dozen doors writing the same line by hand is exactly the shape
        # of `the-cursor-is-a-colour`, which found a third view nobody had looked at.
        #
        # THE TEN WINDOWS DRAW IT THROUGH ONE PAINTER NOW (`chrome::Hinted::head`),
        # which is what this check family exists to produce rather than to police.
        # What is left to sweep is the three that still lay the line out: the shared
        # painter, the footer — whose row comes out of the REGION and never off its
        # own height — and the file manager's window, whose drawer is its own.
        # `every-window-header-opens` is what says the ten still go through it.
        #
        # THE COUNT IS EXACT ON PURPOSE. A floor would let a door STOP explaining;
        # an exact number makes a FOURTH painter — a door that writes the line by
        # hand instead of asking `Hinted` — announce itself, which is how the
        # twelfth door announced itself when it was written by copying one of
        # these.
        bad = []
        doors = []
        for f in sorted(shell_files("**/*.rs")):
            body = code_of(f.read_text())
            # WHERE THE SENTENCE IS TAKEN OUT, in its three spellings: the shared
            # painter asks its own `said()` (which is what hides it with the line
            # shut), the file manager's window asks `Hinted::said`, and the
            # footer keeps a field of its own.
            for m in re.finditer(
                r"(hinted\.said\(\)|self\.hint_said\.as_ref\(\)|Some\(said\) = self\.said\(\))",
                body,
            ):
                after = body[m.end() : m.end() + 900]
                if "ronoctua_render::Span" not in after:
                    continue
                doors.append(f.name)
                if "Register::Explain.color()" not in after:
                    bad.append(
                        f"{f.name} draws the pointer's sentence and not in "
                        "`Register::Explain` — it reads as one more shortcut on the "
                        "row above it"
                    )
        if len(doors) != 3:
            bad.append(
                f"{len(doors)} places draw the sentence, and there are three; the "
                "sweep is reading the wrong thing, or a door has stopped asking "
                "`chrome::Hinted` and started laying the line out again"
            )

        # AND THE REGISTER RESOLVES TO A TOKEN NOBODY ELSE ON THOSE LINES WEARS.
        # The tone itself is the theme generator's to hold — `text.subtle.explain`
        # is gated against both registers of the hint and all three steps of the
        # content ramp — and this is the half that says the shell ASKS for it.
        floor(len(doors), 3, "places drawing the pointer's sentence")
        chrome = code_of(shell_file("chrome.rs").read_text())
        floor(len(chrome), 20000, "characters of chrome.rs")
        if "Self::Explain => tokens::color::TEXT_SUBTLE_EXPLAIN," not in chrome:
            bad.append("`Register::Explain` no longer resolves to `text.subtle.explain`")

        if bad:
            print("ERROR: the sentence under the hint line is not its own thing.", file=sys.stderr)
            print("", file=sys.stderr)
            for b in bad:
                print("       " + b, file=sys.stderr)
            raise SystemExit(1)
        print(f"OK: {len(doors)} painters draw the pointer's sentence, every one in its own register")
        END
      '';

  # -------------------------------------------------------------------
  # The software centre — the person's own programs (invariant 6's dated
  # exception), and the width of every door it opens
  # -------------------------------------------------------------------

  # TWO READINGS THE SOFTWARE CENTRE'S CHECKS SHARE, and the prelude does not
  # have. Opened AFTER the prelude, never instead of it.
  #
  # * `product` cuts the test modules off, `pub(crate) mod testing` included.
  #   The prelude's `without_tests` stops at `mod` right after the attribute,
  #   so `appimage.rs` (a fake `unsquashfs`, an AppImage built in memory) and
  #   `github.rs` (canned answers) would be read as product. Every test module
  #   of the crate sits at the end of its file, after the product.
  # * `strings_of` lists every string literal with where it begins and ends.
  #   The needles here are flags, paths and program names, and every one of
  #   them is a STRING — `code_of` empties them, and `uncommented` keeps them
  #   but cannot say where one ends: a character literal like the one that
  #   holds a double quote would open a string that never closes.
  # * `parts` splits a call's arguments at the commas of its own level.
  softwarePy = pkgs.writeText "ronoctua-software-checks.py" ''
    import re as _re

    def product(text):
        # `#[cfg(test)]`, or `#[cfg(all(test, …))]` — a test module behind a
        # feature too (never `any(test, …)`: that one builds outside tests).
        m = _re.search(r"#\[cfg\((?:test|all\(\s*test\b[^\]]*)\)\]\s*(?:pub(?:\([^)]*\))?\s+)?mod\b", text)
        return text if m is None else text[: m.start()]

    def is_test_file(path):
        # A FILE THAT IS A TEST MODULE (`software/tests.rs`, declared by its
        # parent as `#[cfg(test)] mod tests;`): `product` cuts a module
        # written inline, and a whole file of tests has nothing to cut.
        parent = path.parent
        declared = [parent.with_suffix(".rs"), parent / "mod.rs", parent / "lib.rs", parent / "main.rs"]
        pattern = r"#\[cfg\(test\)\]\s*(?:pub(?:\([^)]*\))?\s+)?mod\s+" + _re.escape(path.stem) + r"\s*;"
        return any(d.is_file() and d != path and _re.search(pattern, d.read_text()) for d in declared)

    def strings_of(text):
        out, i, n = [], 0, len(text)
        while i < n:
            c = text[i]
            if text.startswith("//", i):
                j = text.find("\n", i)
                i = n if j < 0 else j
                continue
            if text.startswith("/*", i):
                j = text.find("*/", i + 2)
                i = n if j < 0 else j + 2
                continue
            if c == "\x27":
                m = _re.match(r"\x27(?:\\.|[^\\\x27])\x27", text[i:])
                i += m.end() if m else 1
                continue
            if c == "r":
                j = i + 1
                while j < n and text[j] == "#":
                    j += 1
                if j < n and text[j] == "\"" and (j > i + 1 or not text[i - 1 : i].isalnum()):
                    close = "\"" + "#" * (j - i - 1)
                    end = text.find(close, j + 1)
                    stop = n if end < 0 else end
                    out.append((i, stop + len(close), text[j + 1 : stop]))
                    i = stop + len(close)
                    continue
            if c == "\"":
                j = i + 1
                while j < n and text[j] != "\"":
                    j += 2 if text[j] == "\\" else 1
                out.append((i, j + 1, text[i + 1 : j]))
                i = j + 1
                continue
            i += 1
        return out

    def parts(args):
        out, depth, cur, i, n = [], 0, [], 0, len(args)
        while i < n:
            c = args[i]
            if c == "\"":
                j = i + 1
                while j < n and args[j] != "\"":
                    j += 2 if args[j] == "\\" else 1
                cur.append(args[i : j + 1])
                i = j + 1
                continue
            if c in "([{":
                depth += 1
            elif c in ")]}":
                depth -= 1
            elif c == "," and depth == 0:
                out.append("".join(cur).strip())
                cur = []
                i += 1
                continue
            cur.append(c)
            i += 1
        if "".join(cur).strip():
            out.append("".join(cur).strip())
        return out
  '';

  # ANDROID'S DOOR IS FOUR UNITS WIDE, and each is one the crate starts.
  #
  # `nix/modules/android.nix` lets the person START four root units: prepare
  # with one image or the other, erase, and read the device id Google asks
  # for. `YES`, because there is no polkit agent in this session — so what
  # buys the width back is that the rule names exactly what
  # `crates/ronoctua-software/src/android.rs` starts, and nothing else.
  #
  # BOTH DIRECTIONS, the shape of `timedate-polkit-is-narrow`: a unit granted
  # and never started is width nobody uses; a unit started and never granted
  # is a Prepare that comes back refused on somebody's screen. The crate side
  # is read from every `start_unit(…)` call, resolved through its constants
  # and through `init_unit` × `AndroidImage::system_type`, so a third image
  # or a fifth unit is seen on both sides or fails here.
  #
  # AND THE ALTERNATIVES ARE BRACKETED: `&&` binds tighter than `||`, and a
  # bare disjunction of units grants every unit after the first to anyone
  # for anything (`rescue.nix` shipped that once).
  android-polkit-is-narrow =
    let
      config = self.nixosConfigurations.vm.config;
      # THE UNITS THE SYSTEM DECLARES, so a rule naming one that does not
      # exist — a typo, a template renamed — is a finding and not a door to
      # nowhere. A template is declared as `name@`.
      declared = builtins.filter (lib.hasPrefix "ronoctua-android") (
        builtins.attrNames config.systemd.services
      );
    in
    mkCheck "android-polkit-is-narrow" [ pkgs.python3 ] ''
      export RONOCTUA_USER=${config.ronoctua.user}
      export RONOCTUA_UNITS=${lib.escapeShellArg (lib.concatStringsSep " " declared)}
      cat > rules.js <<'RULES'
      ${config.security.polkit.extraConfig}
      RULES
      python3 - <<'END'
      import os, pathlib, re, sys
      exec(open("${pyPrelude}").read())
      exec(open("${softwarePy}").read())

      user = os.environ["RONOCTUA_USER"]
      declared = set(os.environ["RONOCTUA_UNITS"].split())
      src = pathlib.Path("${../crates/ronoctua-software/src}")
      wrong = []

      # WHAT THE CRATE STARTS. `uncommented` and never `code_of`: every unit
      # name is a string literal. `product` cuts the tests, which start fake
      # units by the dozen.
      android = uncommented(product((src / "android.rs").read_text()))
      order = uncommented(product((src / "order.rs").read_text()))
      floor(len(android), 5000, "characters of android.rs")

      def constant(name):
          m = re.search(r"pub const " + name + r": &str = \"([^\"]+)\";", android)
          return m.group(1) if m else None

      # `init_unit` is a `format!` of one image's instance name, and the
      # instances are `AndroidImage::system_type`'s answers.
      init = must(body_of(android, "init_unit"), "`android::init_unit`")
      shape = re.search(r"format!\(\s*\"([^\"{]*)\{[^}]*\}([^\"]*)\"", init)
      images = must(
          body_of(must(scope(order, r"impl AndroidImage\b"), "`impl AndroidImage`"), "system_type"),
          "`AndroidImage::system_type`",
      )
      instances = re.findall(r"=>\s*\"([^\"]+)\"", images)
      floor(len(instances), 2, "images `AndroidImage::system_type` names")
      if not shape:
          wrong.append("`init_unit` no longer builds its name with one `format!`; this check cannot read it")
          inits = set()
      else:
          inits = {shape.group(1) + i + shape.group(2) for i in instances}

      # EVERY `start_unit(…)`, resolved. One this check cannot resolve is a
      # finding, not a skip: it is a unit nobody can say the rule covers.
      started, calls = set(), 0
      for m in re.finditer(r"(?<!fn )\bstart_unit\(", android):
          calls += 1
          args = parts(shut_at(android, m.end()))
          unit = args[1] if len(args) > 1 else ""
          if re.fullmatch(r"&?init_unit\(\s*\w+\s*\)", unit):
              started |= inits
          elif re.fullmatch(r"[A-Z_]+", unit) and constant(unit):
              started.add(constant(unit))
          else:
              wrong.append(f"`start_unit` is called with `{unit}`, which this check cannot resolve to a unit")
      floor(calls, 3, "calls of `android::start_unit`")

      # AND THE VERB IS `start`: the one door to `systemctl` for a system
      # unit is `start_argv`, and `is-active` asks nobody.
      door = must(body_of(android, "start_unit"), "`android::start_unit`")
      if "start_argv(unit)" not in door:
          wrong.append("`start_unit` no longer goes through `start_argv`")
      verbs = [s for _, _, s in strings_of(must(body_of(android, "start_argv"), "`android::start_argv`"))
               if not s.startswith("-")]
      if verbs != ["start"]:
          wrong.append(f"`start_argv` asks systemctl for {verbs}, and the rule grants `start`")
      for m in re.finditer(r"Call::new\(\s*systemctl\s*,", android):
          argv = shut_at(android, m.end()).strip()
          if not re.match(r"(start_argv|is_active_argv)\(", argv):
              wrong.append(f"systemctl is run with `{argv[:60]}`, past `start_argv`")

      # FILE-WIDE: WHAT THE SYSTEM GRANTS — the merged rules of the whole
      # system are one JavaScript file; each rule is taken out by splitting at
      # `polkit.addRule`, and the one naming our units is the one read.
      text = uncommented(pathlib.Path("rules.js").read_text())
      floor(len(text), 500, "characters of the merged polkit rules")
      ours = [r for r in re.split(r"polkit\.addRule", text)[1:] if "ronoctua-android" in r]
      if len(ours) != 1:
          wrong.append(f"{len(ours)} rules mention ronoctua-android; there may be one")

      def top_of(condition):
          was = None
          while was != condition:
              was = condition
              condition = re.sub(r"\([^()]*\)", " ", condition)
          return condition

      for rule in ours:
          results = set(re.findall(r"polkit\.Result\.(\w+)", rule))
          if results != {"YES"}:
              wrong.append(f"the rule answers {sorted(results)}, and may only answer YES")
          actions = set(re.findall(r"action\.id\s*==\s*\"([^\"]+)\"", rule))
          if actions != {"org.freedesktop.systemd1.manage-units"}:
              wrong.append(f"the rule is about {sorted(actions)}")
          verbs = set(re.findall(r"lookup\(\"verb\"\)\s*==\s*\"([^\"]+)\"", rule))
          if verbs != {"start"}:
              wrong.append(f"the rule allows the verbs {sorted(verbs)}; the crate only ever starts")
          users = set(re.findall(r"subject\.user\s*==\s*\"([^\"]+)\"", rule))
          if users != {user}:
              wrong.append(f"the rule is for {sorted(users)}, and may be for {user}")

          granted = set(re.findall(r"lookup\(\"unit\"\)\s*==\s*\"([^\"]+)\"", rule))
          for extra in sorted(granted - started):
              wrong.append(f"granted and never started by the crate: {extra}")
          for missing in sorted(started - granted):
              wrong.append(f"started by the crate and never granted: {missing}")
          for unit in sorted(granted):
              stem = unit.removesuffix(".service")
              name = stem.split("@", 1)[0] + "@" if "@" in stem else stem
              if name not in declared:
                  wrong.append(f"the rule grants {unit}, and the system declares no such unit")

          body = re.search(r"if\s*\((.*?)\)\s*\{", rule, re.S)
          if not body:
              wrong.append("the rule has no condition at all")
              continue
          condition = body.group(1)
          left = condition
          for known in (
              r"action\.id\s*==\s*\"[^\"]+\"",
              r"action\.lookup\(\"(?:unit|verb)\"\)\s*==\s*\"[^\"]+\"",
              r"subject\.user\s*==\s*\"[^\"]+\"",
          ):
              left = re.sub(known, "", left)
          leftover = re.sub(r"[\s()&|]", "", left)
          if leftover:
              wrong.append(f"the condition tests something else as well: {leftover!r}")
          if "||" in top_of(condition):
              wrong.append("the units are OR-ed without brackets, so every unit after the first "
                           "is granted for any action and any subject")

      if wrong:
          print("ERROR: Android's polkit rule is not narrow.", file=sys.stderr)
          print("", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          print("", file=sys.stderr)
          print("       There is no polkit agent in this session, so the rule answers YES and", file=sys.stderr)
          print("       never asks. What buys that width back is that it names exactly the", file=sys.stderr)
          print("       units ronoctua-software starts, the verb start, and one person.", file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: one rule, start of {len(started)} units the crate starts, for {user}, bracketed")
      END
    '';

  # NIX-FLATPAK LEAVES THE PERSON'S APPS ALONE, on both of its sides.
  #
  # `flatpak.nix` imports nix-flatpak as a NixOS module AND as a Home Manager
  # module, and both default to deciding things a person installed by hand is
  # theirs to take back: `uninstallUnmanaged = true` would uninstall, at the
  # next activation, every Flatpak the software view put in (`uninstallUnused`
  # follows it for runtimes), and an update on activation or on nix-flatpak's
  # own timer would be a second answer to "when does this machine change" —
  # the distro's update sequence is the first (`flatpak-system`,
  # `flatpak-user`). Read from the EVALUATED configuration of both profiles:
  # a value set in a module that never loads is not a value the machine has.
  nix-flatpak-leaves-your-apps-alone =
    let
      side = cfg: services: {
        # nixpkgs has its own `services.flatpak`; only nix-flatpak's carries
        # these options, so their absence means the module did not load.
        imported = cfg ? uninstallUnmanaged;
        uninstallUnmanaged = cfg.uninstallUnmanaged or null;
        uninstallUnused = cfg.uninstallUnused or null;
        onActivation = cfg.update.onActivation or null;
        auto = cfg.update.auto.enable or null;
        timer = services ? flatpak-managed-install-timer;
      };
      facts =
        name:
        let
          c = self.nixosConfigurations.${name}.config;
          home = c.home-manager.users.${c.ronoctua.user};
        in
        {
          inherit name;
          flatpak = c.services.flatpak.enable;
          nixos = side c.services.flatpak c.systemd.services;
          home = side (home.services.flatpak or { }) home.systemd.user.services;
        };
    in
    mkCheck "nix-flatpak-leaves-your-apps-alone" [ pkgs.python3 ] ''
      cat > facts.json <<'JSON'
      ${builtins.toJSON (
        map facts [
          "noctua"
          "minimal"
        ]
      )}
      JSON
      python3 - <<'END'
      import json, sys

      # PARSED: the facts are evaluated options, written as JSON by Nix.
      machines = json.load(open("facts.json"))
      wrong = []
      if len(machines) != 2:
          wrong.append(f"{len(machines)} machines were read, and there are two profiles")
      for m in machines:
          name = m["name"]
          if not m["flatpak"]:
              wrong.append(f"{name}: Flatpak is off, and it is on in both profiles")
              continue
          for where in ("nixos", "home"):
              s = m[where]
              said = f"{name}, the {'NixOS' if where == 'nixos' else 'Home Manager'} module"
              if not s["imported"]:
                  wrong.append(f"{said}: nix-flatpak is not imported")
                  continue
              for option, why in (
                  ("uninstallUnmanaged", "every app the person installed goes at the next activation"),
                  ("uninstallUnused", "runtimes the person's apps use are judged by a list that does not know them"),
                  ("onActivation", "every rebuild updates Flatpaks behind the update sequence's back"),
                  ("auto", "a timer of its own updates Flatpaks behind the update sequence's back"),
              ):
                  if s[option] is not False:
                      wrong.append(f"{said}: `{option}` is {s[option]!r}; {why}")
              if s["timer"]:
                  wrong.append(f"{said}: the unit `flatpak-managed-install-timer` exists")

      if wrong:
          print("ERROR: nix-flatpak would decide about the person's own apps.", file=sys.stderr)
          print("", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: {len(machines)} profiles, both modules, nothing uninstalled and nothing updated from there")
      END
    '';

  # NOTHING SETS `GTK_THEME` — not the system, not a unit, not an override,
  # not our Rust.
  #
  # The variable replaces an app's own theme with whatever it names: the
  # defect the owner remembers, and what old tutorials pair with the dark
  # extension. Measured on 2026-09-26 (`docs/ARCHITECTURE.md`, "o modo
  # escuro"), today's libadwaita shrugs `Adwaita:dark` and `Adwaita-dark`
  # off — which is no reason to set it: any other name still wins over the
  # app. Dark reaches Flatpak apps through the settings portal and dconf.
  #
  # IT MATCHES SETTINGS, NOT THE WORD. The module header, `flatpak.rs`'s docs
  # and a test fixture all say `GTK_THEME` on purpose; what fails is a place
  # that GIVES it a value: an environment the evaluated system writes, a
  # `flatpak override`, a string literal in any crate's product. The one
  # literal allowed is the detector the advanced sheet uses to offer the
  # REMOVAL (`flatpak::forces_gtk_theme`), and `--unset-env=GTK_THEME`.
  flatpak-dark-is-never-forced =
    let
      forced =
        name:
        let
          c = self.nixosConfigurations.${name}.config;
          home = c.home-manager.users.${c.ronoctua.user};
          says = v: lib.hasInfix "GTK_THEME" (toString v);
          units =
            kind: services:
            lib.concatLists (
              lib.mapAttrsToList (
                unit: s:
                lib.optional (
                  (s.environment or { }) ? GTK_THEME || says (s.serviceConfig.Environment or "")
                ) "the ${kind} unit ${unit}"
              ) services
            );
          homeUnits = lib.concatLists (
            lib.mapAttrsToList (
              unit: s: lib.optional (says ((s.Service or { }).Environment or "")) "the Home Manager unit ${unit}"
            ) home.systemd.user.services
          );
          overrides =
            kind: all:
            lib.concatLists (
              lib.mapAttrsToList (
                app: groups: lib.optional ((groups.Environment or { }) ? GTK_THEME) "the ${kind} override of ${app}"
              ) all
            );
        in
        map (w: "${name}: ${w}") (
          lib.optional (c.environment.sessionVariables ? GTK_THEME) "environment.sessionVariables"
          ++ lib.optional (c.environment.variables ? GTK_THEME) "environment.variables"
          ++ lib.optional (c.systemd.globalEnvironment ? GTK_THEME) "systemd.globalEnvironment"
          ++ lib.optional (says c.systemd.user.extraConfig) "systemd.user.extraConfig"
          ++ units "system" c.systemd.services
          ++ units "user" c.systemd.user.services
          ++ overrides "system Flatpak" (c.services.flatpak.overrides or { })
          ++ lib.optional (home.home.sessionVariables ? GTK_THEME) "home.sessionVariables"
          ++ lib.optional (
            home.systemd.user.sessionVariables ? GTK_THEME
          ) "Home Manager's systemd.user.sessionVariables"
          ++ homeUnits
          ++ overrides "personal Flatpak" (home.services.flatpak.overrides or { })
        );
      evaluated = forced "noctua" ++ forced "minimal";
    in
    mkCheck "flatpak-dark-is-never-forced" [ pkgs.python3 ] ''
      cat > evaluated.json <<'JSON'
      ${builtins.toJSON evaluated}
      JSON
      python3 - <<'END'
      import json, pathlib, re, sys
      exec(open("${pyPrelude}").read())
      exec(open("${softwarePy}").read())

      wrong = []

      # PARSED: 1. THE EVALUATED SYSTEMS — Nix already asked every place a
      #    value can be given in both profiles, and wrote the ones that give
      #    one. This half sees a route no source sweep reaches — an upstream
      #    module, a name built by interpolation.
      for place in json.load(open("evaluated.json")):
          wrong.append(f"{place} sets GTK_THEME")

      # FILE-WIDE: 2. EVERY CRATE AND EVERY BUFFER, their product — a value can
      #    be given anywhere, so every string literal is asked.
      roots = [pathlib.Path("${../crates}"), pathlib.Path("${../buffers}")]
      swept = 0
      for root in roots:
          for f in sorted(root.rglob("*.rs")):
              if is_test_file(f):
                  continue
              text = product(f.read_text())
              swept += 1
              for at, end, s in strings_of(text):
                  if "GTK_THEME" not in s:
                      continue
                  if s in ("--unset-env=GTK_THEME", "unset-env=GTK_THEME"):
                      continue
                  # A TEST ON TEXT FINDS THE VALUE; it does not give one. The
                  # detector below is one, and so is the permissions page
                  # tinting the line that forces it.
                  if (re.search(r"\.(?:starts_with|ends_with|contains|strip_prefix)\(\s*$", text[:at])
                          and text[end:].lstrip().startswith(")")):
                      continue
                  wrong.append(f"{f.relative_to(root)}: `{s}` in `{whose(text, at)}` gives GTK_THEME a value")
      floor(swept, 300, "Rust sources swept")

      # AND THE DETECTOR IS STILL THERE, and still only detects: the sheet
      # needs it to offer the removal, and it may never become a writer.
      flatpak = product((pathlib.Path("${../crates/ronoctua-software/src}") / "flatpak.rs").read_text())
      detector = uncommented(must(body_of(flatpak, "forces_gtk_theme"), "`flatpak::forces_gtk_theme`"))
      if not re.fullmatch(r"\s*lines\.iter\(\)\.any\(\|l\|\s*l\.starts_with\(\"env=GTK_THEME=\"\)\)\s*", detector):
          wrong.append("`forces_gtk_theme` does more than answer whether GTK_THEME is forced")

      # 3. OUR NIX, OUR SCRIPTS. `hashless`, so the headers that explain why
      #    it is never set are prose and not a setting.
      nix = pathlib.Path("${../nix}")
      sources = sorted(p for p in nix.rglob("*") if p.suffix in (".nix", ".py", ".sh"))
      sources += [pathlib.Path("${../flake.nix}")]
      for p in sources:
          for n, line in enumerate(hashless(p.read_text()).splitlines(), 1):
              if "GTK_THEME" in line:
                  wrong.append(f"{p.name}:{n}: `{line.strip()}` names GTK_THEME in code")
      floor(len(sources), 80, "Nix, Python and shell sources swept")

      if wrong:
          print("ERROR: something forces GTK_THEME.", file=sys.stderr)
          print("", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          print("", file=sys.stderr)
          print("       GTK_THEME replaces an app's own theme with whatever it names. Dark", file=sys.stderr)
          print("       comes through the settings portal and dconf; a forced value may only", file=sys.stderr)
          print("       ever be removed.", file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: two profiles evaluated, {swept} Rust and {len(sources)} Nix sources, nothing sets GTK_THEME")
      END
    '';

  # A WEB APP IS A WINDOW OF THE PERSON'S CHROME, and nothing else.
  #
  # `--app=<url>` in the person's own profile: no omnibox, no tabs, their
  # logins. The four flags that look like the same thing and are not:
  # `--kiosk` and `--start-fullscreen` are read by the FIRST Chrome of the
  # session and lock every later window of ordinary browsing; `--user-data-dir`
  # is a second browser with none of the person's logins; `--enable-features`
  # REPLACES the wrapper's own (the last one on a command line wins).
  #
  # And what the `.desktop` runs is our CLI at its STABLE path with the slug
  # — never a store path, which dies with the generation that wrote it, and
  # never the address, whose quotes, `%` and `$` a `.desktop` line would
  # read as its own grammar. The address is checked on the way in and on the
  # way out: `javascript:`, `file:` and `data:` would open under `--app=` as
  # readily as a page.
  web-apps-are-never-kiosk = mkCheck "web-apps-are-never-kiosk" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())
    exec(open("${shellPrelude}").read())
    exec(open("${softwarePy}").read())

    src = pathlib.Path("${../crates/ronoctua-software/src}")
    web = product((src / "web.rs").read_text())
    floor(len(web), 5000, "characters of web.rs")
    wrong = []

    # FILE-WIDE: 1. NONE OF THE FOUR, anywhere in the crate's product — a flag
    #    added by any module reaches Chrome all the same. The tests name all
    #    four to say they are absent; `product` leaves them out.
    FLAGS = ("--kiosk", "--start-fullscreen", "--user-data-dir", "--enable-features")
    swept = 0
    for f in sorted(src.rglob("*.rs")):
        text = product(f.read_text())
        swept += 1
        for at, _, s in strings_of(text):
            for flag in FLAGS:
                if flag in s:
                    wrong.append(f"{f.name}: `{s}` in `{whose(text, at)}`")
    floor(swept, 20, "sources of the crate")

    # 2. THE ONE ARGUMENT VECTOR: Chrome, the profile, `--app=` — and the
    #    address made canonical again on its way out, because the `.desktop`
    #    is the person's file and may have been edited by hand.
    argv = must(body_of(web, "argv_for"), "`web::argv_for`")
    made = sorted(s for _, _, s in strings_of(argv))
    if made != ["--app={url}", "--profile-directory={profile}"]:
        wrong.append(f"`argv_for` hands Chrome {made}, and a web app is `--profile-directory` and `--app=`")
    if "canonical_url(url)" not in uncommented(argv):
        wrong.append("`argv_for` no longer checks the address on its way out")
    for door in ("open_argv", "once_argv"):
        if "argv_for(" not in uncommented(must(body_of(web, door), f"`web::{door}`")):
            wrong.append(f"`{door}` builds its own argument vector instead of `argv_for`")

    # 3. THE ADDRESS GUARD is an ALLOW-list on the PARSED address.
    guard = uncommented(must(body_of(web, "canonical_url"), "`web::canonical_url`"))
    m = re.search(
        r"let url = Url::parse\(.*?if\s*!\s*matches!\(\s*url\.scheme\(\)\s*,([^)]*)\)\s*\{\s*"
        r"return\s+Err\(\s*Refusal::UrlScheme\s*\)",
        guard,
        re.S,
    )
    if not m:
        wrong.append("`canonical_url` no longer refuses every scheme of the parsed address but an allowed few")
    else:
        allowed = set(re.findall(r"\"([^\"]*)\"", m.group(1)))
        if allowed != {"http", "https"}:
            wrong.append(f"`canonical_url` lets {sorted(allowed)} through; only http and https may open")

    # 4. THE `.desktop` RUNS OUR CLI BY ITS STABLE PATH, WITH THE SLUG.
    entry = must(body_of(web, "desktop_text"), "`web::desktop_text`")
    lines = []
    for _, _, s in strings_of(entry):
        lines += re.sub(r"\\\n\s*", "", s).split("\\n")
    execs = [l for l in lines if l.startswith("Exec=")]
    if execs != ["Exec={SOFTWARE} web-open {slug}"]:
        wrong.append(f"the .desktop runs {execs}, and it may run `{{SOFTWARE}} web-open {{slug}}`")
    if not re.search(r"\bslug\s*=\s*e\.slug\b", uncommented(entry)):
        wrong.append("the `{slug}` of the Exec line is not the web app's slug")
    software = re.search(r"pub const SOFTWARE: &str = \"([^\"]*)\";", uncommented(web))
    if not software or software.group(1) != "/run/current-system/sw/bin/ronoctua-software":
        wrong.append("`SOFTWARE` is not /run/current-system/sw/bin/ronoctua-software")
    others = [s for _, _, s in strings_of(web) if "/nix/store" in s
              or re.search(r"(?<!Try)Exec=", s) and "{SOFTWARE} web-open {slug}" not in s]
    if others:
        wrong.append(f"web.rs writes another Exec or a store path: {others}")

    # 5. AND `web-open` IS WHERE THE CLI BECOMES CHROME, through `open_argv`.
    cli = uncommented(product((src / "cli.rs").read_text()))
    opener = must(body_of(cli, "web_open"), "`cli::web_open`")
    if "web::open_argv(" not in opener:
        wrong.append("the CLI's `web-open` no longer opens through `web::open_argv`")

    # 6. AND THE KIOSK (`LEADER m b`) IS NOT CHROMIUM'S KIOSK EITHER. It is a
    #    window of the person's Chrome whose bars the COMPOSITOR hides, opened
    #    by `ronoctua-browser`'s one argument vector: the profile, a new window,
    #    and our extension's page. FILE-WIDE over that crate's product, like
    #    part 1; then the vector's own literals, which are exactly these.
    bsrc = pathlib.Path("${../crates/ronoctua-browser/src}")
    bswept = 0
    for f in sorted(bsrc.rglob("*.rs")):
        text = product(f.read_text())
        bswept += 1
        for at, _, s in strings_of(text):
            for flag in FLAGS:
                if flag in s:
                    wrong.append(f"ronoctua-browser/{f.name}: `{s}` in `{whose(text, at)}`")
    floor(bswept, 8, "sources of ronoctua-browser")
    kiosk = must(body_of(product((bsrc / "launch.rs").read_text()), "argv"), "`launch::argv`")
    kiosk_made = sorted(s for _, _, s in strings_of(kiosk))
    kiosk_wanted = sorted([
        "chrome-extension://{}/{PAGE}#n={}&p={}",
        "&u=",
        "--profile-directory={}",
        "--new-window",
    ])
    if kiosk_made != kiosk_wanted:
        wrong.append(f"`launch::argv` hands Chrome {kiosk_made}, and a kiosk is {kiosk_wanted}")

    # 7. AND THE VECTOR THAT RUNS IS THAT ONE. The footer execs it from
    #    `Footer::kiosk_launch`, which splits `launch::argv` into a program and
    #    its arguments — so a word added THERE reaches Chrome as surely as one
    #    added in `launch.rs`, and parts 1 and 6 would not see it. The body
    #    names `launch::argv` and writes no argument of its own: no literal
    #    that starts with `-`. The kiosk's own modules, product-wide, carry
    #    none of the four either.
    launching = must(
        body_of(product(shell_source("surface.rs")), "kiosk_launch"),
        "`Footer::kiosk_launch`",
    )
    if "ronoctua_browser::launch::argv(" not in uncommented(launching):
        wrong.append("`kiosk_launch` no longer runs the vector `launch::argv` makes")
    for _, _, s in strings_of(launching):
        if s.startswith("-") or any(flag in s for flag in FLAGS):
            wrong.append(f"`kiosk_launch` adds `{s}` to the vector Chrome runs")
    kswept = 0
    for name in ("kiosk.rs", "kiosk_view.rs", "adapt.rs"):
        text = product(shell_source(name))
        kswept += 1
        for at, _, s in strings_of(text):
            for flag in FLAGS:
                if flag in s:
                    wrong.append(f"ronoctua-shell/{name}: `{s}` in `{whose(text, at)}`")
    floor(kswept, 3, "kiosk modules of the shell")

    if wrong:
        print("ERROR: a web app or a kiosk could open as something other than a window of the person's Chrome.", file=sys.stderr)
        print("", file=sys.stderr)
        for w in wrong:
            print("       " + w, file=sys.stderr)
        print("", file=sys.stderr)
        print("       Chromium's `--kiosk` and `--start-fullscreen` switches lock the whole Chrome", file=sys.stderr)
        print("       of the session, `--user-data-dir` loses the person's logins,", file=sys.stderr)
        print("       `--enable-features` replaces the wrapper's own. A web app is", file=sys.stderr)
        print("       `--profile-directory` and `--app=`; a kiosk is `--profile-directory`,", file=sys.stderr)
        print("       `--new-window` and our extension's page.", file=sys.stderr)
        raise SystemExit(1)
    print(f"OK: {swept} + {bswept} + {kswept} sources, two argument vectors and the footer runs the kiosk's as made, http and https only, the CLI by its stable path")
    END
  '';

  # THE PERSON'S PROGRAMS STAY IN THE PERSON'S HOME.
  #
  # Invariant 6's exception is exactly as wide as `$HOME`: the user's Nix
  # profile, the `--user` Flatpak installation, `~/Applications`, the web
  # apps' `.desktop` files. What the crate may not do is reach past it — ask
  # for someone else's rights, touch the SYSTEM installation, or write under
  # `/etc`, `/usr` or `/var`. The system's Flatpaks move in exactly one
  # place: the root step `flatpak-system` of the update's table (read from the
  # evaluated machine, `ronoctua.update.sequence`).
  #
  # THE PATHS OUTSIDE THE HOME THE PRODUCT NAMES ARE AN ALLOW-LIST, each with
  # how it is used: `/var/lib/waydroid` is only ever asked whether
  # `waydroid.cfg` exists or read (the image is root's, and the init unit is
  # the only way to it); `/var/lib/flatpak` is only the system catalogue the
  # offline search reads when the person has none; `/etc` is only bound READ-
  # ONLY into a trial's sandbox, whose one writable bind is its own throwaway
  # home.
  software-stays-in-the-home =
    let
      steps = self.nixosConfigurations.vm.config.ronoctua.update.sequence.steps;
    in
    mkCheck "software-stays-in-the-home" [ pkgs.python3 ] ''
      cat > steps.json <<'JSON'
      ${builtins.toJSON steps}
      JSON
      python3 - <<'END'
      import json, pathlib, re, sys
      exec(open("${pyPrelude}").read())
      exec(open("${softwarePy}").read())

      src = pathlib.Path("${../crates/ronoctua-software/src}")
      wrong = []

      # FILE-WIDE: 1. EVERY STRING OF THE PRODUCT — an escalation or a path
      #    anywhere in the crate is the question, whichever module holds it.
      ESCALATES = re.compile(r"(?:^|[/\s])(?:sudo|pkexec|doas|run0)(?:\s|$)")
      WIDER = ("--system", "--installation")
      OUTSIDE = re.compile(r"/(?:etc|usr|var|opt|root|boot|srv|nix/var)(?:/|$)")
      ALLOWED = {
          ("android.rs", "/var/lib/waydroid"): "system",
          ("appstream.rs", "/var/lib/flatpak"): None,
          ("trial.rs", "/etc"): "sandbox_args",
          # THE MACHINE'S REPORTS about the person's declaration (`REPORTS`:
          # what applied, what was skipped and why), which the inv. 6
          # amendment has the software centre show; and the XDG
          # specification's default data folders, where a program's system
          # entry is found. Both READ only — proven below.
          ("lib.rs", "/etc/ronoctua"): None,
          ("lib.rs", "/usr/local/share:/usr/share"): "data_dirs_of",
      }
      seen, swept = set(), 0
      for f in sorted(src.rglob("*.rs")):
          text = product(f.read_text())
          swept += 1
          for at, _, s in strings_of(text):
              where = f"{f.name}: `{s}` in `{whose(text, at)}`"
              if ESCALATES.search(s):
                  wrong.append(where + " asks for another user's rights")
              if any(s == w or s.startswith(w + "=") for w in WIDER):
                  wrong.append(where + " reaches past the person's own installation")
              if OUTSIDE.match(s):
                  key = (f.name, s)
                  if key not in ALLOWED:
                      wrong.append(where + " is a path outside the home")
                  elif ALLOWED[key] and whose(text, at) != ALLOWED[key]:
                      wrong.append(where + f" is allowed only inside `{ALLOWED[key]}`")
                  seen.add(key)
      floor(swept, 20, "sources of the crate")
      for key in sorted(set(ALLOWED) - seen):
          wrong.append(f"{key[0]} no longer names {key[1]}; take it off this check's list")

      # 2. AND EACH ALLOWED PATH IS ONLY READ.
      android = uncommented(product((src / "android.rs").read_text()))
      uses = 0
      for m in re.finditer(r"\bplaces\.waydroid\b", android):
          uses += 1
          after = android[m.end():]
          before = android[: m.start()].rstrip()
          if not (re.match(r"\.join\(\"waydroid\.cfg\"\)\s*\.exists\(\)", after)
                  or before.endswith("read_to_string(")):
              wrong.append("android.rs does more with /var/lib/waydroid than read `waydroid.cfg`: "
                           + (android[m.start() : m.end() + 40].split("\n")[0]))
      floor(uses, 2, "readings of /var/lib/waydroid")
      appstream = uncommented(product((src / "appstream.rs").read_text()))
      roots = [m.start() for m in re.finditer(r"\bSYSTEM_ROOT\b", appstream)]
      floor(len(roots), 2, "mentions of the system catalogue")
      for at in roots:
          line = appstream[appstream.rfind("\n", 0, at) + 1 : appstream.find("\n", at)]
          if not ("pub const SYSTEM_ROOT" in line or "source_under(Path::new(SYSTEM_ROOT))" in line):
              wrong.append(f"appstream.rs uses /var/lib/flatpak past the catalogue it reads: {line.strip()}")
      under = must(body_of(appstream, "source_under"), "`appstream::source_under`")
      if re.search(r"\b(write|create|remove|rename|OpenOptions)\w*\(", under):
          wrong.append("`source_under` writes; it may only name the system catalogue")

      # THE MACHINE'S REPORTS AND THE SYSTEM'S DATA FOLDERS, ONLY READ: every
      # `.reports` and `.data_dirs` of the product, the statement it is in,
      # the uses of a name a `let` binds it to (in that name's scope), and
      # the body of a function of the crate it is handed to — none writes.
      WRITES = re.compile(r"\b(?:write\w*|create_dir\w*|remove_\w+|rename|set_permissions|copy|hard_link|symlink)\s*\(|\bOpenOptions\b|\bFile::create\b")
      def bounds(text, at):
          d, i = 0, at
          while i > 0:
              c = text[i - 1]
              if c in ")]}":
                  d += 1
              elif c in "([{":
                  if d == 0 and c == "{":
                      break
                  d = max(d - 1, 0)
              elif c == ";" and d == 0:
                  break
              i -= 1
          d, j = 0, at
          while j < len(text):
              c = text[j]
              if c in "([{":
                  d += 1
              elif c in ")]}":
                  if d == 0:
                      break
                  d -= 1
              elif c == ";" and d == 0:
                  break
              j += 1
          return i, j
      def rest_of_block(text, at):
          d, j = 0, at
          while j < len(text):
              if text[j] == "{":
                  d += 1
              elif text[j] == "}":
                  if d == 0:
                      break
                  d -= 1
              j += 1
          return text[at:j]
      product_texts = {g.name: uncommented(product(g.read_text())) for g in sorted(src.rglob("*.rs"))}
      def fn_anywhere(name):
          for t in product_texts.values():
              b = body_of(t, name)
              if b:
                  return b
          return ""
      machine_reads = 0
      for name, text in product_texts.items():
          for field in ("reports", "data_dirs"):
              for m in re.finditer(r"\." + field + r"\b", text):
                  machine_reads += 1
                  a, b = bounds(text, m.start())
                  st = text[a:b]
                  looked = [st]
                  bound = re.match(r"\s*let\s+(?:mut\s+)?(\w+)\s*=", st)
                  if bound:
                      after = rest_of_block(text, b)
                      for u in re.finditer(r"\b" + bound.group(1) + r"\b", after):
                          ua, ub = bounds(after, u.start())
                          looked.append(after[ua:ub])
                  for called in re.findall(r"\b([a-z_]\w*)\(\s*&?[\w.]*\." + field + r"\b", st):
                      looked.append(fn_anywhere(called))
                  if any(WRITES.search(x) for x in looked):
                      wrong.append(f"{name}: the machine's `{field}` is written in `{whose(text, m.start())}`")
      floor(machine_reads, 4, "readings of the machine's reports and data folders")

      # THE SANDBOX: every system path bound READ-ONLY, and the one writable
      # bind is the trial's own home.
      trial = product((src / "trial.rs").read_text())
      sandbox = must(body_of(trial, "sandbox_args"), "`trial::sandbox_args`")
      lits = strings_of(sandbox)
      floor(len(lits), 20, "strings of the sandbox's arguments")
      # A bind's SOURCE is the literal written right after it; a variable
      # there (the home, a socket) is read by its own rule below.
      for k, (_, end, option) in enumerate(lits):
          if option not in ("--bind", "--bind-try", "--dev-bind", "--dev-bind-try"):
              continue
          follows = k + 1 < len(lits) and re.fullmatch(r"[\s,]*", sandbox[end : lits[k + 1][0]])
          source = lits[k + 1][2] if follows else None
          if option == "--dev-bind-try" and source != "/dev/dri":
              wrong.append(f"the sandbox binds the device {source or 'named by a variable'}")
          elif option != "--dev-bind-try" and source is not None:
              wrong.append(f"the sandbox binds {source} WRITABLE")
      if uncommented(sandbox).count("\"--bind\"") != 1 or not re.search(
          r"\"--bind\"\.to_owned\(\),\s*home\.clone\(\),\s*home\.clone\(\)", uncommented(sandbox)
      ) or "let home = r.home." not in uncommented(sandbox):
          wrong.append("the sandbox's one writable bind is no longer the trial's own home")

      # 3. FLATPAK: `--user` on every argument vector, and no call around them.
      flatpak = product((src / "flatpak.rs").read_text())
      code = uncommented(flatpak)
      builders = re.findall(r"pub fn (\w+_argv)\b", code)
      floor(len(builders), 10, "flatpak argument builders")
      for b in builders:
          if "--user" not in [s for _, _, s in strings_of(must(body_of(flatpak, b), f"`flatpak::{b}`"))]:
              wrong.append(f"`flatpak::{b}` does not carry --user")
      calls = 0
      for m in re.finditer(r"Call::new\(\s*program\s*,", code):
          calls += 1
          argv = shut_at(code, m.end()).strip()
          if not (re.match(r"\w+_argv\(", argv) or (argv == "args" and whose(code, m.start()) == "transact")):
              wrong.append(f"flatpak is run with `{argv[:60]}`, past the builders")
      for m in re.finditer(r"(?<!fn )\btransact\(", code):
          calls += 1
          args = parts(shut_at(code, m.end()))
          if len(args) < 3 or not re.match(r"\w+_argv\(", args[2]):
              wrong.append(f"a flatpak transaction runs `{args[2] if len(args) > 2 else args}`, past the builders")
      floor(calls, 10, "flatpak calls")
      for f in sorted(src.rglob("*.rs")):
          if f.name == "flatpak.rs":
              continue
          for m in re.finditer(r"\btools\.flatpak\b(?!\.is_(?:some|none)\(\))", uncommented(product(f.read_text()))):
              wrong.append(f"{f.name} reaches flatpak itself; only flatpak.rs runs it, through its builders")

      # PARSED: 4. THE ONE `flatpak update --system` — the update table, as
      #    Nix evaluated it.
      steps = json.load(open("steps.json"))
      floor(len(steps), 15, "update steps")
      system = [s for s in steps if s.get("program") == "flatpak" or s.get("package") == "flatpak"
                or any(a == w or a.startswith(w + "=") for a in s.get("run", []) for w in WIDER)]
      # BY WHAT IT RUNS, and not by its id: the id lives in the update's table
      # alone, and its brain module's check refuses a second list.
      sanctioned = {"root": True, "package": "flatpak", "program": "flatpak",
                    "run": ["update", "--system", "--noninteractive", "-y"]}
      if len(system) != 1 or any(system[0].get(k) != v for k, v in sanctioned.items()):
          wrong.append("the update table moves the system's Flatpaks in "
                       + ", ".join(f"`{s.get('id')}` ({s.get('run')})" for s in system)
                       + "; the one sanctioned step is the root `flatpak-system`: flatpak update --system --noninteractive -y")

      if wrong:
          print("ERROR: the software centre reaches past the person's home.", file=sys.stderr)
          print("", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          print("", file=sys.stderr)
          print("       Invariant 6's exception is the person's own programs, under $HOME: the", file=sys.stderr)
          print("       Nix profile, the --user installation, ~/Applications. The system's", file=sys.stderr)
          print("       Flatpaks move only in the root update step.", file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: {swept} sources, {len(builders)} flatpak builders all --user, one system step")
      END
    '';

  # ONE CRATE RUNS THE SOFTWARE CENTRE'S PROGRAMS.
  #
  # `ronoctua-software` is the only code that runs `flatpak`, `nix profile`,
  # `appimage-run`, `unsquashfs`, `waydroid` and the trials' `bwrap` and
  # `ronoctua-try-*` units — the shape `one-syncthing-boundary` keeps for
  # Syncthing. The shell and the queue reach them through the library's types
  # and the CLI the queue runs; a second caller would be a second place that
  # has to know `--user`, the lanes and the refusals.
  #
  # WHAT IS NOT A CROSSING: the launcher running an installed app's
  # `.desktop` line (`foreign.rs`, `apps.rs`). A Flatpak export's
  # `Exec=flatpak run …` is the app's own line, read from its file — no
  # program name is written in our code for it.
  one-software-boundary = mkCheck "one-software-boundary" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())
    exec(open("${softwarePy}").read())

    crates = pathlib.Path("${../crates}")
    home = crates / "ronoctua-software"
    wrong = []

    # FILE-WIDE: a boundary is broken by a NAME anywhere outside it, so each
    # file is the question; `product` leaves the tests out.
    #
    # `RONOCTUA_NIX` is not on the list: `ronoctua-memory` asks Nix what the
    # store weighs by the same variable, and that is not a program of the
    # software centre. What is, is `nix profile`, and that is looked for by
    # its words.
    PROGRAMS = ("flatpak", "waydroid", "appimage-run", "unsquashfs", "bwrap")
    VARIABLES = ("RONOCTUA_FLATPAK", "RONOCTUA_WAYDROID", "RONOCTUA_APPIMAGE_RUN",
                 "RONOCTUA_UNSQUASHFS", "RONOCTUA_BWRAP")
    PROFILE = ("add", "install", "remove", "upgrade", "rollback", "wipe-history", "list", "history")
    # THE DECLARATION'S SCHEMA NAMES EACH SOURCE BY ITS WORD — `flatpak` is the
    # first half of `flatpak:<app-id>` (`ronoctua_person::declared::Source::word`,
    # the software package): data, which runs nothing. That one table, by its
    # body, is let through; the same word anywhere else in the crate is not.
    schema = crates / "ronoctua-person" / "src" / "declared.rs"
    swept = 0
    for f in sorted(crates.rglob("*.rs")):
        if home in f.parents:
            continue
        text = product(f.read_text())
        lits = strings_of(text)
        swept += 1
        words = range(0)
        if f == schema:
            table = must(body_of(text, "word"), "`declared::Source::word`")
            words = range(text.find(table), text.find(table) + len(table))
        for k, (at, end, s) in enumerate(lits):
            where = f"{f.relative_to(crates)}: `{s}` in `{whose(text, at)}`"
            if s.rsplit("/", 1)[-1] in PROGRAMS and at not in words:
                wrong.append(where + " names a program only ronoctua-software runs")
            if s in VARIABLES:
                wrong.append(where + " reads a tool only ronoctua-software runs")
            if s.startswith("ronoctua-try-") or s == "trial-exec":
                wrong.append(where + " reaches a trial, which is ronoctua-software's")
            if re.search(r"\bnix profile\b", s):
                wrong.append(where + " runs `nix profile`")
            if (s == "profile" and k + 1 < len(lits) and lits[k + 1][2] in PROFILE
                    and re.fullmatch(r"[\s,]*", text[end : lits[k + 1][0]])):
                wrong.append(where + f" runs `nix profile {lits[k + 1][2]}`")
    floor(swept, 300, "sources outside ronoctua-software")

    # AND THE BOUNDARY IS WHERE IT SAYS: the crate reads every one of those
    # tools from its environment in ONE place.
    lib = uncommented(product((home / "src" / "lib.rs").read_text()))
    reader = must(body_of(lib, "from_env"), "`Tools::from_env`")
    for name in VARIABLES:
        if f"\"{name}\"" not in reader:
            wrong.append(f"`Tools::from_env` no longer reads {name}; has the boundary moved?")

    # AND OUR NIX GIVES THOSE TOOLS A VALUE IN ONE TABLE. `hashless`, so a
    # header explaining the table is prose; and a VALUE, so the nested loop
    # naming three of them to leave them out (`removeAttrs`) is not a second
    # table.
    nix = pathlib.Path("${../nix}")
    table = sorted(nix.rglob("*.nix"))
    floor(len(table), 50, "Nix files swept")
    for p in table:
        if p.name == "software-tools.nix":
            continue
        code = hashless(p.read_text())
        for name in VARIABLES:
            if re.search(r"\b" + name + r"\s*=(?!=)|--set(?:-default)?\s+" + name + r"\b", code):
                wrong.append(f"{p.relative_to(nix)} gives {name} a value; the one table is nix/software-tools.nix")

    if wrong:
        print("ERROR: the software centre's programs are run from outside ronoctua-software.", file=sys.stderr)
        print("", file=sys.stderr)
        for w in wrong:
            print("       " + w, file=sys.stderr)
        print("", file=sys.stderr)
        print("       The shell and the queue go through the library and the CLI. A second", file=sys.stderr)
        print("       caller is a second place that has to know --user, the lanes and the", file=sys.stderr)
        print("       refusals.", file=sys.stderr)
        raise SystemExit(1)
    print(f"OK: {swept} sources outside the crate, none of them runs its programs")
    END
  '';

  # WHAT THE SOFTWARE CENTRE STARTS IS THE PERSON'S, AND MAY DIE ALONE.
  #
  # Three argument vectors decide where an install, a trial and Android's
  # session live, and each is a pure function tested as data:
  #
  # * the QUEUE runs the CLI as `systemd-run --user --scope --quiet --collect
  #   --slice=app.slice -p OOMPolicy=kill -- <cli> run --progress`
  #   (`ronoctua-transfers/src/software.rs`). `app.slice` is where the OOM
  #   killer looks first and not the desktop's `session.slice`; `OOMPolicy=kill`
  #   takes the order down and not the queue, whose own policy is `stop`;
  #   `--collect`, or a scope killed for memory stays listed as failed until
  #   the session ends.
  # * a TRIAL is `ronoctua-try-<key>.service`, a transient USER service in
  #   `app.slice`, `--collect`ed, with no new privileges.
  # * Android's session is the same shape, one unit of the person's.
  #
  # And the queue's unit hands it `systemd-run` by path: without it the
  # engine falls back to the bare name, which a unit's `PATH` may not have.
  software-unit-is-narrow =
    let
      env = self.nixosConfigurations.vm.config.systemd.user.services.ronoctua-transfers.environment;
      unit = {
        systemdRunByPath =
          env ? RONOCTUA_SYSTEMD_RUN
          && lib.hasPrefix "${builtins.storeDir}/" env.RONOCTUA_SYSTEMD_RUN
          && lib.hasSuffix "/bin/systemd-run" env.RONOCTUA_SYSTEMD_RUN;
        software = env ? RONOCTUA_SOFTWARE;
      };
    in
    mkCheck "software-unit-is-narrow" [ pkgs.python3 ] ''
      cat > unit.json <<'JSON'
      ${builtins.toJSON unit}
      JSON
      python3 - <<'END'
      import json, pathlib, re, sys
      exec(open("${pyPrelude}").read())
      exec(open("${softwarePy}").read())

      wrong = []

      # 1. THE QUEUE: the whole vector, in order — the program and the CLI as
      #    the two names they are, every flag as the string it is.
      queue = product(pathlib.Path("${../crates/ronoctua-transfers/src}/software.rs").read_text())
      line = must(body_of(queue, "command_line"), "`software::command_line`")
      said = [m.group(1) if m.group(1) is not None else m.group(2)
              for m in re.finditer(r"\"([^\"]*)\"|\b(systemd_run|software)\b", uncommented(line))]
      want = ["systemd_run", "--user", "--scope", "--quiet", "--collect", "--slice=app.slice",
              "-p", "OOMPolicy=kill", "--", "software", "run", "--progress"]
      if said != want:
          wrong.append(f"the queue runs {said}; it has to be {want}")
      if "command_line(&systemd_run(), &software)" not in uncommented(queue):
          wrong.append("the queue no longer spawns the vector `command_line` builds")
      if "\"RONOCTUA_SYSTEMD_RUN\"" not in uncommented(must(body_of(queue, "systemd_run"), "`software::systemd_run`")):
          wrong.append("the queue no longer takes systemd-run from RONOCTUA_SYSTEMD_RUN")

      # PARSED: what the evaluated unit hands the queue.
      unit = json.load(open("unit.json"))
      if not unit["systemdRunByPath"]:
          wrong.append("the queue's unit does not hand it systemd-run by store path")
      if not unit["software"]:
          wrong.append("the queue's unit does not name the CLI (RONOCTUA_SOFTWARE)")

      # 2. A TRIAL.
      src = pathlib.Path("${../crates/ronoctua-software/src}")
      trial = product((src / "trial.rs").read_text())
      launch = must(body_of(trial, "launch_argv"), "`trial::launch_argv`")
      lits = [s for _, _, s in strings_of(launch)]
      floor(len(lits), 8, "strings of a trial's systemd-run")
      for flag in ("--user", "--collect", "--"):
          if flag not in lits:
              wrong.append(f"a trial's systemd-run lost `{flag}`")
      if [s for s in lits if s.startswith("--slice")] != ["--slice=app.slice"]:
          wrong.append(f"a trial is not in app.slice: {[s for s in lits if s.startswith('--slice')]}")
      properties = {lits[k + 1] for k, s in enumerate(lits[:-1]) if s == "-p"}
      if properties != {"NoNewPrivileges=yes", "OOMPolicy=kill", "ExitType=cgroup"}:
          wrong.append(f"a trial's properties are {sorted(properties)}")
      if any(s in ("--system", "--scope") or s.startswith(("--uid", "--gid")) for s in lits):
          wrong.append("a trial is started as something other than the person's own service")
      if not re.search(r"format!\(\s*\"--unit=\{\}\"\s*,\s*unit_of\(key\)\s*\)", uncommented(launch)):
          wrong.append("a trial's unit is not named by `unit_of`")
      named = uncommented(must(body_of(trial, "unit_of"), "`trial::unit_of`"))
      prefix = re.search(r"pub const UNIT_PREFIX: &str = \"([^\"]*)\";", uncommented(trial))
      if "{UNIT_PREFIX}{key}.service" not in named or not prefix or prefix.group(1) != "ronoctua-try-":
          wrong.append("a trial's unit is not `ronoctua-try-<key>.service`")
      runs = re.findall(r"Call::new\(\s*systemd_run\s*,\s*(\w+)\(", uncommented(trial))
      if runs != ["launch_argv"]:
          wrong.append(f"trial.rs runs systemd-run with {runs}, and `launch_argv` is the one")

      # 3. ANDROID'S SESSION: the person's, in app.slice, collected.
      android = product((src / "android.rs").read_text())
      session = [s for _, _, s in strings_of(must(body_of(android, "session_start_argv"), "`android::session_start_argv`"))]
      for flag in ("--user", "--collect", "--slice=app.slice"):
          if flag not in session:
              wrong.append(f"Android's session lost `{flag}`")

      if wrong:
          print("ERROR: what the software centre starts is not narrow.", file=sys.stderr)
          print("", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          print("", file=sys.stderr)
          print("       An order, a trial and Android's session belong in app.slice, as the", file=sys.stderr)
          print("       person's own units, killed alone when memory runs out, and collected.", file=sys.stderr)
          raise SystemExit(1)
      print("OK: the queue's scope, a trial's unit and Android's session, all in app.slice and collected")
      END
    '';

  # THE UNITS THAT LAUNCH AND INSTALL SEE THE SESSION'S `PATH`.
  #
  # NixOS gives every unit five packages on `PATH` unless told otherwise, and
  # some of ours exist to find what the PERSON has: the footer opens a
  # `.desktop` whose `Exec=` is a bare name (everything in the Nix profile,
  # every Flatpak export's `flatpak run`), the queue is the parent of what an
  # install starts, and a brain module's units that run what the person
  # installed (the update's `binary` steps) say so in their manifest
  # (`sessionPath`). Off, and with no `path` of their own, they write no
  # `Environment=PATH` and inherit the user manager's, built from
  # `environment.profiles`.
  #
  # Read from the RENDERED unit as well as the option: a `path = [ … ]`
  # added anywhere writes a `PATH` with `enableDefaultPath` still off. The
  # lifeline is the control — it keeps its own `PATH`, and a probe that
  # cannot see that one is not reading units at all.
  session-units-inherit-the-session-path =
    let
      c = self.nixosConfigurations.vm.config;
      probe = name: {
        inherit name;
        defaultPath = c.systemd.user.services.${name}.enableDefaultPath;
        declaresPath = c.systemd.user.services.${name}.environment ? PATH;
        writesPath = lib.any (
          l: lib.hasPrefix "Environment=\"PATH=" l || lib.hasPrefix "Environment=PATH=" l
        ) (lib.splitString "\n" c.systemd.user.units."${name}.service".text);
      };
      # THE BRAIN MODULES' OWN, read from their manifests and named by none.
      sessionUnits = lib.concatMap (
        m:
        map (u: lib.removeSuffix ".service" u.name) (
          builtins.filter (u: u.sessionPath) (lib.attrValues m.units)
        )
      ) brainModules.every;
      units = map probe (
        [
          "ronoctua-footer"
          "ronoctua-transfers"
        ]
        ++ sessionUnits
      );
      control = probe "ronoctua-lifeline";
    in
    mkCheck "session-units-inherit-the-session-path" [ pkgs.python3 ] ''
      cat > units.json <<'JSON'
      ${builtins.toJSON { inherit units control; }}
      JSON
      python3 - <<'END'
      import json, sys

      # PARSED: the evaluated units, written as JSON by Nix.
      facts = json.load(open("units.json"))
      wrong = []
      # THE TWO OF THE SHELL, AND THE MODULES' — at least one, or the
      # manifests stopped saying which units run in the session.
      if len(facts["units"]) < 3:
          wrong.append(f"{len(facts['units'])} units were read, and there are the shell's two and the modules'")
      for u in facts["units"]:
          if u["defaultPath"]:
              wrong.append(f"{u['name']}: `enableDefaultPath` is on")
          if u["declaresPath"]:
              wrong.append(f"{u['name']}: the unit declares a PATH of its own")
          if u["writesPath"]:
              wrong.append(f"{u['name']}: the rendered unit writes Environment=PATH")
      if not facts["control"]["writesPath"]:
          wrong.append("the lifeline's unit shows no PATH either, so this probe is not reading units")

      if wrong:
          print("ERROR: a unit that launches or installs has a PATH of its own.", file=sys.stderr)
          print("", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          print("", file=sys.stderr)
          print("       A unit's default PATH is five packages. The footer would open nothing", file=sys.stderr)
          print("       from the Nix profile or Flatpak, and every `binary` update step would", file=sys.stderr)
          print("       be skipped as missing.", file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: {len(facts['units'])} units inherit the session's PATH, and the lifeline keeps its own")
      END
    '';

  # WAYDROID'S CONTAINER WAITS FOR ITS IMAGE.
  #
  # Upstream's `waydroid-container.service` starts at boot and FAILS with no
  # image, and a failed unit is a `degraded` system — which is exactly when
  # nix-flatpak's Home Manager activation skips, in silence. So it SKIPS
  # instead, on the file `waydroid init` writes last; and the init unit
  # skips once that file exists, so a second Prepare is not a second
  # gigabyte over the first.
  #
  # THE SAME FILE on three sides: the two units' conditions, and what
  # `android.rs` calls prepared (`Places::system` + `waydroid.cfg`). A module
  # that moved it would leave the screen saying "prepared" over a container
  # that never starts.
  waydroid-waits-for-its-image =
    let
      c = self.nixosConfigurations.vm.config;
      # THE CONDITION LINES ONLY, without the rest of the unit's context — the
      # unit text names Waydroid's store path, and this check has no use for
      # 0.72 GB of it.
      conditions =
        unit:
        map builtins.unsafeDiscardStringContext (
          builtins.filter (lib.hasPrefix "Condition") (lib.splitString "\n" c.systemd.units.${unit}.text)
        );
      facts = {
        android = c.ronoctua.software.android;
        option = c.systemd.services.waydroid-container.unitConfig.ConditionPathExists or null;
        container = conditions "waydroid-container.service";
        init = conditions "ronoctua-android-init@.service";
      };
    in
    mkCheck "waydroid-waits-for-its-image" [ pkgs.python3 ] ''
      cat > facts.json <<'JSON'
      ${builtins.toJSON facts}
      JSON
      python3 - <<'END'
      import json, pathlib, re, sys
      exec(open("${pyPrelude}").read())
      exec(open("${softwarePy}").read())

      wrong = []

      # WHAT THE CRATE CALLS PREPARED: the machine's root, and the file.
      android = uncommented(product(pathlib.Path("${../crates/ronoctua-software/src}/android.rs").read_text()))
      places = must(body_of(android, "system"), "`Places::system`")
      root = re.search(r"waydroid:\s*PathBuf::from\(\"([^\"]+)\"\)", places)
      floor(len(re.findall(r"places\.waydroid\.join\(\"waydroid\.cfg\"\)", android)), 2,
            "places where android.rs asks whether Android is prepared")
      if not root:
          wrong.append("`Places::system` no longer names Waydroid's root")
          raise SystemExit("ERROR: " + wrong[0])
      configured = root.group(1).rstrip("/") + "/waydroid.cfg"

      # PARSED: the evaluated units' condition lines, written by Nix.
      facts = json.load(open("facts.json"))
      if not facts["android"]:
          wrong.append("Android is off on the full profile's VM, so nothing here was read")
      if facts["option"] != configured:
          wrong.append(f"waydroid-container's condition is {facts['option']!r}, and Android is prepared at {configured}")
      if f"ConditionPathExists={configured}" not in facts["container"]:
          wrong.append(f"the rendered waydroid-container.service does not wait for {configured}: {facts['container']}")
      if f"ConditionPathExists=!{configured}" not in facts["init"]:
          wrong.append(f"the init unit does not skip once {configured} exists: {facts['init']}")

      if wrong:
          print("ERROR: Waydroid's container does not wait for its image.", file=sys.stderr)
          print("", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          print("", file=sys.stderr)
          print("       Started with no image it fails, a failed unit is a degraded system, and", file=sys.stderr)
          print("       a degraded system is when nix-flatpak's activation skips in silence.", file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: the container waits for {configured}, and Prepare stops once it is there")
      END
    '';

  # THE NIX SEARCH INDEX IS WHOLE.
  #
  # A short index is a search that says "nothing found" about programs that
  # exist, and nothing on screen tells the two apart. The writer
  # (`nix/scripts/software-index.py`) refuses to write fewer than its FLOOR
  # and stamps a header with its format and its count; the reader
  # (`nix_index.rs`) refuses a header it does not know and looks rows up by a
  # binary search over sorted attributes. This reads the BUILT index against
  # both: the header, the count against the rows, the floor, the order, the
  # columns — and the revision, which has to be the system's own nixpkgs.
  nix-index-is-whole =
    let
      index = self.packages.${system}.software-nix-index;
    in
    mkCheck "nix-index-is-whole" [ pkgs.python3 ] ''
      python3 - <<'END'
      import ast, pathlib, re, sys
      exec(open("${pyPrelude}").read())

      wrong = []

      # PARSED: WHAT THE WRITER PROMISES — the generator is read by Python's
      # own parser — a `#` inside its header string would cut a line for
      # `hashless` — and only its constants and its header are taken.
      tree = ast.parse(pathlib.Path("${../nix/scripts/software-index.py}").read_text())
      consts = {t.id: ast.literal_eval(n.value) for n in ast.walk(tree) if isinstance(n, ast.Assign)
                for t in n.targets if isinstance(t, ast.Name) and t.id in ("FORMAT", "FLOOR")}
      heads = [v.value for n in ast.walk(tree) if isinstance(n, ast.JoinedStr)
               for v in n.values[:1] if isinstance(v, ast.Constant) and str(v.value).startswith("#")]
      if set(consts) != {"FORMAT", "FLOOR"} or len(heads) != 1:
          raise SystemExit("ERROR: the generator's FORMAT, FLOOR or header went away")
      writer = heads[0].split("\t")[0]
      floor(consts["FLOOR"], 1000, "packages the generator's FLOOR demands")

      # FILE-WIDE: AND WHAT THE READER EXPECTS — two constants at the top of
      # `nix_index.rs`, which no function holds.
      reader = uncommented(pathlib.Path("${../crates/ronoctua-software/src}/nix_index.rs").read_text())
      header = re.search(r"pub const HEADER: &str = \"([^\"]*)\";", reader)
      fmt = re.search(r"pub const FORMAT: &str = \"([^\"]*)\";", reader)
      if not header or header.group(1) != writer:
          wrong.append(f"the reader expects {header and header.group(1)!r} and the writer stamps {writer!r}")
      if not fmt or fmt.group(1) != consts["FORMAT"]:
          wrong.append(f"the reader reads format {fmt and fmt.group(1)!r} and the writer writes {consts['FORMAT']!r}")

      # PARSED: THE BUILT INDEX, a TSV, line by line (18 MB).
      count, attrs, bad = 0, [], []
      with open("${index}/index.tsv", encoding="utf-8") as f:
          first = f.readline().rstrip("\n").split("\t")
          for line in f:
              count += 1
              cols = line.rstrip("\n").split("\t")
              if len(cols) != 8 or not cols[0] or set(cols[3]) - set("ubinl"):
                  bad.append(line[:80])
              attrs.append(cols[0])
      if len(first) != 3 or first[0] != writer or first[1] != consts["FORMAT"]:
          wrong.append(f"the index's header is {first}")
      elif first[2] != str(count):
          wrong.append(f"the header says {first[2]} packages and the index has {count} rows")
      if count < consts["FLOOR"]:
          wrong.append(f"{count} packages, under the generator's floor of {consts['FLOOR']}")
      if bad:
          wrong.append(f"{len(bad)} rows are not eight columns with known flags, the first: {bad[0]!r}")
      if any(a >= b for a, b in zip(attrs, attrs[1:])):
          wrong.append("the rows are not in strictly ascending attribute order; a binary search would miss")

      rev = pathlib.Path("${index}/rev").read_text().strip()
      if rev != "${inputs.nixpkgs.rev}":
          wrong.append(f"the index was built from nixpkgs {rev}, and the system installs from ${inputs.nixpkgs.rev}")

      if wrong:
          print("ERROR: the Nix search index is not whole.", file=sys.stderr)
          print("", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          print("", file=sys.stderr)
          print("       A short or unreadable index is a search that answers \"nothing found\"", file=sys.stderr)
          print("       about programs that exist.", file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: {count} packages in order, format {consts['FORMAT']}, from the system's nixpkgs")
      END
    '';

  # THE UPDATE MOVES WHAT THE PERSON HAS, AND ADDS ONLY WHAT IS DECLARED.
  #
  # Invariant 6's exception lets the update keep the person's programs
  # current, and its 2026-10-05 amendment lets it bring in what is DECLARED
  # (through the rebuild and the reconciler); it does not let it install
  # anything a step names. Two halves:
  #
  # * the TABLE: every `ronoctua-software` step, read through the CLI's own
  #   grammar, carries only words the grammar matches by itself (never a
  #   key, slug, path or query), and its verb builds only an order that
  #   moves what is installed or reconciles what is declared; every other
  #   `upgrade-software` step is the sanctioned root `flatpak update
  #   --system`. The CLI's own tables are read, so a source added to one
  #   side and not the other fails here.
  # * the CRATE: each source's dispatch sends `Order::Upgrade` to its
  #   `upgrade` or to a refusal, and each `upgrade` works on what is installed
  #   — the Nix manifest's elements, the Flatpak installation (`flatpak update`
  #   of an id that is not there fails), the AppImages' sidecars, Android's
  #   own record — and calls no installer, except that Android reinstalls, over
  #   the old one, an app its record already holds.
  #
  # WHAT READING SOURCE CANNOT PIN: that `nix profile upgrade` and `flatpak
  # update` themselves add nothing. `flatpak update` may pull in a new runtime
  # an updated app now needs — a dependency of something installed, not a new
  # program; `nix profile upgrade` rebuilds an element from its own flake
  # reference. Those are the tools' semantics, and the tests in the crate
  # exercise them against fixtures.
  software-upgrade-installs-nothing =
    let
      steps = self.nixosConfigurations.vm.config.ronoctua.update.sequence.steps;
    in
    mkCheck "software-upgrade-installs-nothing" [ pkgs.python3 ] ''
      cat > steps.json <<'JSON'
      ${builtins.toJSON steps}
      JSON
      python3 - <<'END'
      import json, pathlib, re, sys
      exec(open("${pyPrelude}").read())
      exec(open("${softwarePy}").read())

      src = pathlib.Path("${../crates/ronoctua-software/src}")
      read = lambda name: uncommented(product((src / name).read_text()))
      wrong = []

      # THE CLI'S TABLES: which sources it upgrades and tidies, as words.
      lib = read("lib.rs")
      words = dict(re.findall(r"Self::(\w+)\s*=>\s*\"([a-z-]+)\"",
                              must(body_of(must(scope(lib, r"impl Source\b"), "`impl Source`"), "word"), "`Source::word`")))
      cli = read("cli.rs")
      def table(name):
          m = re.search(r"pub const " + name + r": \[Source; \d+\] = \[([^\]]*)\]", cli)
          return [words.get(s, "?" + s) for s in re.findall(r"Source::(\w+)", m.group(1))] if m else []
      upgradable = table("UPGRADABLE") + ["android-system"]
      tidied = table("TIDIED")
      floor(len(upgradable), 4, "sources the CLI upgrades")
      floor(len(tidied), 2, "sources the CLI tidies")

      # PARSED: 1. THE TABLE — the update's, as Nix evaluated it, read through
      # the CLI's own grammar (`cli::parse`) and dispatch (`cli::main`).
      #
      # THE AMENDED RULE (inv. 6, 2026-10-05): the update installs what is
      # DECLARED, and nothing else. So (a) no word of a step names a program:
      # every word is one the grammar matches BY ITSELF — a command, a fixed
      # word or flag compared with `==`, a source — and never one it BINDS (a
      # key, a slug, a path, a query: the words that would say what to
      # install); and (b) every order a step's verb builds either moves what is
      # installed (`Upgrade`, `Tidy`) or brings in what is declared
      # (`Reconcile`, which touches only its own ledger — run against fixtures
      # by `reconcile-touches-only-the-ledger`); a verb that builds no order
      # calls no installer. `run`, whose order comes on standard input, is the
      # verb that could carry anything, and (b) refuses it: it builds no order
      # of its own and hands one to `perform`.
      steps = json.load(open("steps.json"))
      moving = [s for s in steps if s["does"] == "upgrade-software"]
      floor(len(moving), 6, "upgrade-software steps")
      INSTALLERS = r"\b(install|install_file|install_argv|install_file_argv|add_argv|installable|remote_add_argv)\("
      SANCTIONED = {"Upgrade": "upgrade-software", "Tidy": "reclaim-space", "Reconcile": "reconcile-declared"}

      parsing = must(body_of(cli, "parse"), "`cli::parse`")
      heads = list(re.finditer(r'\n\s*((?:"[a-z-]+"\s*\|\s*)*"[a-z-]+")\s*=>', parsing))
      floor(len(heads), 8, "commands in the CLI's grammar")
      arm_of = {}
      for i, h in enumerate(heads):
          end = heads[i + 1].start() if i + 1 < len(heads) else len(parsing)
          for word in re.findall(r'"([a-z-]+)"', h.group(1)):
              arm_of[word] = parsing[h.end():end]

      dispatch = must(body_of(cli, "main"), "`cli::main`")
      dispatch = dispatch[dispatch.index("match verb"):]
      starts = list(re.finditer(r"\n\s*Verb::(\w+)\b[^=;]*=>", dispatch))
      floor(len(starts), 8, "arms of the CLI's dispatch")
      does_of = {}
      for i, a in enumerate(starts):
          end = starts[i + 1].start() if i + 1 < len(starts) else len(dispatch)
          does_of[a.group(1)] = does_of.get(a.group(1), "") + dispatch[a.end():end]

      def judged(sid, argv, does):
          # What is wrong with one argument vector of a `ronoctua-software` step.
          if not argv or argv[0] not in arm_of:
              return [f"`{sid}` runs ronoctua-software {argv}, which is no command of its grammar"]
          arm = arm_of[argv[0]]
          closed = set(re.findall(r'==\s*"([^"]+)"', arm))
          # A SOURCE is matched by itself too, and only one of the table the
          # arm names (`UPGRADABLE`, `TIDIED`, or every source).
          for t in re.findall(r"\bone_of\(\s*\w+\s*,\s*&([\w:]+)", arm):
              closed |= set(words.values()) if t == "Source::ALL" else set(table(t))
          out = [f"`{sid}`: `{w}` is a word ronoctua-software {argv[0]} binds — it names something"
                 for w in argv[1:] if w not in closed]
          verbs = sorted(set(re.findall(r"Verb::(\w+)", arm)))
          if len(verbs) != 1:
              return out + [f"`{sid}`: ronoctua-software {argv[0]} builds {verbs or 'no verb this can read'}"]
          verb = verbs[0]
          body = does_of.get(verb)
          if body is None:
              return out + [f"`{sid}`: the dispatch has no arm for `Verb::{verb}`"]
          orders = sorted(set(re.findall(r"\bOrder::(\w+)", body)))
          for o in orders:
              if o not in SANCTIONED:
                  out.append(f"`{sid}`: ronoctua-software {argv[0]} builds `Order::{o}`, which neither moves "
                             "what is installed nor brings in what is declared")
              elif SANCTIONED[o] != does:
                  out.append(f"`{sid}` runs `Order::{o}` as {does}, not {SANCTIONED[o]}")
          if not orders:
              if "perform(" in body:
                  out.append(f"`{sid}`: ronoctua-software {argv[0]} hands `perform` an order that is not "
                             "in the table — whatever arrives on standard input")
              for called in re.findall(r"\b([a-z_]\w*)\(&ctx", body):
                  if called in ("answer",):
                      continue
                  inner = body_of(cli, called) or ""
                  if re.search(INSTALLERS, inner) or re.search(r"\bOrder::", inner):
                      out.append(f"`{sid}`: ronoctua-software {argv[0]} reaches an installer through `{called}`")
              if does == "upgrade-software" and verb != "Upgrade":
                  out.append(f"`{sid}` says it upgrades and runs ronoctua-software {argv[0]}")
          return out

      software_steps = 0
      for s in steps:
          run = s.get("run", [])
          if s.get("program") == "ronoctua-software":
              software_steps += 1
              wrong += judged(s["id"], run, s["does"])
              if s.get("rehearse"):
                  wrong += judged(s["id"] + " (rehearsed)", s["rehearse"], s["does"])
          elif s["does"] == "upgrade-software" and not (
              s.get("program") == "flatpak" and s.get("root") is True
              and run == ["update", "--system", "--noninteractive", "-y"]
          ):
              wrong.append(f"`{s['id']}` upgrades the person's programs with {s.get('program')} {run}")
      floor(software_steps, 9, "ronoctua-software steps in the update")

      # 2. THE CLI's verbs build the orders they say.
      for verb, order in (("Upgrade(Target::Source(source))", "Order::Upgrade"), ("Tidy(source)", "Order::Tidy")):
          arm = must(scope(cli, r"Verb::" + re.escape(verb) + r"\s*=>"), f"the CLI's `{verb}` arm")
          if order not in arm or "Order::Install" in arm:
              wrong.append(f"the CLI's `{verb}` does not run `{order}`")
      if [s for _, _, s in strings_of(must(body_of(cli, "images_argv"), "`cli::images_argv`"))] != ["upgrade"]:
          wrong.append("Android's images are moved by something other than `waydroid upgrade`")

      # 3. EACH SOURCE SENDS AN UPGRADE TO ITS UPGRADE, OR REFUSES IT.
      def target(text, at):
          k = text.find("=>", at) + 2
          while text[k].isspace():
              k += 1
          depth, j = 0, k
          while j < len(text):
              c = text[j]
              if c in "([{":
                  depth += 1
              elif c in ")]}":
                  if depth == 0:
                      break
                  depth -= 1
                  if depth == 0 and text[k] == "{":
                      return text[k : j + 1]
              elif c == "," and depth == 0:
                  break
              j += 1
          return text[k:j]
      arms = 0
      for name, dispatch in (("nix.rs", ("run",)), ("flatpak.rs", ("run",)),
                             ("appimage.rs", ("run_with", "run_offline")), ("android.rs", ("run", "run_in"))):
          text = read(name)
          for fn in dispatch:
              body = must(body_of(text, fn), f"`{name[:-3]}::{fn}`")
              for m in re.finditer(r"\bOrder::Upgrade\b", body):
                  arms += 1
                  goes = target(body, m.end())
                  if "install" in goes or not ("upgrade(" in goes or re.match(r"\{?\s*Err\(", goes)):
                      wrong.append(f"{name}: `{fn}` sends an upgrade to `{' '.join(goes.split())[:70]}`")
      floor(arms, 6, "upgrade arms of the four sources")

      # 4. AND EACH `upgrade` WORKS ON WHAT IS INSTALLED, CALLING NO INSTALLER.
      INSTALLERS = r"\b(install|install_file|install_argv|install_file_argv|add_argv|installable|remote_add_argv)\("
      def fn(name, item):
          return must(body_of(read(name), item), f"`{name[:-3]}::{item}`")

      nix_up = fn("nix.rs", "upgrade")
      if re.search(INSTALLERS, nix_up) or "upgrade_plan(" not in nix_up or "upgrade_argv(" not in nix_up:
          wrong.append("nix.rs: `upgrade` does not move the manifest's elements with `nix profile upgrade`")
      plan = fn("nix.rs", "upgrade_plan")
      if "for e in manifest.elements" not in plan or re.search(r"\.push\((?!e\.name\.clone\(\))", plan):
          wrong.append("nix.rs: `upgrade_plan` names something other than the manifest's elements")
      argv = fn("nix.rs", "upgrade_argv")
      if [s for _, _, s in strings_of(argv)][:2] != ["profile", "upgrade"] or "argv.extend(elements" not in argv:
          wrong.append("nix.rs: `upgrade_argv` is not `nix profile upgrade` of the elements it is given")

      flat_up = fn("flatpak.rs", "upgrade")
      if re.search(INSTALLERS, flat_up) or "update_argv(" not in flat_up:
          wrong.append("flatpak.rs: `upgrade` is not `flatpak update` alone")
      if [s for _, _, s in strings_of(fn("flatpak.rs", "update_argv"))] != ["update", "--user", "-y", "--"]:
          wrong.append("flatpak.rs: `update_argv` is not `flatpak update --user -y [-- <id>]`")

      image_up = fn("appimage.rs", "upgrade")
      if re.search(INSTALLERS, image_up) or "sidecars(&ctx.roots)" not in image_up or "sidecar(&ctx.roots, key)" not in image_up:
          wrong.append("appimage.rs: `upgrade` does not start from the AppImages already integrated")
      one = fn("appimage.rs", "upgrade_one")
      if re.search(INSTALLERS, one) or "key: Some(s.key.clone())" not in one:
          wrong.append("appimage.rs: `upgrade_one` does not replace the AppImage it was given, under its key")

      apps_up = fn("android.rs", "upgrade")
      wanted = re.search(r"let wanted\b(.*?);\s*let due\b(.*?);", apps_up, re.S)
      if ("let kept = record(&ctx.roots)" not in apps_up or not wanted
              or wanted.group(1).count("kept.keys()") < 2 or "catalogue" in wanted.group(1)
              or not re.match(r"[^=]*=\s*wanted\s*\.into_iter\(\)", wanted.group(2))):
          wrong.append("android.rs: `upgrade` does not choose from the apps its record holds")
      loop = must(scope(apps_up, r"for app in &due"), "Android's upgrade loop")
      if apps_up.count("install_app(") != loop.count("install_app("):
          wrong.append("android.rs: `upgrade` installs something outside the apps it chose to move")

      if wrong:
          print("ERROR: the update could install a program the person does not have.", file=sys.stderr)
          print("", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          print("", file=sys.stderr)
          print("       Invariant 6's exception keeps the person's programs current, and its", file=sys.stderr)
          print("       amendment brings in what is DECLARED. Putting in one a step names", file=sys.stderr)
          print("       is the imperative install it refuses.", file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: {software_steps} ronoctua-software steps name nothing, {len(moving)} move what is there, "
            f"{arms} dispatch arms, four upgrades that install nothing new")
      END
    '';

  # THE BRAIN MODULES' OWN CHECKS (brain.md §3), each folder's `checks.nix`,
  # merged into this set. `nix/brain-modules.nix` already refuses a name
  # outside a module's id and key prefixes, and two modules giving one name;
  # what it cannot see is a name this file already has, and that is refused
  # here — the second definition would win in silence.
  brainModuleChecks =
    (brainModules.checksWith {
      inherit
        pkgs
        lib
        self
        system
        rust
        buffers
        mkCheck
        pyPrelude
        texts
        languages
        brainModules
        brainModulesRs
        brainManifestsRs
        ;
    }).checks;
  # The Rust build's own checks (`tests/rust-units.nix`).
  rustUnitChecks = import ./rust-units.nix {
    inherit
      pkgs
      lib
      rust
      mkCheck
      ;
  };
  # The build's granularity and its guards (`tests/build-granularity.nix`).
  granularity = import ./build-granularity.nix {
    inherit
      pkgs
      lib
      self
      rust
      mkCheck
      pyPrelude
      buffers
      themed
      defaultTheme
      texts
      withPersonModules
      ;
  };
  # The third-party units' checks (`tests/third-party-units.nix`).
  thirdPartyChecks = import ./third-party-units.nix {
    inherit
      pkgs
      lib
      rust
      mkCheck
      ;
  };
  # The programs in their places (`tests/build-outputs.nix`).
  outputChecks = import ./build-outputs.nix {
    inherit
      pkgs
      lib
      self
      system
      rust
      mkCheck
      pyPrelude
      ;
  };
  raw =
    let
      clashes = builtins.filter (n: builtins.hasAttr n core) (builtins.attrNames brainModuleChecks);
      buildClashes = builtins.filter (n: builtins.hasAttr n (core // brainModuleChecks)) (
        builtins.attrNames rustUnitChecks
      );
      granularityClashes = builtins.filter (
        n: builtins.hasAttr n (core // brainModuleChecks // rustUnitChecks)
      ) (builtins.attrNames granularity.checks);
      thirdPartyClashes = builtins.filter (
        n: builtins.hasAttr n (core // brainModuleChecks // rustUnitChecks // granularity.checks)
      ) (builtins.attrNames thirdPartyChecks);
      outputClashes = builtins.filter (
        n:
        builtins.hasAttr n (
          core // brainModuleChecks // rustUnitChecks // granularity.checks // thirdPartyChecks
        )
      ) (builtins.attrNames outputChecks);
      all =
        core
        // brainModuleChecks
        // rustUnitChecks
        // granularity.checks
        // thirdPartyChecks
        // outputChecks;
    in
    if clashes != [ ] then
      throw "a brain module declares a check tests/checks.nix already has: ${lib.concatStringsSep ", " clashes}"
    else if buildClashes != [ ] then
      throw "tests/rust-units.nix declares a check tests/checks.nix already has: ${lib.concatStringsSep ", " buildClashes}"
    else if granularityClashes != [ ] then
      throw "tests/build-granularity.nix declares a check the others already have: ${lib.concatStringsSep ", " granularityClashes}"
    else if thirdPartyClashes != [ ] then
      throw "tests/third-party-units.nix declares a check the others already have: ${lib.concatStringsSep ", " thirdPartyClashes}"
    else if outputClashes != [ ] then
      throw "tests/build-outputs.nix declares a check the others already have: ${lib.concatStringsSep ", " outputClashes}"
    else
      all;

  # THE SAMPLE MODULE, read by the same loader as a real one — the fixture
  # every check below proves its half on, on the day no real module exists.
  brainSample = import ../nix/brain-modules.nix {
    inherit lib languages;
    modulesDir = ../crates/ronoctua-brain/tests/modules;
  };

  # THE GENERATOR WRITES WHAT THE GOLDEN SAMPLE SAYS (brain.md §7, S0).
  #
  # `crates/ronoctua-brain/tests/modules/pilot-sample/manifest.rs` was written
  # by hand before the generator existed, as the file it has to produce; the
  # brain's own test compiles it beside the sample's `module.rs`. This runs the
  # real derivation (`nix/brain-modules-rs.nix`, formatter included) on the
  # sample's folder and compares, byte for byte below the header.
  #
  # AND THE LOADER'S REFUSALS, proved at evaluation on folders that exist
  # nowhere (`problemsOf`, `mergeChecks` are pure) — each by its sentence,
  # after the folder they break is accepted — and its gate around a module's
  # NixOS half and what that imports, proved by evaluating the sample's
  # `module.nix` on and off. And the text generator's refusals on the sample's
  # fragment, with the one case it must let through. So a loader that stopped
  # refusing, or a gate that stopped closing, is a red check and not a module
  # that slipped through.
  brain-modules-match-the-golden =
    let
      # BOTH PARTS, on the sample: the library's (the manifest the golden file
      # is, `distro.rs`, `ids.txt`, `shared.txt`) and the daemon's (`all.rs`,
      # which makes the modules, and no distro manifest of its own).
      generated = pkgs.callPackage ../nix/brain-modules-rs.nix {
        brainModules = brainSample;
        inherit rustToolchain languages;
        part = "library";
      };
      registry = pkgs.callPackage ../nix/brain-modules-rs.nix {
        brainModules = brainSample;
        inherit rustToolchain languages;
        part = "daemon";
      };
      complete = {
        id = "made-up";
        files = [
          "manifest.nix"
          "module.rs"
          "module.nix"
          "checks.nix"
          "why.md"
        ];
        i18nFiles = map (l: "${l}.ftl") languages;
        manifest = {
          what = "A made-up module.";
          needs = {
            root = false;
            network = false;
            boundaries = [ ];
          };
          schedule = null;
          uses = [ ];
          namedBy = { };
        };
      };
      # EACH REFUSAL WITH THE WORDS IT OWES, and the folder they all break
      # accepted first: without that control a `complete` that had itself
      # become refused would make every refusal below pass on the wrong
      # sentence.
      refused = what: expect: attrs: {
        inherit what expect;
        said = brainSample.problemsOf (complete // attrs);
      };
      # brain.md §1's own schedule: no calendar, so no interval.
      calendarLess = {
        kind = "routine";
        calendar = false;
        partOfDay = "any";
        countdownSeconds = 0;
        runawayMinutes = 60;
        gated = false;
      };
      refusals = [
        (refused "a folder without its why.md" "why.md is missing" {
          files = lib.remove "why.md" complete.files;
        })
        (refused "a language without its .ftl" "i18n/${lib.last languages}.ftl is missing" {
          i18nFiles = [ "${builtins.head languages}.ftl" ];
        })
        (refused "a manifest that is a function" "manifest.nix is a plain attrset, not a function" {
          manifest = _: complete.manifest;
        })
        (refused "a field the loader does not know" "`schedul` is not a field" {
          manifest = complete.manifest // {
            schedul = null;
          };
        })
        (refused "a mark whose glyph is not declared" "marks.full.glyph names a glyph" {
          manifest = complete.manifest // {
            marks.full = {
              glyph = "full";
              hint = "made-up-mark-full";
            };
          };
        })
        (refused "a calendar without its interval" "schedule.intervalDays is missing" {
          manifest = complete.manifest // {
            schedule = calendarLess // {
              calendar = true;
            };
          };
        })
        (refused "an id that is not an English kebab word" "is not an English kebab word" {
          id = "Made_Up";
        })
      ];
      accepted = {
        complete = brainSample.problemsOf complete;
        calendarLess = brainSample.problemsOf (
          complete
          // {
            manifest = complete.manifest // {
              schedule = calendarLess;
            };
          }
        );
      };
      merge =
        answers: (builtins.tryEval (builtins.deepSeq (brainSample.mergeChecks answers) true)).success;
      answer = id: names: {
        inherit id;
        prefixes = [ id ];
        checks = lib.genAttrs names (_: null);
        slow = [ ];
      };
      # THE GATE, on and off: the sample's `module.nix` writes one file in
      # `/etc` and imports a sibling that writes another, and a module the
      # flake turns off must write neither.
      etcOf =
        modules: on:
        builtins.attrNames
          (lib.evalModules {
            modules = modules ++ [
              {
                options.ronoctua.brain.enable = lib.mkOption { default = true; };
                options.ronoctua.brain.modules.pilot-sample.enable = lib.mkOption { default = true; };
                options.environment.etc = lib.mkOption {
                  type = lib.types.attrsOf lib.types.anything;
                  default = { };
                };
                config.ronoctua.brain.modules.pilot-sample.enable = on;
              }
            ];
          }).config.environment.etc;
      gate = etcOf brainSample.nixosModules;
      # AND THE GATE AROUND WHAT A MODULE IMPORTS, on modules written here:
      # one imported inline is gated with it; a path outside its folder and a
      # `disabledModules` are refused.
      gateOf = brainSample.gate "pilot-sample" brainSample.modules.pilot-sample.dir;
      inlineImport = gateOf {
        imports = [ { environment.etc."ronoctua/inline".text = "inline\n"; } ];
      };
      refusedByGate = m: !(builtins.tryEval (builtins.deepSeq (etcOf [ (gateOf m) ] true) true)).success;
      # THE SAMPLE AS THE GENERATOR RECEIVES IT, for the two runs made here.
      record = pkgs.writeText "sample-record.json" (builtins.toJSON (brainSample.forGenerator (_: { })));
      facts = pkgs.writeText "brain-modules-facts.json" (
        builtins.toJSON {
          ids = brainSample.ids;
          slow = brainSample.slowChecks;
          checks =
            builtins.attrNames
              (brainSample.checksWith (lib.genAttrs brainSample.checkArguments (_: null))).checks;
          refusals = map (r: {
            inherit (r) what expect said;
          }) refusals;
          inherit accepted;
          mergeAcceptsDistinct = merge [
            (answer "made-up" [ "made-up-holds" ])
            (answer "other" [ "other-holds" ])
          ];
          # ONE NAME IN BOTH NAMESPACES, so it is the second declaration that
          # is refused and not a name outside its module's prefixes.
          mergeRefusesTwice =
            !(merge [
              (answer "made-up" [ "made-up-x-holds" ])
              (answer "made-up-x" [ "made-up-x-holds" ])
            ]);
          mergeRefusesOutside = !(merge [ (answer "made-up" [ "somebody-elses" ]) ]);
          gateOpens =
            gate true == [
              "ronoctua/pilot-sample"
              "ronoctua/pilot-sample-imported"
            ];
          gateCloses = gate false == [ ];
          gateInlineOpens = etcOf [ inlineImport ] true == [ "ronoctua/inline" ];
          gateInlineCloses = etcOf [ inlineImport ] false == [ ];
          gateRefusesOutside = refusedByGate {
            imports = [ (builtins.toFile "outside.nix" "{ }") ];
          };
          gateRefusesDisabled = refusedByGate { disabledModules = [ "made-up.nix" ]; };
        }
      );
    in
    mkCheck "brain-modules-match-the-golden" [ pkgs.python3 ] ''
      python3 - <<'END'
      import json, pathlib, subprocess, sys, tempfile
      exec(open("${pyPrelude}").read())

      # PARSED: the loader's answers arrive as JSON written by Nix.
      # FILE-WIDE: the two manifests are compared as whole TEXT below their
      # headers, which is the question — whether the generator writes what
      # the sample says, comments and all.
      wrong = []
      facts = json.load(open("${facts}"))
      if facts["ids"] != ["pilot-sample"]:
          wrong.append(f"the loader read {facts['ids']} out of the sample's folder")
      if facts["slow"] != ["pilot-sample-is-a-sample"] or facts["checks"] != ["pilot-sample-is-a-sample"]:
          wrong.append(f"the sample's checks came out as {facts['checks']}, slow {facts['slow']}")
      for what, said in facts["accepted"].items():
          if said:
              wrong.append(f"the loader refused a good folder ({what}): {said}")
      floor(len(facts["refusals"]), 7, "refusals asked of the loader")
      for r in facts["refusals"]:
          if not any(r["expect"] in s for s in r["said"]):
              wrong.append(f"the loader did not refuse {r['what']} with `{r['expect']}`: it said {r['said']}")
      for fact, what in (
          ("mergeAcceptsDistinct", "two modules with distinct checks were refused"),
          ("mergeRefusesTwice", "two modules declaring one check were merged"),
          ("mergeRefusesOutside", "a check named outside its module's prefixes was merged"),
          ("gateOpens", "the sample's module.nix, or the file it imports, did not apply with its module on"),
          ("gateCloses", "the sample's module.nix, or the file it imports, applied with its module turned off"),
          ("gateInlineOpens", "a module imported inline did not apply with its module on"),
          ("gateInlineCloses", "a module imported inline applied with its module turned off"),
          ("gateRefusesOutside", "a NixOS half importing a file outside its folder was accepted"),
          ("gateRefusesDisabled", "a NixOS half declaring disabledModules was accepted"),
      ):
          if not facts[fact]:
              wrong.append(what)

      # THE GOLDEN FILE, below both headers: a header is the `//` lines (not
      # `///`) and the blank lines before the first item.
      def below_the_header(path):
          lines = pathlib.Path(path).read_text().splitlines(True)
          at = 0
          while at < len(lines) and (not lines[at].strip()
                                     or (lines[at].startswith("//") and not lines[at].startswith("///"))):
              at += 1
          return lines[at:]
      made = below_the_header("${generated}/pilot-sample/manifest.rs")
      golden = below_the_header("${../crates/ronoctua-brain/tests/modules/pilot-sample/manifest.rs}")
      floor(len(golden), 80, "lines of the golden manifest.rs")
      if made != golden:
          import difflib
          wrong.append("the generated manifest.rs is not the golden one:\n"
                       + "".join(difflib.unified_diff(golden, made, "golden", "generated")))
      for part in ("${generated}", "${registry}"):
          if pathlib.Path(part, "ids.txt").read_text() != "pilot-sample pilot_sample distro\n":
              wrong.append(f"{part}/ids.txt is not `pilot-sample pilot_sample distro`")
      if pathlib.Path("${generated}/shared.txt").read_text() != "":
          wrong.append("the sample carries no shared half, and shared.txt lists one")
      # THE DAEMON'S PART COMPILES NO DISTRO MANIFEST: the library's is
      # re-exported, so a second one would be two `MANIFEST`s of one module.
      if pathlib.Path("${registry}/pilot-sample").exists():
          wrong.append("the daemon's part wrote a distro module's manifest; it is the library's")
      registry = uncommented(pathlib.Path("${registry}/all.rs").read_text())
      floor(len(registry), 500, "characters of the generated all.rs")
      # THE TWO ITEMS THE DAEMON'S `src/compiled.rs` PROMISES, with their
      # signatures, and the registry's own test beside them.
      for owed in ("pub const IDS: &[&str] = &[pilot_sample::ID];",
                   "pub fn all(birth: &crate::module::Birth) -> Vec<Box<dyn crate::module::Module>>",
                   "Box::new(pilot_sample::new(birth))",
                   "#[cfg(test)]\nmod the_registry {"):
          if owed not in registry:
              wrong.append(f"all.rs has no `{owed}`")
      # AND THE LIBRARY'S VIEWS DECLARE AND NEVER MAKE: the footer's crate
      # holds no `all`, and so links no module's code — and no list of the
      # modules' actions or events, which the footer reads from the brain's
      # catalogue at run time (the person's included).
      views = uncommented(pathlib.Path("${generated}/distro.rs").read_text())
      floor(len(views), 300, "characters of the generated distro.rs")
      for owed in ("pub const IDS: &[&str] = &[pilot_sample::ID];",
                   "pub static MANIFESTS: &[&crate::module::Manifest]",
                   "pub fn manifest(id: &str) -> Option<&'static crate::module::Manifest>",
                   "#[cfg(test)]\nmod the_registry {"):
          if owed not in views:
              wrong.append(f"distro.rs has no `{owed}`")
      for refused in ("fn all(", "::new(", "crate::module::Module", "crate::module::Birth"):
          if refused in views:
              wrong.append(f"distro.rs says `{refused}`: the library would make modules")
      for refused in ("ACTIONS", "EVENTS"):
          if refused in views:
              wrong.append(f"distro.rs lists `{refused}`: what the footer registers of a module is the catalogue's")

      # AND THE GENERATOR'S OWN REFUSAL AND ITS TABLES, on records made here:
      # a fragment without a key the manifest needs is refused by the key's
      # name, and a table lands beside the manifest with a module including it.
      work = pathlib.Path(tempfile.mkdtemp())
      record = json.loads(pathlib.Path("${record}").read_text())[0]
      kept = [n for n in record["names"] if n != "cmd-pilot-sample-forget"]
      if len(kept) != len(record["names"]) - 1:
          wrong.append("the sample's record does not name `cmd-pilot-sample-forget`: the refusal below asks nothing")
      table = work / "steps.rs"
      table.write_text("pub const STEPS: usize = 3;\n")
      def run(r):
          (work / "records.json").write_text(json.dumps([r]))
          return subprocess.run(
              [sys.executable, "${../nix/scripts/gen-brain-modules.py}", "--part", "library",
               "--modules", str(work / "records.json"),
               "--language", "${builtins.head languages}",
               "--out", str(work / "out")], capture_output=True, text=True)
      r = run(dict(record, names=kept))
      if r.returncode == 0 or "cmd-pilot-sample-forget" not in r.stderr:
          wrong.append("a fragment missing an action's label was not refused by the key's name")
      r = run(dict(record, tables={"steps.rs": str(table)}))
      if r.returncode != 0:
          wrong.append("a record with a table was refused: " + r.stderr)
      else:
          out = work / "out" / "pilot-sample"
          if (out / "steps.rs").read_text() != table.read_text():
              wrong.append("the table was not copied beside the manifest")
          if 'include!("steps.rs")' not in uncommented((out / "manifest.rs").read_text()):
              wrong.append("the manifest does not include its table")

      # AND THE TEXT GENERATOR (`gen-i18n.py`) ON THE SAMPLE'S FRAGMENT, beside
      # a crate's fragment written here: its three refusals, each by its
      # sentence — and the one thing it must NOT refuse, a crate's key inside
      # the module's namespace. Whether a file outside the folder may speak in the module's
      # words is `brain-modules-are-sealed`'s question (step 5, where `namedBy`
      # answers it); refused here, it would stop every build instead.
      LANGS = "${lib.concatStringsSep " " languages}".split()
      def fragment(lines):
          d = pathlib.Path(tempfile.mkdtemp())
          for l in LANGS:
              own = (pathlib.Path("${../crates/ronoctua-brain/tests/modules/pilot-sample/i18n}") / f"{l}.ftl").read_text() if lines is None else ""
              (d / f"{l}.ftl").write_text(own + "\n".join(lines or []) + "\n")
          return d
      sample_texts = fragment(None)
      def run_texts(base, modules):
          d = pathlib.Path(tempfile.mkdtemp())
          (d / "base").mkdir()
          for l in LANGS:
              (d / "base" / f"{l}.ftl").write_text("\n".join(base) + "\n")
          given = []
          for ident, (folder, prefixes) in modules.items():
              given += ["--module", f"{ident}={folder}", "--prefixes", f"{ident}={prefixes}"]
          return subprocess.run(
              [sys.executable, "${../nix/scripts/gen-i18n.py}", str(d / "out"),
               *LANGS, "--fragment", f"base={d / 'base'}", *given], capture_output=True, text=True)
      alone = {"pilot-sample": (sample_texts, "pilot-sample")}
      r = run_texts(["hello = Hello"], alone)
      if r.returncode != 0:
          wrong.append("gen-i18n refused the sample's fragment beside a clean base: " + r.stderr)
      r = run_texts(["hello = Hello", "pilot-sample-page = Page", "cmd-pilot-sample-open = Open",
                 "about-pilot-sample-open = Opens it"], alone)
      if r.returncode != 0:
          wrong.append("gen-i18n refused base keys inside a module's namespace: " + r.stderr)
      for what, base, modules, said in (
          ("a module key that is also a base key", ["hello = Hello", "cmd-pilot-sample-forget = Forget"],
           alone, "is also a key of `base`"),
          ("a module key outside its namespace", ["hello = Hello"],
           dict(alone, **{"made-up": (fragment(["somebody-elses = Stray"]), "made-up")}),
           "is outside its namespace"),
          ("two modules whose prefixes overlap", ["hello = Hello"],
           dict(alone, pilot=(fragment(["pilot-x = X"]), "pilot")), "overlap"),
      ):
          r = run_texts(base, modules)
          if r.returncode == 0 or said not in r.stderr:
              wrong.append(f"gen-i18n did not refuse {what} with `{said}`: {r.stderr!r}")

      if wrong:
          print("ERROR: the brain's module generator is not what its sample says.", file=sys.stderr)
          print("", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: the generator writes the golden sample, the loader refuses"
            f" {len(facts['refusals'])} broken folders and two bad merges, and the gate closes")
      END
    '';

  # NOTHING OUTSIDE A MODULE'S FOLDER NAMES IT (brain.md §4).
  #
  # A module is a folder so that adding one, or taking one away, is a folder:
  # its manifest, its Rust, its NixOS half, its texts, its checks and its
  # paragraph travel together, and the shell, the buffer and the core draw
  # every module the same way without naming any. That holds only as long as
  # nothing outside the folder starts naming it again — the defect the folders
  # exist to end, where a core text carried a module's word and the buffer
  # built a module's keys itself. So, for every module:
  #
  #   1. the folder is complete — its files, one `.ftl` per language, its name
  #      and its line — and carries no `manifest.rs` (that one is generated);
  #   2. every key its manifest names is in its own fragment;
  #   3. its Rust has a `#[test]`;
  #   4. every `ronoctua_*` crate its Rust uses is a declared boundary (or the
  #      core's own), and every declared boundary exists;
  #   5. NO TRACKED FILE OUTSIDE THE FOLDER NAMES IT — its id (quoted,
  #      `modules::<snake>`, and for an id of two words or more also bare, in
  #      snake and in SCREAMING: a one-word id bare is an English word, and
  #      would find every comment that uses it), any name in its namespace
  #      (`<prefix>-…`, and `cmd-`, `notif-`, `echo-`, `about-`, `ask-` before
  #      it — the namespace `gen-i18n.py` gives its keys, so a base key there
  #      is asked about HERE, where `namedBy` can allow it), its keys and their
  #      constants, its glyph tokens, units, event tags and commands — except a
  #      file its `namedBy` lists, with exactly the names listed (`"*"` any); a
  #      listed file or a `uses` path that is gone, and a listed name that no
  #      longer occurs, are refused as stale;
  #   6. the ids the brain COMPILED (`ronoctua-brain modules`) are the loader's;
  #   7. no `src/tasks/` remains in either crate of the brain (the library,
  #      `crates/ronoctua-brain`, and the daemon, `crates/ronoctua-brain-daemon`)
  #      — OFF until the six tasks had moved into folders (brain.md §7, S5),
  #      and proved below;
  #   8. the core's own tests — the library's and the daemon's — use made-up
  #      ids, never a module's.
  #
  # A PERSON'S MODULE (`origin = "person"`, `my-…`) IS SKIPPED: its folder is
  # in the person's home and reaches a machine as a store copy, so none of
  # the eight is the tree's to ask of it — proved by a plant beside the
  # sample, with a distro twin of it refused.
  #
  # WITH NO MODULE YET the real sweep has nothing to ask, and a check that
  # passes on nothing proves nothing — so every step also runs on the sample
  # module, copied into a tree made here: clean it passes, and each plant
  # (a file naming it, a missing file, no test, an undeclared crate, compiled
  # ids that differ, a stale allowance, a core test naming it, a `src/tasks/`)
  # is refused by the step that owns it.
  brain-modules-are-sealed =
    let
      compiled =
        if brainModules.ids == [ ] then
          pkgs.writeText "no-brain-modules" ""
        else
          pkgs.runCommand "brain-modules-compiled" { } ''
            ${rust.brain}/bin/ronoctua-brain modules > $out
          '';
      real = pkgs.writeText "brain-modules.json" brainModules.json;
      sample = pkgs.writeText "brain-sample.json" brainSample.json;
    in
    mkCheck "brain-modules-are-sealed" [ pkgs.python3 ] ''
      python3 - <<'END'
      import json, pathlib, re, shutil, sys, tempfile
      exec(open("${pyPrelude}").read())

      # PARSED: every manifest arrives as JSON written by `nix/brain-modules.nix`;
      # a module's Rust is read through `code_of` and its texts by their key
      # column.
      # FILE-WIDE: step 5's offence is a name written ANYWHERE outside the
      # folder, so there is no item to narrow to — and it reads raw text,
      # because a name in a comment is still the module named where it may not
      # be.
      LANGUAGES = ${builtins.toJSON languages}
      BASE = LANGUAGES[0]
      REQUIRED = ("manifest.nix", "module.rs", "module.nix", "checks.nix", "why.md")
      # The crates every module may use without declaring: the core's own
      # vocabulary — its roots, its protocol and the journal feed it runs.
      CORE = {"ronoctua-xdg", "ronoctua-protocol", "ronoctua-journal"}
      HAYSTACK = {".rs", ".nix", ".py", ".ftl", ".wit", ".toml", ".json", ".sh"}
      # What opens a key of a command, a notification, the minibuffer, a hint
      # and a question — before a module's prefix, still its namespace.
      OPENERS = ("", "cmd-", "notif-", "echo-", "about-", "ask-")
      KEBAB = re.compile(r"(?<![A-Za-z0-9_-])[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?![A-Za-z0-9_-])")
      QUOTED = re.compile(r"[\"']([a-z][a-z0-9-]*)[\"']")
      IDENT = re.compile(r"(?<![A-Za-z0-9_])[A-Za-z_][A-Za-z0-9_]*")
      PATHED = re.compile(r"modules::([a-z][a-z0-9_]*)")

      def keys_of(path):
          return set(re.findall(r"^([a-z][a-z0-9-]*)\s*=", path.read_text(), re.M))

      def owed_keys(m):
          i = m["id"]
          owed = [f"brain-task-{i}", f"brain-task-{i}-does"]
          owed += [f"cmd-{i}-{a}" for a in m["actions"]]
          owed += [a["asks"] for a in m["actions"].values() if a.get("asks")]
          owed += [k["hint"] for k in m["marks"].values()]
          owed += [f"{i}-why-{w}" for w in m["whys"]]
          owed += [f"{i}-says-{n}" for n in m["notices"]]
          for e, spec in m["events"].items():
              if spec.get("notification") is not None:
                  owed += [f"notif-{i}-{e}-summary", f"notif-{i}-{e}-body"]
          return owed

      def haystack(root):
          for f in sorted(root.rglob("*")):
              rel = f.relative_to(root)
              if f.is_file() and f.suffix in HAYSTACK and rel.parts[0] not in ("docs", ".git"):
                  yield rel, f

      def in_namespace(token, i, prefixes):
          # `<opener><prefix>-…`, or `<opener><prefix>` itself behind an
          # opener (`cmd-<id>` is a command); the bare prefix is the id rule's.
          for opener in OPENERS:
              if not token.startswith(opener):
                  continue
              rest = token[len(opener):]
              if any(rest.startswith(p + "-") or (opener and rest == p) for p in prefixes):
                  return True
          return False

      def sealed(root, modules, compiled, tasks_gone, floors):
          problems = []
          # A PERSON'S MODULE IS NOT THE TREE'S: its folder lives in the
          # person's home and reaches a machine as a store copy, so nothing
          # here can be asked of it — and a distro file never names it.
          modules = [m for m in modules if m.get("origin", "distro") == "distro"]
          home = root / "crates" / "ronoctua-brain"
          # THE CORE IS TWO CRATES: the library (what crosses, the manifests)
          # and the daemon (what runs). Steps 7 and 8 ask both.
          cores = [home, root / "crates" / "ronoctua-brain-daemon"]
          folders = {m["id"]: home / "modules" / m["id"] for m in modules}
          texts = {}
          for m in modules:
              i, folder = m["id"], folders[m["id"]]
              say = lambda step, what: problems.append((step, f"{i}: {what}"))
              # 1) THE FOLDER IS COMPLETE.
              for f in REQUIRED:
                  if not (folder / f).is_file():
                      say(1, f"{f} is missing")
              if (folder / "manifest.rs").exists():
                  say(1, "manifest.rs is in the folder; it is generated, never written")
              for language in LANGUAGES:
                  if not (folder / "i18n" / f"{language}.ftl").is_file():
                      say(1, f"i18n/{language}.ftl is missing")
              base = folder / "i18n" / f"{BASE}.ftl"
              texts[i] = keys_of(base) if base.is_file() else set()
              # 2) EVERY KEY THE MANIFEST NAMES IS IN ITS OWN FRAGMENT.
              for k in owed_keys(m):
                  if k not in texts[i]:
                      say(2, f"the key `{k}` is not in its i18n/{BASE}.ftl")
              # 3) ITS RUST HAS A TEST.
              sources = sorted(folder.rglob("*.rs"))
              code = {f: code_of(f.read_text()) for f in sources}
              if not any("#[test]" in c for c in code.values()):
                  say(3, "its Rust has no #[test]")
              # 4) EVERY CRATE IT USES IS A DECLARED BOUNDARY, AND EXISTS.
              used = {"ronoctua-" + u.replace("_", "-")
                      for c in code.values() for u in re.findall(r"\bronoctua_([a-z0-9_]+)\b", c)}
              for u in sorted(used - set(m["needs"]["boundaries"]) - CORE):
                  say(4, f"its Rust uses `{u}`, which needs.boundaries does not declare")
              for b in m["needs"]["boundaries"]:
                  if not (root / "crates" / b / "Cargo.toml").is_file():
                      say(4, f"needs.boundaries names `{b}`, which is not a crate of this tree")

          # 5) NOTHING OUTSIDE THE FOLDER NAMES IT.
          wanted = {}
          for m in modules:
              i = m["id"]
              snake, scream = m["snake"], m["snake"].upper()
              specific = set(texts[i]) | {f"{i}-{g}" for g in m["glyphs"]}
              specific |= {f"{i}-{e}" for e in m["events"]} | {f"{i}-{a}" for a in m["actions"]}
              consts = {k.upper().replace("-", "_"): k for k in texts[i]}
              units = {u["name"] for u in m["units"].values()}
              wanted[i] = (snake, scream, specific, consts, units, m["prefixes"])
          hits = {m["id"]: {} for m in modules}
          swept = {}
          for rel, f in haystack(root):
              inside = [i for i, folder in folders.items() if folder in f.parents]
              text = f.read_text(errors="replace")
              swept[""] = swept.get("", 0) + 1
              swept[f.suffix] = swept.get(f.suffix, 0) + 1
              kebab = set(KEBAB.findall(text))
              quoted = set(QUOTED.findall(text))
              idents = set(IDENT.findall(text))
              pathed = set(PATHED.findall(text))
              for m in modules:
                  i = m["id"]
                  if i in inside:
                      continue
                  snake, scream, specific, consts, units, prefixes = wanted[i]
                  multi = "-" in i
                  found = set()
                  if (multi and i in kebab) or i in quoted or snake in pathed:
                      found.add(i)
                  found |= {t for t in kebab if t in specific or in_namespace(t, i, prefixes)}
                  found |= {consts[w] for w in idents if w in consts}
                  if multi and any(w == snake or w == scream or w.startswith(scream + "_") for w in idents):
                      found.add(i)
                  found |= {u for u in units if u in text}
                  if found:
                      hits[i][str(rel)] = found
          # A FLOOR PER TREE AND PER SUFFIX: a sweep of the real tree that read
          # a wrong root, or lost a suffix, still clears a handful of files.
          for suffix, least in floors.items():
              floor(swept.get(suffix, 0), least,
                    "tracked " + (suffix + " files" if suffix else "files") + " swept for a module's names")
          for m in modules:
              i = m["id"]
              allowed = m["namedBy"]
              for rel, found in sorted(hits[i].items()):
                  allow = allowed.get(rel)
                  if allow is None:
                      problems.append((5, f"{i}: {rel} names it ({', '.join(sorted(found))}) and is not in its namedBy"))
                  elif allow != "*" and found - set(allow):
                      problems.append((5, f"{i}: {rel} names {', '.join(sorted(found - set(allow)))}, beyond what namedBy lists"))
              for rel, allow in sorted(allowed.items()):
                  if not (root / rel).is_file():
                      problems.append((5, f"{i}: namedBy lists {rel}, which does not exist"))
                      continue
                  got = hits[i].get(rel, set())
                  stale = ([] if got else ["anything"]) if allow == "*" else [n for n in allow if n not in got]
                  if stale:
                      problems.append((5, f"{i}: namedBy lets {rel} say {', '.join(stale)}, and it no longer does"))
              for u in m["uses"]:
                  if not (root / u).exists():
                      problems.append((5, f"{i}: uses {u}, which does not exist"))

          # 6) THE IDS IT COMPILED ARE THE LOADER'S.
          if compiled is not None and sorted(compiled) != sorted(m["id"] for m in modules):
              problems.append((6, f"the brain compiled {sorted(compiled)}, and the folders are {sorted(folders)}"))
          # 7) THE SIX TASKS HAVE LEFT `src/tasks/`, in both crates.
          for core in cores:
              if tasks_gone and (core / "src" / "tasks").exists():
                  problems.append((7, f"{core.relative_to(root)}/src/tasks/ still exists"))
          # 8) THE CORE'S TESTS USE MADE-UP IDS, in both crates.
          for f in [f for core in cores if core.is_dir() for f in rust_sources(core)
                    if (core / "src") in f.parents]:
              text = f.read_text()
              cut = re.search(r"#\[cfg\(test\)\]", text)
              if not cut:
                  continue
              tests = set(QUOTED.findall(text[cut.start():]))
              for i in sorted(folders):
                  if i in tests:
                      problems.append((8, f"{f.relative_to(root)}: a core test names the module `{i}`"))
          return problems

      # -- THE REAL TREE ---------------------------------------------------
      modules = json.load(open("${real}"))
      compiled = [l.strip() for l in open("${compiled}").read().splitlines() if l.strip()]
      # STEP 7 IS ON: every task lives in a module folder now (brain.md §7,
      # S5), and a `src/tasks/` coming back is a task outside the contract.
      TASKS_GONE = True
      root = pathlib.Path("${self}")
      # ~1 050 tracked files today (685 `.rs`, 211 `.nix`, 4 `.ftl`): losing
      # the `.rs` or the `.nix` takes the whole under its floor.
      REAL = {"": 900, ".rs": 500, ".nix": 150, ".ftl": 2}
      problems = sealed(root, modules, compiled, TASKS_GONE, REAL)

      # -- THE SAMPLE, in a tree made here --------------------------------
      # Each plant is refused by the step that owns it, or this check has
      # stopped reaching that step.
      sample = json.load(open("${sample}"))
      floor(len(sample), 1, "sample modules read")
      def tree():
          t = pathlib.Path(tempfile.mkdtemp())
          folder = t / "crates/ronoctua-brain/modules/pilot-sample"
          shutil.copytree("${../crates/ronoctua-brain/tests/modules/pilot-sample}", folder)
          # WRITABLE FIRST: the copy keeps the store's read-only modes.
          for p in (folder, *folder.rglob("*")):
              p.chmod(0o755 if p.is_dir() else 0o644)
          (folder / "manifest.rs").unlink()
          (t / "crates/ronoctua-brain/src").mkdir(parents=True)
          (t / "crates/ronoctua-brain/src/lib.rs").write_text(
              "pub fn core() {}\n#[cfg(test)]\nmod tests {\n    const ID: &str = \"made-up\";\n}\n")
          (t / "crates/ronoctua-shell/src").mkdir(parents=True)
          (t / "crates/ronoctua-shell/src/main.rs").write_text("fn main() {}\n")
          (t / "crates/ronoctua-shell/i18n").mkdir(parents=True)
          (t / "crates/ronoctua-shell/i18n/en-GB.ftl").write_text("hello = Hello\n")
          return t, folder
      clean, _ = tree()
      # The tree made here: a handful of files, one of each suffix it plants.
      SAMPLE = {"": 3, ".rs": 2, ".ftl": 1}
      control = sealed(clean, sample, ["pilot-sample"], True, SAMPLE)
      if control:
          problems.append((0, f"the sample, clean, was refused: {control}"))
      # A PERSON'S MODULE BESIDE IT, whose folder is nowhere in the tree:
      # skipped, never asked for its files, its texts or its namedBy.
      person = [dict(m, id="my-" + m["id"], snake="my_" + m["snake"], origin="person") for m in sample]
      skipped = sealed(clean, sample + person, ["pilot-sample"], True, SAMPLE)
      if skipped:
          problems.append((0, f"a person's module was asked what only a folder of the tree owes: {skipped}"))
      # …and only a person's: the same record as the distro's is refused.
      distro_twin = [dict(m, origin="distro") for m in person]
      if not any(s == 1 for s, _ in sealed(clean, sample + distro_twin, ["pilot-sample"], True, SAMPLE)):
          problems.append((0, "a distro module with no folder was skipped as if it were a person's"))
      planted = 0
      def plant(step, what, change, compiled=("pilot-sample",), manifest=None):
          global planted
          planted += 1
          t, folder = tree()
          change(t, folder)
          said = sealed(t, manifest or sample, list(compiled), True, SAMPLE)
          if not any(s == step for s, _ in said):
              problems.append((0, f"step {step} did not refuse {what} (it said {said})"))
      plant(1, "a folder without why.md", lambda t, f: (f / "why.md").unlink())
      plant(2, "a fragment without an action's label", lambda t, f: (f / "i18n" / f"{BASE}.ftl").write_text(
          "\n".join(l for l in (f / "i18n" / f"{BASE}.ftl").read_text().splitlines() if not l.startswith("cmd-")) + "\n"))
      plant(3, "Rust with no test", lambda t, f: (f / "rules.rs").write_text(
          (f / "rules.rs").read_text().replace("#[test]", "")))
      plant(4, "an undeclared crate", lambda t, f: (f / "module.rs").write_text(
          "use ronoctua_audio::chime;\n" + (f / "module.rs").read_text()))
      plant(5, "a shell file naming it", lambda t, f: (t / "crates/ronoctua-shell/src/main.rs").write_text(
          "fn main() { run(\"pilot-sample\"); }\n"))
      plant(5, "a crate's text in its namespace", lambda t, f: (t / "crates/ronoctua-shell/i18n/en-GB.ftl").write_text(
          "hello = Hello\npilot-sample-extra = Extra\n"))
      plant(5, "a crate's hint in its namespace, behind an opener", lambda t, f: (t / "crates/ronoctua-shell/i18n/en-GB.ftl").write_text(
          "hello = Hello\nabout-pilot-sample-extra = Extra\n"))
      plant(5, "a stale namedBy", lambda t, f: None,
            manifest=[dict(sample[0], namedBy={"crates/ronoctua-shell/src/main.rs": ["pilot-sample"]})])
      plant(6, "compiled ids that differ", lambda t, f: None, compiled=())
      plant(7, "a src/tasks/ left behind", lambda t, f: (t / "crates/ronoctua-brain/src/tasks").mkdir())
      plant(8, "a core test naming it", lambda t, f: (t / "crates/ronoctua-brain/src/lib.rs").write_text(
          "#[cfg(test)]\nmod tests {\n    const ID: &str = \"pilot-sample\";\n}\n"))
      # AND IN THE DAEMON'S CRATE, which holds the rest of the core.
      def daemon_file(t, path, text):
          (t / "crates/ronoctua-brain-daemon/src").mkdir(parents=True, exist_ok=True)
          (t / "crates/ronoctua-brain-daemon/src" / path).write_text(text)
      plant(7, "a src/tasks/ left behind in the daemon", lambda t, f: (
          t / "crates/ronoctua-brain-daemon/src/tasks").mkdir(parents=True))
      plant(8, "a daemon test naming it", lambda t, f: daemon_file(
          t, "hub.rs", "#[cfg(test)]\nmod tests {\n    const ID: &str = \"pilot-sample\";\n}\n"))
      # AND AN ALLOWANCE THAT IS USED IS NOT A PROBLEM.
      t, _ = tree()
      (t / "crates/ronoctua-shell/src/main.rs").write_text("fn main() { run(\"pilot-sample\"); }\n")
      allowed = sealed(t, [dict(sample[0], namedBy={"crates/ronoctua-shell/src/main.rs": ["pilot-sample"]})],
                       ["pilot-sample"], True, SAMPLE)
      if allowed:
          problems.append((0, f"a file its namedBy lists, saying what is listed, was refused: {allowed}"))
      # AND A CRATE'S TEXT IN ITS NAMESPACE, ALLOWED: the shell's own page may
      # speak in the module's words when the module says so — the question
      # `gen-i18n.py` leaves to this step.
      t, _ = tree()
      (t / "crates/ronoctua-shell/i18n/en-GB.ftl").write_text("hello = Hello\ncmd-pilot-sample-open = Open\n")
      allowed = sealed(t, [dict(sample[0], namedBy={"crates/ronoctua-shell/i18n/en-GB.ftl": ["cmd-pilot-sample-open"]})],
                       ["pilot-sample"], True, SAMPLE)
      if allowed:
          problems.append((0, f"a crate's text its namedBy allows was refused: {allowed}"))

      if problems:
          print("ERROR: a brain module is not sealed in its folder.", file=sys.stderr)
          print("", file=sys.stderr)
          for step, what in problems:
              print(f"       step {step}: {what}", file=sys.stderr)
          print("", file=sys.stderr)
          print("       A module is its folder: nothing outside names it but the files its", file=sys.stderr)
          print("       `namedBy` lists, with the names listed. See brain.md §4.", file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: {len(modules)} brain modules sealed in their folders"
            + (f" ({', '.join(m['id'] for m in modules)})" if modules else " (none yet)")
            + f"; the sample, clean, passes and {planted} plants are refused")
      END
    '';

  # THE MODULES' RUST IS FORMATTED, and `cargo fmt` never sees it.
  #
  # The crate loads each `module.rs` by a `#[path]` inside an `include!` of a
  # generated file, and `rustfmt` does not expand macros — so `rust-fmt`
  # (`cargo fmt` over the workspace) walks past every module, and past the
  # sample under `tests/modules/`, which is loaded the same way — as are the
  # person's fixtures under `tests/person*/`. `nix fmt`
  # formats them with `rustfmt` on the file itself; this checks the same files
  # the same way, with the edition the manifest would have told it.
  brain-modules-fmt =
    let
      brainCrate = ../crates/ronoctua-brain;
      sources = lib.fileset.toSource {
        root = brainCrate;
        fileset = lib.fileset.unions (
          map (lib.fileset.fileFilter (f: f.hasExt "rs")) (
            lib.optional (builtins.pathExists (brainCrate + "/modules")) (brainCrate + "/modules")
            ++ [
              (brainCrate + "/tests/modules")
              (brainCrate + "/tests/person")
              (brainCrate + "/tests/person-refused")
            ]
          )
        );
      };
    in
    mkCheck "brain-modules-fmt" [ rustToolchain pkgs.findutils ] ''
      failed=0
      seen=0
      while IFS= read -r source; do
        seen=$((seen + 1))
        if ! rustfmt --edition 2024 --check "$source" > /dev/null; then
          echo "ERROR: ''${source#${sources}/} is out of format. Run: nix fmt" >&2
          failed=1
        fi
      done < <(find ${sources} -name '*.rs' | sort)
      [ "$seen" -gt 0 ] || { echo "ERROR: no module source at all, not even the sample's — did the set change?" >&2; exit 1; }
      [ "$failed" = 0 ] || exit 1
      echo "OK: the $seen sources of the brain's modules and its sample are formatted"
    '';

  # THE ICON TABLES ARRIVE AT RUN TIME, AND NOT AT COMPILE TIME.
  #
  # `atlas-is-at-run-time`'s argument on the icons' ~9 MB: in `generated` a
  # store path is a compilation INPUT, and a Nerd Fonts release or a lexicon
  # edit would rebuild every unit that reads it, and every one above, for data
  # no compilation reads. The crate
  # reads the directory from the environment, the wrapper sets it, the nested
  # loop exports it (`bakedExports` is `generated // atRunTime`), the PNG
  # tool's door exports it, and the tests search the real tables with it.
  iconset-is-at-run-time = mkCheck "iconset-is-at-run-time" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: for the Rust half, whether the crate reaches for a table
    # through the COMPILER anywhere in it (`include_str!`, `option_env!`,
    # `env!`), and the needles are string literals, so `uncommented` keeps them.
    # PARSED: the Nix half is narrowed to one attribute block by `block`.
    rust = hashless(pathlib.Path("${../nix/rust.nix}").read_text())
    floor(len(rust), 2000, "characters of nix/rust.nix")
    bad = []

    def block(name, indent="  "):
        m = re.search(r"\n" + indent + name + r" = [^\n]*\{(.*?)\n" + indent + r"\};", rust, re.S)
        return m.group(1) if m else ""

    if "RONOCTUA_ICONSET" not in block("atRunTime"):
        bad.append("RONOCTUA_ICONSET is not in atRunTime; the wrapper would not set it")
    for wrong in ("generated", "buildBase"):
        if "RONOCTUA_ICONSET" in block(wrong):
            bad.append(f"RONOCTUA_ICONSET is a {wrong} input: a new font release would rebuild every unit above the crate")
    # PARSED: the iconset's test run itself, at evaluation — it takes the
    # variable by its crate's `run-env`.
    if "${
      lib.boolToString (rust.test.testRuns.ronoctua-iconset.unit.runEnv ? RONOCTUA_ICONSET)
    }" != "true":
        bad.append("the iconset's test run is not given RONOCTUA_ICONSET: its tests would fail, or be skipped")

    src = pathlib.Path("${../crates/ronoctua-iconset/src}")
    # THE CRATE'S KEY NAMES are not a table: a crate that speaks includes
    # `$RONOCTUA_KEYS_DIR/<crate>.rs` (`src/key.rs`, `nix/text-keys.nix`),
    # written from its fragment's names alone. That file, in exactly that
    # shape, is not asked; anything else in it is, like every other file.
    keys_include = 'include!(concat!(env!("RONOCTUA_KEYS_DIR"),"/",env!("CARGO_PKG_NAME"),".rs"));'
    def asked(f):
        body = uncommented(f.read_text())
        if f.name == "key.rs" and re.sub(r"\s+", "", re.sub(r"#!\[[^\]]*\]", "", body)) == keys_include:
            return ""
        return body
    text = "".join(asked(f) for f in sorted(src.glob("*.rs")))
    floor(len(text), 8000, "characters of ronoctua-iconset")
    for baked in ("include_str!", "include_bytes!", "option_env!", "env!("):
        if baked in text.replace("var_os(", ""):
            bad.append(f"ronoctua-iconset uses {baked}: a table would be baked into the binary")
    if 'VARIABLE: &str = "RONOCTUA_ICONSET"' not in text:
        bad.append("ronoctua-iconset does not name RONOCTUA_ICONSET as its variable")
    shared = must(body_of(text, "shared"), "ronoctua-iconset's `shared`")
    if "var_os(VARIABLE)" not in shared:
        bad.append("`shared` does not read the directory from the environment")
    if "Weak" not in text or "downgrade" not in text:
        bad.append("the set is not held behind a Weak: the ~9 MB would outlive the last view")

    # AND IT IS ONE DIRECTORY WITH THE THREE TABLES.
    iconset = pathlib.Path("${self.packages.${system}.iconset}")
    for f in ("glyphs.json", "lucide.json", "unicode.json"):
        if not (iconset / f).is_file():
            bad.append(f"the iconset directory has no {f}")

    # AND WHERE THE SHELL RUNS UNWRAPPED, IT IS EXPORTED.
    dev = hashless(pathlib.Path("${../nix/dev.nix}").read_text())
    if not re.search(r"generated\s*//\s*atRunTime", dev):
        bad.append("nix/dev.nix no longer exports atRunTime: the nested loop would have no icons")
    flake = hashless(pathlib.Path("${../flake.nix}").read_text())
    door = re.search(r'--door"[^\n]*\n(.*?)exec [^\n]*photograph', flake, re.S)
    if not door or "RONOCTUA_ICONSET" not in door.group(1):
        bad.append("the PNG tool's --door branch does not export RONOCTUA_ICONSET")

    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        sys.exit(1)
    print("OK: the icon tables arrive at run time, everywhere the shell runs")
    END
  '';

  # ONE ICON SEARCH, and it is `ronoctua_iconset::search`.
  #
  # There were three — one per buffer — and they had drifted: a substring in
  # one, a word prefix in another, an identity rule that put the letter `a`
  # first for an arrow in the third. One ladder of ranks (`Rank`), one word
  # rule (`word_prefix`), for the three collections.
  one-icon-search = mkCheck "one-icon-search" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # PARSED: the crate's search is read by its body; FILE-WIDE: the rest of
    # the tree is swept for a second copy by the names every copy used.
    root = pathlib.Path("${self}")
    lib = code_of((root / "crates/ronoctua-iconset/src/lib.rs").read_text())
    lib = without_tests(lib)
    floor(len(lib), 8000, "characters of ronoctua-iconset")
    bad = []
    if len(re.findall(r"\bpub fn search\b", lib)) != 1:
        bad.append("ronoctua-iconset does not have exactly one `pub fn search`")
    search = must(body_of(lib, "search"), "`search`")
    for c in ("Collection::NerdFonts", "Collection::Lucide", "Collection::Unicode"):
        if c not in search:
            bad.append(f"`search` does not answer for {c}")
    if len(re.findall(r"\bfn rank\b", lib)) != 1 or ".rank(" not in search:
        bad.append("the three collections are not ranked by the one `Terms::rank`")
    if len(re.findall(r"\bfn word\b", lib)) != 1 or ".word(" not in search:
        bad.append("a typed word is not looked up by the one `Index::word`")
    if len(re.findall(r"\bfn words_of\b", lib)) != 1:
        bad.append("the word boundary of the indexed text is not one `words_of`")

    # THE COPIES THIS REPLACES, until the icons app removes them. Each entry
    # must still exist: a grandfathered file that is gone is a line to delete.
    # EMPTY since the icons app replaced the three buffers: the list stays, so
    # a copy that ever has to be tolerated again is named, never silently let
    # through.
    GRANDFATHERED = set()
    for g in sorted(GRANDFATHERED):
        if not (root / g).exists():
            bad.append(f"{g} is gone: take it out of this check's grandfathered list")
    COPY = re.compile(r"\bfn (word_prefix|match_score|word_score)\b")
    swept = 0
    for base in ("crates", "buffers"):
        for f in sorted((root / base).rglob("*.rs")):
            rel = str(f.relative_to(root))
            if "target" in f.parts or rel.startswith("crates/ronoctua-iconset/"):
                continue
            swept += 1
            text = code_of(f.read_text(errors="replace"))
            m = COPY.search(text)
            if m and rel not in GRANDFATHERED:
                bad.append(f"{rel} defines `{m.group(1)}`: a second icon search")
            raw = uncommented(f.read_text(errors="replace"))
            for table in ('"glyphs.json"', '"lucide.json"', '"unicode.json"'):
                if table in raw:
                    bad.append(f"{rel} reads {table} itself instead of asking ronoctua-iconset")
    floor(swept, 300, "Rust files swept")

    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        sys.exit(1)
    print(f"OK: one icon search, and {swept} files carry no second one")
    END
  '';

  # EVERY UNIT HAS WORDS IN EVERY LANGUAGE, AND CONVERTS AS DEFINED.
  #
  # The generator refuses a unit without words and a word or symbol with two
  # meanings (its negative fixture proves each); this closes what it cannot
  # see: the NAME a door writes (`unit-<id>`, a numeric selector) in every
  # `.ftl`, no orphan `unit-` key, the factors in the Rust table equal to the
  # declared decimals, and every DEFINITION of `known` (`1 mile` is `1.609344
  # km`, `0 °C` is `32 °F`, `180°` is `π rad`) computed through the factors by
  # the engine's three rules — offset, reciprocal, power of π — with rationals.
  # A round trip alone could not fail: a wrong factor cancels on the way back.
  # The engine's own `convert` is held to the same list by the Rust test
  # `conversions_agree_with_definitions`, which this check pins.
  units-are-total = mkCheck "units-are-total" [ pkgs.python3 ] ''
