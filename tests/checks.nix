  py = pkgs.python3.withPackages (ps: [
    ps.fonttools
    ps.brotli
  ]);

  # THE KEYBOARD'S HALF OF THE BUILT SYSTEM, for `keyd-rules-carry-the-leader`.
  #
  # Out of the EVALUATED configuration and not out of the module's source: what
  # a machine boots with is the file and the rules, not the expression that
  # made them. The three lines are `d` (the directory, and whose it is), `C`
  # (the seed, whose sixth field is the store path it copies from) and `L+`
  # (the symlink `/etc/keyd` becomes).
  keyboardTmpfiles = builtins.filter (
    rule: builtins.match ".*keyd.*" rule != null
  ) self.nixosConfigurations.vm.config.systemd.tmpfiles.rules;
  tmpfilesOfTheKeyboard = pkgs.writeText "keyd-tmpfiles" (
    builtins.concatStringsSep "\n" keyboardTmpfiles
  );
  seedOfTheKeyboard = builtins.elemAt (lib.splitString " " (
    lib.findFirst (r: lib.hasPrefix "C " r) "" keyboardTmpfiles
  )) 6;
  user = self.nixosConfigurations.vm.config.ronoctua.user;

  # THE FOUR THINGS A CHECK THAT READS SOURCE MUST DO, in one place.
  #
  # # Why this exists
  #
  # Because a check that greps Rust passes for the wrong reason with alarming
  # ease, and three of them did. The audit that found it named four shapes:
  #
  # * **the wrong anchor** — a bare `find` landed on an occurrence in a
  #   DIFFERENT function, so the captured window began in the wrong place, ran
  #   past the arm the check was about, and found what it was looking for in
  #   the neighbour. Sabotaging the real code changed nothing.
  # * **the non-greedy brace** — a body captured up to a guessed closing brace
  #   stops at the DESTRUCTURING's brace as soon as a record has several
  #   fields, so the body is empty and every `not in body` silently passes.
  # * **the comment that satisfies the assertion** — searching un-stripped text
  #   lets a doc comment stand in for the code it describes.
  # * **the vacuous loop** — a `finditer` that matches nothing iterates zero
  #   times, and zero iterations is a green check.
  #
  # The repository already had the cure, written out six times by hand. This is
  # it once: narrow by BRACES from `fn NAME`, strip what is not code, and refuse
  # to proceed on a capture that is suspiciously small.
  #
  # `checks-do-not-pass-by-coincidence` is what makes a new check use it.
  #
  # A FILE and not a string spliced into each script: a Nix `''` string carries
  # no indentation of its own, so interpolating it into an indented Python
  # heredoc would put the first line at four spaces and the rest at zero. The
  # store path is read at run time instead — every check that needs it opens
  # with `exec(open("${pyPrelude}").read())`.
  pyPrelude = pkgs.writeText "ronoctua-check-prelude.py" ''
    import re as _re
    import sys as _sys

    def code_of(text):
        # The text with comments and every literal emptied.
        #
        # LIFTED FROM `every-window-knows-its-scale`, which had the best of the
        # six hand-written copies, and it is better for three reasons the
        # simpler ones get wrong: a raw string `r#"…"#` has no escapes and ends
        # only at the matching hash count; a lifetime `'a` is not a character
        # literal, and skipping to the next quote from one eats the code
        # between two lifetimes; and a character literal is emitted as `_`
        # rather than as an empty pair of single quotes, because this file is a
        # Nix indented string and such a pair closes the fence — inside a
        # comment as readily as in code.
        out, i, n = [], 0, len(text)
        while i < n:
            c = text[i]
            if c == "r":
                j = i + 1
                while j < n and text[j] == "#":
                    j += 1
                if j < n and text[j] == '"' and (j > i + 1 or not text[i - 1 : i].isalnum()):
                    close = '"' + "#" * (j - i - 1)
                    end = text.find(close, j + 1)
                    i = n if end == -1 else end + len(close)
                    out.append('""')
                    continue
            if c == '"':
                i += 1
                while i < n:
                    if text[i] == "\\":
                        i += 2
                        continue
                    if text[i] == '"':
                        i += 1
                        break
                    i += 1
                out.append('""')
                continue
            if c == "'":
                m = _re.match(r"'(?:\\.|[^\\'])'", text[i:])
                if m:
                    i += m.end()
                    out.append("_")
                    continue
            if c == "/" and text[i : i + 2] == "//":
                while i < n and text[i] != "\n":
                    i += 1
                continue
            if c == "/" and text[i : i + 2] == "/*":
                end = text.find("*/", i + 2)
                i = n if end < 0 else end + 2
                continue
            out.append(c)
            i += 1
        return "".join(out)

    def hashless(text):
        # The same, for a language whose comments begin with `#` — Nix,
        # shell, Python, `.ftl`. `code_of` is Rust-shaped and would leave every one of
        # those comments standing, which is how a check comes to be satisfied
        # by the sentence above the code instead of the code.
        return "\n".join(l.split("#", 1)[0] for l in text.splitlines())

    def uncommented(text):
        # The comments off and the STRINGS KEPT.
        #
        # `code_of` empties both, and for most questions that is right: a
        # sentence in a comment answering for the code is the defect this
        # family exists to refuse, and so is a message literal answering for
        # the branch that would print it. But some assertions ARE about a
        # string — `include!(concat!(env!("OUT_DIR"), "/names.rs"))` is the
        # line that wires a generated table into a crate, and the path in it is
        # the half that says WHICH table. Emptied, the assertion would go on
        # passing over an include of the wrong file.
        #
        # So this is the narrower tool, and it is narrower on purpose: it is
        # for a needle that is itself a string literal. A check reaching for it
        # to search for PROSE has picked the wrong one — prose in a string is
        # exactly what `code_of` is there to take away.
        out, i, n = [], 0, len(text)
        while i < n:
            if text[i] == '"':
                out.append('"')
                i += 1
                while i < n:
                    if text[i] == "\\":
                        out.append(text[i : i + 2])
                        i += 2
                        continue
                    out.append(text[i])
                    if text[i] == '"':
                        i += 1
                        break
                    i += 1
                continue
            if text[i : i + 2] == "//":
                while i < n and text[i] != "\n":
                    i += 1
                continue
            if text[i : i + 2] == "/*":
                end = text.find("*/", i + 2)
                i = n if end < 0 else end + 2
                continue
            out.append(text[i])
            i += 1
        return "".join(out)

    def body_of(text, name, kind="fn"):
        # The body of one item, from its name to the brace that closes it.
        #
        # By BRACES and never by a terminator someone guessed: the guess is
        # what stops at the destructuring's own brace, or runs into the next
        # function and reads whatever is there. `name` is matched as a WORD, so
        # a longer name beginning with it is not mistaken for it, and the
        # signature is not spelled out — a parameter being added is not a
        # defect, and reporting one as "the function went away" is a wrong
        # diagnosis this check family has already given once.
        m = _re.search(r"\b" + kind + r"\s+" + _re.escape(name) + r"\b", text)
        if not m:
            return None
        start = text.find("{", m.end())
        if start < 0:
            return None
        depth = 0
        for k in range(start, len(text)):
            if text[k] == "{":
                depth += 1
            elif text[k] == "}":
                depth -= 1
                if depth == 0:
                    return text[start + 1 : k]
        return None

    def scope(text, header):
        # The braced block whose HEADER matches this pattern.
        #
        # Because a name is only unique inside something. `fn at` occurs twice
        # in `screen.rs` — `Run::at`, the builder, and `Pen::at`, the bounds
        # check — and `body_of` on the bare file finds the first. That is the
        # wrong-anchor defect, and it caught this check's own author a second
        # time. Narrow to the `impl` first, then ask for the name.
        m = _re.search(header, text)
        if not m:
            return None
        start = text.find("{", m.end())
        if start < 0:
            return None
        depth = 0
        for k in range(start, len(text)):
            if text[k] == "{":
                depth += 1
            elif text[k] == "}":
                depth -= 1
                if depth == 0:
                    return text[start + 1 : k]
        return None

    def shut_at(text, opened):
        # A call's arguments: from just after its `(` to the matching `)`.
        #
        # By PARENTHESES and never by a closing string. A call ends `) {` or
        # `)?` or `),` as readily as `);`, and a scan that guesses one of those
        # either stops in the middle of the arguments or runs into the next
        # call and reads whatever is there. A fixed number of characters is the
        # same mistake with a different face: the window moves whenever
        # anything inside it does.
        deep, at = 0, opened
        while at < len(text):
            if text[at] == "(":
                deep += 1
            elif text[at] == ")":
                if deep == 0:
                    return text[opened:at]
                deep -= 1
            at += 1
        return text[opened:]

    def without_tests(text):
        # The file with its `#[cfg(test)]` MODULE cut off.
        #
        # Because a test USES what it is testing: the keyboard buffer's own
        # tests send `Input::Click`, so a check asking whether the buffer
        # answers one found the arm in the test after it had been deleted from
        # the product. It is the vacuous pass with a new face — the needle was
        # there, and not in the code that runs on somebody's screen.
        #
        # BY THE MODULE AND NOT BY THE ATTRIBUTE, and that is a correction. It
        # cut at the first `#[cfg(test)]` of any kind, and six views carry a
        # `#[cfg(test)] const DECIDING_WIDTH` near the top — so the whole file
        # after it was thrown away, and a check reading one of them went
        # looking in nothing. What saves such a check is its `floor`; what
        # stops it needing one is this.
        m = _re.search(r"#\[cfg\(test\)\]\s*(?:pub\s+)?mod\b", text)
        return text if m is None else text[: m.start()]

    def _masked(text):
        # The text with every comment and literal blanked IN PLACE: each of
        # their characters a space, the newlines kept. The same length as the
        # text, so an offset found in it is an offset of the text — what
        # `code_of` cannot give, since it shortens what it empties. Rust's
        # block comments nest, and a character literal may be a brace.
        out, i, n = list(text), 0, len(text)

        def blank(a, b):
            for k in range(a, b):
                if out[k] != "\n":
                    out[k] = " "

        while i < n:
            c = text[i]
            if c == "r" or (c == "b" and text[i + 1 : i + 2] == "r"):
                j = i + (2 if c == "b" else 1)
                h = j
                while h < n and text[h] == "#":
                    h += 1
                if h < n and text[h] == '"' and not text[i - 1 : i].isalnum() and text[i - 1 : i] != "_":
                    close = '"' + "#" * (h - j)
                    end = text.find(close, h + 1)
                    end = n if end == -1 else end + len(close)
                    blank(i, end)
                    i = end
                    continue
            if c == '"':
                j = i + 1
                while j < n:
                    if text[j] == "\\":
                        j += 2
                        continue
                    if text[j] == '"':
                        j += 1
                        break
                    j += 1
                blank(i, j)
                i = j
                continue
            if c == "'":
                m = _re.match(r"'(?:\\u\{[0-9a-fA-F_]*\}|\\.|[^\\'\n])'", text[i:])
                if m:
                    blank(i, i + m.end())
                    i += m.end()
                    continue
            if text[i : i + 2] == "//":
                j = text.find("\n", i)
                j = n if j == -1 else j
                blank(i, j)
                i = j
                continue
            if text[i : i + 2] == "/*":
                depth, j = 1, i + 2
                while j < n and depth:
                    if text[j : j + 2] == "/*":
                        depth, j = depth + 1, j + 2
                    elif text[j : j + 2] == "*/":
                        depth, j = depth - 1, j + 2
                    else:
                        j += 1
                blank(i, j)
                i = j
                continue
            i += 1
        return "".join(out)

    def outside_tests(text):
        # The file with EACH `#[cfg(test)]` module blanked and the code after
        # it kept, every line where it was — so a line a check prints is the
        # file's own.
        #
        # `without_tests` cuts from the first test module to the END, which is
        # right for a check asking whether the product HAS something (a test's
        # use of it must not answer for it) and wrong for one asking whether
        # ANY line of the product breaks a rule: a file whose product resumes
        # after a mid-file `mod meter_tests` keeps everything below it out of
        # the sweep, and a breach there passes. This blanks each module by its
        # braces, counted in the code alone (`_masked`); a module declared out
        # of line (`#[cfg(test)] mod tests;`) is a declaration, and stays.
        out, at = [], 0
        for start, end in _test_spans(text):
            out.append(text[at:start])
            out.append("\n" * text.count("\n", start, end))
            at = end
        out.append(text[at:])
        return "".join(out)

    def _test_spans(text):
        # Where each `#[cfg(test)]` module of the text starts and ends, by its
        # braces counted in the code alone (`_masked`).
        masked = _masked(text)
        opened = _re.compile(r"#\[cfg\(test\)\]\s*(?:#\[[^\]]*\]\s*)*(?:pub(?:\([^)]*\))?\s+)?mod\s+\w+\s*\{")
        spans, at = [], 0
        while True:
            m = opened.search(masked, at)
            if m is None:
                break
            depth, end = 0, len(masked)
            for k in range(m.end() - 1, len(masked)):
                if masked[k] == "{":
                    depth += 1
                elif masked[k] == "}":
                    depth -= 1
                    if depth == 0:
                        end = k + 1
                        break
            spans.append((m.start(), end))
            at = end
        return spans

    def test_modules(text):
        # The text's `#[cfg(test)]` modules, one after another.
        return "".join(text[s:e] + "\n" for s, e in _test_spans(text))

    def whose(text, at):
        # Which function a hit at `at` is inside — the `walls` idiom.
        walls = [(m.start(), m.group(1)) for m in _re.finditer(r"\n\s*(?:pub )?fn (\w+)", text)]
        return next((name for start, name in reversed(walls) if start < at), "nothing")

    def floor(many, least, what):
        # Refuse a sweep that found suspiciously little. The antidote to the
        # vacuous pass: a capture that came back empty, or a loop that never
        # turned, is NOISE and not an answer.
        if many < least:
            print("ERROR: only " + str(many) + " " + what
                  + "; this check has stopped reaching them.", file=_sys.stderr)
            raise SystemExit(1)
        return many

    def must(body, what):
        # `body_of`'s answer, or a refusal that says which item went missing.
        if body is None or len(body.strip()) < 2:
            print("ERROR: " + what + " went away, or came back empty.", file=_sys.stderr)
            raise SystemExit(1)
        return body

    def rust_sources(crate_dir):
        # EVERY `.rs` A CRATE COMPILES, however deep: `src/**`, and
        # `modules/**` — the brain's module folders, which the crate loads by
        # a `#[path]` inside an `include!` of a generated file, so no `mod`
        # line under `src/` names them and no glob of `src/` reaches them.
        #
        # A sweep that globbed `src/*.rs` walked past every file one directory
        # down (`door/`, `software/`, `tasks/`) as well, and a rule no sweep
        # reaches holds by luck. Sorted; a name for a message is the caller's
        # `relative_to` — a bare file name is no longer unique.
        import pathlib as _pathlib
        root = _pathlib.Path(crate_dir)
        found = []
        for part in ("src", "modules"):
            if (root / part).is_dir():
                found += (root / part).rglob("*.rs")
        return sorted(found)

    def workspace_sources(crates_dir):
        # `rust_sources` of every crate under `crates/`.
        import pathlib as _pathlib
        found = []
        for crate in sorted(_pathlib.Path(crates_dir).iterdir()):
            if (crate / "Cargo.toml").is_file():
                found += rust_sources(crate)
        return found

    # THE SHELL'S SOURCES, WHEREVER A MODULE OF IT LIVES.
    #
    # The shell is one crate today and a family of them tomorrow
    # (`ronoctua-shell`, `ronoctua-shell-kit`, `ronoctua-shell-door`…): a check
    # that names `crates/ronoctua-shell/src/files.rs` would have to be edited
    # the day `files.rs` moves to the file manager's own crate, and a sweep of
    # one crate's `src/` would silently stop reaching the modules that left
    # it. So a check asks for a module by its path INSIDE a shell crate's
    # `src/` — `surface.rs`, `door/mod.rs` — and these find it in whichever
    # crate holds it. Every crate named `ronoctua-shell` or `ronoctua-shell-*`
    # is the shell, found by name in the tree: a crate split off joins with no
    # edit here. And `ronoctua-render-png`, the buffer's PNG camera: a binary
    # of the shell until the 2026-10-12 wave, still at `bin/render-png.rs`
    # inside its own `src/`, so every sweep that reached it reaches it.
    #
    # The tree is `shellSources` (every shell crate's `src/`, laid out as in
    # the repository), which a check opens with
    # `exec(open("''${shellPrelude}").read())` after this prelude; a check
    # over another tree (`''${self}`, a planted one) passes `root=`.
    _SHELL_CRATE = _re.compile(r"ronoctua-shell(?:-[a-z0-9-]+)?|ronoctua-render-png")

    def shell_crates(root=None):
        # Every shell crate's folder under `root` (a tree holding `crates/`),
        # sorted; a tree with none is refused, never an empty sweep.
        import pathlib as _pathlib
        if root is None:
            root = globals().get("SHELL_SOURCES")
            if root is None:
                print("ERROR: no shell tree; open with the shell prelude or pass root=",
                      file=_sys.stderr)
                raise SystemExit(1)
        crates = _pathlib.Path(root) / "crates"
        found = sorted(c for c in crates.iterdir()
                       if _SHELL_CRATE.fullmatch(c.name) and (c / "src").is_dir())
        if not found:
            print("ERROR: no shell crate under " + str(crates), file=_sys.stderr)
            raise SystemExit(1)
        return found

    def shell_files(pattern="**/*.rs", root=None):
        # Every file of the shell matching `pattern`, a glob relative to a
        # shell crate's `src/` (`*.rs` is that folder alone, `**/*.rs` every
        # depth, `door/*.rs` one folder), over every shell crate, sorted.
        found = []
        for crate in shell_crates(root):
            found += (crate / "src").glob(pattern)
        return sorted(found)

    def shell_file(name, root=None):
        # THE one file of the shell at `src/<name>` — whichever shell crate
        # holds it. Absent, or in two crates at once, is refused by name.
        hits = [c / "src" / name for c in shell_crates(root) if (c / "src" / name).is_file()]
        if len(hits) != 1:
            print("ERROR: the shell has " + str(len(hits)) + " files at src/" + name
                  + " (" + ", ".join(str(h) for h in hits) + "); a check reads exactly one",
                  file=_sys.stderr)
            raise SystemExit(1)
        return hits[0]

    def shell_has(name, root=None):
        # Whether some shell crate holds `src/<name>`.
        return any((c / "src" / name).is_file() for c in shell_crates(root))

    def shell_module_files(name, root=None):
        # THE FILES OF ONE MODULE OF THE SHELL: `src/<name>.rs` or
        # `src/<name>/mod.rs`, then every file under `src/<name>/`, sorted — in
        # whichever shell crate holds it. A module split into files (the
        # footer: `surface/mod.rs` and one `surface/<view>.rs` per view) is
        # still ONE module: its children see its private fields and its
        # methods are one `impl`. Absent, or in two crates, is refused.
        hits = []
        for c in shell_crates(root):
            src = c / "src"
            head = [f for f in (src / (name + ".rs"), src / name / "mod.rs") if f.is_file()]
            if head:
                rest = sorted(f for f in (src / name).rglob("*.rs") if f not in head) if (src / name).is_dir() else []
                hits.append(head + rest)
        if len(hits) != 1:
            print("ERROR: the shell has " + str(len(hits)) + " modules named " + name
                  + "; a check reads exactly one", file=_sys.stderr)
            raise SystemExit(1)
        return hits[0]

    def shell_source(name, root=None):
        # THE TEXT OF `src/<name>` — a file of the shell, as `shell_file` finds
        # it — or, when `<name>` is a module that became a folder
        # (`surface.rs` → `surface/mod.rs` and its children), the text of the
        # whole module, its files one after another: what the module DOES is
        # in all of them, and a check that asks "does the footer do X" asks
        # the module. One line names each file (a comment, so `code_of` and
        # `uncommented` drop it and nothing it says can satisfy a rule).
        #
        # THE PRODUCT FIRST, THE TESTS LAST: every file's code with its test
        # modules taken out (`outside_tests`), and then every file's test
        # modules — so `without_tests`, which cuts from the first test module
        # to the end, still leaves the whole product of the module, children
        # included, and the raw text still holds everything.
        stem = name[:-3] if name.endswith(".rs") else name
        if shell_has(name, root) and not shell_has(stem + "/mod.rs", root):
            return shell_file(name, root).read_text()
        texts = [(shell_name(f) or f.name, f.read_text()) for f in shell_module_files(stem, root)]
        return "".join(
            "\n// -- " + n + " --\n" + outside_tests(x) for n, x in texts
        ) + "".join(test_modules(x) for _, x in texts)

    def shell_dir(name, root=None):
        # THE one folder of the shell at `src/<name>` (`door`), as
        # `shell_file` finds a file.
        hits = [c / "src" / name for c in shell_crates(root) if (c / "src" / name).is_dir()]
        if len(hits) != 1:
            print("ERROR: the shell has " + str(len(hits)) + " folders at src/" + name
                  + "; a check reads exactly one", file=_sys.stderr)
            raise SystemExit(1)
        return hits[0]

    def shell_name(path):
        # A path's name inside its shell crate's `src/` (`surface.rs`,
        # `door/mod.rs`), or None for a path in no shell crate — what a check
        # prints, and what it compares with a module's name.
        parts = list(_pathlib_parts(path))
        for i in range(len(parts) - 2, 0, -1):
            if parts[i] == "src" and _SHELL_CRATE.fullmatch(parts[i - 1]):
                return "/".join(parts[i + 1 :])
        return None

    def _pathlib_parts(path):
        import pathlib as _pathlib
        return _pathlib.PurePath(path).parts

    def shell_manifests(root=None):
        # Every shell crate's `Cargo.toml`, sorted — opened with the
        # manifests' prelude (`shellManifestPrelude`), or under `root` (a
        # tree holding `crates/`). A check about what the shell DEPENDS on
        # reads all of them: a dependency a module took with it to its new
        # crate is still the shell's. None is refused, never an empty sweep.
        import pathlib as _pathlib
        if root is None:
            root = globals().get("SHELL_MANIFESTS")
            if root is None:
                print("ERROR: no shell manifests; open with the manifests' prelude or pass root=",
                      file=_sys.stderr)
                raise SystemExit(1)
        crates = _pathlib.Path(root) / "crates"
        found = sorted(c / "Cargo.toml" for c in crates.iterdir()
                       if _SHELL_CRATE.fullmatch(c.name) and (c / "Cargo.toml").is_file())
        if not found:
            print("ERROR: no shell manifest under " + str(crates), file=_sys.stderr)
            raise SystemExit(1)
        return found

    # THE LEADER'S KEYMAP, WHEREVER A CRATE SAYS ITS KEYS.
    #
    # Each crate declares its keys in a `bindings::Contribution` beside its
    # view — a `pub const KEYS`, the footer's `pub const BASE` — and the
    # binary assembles them (`keymap::CONTRIBUTIONS`). A check that read the
    # keymap in one file would stop seeing a crate's keys, silently, the day
    # that crate said them itself; these find every one, in the shell's
    # product code (tests cut, comments off, strings kept).
    _CONTRIBUTION = _re.compile(
        r"pub const ([A-Z_]+):\s*(?:crate::bindings::)?Contribution\s*=\s*"
        r"(?:crate::bindings::)?Contribution\s*\{"
    )

    def _matched(text, at):
        # The text inside the bracket opening at `at` (`{` or `[`) up to the
        # one that closes it — a bracket inside a string literal (`"TAB ["`)
        # is no bracket.
        opening = text[at]
        closing = "}" if opening == "{" else "]"
        depth, k = 0, at
        while k < len(text):
            c = text[k]
            if c == '"':
                k += 1
                while k < len(text) and text[k] != '"':
                    k += 2 if text[k] == "\\" else 1
            elif c == opening:
                depth += 1
            elif c == closing:
                depth -= 1
                if depth == 0:
                    return text[at + 1 : k]
            k += 1
        return text[at + 1 :]

    def hosted_regions(root=None):
        # The views the binary registers with the footer's slot host
        # (`regions.rs`, `<crate>::<module>::ENTRY` a line — by its whole
        # path, or `crate::<module>` through the binary's root): each region's id,
        # as its module ranks it (`pub const ID: &str = "…"`), and the
        # module's file — what a check about a view asks once the view is a
        # region of its own crate. Refused by name when an entry's module has
        # no id, or two entries one.
        text = uncommented(without_tests(shell_file("regions.rs", root).read_text()))
        at = text.find("pub const REGIONS")
        if at < 0:
            print("ERROR: regions.rs declares no `REGIONS`", file=_sys.stderr)
            raise SystemExit(1)
        table = text[at : text.index("];", at)]
        found = {}
        for module in _re.findall(r"\b(?:crate|ronoctua_shell_\w+)::(\w+)::ENTRY\b", table):
            f = shell_file(module + ".rs", root)
            m = _re.search(r'pub const ID: &str = "([a-z-]+)";', uncommented(f.read_text()))
            if m is None or m.group(1) in found:
                print("ERROR: the region of " + module + ".rs has no `ID` of its own", file=_sys.stderr)
                raise SystemExit(1)
            found[m.group(1)] = f
        return found

    def keymap_contributions(root=None):
        # Every contribution: (file, the constant's name, its body).
        found = []
        for f in shell_files("**/*.rs", root):
            text = uncommented(without_tests(f.read_text()))
            for m in _CONTRIBUTION.finditer(text):
                found.append((f, m.group(1), _matched(text, m.end() - 1)))
        return found

    def keymap_rows(root=None):
        # Every WRITTEN sequence of every contribution — its `bindings`
        # field — as (file, keys, command): the keys a literal's text or a
        # constant's name (`SOFTWARE_KEYS`), the command a literal's id or a
        # constant's path as written (`OPEN`, `crate::binary_cache::OPEN`).
        # A field that names a constant (`bindings: BINDINGS`) is that
        # constant's slice, declared in the same file.
        rows = []
        for f, _, body in keymap_contributions(root):
            m = _re.search(r"\bbindings:\s*(&\[|[A-Z_]+)", body)
            if not m:
                continue
            if m.group(1) == "&[":
                table = _matched(body, m.end() - 1)
            else:
                text = uncommented(without_tests(f.read_text()))
                d = _re.search(r"pub const " + m.group(1) + r"\b[^=]*=\s*&\[", text)
                table = _matched(text, d.end() - 1) if d else ""
            for r in _re.finditer(
                r'\(\s*("[^"]*"|[A-Za-z_:]+)\s*,\s*("[a-z0-9-]+"|[A-Za-z_:]+)\s*,\s*(?:None|Some\()',
                table,
            ):
                rows.append((f, r.group(1).strip('"'), r.group(2).strip('"')))
        return rows

    def without_keymap(text):
        # The text with every keymap contribution cut out. A view's file holds
        # its crate's `KEYS` beside the view, and the labels there are the
        # shortcut list's — `cmd-<id>`, `group-…` — and not rows the view
        # draws, as they were not while they lived in `leader.rs`.
        out, at = [], 0
        for m in _CONTRIBUTION.finditer(text):
            if m.start() < at:
                continue
            out.append(text[at : m.start()])
            at = m.end() + len(_matched(text, m.end() - 1)) + 1
        out.append(text[at:])
        return "".join(out)
  '';

  # THE SHELL'S CRATES, by name: `ronoctua-shell`, every `ronoctua-shell-*`
  # under `crates/`, and `ronoctua-render-png` (a binary of the shell until
  # the 2026-10-12 wave, still `bin/render-png.rs` in its `src/`). Read from
  # the tree at evaluation, so a crate split off is reached with no edit.
  shellCrates =
    builtins.filter
      (
        name:
        name == "ronoctua-shell" || lib.hasPrefix "ronoctua-shell-" name || name == "ronoctua-render-png"
      )
      (builtins.attrNames (lib.filterAttrs (_: kind: kind == "directory") (builtins.readDir ../crates)));

  # EVERY SHELL CRATE'S `src/`, and nothing else, laid out as in the
  # repository (`crates/<crate>/src/…`): what a check about the shell reads,
  # through `shell_file`/`shell_files` (Python) or the same two names in a
  # shell script (`shellSh`). A check that read `../crates/ronoctua-shell/src`
  # would have to be edited each time a module moved to another shell crate.
  shellSources = lib.fileset.toSource {
    root = ../.;
    fileset = lib.fileset.unions (map (crate: ../crates + "/${crate}/src") shellCrates);
  };

  # WHERE THE PRELUDE'S SHELL HELPERS LOOK, in a file of its own: the prelude
  # stays free of any source, so a check that reads no shell file does not
  # depend on the shell. A check reading the shell opens with
  # `exec(open("''${pyPrelude}").read())` and then
  # `exec(open("''${shellPrelude}").read())`. `globals()`, because a prelude
  # opened inside a function puts its names in that function's locals, and
  # the helpers look the tree up in the module's.
  shellPrelude = pkgs.writeText "ronoctua-check-shell.py" ''
    globals()["SHELL_SOURCES"] = "${shellSources}"
  '';

  # EVERY SHELL CRATE'S `Cargo.toml`, and nothing else, as `shellSources` holds
  # their `src/`: what a check about what the shell DEPENDS on reads, through
  # `shell_manifests()`, opened with `shellManifestPrelude` after the prelude.
  # A prelude of its own, so the checks that read only the sources do not
  # rebuild when a manifest moves.
  shellManifests = lib.fileset.toSource {
    root = ../.;
    fileset = lib.fileset.unions (map (crate: ../crates + "/${crate}/Cargo.toml") shellCrates);
  };
  shellManifestPrelude = pkgs.writeText "ronoctua-check-shell-manifests.py" ''
    globals()["SHELL_MANIFESTS"] = "${shellManifests}"
  '';

  # THE SAME TWO HELPERS FOR A SHELL SCRIPT, sourced with `. ''${shellSh}`:
  # `shell_file NAME` prints the one file at a shell crate's `src/NAME` (and
  # fails, naming it, on none or two); `shell_files PATTERN` prints every file
  # matching the glob under each shell crate's `src/`, one a line, sorted.
  shellSh = pkgs.writeText "ronoctua-check-shell.sh" ''
    shell_file() {
      local hits=() crate
      for crate in ${lib.concatMapStringsSep " " (c: "${shellSources}/crates/${c}") shellCrates}; do
        if [ -f "$crate/src/$1" ]; then hits+=("$crate/src/$1"); fi
      done
      if [ "''${#hits[@]}" -ne 1 ]; then
        echo "ERROR: the shell has ''${#hits[@]} files at src/$1; a check reads exactly one" >&2
        return 1
      fi
      echo "''${hits[0]}"
    }
    shell_files() {
      local crate f
      for crate in ${lib.concatMapStringsSep " " (c: "${shellSources}/crates/${c}") shellCrates}; do
        for f in "$crate"/src/$1; do
          if [ -e "$f" ]; then echo "$f"; fi
        done
      done | sort
    }
  '';

  # The kernel's console as the ISO and every machine have it, for the VM
  # tests that look at one.
  consoleModule = import ../nix/modules/console.nix { tool = rust.consoleFont; };

  # A MACHINE FOR THE INSTALLER TO READ (`RONOCTUA_INSTALLER_SYSROOT`): the
  # firmware's EFI folder and a TPM 2.0, each when asked for. The build's
  # sandbox has neither, and what the installer read there would be the
  # builder's — a `host.nix` for BIOS, an installation stopped on the TPM.
  installerMachine =
    { uefi, tpm2 }:
    pkgs.runCommand
      "installer-machine-${if uefi then "uefi" else "bios"}${lib.optionalString (!tpm2) "-no-tpm"}"
      { }
      (
        "mkdir -p $out/sys\n"
        + lib.optionalString uefi "mkdir -p $out/sys/firmware/efi\n"
        + lib.optionalString tpm2 "mkdir -p $out/sys/class/tpm/tpm0 && echo 2 > $out/sys/class/tpm/tpm0/tpm_version_major\n"
      );
  uefiMachine = installerMachine {
    uefi = true;
    tpm2 = true;
  };

  # A check that runs a script and passes if it exits 0.
  mkCheck =
    name: deps: script:
    pkgs.runCommand "check-${name}" { nativeBuildInputs = deps; } ''
      set -euo pipefail
      ${script}
      touch $out
    '';

  # VM test of the footer: it proves that it DRAWS, not only that it compiles.
  # Under lavapipe (section 9.3 of the plan) — correctness, never performance.
  footerVm = import ./footer-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
  };

  # A REAL SYNCTHING, and the view that reads it. Also the only place the
  # polkit rule is exercised end to end, as the owner and with no agent.
  syncthingVm = import ./syncthing-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
  };

  # The machine does not freeze when memory runs out, and the desktop is not the
  # victim. Two nodes with different RAM, because a percentage that is merely
  # present looks exactly like one that does not adapt.
  oomVm = import ./oom-vm.nix {
    inherit pkgs lib;
    ronoctua = {
      inherit fonts fontconfigConf;
      # The theme list (the option's enum), the solved palettes and the
      # DEFAULT — base.nix and scroll.nix read all three.
      #
      # `defaultTheme` was missing here, and `ronoctua.theme`'s option reads it
      # for its `default`: every VM test that imports `base.nix` failed to
      # EVALUATE with "attribute 'defaultTheme' missing". It arrived when order
      # and default became two facts in `assets/themes/themes.nix`, and it went
      # unseen because these tests are in `most`, which had not been run since.
      inherit themes themed defaultTheme;
      inherit cursors;

      shell = rust.shell;
      iconSuperpack = self.packages.${system}.noctua-icon-theme;
    };
  };

  # The modeline reflects the focused buffer, proved ON SCREEN (milestone 4).
  modelineVm = import ./modeline-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
    # The player, for the pair it draws on the modeline (its four clicks).
    inherit (rust) player;
    # The contract's driver, for what the compositor says exists.
    contract = rust.bins.ronoctua-contract;
  };

  # The default keymap closes: no collision and every shortcut pointing at a
  # command that exists. The binary is the same one a person runs by hand.
  # EVERY SHORTCUT OF THE COMPOSITOR'S OWN CONFIGURATION IS BOUND HERE.
  #
  # The session passes `-c`, so the configuration the compositor ships is never
  # read — and what it binds would simply not exist unless `actions.rs` binds
  # it too. This reads the PINNED shipped file and the binds we generate, and
  # asks of every one of its shortcuts: the same key doing the same thing, or
  # a relocation written below with its reason, or — on the nine keys the
  # distro already had — the same command on some key of ours. A compositor
  # update that adds a shortcut fails here, naming it.
  every-compositor-shortcut-is-bound =
    let
      binds =
        (pkgs.callPackage ../nix/compositor-binds.nix { ronoctua-shell = rust.shell; }).forPrefix
          "Super";
    in
    mkCheck "every-compositor-shortcut-is-bound" [ pkgs.python3 ] ''
      python3 - <<'END'
      import re, sys
      exec(open("${pyPrelude}").read())

      # PARSED: two configuration files, read as the compositor reads them —
      # `set` variables, `mode "…" { }` blocks, comments.
      def parse(path):
          variables, binds, extra, mode = {}, [], [], None
          for raw in open(path, encoding="utf-8"):
              line = raw.split("#", 1)[0].strip() if raw.lstrip().startswith("#") else raw.strip()
              if not line:
                  continue
              for name, value in sorted(variables.items(), key=lambda kv: -len(kv[0])):
                  line = line.replace(name, value)
              if line.startswith("set $"):
                  _, name, value = line.split(None, 2)
                  variables[name] = value
                  continue
              m = re.match(r'mode\s+"([^"]+)"\s*\{', line)
              if m:
                  mode = m.group(1)
                  continue
              if line == "}":
                  mode = None
                  continue
              if line.startswith(("floating_modifier", "bindgesture")):
                  extra.append(" ".join(line.split()))
                  continue
              if not line.startswith("bindsym"):
                  continue
              words = [w for w in line.split()[1:] if not w.startswith("--")]
              binds.append((mode, canon(words[0]), " ".join(words[1:])))
          return binds, extra

      ALIASES = {"mod4": "super", "page_up": "prior", "page_down": "next"}
      def canon(key):
          parts = [ALIASES.get(p.lower(), p.lower()) for p in key.split("+")]
          return "+".join(sorted(parts[:-1]) + parts[-1:])

      def steps(command):
          # `a; mode default;` and `a; mode default` are the same thing.
          return [s.strip() for s in command.split(";") if s.strip()]

      theirs, their_extra = parse("${inputs.scroll-src}/config.in")
      ours, our_extra = parse("${binds}")
      floor(len(theirs), 250, "binds in the shipped configuration")
      floor(len(ours), 300, "binds we generate")

      MODES = {"wssplit": "split", "jump": "jump", "filter": "filter",
               "modifiers": "placement", "setsizeh": "width", "setsizev": "height",
               "resize": "resize", "floating": "floating", "togglesizeh": "toggle-width",
               "togglesizev": "toggle-height", "align": "align", "fit_size": "fit",
               "trailmark": "trailmark", "trail": "trail", "spaces": "spaces"}
      # WHERE A SHORTCUT OF THEIRS WENT, and why — the owner's rule: the
      # distro keeps its keys, and what loses one gets another.
      RELOCATED = {
          "shift+super+left": "shift+super+h", "shift+super+down": "shift+super+j",
          "shift+super+up": "shift+super+k", "shift+super+right": "shift+super+l",
          "super+c": "super+i", "super+t": "super+m", "super+g": "super+s",
          "super+comma": "ctrl+super+minus", "super+period": "ctrl+super+equal",
          "super+button4": "ctrl+super+button4", "super+button5": "ctrl+super+button5",
          # Bare, it takes Back away from every browser.
          "button8": "super+button8",
      }
      # The distro's keys whose shipped command already has another key here.
      ELSEWHERE = {"super+f", "shift+super+f"}
      # What the shipped file hands to programs this distro does not ship.
      PROGRAMS = [("kitty", "buffer-terminal"), ("wmenu-run", "apps-open"),
                  ("$filemanager", "files-window"), ("scrollnag", "session-quit"),
                  ("grim", "screen-capture"), ("set-sink-mute", "volume-mute"),
                  ("-5%", "volume-down"), ("+5%", "volume-up"), ("set-source-mute", "mic-mute"),
                  ("play-pause", "media-play"), ("previous", "media-previous"),
                  ("playerctl next", "media-next"), ("playerctl stop", "media-stop"),
                  ("5%-", "brightness-down"), ("5%+", "brightness-up")]
      # Left out, and why: a deed with criteria names one program.
      LEFT_OUT = {'jump criteria [app_id="firefox"]'}
      # THE SAME KEY, ANOTHER MEANING, and why: NINE workspaces, the owner's
      # rule. The shipped file puts a tenth on `0`; here `0` is every workspace
      # at once (the `LEADER 0` of the sequence), and the bands that move or
      # swap name the ninth, as `TAB 0` and `TAB m 0` do.
      INSTEAD = {
          "super+0": ["command workspace-all"],
          "shift+super+0": steps(
              "move container to workspace number 9; workspace number 9"
          ),
          "ctrl+super+0": steps("workspace swap number 9"),
          "ctrl+shift+super+0": steps("workspace swap number 9 name_only"),
      }

      # A DEED OF THEIRS THAT GOES THROUGH OUR BINARY, and why: every
      # workspace at once is said by no reply and no event, so the footer —
      # which shows the key back out of it — turns it on itself.
      THROUGH_US = {"scale_workspaces toggle": "workspace-all",
                    # THE SELECTION, which no reply and no event says either:
                    # the footer keeps its own copy (`crate::selection`).
                    "selection toggle": "wm-select",
                    "selection reset": "wm-select-none",
                    "selection move": "wm-select-move",
                    "selection workspace": "wm-select-workspace",
                    "selection to_trail": "wm-select-to-trail",
                    # AND A WINDOW'S BARS, which the Chrome kiosk keeps a copy
                    # of for the same reason (`kiosk::Kiosks::deed_ran`).
                    "fullscreen application": "wm-full-application"}

      def ours_as(command):
          if command in THROUGH_US:
              return ["command " + THROUGH_US[command]]
          if command.startswith("exec "):
              for needle, ours_id in PROGRAMS:
                  if needle in command:
                      return ["command " + ours_id]
              return None
          m = re.match(r'mode "([^"]+)"$', command)
          if m and m.group(1) in MODES:
              return ['mode "' + MODES[m.group(1)] + '"']
          return steps(command)

      def matches(wanted, command):
          if wanted and wanted[0].startswith("command "):
              return command.startswith("exec ") and command.endswith(wanted[0])
          return steps(command) == wanted

      by_key = {}
      for mode, key, command in ours:
          by_key.setdefault((mode, key), []).append(command)
      wrong = []
      for mode, key, command in theirs:
          if any(steps(command)[0] == left for left in LEFT_OUT):
              continue
          wanted = ours_as(command)
          if wanted is None:
              wrong.append(f"{key}: `{command}` runs a program nobody mapped")
              continue
          where = (MODES.get(mode, mode) if mode else None, key)
          if mode and mode not in MODES:
              wrong.append(f"the mode `{mode}` has no counterpart here")
              continue
          if any(matches(wanted, c) for c in by_key.get(where, [])):
              continue
          if not mode and key in RELOCATED and any(
              matches(wanted, c) for c in by_key.get((None, RELOCATED[key]), [])
          ):
              continue
          if not mode and key in INSTEAD and any(
              matches(INSTEAD[key], c) for c in by_key.get((None, key), [])
          ):
              continue
          if not mode and key in ELSEWHERE and any(
              matches(wanted, c) for (m, _), cs in by_key.items() if m is None for c in cs
          ):
              continue
          wrong.append(f"{'mode ' + mode + ': ' if mode else ""}{key} -> `{command}`")
      for line in their_extra:
          if line.replace("Mod4", "Super") not in our_extra:
              wrong.append(f"`{line}` is not in our configuration")
      for w in wrong:
          print(f"ERROR: {w}", file=sys.stderr)
      if wrong:
          print(f"{len(wrong)} of the compositor's own shortcuts are not bound here.", file=sys.stderr)
          sys.exit(1)
      print(f"OK: all {len(theirs)} of the compositor's shortcuts are bound, {len(RELOCATED)} of them elsewhere")
      END
    '';

  keymap-no-collision = mkCheck "keymap-no-collision" [ ] ''
    # The palettes and the texts (`rust.keyed`): this binary is the unwrapped
    # one, and the colours and the words are data it reads at run time.
    export RONOCTUA_THEMES=${rust.keyed.RONOCTUA_THEMES}
    export RONOCTUA_TEXTS=${rust.keyed.RONOCTUA_TEXTS}
    # And the brain's catalogue (`rust.keyed`): the modules' marks and the
    # keymap's actions are data it reads at run time, refused (78) without it.
    export RONOCTUA_BRAIN_CATALOGUE=${rust.keyed.RONOCTUA_BRAIN_CATALOGUE}
    ${rust.bins.ronoctua-shell}/bin/ronoctua-shell check-keymap
  '';

  # THE ICON PAGE'S TAG ROW EXISTS FOR EVERY LANGUAGE.
  #
  # The icons app's page (`crate::icons_page`) shows one row of tags per
  # language, and the key is ASSEMBLED — `icons-sheet-tags-` plus the subtag —
  # so it is one of the keys
  # `docs/ARCHITECTURE.md` calls invisible to every search in the code. It was
  # two constants, `TAGS_PT` and `TAGS_EN`, which is the shape that made a third
  # language impossible; now it is a prefix, and what a prefix loses is the
  # compile error.
  #
  # Without this, declaring a third language would draw `[icons-sheet-tags-de]`
  # on the page — the raw key, which is exactly the failure invariant 8 exists
  # to refuse.
  buffer-tag-rows-have-text = mkCheck "buffer-tag-rows-have-text" [ pkgs.gnugrep pkgs.coreutils ] ''
    failed=0
    for language in ${lib.concatStringsSep " " languages}; do
      subtag=$(echo "$language" | cut -d- -f1 | tr 'A-Z' 'a-z')
      for other in ${lib.concatStringsSep " " languages}; do
        key="icons-sheet-tags-$subtag"
        grep -qE "^$key = ." ${texts}/$other.ftl || {
          echo "ERROR: $key is missing from $other.ftl — the icon page would" >&2
          echo "       draw the raw key on the row that shows $language's tags." >&2
          failed=1
        }
      done
    done
    [ "$failed" = 0 ] || exit 1
    echo "OK: a tag row for each of ${toString (builtins.length languages)} languages, in every .ftl"
  '';

  # A THIRD LANGUAGE COSTS NOTHING BUT ITS TRANSLATION.
  #
  # Everything else in this file now reads `assets/i18n/languages.nix`, so a
  # third language is checked everywhere the first two are. What no check could
  # say is whether the PIPELINE survives a third — and it could not be said by
  # inspection, because for as long as the tree has existed the answer to "how
  # many languages" has been two, in ninety-five places.
  #
  # So this builds one. `zz-ZZ` is a synthetic language whose every value is the
  # base language's, PADDED to roughly 120% — which is about what German or
  # French cost against English, and rather more than the 6.8% pt-BR costs. It
  # exercises the generator's key parity, the merged file a program reads at
  # run time, the `LANGUAGES` constant of the registry written at evaluation
  # (`nix/text-keys.nix`), and the arithmetic of every check that used to name
  # a pair. It never reaches an installed system: it is built here, used here,
  # and thrown away with the derivation.
  #
  # THE LOADER HAS NO ARM PER LANGUAGE ANY MORE. It used to be a generated
  # `face()` with one `include_str!` per language — the one place a declared
  # language could still be missing its body. Now a program reads
  # `$RONOCTUA_TEXTS/<language>.ftl` for whichever declared language it is
  # asked, so the registry must name no file at all; a binary compiled with
  # three languages is not built here.
  #
  # `zz` is reserved by ISO 639-2 for local use, so it cannot collide with a
  # real language somebody adds later.
  third-language-costs-nothing =
    let
      # EVERY BRAIN MODULE'S TEXT FOLDER, and the sample's: a third language
      # costs one more file in each of them too, and the sample is there so
      # that half runs on the day no real module exists yet.
      folders = pkgs.writeText "third-language-folders.json" (
        builtins.toJSON (
          map (f: {
            inherit (f) id prefixes;
            dir = "${f.dir}";
          }) brainModules.i18nFragments
          ++ [
            {
              id = "pilot-sample";
              prefixes = [ "pilot-sample" ];
              dir = "${../crates/ronoctua-brain/tests/modules/pilot-sample/i18n}";
            }
          ]
        )
      );
      # EVERY CRATE'S FRAGMENT (and the extension's), each grown the same way.
      crateFolders = pkgs.writeText "third-language-fragments.json" (
        builtins.toJSON (lib.mapAttrs (_: dir: "${dir}") texts.fragments)
      );
      # THE LANGUAGES A THIRD WOULD COMPILE AGAINST, and every crate's keys:
      # the functions the build writes them with, at evaluation.
      thirdKeys =
        (import ../nix/text-keys.nix {
          inherit lib;
          src = ../.;
          languages = languages ++ [ "zz-ZZ" ];
          inherit (pkgs) writeTextDir linkFarm;
        }).languagesRs;
      keyFiles = pkgs.writeText "third-language-key-files.json" (builtins.toJSON texts.textKeys.files);
    in
    mkCheck "third-language-costs-nothing" [ pkgs.python3 ] ''
      python3 - <<'END'
      import json, pathlib, re, subprocess, sys, tempfile

      base = "${builtins.head languages}"
      root = pathlib.Path(tempfile.mkdtemp())

      # THE VALUE GROWS, THE KEY DOES NOT. A key that changed would be testing
      # the generator's tolerance for a typo, which is a different check
      # (`i18n-missing-key-fails`) and one that already exists.
      def grown_from(path):
          grown = []
          for line in path.read_text(encoding="utf-8").splitlines():
              m = re.match(r"^([a-z][a-z0-9-]*) *= *(.+)$", line)
              if m:
                  value = m.group(2)
                  grown.append(f"{m.group(1)} = {value + 'x' * max(1, len(value) // 5)}")
              else:
                  grown.append(line)
          return grown

      # ONE FILE MORE IN EVERY CRATE'S FRAGMENT.
      crates = []
      grown = []
      for name, folder in sorted(json.load(open("${crateFolders}")).items()):
          mine = root / "crates" / name
          mine.mkdir(parents=True)
          for f in pathlib.Path(folder).glob("*.ftl"):
              (mine / f.name).write_text(f.read_text(encoding="utf-8"), encoding="utf-8")
          lines = grown_from(mine / f"{base}.ftl")
          grown += lines
          (mine / "zz-ZZ.ftl").write_text("\n".join(lines) + "\n", encoding="utf-8")
          crates += ["--fragment", f"{name}={mine}"]
      if len(crates) // 2 < 30:
          print(f"ERROR: only {len(crates) // 2} crate fragments were grown", file=sys.stderr)
          raise SystemExit(1)
      # The largest fragment, the one an incomplete third language is cut from below.
      work = max((root / "crates").iterdir(), key=lambda d: (d / f"{base}.ftl").stat().st_size)

      # AND ONE FILE MORE IN EVERY MODULE'S FOLDER, grown the same way.
      folders = json.load(open("${folders}"))
      modules = []
      for folder in folders:
          mine = root / "modules" / folder["id"]
          mine.mkdir(parents=True)
          for f in pathlib.Path(folder["dir"]).glob("*.ftl"):
              (mine / f.name).write_text(f.read_text(encoding="utf-8"), encoding="utf-8")
          (mine / "zz-ZZ.ftl").write_text(
              "\n".join(grown_from(mine / f"{base}.ftl")) + "\n", encoding="utf-8"
          )
          modules += ["--module", f"{folder['id']}={mine}",
                      "--prefixes", f"{folder['id']}={','.join(folder['prefixes'])}"]
      if not any(f["id"] == "pilot-sample" for f in folders):
          print("ERROR: the sample module's folder is not among the ones grown", file=sys.stderr)
          raise SystemExit(1)

      out = root / "out"
      def generate():
          return subprocess.run(
              [sys.executable, "${../nix/scripts/gen-i18n.py}", str(out),
               *"${lib.concatStringsSep " " languages}".split(), "zz-ZZ", *crates, *modules],
              capture_output=True, text=True,
          )

      r = generate()
      if r.returncode != 0:
          print("ERROR: the generator refused a complete third language.", file=sys.stderr)
          print(r.stderr, file=sys.stderr)
          raise SystemExit(1)

      # PARSED: the languages and every crate's keys are Rust written by
      # `nix/text-keys.nix`, and the two facts asked of them are the
      # `LANGUAGES` item and the absence of any file they would read.
      body = open("${thirdKeys}", encoding="utf-8").read()
      keys = json.load(open("${keyFiles}"))
      if len(keys) < 30:
          print(f"ERROR: only {len(keys)} crates' key files were read", file=sys.stderr)
          raise SystemExit(1)
      # The three things a third language has to reach: the list, the file a
      # program reads, and the count the generator reports.
      if 'pub const LANGUAGES: [&str; 3]' not in body or '    "zz-ZZ",' not in body:
          print("ERROR: LANGUAGES did not grow to three.", file=sys.stderr)
          raise SystemExit(1)
      if any("include_str!" in t or "include_bytes!" in t for t in [body, *keys.values()]):
          print("ERROR: the key registry embeds a file again — a language's sentences are", file=sys.stderr)
          print("       compiled in, and a declared language can be missing its body.", file=sys.stderr)
          raise SystemExit(1)
      if "in 3 languages" not in r.stdout:
          print(f"ERROR: the generator did not report three: {r.stdout!r}", file=sys.stderr)
          raise SystemExit(1)
      # AND THE FILE A PROGRAM READS HAS EVERY MODULE'S THIRD TEXT: the merged
      # `zz-ZZ.ftl` is what `RONOCTUA_TEXTS` would hand it.
      merged = (out / "zz-ZZ.ftl").read_text(encoding="utf-8")
      sample = grown_from(root / "modules" / "pilot-sample" / f"{base}.ftl")
      # Its MESSAGES: the merged file leaves the fragments' comments out.
      if not all(l in merged for l in sample if " = " in l and not l.startswith("#")):
          print("ERROR: the merged zz-ZZ.ftl does not carry the sample module's third texts", file=sys.stderr)
          raise SystemExit(1)

      # AND AN INCOMPLETE THIRD IS STILL REFUSED. Without this the check above
      # would pass on a generator that had stopped comparing altogether.
      #
      # THE LAST KEY, and not the last line: the file ends in comments (the
      # anchors every package writes after), and dropping one of those left a
      # complete third language — so this used to fail on a correct generator.
      lines = (work / "zz-ZZ.ftl").read_text(encoding="utf-8").splitlines()
      last = max(i for i, l in enumerate(lines) if re.match(r"^[a-z][a-z0-9-]* *=", l))
      (work / "zz-ZZ.ftl").write_text("\n".join(lines[:last] + lines[last + 1 :]) + "\n", encoding="utf-8")
      r = generate()
      if r.returncode == 0:
          print("ERROR: a third language missing a key was ACCEPTED.", file=sys.stderr)
          raise SystemExit(1)
      (work / "zz-ZZ.ftl").write_text("\n".join(lines) + "\n", encoding="utf-8")

      # AND A MODULE WITHOUT ITS THIRD FILE IS REFUSED, by name: the cost of
      # a language is a file in every module, and one forgotten is a module
      # whose rows fall back to the key in brackets.
      (root / "modules" / "pilot-sample" / "zz-ZZ.ftl").unlink()
      r = generate()
      if r.returncode == 0 or "pilot-sample" not in r.stderr or "zz-ZZ" not in r.stderr:
          print("ERROR: a module with no file for the third language was not refused by name.", file=sys.stderr)
          print(r.stderr, file=sys.stderr)
          raise SystemExit(1)

      print(f"OK: a third language builds, loads and is checked — {len(grown)} lines, +20%,"
            f" and one file more in each of {len(folders)} module folders")
      END
    '';

  # DECLARED AND PRESENT ARE THE SAME SET.
  #
  # `assets/i18n/languages.nix` is the one list, and `gen-i18n.py` already
  # closes one direction: a name there with no `.ftl` beside it takes the build
  # down. This closes the other, which was open and silent.
  #
  # A `.ftl` dropped into the directory without being declared used to be
  # copied into the store by `nix/i18n.nix` (which globs), linted by
  # `english-names` (which globs), and then ignored by everything that
  # matters — no key parity, no entry in `LANGUAGES`, no bundle, no menu.
  # `Texts::fresh` would answer `None` for it and the screen would fall back to
  # English without a word. A file that is present, processed and inert is the
  # worst of the three states.
  languages-are-declared = mkCheck "languages-are-declared" [ pkgs.coreutils pkgs.gnused ] ''
    declared=$(printf '%s\n' ${lib.escapeShellArgs languages} | sort)
    base=${builtins.head languages}

    # EVERY FRAGMENT — each crate's that speaks and the extension's — holds
    # exactly the declared languages. And the base has to be among them,
    # because that is what the generator compares every other against and
    # what each crate's keys are read from.
    fragments=0
    for named in ${
      lib.concatStringsSep " " (lib.mapAttrsToList (name: dir: "${name}=${dir}") texts.fragments)
    }; do
      name=''${named%%=*}
      dir=''${named#*=}
      fragments=$((fragments + 1))
      present=$(cd "$dir" && ls *.ftl | sed 's/\.ftl$//' | sort)
      if [ "$declared" != "$present" ]; then
        echo "ERROR: the declared languages and the .ftl files of $name's fragment differ." >&2
        echo "  declared in assets/i18n/languages.nix:" >&2
        printf '    %s\n' $declared >&2
        echo "  present in its i18n/:" >&2
        printf '    %s\n' $present >&2
        echo "      A file that is present and undeclared is worse than a missing" >&2
        echo "      one: it gets copied and linted, and then nothing reads it." >&2
        exit 1
      fi
      test -f "$dir/$base.ftl" || {
        echo "ERROR: $name's fragment has no .ftl of the base language $base" >&2; exit 1; }
    done
    [ "$fragments" -gt 30 ] || {
      echo "ERROR: only $fragments fragments were found — did the list of crates that speak change?" >&2
      exit 1
    }

    # AND `assets/i18n/` HOLDS THE LIST ALONE: a `.ftl` there is read by
    # nothing — every sentence lives in the fragment of the crate that says it.
    stray=$(cd ${../assets/i18n} && ls | grep -v '^languages\.nix$' || true)
    if [ -n "$stray" ]; then
      echo "ERROR: assets/i18n holds more than languages.nix: $stray" >&2
      echo "      A sentence lives in crates/<crate>/i18n/<lang>.ftl, of the crate that says it." >&2
      exit 1
    fi

    # AND EVERY BRAIN MODULE'S TEXT FOLDER IS THE SAME SET, file for file.
    #
    # A module carries its own `i18n/<lang>.ftl` (`nix/brain-modules.nix`),
    # and a third `.ftl` dropped into one is the inert file above, one folder
    # down. The sample under `tests/modules/` is read too, so the half that
    # reads a module folder runs on the day no real module exists yet.
    folders=0
    for texts_of in ${../crates/ronoctua-brain}/modules/*/i18n ${../crates/ronoctua-brain}/tests/modules/*/i18n; do
      if [ ! -d "$texts_of" ]; then
        continue
      fi
      folders=$((folders + 1))
      mine=$(cd "$texts_of" && ls *.ftl | sed 's/\.ftl$//' | sort)
      if [ "$declared" != "$mine" ]; then
        module=$(basename "$(dirname "$texts_of")")
        echo "ERROR: the brain module $module has other .ftl files than the declared languages:" >&2
        printf '    %s\n' $mine >&2
        exit 1
      fi
    done
    [ "$folders" -gt 0 ] || {
      echo "ERROR: no brain module's text folder was found, not even the sample's — did the glob change?" >&2
      exit 1
    }

    echo "OK: $(printf '%s\n' $declared | wc -l) languages, declared and present, base $base, in $fragments fragments and $folders module folders"
  '';

  # Every language has exactly the same keys, none of them empty, and no key is
  # in two fragments. It is the generator that runs in the build; here it runs
  # again as a named check — with every crate's fragment and every brain
  # module's, as `nix/i18n.nix` runs it.
  i18n-complete = mkCheck "i18n-complete" [ pkgs.python3 ] ''
    python3 ${../nix/scripts/gen-i18n.py} $TMPDIR/texts \
      ${lib.escapeShellArgs languages} ${fragmentTextArgs} ${brainTextArgs}
  '';

  # THE NESTED SESSION'S `FONTCONFIG_FILE` RESOLVES A REAL FONT.
  #
  # # What this catches, and how it showed up
  #
  # `FONTCONFIG_FILE` replaces the WHOLE fontconfig configuration. The
  # `nix/dev.nix` pointed at the FRAGMENT — only the alias rules, with no
  # `<dir>` at all —, and fontconfig was left with no font directory: zero
  # fonts, and everything that goes through it becomes TOFU.
  #
  # The symptom was an error message from the compositor in little boxes on the screen.
  # Precisely the message that says what is wrong — the cruelest failure mode
  # there is, because it wipes the information you need exactly when you need it.
  #
  # Our renderer does not go through here (section 6.4), so the footer looked
  # normal while the compositor's warning was illegible: two chains, and only
  # one broken. No check looked at the second.
  fontconfig-nested-finds-font = mkCheck "fontconfig-nested-finds-font" [ pkgs.fontconfig.bin ] ''
    export FONTCONFIG_FILE=${fontconfigConf.fullConf}
    export XDG_CACHE_HOME=$TMPDIR/cache

    # ZERO FONTS IS THE DEFECT. An empty `fc-list` means that every text that
    # goes through fontconfig comes out in little boxes.
    n=$(fc-list 2>/dev/null | wc -l)
    echo "fontconfig sees $n fonts"
    [ "$n" -gt 0 ] || {
      echo "ERROR: NO font at all is visible through the nested FONTCONFIG_FILE." >&2
      echo "      Every foreign app's text — and this compositor's own error" >&2
      echo "      compositor — it would come out as tofu." >&2
      exit 1
    }

    # AND THE THREE GENERICS FALL ON OUR FONT (section 6.4). Finding "some" font
    # is not enough: the nested session exists to show what the distro shows, and
    # with the host's config in the middle it showed Liberation Sans.
    for g in sans-serif serif monospace; do
      matched=$(fc-match "$g" 2>/dev/null)
      echo "  $g -> $matched"
      case "$matched" in
        *NoctuaIosevka*) ;;
        *) echo "ERROR: \`$g\` fell through to '$matched', and not to our font." >&2
           exit 1 ;;
      esac
    done
    echo "OK: the nested fontconfig finds a font, and it is ours"
  '';

  # THE SYNTAX GATE IS NOT HERE, AND THAT IS MEASURED RATHER THAN LOST.
  #
  # It used to be: a validator that read a file and exited, catching a
  # duplicate bind that had sailed through the whole battery and left the
  # compositor on its own defaults — a red box on screen, none of our
  # shortcuts, no leader.
  #
  # This compositor's `--validate` brings up the SERVER first — libseat, a VT,
  # a backend, a renderer — and only then looks at the config. In a sandbox it
  # spends ten seconds failing to find a session; outside one but with no GPU
  # it prints `Failed to create renderer` for a good config and for a
  # deliberately broken one alike. A gate that says the same thing whatever it
  # is shown is not a gate.
  #
  # So it moved to `tests/compositor-contract.nix`, where there is an X server
  # for it — and it took a NEGATIVE half with it, which the version here never
  # had: a broken copy of the same config must be refused, or the gate proves
  # nothing about the good one.
  #
  # What stays in the build are the guards that can be answered by READING the
  # file: `nix/compositor-binds.nix`, `nix/compositor-window-rules.nix` and the
  # config derivations themselves all grep for what must be in them.

  # A CAPTURE LANDS IN A DIRECTORY THE DISTRO DECLARED.
  #
  # # What went wrong without this
  #
  # Nothing declared where a capture goes, so it went wherever the program
  # that took it chose. This distro has no `~/Pictures`: its
  # `XDG_PICTURES_DIR` is `main/media/image`. So every capture went to a
  # directory the system never declared, never created and nothing could point
  # at — and it was silent, because a program writing a PNG somewhere is not an
  # error anywhere.
  #
  # # The two ends MOVED, and the check moved with them
  #
  # It used to read a `screenshot-path` line out of the compositor's generated
  # config. There is no such line now and there cannot be: this compositor
  # takes no screenshots at all. What takes one is `grim`, started by the
  # footer, and the NAME is built in Rust (`capture_path`) out of
  # `RONOCTUA_SCREENSHOTS` — so the two ends to hold together are the module
  # that exports that variable and the table that declares the directory.
  #
  # # Why it reads THREE files
  #
  # Because the defect is the ends DRIFTING, not any one of them being wrong
  # alone. `nix/user-dirs.nix` is what makes the directory (through
  # `xdg.userDirs`, whose `createDirectories` covers `extraConfig` too); the
  # module is what hands the footer the path; and `capture.rs` is what turns it
  # into a file name. Checking only that the variable exists would go green on
  # a path pointing anywhere at all.
  #
  # It reads the GENERATED unit, and not the module's source — the check is
  # against the code, not against the criterion. A variable written into the
  # module and lost on its way into `systemd.user.services` would still be in
  # the source.
  screenshots-land-in-a-declared-directory =
    let
      footer = self.nixosConfigurations.vm.config.systemd.user.services.ronoctua-footer;
      given = footer.environment.RONOCTUA_SCREENSHOTS or "";
    in
    mkCheck "screenshots-land-in-a-declared-directory" [ pkgs.python3 ] ''
      python3 - <<'END'
      import pathlib, re, sys
      exec(open("${pyPrelude}").read())
      exec(open("${shellPrelude}").read())

      # THE UNIT'S OWN VALUE, forced by Nix above and pasted in here. An
      # absent one arrives as the empty string rather than as an evaluation
      # error, which is what lets this say something useful about it.
      given = "${given}"

      if not given:
          print("ERROR: the footer's unit does not carry RONOCTUA_SCREENSHOTS.", file=sys.stderr)
          print("", file=sys.stderr)
          print("       Then `capture_path` returns None, `screen-capture` echoes", file=sys.stderr)
          print("       \"nothing to do\", and the key looks broken rather than", file=sys.stderr)
          print("       unconfigured.", file=sys.stderr)
          raise SystemExit(1)

      # FILE-WIDE, and PROSE is not the word for it: what is read is a Nix
      # TABLE and a Rust function, and the entry in the first is a plain
      # string with no function around it to narrow to.
      #
      # `hashless` for the Nix, because a `screenshot` entry commented out is
      # not an entry and it used to read as one.
      table = hashless(pathlib.Path("${../nix/user-dirs.nix}").read_text())
      floor(len(table), 200, "characters of nix/user-dirs.nix")
      entry = re.search(r'^\s*screenshot\s*=\s*"([^"]+)"\s*;', table, re.M)
      if not entry:
          print("ERROR: nix/user-dirs.nix has no `screenshot` entry.", file=sys.stderr)
          raise SystemExit(1)
      declared = entry.group(1)

      if given != declared:
          print("ERROR: the capture does not land in the declared folder.", file=sys.stderr)
          print("", file=sys.stderr)
          print(f"       the footer is given: {given}", file=sys.stderr)
          print(f"       the distro declares: {declared}", file=sys.stderr)
          print("", file=sys.stderr)
          print("       Both come out of nix/user-dirs.nix on purpose: it is the", file=sys.stderr)
          print("       file that CREATES the folder, through xdg.userDirs, and the", file=sys.stderr)
          print("       one the manager's sidebar points at.", file=sys.stderr)
          raise SystemExit(1)

      # AND THE NAME SAYS WHEN, or a second capture overwrites the first.
      #
      # The moment is built in Rust now rather than handed to a compositor as
      # a strftime, so what is read is the FORMAT STRING that builds it. Its
      # own test pins the shape; this asks only that a moment is in there at
      # all, which is the half that a refactor could drop in silence.
      #
      # `body_of`, because the question IS about one function.
      rust = body_of(
          shell_file("capture.rs").read_text(),
          "capture_path",
      )
      floor(len(rust), 200, "characters of capture_path")

      for needed, why in (
          ("RONOCTUA_SCREENSHOTS", "it does not read the directory from the environment"),
          ("{:04}-{:02}-{:02}", "the name carries no date"),
          ("{:02}-{:02}-{:02}", "the name carries no time"),
      ):
          if needed not in rust:
              print(f"ERROR: capture_path — {why}.", file=sys.stderr)
              print("       A second capture inside one minute erases the first.", file=sys.stderr)
              raise SystemExit(1)

      # AND NO SPACE IN IT. A name with a space is a name that has to be
      # quoted for the rest of its life — by every action of the
      # notification, by the clipboard, by whatever opens it. The previous
      # compositor's default had two.
      made = re.search(r'format!\("(screenshot-[^"]*)"', rust)
      if not made:
          print("ERROR: capture_path no longer builds a name with `format!`.", file=sys.stderr)
          raise SystemExit(1)
      if " " in made.group(1):
          print(f"ERROR: the capture's name has a space in it: {made.group(1)}", file=sys.stderr)
          raise SystemExit(1)

      print(f"OK: the capture lands in {declared}, which the distro declares and creates")
      END
    '';

  # THE DISKS MODULE ADDS NO POLKIT RULE OF ITS OWN.
  #
  # # Why the assertion is INVERTED here, and only here
  #
  # `rescue-polkit-is-narrow` and `transfers-unit-is-narrow` demand a rule,
  # because in those the UNIT IS OURS and nobody else authorises it. udisks2
  # is not ours: it ships actions that already split on `HintSystem`, so a
  # removable device mounts
  # with no password and an internal one asks. A rule of ours could only WIDEN
  # that, and it would be a second place to keep in step with somebody else's
  # action ids — which polkit parses at runtime, so a stale one is silent.
  #
  # # The four halves, and why each is needed
  #
  # Without (1) this goes green on a module that does nothing at all. Without
  # (3) the rule could be smuggled into another module. Without (4) it goes
  # green on a tree where every polkit rule in the project was deleted, which is
  # the failure mode of every "assert the absence of something" check.
  disks-adds-no-polkit-rule-of-its-own =
    mkCheck "disks-adds-no-polkit-rule-of-its-own" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        # FILE-WIDE: a polkit rule anywhere in a module is the offence, and a
        # module is a Nix attribute set with no functions to narrow to.
        #
        # `hashless`: a rule written out in a `#` comment — which is how one is
        # usually left behind — would otherwise be read as a rule.
        modules = pathlib.Path("${../nix/modules}")
        disks = hashless((modules / "disks.nix").read_text())
        floor(len(disks), 200, "characters of nix/modules/disks.nix")
        wrong = []

        # 1. THE MODULE ACTUALLY TURNS UDISKS ON.
        if not re.search(r"^\s*enable = true;", disks, re.M):
            wrong.append("nix/modules/disks.nix does not switch udisks2 on")
        if "services.udisks2" not in disks:
            wrong.append("nix/modules/disks.nix does not mention services.udisks2")

        # 2. AND WRITES NO RULE.
        if "polkit" in disks and "extraConfig" in disks:
            wrong.append("nix/modules/disks.nix writes a polkit rule")

        # 3. NOR DOES ANY OTHER MODULE NAME A UDISKS ACTION.
        swept = 0
        for f in sorted(modules.glob("*.nix")):
            body = hashless(f.read_text())
            swept += 1
            if "org.freedesktop.udisks2." in body.lower():
                wrong.append(f"{f.name} names a udisks2 action in a polkit rule")

        # 4. AND THE FOUR RULES THAT SHOULD EXIST STILL DO.
        #    An "assert the absence" check that never asserts a presence goes
        #    green on an empty tree.
        floor(swept, 10, "modules swept for a udisks2 rule")
        # (`files.nix` left the list when its unit moved behind the sudo door;
        # `security.nix`'s shields rule took its place.)
        for name in ["security.nix", "rescue.nix", "memory.nix", "keyboard.nix"]:
            body = hashless((modules / name).read_text())
            if "polkit.addRule" not in body:
                wrong.append(f"{name} lost the polkit rule it MUST have")

        if wrong:
            print("ERROR: the disks' privilege posture changed.", file=sys.stderr)
            print("", file=sys.stderr)
            for w in wrong:
                print("       " + w, file=sys.stderr)
            print("", file=sys.stderr)
            print("       udisks2 already separates removable from system by HintSystem,", file=sys.stderr)
            print("       and its rule is narrower than any of ours could be.", file=sys.stderr)
            raise SystemExit(1)
        print("OK: udisks2 on, no rule of ours, and the four that exist are still there")
        END
      '';

  # THE TOOL LIST OF UDISKS IS PINNED, AND SO IS WHAT WE ASK OF IT.
  #
  # # What this is protecting
  #
  # `nix/modules/disks.nix` builds udisks with `xfsprogs` replaced by an empty
  # directory. Measured: 305,4 MiB, of which 258,0 is a python3 env reached by
  # exactly one path — `udisks → xfsprogs-bin → python3-env`, for `xfs_scrub`.
  # The distro is btrfs and no pendrive is XFS.
  #
  # That override is free ONLY because mounting is a kernel operation and this
  # crate asks udisks for four verbs, none of which is checking, repairing,
  # resizing or formatting. The day somebody proxies one of those, the override
  # silently stops being free and starts being a feature that does not work.
  #
  # # Why it reads the CODE
  #
  # Because a comment saying "we do not format" is not a guarantee. This greps
  # the proxy module for method declarations, which is the rule
  # `switches-that-do-nothing-say-so` states: the comments do not count.
  disks-tools-are-pinned = mkCheck "disks-tools-are-pinned" [ pkgs.python3 pkgs.binutils ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the override is a Nix attribute set and the five verbs are
    # module-level `fn`s — neither question is about the inside of a function.
    # `Recipe::filesystem` is narrowed by name below.
    module = hashless(pathlib.Path("${../nix/modules/disks.nix}").read_text())
    proxies = code_of(pathlib.Path("${../crates/ronoctua-disks/src/udisks.rs}").read_text())
    floor(len(module), 200, "characters of nix/modules/disks.nix")
    floor(len(proxies), 1000, "characters of udisks.rs")
    wrong = []

    # 1. THE ONE OVERRIDE IS STILL THERE. A nixpkgs bump that re-adds the
    #    258 MiB of Python has to fail here, and not on somebody's ISO.
    if not re.search(r"xfsprogs\s*=\s*pkgs\.emptyDirectory\s*;", module):
        wrong.append("the xfsprogs override left nix/modules/disks.nix")

    # 2. AND IT IS STILL THE ONLY ONE. A tool quietly dropped is a
    #    `mount.<type>` quietly missing, which is a stick that will not mount
    #    and nothing saying why.
    block = scope(module, r"pkgs\.udisks\.override")
    if not block:
        wrong.append("could not find the `pkgs.udisks.override` block in disks.nix")
    else:
        named = set(re.findall(r"^\s*(\w+)\s*=", block, re.M))
        extra = named - {"xfsprogs"}
        if extra:
            wrong.append(f"disks.nix overrides more than xfsprogs: {sorted(extra)}")

    # 3. WHAT WE ASK OF UDISKS, AND WHAT WE MUST NOT.
    def declared(name):
        return re.search(rf"^\s*fn {name}\(", proxies, re.M) is not None

    # `format` USED TO BE ON THIS LIST, and moving it off is a decision and not
    # a relaxation: writing a filesystem is a thing this distro now does, from a
    # buffer whose whole design is the two refusals in front of it. What stays
    # forbidden is everything that would REPAIR or RENAME a filesystem — those
    # are the verbs whose helper the xfsprogs override took away, and offering
    # one that silently does nothing for XFS is the failure this check exists
    # for.
    for verb in ["check", "repair", "resize", "set_label", "take_ownership"]:
        if declared(verb):
            wrong.append(
                f"udisks.rs declares `{verb}`, which the xfsprogs override makes impossible"
            )

    # 4. AND THE FIVE THAT EXIST STILL DO, or this goes green on an empty file.
    for verb in ["mount", "unmount", "eject", "power_off", "format"]:
        if not declared(verb):
            wrong.append(f"udisks.rs lost `{verb}`, which the sidebar uses")

    # 5. AND THE FIVE THIS BUILD CAN WRITE ARE THE FIVE IT OFFERS.
    #
    #    THE SENTENCE ON SCREEN IS WHAT IS BEING CHECKED. The buffer draws a
    #    row saying XFS is not here because the program that writes it is not
    #    installed; a `Recipe` that named `xfs` would make that row a lie AND
    #    produce a refusal from udisks with nothing on screen predicting it.
    # `uncommented`, because the filesystems ARE the string literals this
    # reads back — `code_of` would empty every one of them and the set would
    # come back empty whatever the code said.
    protocol = uncommented(pathlib.Path("${../crates/ronoctua-protocol/src/lib.rs}").read_text())
    floor(len(protocol), 2000, "characters of the protocol's lib.rs")
    body = body_of(protocol, "filesystem")
    if not body:
            wrong.append("could not find `Recipe::filesystem` in the protocol")
    else:
        offered = set(re.findall(r'=> "([a-z0-9]+)"', body))
        if offered != {"vfat", "exfat", "ntfs", "ext4", "btrfs"}:
            wrong.append(f"the filesystems on offer changed: {sorted(offered)}")

    if wrong:
        print("ERROR: what we ask of udisks2 and what it carries disagree.", file=sys.stderr)
        print("", file=sys.stderr)
        for w in wrong:
            print("       " + w, file=sys.stderr)
        raise SystemExit(1)
    # OUTSIDE THE FAILURE. This line sat one indent in, after the `raise`, so
    # it was unreachable on both paths and the Python half of this check said
    # nothing at all when it was green.
    print("OK: only xfsprogs goes, the five verbs exist, and XFS is not offered")
    END

    # AND THE BUILT PACKAGE AGREES WITH THE OVERRIDE.
    #
    # The two halves above read SOURCE. This one reads the artefact, and it is
    # the half that catches a bump: nixpkgs patches `udisksd` to OVERWRITE its
    # own `PATH` with a `makeBinPath` of the tools it was built against, so
    # that string IS what udisks can reach at runtime. `system.fsPackages`
    # never reaches it, which is why `boot.supportedFilesystems` does almost
    # nothing and the module says so.
    #
    # It lives here and not in `disks-vm` because it is a property of the
    # DERIVATION and not of a booted machine: a check that needs no VM fails in
    # seconds instead of in minutes.
    forced=$(strings ${slimUdisks}/libexec/udisks2/udisksd \
      | grep -E '^/nix/store/.*/bin(:|$)' | head -1)
    [ -n "$forced" ] || {
      echo "ERROR: could not find the forced PATH inside udisksd." >&2
      echo "      Without it the nixpkgs patch changed, and the override of" >&2
      echo "      xfsprogs stops meaning what this check claims." >&2
      exit 1; }

    case "$forced" in
      *xfsprogs*)
        echo "ERROR: xfsprogs is back on udisksd's PATH, and 212 MiB with it." >&2
        echo "      Measured: 305.4 MiB of xfsprogs-bin, of which 258.0 are a" >&2
        echo "      python3 environment for xfs_scrub — and this distro is btrfs." >&2
        exit 1 ;;
    esac

    for helper in exfat ntfs3g dosfstools util-linux; do
      case "$forced" in
        *"$helper"*) ;;
        *)
          echo "ERROR: $helper left udisksd's PATH." >&2
          echo "      A pen drive formatted like that stops mounting, and the" >&2
          echo "      symptom is a sidebar row that does nothing." >&2
          exit 1 ;;
      esac
    done
    echo "OK: udisksd's forced PATH has no xfsprogs and has the four helpers"
  '';

  # PERSISTENCE TAKES ITS ROOT AS A PARAMETER.
  #
  # # The defect this exists for, and it reached the owner's screen
  #
  # The file manager's sidebar persisted through a function that found
  # `$XDG_CONFIG_HOME` for itself. Its unit tests press the key that hides the
  # sidebar and the key that pins a file — because that is how one proves a key
  # does something — so `cargo test` wrote into the REAL configuration of
  # whoever ran it, leaving a `/tmp` path pinned and `showing: false`. The
  # symptom was a file manager with no sidebar on a build that had one, and
  # NOTHING FAILED: every test green, every check green, and the only wrong
  # thing in a file nobody thinks to look at.
  #
  # The rule was already written, in the very crate that broke it: `trash::Bin`
  # takes its root because "two tests setting the same environment variable
  # race, and the one that loses puts a file in the other's trash".
  #
  # # Why the shape, and not a sweep of `$HOME` after the suite
  #
  # A check that ran the suite and looked at the home afterwards would only
  # catch the crates that have such a test TODAY. This catches the shape: a
  # function that reads or writes must not also be the one that decides where.
  persistence-takes-its-root-as-a-parameter =
    mkCheck "persistence-takes-its-root-as-a-parameter" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        # WHERE THE ENVIRONMENT MAY BE READ AT ALL. Both are named for what they
        # are — a lookup, not a read — and the application calls them, once.
        FINDERS = ("config_dir()", "state_dir()")
        # What makes a function one that persists.
        TOUCHES = (
            "fs::write", "fs::read_to_string", "create_dir_all", "fs::rename",
            "File::create", "File::open",
        )
        # The lookups themselves, and the constructor that exists to gather them.
        ALLOWED = ("config_dir", "state_dir", "of_env")

        # FILE-WIDE: the offence is a function ANYWHERE in the workspace that
        # both writes and finds, so the census is of every file — and inside
        # one, the indent walk below narrows to a function at a time.
        crates = pathlib.Path("${../crates}")
        bad = []
        swept = 0
        for f in sorted(crates.rglob("*.rs")):
            body = code_of(f.read_text())
            swept += 1
            # `[ \t]*` AND NOT `\s*`: `\s` matches a NEWLINE, so a function
            # preceded by a blank line — which is most of them — captured
            # `"\n    "` as its indent, and the closing brace was then
            # searched for as `\n\n    }\n`, which never matches. The body
            # became THE REST OF THE FILE, and the check flagged fourteen
            # Wayland handlers for a `config_dir()` five thousand lines below
            # them. It went unnoticed because it only fires when something
            # that WRITES appears after such a function, which nothing did
            # until the network view read a file the person named.
            for m in re.finditer(r"\n([ \t]*)(?:pub )?(?:const )?fn (\w+)", body):
                indent, name = m.group(1), m.group(2)
                if name in ALLOWED:
                    continue
                rest = body[m.end():]
                stop = re.search("\n" + indent + "}\n", rest)
                inside = rest[: stop.start()] if stop else rest
                if not any(w in inside for w in TOUCHES):
                    continue
                found = [w for w in FINDERS if w in inside]
                if found:
                    bad.append(
                        f"{f.relative_to(crates)}: `{name}` writes AND finds the "
                        f"directory ({', '.join(found)})"
                    )

        floor(swept, 100, "sources of the workspace swept for a writer")
        if bad:
            print("ERROR: persistence that finds its own root.", file=sys.stderr)
            print("", file=sys.stderr)
            for b in bad:
                print("       " + b, file=sys.stderr)
            print("", file=sys.stderr)
            print("       A function that reads or writes does NOT decide where. What finds", file=sys.stderr)
            print("       the directory is the application, once, and it hands over the", file=sys.stderr)
            print("       answer — otherwise `cargo test` writes into the home of whoever", file=sys.stderr)
            print("       runs it, which is what happened with the sidebar.", file=sys.stderr)
            raise SystemExit(1)

        # AND THE FINDERS ARE STILL THERE. Without this the check goes
        # green on a tree where persistence was deleted altogether.
        finders = floor(
            sum(
                1
                for f in crates.rglob("*.rs")
                for w in ("fn config_dir(", "fn state_dir(")
                if w in code_of(f.read_text())
            ),
            2,
            "functions that locate a directory",
        )
        print(f"OK: nothing that persists finds its own root ({finders} locators)")
        END
      '';

  # THE KEYBOARD LAYOUT REALLY EXISTS.
  #
  # # Why this needs a check
  #
  # xkb does NOT refuse a layout it does not know: it falls back to `us` and
  # carries on. The symptom is the whole keyboard typing something else, with
  # not one line of error anywhere — the same class as the silent fallback that
  # has already cost dearly four times in this project, and the dearest of them,
  # because the way to investigate is by typing.
  #
  # The source of truth is the `xkeyboard-config` registry the session is going
  # to use, and not a list of ours: bumping nixpkgs may retire a name.
  # Chrome does not ask for a password, and cannot start asking again.
  #
  # Two halves, and the check has to see both. The flag alone is not enough: a
  # Secret Service that exists in the closure will be found by SOMETHING, and
  # the prompt comes back through a dependency nobody chose — which is exactly
  # the failure this is here to prevent, because the symptom (a password box on
  # startup) looks like a Chrome setting and is not.
  browser-has-no-keyring = mkCheck "browser-has-no-keyring" [ pkgs.jq ] ''
    system_path=${self.nixosConfigurations.vm.config.system.build.toplevel}

    # 1) The flag reached the wrapper the user actually runs.
    chrome=$(readlink -f "$system_path/sw/bin/google-chrome-stable" 2>/dev/null \
             || readlink -f "$system_path/sw/bin/google-chrome" 2>/dev/null || true)
    [ -n "$chrome" ] || { echo "ERROR: Chrome is not in system_path's closure" >&2; exit 1; }
    grep -q -- "--password-store=basic" "$chrome" || {
      echo "ERROR: Chrome's wrapper has no --password-store=basic." >&2
      echo "      Without it Chrome looks for a Secret Service and asks for a password." >&2
      exit 1; }
    echo "OK: --password-store=basic in the wrapper"

    # 2) NO Secret Service anywhere in the closure.
    #
    # `nix-store -qR` and not a grep over the config: the point is what ends up
    # ON THE MACHINE, and a dependency that pulls the keyring in does not appear
    # in any option.
    found=$(nix-store -qR "$system_path" 2>/dev/null | grep -E "gnome-keyring|kwallet" || true)
    if [ -n "$found" ]; then
      echo "ERROR: a Secret Service got into the closure:" >&2
      echo "$found" | sed 's/^/       /' >&2
      echo "" >&2
      echo "      With it installed Chrome asks for a password again on opening," >&2
      echo "      and the prompt is the keyring's, not Chrome's: no option in the" >&2
      echo "      browser switches it off." >&2
      exit 1
    fi
    echo "OK: no gnome-keyring and no kwallet in the closure"
  '';

  # The nine directories of section 2 reach `user-dirs.dirs`.
  #
  # Setting the environment variable alone moves NOTHING: a file dialog, a
  # browser download and `xdg-open` all read `~/.config/user-dirs.dirs`. So the
  # check reads the generated file, not the option — the option agreeing with
  # itself proves nothing.
  #
  # `XDG_PROJECTS_DIR` is in the list on purpose even though the spec has no such
  # key: it is ours, and if it silently vanished from the generated file nobody
  # would notice until a script went looking for it.
  xdg-user-dirs = mkCheck "xdg-user-dirs" [ ] ''
    dirs=${
      self.nixosConfigurations.vm.config.home-manager.users.noctua.xdg.configFile."user-dirs.dirs".source
    }
    echo "generated file: $dirs"

    expected="XDG_DESKTOP_DIR=/home/noctua/main/temp
    XDG_DOCUMENTS_DIR=/home/noctua/main/archive
    XDG_DOWNLOAD_DIR=/home/noctua/main/temp
    XDG_MUSIC_DIR=/home/noctua/main/media/audio-music
    XDG_MUSIC_VIDEO_DIR=/home/noctua/main/media/video-music
    XDG_PICTURES_DIR=/home/noctua/main/media/image
    XDG_PROJECTS_DIR=/home/noctua/main/prj
    XDG_PUBLICSHARE_DIR=/home/noctua/main/share/public
    XDG_SCREENSHOT_DIR=/home/noctua/main/media/screenshot
    XDG_TEMPLATES_DIR=/home/noctua/templates
    XDG_VIDEOS_DIR=/home/noctua/main/media/video"

    missing=0
    echo "$expected" | while read -r pair; do
      [ -n "$pair" ] || continue
      key=''${pair%%=*}
      value=''${pair#*=}
      line=$(grep -E "^$key=" "$dirs" || true)
      if [ -z "$line" ]; then
        echo "ERROR: $key is not in the generated user-dirs.dirs" >&2; exit 1
      fi
      # The generated value is quoted and uses `$HOME`.
      got=$(echo "$line" | sed -e 's/^[^=]*=//' -e 's/^"//' -e 's/"$//' -e "s|\\\$HOME|/home/noctua|")
      if [ "$got" != "$value" ]; then
        echo "ERROR: $key = $got, expected $value" >&2; exit 1
      fi
      echo "  OK  $key = $got"
    done || missing=1
    [ "$missing" = 0 ] || exit 1

    echo "OK: section 2's eleven directories reach user-dirs.dirs"
  '';

  # THE LOCALE AND THE TIMEZONE EXIST, and the check is where that gets asked.
  #
  # `ronoctua.locale` is a free string on purpose: the real list is glibc's
  # `SUPPORTED`, and reading it during evaluation would be
  # import-from-derivation — the flake would stop and wait for a build. Here,
  # inside a build, the file is free to read.
  #
  # What goes wrong without this is quiet in the way that costs most: a locale
  # glibc does not know produces no error at build time, and the installed system
  # falls back to `C` — dates in American order, no accents in `sort`, and
  # nothing anywhere saying why.
  # THE CONSOLE QUESTION EXISTS, AND ASKS ONCE.
  #
  # Three things that are cheap to get wrong and expensive to notice:
  #
  #   - it must be wanted by `multi-user.target`, because it exists for the boot
  #     that never reaches a graphical one. Under `graphical.target` it would run
  #     exactly when it is not needed and never when it is;
  #   - it must be `oneshot` with no `Restart`, or a machine out of range gets a
  #     password prompt on its console every minute, forever;
  #   - the binary must be a store path. A unit's PATH is minimal, and the
  #     failure of a bare name shows up as a service that exits with nothing to
  #     say about Wi-Fi.
  wifi-console-asks-once = mkCheck "wifi-console-asks-once" [ ] ''
    unit=${self.nixosConfigurations.vm.config.systemd.services.ronoctua-network-console.serviceConfig.Type}
    test "$unit" = "oneshot" || {
      echo "ERROR: the console's service is \`$unit\`, and not oneshot." >&2
      echo "      With Restart it would ask for the password in a loop." >&2
      exit 1; }

    exec_start=${self.nixosConfigurations.vm.config.systemd.services.ronoctua-network-console.serviceConfig.ExecStart}
    case "$exec_start" in
      /nix/store/*) ;;
      *) echo "ERROR: ExecStart is not a store path: $exec_start" >&2; exit 1 ;;
    esac

    wanted="${lib.concatStringsSep " " self.nixosConfigurations.vm.config.systemd.services.ronoctua-network-console.wantedBy}"
    case " $wanted " in
      *" multi-user.target "*) ;;
      *) echo "ERROR: the service is not pulled in by multi-user.target: $wanted" >&2
         echo "      It exists for the boot that does NOT reach graphics." >&2
         exit 1 ;;
    esac

    echo "OK: the console question is oneshot, by path, in multi-user"
  '';

  locale-exists =
    let
      # `null` IS THE ANSWER, not a missing attribute, so `or ""` does not
      # reach it: `ronoctua.time.zone` is declared and defaults to null.
      declaredZone =
        let
          zone = self.nixosConfigurations.vm.config.ronoctua.time.zone;
        in
        if zone == null then "" else zone;
    in
    mkCheck "locale-exists" [ ] ''
      supported=${pkgs.glibcLocales}/share/i18n/SUPPORTED
      tab=${pkgs.tzdata}/share/zoneinfo/zone1970.tab
      locale=${self.nixosConfigurations.vm.config.i18n.defaultLocale}
      # THE ZONE IS THE PERSON'S UNLESS THE FLAKE CLAIMS IT, so it is a string
      # or it is nothing — `ronoctua.time.zone` is `null` by default, which is
      # what leaves `/etc/localtime` to `systemd-timedated` and lets `LEADER s l`
      # change the machine's zone. This read used to be unconditional and the
      # whole battery stopped evaluating at `cannot coerce null to a string`.
      zone=${declaredZone}

      grep -qE "^$locale/UTF-8" "$supported" || {
        echo "ERROR: the locale \`$locale\` is not in glibc's SUPPORTED." >&2
        echo "      system_path would fall through to \`C\`: dates in American order, with no" >&2
        echo "      no accent in the sorting, and nothing saying why." >&2
        exit 1; }

      # The measurement key is the one that must NOT follow the language: it is
      # what keeps the machine metric when someone installs in American English.
      measurement=${self.nixosConfigurations.vm.config.i18n.extraLocaleSettings.LC_MEASUREMENT or ""}
      case "$measurement" in
        en_US*|en_PH*|""|C|C.UTF-8|POSIX)
        echo "ERROR: LC_MEASUREMENT = \`$measurement\` is not metric." >&2
        echo "      Choosing American English chooses a language, never an inch." >&2
          exit 1 ;;
      esac

      # AND IT IS ONLY CHECKED WHEN THERE IS ONE. A zone the flake does not
      # declare is not a zone that is missing: it is the machine's own, seeded
      # by the installer and rewritten by `timedatectl`, and no build-time file
      # can say what it will be. What still has to hold is that a zone somebody
      # DID pin exists — a typo there is a clock an hour out with nothing on
      # screen able to say so.
      if [ -n "$zone" ]; then
        awk -F'\t' '!/^#/ { print $3 }' "$tab" | grep -qx "$zone" || {
          echo "ERROR: the zone \`$zone\` does not exist in the tzdb." >&2
          exit 1; }
      else
        zone="the machine's own"
      fi

      echo "OK: locale \`$locale\`, metric measurements, zone \`$zone\`"
    '';

  # EVERY DOWNLOAD NAMES WHAT IT DOWNLOADS: a version, a commit or a capture.
  #
  # A fixed-output derivation pins a HASH, and a hash against an address that
  # serves new bytes every day holds only while the store keeps the old copy.
  # On 2026-09-22 a garbage collection on the host took that copy, and
  # `nix run .#dev` died on `hash mismatch in fixed-output derivation` for
  # three GeoNames and Geofabrik files that had simply been regenerated
  # upstream — nothing in this tree had changed. `nix/atlas.nix` now fetches
  # Wayback Machine captures; this refuses the next unversioned address before
  # it can do the same on the next machine that builds.
  #
  # Flake inputs are out of scope on purpose: `flake.lock` holds their revision
  # and hash, so the address in `flake.nix` is not what decides the bytes.
  #
  # AND THE DISTRO'S PINS (`assets/distro-pins.json`, written by
  # `nix run .#distro-pins`): an address there is a download like any other,
  # and an F-Droid apk names its version code in the file (`<package>_<code>.apk`).
  downloads-are-pinned = mkCheck "downloads-are-pinned" [ pkgs.python3 ] ''
    python3 - <<'END'
    import json, pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: an address is a literal wherever it is written, and the
    # question is about every `url =` and `urls = [ … ]` of every Nix file.
    root = pathlib.Path("${../nix}")
    pinned = [
        r"/v?\d+\.\d+",                                   # a version in the path
        r"/[0-9a-f]{40}(/|$)",                            # a commit
        r"web\.archive\.org/web/(\d{14}|\$\{\w+\})id_/",  # a capture, raw bytes
        r"\$\{\w*(version|Version|tag|rev|commit)\w*\}",  # a variable that is one
    ]
    # A CAPTURE'S STAMP IS A MOMENT THAT EXISTS. Fourteen digits pass the
    # shape above, and `99999999999999` is the archive's way of saying "the
    # newest capture", which is the live address again under another name.
    # What this cannot see offline is a real date that is not a capture
    # (`20260601000000`): the archive answers it with its NEAREST capture,
    # and naming the capture itself is the author's part (see
    # `nix/broadcast.nix`).
    import datetime
    def impossible_stamp(url):
        m = re.search(r"web\.archive\.org/web/(\d{14})id_/", url)
        if not m:
            return False
        try:
            datetime.datetime.strptime(m.group(1), "%Y%m%d%H%M%S")
        except ValueError:
            return True
        return False

    seen = 0
    wrong = []
    for f in sorted(root.rglob("*.nix")):
        text = hashless(f.read_text())
        found = re.findall(r'\burl\s*=\s*"([^"]+)"', text)
        for block in re.findall(r'\burls\s*=\s*\[(.*?)\]', text, re.S):
            found += re.findall(r'"([^"]+)"', block)
        for url in found:
            if not re.match(r"https?://", url):
                continue
            seen += 1
            if not any(re.search(p, url) for p in pinned) or impossible_stamp(url):
                wrong.append(f"{f.relative_to(root)}: {url}")

    floor(seen, 5, "download addresses under nix/")

    # PARSED: the pins file is JSON, a table of pins per kind.
    pins = json.load(open("${../assets/distro-pins.json}"))
    apk = r"_\d+\.apk$"
    pinned_files = 0
    for kind in ("appimage", "android"):
        for id_, pin in sorted(pins.get(kind, {}).items()):
            pinned_files += 1
            url = pin.get("url", "")
            if not any(re.search(p, url) for p in pinned + ([apk] if kind == "android" else [])):
                wrong.append(f"assets/distro-pins.json: `{id_}`: {url}")
    if wrong:
        print("ERROR: these downloads name no version, commit or capture (or a", file=sys.stderr)
        print("      capture stamp that is no moment, such as 99999999999999):", file=sys.stderr)
        for w in wrong:
            print("  " + w, file=sys.stderr)
        print("      An address that serves new bytes under the same name breaks the", file=sys.stderr)
        print("      pinned hash the first time the store copy is collected. Point it at", file=sys.stderr)
        print("      a versioned release, or at a capture — see `snapshot` in nix/atlas.nix.", file=sys.stderr)
        sys.exit(1)
    print(f"OK: {seen} download addresses under nix/ and {pinned_files} in the distro's pins, every one pinned")
    END
  '';

  keyboard-layout-exists = mkCheck "keyboard-layout-exists" [ ] ''
    lst=${pkgs.xkeyboard_config}/share/X11/xkb/rules/base.lst
    layout=${keyboard.layout}
    optionName=${keyboard.options}
    variantName="${keyboard.variant}"

    grep -qE "^ +$layout +" "$lst" || {
      echo "ERROR: the layout \`$layout\` does not exist in xkeyboard-config." >&2
      echo "      xkb does NOT refuse: it falls back to \`us\` and the whole keyboard" >&2
      echo "      starts typing something else, with no error at all." >&2
      exit 1; }

    # ONE BY ONE, and there is more than one now.
    #
    # `options` is a comma-separated LIST, and this used to grep the whole
    # string as if it were a single name — which worked only for as long as
    # there was exactly one option. The day a second was added, the check would
    # have failed on a correct config, which is the other half of the same
    # defect: a check that cannot see is as bad as no check.
    for o in $(echo "$optionName" | tr ',' ' '); do
      grep -qE "^ +$o +" "$lst" || {
        echo "ERROR: the option \`$o\` does not exist in xkeyboard-config." >&2
        echo "      xkb does NOT refuse it: it IGNORES the option and carries on," >&2
        echo "      so the accents simply do not happen, with no error." >&2
        exit 1; }
    done

    if [ -n "$variantName" ]; then
      grep -qE "^ +$variantName +$layout:" "$lst" || {
        echo "ERROR: the variant \`$variantName\` does not exist for \`$layout\`." >&2
        exit 1; }
    fi

    # And the CONSOLE's keymap, which is another database (kbd, not xkb). The
    # installer runs on a TTY: a wrong name here gives a US keyboard at the moment
    # of typing the disk's passphrase.
    test -e ${pkgs.kbd}/share/keymaps/i386/qwerty/${keyboard.console}.map.gz || {
      echo "ERROR: the console keymap \`${keyboard.console}\` does not exist in kbd." >&2
      exit 1; }

    echo "OK: layout $layout, option $optionName, console ${keyboard.console}"
  '';

  # AND THE OPTIONS DO WHAT THEIR NAMES PROMISE — the keymap, compiled.
  #
  # # Why existing is not enough
  #
  # The check above proves the names are in the database. It does not prove they
  # produce anything: an option xkb does not recognise is **ignored, and the
  # exit status is zero** — measured, with `compose:naoexiste`, which compiles
  # fine and merely writes "Unrecognized RMLVO option ... was ignored" to
  # stderr. The symptom is the accent key that types nothing, on a keyboard that
  # is otherwise perfect.
  #
  # So this compiles the real keymap out of the real database and reads the
  # symbols back:
  #
  #   - `<CAPS>` has to carry `Multi_key`, which IS Compose. Without it, the
  #     British layout reaches dead `^` and `` ` `` and nothing else — no `á`,
  #     no `ã`, no `ç`, which is half of Portuguese;
  #   - both Shifts have to carry `Caps_Lock` on their second level. That is
  #     where Caps Lock went when Compose took its place, and it is the only way
  #     back to it.
  #
  # `xkbcli` and not `setxkbmap`: the second one needs an X server, and this
  # is a check.
  keyboard-options-do-what-they-say =
    mkCheck "keyboard-options-do-what-they-say"
      [
        pkgs.libxkbcommon
        pkgs.gnugrep
      ]
      ''
        export XKB_CONFIG_ROOT=${pkgs.xkeyboard_config}/share/X11/xkb

        xkbcli compile-keymap \
          --layout ${keyboard.layout} \
          ${lib.optionalString (keyboard.variant != "") "--variant ${keyboard.variant} "}\
          --options "${keyboard.options}" > keymap.xkb 2> errors.txt || {
            echo "ERROR: the keymap did not even compile:" >&2; cat errors.txt >&2; exit 1; }

        # The ignored-option message, which is the silent failure by name.
        if grep -q "was ignored" errors.txt; then
          echo "ERROR: xkb IGNORED an option and carried on:" >&2
          cat errors.txt >&2
          exit 1
        fi

        # Compose, wherever the answer put it — the symbol is what matters, and
        # not which key carries it.
        grep -q "Multi_key" keymap.xkb || {
          echo "ERROR: no key became Compose (\`Multi_key\`) in the keymap." >&2
          echo "      Without it there is no \`a\`, \`a~\` or \`c,\` on this keyboard." >&2
          exit 1; }

        # And Caps Lock, which left the Caps Lock key and has to be somewhere.
        for side in LFSH RTSH; do
          grep -A 3 "key <$side>" keymap.xkb | grep -q "Caps_Lock" || {
          echo "ERROR: Shift <$side> does not toggle Caps Lock." >&2
            echo "      The Caps key became Compose; without both Shifts, Caps" >&2
          echo "      Lock stopped existing and nobody was told." >&2
            grep -A 3 "key <$side>" keymap.xkb >&2
            exit 1; }
        done

        echo "OK: Compose exists in the keymap and both Shifts toggle Caps Lock"
      '';

  # AND A MODIFIER THE HOST LEAVES STUCK CANNOT TAKE THE NESTED LOOP AWAY.
  #
  # # What this is defending against, and why it cannot be repaired
  #
  # `nix run .#dev` runs the compositor as a WINDOW of another compositor,
  # sharing one keyboard with it. When the host keeps a chord for itself and
  # takes the focus away with it — `Super+Ctrl+Space` opens the wallpaper
  # manager on the machine this was found on — a nested compositor that
  # DERIVES its modifier state by counting presses against releases sees the
  # modifier go down and never sees it come up.
  #
  # A modifier stuck that way is stuck for good. libxkbcommon keeps one filter
  # per pressed key with a reference count, so pressing it again and letting go
  # takes the count 1 → 2 → 1, and reloading the keymap replays the keys the
  # compositor still believes are down. And a bind's modifiers are matched by
  # EQUALITY, so one stray bit kills every bind in the session — the leader
  # included. The only cure is restarting the compositor.
  #
  # `nix/keyboard-nested.nix` carries the reading that says this compositor
  # does NOT derive that state, and the one gesture that would decide it.
  #
  # So the keymap is the only lever, and Super is the only modifier the nested
  # loop can spare: it belongs to the host in there and reaches no bind of
  # ours. `nix/keyboard-nested.nix` cuts it out.
  #
  # # Why the check reads the GENERATED config
  #
  # The derivation guards its own surgery. What it cannot guard is being
  # WIRED IN: drop the `file` line from `nix/dev.nix` and the keymap is not
  # even built, every guard in it goes unrun, and the loop goes back to being
  # poisonable with nothing failing anywhere.
  #
  # It reads BOTH configs because the danger runs both ways. In production the compositor
  # owns the seat, nothing gets between the keyboard and the compositor, and
  # Super IS the leader (`nix/modules/keyboard.nix`) — a keymap without it
  # there would take the leader away from the whole system.
  nested-survives-a-stray-modifier =
    mkCheck "nested-survives-a-stray-modifier"
      [
        pkgs.libxkbcommon
        pkgs.gnugrep
        pkgs.xkeyboard_config
      ]
      ''
        export XKB_CONFIG_ROOT=${pkgs.xkeyboard_config}/share/X11/xkb

        nested=${devApp.config}
        production="${self.nixosConfigurations.vm.config.environment.etc."scroll/config".source}"

        # THE NESTED CONFIG POINTS AT A KEYMAP OF OURS.
        # `|| true`: `mkCheck` runs under `set -euo pipefail`, so a grep that
        # finds nothing takes the whole script down AT THE ASSIGNMENT — and the
        # sentence below, which is the entire point of the check, never prints.
        # Measured: the first version of this failed with an empty log.
        keymap=$(grep -oP '^\s*xkb_file "\K[^"]+' "$nested" | head -1 || true)
        if [ -z "$keymap" ]; then
          echo "ERROR: the nested config has no \`xkb_file\`, so the nested" >&2
          echo "      compositor is back on the stock keymap — the one where a" >&2
          echo "      chord the HOST swallows can leave Super stuck and take every" >&2
          echo "      bind in the session with it, until the compositor is restarted." >&2
          exit 1
        fi
        test -e "$keymap" || {
          echo "ERROR: the nested config points at \`$keymap\`, which is not there." >&2
          echo "      the compositor answers a keymap it cannot read with a warning in a log" >&2
          echo "      and a silent fall back to the layout WITH Super." >&2
          exit 1; }

        # AND THAT KEYMAP GIVES SUPER TO NO KEY. Asked of the compiled keymap
        # rather than of its spelling: `--modmaps` says what every key
        # contributes, and the section about KEYS is the one that matters —
        # the header above it names every modifier the format knows, Mod4
        # included.
        keys_of() {
          xkbcli compile-keymap --input-format 1 --keymap "$1" --modmaps \
            | sed -n '/Keys modifier maps/,$p'
        }
        if keys_of "$keymap" | grep -qE "Mod4|Super"; then
          echo "ERROR: a key still carries Super in the nested keymap:" >&2
          keys_of "$keymap" | grep -B 2 -E "Mod4|Super" >&2
          exit 1
        fi

        # AND THE REST OF THE KEYBOARD SURVIVED. A cut that also took Shift or
        # Control would leave the leader working and the typing broken, which
        # is the half nobody would look at.
        for real in Shift Control Mod1 Mod5; do
          keys_of "$keymap" | grep -q "real: *$real" || {
            echo "ERROR: no key carries \`$real\` in the nested keymap." >&2
            echo "      Cutting Super took a modifier the loop types with." >&2
            exit 1; }
        done

        # PRODUCTION KEEPS ITS SUPER, and this is the direction that would go
        # unnoticed: there Super IS the leader, and a keymap without it would
        # take the command list away from the whole system.
        if grep -qE '^\s*file "' "$production"; then
          echo "ERROR: the production config carries an \`xkb { file }\`." >&2
          echo "      The nested loop's keymap has no Super, and Super is what" >&2
          echo "      the leader IS in production." >&2
          exit 1
        fi
        xkbcli compile-keymap \
          --output-format 1 \
          --layout ${keyboard.layout} \
          ${lib.optionalString (keyboard.variant != "") "--variant ${keyboard.variant} "}\
          --options "${keyboard.options}" > production.xkb
        keys_of production.xkb | grep -q "Mod4" || {
          echo "ERROR: the production keyboard has no Super either. The layout" >&2
          echo "      itself lost it, so the two configs agree and both are wrong." >&2
          exit 1; }

        # AND THE LEADER ANSWERS A SHIFT NOBODY PRESSED.
        #
        # The keymap covers Super; Ctrl and Alt are inside the chord, so they
        # cannot change its outcome. That leaves Shift, and one extra bind
        # covers it: with a Shift stuck, the same `Ctrl+Alt+Space` reaches the
        # compositor as `Ctrl+Shift+Alt+space`. Measured on two nested
        # compositor instances — without the line the leader is dead, with it
        # it fires.
        #
        # It compares the ACTIONS and not just the keys: a variant pointing at
        # something else would be a second leader that does not lead.
        # THE COMMAND A BIND RUNS, by the key it is bound to.
        #
        # `bindsym [--flag…] <key> <command…>`: the flags are optional and the
        # command is everything after the key, so the key is matched as a WORD
        # between them rather than at the start of the line.
        #
        # AND THE KEY IS `space`, lowercase. A bind matches a KEYSYM, and the
        # keysym is `space` — `Space` is not one, so the bind would simply
        # never fire. The same rule put `Ctrl+Alt+l` in the emergency binds.
        action_of() {
          grep -E "^[[:space:]]*bindsym( --[a-z-]+)* $1 " "$nested" \
            | head -1 \
            | sed -E "s/^[[:space:]]*bindsym( --[a-z-]+)* $1 //"
        }
        plain=$(action_of 'Ctrl\+Alt\+space' || true)
        shifted=$(action_of 'Ctrl\+Shift\+Alt\+space' || true)
        if [ -z "$plain" ]; then
          echo "ERROR: the nested config has no \`Ctrl+Alt+space\` leader at all." >&2
          exit 1
        fi
        if [ "$shifted" != "$plain" ]; then
          echo "ERROR: the nested leader does not answer a stray Shift." >&2
          echo "      the compositor matches modifiers by EQUALITY, so a chord survives only" >&2
          echo "      the modifiers already inside it. A host chord holding Shift" >&2
          echo "      leaves it stuck in here for the rest of the session, and then" >&2
          echo "      \`Ctrl+Alt+Space\` arrives as \`Ctrl+Shift+Alt+Space\` and matches" >&2
          echo "      nothing." >&2
          echo "      wanted: $plain" >&2
          echo "      found:  ''${shifted:-<no such bind>}" >&2
          exit 1
        fi

        echo "OK: no Super in the nested keymap, Super intact in production,"
        echo "    and the leader answers a stray Shift"
      '';

  # THE INSTALLER'S DEFAULTS ARE THE SYSTEM'S DEFAULTS.
  #
  # `ronoctua-installer` carries `DEFAULT_LAYOUT` and `DEFAULT_COMPOSE` as Rust
  # constants — it has to, because it runs from a TTY on the ISO with no flake
  # to evaluate. That makes them a SECOND copy of `nix/keyboard-xkb.nix`, and
  # the two agreeing has been a matter of whoever edited remembering the other.
  #
  # What divergence looks like: a machine installed by pressing Enter through
  # the questions and a machine built by `nix build .#noctua` type differently.
  # Nothing fails; the person just finds out the day they need an accent.
  #
  # AND `CAPS_TOGGLE`, what the system adds whatever the answer: the Compose
  # question's help names the keys of the default and of this option
  # (`COMPOSE_HELP_KEYS`), so the help says what the system does only while the
  # two agree.
  installer-defaults-match-the-keyboard =
    mkCheck "installer-defaults-match-the-keyboard" [ pkgs.gnugrep ]
      ''
        src=${../crates/ronoctua-installer/src}/model.rs
        failed=0

        agree() {
          wanted="$2"
          found=$(grep -oP "pub const $1: &str = \"\K[^\"]*" "$src" | head -1)
          [ "$found" = "$wanted" ] || {
            echo "ERROR: $1 is \`$found\` in the installer and \`$wanted\` in the Nix." >&2
            failed=1
          }
        }
        agree DEFAULT_LAYOUT "${keyboard.layout}"
        agree DEFAULT_COMPOSE "${keyboard.compose}"
        agree CAPS_TOGGLE "${lib.concatStringsSep "," keyboard.always}"

        [ "$failed" = 0 ] || exit 1
        echo "OK: the installer and nix/keyboard-xkb.nix agree"
      '';

  # THE ISO'S BANNER SAYS THE COMMANDS ONCE PER LANGUAGE.
  #
  # The banner after the ISO's login is written by hand, one block per
  # declared language (`nix/installer/iso.nix`): the language is asked inside
  # the installer, so on that screen it does not exist yet. A sweep into
  # English once turned the pt-BR block into a second copy of the English one,
  # and the banner said the same thing twice — nothing failed.
  #
  # Read from the EVALUATED banner, not from the file: what the person sees is
  # `users.motd`. The blocks naming the installer are counted against
  # `languages.nix` (a language declared without its block is the same gap)
  # and must all differ. The rule is run first on two planted banners, the old
  # duplicated one and one with a language missing, which it must refuse.
  installer-banner-has-each-language-once =
    mkCheck "installer-banner-has-each-language-once" [ pkgs.python3 ]
      ''
        python3 - <<'PY'
        import sys

        def wrong_of(motd, languages):
            blocks = [b.strip() for b in motd.split("\n\n") if "ronoctua-install" in b]
            said = []
            if len(blocks) != len(languages):
                said.append(f"{len(blocks)} blocks name the installer, and "
                            f"{len(languages)} languages are declared ({', '.join(languages)})")
            for i, b in enumerate(blocks):
                if b in blocks[:i]:
                    said.append("a block is a copy of an earlier one:\n" + b)
            return said

        languages = ${builtins.toJSON languages}
        twice = "\n\nronoctua-distro\n\nTo install: ronoctua-install --execute\n\nTo install: ronoctua-install --execute\n"
        once = "\n\nronoctua-distro\n\nTo install: ronoctua-install --execute\n"
        if len(languages) < 2:
            print("ERROR: fewer than two languages declared; the planted banners prove nothing.",
                  file=sys.stderr)
            raise SystemExit(1)
        for planted in (twice, once):
            if not wrong_of(planted, languages):
                print("ERROR: the rule takes a planted banner it exists to refuse:\n" + planted,
                      file=sys.stderr)
                raise SystemExit(1)

        wrong = wrong_of(${builtins.toJSON self.nixosConfigurations.installer.config.users.motd}, languages)
        if wrong:
            print("ERROR: the ISO's banner does not say the commands once per language.",
                  file=sys.stderr)
            for w in wrong:
                print("       " + w, file=sys.stderr)
            print("       nix/installer/iso.nix writes one block per language of", file=sys.stderr)
            print("       assets/i18n/languages.nix, each in its own language.", file=sys.stderr)
            raise SystemExit(1)
        print(f"OK: the ISO's banner names the installer once in each of {len(languages)} languages")
        PY
      '';

  # EVERY COMPOSITOR COMMAND HAS A TRANSLATION IN EVERY LANGUAGE.
  #
  # The list is DECLARED in `assets/compositor-deeds.nix` and the sentences are
  # written by hand, so the two move separately: a row added there without a
  # sentence here would show up in the finder as `[cmd-wm-…]` — the
  # missing-key marker, in the middle of a long list, where nobody looks.
  #
  # AND THE PRESSURE CHANGED OWNER, which is worth saying out loud. It used to
  # come from upstream: the list was mirrored from a compositor's own help
  # text, so a version bump forced the translations. Now the list is ours, and
  # THIS CHECK is the only thing that forces them.
  compositor-deeds-translated = mkCheck "compositor-deeds-translated" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import re, sys, pathlib
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a generated table of rows against a catalogue of sentences.
    # Neither has a function in it.
    #
    # `uncommented`, because the key IS the string literal being read out, and
    # `hashless` on the `.ftl`, whose comment is `#`.
    table_src = uncommented(pathlib.Path("${compositorDeeds}/deeds.rs").read_text())
    key_names = re.findall(r'key: "(cmd-wm-[a-z0-9-]+)"', table_src)
    floor(len(key_names), 40, "deeds in the generated table")

    absent = []
    for language in ${builtins.toJSON languages}:
        ftl = hashless(pathlib.Path("${texts}/" + language + ".ftl").read_text())
        present = set(re.findall(r"^([a-z0-9-]+) *=", ftl, re.M))
        floor(len(present), 500, "keys declared by " + language)
        absent += [f"{language}: {c}" for c in key_names if c not in present]

    if absent:
        print("ERROR: a compositor command with no translation:", file=sys.stderr)
        for f in absent:
            print(f"  {f}", file=sys.stderr)
        print(
            "\nThe list is declared in assets/compositor-deeds.nix. A row added\n"
            "there needs a sentence in every .ftl — otherwise it shows up as\n"
            "`[key]` in the finder, and this check is the only thing asking.",
            file=sys.stderr,
        )
        sys.exit(1)
    print(f"OK: the {len(key_names)} compositor commands are in every language")
    PY
  '';

  # THE SUBMENU MARK DOES NOT LIVE IN THE TRANSLATION.
  #
  # It used to: `group-window = +window`, and the `+` was part of the text. That
  # is why three of the six groups ended up without it — nothing forced it, and
  # the omission showed up nowhere. Now whoever puts the `+` on is the drawing,
  # out of the tree's `is_group`, and no group has any way of escaping.
  #
  # This check stops it from coming back: a `+` in the .ftl would give `++window`
  # on screen, which is the loud symptom of a mark in two places.
  group-mark-outside-translation = mkCheck "group-mark-outside-translation" [ ] ''
    if grep -nE '^group-[a-z-]+ *= *\+' ${texts}/*.ftl; then
      echo "ERROR: there is a group label with a \`+\` in the translation." >&2
      echo "      The mark is put on in the DRAWING (surface::GROUP_MARK);" >&2
      echo "      written here, it comes out doubled — and only in some groups." >&2
      exit 1
    fi
    echo "OK: the submenu mark is in no translation"
  '';

  # And the other way round: a key in only one language BRINGS THE BUILD DOWN.
  # Without this fixture, the check above would pass with the generator broken.
  i18n-missing-key-fails = mkCheck "i18n-missing-key-fails" [ pkgs.python3 ] ''
    # ONE CRATE'S FRAGMENT, the foundation's, copied: its BASE language is the
    # victim, because it is the one every other is compared against — an
    # orphan there has to be caught whichever way the generator walks the list.
    cp -r ${texts.fragments.ronoctua-shell-kit} bad && chmod -R +w bad
    echo 'only-in-english = orphan' >> bad/${builtins.head languages}.ftl

    if python3 ${../nix/scripts/gen-i18n.py} $TMPDIR/texts \
      ${lib.escapeShellArgs languages} --fragment ronoctua-shell-kit=bad 2>errors.txt; then
      echo "ERROR: the generator ACCEPTED a key that exists in only one language" >&2
      exit 1
    fi
    grep -q 'only-in-english' errors.txt || {
      echo "ERROR: it failed, but the message does not say which key" >&2
      cat errors.txt >&2
      exit 1
    }
    echo "OK: a key in only one language takes the build down, saying which"
  '';

  # A TOKEN THAT DOES NOT EXIST DOES NOT COMPILE IN THE BUFFER — section 7.6.
  #
  # "The build generates (a) the shell's Rust table and (b) the WIT enum of valid
  # names. A token that does not exist becomes a **compile error in the guest**."
  #
  # Before, `color` was `record color { token: string }`: a buffer cited
  # `color.nonexistent`, compiled, and the host fell into a silent fallback —
  # the same class as invariant 8's `[api_key]`.
  #
  # # Why this check is STRUCTURAL, and not "compile and watch it fail"
  #
  # The guarantee does not come from a test: it comes from `color` being an ENUM.
  # Citing a case that does not exist in an enum is a compile error in Rust —
  # that is a property of the language, and failing it here would be testing rustc.
  #
  # What CAN break, and is therefore what is asserted: `color` going back to being
  # a record with a string, or the two generated artifacts diverging. Those are
  # the only two ways for the guarantee to be lost, and both are covered.
  invalid-token-fails-build = mkCheck "invalid-token-fails-build" [ pkgs.python3 ] ''
    wit=${wit}/deps/tokens/tokens.wit
    rs=${tokensRs}/tokens.rs

    # 1. `color` is an enum. If it goes back to being a record with a string, the guarantee is gone.
    grep -qE '^\s*enum color \{' "$wit" || {
      echo "ERROR: \`color\` is no longer an enum in the WIT." >&2
      echo "      With a free string, a token that does not exist compiles in the guest and" >&2
      echo "      fails silently on screen. See section 7.6." >&2
      exit 1
    }
    if grep -qE 'record color|token:\s*string' "$wit"; then
      echo "ERROR: \`color\` is carrying a string again." >&2
      exit 1
    fi

    # 2. The two generated artifacts have exactly the same set of names.
    #    A divergence here shows up as a wrong color, never as an error.
    python3 - "$wit" "$rs" <<'PY'
    import re, sys
    wit, rs = open(sys.argv[1]).read(), open(sys.argv[2]).read()

    block = re.search(r"enum color \{(.*?)\n    \}", wit, re.S).group(1)
    in_wit = {c.strip().lstrip("%").rstrip(",")
              for c in block.splitlines()
              if c.strip() and not c.strip().startswith("//")}

    in_rs = set(re.findall(r'"([a-z0-9-]+)" => color::', rs))

    only_wit, only_rs = in_wit - in_rs, in_rs - in_wit
    if only_wit or only_rs:
        for n in sorted(only_wit):
            print(f"ERROR: `{n}` is in the WIT and not in the Rust bridge", file=sys.stderr)
        for n in sorted(only_rs):
            print(f"ERROR: `{n}` is in the Rust bridge and not in the WIT", file=sys.stderr)
        raise SystemExit(1)
    print(f"OK: {len(in_wit)} colours, the same in both generated artefacts")

    # 2b. THE SAME, FOR `icon`.
    #
    # Colour has a hand-written bridge in the host, so a divergence there is a
    # human mistake. Icons were thought safe: the WIT enum and the Rust
    # constants came out of one dictionary, which is exactly why this went
    # unchecked — "same source, cannot diverge". Since 2026-10-12 they are two
    # generators: the WIT is written at evaluation from the NAMES
    # (`nix/token-names.nix`), and the Rust by `gen-tokens.py` from the glyph
    # table.
    #
    # A generator can still drop one side. And the symptom would be the `?`
    # glyph the host draws for an unknown token: visible only on the screen that
    # happens to use it, and looking like a font problem.
    #
    # AND NO BRAIN MODULE'S GLYPH IS IN EITHER. A mark is drawn from the
    # brain's catalogue, data the footer reads at run time
    # (`nix/brain-catalogue.nix`): a module's token in the host's table would
    # be compiled into every crate that draws, and in the WIT into every
    # buffer — so a person's module would rebuild them all. The modules'
    # tokens are named by the loader (`brainModules.glyphs`), and no
    # `brain_mark` answers them in the host any more.
    block = re.search(r"enum icon \{(.*?)\n    \}", wit, re.S)
    if block is None:
        print("ERROR: `icon` stopped being an enum in the WIT", file=sys.stderr)
        raise SystemExit(1)
    icon_wit = {c.strip().lstrip("%").rstrip(",")
                for c in block.group(1).splitlines()
                if c.strip() and not c.strip().startswith("//")}

    # `pub const SOME_NAME: &str` inside `pub mod icon`.
    mod_icon = re.search(r"pub mod icon \{(.*?)\n\}", rs, re.S)
    if mod_icon is None:
        print("ERROR: `pub mod icon` is gone from the generated Rust", file=sys.stderr)
        raise SystemExit(1)
    icon_rs = {n.lower().replace("_", "-")
               for n in re.findall(r"pub const ([A-Z0-9_]+):", mod_icon.group(1))}
    if "fn brain_mark" in mod_icon.group(1):
        print("ERROR: the host's table answers a brain module's glyph again (`icon::brain_mark`):"
              " a mark's glyph is the catalogue's, read at run time", file=sys.stderr)
        raise SystemExit(1)
    modules = set(${builtins.toJSON (builtins.attrNames brainModules.glyphs)})
    if len(modules) < 1:
        print("ERROR: no brain module declares a glyph, and the half below proves nothing", file=sys.stderr)
        raise SystemExit(1)
    for where, names in (("the WIT", icon_wit), ("the host's table", icon_rs)):
        for n in sorted(modules & names):
            print(f"ERROR: the brain module glyph `{n}` is in {where}: a person's module would rebuild it", file=sys.stderr)
        if modules & names:
            raise SystemExit(1)

    only_wit, only_rs = icon_wit - icon_rs, icon_rs - icon_wit
    if only_wit or only_rs:
        for n in sorted(only_wit):
            print(f"ERROR: the icon `{n}` is in the WIT and not in the Rust", file=sys.stderr)
        for n in sorted(only_rs):
            print(f"ERROR: the icon `{n}` is in the Rust and not in the WIT", file=sys.stderr)
        raise SystemExit(1)
    print(f"OK: {len(icon_wit)} icons, the same in both generated artefacts, and none of the {len(modules)} module glyphs in either")
    PY

    # 3. The host's bridge must have no default arm: `_ =>` has to give back
    #    `None`, and not a color. A `_ => TEXT_DIM` would bring the fallback back.
    if grep -qE '_ => color::' "$rs"; then
      echo "ERROR: the host's bridge has a fallback to a real colour." >&2
      echo "      An invalid name has to become \`None\`, not a pretty colour." >&2
      exit 1
    fi
  '';

  # NO SECRET IN THE TREE — section 9 of the prompt, invariant 13.
  #
  # "Add a check to `nix flake check` that fails if it detects secret patterns in
  # the repository." It is what holds up "the repository has to be publishable as
  # it is".
  #
  # It measures `self`, which already IS the source's path in the store —
  # measuring makes no new copy (unlike `${../.}`; see the AGENTS.md).
  secrets-out-of-repo = mkCheck "secrets-out-of-repo" [ pkgs.python3 ] ''
    python3 ${../nix/scripts/scan-secrets.py} ${self}
  '';

  # And the other way round: a planted secret BRINGS THE CHECK DOWN.
  #
  # Without this fixture, "the sweep works" would be an untested claim — and a
  # sweep that has never reported anything is indistinguishable from a broken one.
  # It covers the six forms, because one regex can die on its own.
  planted-secret-fails = mkCheck "planted-secret-fails" [ pkgs.python3 ] ''
    mkdir -p tree_out/sub

    # Assembled in pieces for the same reason as the script: written whole, this
    # file would report itself in the real sweep.
    printf -- '-----%s OPENSSH %s-----\n' BEGIN 'PRIVATE KEY' > tree_out/sub/id_ed25519
    printf 'u:%sy%sj9T%sFq3kL9mZx2pQvR7sT1uWn0%saBcDeFgHiJkLmNoPqRsTuVwXyZ01234\n' \
      "\$" "\$" "\$" "\$" > tree_out/sub/shadow
    printf 'AGE-SECRET-%s\n' 'KEY-1QQPQZRHW4YSHVMKS4YFPXP93KVMHJ2LPXPD9Y6MPQ7TCFVWXHXAS8RXNMV' \
      > tree_out/sub/api_key.txt
    printf 'token = "%sA1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8"\n' 'ghp_' > tree_out/sub/cfg.toml
    printf 'psk%s"WifiPassword12345"\n' '=' > tree_out/sub/wifi.conf
    printf 'maintainer = "someone.real%sprovider.com"\n' '@' > tree_out/sub/meta.nix

    if python3 ${../nix/scripts/scan-secrets.py} tree_out 2>errors.txt; then
      echo "ERROR: the scan did NOT report the planted secrets." >&2
      exit 1
    fi

    # Every form has to show up: one regex can break without the others.
    for shape in "private key" "password hash" "age key" \
                 "service token" "wifi PSK" "e-mail"; do
      grep -q "$shape" errors.txt || {
        echo "ERROR: the scan did not report: $shape" >&2
        cat errors.txt >&2
        exit 1
      }
    done

    # And the secret must NOT show up in the output: the CI log would publish it.
    if grep -qE 'A1b2C3d4|QQPQZRHW4|SenhaDoWifi' errors.txt; then
      echo "ERROR: the scan printed the secret itself." >&2
      exit 1
    fi

    echo "OK: all six shapes take the check down, and none leaks into the message"
  '';

  # Notifications, history and the proof that there is no second surface.
  notifyVm = import ./notify-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
  };

  # POWER: the daemons, the policies, the udev rule, the fallback from a
  # profile the machine does not offer, and no battery drawing nothing.
  # THE RADIO IN A VM: what a machine with NO controller can prove, which is
  # the bus's door, the module's one setting and the footer drawing nothing.
  # bluetoothd itself never starts here — its unit has a
  # `ConditionPathIsDirectory=/sys/class/bluetooth` — and the test says so.
  bluetoothVm = import ./bluetooth-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
    ronoctua = {
      inherit fonts fontconfigConf;
      inherit themes themed defaultTheme;
      inherit cursors;

      shell = rust.shell;
      iconSuperpack = self.packages.${system}.noctua-icon-theme;
    };
  };

  # THE NETWORK IN A VM: the two tunnels, the ports and the way out on a
  # machine with no radio. What it proves that nothing else can is the ONE
  # polkit rule — the owner starting and stopping Tor with no agent anywhere.
  networkVm = import ./network-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
    ronoctua = {
      inherit fonts fontconfigConf;
      inherit themes themed defaultTheme;
      inherit cursors;

      shell = rust.shell;
      # The agent and the boot's console, programs of their own.
      inherit (rust) networkConsole networkAgent;
      iconSuperpack = self.packages.${system}.noctua-icon-theme;
    };
  };

  # THE CAMERA STUDIO in a VM, with a camera that is nobody's hardware — a
  # loopback fed by `testsrc` — and every assertion made from outside the
  # screen: the preview memfd, `ffprobe`, a second reader of the virtual
  # camera, and `/proc` for who holds the device. And the person's login: the
  # session's own PipeWire and WirePlumber open no camera.
  cameraVm = import ./camera-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
    studio = rust.studio;
    # The modules' argument, as `powerVm` builds it: base.nix reads the
    # themes out of it.
    ronoctua = {
      inherit fonts fontconfigConf;
      inherit themes themed defaultTheme;
      inherit cursors;

      shell = rust.shell;
      iconSuperpack = self.packages.${system}.noctua-icon-theme;
    };
  };

  # THE PLAYER in a VM: every family of format through the decoder its table
  # names, the picture through the memfd, a second video in step, MPRIS over
  # `busctl`, and the column narrowing a window in the compositor's own tree.
  playerVm = import ./player-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
    player = rust.player;
  };

  # TWO MACHINES IN STEP: pairing by a code, the film over HTTP from the one
  # followed, and the follower within 80 ms — over a real network, with only
  # the Tailscale daemon's local API stood in for.
  playerRemoteVm = import ./player-remote-vm.nix {
    inherit pkgs lib;
    player = rust.player;
  };

  displayVm = import ./display-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
    # The modules' argument, as `oomVm` builds it: base.nix reads the fonts,
    # the themes and the shell out of it.
    ronoctua = {
      inherit fonts fontconfigConf;
      inherit themes themed defaultTheme;
      inherit cursors;

      shell = rust.shell;
      iconSuperpack = self.packages.${system}.noctua-icon-theme;
    };
  };

  powerVm = import ./power-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
    # The modules' argument, as `oomVm` builds it: base.nix reads the fonts,
    # the themes and the shell out of it.
    ronoctua = {
      inherit fonts fontconfigConf;
      inherit themes themed defaultTheme;
      inherit cursors;

      shell = rust.shell;
      iconSuperpack = self.packages.${system}.noctua-icon-theme;
    };
  };

  # THE 5 MS BUDGET of section 5.2, measured on the heaviest component.
  #
  # It was the glyph browser, which embedded the whole database (2.8 MB); the
  # three icon browsers are the native icons app now (`crate::icons`), whose
  # tables are read at run time, and the heaviest component left is the
  # brain's panel. The RISK this gate names stays: a buffer that embeds a table
  # again is what would blow the ceiling, and this is where it would show.
  #
  # Section 9.3 of the plan is explicit: instantiation is one of the metrics
  # INDEPENDENT of the GPU that the CI gates. It does not fall under the ban on
  # measuring performance under lavapipe, which is about rasterization.
  instance-fast = mkCheck "instance-fast" [ ] ''
    ${rust.bins.ronoctua-bench-instance}/bin/ronoctua-bench-instance \
      ${buffers.brain}/lib/ronoctua_buffer_brain.wasm 200
  '';

  # THE SYMBOL DATABASE IS GENERATED FROM THE REAL SOURCE FILE, like the glyph one.
  #
  # What it asserts beyond "the file exists": the total (the intersection of the
  # UCD with the `cmap`), and that the TWO fields only this buffer has arrived —
  # the `sample` of the combining marks and the `width` of the double-advance
  # ones. Without them the database looks whole and the screen lies on 325
  # characters.
  unicode-table-generated = mkCheck "unicode-table-generated" [ pkgs.jq ] ''
    db=${unicodedb.db}
    for f in unicode.json coverage.md; do
      [ -s "$db/$f" ] || { echo "ERROR: $f is missing or empty" >&2; exit 1; }
    done

    n=$(jq 'length' "$db/unicode.json")
    echo "characters in the database: $n"
    [ "$n" -gt 7000 ] || { echo "ERROR: the base came out too small ($n)" >&2; exit 1; }

    # THE MANDATORY FIELDS, in every record.
    jq -e 'all(.cp and .name and .shows and .family)' "$db/unicode.json" >/dev/null \
      || { echo "ERROR: a record with no cp, name, sample or family" >&2; exit 1; }

    # `mostra` IS A LIST OF NUMBERS, and not text.
    #
    # It is what stops the character from travelling as a string: for `U+0022` the
    # JSON would write `"\""` and the component's parser — which finds the end of a
    # value by looking for the next quote — would read `\`. Two wrong characters,
    # silently, and only on those two.
    jq -e 'all(.shows | type == "array" and all(type == "number"))' \
      "$db/unicode.json" >/dev/null \
      || { echo "ERROR: \`shows\` stopped being a list of codepoints" >&2; exit 1; }

    # NO string field carries punctuation that would break the `split`.
    #
    # The punctuation that actually breaks it: a quote (it cuts the value in half),
    # a brace and a comma (they split a record and a list) and a bracket (it
    # delimits a list). The `:` does NOT count — it separates nothing in the
    # component's parser, and `bandeira: Brasil` is a legitimate emoji name coming
    # from the CLDR.
    bads=$(jq '[.[] | to_entries[] | select(.value | type == "string")
                 | select(.value | test("[\"{},\\[\\]]"))] | length' "$db/unicode.json")
    [ "$bads" = 0 ] || {
      echo "ERROR: $bads string fields with JSON punctuation." >&2
      echo "      The component splits the records on \`},\` and has no parser." >&2
      exit 1; }

    combining=$(jq '[.[] | select(.width == 0)] | length' "$db/unicode.json")
    wide=$(jq '[.[] | select(.width == 2)] | length' "$db/unicode.json")
    echo "combining: $combining   double width: $wide"
    [ "$combining" -gt 100 ] || { echo "ERROR: the combining marks went away" >&2; exit 1; }
    [ "$wide" -gt 0 ] || { echo "ERROR: the double-width ones went away" >&2; exit 1; }

    echo "OK: symbol database generated from the real font, with sample and width"
  '';

  # THE UCD VERSION GUARD SPEAKS — the negative fixture.
  #
  # Without it the guard would be a promise, and the glyph one has already shown
  # that an unverified promise is the same thing as an absent guard.
  unicode-version-mismatch-fails = mkCheck "unicode-version-mismatch-fails" [ ] ''
    grep -q "the Unicode Character Database version diverged" \
      ${unicodedb.versionMismatchFails}/out_text.txt \
      || { echo "ERROR: the message does not say the versions diverge" >&2; exit 1; }
    echo "OK: a UCD of another version takes the build down, saying which"
  '';

  # THE LUCIDE DATABASE IS GENERATED FROM THE REAL SET, and the font along with it.
  #
  # What it asserts beyond "the file exists": the exact total, that BOTH
  # codepoints of each icon arrived (the drawing one and the origin one), and
  # that the two live in SEPARATE ranges. That separation is this buffer's whole
  # subject — see `nix/lucidegen.nix`.
  lucide-table-generated = mkCheck "lucide-table-generated" [ pkgs.jq ] ''
    db=${lucidedb.db}
    for f in lucide.json coverage.md NoctuaLucide.ttf; do
      [ -s "$db/$f" ] || { echo "ERROR: $f is missing or empty" >&2; exit 1; }
    done

    n=$(jq 'length' "$db/lucide.json")
    echo "icons in the database: $n"
    [ "$n" = 1668 ] || { echo "ERROR: the database has $n icons and should have 1668" >&2; exit 1; }

    jq -e 'all(.name and .cp and .lcp and .cats and .nodes)' "$db/lucide.json" >/dev/null \
      || { echo "ERROR: a record with no name, cp, lcp, cats or nos" >&2; exit 1; }

    # THE TWO CODEPOINTS ARE FROM DIFFERENT RANGES.
    #
    # `cp` draws and `lcp` is copied. If they are ever equal, the remapping is gone
    # — and with it the reason for the buffer not drawing 634 wrong icons.
    not_in=$(jq '[.[] | select(.cp < 991232 or .cp > 993667)] | length' "$db/lucide.json")
    [ "$not_in" = 0 ] || {
      echo "ERROR: $not_in icons draw outside U+F2000..U+F2683." >&2
      echo "      The source range collides with 634 Nerd Fonts codepoints." >&2
      exit 1; }
    merged=$(jq '[.[] | select(.cp == .lcp)] | length' "$db/lucide.json")
    [ "$merged" = 0 ] || { echo "ERROR: $merged icons with cp == lcp" >&2; exit 1; }

    # NO string field carries punctuation that would break the component's
    # `split`, which has no JSON parser (invariant 11). The `d` of the SVGs carries
    # a comma at the origin; the generator swaps it for a space, which the SVG
    # grammar treats the same.
    bads=$(jq '[.[] | to_entries[] | select(.value | type == "string")
                 | select(.value | test("[\"{},\\[\\]]"))] | length' "$db/lucide.json")
    [ "$bads" = 0 ] || {
      echo "ERROR: $bads string fields with JSON punctuation." >&2
      exit 1; }

    cats=$(jq '[.[].cats[]] | unique | length' "$db/lucide.json")
    [ "$cats" = 43 ] || { echo "ERROR: $cats categories, and 0.563.0 has 43" >&2; exit 1; }

    echo "OK: 1668 icons, 43 categories, drawing and source in separate ranges"
  '';

  # THE COLLISION GUARD SPEAKS — the negative fixture.
  #
  # It is not hypothetical: it is the measured defect. Without the guard, 634 of
  # the 1,668 icons would draw the Nerd Fonts glyph that occupies the same codepoint.
  lucide-range-taken-fails = mkCheck "lucide-range-taken-fails" [ ] ''
    grep -q "collides with 634 codepoints" ${lucidedb.rangeTakenFails}/out_text.txt \
      || { echo "ERROR: the message does not say how many codepoints collide" >&2; exit 1; }
    echo "OK: the source range takes the build down, saying how many collide"
  '';

  # THE CONSOLE FONT IS ONE THE KERNEL TAKES — and for as long as it existed it
  # was not: every console, the ISO's and every machine's, fell back to the
  # kernel's own font, and nothing said so but a line in the journal.
  #
  # Two rules, both the kernel's and neither the format's: the framebuffer
  # console takes 256 or 512 glyphs and answers any other count with
  # `KDFONTOP: Invalid argument` (the font had 498), and it erases a cell with
  # glyph POSITION 32 whatever the unicode table says a space is (`@` stood
  # there, and `setfont` said "background will look funny"). AND THE CELL IS
  # THE FACE'S LINE BOX: the height was taken for the em, and the letters came
  # out at 60% of their cell with their descenders cut — `█` filling its cell
  # and `▀` exactly its top half is what says the box and the cell are one.
  # And the font eight pixels wide — the VGA text console's — has 256 glyphs,
  # where VGA keeps sixteen colours. Measured on the files the machines load,
  # at both sizes; that the kernel then loads them is `installer-console-vm`'s.
  console-font-is-what-the-kernel-takes =
    mkCheck "console-font-is-what-the-kernel-takes" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import pathlib, struct, sys

        # PARSED: a PSF2 file, read field by field as the kernel and `setfont`
        # read it; there is no text in it for a comment to hide in.
        wrong = []
        fonts = sorted(pathlib.Path("${fonts.noctua-console-psf}/share/consolefonts").glob("*.psf"))
        if len(fonts) < 2:
            print(f"ERROR: {len(fonts)} console fonts; the sizes stopped being built", file=sys.stderr)
            raise SystemExit(1)
        for f in fonts:
            b = f.read_bytes()
            magic, version, header, flags, count, charsize, height, width = struct.unpack("<4sIIIIIII", b[:32])
            if magic != b"\x72\xb5\x4a\x86" or header != 32 or not flags & 1:
                wrong.append(f"{f.name}: not a PSF2 with a unicode table")
                continue
            if count not in (256, 512):
                wrong.append(f"{f.name}: {count} glyphs, and the console takes 256 or 512")
            # THE VGA TEXT CONSOLE'S FONT is the one eight pixels wide, and VGA
            # pays for a glyph's ninth bit with the bright half of the text's
            # colours: past 256, the terminal UIs' sixteen slots are eight.
            if width == 8 and count != 256:
                wrong.append(f"{f.name}: eight wide and {count} glyphs: VGA text would keep eight colours")
            if charsize != height * ((width + 7) // 8):
                wrong.append(f"{f.name}: {charsize} bytes a glyph for {width}x{height}")
            glyph = lambda i: b[header + i * charsize : header + (i + 1) * charsize]
            if any(glyph(32)):
                wrong.append(f"{f.name}: position 32, which erases a cell, is not blank")
            table = b[header + count * charsize :].split(b"\xff")
            entries = [e.decode("utf-8") for e in table[:count]]
            if len(entries) != count:
                wrong.append(f"{f.name}: {len(entries)} unicode entries for {count} glyphs")
                continue
            for c in range(0x20, 0x7F):
                if entries[c][:1] != chr(c):
                    wrong.append(f"{f.name}: position {c:#x} draws {entries[c][:1]!r}, not {chr(c)!r}")
            mapped = [cp for e in entries for cp in e]
            twice = sorted({cp for cp in mapped if mapped.count(cp) > 1})
            if twice:
                wrong.append(f"{f.name}: mapped to two glyphs: {[hex(ord(c)) for c in twice]}")
            if not any(glyph(ord("@"))):
                wrong.append(f"{f.name}: `@` is blank — the sweep is reading the wrong positions")
            def rows(cp):
                at = next((i for i, e in enumerate(entries) if chr(cp) in e), None)
                if at is None:
                    return None
                stride = (width + 7) // 8
                bits = int.from_bytes(glyph(at), "big")
                total = 8 * charsize
                return [
                    [bool(bits >> (total - 1 - (y * stride * 8 + x)) & 1) for x in range(width)]
                    for y in range(height)
                ]
            full, upper = rows(0x2588), rows(0x2580)
            if full is None or upper is None:
                wrong.append(f"{f.name}: no `█` or `▀` to measure the cell with")
            else:
                if not all(all(r) for r in full):
                    wrong.append(f"{f.name}: `█` leaves part of its {width}x{height} cell empty")
                half = height // 2
                if not (all(all(r) for r in upper[:half]) and not any(any(r) for r in upper[half:])):
                    wrong.append(f"{f.name}: `▀` is not the top half of its cell")
        if wrong:
            print("ERROR: a console font the kernel does not take as it is:", file=sys.stderr)
            for w in wrong:
                print("  " + w, file=sys.stderr)
            raise SystemExit(1)
        print(f"OK: {len(fonts)} console fonts of 256 or 512 glyphs, position 32 blank, ASCII at its own, the cell the face's line box")
        END
      '';

  # THE MARKS THIS REPOSITORY DRAWS — the fourth face, and the only one with no
  # upstream font behind it.
  #
  # WHY THE FACE EXISTS AT ALL. A mark the interface has to draw and that is in
  # none of the other faces meets two invariants at once: 10 says a UI icon is
  # a glyph and no design system component consults a pixmap, 9 says a
  # codepoint is a token resolved against a real cmap. Drawing it into a face
  # of ours is the only door left, and `nix/marksgen.nix` is it.
  #
  # WHAT THIS ASSERTS BEYOND "THE FILE EXISTS": that every mark declared
  # reached the cmap, that every mark is reached by a token, that each carries
  # the ADVANCE its neighbours carry, and that its ink fits inside a reference
  # icon's box. Both numbers are MEASURED here from the real font rather than
  # written down — see the comment beside them.
  marks-are-in-the-font = mkCheck "marks-are-in-the-font" [ pkgs.jq py ] ''
    db=${marksdb.db}
    for f in NoctuaMarks.ttf marks.json report.md; do
      [ -s "$db/$f" ] || { echo "ERROR: $f is missing or empty" >&2; exit 1; }
    done

    declared=$(jq 'length' ${pkgs.writeText "marks-declared.json" (builtins.toJSON (import ../assets/icons/marks.nix))})
    built=$(jq 'length' "$db/marks.json")
    [ "$declared" = "$built" ] || {
      echo "ERROR: $declared marks declared and $built in the face" >&2; exit 1; }

    # EVERY `ours-` TOKEN RESOLVED. The icon table is what the shell reads; a
    # mark that built but that no token reaches is a drawing nobody draws, and
    # a token naming a mark that does not exist already fails the generator.
    python3 - <<'PYEOF'
    import json, sys
    from fontTools.ttLib import TTFont
    from fontTools.pens.boundsPen import BoundsPen

    marks = json.load(open("${marksdb.db}/marks.json"))
    icons = json.load(open("${glyphdb.db}/icons.json"))
    font = TTFont("${marksdb.db}/NoctuaMarks.ttf", lazy=True)
    cmap, shapes = font.getBestCmap(), font.getGlyphSet()

    # THE BOX IS READ, NOT WRITTEN DOWN.
    #
    # It used to be `(0, 40, 600, 640)` typed here as well as copied by the
    # generator — a second truth, and the wrong one: measured over the 6896
    # `md-` glyphs of the built face there are 747 distinct ink boxes and that
    # one is on 1992 of them. What IS constant is the advance, 600 for every
    # one. So the reference is measured here too, and the rule is: the advance
    # matches and the ink fits INSIDE.
    nerd = TTFont(
        "${fonts.corrected}/TTF-nerdfonts/NoctuaIosevkaNerdFontMono-Regular.ttf",
        lazy=True,
    )
    nerd_cmap, nerd_shapes = nerd.getBestCmap(), nerd.getGlyphSet()
    reference = nerd_cmap[int("${marksdb.reference}", 16)]
    pen = BoundsPen(nerd_shapes)
    nerd_shapes[reference].draw(pen)
    BOX = tuple(round(v) for v in pen.bounds)
    ADVANCE = int(nerd_shapes[reference].width)

    bad = []
    ours = {t: v for t, v in icons.items() if v["glyph"].startswith("ours-")}
    if not ours:
        sys.exit("ERROR: no icon token reaches a mark; the face draws for nobody")

    # AND EVERY MARK IS REACHED, not just some mark by some token. The first
    # version asked only whether the set was non-empty, so a second mark that
    # nothing drew would have passed the very guard whose comment forbids it.
    drawn = {v["glyph"][len("ours-"):] for v in ours.values()}
    for orphan in sorted(set(marks) - drawn):
        bad.append(f"the face draws `{orphan}` and no icon token reaches it")

    for token, entry in sorted(ours.items()):
        name = entry["glyph"][len("ours-"):]
        if name not in marks:
            bad.append(f"icon.{token} -> {entry['glyph']}, which the face does not hold")
            continue
        if entry["codepoint"] != marks[name]["codepoint"]:
            bad.append(f"icon.{token} points at U+{entry['codepoint']:05X} and the face says "
                       f"U+{marks[name]['codepoint']:05X}")
            continue
        if entry["codepoint"] not in cmap:
            bad.append(f"icon.{token} is not in the face's cmap")
            continue
        pen = BoundsPen(shapes)
        glyph = shapes[cmap[entry["codepoint"]]]
        glyph.draw(pen)
        got = tuple(round(v) for v in pen.bounds)
        if not (got[0] >= BOX[0] and got[1] >= BOX[1] and got[2] <= BOX[2] and got[3] <= BOX[3]):
            bad.append(f"icon.{token} draws at {got}, outside {reference}'s box {BOX}")
        if int(glyph.width) != ADVANCE:
            bad.append(f"icon.{token} advances {glyph.width} and every icon advances {ADVANCE}")

    if bad:
        print("ERROR: the marks do not match the icons they sit beside:", file=sys.stderr)
        for line in bad:
            print(f"       {line}", file=sys.stderr)
        sys.exit(1)
    print(f"OK: {len(ours)} mark(s) drawn here, in the icons' own box {BOX}")
    PYEOF
  '';

  # THE COLLISION GUARD SPEAKS, for the marks face — the negative fixture.
  #
  # The same defect Lucide's fixture is about, and the reason the range is
  # `U+F3000` and not something convenient: the face asked for by name beats
  # the fallback chain, so a mark sharing a codepoint with a Nerd Fonts glyph
  # comes out drawn as ANOTHER icon. Not tofu, which one sees — a pretty and
  # wrong drawing, which nobody catches by looking.
  marks-range-taken-fails = mkCheck "marks-range-taken-fails" [ ] ''
    grep -q "collides with" ${marksdb.rangeTakenFails}/out_text.txt       || { echo "ERROR: the message does not say the range collides" >&2; exit 1; }
    echo "OK: a taken range takes the build down, saying which face answers for it"
  '';

  # THE PANEL ANSWERS THE HOST — driven on the real component.
  #
  # The three sibling drivers exercise buffers that carry their own database.
  # This one is the first whose screen is EMPTY until the host speaks: the
  # survey crosses the WIT as a record with lists inside, lowered field by
  # field, and `wasmtime` compares the field NAMES only after zipping them
  # positionally. A field out of order fails here, with a message, instead of
  # on somebody's screen.
  #
  # It also holds the two rules that make an irreversible key safe: one press
  # arms, another key disarms, the same key fires — and closing points at the
  # ROW of the last survey, never at a pid, because a scope has none.
  memory-driven = mkCheck "memory-driven" [ ] ''
    ${rust.bins.ronoctua-test-memory}/bin/ronoctua-test-memory \
      ${buffers.memory}/lib/ronoctua_buffer_memory.wasm \
      ${texts}
  '';

  # THE KEYBOARDS, DRIVEN — `LEADER s k`.
  #
  # Its screen is empty until the host speaks, so the record with three lists
  # inside crosses the WIT here rather than on somebody's machine. And one
  # thing is this buffer's alone: what it hands BACK. A remap carries three
  # strings, the host refuses any it did not send, and a component that built
  # one out of its own head would be a screen where the arrows do nothing at
  # all — no error, no message, nothing moving.
  #
  # It also walks the ring in BOTH directions, because the way back out of a
  # remap is the first choice and a ring that only goes forwards is a ring
  # somebody has to walk nine times to leave.
  keyboard-driven = mkCheck "keyboard-driven" [ ] ''
    ${rust.bins.ronoctua-test-keyboard}/bin/ronoctua-test-keyboard \
      ${buffers.keyboard}/lib/ronoctua_buffer_keyboard.wasm \
      ${texts}
  '';

  # AND THE ONE BUFFER WITH NO WIDTH CONSTANT OF ITS OWN.
  #
  # # What this catches
  #
  # A buffer cannot measure a sentence it does not have: it emits a KEY and the
  # host translates (invariant 11), so what it declares is what it RESERVED.
  # Seven of the eight write that reservation down as a constant a reader can
  # find. The brain does not: its widths are numbers inside four `Table`s
  # (`Column::fixed("label", 16, 2)`) and half its keys are ASSEMBLED at run
  # time — `brain-why-{}`, `brain-hold-{}`, `brain-standing-{}` — or ARRIVE
  # beside an id, like a step's name, which the step's module declared.
  # Nothing that reads this repository's source can pair one with the other.
  #
  # The FRAME can, because `Command::Text` carries the key and its `max_width`
  # side by side, already assembled. So this drives the panel through every
  # shape that draws a different family of key — idle, held, refused, running
  # with a warning, and the update's own page — and measures what came out
  # against both `.ftl` files, with the ruler the host CUTS with.
  #
  # It is also the second buffer whose screen is EMPTY until the host speaks,
  # and the `mind` is the largest record this system lowers: tasks with steps
  # with outcomes, three levels of list. A field out of order fails here.
  #
  # THE MODULES ARE THE ONES THE BRAIN REPORTS — `ronoctua-brain modules`, what
  # the binary compiled — now that every task is a module folder (the sealed
  # check's step 7): a module whose labels a language lacks is drawn and
  # caught. The steps it draws are the first compiled module's that has any,
  # with the keys that module declared.
  brain-driven = mkCheck "brain-driven" [ ] ''
    ${rust.bins.ronoctua-brain}/bin/ronoctua-brain modules > modules.txt
    ${rust.bins.ronoctua-test-brain}/bin/ronoctua-test-brain \
      ${buffers.brain}/lib/ronoctua_buffer_brain.wasm \
      ${texts} --modules modules.txt
  '';

  # AND ON THE FOURTH, which is the lightest of them: it embeds no database at
  # all, because every number it draws is pushed in at run time. The ceiling
  # here is loose on purpose — what it guards is a regression in the RUNTIME,
  # which would show up first on the component that has the least to load.
  memory-instance-fast = mkCheck "memory-instance-fast" [ ] ''
    ${rust.bins.ronoctua-bench-instance}/bin/ronoctua-bench-instance \
      ${buffers.memory}/lib/ronoctua_buffer_memory.wasm 200
  '';

  # AND ON THE FIFTH — the queue in a window, which embeds nothing either.
  #
  # What only this driver can prove: the cursor is an ID, and the list REORDERS
  # underneath it. The queue sorts what is afoot above what has finished, so a
  # job ending moves every row below it — and the key in question deletes the
  # piece already written at the destination. The reorder is simulated between
  # the frame and the key, which is the one place both sides of the WIT are
  # visible at once.
  transfers-driven = mkCheck "transfers-driven" [ ] ''
    ${rust.bins.ronoctua-test-transfers}/bin/ronoctua-test-transfers \
      ${buffers.transfers}/lib/ronoctua_buffer_transfers.wasm \
      ${texts}
  '';

  # THE MOUSE REACHES NOTHING THE KEYBOARD DOES NOT, and opens no surface.
  #
  # The footer had a pointer before this — the scrollbar, the file manager's
  # rows, the right-button menu — but only inside the EXPANDED region. Making
  # the modeline itself clickable is the change that invites invariant 14 back
  # in, so the check is written in the same commit as the feature rather than
  # after it.
  #
  # Two things, and each is a way for a mouse to become chrome:
  #
  #   1. every id the pointer acts on is one a KEY also reaches. Today that is
  #      `state`, and the two orders it sends — `state-next`, `state-prev` — are
  #      the same two `Esc`+arrow sends in `buffer.rs`. A click that ran anything
  #      else would be a door only the mouse has;
  #   2. NOTHING FLOATS. No `xdg_popup`, no second layer surface, no window
  #      created from a pointer path. The right-button menu already draws in the
  #      footer's own region for exactly this reason, and the comment there says
  #      so — this makes it true rather than intended.
  footer-mouse-reaches-nothing-new = mkCheck "footer-mouse-reaches-nothing-new" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())
    exec(open("${shellPrelude}").read())

    # FILE-WIDE: what a mark DOES is a command id written where that mark is
    # handled, and `enum Hit` is module-level in three files. `segment_clicked`
    # is narrowed by name below, and the three enums by `scope`.
    #
    # `uncommented` and never `code_of`: every needle here is a command id or a
    # mark id in a string literal. Emptying the strings would leave a check
    # that finds nothing and says so about nothing.
    root = pathlib.Path("${self}")
    def read(what):
        # A PATH, or a file of the shell by its name — or a module of it split
        # into files, the footer's (`shell_source`).
        if isinstance(what, pathlib.PurePath):
            text, name = uncommented(what.read_text()), what.name
        else:
            text, name = uncommented(shell_source(what)), what
        floor(len(text), 500, "characters of " + name)
        return text
    surface = read("surface.rs")
    buffer_host = read("buffer.rs")
    gaps = []

    # 1) WHAT A CLICK ON THE MODELINE CAN DO.
    # BY NAME AND BRACES. The signature was written out here, and the capture
    # ran to the next `\n    }` — which a nested block closes early, taking
    # everything after it out of reach.
    clicked = must(body_of(surface, "segment_clicked"), "`segment_clicked`")
    floor(len(clicked), 500, "characters of `segment_clicked`")
    orders = set(re.findall(r'"(state-next|state-prev)"', clicked))
    if orders != {"state-next", "state-prev"}:
        gaps.append("the click sends " + repr(sorted(orders)) + ", and not the keyboard's two")

    # The SAME two the keyboard produces, on the other side of the socket.
    from_keys = set(re.findall(r'"(state-next|state-prev)"', buffer_host))
    rotates = "EscapeAct::Rotate" in buffer_host
    if not rotates:
        gaps.append("the host's `Esc` no longer cycles: the click would be left alone")

    # AND NOTHING ELSE. Every segment that answers the mouse has a key that
    # does the same thing: `state` rotates (what holding `Esc` and an arrow
    # does), `notif` opens the manager (`LEADER n n`), `update` opens the
    # window that follows a run (`LEADER s u w`), `battery` and `profile` open
    # the power view (`LEADER s p p`), `net-off` and `vpn` open the network
    # (`LEADER s n n`), and `airplane` toggles it (`LEADER s n a`). One more
    # would be a door only the mouse knows about.
    #
    # EVERY COMPARISON OF `id`, and not only the one right after an `if`: an
    # `id == "camera" || id == "recording"` hid its second id from a pattern
    # that wanted the `if`, and a mark nobody named went through unasked.
    acted = set(re.findall(r'\bid\s*[!=]=\s*"([a-z-]+)"', clicked))
    agreed = {
        "state", "notif", "update", "battery", "profile",
        # THE WAY OUT'S THREE MARKS AND THE TWO TUNNELS THAT ARE NOT NM'S.
        # Each opens the view on its own row, and the aeroplane toggles.
        "net-off", "airplane", "vpn", "tailscale", "tor",
        # AND SOUND'S TWO. Both run `audio-open`, which is what `LEADER s a a`
        # runs — the mouse reaches no door the keyboard lacks.
        "muted", "microphone",
        # AND SYNCTHING'S ONE. It runs `syncthing-open`, which is `LEADER s s s`.
        # It is also the only mark in the system whose very EXISTENCE is a
        # preference — see `ronoctua_syncthing::prefs::Mark` — and that changes
        # nothing here: a mark that is drawn is a mark that can be clicked, and
        # what it does has to be a door the keyboard already has.
        "syncthing",
        # AND THE TWO THAT SYNC WHAT THIS MACHINE HOLDS. `clip` runs
        # `clipboard-open`, which is `LEADER c`; `history` runs `atuin-open`,
        # which is `LEADER s h h`. Both marks are a ring the owner chooses
        # (`Never`/`WhenOff`/`WhenOn`), like Syncthing's, and for the same
        # reason that changes nothing here.
        "clip", "history",
        # AND THREE THAT ANSWERED THE CLICK BEFORE THIS LIST NAMED THEM, each a
        # door the keyboard has: `camera` runs `camera-settings-open`
        # (`LEADER s c c`), `compositor-mode` leaves the mode, which is the
        # mode's own `Esc`, and `player` is the player's PAIR — one segment,
        # two glyphs told apart by `player_mark::zone_at`: play/pause runs
        # `player-toggle` (`LEADER p t`) and its right button `player-column`
        # (`LEADER p c`, the column opened or closed), next runs `player-next`
        # (`LEADER p n`) and opens the view, `player-open` (`LEADER p p`).
        "camera", "player", "compositor-mode",
        # AND THE SOFTWARE VIEW'S TWO, each a door the keyboard has:
        # `software-trial` runs `software-trials` (`LEADER i t`) and
        # `software-android` runs `software-android` (`LEADER i a`).
        "software-trial", "software-android",
        # AND THE WINDOW'S FOUR (9ab8042), each a door the keyboard has:
        # `mode` (the app's name) runs `window-menu`, `LEADER w o`, and
        # `LEADER w` IS that menu, generated from it; `drawer`, `trail` and
        # `selection` open the menu at their level, and under the leader those
        # levels are the groups `w g`, `w y` and `w v`. The drawer's right
        # button runs `wm-scratchpad-show`, the compositor's own chord.
        "mode", "drawer", "trail", "selection",
        # AND THE GESTURES' ONE (05658b0): it runs `gestures`, `LEADER m g`.
        "gestures",
        # AND THE CAMERA'S SECOND, the recording: `camera-settings-open`, the
        # camera's own door, `LEADER s c c`.
        "recording",
        # AND THE SCREEN RESIZER'S: it runs `dev-resizer`, `LEADER / r`, which
        # gives the screen back whole.
        "resizer",
        # AND THE PASSWORDLESS WINDOW'S END: it runs `security-open admin`,
        # `LEADER s e e` on the administrator's section, where it ends.
        "security-until",
    }
    if acted != agreed:
        gaps.append(
            "the click acts on " + repr(sorted(acted)) + ", outside " + repr(sorted(agreed))
        )
    if '"notif-open"' not in clicked:
        gaps.append("clicking the bell does not open the manager")
    # AND THE TWO NEW ONES REACH THE KEYBOARD'S OWN COMMANDS, by name: being
    # in the set above says a mark may be clicked, and this says WHAT it does.
    for mark, command in (("clip", "clipboard-open"), ("history", "atuin-open")):
        if f'"{command}"' not in clicked:
            gaps.append(f"clicking `{mark}` does not run `{command}`")
    # THE BATTERY AND THE PROFILE open the power view — `LEADER s p p`'s own
    # command, so the mouse reaches no door the keyboard lacks.
    if clicked.count('"power-open"') < 2:
        gaps.append("clicking the battery or the profile does not open the power view")
    # THE SAME, FOR SOUND: silence and the microphone each open `LEADER s a a`.
    if clicked.count('"audio-open"') < 2:
        gaps.append("clicking the mute mark or the microphone does not open the sound view")
    # AND SYNCTHING'S, which is ONE mark and therefore one call. The keyboard
    # reaches the same door at `LEADER s s s`, and the `keymap` read below is
    # what says that door exists there too.
    if '"syncthing-open"' not in clicked:
        gaps.append("clicking the syncthing mark does not open its view")
    # THE UPDATE'S MARK, and BOTH halves of it.
    #
    # The mark only exists while something is running, so a click is the
    # obvious way to reach the window and the tempting place to stop. The key
    # is what makes it reachable at three in the morning when nothing is
    # running — which is exactly when somebody wants to read what happened.
    #
    # The update's commands are its window's (`update_window::COMMANDS`,
    # `BINDINGS`), and neither the footer nor the leader spells their ids: the
    # click runs the window's `WATCH`, and that same `WATCH` has a key in the
    # window's table, which the update's contribution takes whole.
    #
    # THE KEYMAP IS EVERY FILE THAT SAYS KEYS (`keymap_contributions`): each
    # crate declares its own beside its view, the footer's are `leader::BASE`.
    keymap = "\n".join(read(f) for f in sorted({f for f, _, _ in keymap_contributions()}))
    floor(len(keymap_contributions()), 20, "contributions to the keymap")
    window = read("update_window.rs")
    # THE MARK IS THE UPDATE'S WORDS, under the footer and the view (lane
    # R6): the click runs `update_mark::WATCH`, and the window's `WATCH` —
    # which its table binds — is that one.
    if ("update_mark::WATCH" not in clicked
            or not re.search(r"\bpub const WATCH: &str = crate::update_mark::WATCH;", window)
            or not re.search(r'\bpub const WATCH: &str = "[a-z][a-z-]*";', read("update_mark.rs"))):
        gaps.append("clicking the update's mark does not open the window")
    # THE TABLE, from its name to its closing bracket — a slice, not braces.
    table = re.search(r"pub const BINDINGS\b[^=]*=\s*&\[(.*?)\];", window, re.S)
    bindings = must(table and table.group(1), "the update window's `BINDINGS`")
    taken = [body for f, _, body in keymap_contributions() if shell_name(f) == "update_window.rs"]
    if (len(taken) != 1 or not re.search(r"\bbindings:\s*BINDINGS\b", taken[0])
            or not re.search(r'\(\s*"[^"]+",\s*WATCH,', bindings)):
        gaps.append("the update's mark has no equivalent key")
    if '"power-open"' not in keymap:
        gaps.append("the battery's mark has no equivalent key")
    # THE WAY OUT'S THREE, and the keys that do the same.
    if clicked.count('"network-open"') < 2:
        gaps.append("the fault and the tunnel marks do not open the network view")
    if '"network-airplane"' not in clicked:
        gaps.append("clicking the aeroplane does not leave aeroplane mode")
    for id in ('"network-open"', '"network-airplane"'):
        if id not in keymap:
            gaps.append(f"the way-out mark {id} has no equivalent key")
    # THE TAILNET'S AND TOR'S MARKS open the view on their own section, which
    # is the same view `LEADER s n n` opens — and every switch there is a ROW,
    # reached by the same `RET` the keyboard presses.
    #
    # The words a mark opens the view with are the way out's, under the
    # footer and the view (`link_words`, lane R6): the click hands them, and
    # the view's region reads the same three back (`opened_on`).
    openings = ("link_words::tunnel_opening", "link_words::TAILNET_OPENING", "link_words::TOR_OPENING")
    opened = must(body_of(read("network_region.rs"), "opened_on"), "the network region's `opened_on`")
    if (any(o not in clicked for o in openings)
            or any(o.split("::")[-1] not in opened for o in ("tunnel_opened", "TAILNET_OPENING", "TOR_OPENING"))):
        gaps.append("a tunnel mark does not open the view on its own row")
    # THE DEVICE MARKS, which this check cannot see the way it sees the rest.
    #
    # `bt-1`..`bt-4` carry a DIGIT, and the regex above reads `[a-z-]+`: a
    # click on one of them would slip past `acted` unnoticed. So they are
    # asserted by name — the pool is looked up rather than compared, the
    # command it runs is the one `RET` on the row runs, and that command is
    # in the keymap. Four devices, one door, and the keyboard reaches it too.
    view = read("bluetooth.rs")
    # THE POOL IS THE RADIO'S WORDS, under the footer and the view (lane R6).
    if 'pub const POOL: [&str; 4] = ["bt-1", "bt-2", "bt-3", "bt-4"];' not in read("bluez_words.rs"):
        gaps.append("the bluetooth pool is not the four ids this check knows")
    if "POOL.iter().position" not in clicked:
        gaps.append("a click on a device mark reaches nothing")
    if '"bluetooth-device"' not in clicked:
        gaps.append("clicking a device does not open that device")
    if '"bluetooth-device"' not in view:
        gaps.append("`bluetooth-device` is not what the view's own RET runs")
    if '"bluetooth-open"' not in keymap:
        gaps.append("the device marks have no equivalent key")
    for id in ('"camera-settings-open"', '"player-column"'):
        if id not in clicked or id not in keymap:
            gaps.append(f"a mark runs {id} without a key doing the same")
    # EACH MARK BELOW, by what ITS OWN BRANCH runs and where that is a key:
    # being in the set above says a mark may be clicked, and this says what it
    # does. The branch is the block whose `if` compares `id` with that mark —
    # the first one, which is the one that runs — so a mark split off an `||`
    # and pointed elsewhere is asked on its own, and a command another mark
    # runs does not answer for it.
    def branch(mark):
        return scope(clicked, r'\bid\s*==\s*"' + re.escape(mark) + r'"') or ""
    for mark, needle in (
        ("mode", '"window-menu"'),
        ("drawer", '"drawer-open"'),
        ("drawer", '"wm-scratchpad-show"'),
        ("trail", '"trail-open"'),
        ("selection", '"selection-open"'),
        ("gestures", 'run_command("gestures")'),
        ("camera", 'run_command("camera-settings-open")'),
        ("recording", 'run_command("camera-settings-open")'),
        ("player", "crate::player_mark::zone_at(cell)"),
        ("player", 'run_command("player-toggle")'),
        ("player", 'run_command("player-column")'),
        ("player", 'run_command("player-next")'),
        ("player", 'run_command("player-open")'),
        ("software-trial", 'run_command("software-trials")'),
        ("software-android", 'run_command("software-android")'),
        ("resizer", 'run_command("dev-resizer")'),
    ):
        if needle not in branch(mark):
            gaps.append(f"clicking `{mark}` does not run {needle}")
    for seq, command in (
        ("w o", "window-menu"),
        ("m g", "gestures"),
        ("s c c", "camera-settings-open"),
        ("p c", "player-column"),
        ("p t", "player-toggle"),
        ("p n", "player-next"),
        ("p p", "player-open"),
        ("i a", "software-android"),
        ("/ r", "dev-resizer"),
    ):
        if f'("{seq}", "{command}"' not in keymap:
            gaps.append(f"`{command}` has no key at LEADER {seq}")
    # `software-trials` is bound through a constant, which the software view
    # also uses to teach the key: the binding and the constant's value both.
    if '(SOFTWARE_TRIALS_KEYS, "software-trials"' not in keymap or 'SOFTWARE_TRIALS_KEYS: &str = "i t"' not in keymap:
        gaps.append("`software-trials` has no key at LEADER i t")
    # `drawer-open`, `trail-open` and `selection-open` are the menu at a
    # level, and under the leader each level IS a group of `LEADER w`,
    # because `w` is generated from the menu.
    menu = read("window_menu.rs")
    for letter, level in (("g", "Drawer"), ("y", "Trail"), ("v", "Selection")):
        if not re.search(r'group\("' + letter + r'", key::\w+, Level::' + level + r'\)', menu):
            gaps.append(f"`LEADER w {letter}` no longer opens the {level} level the mark opens")
    if "window_menu::leader_bindings()" not in keymap:
        gaps.append("`LEADER w` is no longer generated from the window menu")
    actions = read("actions.rs")
    if 'd("z", "z", "wm-scratchpad-show")' not in actions:
        gaps.append("the drawer's right button runs `wm-scratchpad-show`, and no chord does")
    # THE TRAIL NUMBERS, by name for the reason the devices give: `trail-1`
    # to `trail-9` carry a digit. A number puts that trail in use, which the
    # trail mode's digits do too, and `LEADER w y <n>` in the menu.
    trails = read("trails.rs")
    if 'pub const POOL: [&str; 9] = [' not in trails or '"trail-9"' not in trails or '"trail-10"' in trails:
        gaps.append("the trail pool is not the nine ids this check knows")
    if "trails::number_of(id)" not in clicked:
        gaps.append("a click on a trail number reaches nothing")
    if '"wm-trail-number"' not in clicked:
        gaps.append("a trail number does not run `wm-trail-number`")
    if 'digits("wm-trail-number"' not in actions:
        gaps.append("the trail numbers' `wm-trail-number` has no equivalent key")
    # THE WORKSPACE NUMBERS, likewise by name: `ws-1`..`ws-9` carry digits.
    # NINE, the owner's rule (9ab8042): `0` is every workspace at once and
    # never a tenth. The left button goes to the number drawn and the right one
    # opens the overview — and both are keys: `LEADER 1`…`9`, `LEADER 0` and
    # `TAB TAB`.
    places = read("workspaces.rs")
    if 'pub const POOL: [&str; 9] = [' not in places or '"ws-9"' not in places or '"ws-10"' in places:
        gaps.append("the workspace pool is not the nine ids this check knows")
    if "workspaces::number_of(id)" not in clicked:
        gaps.append("a click on a workspace number reaches nothing")
    for id in ('"workspace-go"', '"workspace-all"', '"workspace-overview"'):
        if id not in clicked:
            gaps.append(f"a workspace number does not run {id}")
        if id not in keymap:
            gaps.append(f"the workspace numbers' {id} has no equivalent key")
    # THE BRAIN'S MODULES' MARKS, `brain:<module>/<mark>`, which no list of ids
    # can name: what a module publishes is decided at run time, and the shell
    # names no module. They are asked by the PREFIX instead, and held to the
    # same promise: the branch that answers them runs what `brain::click_of`
    # says — the mark's own action through `brain-act`, or its module's page
    # through `brain-open` — and both are doors the keyboard has: `brain-open`
    # is `LEADER b`, and `brain-act` is by name (`LEADER :`) and the brain's
    # own `, n`.
    brain_src = read("brain.rs")
    if 'pub const MARK_PREFIX: &str = "brain:";' not in brain_src:
        gaps.append("the brain's marks are no longer the `brain:` segments this check knows")
    if "crate::brain::drawn_mark(id)" not in clicked or "crate::brain::click_of(" not in clicked:
        gaps.append("a click on a brain module's mark reaches nothing")
    click_of = must(body_of(brain_src, "click_of"), "`brain::click_of`")
    ran = set(re.findall(r'"(brain-[a-z-]+)"', click_of))
    if ran != {"brain-act", "brain-open"}:
        gaps.append("a brain mark's click runs " + repr(sorted(ran)) + ", and not `brain-act` or `brain-open`")
    if '(BRAIN_KEYS, "brain-open"' not in keymap:
        gaps.append("`brain-open`, what a brain mark opens, has no key")

    # 1b) AND WHAT A MODELINE ADAPTED TO A PROGRAM CAN DO (`crate::adapt`).
    #
    # An adapter's segments are not compared by id above: ONE branch, first in
    # `segment_clicked`, hands them to their adapter by what was DRAWN
    # (`adapter_clicked`), and the middle button, the wheel and a drop reach
    # the same adapter. So the promise is held here, adapter by adapter:
    # everything its pointer runs is a command of the registry that a KEY
    # reaches too — the kiosk's grid (which IS its `,` group, generated from
    # it), a press of one of its view's lists, or the window menu's `B`
    # (`LEADER w B`, generated from the menu).
    #
    # FIRST, and not merely somewhere: a mark's own `if id == …` asked before
    # it would answer for a segment its adapter drew under the same id.
    handed = clicked.find("self.adapter_clicked(id, button)")
    asked = [m.start() for m in re.finditer(r"\bid\s*[!=]=|\w+\(id\)", clicked)]
    if handed < 0:
        gaps.append("`segment_clicked` no longer hands an adapter's segment to its adapter")
    elif asked and min(asked) < handed:
        gaps.append("`segment_clicked` asks a mark of its own before the adapter")
    kiosk = read("kiosk.rs")
    # THE PRODUCT ONLY: the tests name the commands they expect a row to run,
    # and a test's literal would answer for a mapping the product lost.
    kiosk_view = without_tests(read("kiosk_view.rs"))
    acts = set()
    for fn in ("clicked", "wheeled", "dropped"):
        body = must(body_of(kiosk, fn), "the kiosk adapter's `" + fn + "`")
        acts |= set(re.findall(r'Act::Run(?:With)?\(\s*"([a-z0-9-]+)"', body))
    floor(len(acts), 10, "commands the kiosk's modeline runs")
    registered = set(re.findall(r'id:\s*"([a-z0-9-]+)"', keymap))
    # A TABLE IS A SLICE, `&[ … ]`, and `scope` walks braces: each is taken
    # from its name to the `];` that closes it, the shape the hint tables'
    # own census reads them in.
    def table_of(name):
        m = re.search(r"pub const " + name + r":[^=]*=\s*&\[(.*?)\n\];", kiosk_view, re.S)
        return must(m and m.group(1), "`kiosk_view::" + name + "`")
    grid = table_of("ROOT")
    by_key = set(re.findall(r'"([a-z]+-[a-z0-9-]+)"', grid))
    floor(len(by_key), 15, "commands of the kiosk's grid")
    for table in ("OF_THE_TABS", "OF_THE_EXTENSIONS"):
        by_key |= set(re.findall(r'\(\s*"[^"]*"\s*,\s*"([a-z0-9-]+)"', table_of(table)))
    # WHAT A LIST'S ROW RUNS, with the row's tab or extension as the argument:
    # what `acted` answers a key of the list with, and nothing else.
    rows = must(body_of(kiosk_view, "acted"), "`kiosk_view::acted`")
    by_key |= set(re.findall(r'id:\s*"([a-z0-9-]+)"', rows))
    by_key |= set(re.findall(r'run\("B", key::\w+, "([a-z0-9-]+)"\)', menu))
    for act in sorted(acts):
        if act not in registered:
            gaps.append(f"the kiosk's modeline runs `{act}`, which is not a command of the registry")
        if act not in by_key:
            gaps.append(f"the kiosk's modeline runs `{act}`, and no key of its view, its `,` group or `LEADER w B` does")
    # THE GRID IS THE `,` GROUP, generated and not written twice.
    local = must(body_of(kiosk_view, "local_bindings"), "`kiosk_view::local_bindings`")
    if "ROOT.iter()" not in local or "LOCAL_PREFIX" not in local:
        gaps.append("the kiosk's `,` group is no longer generated from its grid")
    # AND ITS TWO POOLS, by name for the reason the devices give: `kiosk-tab-1`
    # to `kiosk-tab-16` and `kiosk-ext-1` to `kiosk-ext-8` carry digits, which
    # the `acted` pattern above cannot see — and they never reach it anyway:
    # they are the adapter's, answered by what was drawn.
    if 'pub const TABS: [&str; 16] = [' not in kiosk or '"kiosk-tab-16"' not in kiosk or '"kiosk-tab-17"' in kiosk:
        gaps.append("the kiosk's tab pool is not the sixteen ids this check knows")
    if 'pub const EXTENSIONS: [&str; 8] = [' not in kiosk or '"kiosk-ext-8"' not in kiosk or '"kiosk-ext-9"' in kiosk:
        gaps.append("the kiosk's extension pool is not the eight ids this check knows")

    # 2) WHAT A CLICK ON THE NOTIFICATION BAND CAN DO.
    #
    # Two things, and each has a key: the circle marks it read, which is what
    # `notif-dismiss` does; an action runs, which the keyboard reaches by
    # OPENING the record — the actions are rows there, one under the other, and
    # `RET` runs the one under the cursor. There is nothing up there the
    # keyboard cannot reach, and this is what keeps that true as the band grows.
    #
    # It used to be the action's OWN LETTER, and the owner had it removed: the
    # manager's levels already teach a dozen keys and will teach more, so a
    # letter owned by a notification collides with one of them sooner or later
    # — invisibly, because the person presses it and something else happens.
    band = read("band.rs")
    # EVERY variant of the enum, and not only the two we hoped to find: a check
    # that looks for what it expects passes on a THIRD target nobody gave a key
    # to, which is the whole defect. Planted, and the first version passed.
    enum = scope(band, r"pub enum Hit\b")
    if not enum:
        sys.exit("ERROR: `band::Hit` went away or changed shape")
    hits = set(re.findall(r"^    ([A-Z]\w*)", enum, re.M))
    # AND `Open` (8fc9e4a, "the band opens the record whole"), whose key is
    # read below with the manager.
    if hits != {"Read", "Action", "Open"}:
        gaps.append("the band has targets " + repr(sorted(hits)) + ", outside what was agreed")
    # The keyboard's half of each. `keymap` is read above, with the modeline's
    # own half — one read, because two would be two things to keep in step.
    if '"notif-dismiss"' not in keymap:
        gaps.append("the band's circle has no equivalent key")
    manager = read("notifications.rs")
    # `Open`: the keyboard reaches the same record by opening the manager
    # (`LEADER n n`) and pressing `RET` on its row, which opens it whole.
    if '"notif-open"' not in keymap:
        gaps.append("the band's `Open` has no key: `notif-open` is not bound")
    if '("RET", "notif-see", Column::Happened)' not in manager:
        gaps.append("`RET` on a row no longer opens the record whole: the band's `Open` would be mouse-only")
    # AGAINST THE CODE AND NOT THE CRITERION: the row has to EXIST in the open
    # record's plan, and `RET` has to run the one under the cursor. Looking for
    # the words "action" anywhere would pass on a comment.
    if "Told::Act(" not in manager:
        gaps.append("the open record has no row for an action")
    if not re.search(r"Some\(Told::Act\(i\)\) => Errand::Act\(", manager):
        gaps.append("`RET` does not run the action under the cursor in the open record")
    if '"notif-act"' not in manager:
        gaps.append("the open record's line does not teach how to run one")

    # AND THE BRAIN'S LINE, below the minibuffer, for the same reason.
    #
    # It is the one place on this screen that appears WITHOUT being asked for
    # and asks a question back — the machine is about to rebuild itself, and
    # the two answers are on the line. If either of them were mouse-only, a
    # person at the keyboard could watch the countdown run out with no way to
    # stop it.
    brain = read("brain.rs")
    brain_enum = scope(brain, r"pub enum Hit\b")
    if not brain_enum:
        sys.exit("ERROR: `brain::Hit` went away or changed shape")
    brain_hits = set(re.findall(r"^    ([A-Z]\w*)", brain_enum, re.M))
    # THE COUNTDOWN'S TWO, THE NOTICE'S THREE, AND `+N`: every one a command
    # a key runs — the countdown's and the notice's inside the brain's buffer,
    # `+N` at `LEADER b` — and what each runs is read off `brain_clicked`.
    if brain_hits != {"Abort", "Proceed", "Act", "Dismiss", "Snooze", "More"}:
        gaps.append("the brain's line has targets " + repr(sorted(brain_hits)) + ", outside what was agreed")
    brain_clicked = must(body_of(surface, "brain_clicked"), "`Footer::brain_clicked`")
    for hit, command in (
        ("Abort", "brain-abort"),
        ("Proceed", "brain-proceed"),
        ("Act", "brain-act"),
        ("Dismiss", "brain-dismiss"),
        ("Snooze", "brain-snooze"),
        ("More", "brain-open"),
    ):
        if not re.search(r"Hit::" + hit + r'\s*=>\s*self\.run_command\("' + command + r'"\)', brain_clicked):
            gaps.append("the brain's `" + hit + "` does not run `" + command + "`")
    #
    # MEASURED AGAINST THE BRAIN'S BUFFER and no longer against the leader's
    # table. `LEADER b a` and `LEADER b p` are gone: the owner asked for
    # `LEADER b` to open the brain with nothing in between, and a sequence
    # cannot be a command and the prefix of another — the keymap refuses that
    # at build time. What the two answers do already lived inside the buffer,
    # as `m a` and `m p`, and the band prints THOSE.
    #
    # So the promise is the same one, one door along: every control the band
    # draws is answerable from the keyboard. The band also keeps its click,
    # and both remain registry commands, so `LEADER :` reaches them by name.
    #
    # AND THE THIRD IS THE WATCH'S OFFER. A watch has no result but a
    # sentence, and a sentence that only appeared on a screen somebody has to
    # open would be a watch nobody hears — so the line carries the offer too,
    # with a button. It is ONE target and not one per notice: what it runs is
    # named by the notice itself, as a command id the registry resolves.
    # The promise it is held to is the other two's exactly — the button is
    # answerable from the keyboard, at `m n`.
    brain_buffer = read(root / "buffers" / "brain" / "src" / "lib.rs")
    for command in (
        '"brain-abort"',
        '"brain-proceed"',
        '"brain-act"',
        '"brain-dismiss"',
        '"brain-snooze"',
    ):
        if command not in brain_buffer:
            gaps.append("the brain's line has no key in the brain's buffer for " + command)
    # AND THE BAND PRINTS WHAT THE BUFFER ANSWERS TO. The two constants are
    # the band's own, and they have to be the buffer's keys and not the
    # leader's — a line that taught `SUPER b a` after that sequence went away
    # would be teaching a key that does nothing.
    leader_src = keymap
    for const, wanted in (
        ("BRAIN_ABORT_KEYS", "brain-abort"),
        ("BRAIN_PROCEED_KEYS", "brain-proceed"),
        ("BRAIN_NOTICE_KEYS", "brain-act"),
        ("BRAIN_DISMISS_KEYS", "brain-dismiss"),
        ("BRAIN_SNOOZE_KEYS", "brain-snooze"),
    ):
        said = re.search(r"pub const " + const + r': &str = "([^"]+)";', leader_src)
        if not said:
            gaps.append("`" + const + "` went away; the band draws its key from it")
            continue
        if ('("' + said.group(1) + '", "' + wanted + '")') not in brain_buffer:
            gaps.append(
                "the band prints `" + said.group(1) + "` for " + wanted
                + ", which is not what the brain's buffer binds"
            )
    # AND A CONTROL CANNOT BE BUILT WITHOUT SAYING WHAT IT DOES.
    #
    # This is structural rather than a count, and the first version of it was a
    # count — it wanted four `explain: Some(` and found three, because the two
    # controls share one builder. Counting occurrences measures how the source
    # is factored, which is not the property.
    #
    # The property is that the builder DEMANDS the sentence: a `control` whose
    # signature takes an `explain: String` cannot produce a target that has
    # none, whatever a caller forgets.
    if not re.search(r"fn control\([^)]*explain: String", brain, re.S):
        gaps.append("the constructor of the brain line's control does not require an explanation")

    # THE MANAGER'S ROW TARGETS, and the keys that do the same thing.
    #
    # Every variant of the enum, and not the two we hoped to find: a check that
    # looks for what it expects passes on a THIRD target nobody gave a key to.
    rows_enum = scope(manager, r"pub enum Hit\b")
    if not rows_enum:
        sys.exit("ERROR: `notifications::Hit` went away or changed shape")
    targets = set(re.findall(r"^    ([A-Z]\w*)", rows_enum, re.M))
    #
    # `ToggleRead` was `MarkRead`, and the rename is the point rather than a
    # detail: the envelope is ONE control that goes both ways, drawn open on an
    # unread row and closed on a read one. Marking read used to be a one-way
    # door — a row read by a slip of the hand stayed read for a fortnight — and
    # a name that said `MarkRead` while sometimes unmarking would be a name
    # that lies to whoever reads this check next. TWO targets, still.
    if targets != {"ToggleRead", "Delete"}:
        gaps.append("the list has targets " + repr(sorted(targets)) + ", outside what was agreed")
    for key, verb in (("Press::Space", "ToggleRead"), ("Press::Letter('d')", "Delete")):
        if key not in manager:
            gaps.append("the list's " + verb + " target has no equivalent key")
    # AND EVERY CONTROL EXPLAINS ITSELF on the message line, never in a tooltip.
    if band.count("explain: Some(") < 3:
        gaps.append("a control of the band does not say what it does on hover")

    # 3) NOTHING FLOATS.
    forbidden = ("xdg_popup", "XdgPopup", "create_popup", "Popup::")
    for name in (
        "surface.rs",
        "buffer.rs",
        "files_window.rs",
        "band.rs",
        "brain.rs",
        "update_window.rs",
        "notifications.rs",
        "notifications_window.rs",
    ):
        text = read(name)
        for word in forbidden:
            if word in text:
                gaps.append(name + ": " + word + " — invariant 14")

    if gaps:
        print("ERROR: the pointer gained a door of its own.", file=sys.stderr)
        for g in gaps:
            print("       " + g, file=sys.stderr)
        raise SystemExit(1)
    print("OK: the modeline and the band only do what the keyboard does, and nothing floats")
    END
  '';

  # THE STATE CONTRACT, ON EVERY BUFFER AT ONCE.
  #
  # Each half of it is already guarded and neither is worth much alone: the
  # descriptor's states by `Descriptor::validate`, the words by
  # `buffer-states-have-text`, the host's `Esc` layer by unit tests in
  # `buffer.rs`. What none of them reaches is the ROUND TRIP — send the id the
  # buffer declared and get the same id back out of `effect::state-changed`,
  # through the WIT and out of the component's own memory.
  #
  # A buffer that took `enter-state` and did nothing would satisfy every check
  # above and leave `SPC w s` offering a state nobody can enter, with the
  # modeline naming a screen that is not up. That is not hypothetical: it was
  # planted, and the first version of the driver PRINTED it and exited zero.
  #
  # Every buffer and not one chosen, because the contract is the same for
  # all of them and most were written in a single pass — which is the pass
  # whose mistakes land in whichever file the writer got tired on.
  states-driven = mkCheck "states-driven" [ ] ''
    ${rust.bins.ronoctua-test-states}/bin/ronoctua-test-states \
      ${buffers.memory}/lib/ronoctua_buffer_memory.wasm \
      ${buffers.keyboard}/lib/ronoctua_buffer_keyboard.wasm \
      ${buffers.transfers}/lib/ronoctua_buffer_transfers.wasm \
      ${buffers.format}/lib/ronoctua_buffer_format.wasm \
      ${buffers.example}/lib/ronoctua_buffer_example.wasm
  '';

  # THE KEYS THE CODE ASKS FOR EXIST, and that is a different question from
  # the one `i18n-complete` answers.
  #
  # `i18n-complete` compares the two bundles AGAINST EACH OTHER: it catches a
  # key in one language and not the other, which is the common mistake. It
  # cannot catch a key that is in neither — and a key in neither reaches the
  # screen as `[files-fact-lens]`, in both languages, with every check green.
  #
  # `crates/ronoctua-inspect/src/lib.rs` names this check in its own `key`
  # module docstring and it did not exist. The keys there are LITERALS rather
  # than a generated `key` module's constants, and they have to be: the crate
  # does not speak — it names facts whose sentences live in the fragments of
  # the crates that say them — so no constant of its own can stand for one.
  # That is the one hole in invariant 8's "a missing key does not compile",
  # and this is what closes it.
  #
  # The update's brain module does the same job for its sequence, against the
  # list its generator derives. This one has no generator, so it reads the
  # constants.
  # THE AMBIENT SOUNDS' WORDS AND GLYPHS. `assets/ambience.nix` names each
  # sound and its group, and the player's page says them by keys built from
  # those ids (`player::ambience_name`, `player::ambience_group`) and draws a
  # group by a glyph chosen by its id (`player_ambience::glyph_of`). A key
  # missing is said as "a sound this player has no name for", and a group
  # with no glyph arm gets the plain wave — both honest, and both SILENT at
  # build time: this is what says them.
  ambience-keys-exist = mkCheck "ambience-keys-exist" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())
    exec(open("${shellPrelude}").read())

    # PARSED: the declaration's `id = "…";` and `group = "…";` fields, which
    # the build reads the same way (`nix/ambience.nix`), comments taken out.
    # FILE-WIDE: the two `.ftl` files, whose keys are module-level lines.
    root_dir = pathlib.Path("${self}")
    nix = "\n".join(
        line.split("#", 1)[0]
        for line in (root_dir / "assets/ambience.nix").read_text().splitlines()
    )
    ids = re.findall(r'\bid\s*=\s*"([a-z0-9-]+)"\s*;', nix)
    groups = sorted(set(re.findall(r'\bgroup\s*=\s*"([a-z0-9-]+)"\s*;', nix)))
    floor(len(ids), 3, "ambient sounds declared")
    floor(len(groups), 2, "groups of ambient sounds")

    owed = [f"player-ambience-{i}" for i in ids]
    owed += [f"player-ambience-group-{g}" for g in groups]
    failed = 0
    for language in ${builtins.toJSON languages}:
        text = (pathlib.Path("${texts}") / f"{language}.ftl").read_text()
        have = set(re.findall(r"^([a-z][a-z0-9-]*)\s*=", text, re.M))
        for k in owed:
            if k not in have:
                print(f"ERROR: {language} does not have `{k}`", file=sys.stderr)
                failed = 1

    # THE GLYPHS, by the arms of `glyph_of` — narrowed to that function, so a
    # group's id written anywhere else in the file is not taken for its arm.
    page = uncommented(shell_file("player_ambience.rs").read_text())
    arms = set(re.findall(r'"([a-z0-9-]+)"\s*=>', must(body_of(page, "glyph_of"), "`player_ambience::glyph_of`")))
    for g in groups:
        if g not in arms:
            print(f"ERROR: the group `{g}` has no glyph in `player_ambience::glyph_of`", file=sys.stderr)
            failed = 1

    if failed:
        print("", file=sys.stderr)
        print("A sound or a group the page cannot name is said as one it has no name", file=sys.stderr)
        print("for, and a group with no glyph is drawn as the plain wave: nothing on", file=sys.stderr)
        print("screen fails, which is why this does.", file=sys.stderr)
        raise SystemExit(1)
    print(f"OK: {len(ids)} ambient sounds and {len(groups)} groups have words in every language, and every group a glyph")
    END
  '';

  inspect-keys-exist = mkCheck "inspect-keys-exist" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the keys are a module-level `pub mod key`, and that module IS
    # the narrowing — found by `scope`, which walks its braces rather than
    # stopping at the first `\n}` a nested block gives it.
    #
    # `uncommented`, because a key is the string literal being read out.
    root_dir = pathlib.Path("${self}")
    source = uncommented((root_dir / "crates/ronoctua-inspect/src/lib.rs").read_text())
    floor(len(source), 1000, "characters of ronoctua-inspect's lib.rs")

    # The `key` module's constants, and only those: a literal anywhere else in
    # the crate is a string, not a promise about a bundle.
    block = scope(source, r"pub mod key\b")
    if not block:
        print("ERROR: the `key` module is gone from ronoctua-inspect.", file=sys.stderr)
        raise SystemExit(1)
    owed = sorted(set(re.findall(r'pub const [A-Z_0-9]+: &str = "([a-z][a-z0-9-]*)";', block)))
    floor(len(owed), 5, "keys ronoctua-inspect asks for")

    failed = 0
    for language in ${builtins.toJSON languages}:
        text = (pathlib.Path("${texts}") / f"{language}.ftl").read_text()
        have = set(re.findall(r"^([a-z][a-z0-9-]*)\s*=", text, re.M))
        for k in owed:
            if k not in have:
                print(f"ERROR: {language} does not have `{k}`", file=sys.stderr)
                failed = 1

    if failed:
        print("", file=sys.stderr)
        print("A key missing from BOTH languages is invisible to", file=sys.stderr)
        print("i18n-complete, which compares one language against the other. It reaches the", file=sys.stderr)
        print("screen in square brackets, and nothing else reports it.", file=sys.stderr)
        raise SystemExit(1)
    print(f"OK: the {len(owed)} keys ronoctua-inspect asks for exist in both languages")
    END
  '';

  # THE DESIGN CRATE'S TWO CONSTANTS AGREE WITH THE TOKENS THEY DEFINE.
  #
  # A buffer may not be told a token's value (invariant 11), so
  # `ronoctua-design` carries `AIR` and `ICON` as numbers of its own. That is
  # legitimate — both are DEFINITIONS rather than values — but a definition
  # still has to stay true:
  #
  #   AIR  = 1   because the air is one line height, and a cell IS one line
  #              height (`font.size.base` x `font.lineHeight`). If the cell
  #              ever stopped being the unit of vertical rhythm, this would
  #              quietly become "one cell of air, which is no longer a line".
  #   ICON = 2   because `ceil(font.size.icon / font.size.base)`: the glyph is
  #              drawn on the cell at 22 px and its advance exceeds the 10,8 px
  #              cell, so it covers two columns. Raise `font.size.icon` past
  #              two cells' worth and the title would be written ON TOP of the
  #              glyph, in every buffer at once.
  #
  # It used to divide by `font.size.large`, which was the buffers' body until
  # the owner asked for one measure across the system. The definition did not
  # change — it is still "the icon over the body" — only the body's name.
  #
  # One number, two homes, and this is what stops them drifting.
  design-constants-match-tokens = mkCheck "design-constants-match-tokens" [ pkgs.python3 ] ''
    python3 - <<'END'
    import math, pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: both numbers are module-level — a `pub const` in a crate and a
    # leaf of an attribute set — and there is no function to narrow to.
    root_dir = pathlib.Path("${self}")
    design = code_of((root_dir / "crates/ronoctua-design/src/lib.rs").read_text())
    typography = hashless((root_dir / "assets/tokens/typography.nix").read_text())
    floor(len(design), 2000, "characters of ronoctua-design's lib.rs")
    floor(len(typography), 200, "characters of typography.nix")

    def constant(name):
        m = re.search(rf"pub const {name}: u16 = (\d+);", design)
        if not m:
            print(f"ERROR: `{name}` is gone from ronoctua-design", file=sys.stderr)
            raise SystemExit(1)
        return int(m.group(1))

    def token(leaf):
        m = re.search(rf"^\s+{leaf}\s*=\s*([0-9.]+);", typography, re.M)
        if not m:
            print(f"ERROR: the token `{leaf}` is gone from typography.nix", file=sys.stderr)
            raise SystemExit(1)
        return float(m.group(1))

    failed = 0

    air = constant("AIR")
    if air != 1:
        print(f"ERROR: AIR is {air}. The air is ONE line height, and a cell is", file=sys.stderr)
        print("      one line height — so AIR is 1, or the definition changed.", file=sys.stderr)
        failed = 1

    icon = constant("ICON")
    wanted = math.ceil(token("icon") / token("base"))
    if icon != wanted:
        print(f"ERROR: ICON is {icon} and the font asks for {wanted}", file=sys.stderr)
        print(f"      (icon {token('icon')} px over base {token('base')} px).", file=sys.stderr)
        print("      With the wrong number, the title is written ON TOP of the glyph.", file=sys.stderr)
        failed = 1

    if failed:
        raise SystemExit(1)
    print(f"OK: AIR={air} (one cell and one line), ICON={icon} cells for {token('icon')} px")
    END
  '';

  # THE MANAGER'S ROWS ARE BUILT WHERE THEY ARE ASKED FOR, and never handed
  # back to the caller that asked.
  #
  # `Footer::expansion_window` builds one page of the expanded region.
  # `Footer::expansion` builds the whole of it — and, with the file manager
  # open, it does so by calling `expansion_window`. So `expansion_window` may
  # call `expansion` in EXACTLY one place: the branch it takes when there is no
  # manager, where `expansion` will not come back.
  #
  # It had two more. Both asked `View::row_count`, both handed the manager back
  # to `expansion()` when it answered `None` — and `row_count` answers `None`
  # for precisely the three states (menu, question, sheet) that the modal branch
  # further down exists to draw. The pair was an unconditional infinite
  # recursion: the shell died of a stack overflow the moment the right button,
  # `C-m` or a permission question opened one of them, with no diagnostic beyond
  # "fatal runtime error: stack overflow".
  #
  # WHAT IT COSTS AND WHAT IT DOES NOT COVER. It reads one function of one file
  # and runs in milliseconds. It catches THIS pair and no other: a different two
  # functions calling each other would pass it untouched, and there is no check
  # in this file that would catch that one. What makes it worth having anyway is
  # that these two are load-bearing — every line the footer draws goes through
  # them — and that the failure they produce names neither of them.
  manager-builds-its-own-rows = mkCheck "manager-builds-its-own-rows" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import re, sys
    exec(open("${pyPrelude}").read())
    exec(open("${shellPrelude}").read())

    src = shell_source("surface.rs")

    # The function, from its signature to the first line that is back at
    # `impl`-level indentation — the shape every other reader in this file uses.
    body = re.search(
        r"\n    fn expansion_window\(&self[^\n]*\n(.*?)\n    \}\n",
        src,
        re.S,
    )
    if not body:
        sys.exit("ERROR: `expansion_window` went away or changed shape")
    body = body.group(1)

    calls = [n for n, line in enumerate(body.splitlines(), 1) if "self.expansion()" in line]
    if not calls:
        sys.exit(
            "ERROR: `expansion_window` no longer calls `expansion` at all.\n"
            "       The views that are NOT the manager are built by `expansion`\n"
            "       and cut here; if that changed, this check proves nothing and\n"
            "       should be rewritten rather than deleted."
        )
    if len(calls) > 1:
        print(
            f"ERROR: `expansion_window` calls `self.expansion()` {len(calls)} times,"
            " on lines " + ", ".join(str(n) for n in calls) + ".",
            file=sys.stderr,
        )
        print("", file=sys.stderr)
        print("       With the manager open, `expansion` calls THIS function back.", file=sys.stderr)
        print("       The one call that is safe is the `let ... else` for a door with", file=sys.stderr)
        print("       no manager; every other one is a loop with no exit, and the", file=sys.stderr)
        print("       symptom is `fatal runtime error: stack overflow` naming neither.", file=sys.stderr)
        raise SystemExit(1)

    # AND IT IS THE ONE IN THE `else`. A single call in the wrong place is the
    # same defect with a smaller number.
    guard = re.search(r"let Some\(files\) = self\.sections\(\) else \{(.*?)\n        \};", body, re.S)
    if not guard:
        sys.exit("ERROR: the `let Some(files) = self.sections() else` guard is gone")
    if "self.expansion()" not in guard.group(1):
        sys.exit(
            "ERROR: the only call to `expansion` is outside the `else` that runs\n"
            "       when no region in sections is shown — which is the one place it\n"
            "       cannot come back. See the note above this check."
        )

    print("OK: the sections' rows are built here, and `expansion` is only asked")
    print("    for the views that are not laid out in sections")
    PY
  '';

  # A COUNT IS NOT AN ADVANCE, AND ONLY THE DATABASE KNOWS THE DIFFERENCE.
  #
  # After the unification there are exactly TWO rulers left, and they answer two
  # different questions:
  #
  #   `ronoctua_protocol::cells` counts CLUSTERS — how many things there are. It
  #   is what reserves, what confers and what cuts, and the whole system now
  #   shares the one definition.
  #
  #   the database's `width` field is the ADVANCE. An emoji advances 1.245 em
  #   against the cell's 0.600, so its cluster counts as ONE thing and covers
  #   TWO cells. No code can know that: the answer is in the font, and what read
  #   the font was the generator.
  #
  # What draws such a datum budgets from the field (`Char::ink`, or the
  # `width` it multiplies), never from the count. It was the three icon
  # buffers; it is the icons app now (`icons.rs`, `icons_page.rs`), which drew
  # the same characters out of the same table. Writing `wide(&c.drawn())` is the
  # obvious thing to do and it is wrong: a ZWJ couple would reserve one cell for
  # a drawing two cells wide, and the next column would be written over.
  #
  # The check is narrow on purpose. It does not try to understand the layout; it
  # asserts that the character the app DRAWS never reaches the counter, and
  # that the line taking it budgets from the measured width.
  ink-is-not-a-count = mkCheck "ink-is-not-a-count" [ pkgs.gnugrep pkgs.coreutils ] ''
    failed=0
    . ${shellSh}
    icons=$(shell_files 'icons*.rs')

    # 1) THE DRAWN CHARACTER NEVER REACHES THE COUNTER.
    #    `drawn()` is the method that hands out the character itself — the
    #    one string in the three tables that can hold a cluster of six
    #    codepoints.
    if counted=$(grep -nE '(wide|cells|width)\(&?[a-z_.]*\.drawn\(\)' $icons); then
      echo "ERROR: the drawn character was measured with the cluster count:" >&2
      echo "$counted" >&2
      echo "      The count answers HOW MANY THINGS; an emoji is one thing and" >&2
      echo "      two cells. Budget it from the table's width, as Char::ink does." >&2
      failed=1
    fi

    # 2) AND THE LINE THAT TAKES IT BUDGETS FROM THE MEASURED WIDTH — the
    #    method (`c.ink(scale)`) or the field (`c.width`). Without this half,
    #    deleting the budget altogether would pass part 1.
    drawn=$(cat $icons | grep -c '\.drawn()' || true)
    inked=$(cat $icons | grep '\.drawn()' | grep -cE '\.ink\(|\.width' || true)
    if [ "$drawn" -eq 0 ]; then
      echo "ERROR: the icons app draws no character any more — this check proves nothing now." >&2
      failed=1
    fi
    if [ "$inked" -lt "$drawn" ]; then
      echo "ERROR: $drawn line(s) draw the character and only $inked budget from its width." >&2
      failed=1
    fi

    [ "$failed" = 0 ] || exit 1
    echo "OK: $drawn drawn character(s), each budgeted from the width the font gave"
  '';

  # THE BUFFERS' OWN TESTS, ALL SIXTY-NINE OF THEM.
  #
  # They exist in the eight `src/lib.rs` and, until this check, not one of them
  # ran: `nix/buffers.nix` compiled the `.wasm` and stopped. They were green
  # only for as long as somebody remembered to run them by hand — and could not
  # be run by hand without knowing which variables to set, because the three
  # browsers embed their database with `include_str!(env!(…))`.
  #
  # What they cover is what a driver cannot: the arithmetic of a frame inside
  # the component's own vocabulary — where a field starts, what a click divides
  # by, whether a run reaches past the edge, whether a window too short for a
  # row drops the footer. `buffers.tested` builds each one with `doCheck`, so a
  # failing test fails the derivation, naming the test and the line.
  #
  # IT IS GATE-ONLY, and the reason is a number rather than a feeling: with the
  # tests on, the eight buffers go from 27.8 s to 2 min 44 s. See the fourth
  # criterion in `tests/slow.nix`.
  buffers-test = pkgs.linkFarmFromDrvs "check-buffers-test" (lib.attrValues buffers.tested);

  # AND CLIPPY READS THEM, which nothing in this tree did.
  #
  # `cargo clippy --workspace` cannot reach a buffer — the root `Cargo.toml`
  # excludes `buffers/` and each is a workspace of its own — and building one
  # is not linting it. A buffer that baked a table in could not even be
  # linted by hand: `include_str!(env!("RONOCTUA_*_JSON"))` fails at compile
  # time outside Nix, so `cargo clippy` in the directory stopped before
  # reading a line. `nix/buffers.nix`'s `linted` runs it where the variables
  # already are.
  #
  # WHAT IT WOULD HAVE CAUGHT: `ordered` dead in the old Unicode buffer — a
  # function whose doc-comment describes an ordering the file had stopped
  # asking for, with that ordering written out inline three hundred lines
  # away. It survived releases with nothing in the tree able to see it.
  #
  # GATE-ONLY, by `tests/slow.nix`'s fourth criterion and for the same number
  # as `buffers-test`: it is a THIRD compilation of the six, and the battery
  # has already paid for one.
  buffers-lint = pkgs.linkFarmFromDrvs "check-buffers-lint" (lib.attrValues buffers.linted);

  # NOBODY DRAWS A HEADING OF THEIR OWN, AND NOBODY GENERATES BINDINGS.
  #
  # This is the check that makes "these mistakes cannot happen again" mean
  # something. The report that started this work was four buffers with four
  # different headings — with a rule, without one, with a blank row, without
  # one, content starting at column 0, 1, 2 or 4 — and three browsers carrying
  # three copies of one geometry with different numbers in them.
  #
  # Two greps, and each closes one half:
  #
  #   1. `wit_bindgen::generate!` may appear in ONE crate. That is what makes
  #      the design crate unavoidable rather than merely available: a buffer
  #      cannot quietly go back to building its own display list, because it
  #      would have no types to build one out of.
  #   2. no buffer declares a heading of its own. `heading` is the crate's word
  #      for it; a `fn title(` reappearing under `buffers/` is the fifth answer
  #      being written, and the four that existed are why this check does.
  buffers-use-the-design-crate =
    mkCheck "buffers-use-the-design-crate" [ pkgs.gnugrep pkgs.coreutils ]
      ''
          failed=0

          expected="${self}/crates/ronoctua-design/src/lib.rs"
          # THE INVOCATION, NOT THE WORD. Every migrated buffer's module header
        # SAYS that `wit_bindgen::generate!` is gone and why — which is exactly
        # the sentence a future reader needs, and exactly what a naive grep would
        # report as the offence. Anchored to the start of a line, a comment's
        # leading `//` no longer matches.
        offenders=$(grep -rlE '^[[:space:]]*wit_bindgen::generate!' ${self}/buffers ${self}/crates || true)
          for f in $offenders; do
            if [ "$f" != "$expected" ]; then
              echo "ERROR: $f generates bindings of its own — only ronoctua-design does." >&2
              failed=1
            fi
          done
          if ! grep -qE '^[[:space:]]*wit_bindgen::generate!' "$expected"; then
            echo "ERROR: ronoctua-design stopped generating the bindings." >&2
            failed=1
          fi

          if titles=$(grep -rn "fn title(" ${self}/buffers 2>/dev/null); then
            echo "ERROR: a buffer went back to having a header of its own:" >&2
            echo "$titles" >&2
            echo "      There is one header, and it lives in Screen::heading." >&2
            failed=1
          fi

          [ "$failed" = 0 ] || exit 1
          echo "OK: one generator of bindings, and no header written by hand"
      '';

  # NO VIEW BUILDS ITS OWN SEPARATOR.
  #
  # The owner reported the same defect three times across two months, in three
  # different views: *"there are horizontal lines that touch the right side of the
  # screen and do not touch the left"*, and the vertical ones *"are not touching
  # the bottom of the screen"*. It was never one view's bug. Every one of the eight
  # sites wrote the rectangle out by hand, and every one of them made one of the
  # same two mistakes: `x: margin * cell` with `width: self.width` — inset on the
  # left, past the edge on the right — or `height: lines * line_height`, which
  # with a fractional line height stops short of the bottom.
  #
  # So the rectangle is not written by hand any more. `chrome::rule` takes the
  # surface's width and cannot express an inset; `chrome::divider` takes the
  # BOTTOM and not a height, so "where does it end" is answered with the edge
  # rather than with a count. This check is what keeps the ninth site from being
  # written the old way — which is the whole of what the owner asked for: not
  # that the lines be fixed, but that they stop coming back.
  # ONE OFFSET PER LIST, and the list owns it.
  #
  # The manager kept `View::first` in a `Cell` and each door kept a second copy
  # to push in through `set_first`. Three homes for one number, synchronised by
  # hand — and the two the owner reported came straight out of it: the wheel
  # moved a copy the next frame overwrote, and the window's cursor was compared
  # against one height while its wheel used another.
  #
  # Naming the dead spellings is what makes this cheap. They cannot come back
  # by accident, only by somebody typing them again.
  one-offset-per-list = mkCheck "one-offset-per-list" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())
    exec(open("${shellPrelude}").read())

    # FILE-WIDE: a second home for the number is a FIELD or a call written
    # anywhere in one of the three files — none of them a question about the
    # inside of a function. The strip is what stops the comment that explains
    # this rule, and names all four dead spellings, from answering for them.
    files = code_of(shell_file("files.rs").read_text())
    window = code_of(shell_file("files_window.rs").read_text())
    surface = code_of(shell_source("surface.rs"))
    floor(len(files), 10000, "characters of files.rs")
    floor(len(window), 10000, "characters of files_window.rs")
    floor(len(surface), 100000, "characters of surface.rs")
    wrong = []

    # THE SETTER IS GONE. It is what let a door hold the number.
    if re.search(r"\bfn\s+set_first\b", files):
        wrong.append("files.rs declares `set_first` again")
    for name, text in (("files_window.rs", window), ("surface.rs", surface)):
        if ".set_first(" in text:
            wrong.append(name + " pushes an offset in through `set_first`")

    # AND THE FIELD IS A FIELD, not a cell somebody can write through a
    # shared reference.
    if re.search(r"\bfirst:\s*Cell<", files):
        wrong.append("files.rs keeps the listing's offset in a `Cell`")
    if not re.search(r"\blist_offset:\s*usize\b", files):
        wrong.append("files.rs no longer owns `list_offset`")

