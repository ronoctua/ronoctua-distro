  # established and `bluetooth-profiles-have-text` copied one file earlier.
  keyboard-choices-have-text = mkCheck "keyboard-choices-have-text" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a generated list of keys against a catalogue of sentences.
    # Neither file has a function in it.
    #
    # `hashless` on the `.ftl`, whose comment is `#`: a key that was commented
    # out is a key that is not there, and it used to read as present.
    keys = pathlib.Path("${keyboardsRs}/keys.txt").read_text().split()
    floor(len(keys), 12, "words in the vocabulary")

    failed = False
    for language in ${builtins.toJSON languages}:
        ftl = hashless(pathlib.Path("${../assets/i18n}/" + language + ".ftl").read_text())
        have = set(re.findall(r"^([a-z][a-z0-9-]*) *=", ftl, re.M))
        floor(len(have), 500, "keys declared by " + language)
        missing = [k for k in keys if k not in have]
        if missing:
            print(f"ERROR: {language} does not have: {', '.join(missing)}")
            failed = True
        else:
            print(f"ok  {language}: the vocabulary's {len(keys)} words are there")

    if failed:
        sys.exit(1)
    print("OK: every key and every meaning speaks both languages")
    PY
  '';

  # KEYD REALLY REFUSES A FILE IT CANNOT READ.
  #
  # # Why this is measured and not assumed
  #
  # The whole safety of `LEADER s k` rests on one sentence: the rendered files
  # are validated BEFORE they are installed, because a keyd that refuses its
  # configuration is a keyboard with no leader on a machine somebody is
  # holding. That sentence is only true if `keyd check` says no — and how it is
  # spelled decides whether it says anything at all:
  #
  #     keyd check good.conf bad.conf   exit 255   what the crate uses
  #     keyd check -c <directory>       exit 255   `-c` is read as a filename
  #     keyd check <directory>          exit   0   a directory parses as nothing
  #
  # The first version of the crate used the middle spelling, which refuses
  # everything — the feature would have been a screen that never wrote. The
  # third is worse: a guard that says yes to a file that would kill the daemon.
  # So this runs the real binary, both ways, and reads the crate for the
  # spelling.
  keyd-refuses-what-it-cannot-read =
    mkCheck "keyd-refuses-what-it-cannot-read"
      [
        pkgs.keyd
        pkgs.gnugrep
      ]
      ''
        printf '[ids]\n*\n\n[main]\nleftmeta = overload(meta, f13)\n' > good.conf
        printf '[ids]\n*\n\n[main]\nleftmeta = nonsense_action(1,2,3)\n' > bad.conf

        keyd check good.conf || {
          echo "ERROR: keyd refused a configuration this system renders." >&2
          exit 1; }

        if keyd check bad.conf 2>/dev/null; then
          echo "ERROR: keyd accepted a configuration it cannot read." >&2
          echo "      The guard in front of every install is this command, and" >&2
          echo "      a guard that says yes to anything is not a guard." >&2
          exit 1
        fi

        # AND THE CRATE SPELLS IT THE WAY THAT WORKS. `-c` would refuse every
        # write; a bare directory would accept every one.
        crate=${../crates/ronoctua-keyboards/src}/lib.rs
        grep -q '\.arg("check")' "$crate" || {
          echo "ERROR: the crate no longer calls \`keyd check\`." >&2
          exit 1; }
        grep -q '\.args(files)' "$crate" || {
          echo "ERROR: the crate does not hand keyd the FILES it is about to install." >&2
          echo "      With no file, keyd checks what is already in /etc/keyd —" >&2
          echo "      the configuration that is running, not the one being written." >&2
          exit 1; }
        if grep -q '"check", "-c"' "$crate"; then
          echo "ERROR: the crate passes \`-c\`, which keyd reads as a filename." >&2
          echo "      Every install would be refused." >&2
          exit 1
        fi

        echo "OK: keyd takes the files, accepts what we render and refuses what it cannot read"
      '';

  # THE LEADER SURVIVES BEING CONFIGURED.
  #
  # # What would go wrong without this
  #
  # keyd takes a device id in ONE file. The distro's file claims `*`, so a
  # keyboard given rules of its own has to be taken OUT of that claim — and a
  # keyboard outside the catch-all has no rules at all unless its own file
  # repeats them. One of those rules is the leader.
  #
  # So the failure this holds back is precise and awful: somebody configures
  # their keyboard, and the key that opens every command in the system stops
  # working ON THAT KEYBOARD. Nothing errors; the file is valid; keyd is happy.
  #
  # # The three things it reads, and why all three
  #
  # The RULE is declared once (`assets/keyboards.nix`) — the module writes it
  # into the seed and the shell writes it into every file it renders, and a
  # second copy would drift. The SEED has to carry it, or a machine that has
  # never been configured has no leader on first boot. And the DIRECTORY has to
  # belong to the user, or the shell cannot write there at all and the whole
  # feature is a screen that refuses.
  keyd-rules-carry-the-leader =
    mkCheck "keyd-rules-carry-the-leader"
      [
        pkgs.python3
        pkgs.gnugrep
      ]
      ''
        python3 - <<'PY'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        # FILE-WIDE: a rendered keyd file and a tmpfiles line have no functions
        # in them, and the two facts asked of the crate — that it builds the
        # leader once and writes it into every file — are about the file.
        #
        # `hashless` for the Nix and the tmpfiles rules; `uncommented` for the
        # Rust, because `EVERYONE` is the string literal being read out.
        declared = hashless(pathlib.Path("${../assets/keyboards.nix}").read_text())
        floor(len(declared), 100, "characters of assets/keyboards.nix")
        key = re.search(r'key = "([a-z0-9]+)";', declared)
        action = re.search(r'action = "([^"]+)";', declared)
        if not key or not action:
            print("ERROR: assets/keyboards.nix declares no leader rule")
            sys.exit(1)
        rule = f"{key.group(1)} = {action.group(1)}"

        failed = False

        # THE SEED, out of the built system rather than out of the module's
        # source: what a machine boots with is the file, not the expression.
        seed = pathlib.Path("${seedOfTheKeyboard}").read_text()
        if rule not in seed:
            print(f"ERROR: the seeded keyd config does not carry `{rule}`")
            print(f"       it says: {seed!r}")
            failed = True
        if "[ids]" not in seed or "*" not in seed:
            print("ERROR: the seeded keyd config claims no keyboard")
            failed = True

        # AND THE CRATE PUTS IT IN EVERY FILE. Read out of the source, because
        # the unit test that proves it by rendering cannot run from here — and
        # what would break this is somebody writing the rule into the catch-all
        # only, which reads as correct until a keyboard is configured.
        crate = uncommented(pathlib.Path("${../crates/ronoctua-keyboards/src}/lib.rs").read_text())
        product = crate.split("#[cfg(test)]")[0]
        floor(len(product), 1000, "characters of the crate before its tests")
        if "let leader = format!" not in product:
            print("ERROR: the renderer no longer builds the leader's line once")
            failed = True
        # Every file gets it: the catch-all pushes it, and so does the loop.
        if product.count("push_str(&leader)") < 2:
            print("ERROR: the leader is not written into every rendered file —")
            print("       a keyboard with rules of its own would lose it.")
            failed = True

        # AND THE DIRECTORY IS OURS TO WRITE.
        rules = hashless(pathlib.Path("${tmpfilesOfTheKeyboard}").read_text())
        floor(len(rules), 40, "characters of the tmpfiles rules")
        if not re.search(r"^d /var/lib/ronoctua/keyd .* ${user} ", rules, re.M):
            print("ERROR: the keyd directory does not belong to the session's user")
            print(f"       {rules}")
            failed = True
        if "L+ /etc/keyd" not in rules:
            print("ERROR: /etc/keyd is not pointed at the directory the shell writes")
            failed = True

        # AND THE TWO HALVES AGREE ON ITS NAME. The module seeds a file and the
        # crate renders one; if they disagree, a machine boots with the seed
        # AND keeps it beside the shell's own — two catch-alls, both claiming
        # `*`, which is what keyd's manual forbids.
        seeded = re.search(r"^C (\S+)", rules, re.M)
        named = re.search(r'pub const EVERYONE: &str = "([^"]+)"', crate)
        if not seeded or not named:
            print("ERROR: could not read the catch-all's name from both sides")
            failed = True
        elif not seeded.group(1).endswith("/" + named.group(1)):
            print(f"ERROR: the module seeds `{seeded.group(1)}` and the shell")
            print(f"       renders `{named.group(1)}` — two catch-alls, both claiming `*`.")
            failed = True

        if failed:
            sys.exit(1)
        print(f"OK: `{rule}` is in the seed and in every file the shell renders")
        PY
      '';

  # The guard of section 6.3 is only worth anything if it is tested. This check
  # builds the negative fixture, which ONLY passes if the generator refused a
  # token that does not exist.
  icons-unknown-token-fails = mkCheck "icons-unknown-token-fails" [ ] ''
    test -f ${glyphdb.negativeFixture}/out_text.txt \
      || { echo "ERROR: the negative fixture produced no output" >&2; exit 1; }
    grep -q "icon tokens that do not resolve" ${glyphdb.negativeFixture}/out_text.txt \
      || { echo "ERROR: the negative fixture did not fail for the right reason" >&2; exit 1; }
    echo "OK: an icon token that does not exist takes the build down (section 6.3)"
  '';

  # THE SAME GUARD, DOWN THE OTHER BRANCH.
  #
  # `ours-<mark>` resolves against `marks.json` and the marks face, not against
  # `glyphnames.json` and the Nerd Font — a whole second resolution path, whose
  # three failure modes the fixture above cannot reach. It is the same argument
  # that fixture's own comment makes, applied to the branch added beside it.
  marks-unknown-token-fails = mkCheck "marks-unknown-token-fails" [ ] ''
    test -f ${glyphdb.negativeMarkFixture}/out_text.txt \
      || { echo "ERROR: the negative fixture produced no output" >&2; exit 1; }
    grep -q "is not declared in assets/icons/marks.nix" \
      ${glyphdb.negativeMarkFixture}/out_text.txt \
      || { echo "ERROR: the fixture did not fail for the right reason" >&2; exit 1; }
    echo "OK: a mark nobody drew takes the build down"
  '';

  # fontconfig <-> renderer parity — section 6.4.
  #
  # "The renderer does NOT use fontconfig... The shell needs its own fallback
  # chain, COHERENT with fontconfig's."
  #
  # Both come out of nix/fontconfig.nix, from a single list. This check proves
  # that they do agree: if they diverge, the same text renders with different
  # faces inside and outside our buffers, and the symptom ("the accent looks
  # strange in the terminal") is expensive to trace back to here.
  #
  # The renderer's side is simulated by the declared order — it only exists in
  # milestone 3, but the behavior is already determined by the data. When the
  # renderer exists, this script becomes the oracle it is measured against.
  fonts-renderer-parity =
    let
      fontDirs = [
        "${fonts.noctua-iosevka-ttf-nerdfonts}/share/fonts"
        "${pkgs.noto-fonts}/share/fonts"
        "${pkgs.noto-fonts-cjk-sans}/share/fonts"
        "${pkgs.noto-fonts-color-emoji}/share/fonts"
      ];
      # OUR system's fontconfig, not the host's: with our rules and only our
      # fonts. Comparing against the host's fontconfig would prove nothing
      # about the distro.
      #
      # A REAL conf.d, ordered by name — not a sequence of <include> by hand.
      #
      # This matters: including our conf before or after the block of defaults
      # gives different results, and neither of the two reproduces the real
      # system. fontconfig reads `conf.d` in order of file NAME, and that is how
      # `50-ronoctua.conf` positions itself among the default rules. Testing with
      # another order measures a configuration that is never going to exist.
      confd = pkgs.runCommand "ronoctua-test-confd" { } ''
        mkdir -p $out
        ln -s ${pkgs.fontconfig.out}/etc/fonts/conf.d/*.conf $out/ 2>/dev/null || true
        ln -s ${fontconfigConf.confDir}/etc/fonts/conf.d/50-ronoctua.conf $out/50-ronoctua.conf
      '';

      fontsConf = pkgs.writeText "fonts.conf" ''
        <?xml version="1.0"?>
        <!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
        <fontconfig>
          ${lib.concatMapStrings (d: "<dir>${d}</dir>\n  ") fontDirs}
          <cachedir>/tmp/fc-cache</cachedir>
          <include ignore_missing="yes">${confd}</include>
        </fontconfig>
      '';
    in
    mkCheck "fonts-renderer-parity"
      [
        py
        pkgs.fontconfig
      ]
      ''
        export FONTCONFIG_FILE=${fontsConf}
        mkdir -p /tmp/fc-cache
        fc-cache -f >/dev/null 2>&1 || true

        echo "### fc-match on the three generics ###"
        failed=0
        for g in monospace sans-serif serif; do
          m=$(fc-match -f '%{family}' "$g")
          echo "  $g -> $m"
          case "$m" in
            *"NoctuaIosevka Nerd Font Mono"*) ;;
            *) echo "ERROR: '$g' does not resolve to our font (section 6.4)" >&2; failed=1 ;;
          esac
        done
        [ $failed -eq 0 ] || exit 1
        echo

        python3 ${../nix/scripts/check-font-parity.py} \
          --chain-json ${fontconfigConf.chainJson} \
          --font-dir ${fonts.noctua-iosevka-ttf-nerdfonts}/share/fonts \
          --strict
      '';

  # Icon superpack — section 6.6. The manifest has to cover 100% of the names
  # that went in, and the origin licenses all have to be recorded: the
  # repository is publishable (section 9), so "where did this icon come from
  # and under what terms" needs an answer.
  icons-superpack = mkCheck "icons-superpack" [ pkgs.jq ] ''
    sp=${iconSuperpack}
    doc=$sp/share/doc/noctua-icons
    themeName=$sp/share/icons/noctua

    test -f $themeName/index.theme || { echo "ERROR: index.theme is missing" >&2; exit 1; }
    test -f $doc/manifest.json || { echo "ERROR: the manifest is missing" >&2; exit 1; }
    test -f $doc/coverage.md || { echo "ERROR: the coverage report is missing" >&2; exit 1; }

    # Inheritance: hicolor last, as the freedesktop spec requires.
    grep -q '^Inherits=hicolor$' $themeName/index.theme \
      || { echo "ERROR: index.theme does not inherit hicolor last" >&2; exit 1; }

    # Every entry declares a winner and a license — without that the manifest
    # does not answer the question it exists for.
    n=$(jq '.entry_count' $doc/manifest.json)
    complete_ones=$(jq '[.entries[] | select(.winner != null and .license != null)] | length' $doc/manifest.json)
    echo "entries in the manifest: $n"
    [ "$n" -eq "$complete_ones" ] || {
      echo "ERROR: $((n - complete_ones)) entries with no winner or no licence" >&2; exit 1; }

    # Every directory cited in index.theme really exists.
    absent=0
    for d in $(grep '^Directories=' $themeName/index.theme | cut -d= -f2 | tr ',' ' '); do
      [ -d "$themeName/$d" ] || { echo "ERROR: a directory declared but missing: $d" >&2; absent=1; }
    done
    [ $absent -eq 0 ] || exit 1

    # Origin licenses recorded, one per theme that went into the merge.
    for t in $(jq -r '.sources[].name' $doc/manifest.json); do
      test -s "$doc/LICENSES/$t.txt" \
        || { echo "ERROR: the source licence is missing for $t" >&2; exit 1; }
    done

    echo "OK: the manifest covers 100% of the entries, with a winner and a licence"
    echo "OK: source licences recorded for every merged theme"
  '';

  # THE CHAIN'S PIXMAP STEP, against the REAL superpack.
  #
  # The `icons-superpack` above proves that the PACKAGE is well formed; this
  # one proves that the chain REACHES it. They are different things, and the
  # second fails silently: without it, `procurar` would give back `None` for
  # everything, the application list would be left with only the category
  # glyphs — and a whole list of category glyphs LOOKS DELIBERATE. It is the
  # most expensive defect of this path, because it has no symptom at all.
  #
  # It counts OPAQUE pixels: finding the file is not drawing it, and an SVG
  # that rasterizes empty gives an invisible smudge on the dark background —
  # which is indistinguishable from "the icon has not arrived yet".
  apps-icon-from-superpack = mkCheck "apps-icon-from-superpack" [ ] ''
    ${rust.workspace}/bin/ronoctua-test-icons \
      ${iconSuperpack}/share/icons/noctua
  '';

  # ===================================================================
  # NETWORK AND SYNCTHING — does what was TUNED actually reach the system?
  #
  # These two checks evaluate the real NixOS configuration, and not the
  # module's text. The difference matters: a `grep` in the `.nix` would pass
  # with the value written and shadowed by an `mkIf` that never turns on, or
  # with an option renamed by nixpkgs — both cases give a system without the
  # adjustment and a green check. That is exactly how the tray table already
  # passed the build and never reached the Rust.
  # ===================================================================
  networkEval = (pkgs.nixos [ ../nix/modules/network.nix ]).config;
  syncthingEval =
    (pkgs.nixos [
      ../nix/modules/syncthing.nix
      # The Syncthing module reads `config.ronoctua.user`, which belongs to base.
      {
        options = { };
        config.ronoctua.user = "noctua";
      }
      { options.ronoctua.user = lib.mkOption { type = lib.types.str; }; }
    ]).config;

  # The Wi-Fi password sealed in the TPM, against a real TPM (swtpm).
  #
  # The defect it catches is THE PASSWORD STAYING ON DISK — not "the daemon
  # does not come up". A check that only looked at the unit would pass with
  # `psk=<password>` inside the keyfile, which is precisely what this work
  # eliminates.
  wifiTpmVm = import ./wifi-tpm-vm.nix {
    inherit pkgs lib;
    ronoctua-shell = rust.shell;
  };

  network-tuned = mkCheck "network-tuned" [ ] ''
    expected() {
      if [ "$2" != "$3" ]; then
        echo "FAILED: $1 = $2, expected $3" >&2
        echo "" >&2
        echo "This value is NOT decorative: it came out of measuring a" >&2
        echo "592 GB transfer between two machines of this project." >&2
        exit 1
      fi
    }
    # The single biggest gain from the radio. With power saving on, the
    # throughput halves and nothing on screen says why.
    expected "wifi.powersave"       "${lib.boolToString networkEval.networking.networkmanager.wifi.powersave}" "false"
    # BBR without `fq` works WORSE than cubic: it is the classic mistake of
    # turning on only half of it, and that is why both are checked together.
    expected "tcp_congestion_control"       "${
      toString networkEval.boot.kernel.sysctl."net.ipv4.tcp_congestion_control"
    }" "bbr"
    expected "default_qdisc"       "${
      toString networkEval.boot.kernel.sysctl."net.core.default_qdisc"
    }" "fq"
    # The costliest trap in a synchronization: Syncthing pauses between files,
    # and without this every file starts over in slow start.
    expected "tcp_slow_start_after_idle"       "${
      toString networkEval.boot.kernel.sysctl."net.ipv4.tcp_slow_start_after_idle"
    }" "0"
    # Without the module loaded, the BBR sysctl fails at boot — and the failure
    # shows up in the journal, not on the screen.
    case " ${lib.concatStringsSep " " networkEval.boot.kernelModules} " in
      *" tcp_bbr "*) ;;
      *) echo "FAILED: tcp_bbr is not in boot.kernelModules" >&2; exit 1 ;;
    esac
    # AND THE CONNECTIVITY CHECK REACHES THE DAEMON'S OWN FILE.
    #
    # It is `settings.connectivity` and not `connectivity`: the second is not
    # an option of the nixpkgs module, and writing it fails at EVALUATION —
    # which is how it was found, three modules later, with an error naming
    # three options that have nothing to do with it. This line is what stops
    # the value being written somewhere nothing reads.
    #
    # Without the check the daemon answers `full` for any route at all, and
    # the modeline's `no way out` mark could never appear.
    expected "connectivity.uri"       "${
      toString networkEval.networking.networkmanager.settings.connectivity.uri or ""
    }" "http://nmcheck.gnome.org/check_network_status.txt"
    expected "connectivity.interval"       "${
      toString networkEval.networking.networkmanager.settings.connectivity.interval or ""
    }" "300"
    echo "OK: powersave off, BBR+fq, slow start disarmed, the way out measured"
  '';

  syncthing-tuned = mkCheck "syncthing-tuned" [ ] ''
    # ================================================================
    # THE MOST IMPORTANT CHECK IN THIS FILE, and the least obvious.
    #
    # `overrideFolders` is `true` in nixpkgs, and `true` means "whatever is
    # not declared in Nix is DELETED on activation". This module declares no
    # folder at all, because a folder path is personal data (invariant 13) —
    # so the default would DELETE EVERY FOLDER on each `nixos-rebuild`,
    # including the ones the person has just added through the interface,
    # with no warning and no undo.
    #
    # There is no symptom before the damage. Hence the check.
    # ================================================================
    if [ "${lib.boolToString syncthingEval.services.syncthing.overrideFolders}" != "false" ]; then
      echo "FAILED: overrideFolders switched on ERASES the user's folders" >&2
      exit 1
    fi
    if [ "${lib.boolToString syncthingEval.services.syncthing.overrideDevices}" != "false" ]; then
      echo "FAILED: overrideDevices switched on ERASES the paired devices" >&2
      exit 1
    fi
    # UPnP failed every 30 minutes on the measured machine, forever.
    if [ "${lib.boolToString syncthingEval.services.syncthing.settings.options.natEnabled}" != "false" ]; then
      echo "FAILED: natEnabled switched on in a LAN synchronisation" >&2
      exit 1
    fi
    # The relay is a very slow fallback route: with it, a momentary discovery
    # failure drops the transfer to ~1 MB/s with nothing saying so.
    if [ "${lib.boolToString syncthingEval.services.syncthing.settings.options.relaysEnabled}" != "false" ]; then
      echo "FAILED: relaysEnabled lets the transfer fall back to the relay" >&2
      exit 1
    fi
    # The package comes from Nix; self-updating would try to write to /nix/store.
    if [ "${builtins.toString syncthingEval.services.syncthing.settings.options.autoUpgradeIntervalH}" != "0" ]; then
      echo "FAILED: auto-update switched on for a package in the store" >&2
      exit 1
    fi
    echo "OK: override off, no NAT, no relay, no auto-upgrade"
  '';

  # The token generator REFUSES a name that does not become a WIT identifier.
  #
  # The real defect: `wifi-0` was accepted here and broke the build three
  # derivations later, inside a WASM buffer, with the message "invalid
  # character in identifier '0'" pointing at the generated enum — which does
  # not say where the name came from. The check tests BOTH sides: the good
  # name passes, the bad one is refused.
  tokens-wit-name = mkCheck "tokens-wit-name" [ pkgs.python3 ] ''
    python3 - <<'END'
    import importlib.util
    spec = importlib.util.spec_from_file_location("gt", "${../nix/scripts/gen-tokens.py}")
    gt = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(gt)

    for good in ["wifi-weak", "network-secured", "surface.base", "app-firefox"]:
        gt.wit_ident(good)

    for bad in ["wifi-0", "signal-4", "colour-2x"]:
        try:
            gt.wit_ident(bad)
        except SystemExit:
            continue
        raise SystemExit(f"FAILED: `{bad}` passed, and the WIT would refuse it")
    print("OK: the generator refuses a name the WIT does not accept")
    END
  '';

  # THE COLOUR SCIENCE, PROVED — the module every theme value comes out of.
  #
  # `nix/scripts/colorspace.py` is what turns a seed (a hue, a relative chroma,
  # a contrast target) into the bytes on screen: Oklab with conditioned
  # matrices, the analytic sRGB boundary, gamut mapping, APCA, ΔE_ok and the
  # lightness solver. None of it is exercised by `cargo test` — it is Python
  # inside a derivation — so this is where its properties are checked: white
  # is L = 1 exactly, grey has no chroma, the boundary has no kink at the blue
  # primary, mapping is a fixed point, the APCA anchors are the published
  # ±106/108, and the solver re-derives today's accent from its anchor. A theme
  # would still BUILD with any of those broken; the defect would be a colour
  # nobody could trace back.
  colorspace-tests = mkCheck "colorspace-tests" [ pkgs.python3 ] ''
    cd ${../nix/scripts}
    # No pipe: under `set -o pipefail` a failing unittest ends the check at
    # once, with its whole log, which is what a failure should look like.
    python3 -m unittest -v test_colorspace
    echo "OK: the colour science holds"
  '';

  # ===================================================================
  # THEMES — declared once, solved by the generator, proved against the
  # palette they were derived from.
  # ===================================================================

  # Same closure as `languages-are-declared`: the list in
  # `assets/themes/themes.nix` and the seed files on disk are the same set —
  # a seed that is present and undeclared would be solved by nobody and shown
  # to nobody — and the first is the default.
  themes-are-declared = mkCheck "themes-are-declared" [ pkgs.coreutils pkgs.gnused pkgs.gnugrep ] ''
    declared=$(printf '%s\n' ${lib.escapeShellArgs themes} | sort)
    present=$(cd ${../assets/themes} && ls *.nix | grep -v '^themes\.nix$' | grep -v '\.reference\.nix$' | sed 's/\.nix$//' | sort)

    if [ "$declared" != "$present" ]; then
      echo "ERROR: the declared themes and the seed files on disk differ." >&2
      echo "  declared in assets/themes/themes.nix:" >&2
      printf '    %s\n' $declared >&2
      echo "  present in assets/themes:" >&2
      printf '    %s\n' $present >&2
      exit 1
    fi

    # A frozen reference belongs to a declared theme.
    for r in $(cd ${../assets/themes} && ls *.reference.nix 2>/dev/null); do
      id=''${r%.reference.nix}
      printf '%s\n' $declared | grep -qx "$id" || {
        echo "ERROR: $r is a reference for a theme that is not declared." >&2; exit 1; }
    done

    # THE DEFAULT IS DECLARED BY NAME, and it is no longer the first — see
    # `assets/themes/themes.nix`. So it has to be checked: a name that is not
    # in `order` would reach the NixOS option's enum as a default outside its
    # own type, and the failure would name the option rather than the file.
    base=${defaultTheme}
    printf '%s\n' $declared | grep -qx "$base" || {
      echo "ERROR: the default theme $base is not one of the declared ones." >&2; exit 1; }
    test -f ${../assets/themes}/$base.nix || {
      echo "ERROR: the default theme $base has no seed file" >&2; exit 1; }

    echo "OK: $(printf '%s\n' $declared | wc -l) themes, declared and present, default $base"
  '';

  # THE REGRESSION, AS A NAMED CHECK. The generator already fails the build
  # when a solved value drifts from a frozen reference by more than ΔE_ok 0.03
  # without a listed deviation; here the number is on screen for every theme
  # that carries one, so a drift is read as a distance and not as a missing
  # derivation.
  theme-references-hold =
    let
      # The themes that carry a frozen reference beside their seed — today the
      # one the palette was designed on; the check names none of them.
      withReference = builtins.filter (
        id: builtins.pathExists (../assets/themes + "/${id}.reference.nix")
      ) themes;
    in
    mkCheck "theme-references-hold" [ pkgs.python3 ] ''
      test -n "${lib.concatStringsSep " " withReference}" || {
        echo "ERROR: no theme carries a reference; the regression proves nothing" >&2; exit 1; }
      python3 - ${themed}/report.json ${lib.escapeShellArgs withReference} <<'PY'
      import json, sys
      report = json.load(open(sys.argv[1]))
      for theme in sys.argv[2:]:
          if theme not in report:
              sys.exit(f"ERROR: the report has no `{theme}`")
          rows = [f for f in report[theme]["findings"]
                  if f["gate"] == "regression" and not f["subject"].endswith(" alpha")]
          if not rows:
              sys.exit(f"ERROR: no regression rows for {theme}: its reference is not being compared")
          bad = [f for f in rows if f["level"] == "Fail"]
          for f in bad:
              print(f"ERROR: {theme}: {f['subject']} drifted ΔE_ok {f['measured']:.4f} ({f['note']})", file=sys.stderr)
          if bad:
              sys.exit(1)
          worst = max(rows, key=lambda f: f["measured"])
          noted = [f["subject"] for f in rows if f["level"] == "Note"]
          print(f"OK: {theme}: {len(rows)} keys within ΔE_ok 0.03 of its reference, or a listed ceiling;"
                f" worst {worst['subject']} at {worst['measured']:.4f};"
                f" {len(noted)} listed deviation(s): {', '.join(noted) or 'none'}")
      PY
    '';

  # THE GATES BITE. A seed that puts the accent inside the band where it
  # collapses onto red under protanopia has to FAIL to build, with the gate
  # and the number on screen. The positive path is proved by every build; the
  # negative is what needs a check of its own — the same shape as the syntax
  # table's fixture.
  themes-negative =
    let
      # ANY declared seed will do — this one only needs a valid starting point
      # to spoil. It takes the first because there always is one, and NOT
      # because the first means anything: the default is declared by name now.
      base = import (../assets/themes + "/${builtins.head themes}.nix");
      bad = base // {
        families = base.families // {
          accent = base.families.accent // {
            hue = 165;
          };
        };
      };
      json = name: value: pkgs.writeText name (builtins.toJSON value);
    in
    mkCheck "themes-negative" [ pkgs.python3 ] ''
      mkdir generator
      cp ${../nix/scripts/colorspace.py} generator/colorspace.py
      cp ${../nix/scripts/gen-theme.py} generator/gen-theme.py
      if python3 generator/gen-theme.py \
          --themes ${json "themes.json" [ "bad" ]} \
          --seed bad=${json "bad.seed.json" bad} \
          --recipes ${json "colors.json" (import ../assets/tokens/colors.nix)} \
          --out out > log 2>&1; then
        echo "ERROR: a seed with the accent at 165° built; the gates are not biting." >&2
        cat log >&2
        exit 1
      fi
      grep -q "protan band" log || {
        echo "ERROR: the build failed, but not on the hue gate:" >&2; cat log >&2; exit 1; }
      echo "OK: the generator refuses an accent in the protan band, naming the gate"
    '';

  # NO HEX IN THE TOKENS, AND NO SECOND SOURCE OF COLOUR.
  #
  # `assets/tokens/colors.nix` is recipes and the seeds are hues and chromas:
  # a `0xRRGGBBAA` in either is a colour that escaped the generator, which is
  # invariant 9 with one wall fewer. The frozen reference is a FIXTURE the
  # report compares against, and nothing but `nix/themes.nix` may import it —
  # a second reader would make it a second palette. And nobody imports
  # `colors.nix` at evaluation any more: its values do not exist there.
  colours-are-computed = mkCheck "colours-are-computed" [ pkgs.gnugrep ] ''
    seeds=$(ls ${../assets/themes}/*.nix | grep -v '\.reference\.nix$')
    if grep -nE '0x[0-9A-Fa-f]{8}' ${../assets/tokens/colors.nix} $seeds; then
      echo "ERROR: a colour literal in a recipe or a seed." >&2
      echo "      Colours are SOLVED by nix/scripts/gen-theme.py from hues and" >&2
      echo "      contrast targets; a hex here is one the gates never measured." >&2
      exit 1
    fi

    readers=$(grep -rnE '(import|readFile)[^;]*\.reference\.nix' ${self}/nix ${self}/tests ${self}/flake.nix ${self}/crates \
      | grep -v '^${self}/nix/themes.nix:' || true)
    if [ -n "$readers" ]; then
      echo "ERROR: the frozen reference is read outside nix/themes.nix:" >&2
      echo "$readers" >&2
      exit 1
    fi

    importers=$(grep -rnE 'import[^;]*assets/tokens/colors\.nix' ${self}/nix ${self}/tests ${self}/flake.nix \
      | grep -v '^${self}/nix/themes.nix:' | grep -v '^${self}/tests/checks.nix:' || true)
    if [ -n "$importers" ]; then
      echo "ERROR: colors.nix is imported at evaluation; it holds recipes, not values:" >&2
      echo "$importers" >&2
      exit 1
    fi
    echo "OK: no colour literal outside the generator, one reader of the reference"
  '';

  # THE FRAGMENTS EVERY THEME SHIPS FOR THE CONSUMERS OUTSIDE THE SHELL — and
  # the compositor's own parser on the compositor's two. The footer copies
  # these files verbatim when the theme or the desk changes; a fragment the
  # compositor refused would be a border that never follows, with the refusal
  # in a log nobody reads and a nag window this distro turns off.
  #
  # EACH ONE IS VALIDATED UNDER A CONFIG THAT ALREADY PAINTS A DESK, as the
  # system's does (`output * bg`). That is the line the whole arrangement
  # stands on: output settings here are MERGED, last-wins per field
  # (`get_output_config`), so the fragment's `output * bg` beats the one
  # already there instead of colliding with it. The previous compositor needed
  # this subtest for the opposite reason — it refused a duplicate `layout`
  # inside one file and merged an included one — and the shape of the proof is
  # the same either way: put the fragment under a config that already says the
  # thing it says.
  themes-have-fragments =
    mkCheck "themes-have-fragments"
      [
        scroll
        pkgs.gnugrep
        pkgs.jq
      ]
      ''
        # The compositor's own parser, in a sandbox — see
        # `compositor-config-valid` for the two variables that make that
        # possible and for why the verdict is the OUTPUT and never `$?`.
        export XDG_RUNTIME_DIR="$PWD/run"
        mkdir -p "$XDG_RUNTIME_DIR"
        export WLR_BACKENDS=headless
        export WLR_RENDERER=pixman

        for id in ${lib.escapeShellArgs themes}; do
          d=${themed}/$id
          for f in compositor-border-active compositor-border-inactive compositor-background scroll-black.conf scroll-backdrop.conf ghostty.conf mode; do
            test -s "$d/$f" || { echo "ERROR: the theme $id has no fragment $f" >&2; exit 1; }
          done
          for f in compositor-border-active compositor-border-inactive compositor-background; do
            grep -qE '^#[0-9A-F]{6}$' "$d/$f" || {
              echo "ERROR: $id/$f is not a #RRGGBB: $(cat "$d/$f")" >&2; exit 1; }
          done
          # THE SEVENTH IS NOT A COLOUR, so it is read rather than matched
          # against a hex: `nix/modules/foreign.nix` branches on this word and
          # an unknown one would leave GTK and Qt wearing the wrong side.
          case "$(cat "$d/mode")" in
            dark|light) ;;
            *) echo "ERROR: the theme $id says its mode is '$(cat "$d/mode")'" >&2; exit 1 ;;
          esac
          for f in scroll-black.conf scroll-backdrop.conf; do
            printf 'output * bg #123456 solid_color\ninclude "%s"\n' "$d/$f" > "$id.conf"
            scroll --validate --config "$id.conf" > said.txt 2>&1 || true
            grep -q 'Error' said.txt && {
              echo "ERROR: the compositor refuses $id/$f under a config that already paints a desk:" >&2
              cat said.txt >&2; exit 1; }
            grep -qE '^client\.focused #' "$d/$f" || {
              echo "ERROR: $id/$f carries no border" >&2; exit 1; }
          done
          # The desk each fragment names: black by name, and the theme's own
          # `surface.backdrop` — the same bytes the shell's table has.
          grep -qE '^output \* bg #000000 solid_color$' "$d/scroll-black.conf" || {
            echo "ERROR: $id/scroll-black.conf does not paint black" >&2; exit 1; }
          desk=$(jq -r '."surface.backdrop"' "${themed}/$id.json" | sed -E 's/^0x([0-9A-F]{6})FF$/#\1/')
          grep -qE "^output \* bg $desk solid_color$" "$d/scroll-backdrop.conf" || {
            echo "ERROR: $id/scroll-backdrop.conf does not paint the theme's desk $desk:" >&2
            grep 'output \*' "$d/scroll-backdrop.conf" >&2; exit 1; }
          grep -q '^palette = 15=#' "$d/ghostty.conf" || {
            echo "ERROR: $id/ghostty.conf has no sixteenth ANSI colour" >&2; exit 1; }
        done
        echo "OK: every theme carries its seven fragments, and the compositor merges each desk over one already painted"
      '';

  # GHOSTTY STILL RELOADS ON THE SIGNAL THIS SYSTEM SENDS.
  #
  # "toolkits::wake_the_terminals" sends SIGUSR2 so a size chosen in
  # `LEADER s d` reaches the terminals that are ALREADY OPEN. Without it the
  # new file would only be read by the next window, and the person would have a
  # row of terminals in yesterday's size beside a footer in today's.
  #
  # THE SIGNAL IS NOT IN THE MANUAL. Neither man page mentions USR2; what
  # exists is the string below, in the binary, under Ghostty's own
  # "gtk_ghostty_application" log scope — so this is observed behaviour of the
  # version this system pins, not a promise anybody made. SIGUSR1, which is the
  # signal one would guess, appears nowhere.
  #
  # That is exactly why it needs a check rather than a comment: the day an
  # upgrade drops it, the terminal quietly keeps the old size and nothing else
  # in this repository would notice. Here it goes red and says what to do.
  ghostty-reloads-on-a-signal = mkCheck "ghostty-reloads-on-a-signal" [ pkgs.binutils ] ''
    # The wrapper is a small C program; the Zig binary beside it carries the
    # strings.
    real=${pkgs.ghostty}/bin/.ghostty-wrapped
    test -x "$real" || real=${pkgs.ghostty}/bin/ghostty
    strings -n 8 "$real" > said || { echo "ERROR: could not read $real" >&2; exit 1; }

    grep -q "received SIGUSR2, reloading configuration" said || {
      echo "ERROR: Ghostty ${pkgs.ghostty.version} no longer reloads on SIGUSR2." >&2
      echo "" >&2
      echo "       toolkits::wake_the_terminals sends that signal so a size" >&2
      echo "       chosen in the display view reaches terminals that are" >&2
      echo "       already open. Without it they keep the old size until they" >&2
      echo "       are reopened, and nothing on the screen says why." >&2
      echo "" >&2
      echo "       What to do: find what this version reloads on — a keybind" >&2
      echo "       action reload_config is documented — and change" >&2
      echo "       wake_the_terminals and this check together." >&2
      exit 1; }

    # AND THE SIGNAL IS THE ONE WE SEND. Reading the binary proves nothing if
    # the shell sends a different one, and SIGUSR1 is the guess.
    #
    # THE ARGUMENT, NOT THE WORD, AND WITH THE COMMENTS GONE. The first
    # version of this grepped the file for "USR2" and passed while the shell
    # sent USR1 — because the paragraph explaining the signal says USR2 four
    # times. A rule a sentence can satisfy is worse than no rule.
    sed 's|//.*||' ${../crates/ronoctua-shell/src/toolkits.rs} | grep -q '"-USR2"' || {
      echo "ERROR: the shell does not send SIGUSR2, so open terminals keep their size" >&2
      exit 1; }

    echo "OK: Ghostty ${pkgs.ghostty.version} reloads on SIGUSR2, and that is what the shell sends"
  '';

  # GHOSTTY WEARS THE THEME: the palette solved for the machine's default, and
  # after it the person's own, optional — AFTER, because in Ghostty the later
  # file wins, and a machine that never chose has no second file at all.
  ghostty-config-includes-theme =
    let
      vm = self.nixosConfigurations.vm.config;
      text = vm.home-manager.users.${vm.ronoctua.user}.xdg.configFile."ghostty/config".text;
    in
    mkCheck "ghostty-config-includes-theme"
      [
        pkgs.gnugrep
        pkgs.ghostty
      ]
      ''
        cfg=${pkgs.writeText "ghostty-config" text}
        grep -n '^config-file = ' "$cfg" > lines || {
          echo "ERROR: Ghostty's config includes no palette" >&2; exit 1; }
        # THREE, AND IN THIS ORDER — the later file wins in Ghostty, so the
        # order IS the precedence: the machine's palette, then the theme the
        # person chose, then the size they chose. A size ahead of the palette
        # would be overwritten by a file that carries no size at all.
        test "$(wc -l < lines)" -eq 3 || {
          echo "ERROR: three config-file lines were expected:" >&2; cat lines >&2; exit 1; }
        sed -n 1p lines | grep -q '/ghostty.conf$' || {
          echo "ERROR: the first include is not the generated palette:" >&2; cat lines >&2; exit 1; }
        sed -n 2p lines | grep -q '= ?/home/.*/.config/ronoctua/ghostty-theme.conf$' || {
          echo "ERROR: the second include is not the person's optional theme:" >&2; cat lines >&2; exit 1; }
        # AND THE SIZE, LAST. `LEADER s d` moves one number and the terminal
        # has to move with everything else; `toolkits::tell_them` writes this
        # file. It is separate from the theme's on purpose — that one is copied
        # WHOLE out of the store, so a size written into it would be erased by
        # the next change of theme.
        sed -n 3p lines | grep -q '= ?/home/.*/.config/ronoctua/ghostty-size.conf$' || {
          echo "ERROR: the third include is not the person's optional size:" >&2; cat lines >&2; exit 1; }

        # AND THE SIZE IN THE CONFIG IS THE TOKEN'S, not a number typed twice.
        # `toolkits::tell_them` scales `font::TERMINAL_POINTS`; if the module
        # wrote a different base the terminal would sit at a size of its own.
        grep -qE "^font-size = ${toString (import ../assets/tokens/typography.nix).size.terminalPoints}$" "$cfg" || {
          echo "ERROR: Ghostty's font-size is not font.size.terminalPoints:" >&2
          grep -n '^font-size' "$cfg" >&2; exit 1; }
        palette=$(head -1 lines | sed 's/.*= //')
        grep -qE '^palette = 0=#[0-9A-F]{6}$' "$palette" || {
          echo "ERROR: the generated palette has no ANSI 0: $palette" >&2; exit 1; }

        # AND THE BINARY READS IT. Ghostty's only default path is
        # `$XDG_CONFIG_HOME/ghostty/config`, which is where home-manager puts
        # this text on the machine; here the same layout is built in a scratch
        # home and the EFFECTIVE configuration is asked for — the text alone
        # proves nothing about what the program does with it. (`+show-config`
        # takes no config flags: a `--config-file` route could not be proved.)
        export HOME=$TMPDIR/home XDG_CONFIG_HOME=$TMPDIR/xdg
        mkdir -p "$HOME" "$XDG_CONFIG_HOME/ghostty"
        # THE TWO OPTIONAL INCLUDES ARE ABSOLUTE, with the person's user name
        # baked in at build time, so nothing a sandbox can set redirects them —
        # `docs/PENDING.md` 0.000017 records the same shape for the compositor
        # fragments. Their SPELLING is asserted above, off the module's own
        # text; here they are pointed at this scratch home so the MECHANISM can
        # be measured, which is the half no grep can reach.
        sed "s|= ?/home/[^/]*/\.config/ronoctua/|= ?$HOME/.config/ronoctua/|" "$cfg" \
          > "$XDG_CONFIG_HOME/ghostty/config"
        ghostty +show-config > effective 2> errors.txt || {
          echo "ERROR: Ghostty refused the system's config:" >&2; cat errors.txt >&2; exit 1; }
        grep -q '^window-decoration = none$' effective || {
          echo "ERROR: the decoration line did not reach Ghostty:" >&2; cat effective >&2; exit 1; }
        grep -qiE '^palette = 0=#[0-9a-f]{6}$' effective || {
          echo "ERROR: the palette did not reach Ghostty:" >&2; cat effective >&2; exit 1; }

        # AND THE SIZE THE PERSON CHOSE REACHES IT — MEASURED, not argued.
        #
        # This is the one end-to-end proof in the repository that a size chosen
        # in `LEADER s d` arrives at a foreign application. The shell writes
        # `ghostty-size.conf`; here that file is laid down exactly as
        # `toolkits::tell_them` writes it, and Ghostty is asked what its
        # EFFECTIVE font size is. If the include is wrong, if the order is
        # wrong, or if the later file stops winning, this number does not move.
        #
        # 200% is used because it is the ceiling of the range and doubles a
        # number no rounding can blur.
        base=$(grep '^font-size = ' "$cfg" | sed 's/.*= //')
        want=$(awk -v b="$base" 'BEGIN { printf "%.1f", b * 2 }')
        mkdir -p "$HOME/.config/ronoctua"
        printf '# GENERATED by ronoctua-shell. Do not edit — `LEADER s d` rewrites it.\nfont-size = %s\n' "$want" \
          > "$HOME/.config/ronoctua/ghostty-size.conf"
        ghostty +show-config > doubled 2> errors.txt || {
          echo "ERROR: Ghostty refused the size file:" >&2; cat errors.txt >&2; exit 1; }
        said=$(grep '^font-size = ' doubled | sed 's/.*= //')
        awk -v a="$said" -v b="$want" 'BEGIN { exit (a - b < 0.05 && b - a < 0.05) ? 0 : 1 }' || {
          echo "ERROR: the size the person chose did not reach Ghostty." >&2
          echo "       the file said $want and the binary reports $said" >&2
          echo "" >&2
          echo "       This is what makes the terminal follow LEADER s d. If the" >&2
          echo "       third config-file include, or its order, or the name of" >&2
          echo "       the file changes, the terminal silently keeps its own" >&2
          echo "       size while everything around it moves." >&2
          exit 1; }

        echo "OK: Ghostty reads the system's config, its palette, and the size the person chose ($base -> $said)"
      '';

  # GHOSTTY'S WINDOWS ARE PROCESSES THROUGH EVERY DOOR. The module's config says
  # `gtk-single-instance = false`; the upstream desktop entry says
  # `--gtk-single-instance=true` on its `Exec` lines, and a flag beats the
  # file; its `DBusActivatable=true` sends D-Bus-aware launchers through a
  # service that is single-instance by construction. `nix/modules/terminal.nix`
  # rewrites the entry; this measures the one that is installed, so an
  # upstream change cannot bring either back unseen — and it passes on the day
  # upstream drops them itself.
  ghostty-windows-are-processes =
    let
      package = self.nixosConfigurations.vm.config.ronoctua.terminal.package;
    in
    mkCheck "ghostty-windows-are-processes" [ pkgs.gnugrep ] ''
      entry=${package}/share/applications/com.mitchellh.ghostty.desktop
      test -e "$entry" || { echo "ERROR: no desktop entry at $entry" >&2; exit 1; }
      if grep -q -- 'gtk-single-instance=true' "$entry"; then
        echo "ERROR: the installed Ghostty entry still forces a single instance:" >&2
        grep -n 'Exec' "$entry" >&2
        exit 1
      fi
      if grep -q '^DBusActivatable=true' "$entry"; then
        echo "ERROR: the installed Ghostty entry still offers D-Bus activation, which is single-instance" >&2
        exit 1
      fi
      if test -e ${package}/share/dbus-1/services/com.mitchellh.ghostty.service; then
        echo "ERROR: the single-instance D-Bus service is still installed beside the entry" >&2
        exit 1
      fi
      test "$(grep -c '^Exec=' "$entry")" -ge 1 || {
        echo "ERROR: the rewritten entry lost its Exec line" >&2; exit 1; }
      grep -q '^Exec=/nix/store/.*/bin/ghostty' "$entry" || {
        echo "ERROR: the entry's Exec no longer points at Ghostty's binary:" >&2; grep -n '^Exec' "$entry" >&2; exit 1; }
      echo "OK: Ghostty's desktop entry opens a process per window, as the config says"
    '';

  # FOREIGN APPLICATIONS WEAR THE THEME'S SIDE, in the three places the toolkits
  # ask: GTK's two `settings.ini`, the settings portal's dconf, Qt's style.
  #
  # IT USED TO ASSERT A CONSTANT, and the constant was right nine times out of
  # nine — every theme was dark, so `prefer-dark` was both the answer and the
  # only answer. `flashbang` is the tenth and it is light, so what this has to
  # say is a RELATION: the three places agree with each other, and all three
  # agree with the `mode` fragment the generator wrote for the declared theme.
  # Written as a constant it would now be a check that passes while every
  # foreign window on a light desktop stays black.
  #
  # BOTH SIDES ARE BUILT, and that is the half that makes it a relation rather
  # than a coincidence: the system is evaluated twice, once with a dark theme
  # and once with the light one, and the answers have to differ.
  foreign-apps-prefer-dark =
    let
      dressed =
        name:
        let
          vm =
            (self.nixosConfigurations.vm.extendModules {
              modules = [ { ronoctua.theme = name; } ];
            }).config;
          scheme = lib.findFirst (v: v != null) null (
            map (
              db: db.settings."org/gnome/desktop/interface".color-scheme or null
            ) vm.programs.dconf.profiles.user.databases
          );
        in
        {
          inherit name scheme;
          mode = lib.removeSuffix "\n" (builtins.readFile "${themed}/${name}/mode");
          gtk3 = pkgs.writeText "gtk3-${name}" vm.environment.etc."xdg/gtk-3.0/settings.ini".text;
          gtk4 = pkgs.writeText "gtk4-${name}" vm.environment.etc."xdg/gtk-4.0/settings.ini".text;
          qt = if vm.ronoctua.foreign.qt then toString vm.qt.style else null;
        };
      # A dark one and the light one. Named by their MODE and not by their ids,
      # so the day another light theme is added this picks one of each on its
      # own rather than going on asserting something about two names.
      byMode = lib.groupBy (id: lib.removeSuffix "\n" (builtins.readFile "${themed}/${id}/mode")) themes;
      sides = map dressed [
        (builtins.head (byMode.dark or [ ]))
        (builtins.head (byMode.light or [ ]))
      ];
      says = one: ''
        echo "-- ${one.name} (${one.mode})"
        for f in ${one.gtk3} ${one.gtk4}; do
          test "$(grep -c '^\[Settings\]$' "$f")" -eq 1 || {
            echo "ERROR: $f has not exactly one [Settings] header" >&2; exit 1; }
          grep -q "^gtk-application-prefer-dark-theme=${if one.mode == "dark" then "1" else "0"}$" "$f" || {
            echo "ERROR: $f does not wear ${one.mode}" >&2; grep -n 'prefer-dark' "$f" >&2; exit 1; }
        done
        test "${toString one.scheme}" = "${
          if one.mode == "dark" then "prefer-dark" else "prefer-light"
        }" || {
          echo "ERROR: dconf answers ${toString one.scheme} to the portal for a ${one.mode} theme" >&2; exit 1; }
        ${lib.optionalString (one.qt != null) ''
          test "${one.qt}" = "${if one.mode == "dark" then "adwaita-dark" else "adwaita"}" || {
            echo "ERROR: Qt's style is ${one.qt} for a ${one.mode} theme" >&2; exit 1; }
        ''}
      '';
    in
    mkCheck "foreign-apps-prefer-dark" [ pkgs.gnugrep ] ''
      ${lib.optionalString (byMode.dark or [ ] == [ ] || byMode.light or [ ] == [ ]) ''
        echo "ERROR: this check needs one theme of each mode to compare; the fragments name only one side." >&2
        exit 1
      ''}
      ${lib.concatStringsSep "\n" (map says sides)}
      echo "OK: GTK, the portal and Qt wear the declared theme's own side — measured on one of each"
    '';

  # ===================================================================
  # INVARIANT 18 — every NAME is English; every COMMENT is English too.
  #
  # The `AGENTS.md` already said "identifiers in English" and it was never met:
  # there were 54 ids, 90 checks, ~35 files and 358 keys in Portuguese. A rule
  # with no check is a recommendation, and a recommendation is what produced
  # that distance between what the repository asserts and what it does.
  #
  # WHY A DENY LIST, AND NOT "detect Portuguese"
  # --------------------------------------------
  # Detecting a language in general is impossible in a check. Refusing EXACTLY
  # the words that have already been here is possible, honest, and it is what
  # stops the regression — which is the real risk: someone adds `rede-abrir`
  # again out of habit.
  #
  # IT SWEEPS NAMES, NOT PROSE. It looks at: file paths, the `.ftl` key column,
  # and — since the identifier pass — every Rust declaration: `fn`, `struct`,
  # `enum`, `trait`, `const`, `static` and `mod`.
  #
  # It does NOT sweep comments, and that is not because they are exempt —
  # the owner moved them to English, so the second half of the invariant now
  # covers only the four documents, the key VALUES and the search tags.
  # Detecting "this comment is in Portuguese" is the same impossible
  # language detection the deny list exists to avoid; what guards the
  # comments is the sweep that translated them, not a check.
  #
  # THE DECLARATION IS READ ON ITS OWN LINE, and the sweep is deliberately
  # blind to a use: `let rede = …` is not caught here. Catching every local
  # would mean parsing Rust, and a check that needs a parser to be right is a
  # check that goes wrong on its own. What it does catch is what OTHER code
  # sees — and that is where a Portuguese name spreads from.
  english-names = mkCheck "english-names" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # The stems this refactor removed. Adding here is cheap; taking one out
    # requires explaining why the word became acceptable again.
    FORBIDDEN = [
         "aberto", "abrir", "acao", "achada", "achados", "achou", "acoes",
         "carga", "criar", "globais", "leitura", "ordens",
         "abaixo", "acha", "achado", "acorde", "acordes", "alca", "alta", "alternar",
         "andando", "apagar", "arredondar", "atencao", "ativar", "atuais", "atual",
         "atualizando", "aviso", "barra", "branco", "bruta", "cabem", "caixa",
         "caixas", "candidatas", "caractere", "carinhas", "casa", "casal", "cerebro",
         "completos", "componente", "conexao", "conexoes", "conj",
         "contando", "copia", "copias", "custo", "dedo", "degrau", "desde", "desenhado",
         "dicas", "diferentes", "digita", "direto", "diretorio", "documento",
         "eixo", "embutido", "empurrar", "enormes", "envio", "erros", "escalada",
