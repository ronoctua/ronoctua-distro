    removed = re.search(r'\["sub-remove"', merged)
    if not added:
        wrong.append("the merged arm no longer adds the new script with `sub-add … select`")
    if not removed:
        wrong.append("the merged arm no longer removes the script it replaces")
    if added and removed and removed.start() < added.start():
        wrong.append("the old merged script is removed before the new one is added: the picture blinks bare at every change of lane")
    if added and removed and removed.start() > added.start() and not re.search(r"if\s+let\s+Some\(\s*old\s*\)\s*=\s*d\.merged\.replace\(", merged[added.end():removed.start()]):
        wrong.append("the old script removed is not the one the new replaced (`d.merged.replace(id)`)")

    for w in wrong:
        print(f"ERROR: {w}", file=sys.stderr)
    if wrong:
        raise SystemExit(1)
    print("OK: a new merged script is added and selected before the old one goes")
    END
  '';

  # AN AMBIENT SOUND NEVER STARTS BY ITSELF.
  #
  # Rain, a fire, a café: the player remembers each sound's VOLUME across
  # restarts, and never whether it was on. A sound that came back on when
  # the player started — after a reboot, at three in the morning — is a
  # noise nobody chose. So what is kept (`Remembered`) has no switch in it,
  # `Ambience::open` starts no mpv, and every channel of the mixer is born
  # off; a sound plays when somebody turns it on.
  ambience-never-starts-alone = mkCheck "ambience-never-starts-alone" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())
    exec(open("${offeredHelpers}").read())

    # Narrowed by name: `struct Remembered`, `Ambience::open`, `Mixer::new`.
    engine = code_of(product(pathlib.Path("${../crates/ronoctua-player-engine/src/engine/ambience.rs}").read_text()))
    mixer = code_of(product(pathlib.Path("${../crates/ronoctua-player/src/ambience.rs}").read_text()))
    floor(len(engine), 5000, "characters of engine/ambience.rs")
    floor(len(mixer), 5000, "characters of the player's ambience.rs")
    wrong = []

    kept = must(scope(engine, r"\nstruct Remembered\s*"), "`struct Remembered`")
    fields = re.findall(r"(\w+)\s*:\s*([^,]+),", kept)
    floor(len(fields), 1, "fields of `Remembered`")
    for name, kind in fields:
        if kind.strip() == "bool" or re.search(r"\b(on|playing|chosen|active|enabled|started|running|sounds|ids)\b", name):
            wrong.append(f"`Remembered` keeps `{name}: {kind.strip()}`: a sound's switch is not remembered, only its volume")
    if not any(name == "volumes" for name, _ in fields):
        wrong.append("`Remembered` no longer keeps the volumes: what is this checking?")

    impl = must(scope(engine, r"\nimpl Ambience\s*"), "`impl Ambience`")
    opened = must(body_of(impl, "open"), "`Ambience::open`")
    m = re.search(r"\bopen_player\s*\(|\bMpv::new\s*\(|loadfile|\bturn\w*\s*\(|\.on\s*\(", opened)
    if m:
        wrong.append(f"`Ambience::open` starts a sound (`{m.group(0)}`): the player opens with every sound off")
    if not re.search(r"players\s*:\s*Vec::new\(\)", opened):
        wrong.append("`Ambience::open` does not begin with no sound playing (`players: Vec::new()`)")

    born = must(body_of(mixer, "new"), "`Mixer::new`")
    if not re.search(r"\bon\s*:\s*false\b", born) or re.search(r"\bon\s*:\s*true\b", born):
        wrong.append("`Mixer::new` no longer makes every channel off")

    for w in wrong:
        print(f"ERROR: {w}", file=sys.stderr)
    if wrong:
        raise SystemExit(1)
    print("OK: only the volumes are remembered, and the player opens with every ambient sound off")
    END
  '';

  # THE AMBIENT SOUNDS LIVE APART FROM THE QUEUE.
  #
  # Rain under a film is two players in one daemon: the queue's voices and
  # the ambience's own mpvs, each with its own volume on the sound server.
  # They meet in exactly three places of the engine — the four `Ask::Ambient…`
  # arms of `carry` that a door's order arrives by, `state()` that says what
  # the mixer holds, and `farewell()` that ends them with the player — and
  # the ambience's code never reaches the queue or its voices. Anything else
  # is the queue pausing the rain, or a lane change stopping a sound.
  ambience-apart-from-the-queue = mkCheck "ambience-apart-from-the-queue" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())
    exec(open("${offeredHelpers}").read())

    # FILE-WIDE: a reach of the ambience may be written in any file of the
    # engine, so each is the question, attributed to its function; `carry`
    # is narrowed by name for its four arms.
    engine = pathlib.Path("${../crates/ronoctua-player-engine/src}")
    wrong = []


    MEET = {"state", "farewell"}
    DOORS = {"ambient", "ambient_volume", "ambient_silence", "ambient_toggle"}
    met, doors, swept = set(), {}, 0
    for f in sorted(engine.rglob("*.rs")):
        if f.name == "tests.rs" or f.name == "ambience.rs":
            continue
        code = code_of(product(f.read_text()))
        swept += 1
        rel = str(f.relative_to(engine))
        for m in re.finditer(r"\b(?:self|e)\.ambience\b", code):
            where = owner(code, m.start())
            if rel == "engine.rs" and where in MEET:
                met.add(where)
            else:
                wrong.append(f"{rel} reaches the ambient sounds in `{where}`: they meet the queue only in `carry`, `state` and `farewell`")
        for m in re.finditer(r"\.(ambient(?:_volume|_silence|_toggle)?)\s*\(", code):
            doors.setdefault(m.group(1), []).append((rel, owner(code, m.start())))
    floor(swept, 15, "files of the engine swept")
    for where in sorted(MEET - met):
        wrong.append(f"`{where}` no longer reaches the ambient sounds: what is this checking?")
    for door in sorted(DOORS):
        callers = doors.get(door, [])
        if callers != [("engine.rs", "carry")]:
            wrong.append(f"`{door}` is called from {callers or 'nowhere'}: only from `carry`'s `Ask::Ambient…` arm")

    # THE AMBIENCE'S OWN CODE NEVER REACHES THE QUEUE.
    own = code_of(product((engine / "engine" / "ambience.rs").read_text()))
    floor(len(own), 5000, "characters of engine/ambience.rs")
    m = re.search(r"\bself\.(queue|voices|session|window|subtitles|loaded)\b|\bstate\.current\b", own)
    if m:
        wrong.append(f"engine/ambience.rs reaches the queue (`{m.group(0)}`, in `{owner(own, m.start())}`)")

    for w in wrong:
        print(f"ERROR: {w}", file=sys.stderr)
    if wrong:
        raise SystemExit(1)
    print("OK: the ambient sounds meet the queue only in carry's four arms, state() and farewell()")
    END
  '';

  # EVERY LANGUAGE OF CONTENT HAS A NAME ON SCREEN.
  #
  # `assets/tongues.nix` lists the languages a subtitle, a lyric or a film's
  # track can be in, and `nix/tongues.nix` turns it into the player's table
  # and the keys it is named by (`tongue-<code>`). The doors ask for a name
  # by a key BUILT from a code (`tongues::name_key`), which no census of
  # literal keys sees: a row added to the table without its two texts is a
  # language said as its raw code. The twin of `channels-have-text`.
  tongue-keys-exist =
    let
      tongues = pkgs.callPackage ../nix/tongues.nix { tonguesFile = ../assets/tongues.nix; };
    in
    mkCheck "tongue-keys-exist" [ pkgs.python3 ] ''
      python3 - <<'PY'
      import pathlib, re, sys
      exec(open("${pyPrelude}").read())
      exec(open("${offeredHelpers}").read())

      # PARSED: the generator's key list, one per line, and the merged
      # catalogues' module-level keys; the crate's `include!` is read with
      # `uncommented` (the needle is the path, a string literal).
      # FILE-WIDE: the include is at module level.
      keys = pathlib.Path("${tongues}/keys.txt").read_text().split()
      floor(len(keys), 20, "languages of content")
      failed = False
      for key in keys:
          if not re.fullmatch(r"tongue-[a-z][a-z0-9-]*", key):
              print(f"ERROR: `{key}` is not a language's key", file=sys.stderr)
              failed = True
      for language in ${builtins.toJSON languages}:
          ftl = pathlib.Path("${texts}/" + language + ".ftl").read_text()
          have = set(re.findall(r"^([a-z][a-z0-9-]*) *=", ftl, re.M))
          missing = [k for k in keys if k not in have]
          if missing:
              print(f"ERROR: {language} does not name: {', '.join(missing)}", file=sys.stderr)
              failed = True
          else:
              print(f"ok  {language}: the {len(keys)} languages of content have names")

      table = uncommented(pathlib.Path("${../crates/ronoctua-player/src/tongues.rs}").read_text())
      table = table.split("#[cfg(test)]")[0]
      floor(len(table), 500, "characters of the tongues module before its tests")
      wanted = 'include!(concat!(env!("OUT_DIR"), "/tongues.rs"))'
      if wanted not in table:
          print(f"ERROR: the generated table is not included (looked for `{wanted}`)", file=sys.stderr)
          failed = True

      if failed:
          print("", file=sys.stderr)
          print("A language with no name is shown as its raw code; add `tongue-<code>`", file=sys.stderr)
          print("to every language's fragment of the crate that says it (crates/<crate>/i18n/).", file=sys.stderr)
          sys.exit(1)
      print(f"OK: {len(keys)} languages of content, named in every language, and the player reads them")
      PY
    '';

  # THE AMBIENT SOUNDS ARE RECORDINGS ANYONE MAY USE, PROVED WITHOUT THEM.
  #
  # `nix/ambience.nix` refuses, while EVALUATING, a sound whose licence is not
  # CC0 or the public domain, a generator named anywhere (only recordings are
  # ambient sounds), an id or a group that is not kebab-case, an id twice, a
  # window too short to hold the loop and its crossfade, a loudness outside
  # its range, a missing sha256, page or author, and more at once than the
  # ceiling. Those refusals only RAN when the loops were built — which needs
  # the approved originals, a Release that is not published yet — so a table
  # that broke them passed every check on a machine without them. This
  # evaluates the table alone (`originals = null`), and proves each refusal
  # on a table planted wrong in one way.
  ambience-is-cc0 =
    let
      real = import ../assets/ambience.nix;
      evaluated =
        table:
        (pkgs.callPackage ../nix/ambience.nix {
          originals = null;
          inherit table;
        }).table;
      accepted = table: (builtins.tryEval (builtins.deepSeq (evaluated table) true)).success;
      first = builtins.head real.sounds;
      firstChanged = change: real // { sounds = [ (first // change) ] ++ builtins.tail real.sounds; };
      facts = pkgs.writeText "ambience-cc0.json" (
        builtins.toJSON {
          accepted = accepted real;
          sounds = builtins.length real.sounds;
          licences = map (s: s.licence or "") real.sounds;
          planted = {
            "a licence that is not CC0" = accepted (firstChanged {
              licence = "CC-BY-4.0";
            });
            "a generator named" = accepted (firstChanged {
              original = "anoisesrc.flac";
            });
            "an id that is not kebab-case" = accepted (firstChanged {
              id = "Small_Waterfall";
            });
            "an id twice" = accepted (real // { sounds = real.sounds ++ [ first ]; });
            "a window too short" = accepted (firstChanged {
              toSeconds = first.fromSeconds + first.fadeSeconds;
            });
            "a loudness out of range" = accepted (firstChanged {
              loudnessLufs = -6;
            });
            "no sha256" = accepted (firstChanged {
              sha256 = "";
            });
            "no page" = accepted (firstChanged {
              page = "freesound";
            });
            "more at once than the ceiling" = accepted (real // { atOnce = 17; });
            "a route that is not one" = accepted (real // { route = "gapless"; });
          };
        }
      );
    in
    mkCheck "ambience-is-cc0" [ pkgs.python3 ] ''
      python3 - <<'END'
      import json, sys
      exec(open("${pyPrelude}").read())
      exec(open("${offeredHelpers}").read())

      # PARSED: what the evaluation said of the real table and of each planted
      # one arrives as JSON; nothing is searched.
      facts = json.load(open("${facts}"))
      floor(facts["sounds"], 1, "ambient sounds in the table")
      floor(len(facts["planted"]), 10, "planted tables")
      wrong = []
      if not facts["accepted"]:
          wrong.append("assets/ambience.nix is refused by nix/ambience.nix's own rules")
      for licence in facts["licences"]:
          if licence not in ("CC0-1.0", "public-domain"):
              wrong.append(f"a sound is licensed {licence!r}")
      for what, passed in facts["planted"].items():
          if passed:
              wrong.append(f"a table with {what} is accepted: the rule stopped refusing")
      for w in wrong:
          print("ERROR: " + w, file=sys.stderr)
      if wrong:
          sys.exit(1)
      print(f"OK: {facts['sounds']} ambient sounds, each CC0 or public domain, and {len(facts['planted'])} planted tables refused, without the originals")
      END
    '';

  # EVERY SUBTITLE FORMAT IS READ, AND EVERY NAME THE PLAYER IS OFFERED FOR IS ONE IT TAKES.
  #
  # Two halves of one promise. `subtitles::open` decides a file's format by
  # its content and hands it to its reader; `every_reader_is_reached_from_open`
  # proves each reader is reached — so a `Format` with no fixture there is a
  # reader nothing proves can be reached (EBU STL and YouTube's XML had none).
  # And `assets/player-types.nix` makes the file manager OFFER the player for
  # the subtitle types (`subtitles.known` by freedesktop's name, `invented`
  # by glob); a name the player then does not CLAIM as a subtitle
  # (`subtitles::claims`) is put in the queue as media and refused there —
  # the file manager offered a program for a file it cannot open.
  subtitle-formats-are-total =
    let
      types = pkgs.writeText "player-subtitle-types.json" (
        builtins.toJSON (import ../assets/player-types.nix).subtitles
      );
    in
    mkCheck "subtitle-formats-are-total" [ pkgs.python3 ] ''
      python3 - <<'END'
      import json, pathlib, re, sys
      exec(open("${pyPrelude}").read())
      exec(open("${offeredHelpers}").read())

      # PARSED: the declaration arrives as JSON and freedesktop's `globs2` is
      # read line by line; the Rust is narrowed by name — `enum Format`, both
      # `extensions`, `claims` and the fixture test — with `uncommented`,
      # because extensions are string literals.
      src = pathlib.Path("${../crates/ronoctua-player/src/subtitles}")
      sniff = uncommented((src / "sniff.rs").read_text())
      mod = uncommented((src / "mod.rs").read_text())
      floor(len(sniff), 3000, "characters of sniff.rs")
      floor(len(mod), 3000, "characters of subtitles/mod.rs")
      wrong = []

      # 1. EVERY FORMAT HAS A FIXTURE THAT `open` READS.
      formats = re.findall(r"^\s+(\w+),\s*$", must(scope(sniff, r"pub enum Format\s*"), "`enum Format`"), re.M)
      floor(len(formats), 10, "subtitle formats read here")
      reached = must(body_of(mod, "every_reader_is_reached_from_open"), "`every_reader_is_reached_from_open`")
      fixtures = set(re.findall(r"\bFormat::(\w+)\s*,?\s*\)", reached))
      for f in formats:
          if f not in fixtures:
              wrong.append(f"`Format::{f}` has no fixture in `every_reader_is_reached_from_open`: nothing proves `open` reaches its reader")

      # 2. WHAT `claims` TAKES, worked out from what it reads.
      def arms(scope_header):
          body = must(body_of(must(scope(sniff, scope_header), scope_header), "extensions"), f"{scope_header}::extensions")
          return set(re.findall(r'"([a-z0-9]+)"', body))
      ours = arms(r"impl Format\s*")
      tails = arms(r"impl Tail\s*")
      claims = must(body_of(mod, "claims"), "`subtitles::claims`")
      for needle in ("GENERIC_EXTENSIONS.contains", "Format::ALL", "Tail::ALL"):
          if needle not in claims:
              wrong.append(f"`claims` no longer reads `{needle}`: this check works out the wrong answer")
      extra = set()
      for m in re.finditer(r"named\(&\[([^\]]*)\]\)", claims):
          extra |= set(re.findall(r'"([a-z0-9]+)"', m.group(1)))
      generic = set(re.findall(r'"([a-z0-9]+)"', re.search(r"pub const GENERIC_EXTENSIONS[^=]*=\s*\[([^\]]*)\]", mod).group(1)))
      claimed = (ours | tails | extra) - generic
      floor(len(claimed), 15, "extensions the player claims")

      # 3. EVERY NAME THE FILE MANAGER OFFERS THE PLAYER FOR.
      declared = json.load(open("${types}"))
      offered = {}
      for row in declared.get("invented", []):
          for glob in row["globs"]:
              offered.setdefault(glob, row["mime"])
      known = set(declared.get("known", []))
      floor(len(known), 3, "subtitle types freedesktop names")
      found = set()
      for line in open("${pkgs.shared-mime-info}/share/mime/globs2", encoding="utf-8"):
          if line.startswith("#") or not line.strip():
              continue
          parts = line.rstrip("\n").split(":")
          if len(parts) >= 3 and parts[1] in known:
              offered.setdefault(parts[2], parts[1])
              found.add(parts[1])
      for mime in sorted(known - found):
          wrong.append(f"`{mime}` is claimed by name and freedesktop's database has no glob for it")
      floor(len(offered), 10, "globs the player is offered for")
      for glob, mime in sorted(offered.items()):
          m = re.fullmatch(r"\*\.([A-Za-z0-9]+)", glob)
          if not m:
              wrong.append(f"`{glob}` ({mime}) is not a plain `*.<ext>` glob: what would the player claim?")
              continue
          if m.group(1).lower() not in claimed:
              wrong.append(f"the player is offered for `{glob}` ({mime}) and does not claim it as a subtitle: it would queue it as media")

      for w in wrong:
          print("ERROR: " + w, file=sys.stderr)
      if wrong:
          sys.exit(1)
      print(f"OK: {len(formats)} formats reached from `open`, and {len(offered)} offered globs claimed")
      END
    '';

  # EVERY SUBTITLE FFMPEG READS FOR US, THE PINNED FFMPEG CAN READ.
  #
  # Nine subtitle formats are read through ffmpeg rather than by us — JACOSub,
  # PJS, AQTitle, RealText, VPlayer, MPsub, SCC, Spruce STL, MCC
  # (`subtitles::Tail`): the engine runs `ffmpeg -f <demuxer> -i … -f ass -`
  # and reads the ASS. A demuxer the pinned ffmpeg does not have (a bump that
  # drops one, a build without it) fails only when somebody opens such a
  # file, with ffmpeg's own words. This asks THE ffmpeg the player is handed
  # (`nix/player-tools.nix`) for its list.
  subtitle-tail-demuxers-exist =
    let
      ffmpeg = (import ../nix/player-tools.nix { inherit pkgs; }).RONOCTUA_FFMPEG;
    in
    mkCheck "subtitle-tail-demuxers-exist" [ pkgs.python3 ] ''
      ${ffmpeg} -hide_banner -demuxers > demuxers.txt
      ${ffmpeg} -hide_banner -muxers > muxers.txt
      python3 - <<'END'
      import pathlib, re, sys
      exec(open("${pyPrelude}").read())
      exec(open("${offeredHelpers}").read())

      # PARSED: ffmpeg's two lists, one format per line after `---`; the Rust
      # is narrowed to `Tail::demuxer` by name, `uncommented` (the names are
      # string literals).
      def listed(path, flag):
          names, seen = set(), False
          for line in pathlib.Path(path).read_text().splitlines():
              if line.strip() == "---":
                  seen = True
                  continue
              # ` D   name   …` / `  E  name   …`: three columns of flags
              # (a dot or a space where one is off), then the name.
              m = re.match(r"\s([D. ])([E. ])([d. ])\s+(\S+)", line)
              if seen and m and (m.group(1) if flag == "D" else m.group(2)) == flag:
                  names |= set(m.group(4).split(","))
          return names
      demuxers, muxers = listed("demuxers.txt", "D"), listed("muxers.txt", "E")
      floor(len(demuxers), 100, "demuxers the pinned ffmpeg lists")

      sniff = uncommented(pathlib.Path("${../crates/ronoctua-player/src/subtitles/sniff.rs}").read_text())
      tail = must(scope(sniff, r"impl Tail\s*"), "`impl Tail`")
      wanted = re.findall(r'Self::(\w+)\s*=>\s*"([a-z0-9_]+)"', must(body_of(tail, "demuxer"), "`Tail::demuxer`"))
      floor(len(wanted), 5, "formats read through ffmpeg")
      wrong = []
      for variant, demuxer in wanted:
          if demuxer not in demuxers:
              wrong.append(f"`Tail::{variant}` asks ffmpeg for the demuxer `{demuxer}`, which the pinned ffmpeg does not have")
      if "ass" not in muxers:
          wrong.append("the pinned ffmpeg cannot write ASS, which is what every converted subtitle is read as")

      for w in wrong:
          print("ERROR: " + w, file=sys.stderr)
      if wrong:
          sys.exit(1)
      print(f"OK: the pinned ffmpeg reads all {len(wanted)} subtitle formats handed to it, and writes ASS")
      END
    '';

  # EVERY PROGRAM THE PLAYER RUNS IS HANDED TO IT BY PATH.
  #
  # The player's engine and the tags crate run programs by the path a
  # variable names (`RONOCTUA_FFMPEG`, the decoders', exiftool, Matroska's
  # three): a unit's `PATH` is minimal, and a program found by its bare name
  # works in a devshell and fails on the installed machine, far from the
  # cause. `nix/player-tools.nix` is the one table of them, read by the unit
  # and the nested loop. So every variable those crates read must be one the
  # player's unit sets (the evaluated machine's, not a reading of its
  # source); every program variable must be in the table; and Matroska's
  # three — Qt in their closure — only where the media profile is on.
  player-tools-are-set =
    let
      machine = self.nixosConfigurations.vm.config;
      tools = matroska: builtins.attrNames (import ../nix/player-tools.nix { inherit pkgs matroska; });
      facts = pkgs.writeText "player-tools.json" (
        builtins.toJSON {
          unit = builtins.attrNames machine.systemd.user.services.ronoctua-player.environment;
          media = machine.ronoctua.media.enable;
          withoutMatroska = tools false;
          withMatroska = tools true;
        }
      );
    in
    mkCheck "player-tools-are-set" [ pkgs.python3 ] ''
      python3 - <<'END'
      import json, pathlib, re, sys
      exec(open("${pyPrelude}").read())
      exec(open("${offeredHelpers}").read())

      # PARSED: the evaluated unit and the table arrive as JSON. FILE-WIDE:
      # a variable may be read anywhere in the three crates; the two program
      # tables are narrowed by name (`Program::variable`, the decoders'
      # rows), all `uncommented` — a variable's name is a string literal.
      facts = json.load(open("${facts}"))
      unit, on, off = set(facts["unit"]), set(facts["withMatroska"]), set(facts["withoutMatroska"])
      floor(len(unit), 10, "variables the player's unit sets")
      crates = pathlib.Path("${../crates}")
      MATROSKA = {"RONOCTUA_MKVEXTRACT", "RONOCTUA_MKVMERGE", "RONOCTUA_MKVPROPEDIT"}
      # SET ELSEWHERE, OR ON PURPOSE NOT ALWAYS — each a decision:
      UNSET = {
          # the loops are a Release asset not published yet; without them
          # the player says so on screen (`Trouble::NoAmbience`)
          "RONOCTUA_AMBIENCE": "only where the flake carries the loops",
      }
      wrong, reads, programs = [], set(), set()
      READ = re.compile(r'\benv::var(?:_os)?\s*\(\s*"(RONOCTUA_[A-Z0-9_]+)"|\bconst\s+VARIABLE\s*:\s*&str\s*=\s*"(RONOCTUA_[A-Z0-9_]+)"')
      swept = 0
      for crate in ("ronoctua-player-engine", "ronoctua-tags", "ronoctua-player"):
          for f in rust_sources(crates / crate):
              if f.name in ("tests.rs", "fixture.rs") or "bin" in f.parts:
                  continue
              code = uncommented(product(f.read_text()))
              swept += 1
              for m in READ.finditer(code):
                  reads.add(m.group(1) or m.group(2))
      floor(swept, 40, "files of the player's three crates swept")
      sheet = uncommented(product((crates / "ronoctua-tags/src/sheet.rs").read_text()))
      programs |= set(re.findall(r'"(RONOCTUA_[A-Z0-9_]+)"', must(body_of(sheet, "variable"), "`Program::variable`")))
      decoders = uncommented(product((crates / "ronoctua-player/src/decoders.rs").read_text()))
      programs |= set(re.findall(r'\benv\s*:\s*"(RONOCTUA_[A-Z0-9_]+)"', decoders))
      floor(len(programs), 10, "programs the player runs by a variable")
      reads |= programs

      for name in sorted(reads):
          if name in unit or name in UNSET:
              continue
          wrong.append(f"the player reads `{name}` and its unit never sets it: on the installed machine it is not there")
      for name in sorted(programs - on):
          wrong.append(f"`{name}` names a program the player runs and is not in nix/player-tools.nix")
      for name in sorted(MATROSKA):
          if name in off:
              wrong.append(f"`{name}` is in the table without `matroska`: mkvtoolnix and its Qt reach every profile")
          if name not in on:
              wrong.append(f"`{name}` is not in the table even with `matroska`: Matroska's tags cannot be written")
      for name in sorted((programs - MATROSKA) - off):
          wrong.append(f"`{name}` is only in the table with `matroska`: the reduced profile's player cannot run it")
      if facts["media"] != MATROSKA.issubset(unit):
          wrong.append("the player's unit has Matroska's programs where the media profile is off, or lacks them where it is on: `matroska = config.ronoctua.media.enable`")

      for w in wrong:
          print("ERROR: " + w, file=sys.stderr)
      if wrong:
          sys.exit(1)
      print(f"OK: {len(reads)} variables the player reads are set by its unit, and {len(programs)} programs are in the table")
      END
    '';

  # EVERY TYPE THE PLAYER CLAIMS REACHES THE THREE PLACES A DESKTOP ASKS.
  #
  # `assets/player-types.nix` declares what the player opens beyond
  # freedesktop's audio and video: the sounds only its decoders read
  # (`families`), its own two files (`own`), and the subtitles it lays over a
  # film (`subtitles`). A type is only OPENED with the player if it reaches
  # the desktop entry's `MimeType=`, the distribution's `mimeapps.list`
  # defaults, and the list MPRIS hands a media controller
  # (`SupportedMimeTypes`, from `RONOCTUA_PLAYER_TYPES`). These are built by
  # `nix/modules/player.nix` from a list it computes; this reads the BUILT
  # entry of the evaluated machine against the declaration itself.
  player-formats-are-associated =
    let
      machine = self.nixosConfigurations.vm.config;
      entry = lib.findFirst (
        p: (p.name or "") == "ronoctua-player-desktop"
      ) (throw "the machine installs no ronoctua-player-desktop") machine.environment.systemPackages;
      ours = import ../assets/player-types.nix;
      facts = pkgs.writeText "player-formats.json" (
        builtins.toJSON {
          claimed =
            map (f: f.mime) (ours.families ++ ours.own ++ ours.subtitles.invented) ++ ours.subtitles.known;
          mprisReadsTheEntry =
            machine.systemd.user.services.ronoctua-player.environment.RONOCTUA_PLAYER_TYPES
            == "${entry}/share/ronoctua/player-types";
        }
      );
    in
    mkCheck "player-formats-are-associated" [ pkgs.python3 ] ''
      python3 - <<'END'
      import configparser, json, pathlib, sys
      exec(open("${pyPrelude}").read())

      # PARSED: the declaration and the machine's facts arrive as JSON; the
      # desktop entry and `mimeapps.list` are read as the INI files they are,
      # and the MPRIS list one type a line.
      # FILE-WIDE: each of the three is a list of types, with no function.
      facts = json.load(open("${facts}"))
      claimed = set(facts["claimed"])
      floor(len(claimed), 20, "types the player claims beyond audio/ and video/")
      entry = pathlib.Path("${entry}")
      desktop = configparser.ConfigParser(interpolation=None, strict=False)
      desktop.optionxform = str
      desktop.read(entry / "share/applications/br.ronoctua.player.desktop")
      named = set(t for t in desktop["Desktop Entry"]["MimeType"].split(";") if t)
      defaults = configparser.ConfigParser(interpolation=None, strict=False)
      defaults.optionxform = str
      defaults.read(entry / "share/applications/mimeapps.list")
      defaulted = {t for t, app in defaults["Default Applications"].items() if app == "br.ronoctua.player.desktop"}
      supported = set((entry / "share/ronoctua/player-types").read_text().split())
      floor(len(named), 80, "types in the desktop entry")
      wrong = []
      for where, have in (("the desktop entry's MimeType=", named), ("mimeapps.list's defaults", defaulted), ("MPRIS SupportedMimeTypes", supported)):
          for t in sorted(claimed - have):
              wrong.append(f"`{t}` is claimed by the player and missing from {where}")
      if not facts["mprisReadsTheEntry"]:
          wrong.append("the player's unit hands MPRIS a list other than the entry's (`RONOCTUA_PLAYER_TYPES`)")

      for w in wrong:
          print("ERROR: " + w, file=sys.stderr)
      if wrong:
          sys.exit(1)
      print(f"OK: the {len(claimed)} types the player claims are in its entry, its defaults and its MPRIS list")
      END
    '';

  # EVERY PAGE OF THE PLAYER FITS EVERY DOOR IT OPENS IN.
  #
  # The player's pages are drawn in a window and in the column at three
  # sizes, in two languages, and a page laid out for one is read in all of
  # them. What breaks first is not the arithmetic a test checks but what a
  # photograph shows: a label cut with an ellipsis it does not have, a note
  # cut instead of wrapped (AGENTS.md), a heading cut, a run or a rectangle
  # drawn past the surface. Each page is opened by its own key
  # (`photograph --open`, over the fixtures in `tests/fixtures/player-pages`:
  # a film with every kind of lane, the queue, a song's sheet, a desk of
  # suggestions and the world's radio and TV) and its frame read (`--list`);
  # the home is the frame with nothing opened. The pages are the ones the
  # door itself lists (`photograph --list-pages`, which is `PageId::PAGES`),
  # so a page added there is photographed without this check being told.
  #
  # A cut is any run ending in an ellipsis, in ANY colour — a label, a value
  # (`chrome::aligned_pair` wraps both), the cursor row's accent — but three:
  # an ellipsis that is part of the text itself ("Pair with a machine…" asks
  # something, in both languages); a lane's name in the deck, which has a
  # column of `space.player.deckNames` cells by design; and the HEADER'S hint
  # line, drawn in the `text.subtle.*` registers on the header's own line,
  # which is elided at its far end by design (`chrome::with_the_way_back`:
  # the way back first, the rest in the header's drawer, `RCtrl ↑↓`).
  player-pages-fit-every-size = mkCheck "player-pages-fit-every-size" [ pkgs.python3 ] ''
    # The palettes and the texts (`rust.keyed`): this binary is the unwrapped
    # one, and the colours and the words are data it reads at run time.
    export RONOCTUA_THEMES=${rust.keyed.RONOCTUA_THEMES}
    export RONOCTUA_TEXTS=${rust.keyed.RONOCTUA_TEXTS}
    # And the brain's catalogue (`rust.keyed`): the modules' marks and the
    # keymap's actions are data it reads at run time, refused (78) without it.
    export RONOCTUA_BRAIN_CATALOGUE=${rust.keyed.RONOCTUA_BRAIN_CATALOGUE}
    export VK_DRIVER_FILES=${xvfb.icd}
    export VK_ICD_FILENAMES=${xvfb.icd}
    export LIBGL_ALWAYS_SOFTWARE=1
    export RONOCTUA_ATLAS=${rust.atRunTime.RONOCTUA_ATLAS}
    export RONOCTUA_ICONSET=${rust.atRunTime.RONOCTUA_ICONSET}
    export RONOCTUA_COVERAGE_FONTS=${rust.atRunTime.RONOCTUA_COVERAGE_FONTS}
    export HOME=$PWD/home XDG_CONFIG_HOME=$PWD/home/.config XDG_STATE_HOME=$PWD/home/.local/state
    mkdir -p "$HOME" places/Music places/Videos
    ${rust.bins.ronoctua-shell}/bin/ronoctua-shell photograph --make-catalog "$PWD/catalog"
    python3 - <<'END'
    import pathlib, re, subprocess, sys, unicodedata
    exec(open("${pyPrelude}").read())
    exec(open("${offeredHelpers}").read())

    # PARSED: each frame the door printed (`--list`), line by line; the
    # pages the door lists (`--list-pages`); the merged catalogues'
    # module-level texts.
    # FILE-WIDE: the token file, for `deckNames` — one assignment in a table
    # of numbers, with no function to narrow to (`hashless`).
    shell = "${rust.bins.ronoctua-shell}/bin/ronoctua-shell"
    fixtures = pathlib.Path("${../tests/fixtures/player-pages}")
    listed = subprocess.run([shell, "photograph", "--list-pages"], capture_output=True, text=True, check=True)
    keys = [k for k in listed.stdout.split() if k]
    if len(set(keys)) != len(keys):
        print(f"ERROR: two pages share a key: {sorted(k for k in keys if keys.count(k) > 1)}", file=sys.stderr)
        raise SystemExit(1)
    floor(len(keys), 40, "pages the door lists")
    # THE HOME is no page `--open` opens: it is what the door shows first.
    pages = [None] + sorted(keys)
    space = hashless(pathlib.Path("${../assets/tokens/space.nix}").read_text())
    found = re.search(r"\bdeckNames\s*=\s*(\d+)\s*;", space)
    names = int(must(found.group(1) if found else None, "`space.player.deckNames`"))

    whole = {}
    for language in ${builtins.toJSON languages}:
        ftl = pathlib.Path("${texts}/" + language + ".ftl").read_text()
        whole[language] = {v.strip() for v in re.findall(r"^[a-z][a-z0-9-]* *= *(.+)$", ftl, re.M)}
        floor(len(whole[language]), 1000, f"texts of {language}")

    given = [
        "--places", "places", "--catalog", "catalog",
        "--state", str(fixtures / "look.json"), "--queue", str(fixtures / "queue.json"),
        "--sheet", str(fixtures / "sheet.json"), "--desk", str(fixtures / "suggest.json"),
        "--desk", str(fixtures / "radio.json"), "--desk", str(fixtures / "tv.json"),
    ]
    DOORS = (["--door", "window"], ["--door", "column", "--size", "large"],
             ["--door", "column", "--size", "medium"], ["--door", "column", "--size", "small"])
    RUN = re.compile(r'^run line (\d+) column (\d+) (from-the-right |from-the-bottom )?\S+ (color\.\S+) "(.*)"$')
    RECT = re.compile(r"^rect (?:under|over) (-?[\d.]+),(-?[\d.]+) ([\d.]+)x([\d.]+) ")

    def cells(text):
        return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in text)

    def said(text):
        return re.sub(r"\\u\{([0-9a-fA-F]+)\}", lambda m: chr(int(m.group(1), 16)), text).replace('\\"', '"').replace("\\\\", "\\")

    wrong, frames = [], 0
    for language in ${builtins.toJSON languages}:
        for door in DOORS:
            # The header's hint line: the column's line 0 is its control line.
            header = 1 if door[1] == "column" else 0
            for page in pages:
                where = f"{page or 'the home'}, {' '.join(door[1:])}, {language}"
                opened = ["--open", page] if page else []
                done = subprocess.run([shell, "photograph", *door, "--language", language, *given,
                                       *opened, "--list"], capture_output=True, text=True)
                if done.returncode:
                    wrong.append(f"{where}: refused — {done.stderr.strip().splitlines()[-1:]}")
                    continue
                frames += 1
                frame = done.stdout
                size = re.search(r"^(\d+)x(\d+) px logical, (\d+) columns by (\d+) lines", frame, re.M)
                if not size:
                    wrong.append(f"{where}: no frame printed")
                    continue
                width, height, columns, lines = map(int, size.groups())
                runs = 0
                for line in frame.splitlines():
                    run = RUN.match(line)
                    if run:
                        runs += 1
                        at_line, at_column, edge, colour, text = int(run[1]), int(run[2]), run[3], run[4], said(run[5])
                        if at_line >= lines or (not edge and at_column + cells(text) > columns):
                            wrong.append(f"{where}: drawn past the surface ({columns}x{lines} cells): {line}")
                        cut = text.endswith("…") and text not in whole[language] and cells(text) != names
                        hint = colour.startswith("color.text.subtle.") and at_line == header
                        if cut and not hint:
                            wrong.append(f"{where}: cut where it must be whole: {line}")
                    rect = RECT.match(line)
                    if rect:
                        x, y, w, h = map(float, rect.groups())
                        if x < -0.5 or y < -0.5 or x + w > width + 0.5 or y + h > height + 0.5:
                            wrong.append(f"{where}: a rectangle past the surface ({width}x{height} px): {line}")
                if runs < 5:
                    wrong.append(f"{where}: only {runs} runs — the page drew nothing")
    if not wrong:
        floor(frames, len(pages) * len(DOORS) * 2, "frames read")

    for w in wrong:
        print("ERROR: " + w, file=sys.stderr)
    if wrong:
        raise SystemExit(1)
    print(f"OK: {len(keys)} pages and the home fit {len(DOORS)} doors in {len(whole)} languages ({frames} frames)")
    END
  '';

  # THE RULE BESIDE THE COLUMN'S CLOSE HAS THE SAME AIR ON BOTH SIDES.
  #
  # The column's control line is `[close] │ [L][M][S][B]`, and the thin rule
  # stands where the air between the close glyph's INK and the widest size's
  # ink is equal (`column::close_rule`, from `tokens::icon::ink_across`). The
  # cells cannot say where that is: the cross fills its advance and the size
  # glyph starts a fifth of the way into its own. A new face, a glyph swapped
  # in the tokens or a change to how a run is centred moves the rule off the
  # eye's middle by a pixel or two — and only a photograph shows it. So the
  # column is photographed at its three sizes with a control line, and the
  # two gaps are measured on the PIXELS: within one pixel of each other.
  column-rule-has-equal-air = mkCheck "column-rule-has-equal-air" [ pkgs.python3 ] ''
    # The palettes and the texts (`rust.keyed`): this binary is the unwrapped
    # one, and the colours and the words are data it reads at run time.
    export RONOCTUA_THEMES=${rust.keyed.RONOCTUA_THEMES}
    export RONOCTUA_TEXTS=${rust.keyed.RONOCTUA_TEXTS}
    # And the brain's catalogue (`rust.keyed`): the modules' marks and the
    # keymap's actions are data it reads at run time, refused (78) without it.
    export RONOCTUA_BRAIN_CATALOGUE=${rust.keyed.RONOCTUA_BRAIN_CATALOGUE}
    export VK_DRIVER_FILES=${xvfb.icd}
    export VK_ICD_FILENAMES=${xvfb.icd}
    export LIBGL_ALWAYS_SOFTWARE=1
    export RONOCTUA_ICONSET=${rust.atRunTime.RONOCTUA_ICONSET}
    export RONOCTUA_COVERAGE_FONTS=${rust.atRunTime.RONOCTUA_COVERAGE_FONTS}
    export HOME=$PWD/home
    mkdir -p "$HOME"
    for size in large medium small; do
      ${rust.bins.ronoctua-shell}/bin/ronoctua-shell photograph --door column --size "$size" \
        --language en-GB --out "$PWD/$size.png" > /dev/null
      ${rust.bins.ronoctua-shell}/bin/ronoctua-shell photograph --door column --size "$size" \
        --language en-GB --list > "$PWD/$size.txt"
    done
    python3 - <<'END'
    import pathlib, re, struct, sys, zlib
    exec(open("${pyPrelude}").read())

    # PARSED: the frame the door printed (`--list`) for where the rule is, and
    # the PNG it drew, decoded, for where the ink is. No source is searched.
    # FILE-WIDE: a frame is one whole picture, with no function to narrow to.
    def pixels(name):
        raw = pathlib.Path(name).read_bytes()
        assert raw[:8] == b"\x89PNG\r\n\x1a\n", f"{name}: not a PNG"
        at, chunks = 8, {}
        while at < len(raw):
            size = struct.unpack(">I", raw[at:at + 4])[0]
            kind = raw[at + 4:at + 8]
            chunks[kind] = chunks.get(kind, b"") + raw[at + 8:at + 8 + size]
            at += 12 + size
        width, height, depth, colour, _, _, laced = struct.unpack(">IIBBBBB", chunks[b"IHDR"])
        assert (depth, colour, laced) == (8, 6, 0), f"{name}: an unexpected PNG layout"
        rows = zlib.decompress(chunks[b"IDAT"])
        stride = width * 4 + 1
        assert all(rows[n * stride] == 0 for n in range(height)), f"{name}: a filtered row"
        return width, height, rows, stride

    wrong = []
    for size in ("large", "medium", "small"):
        frame = pathlib.Path(f"{size}.txt").read_text()
        floor(len(frame.splitlines()), 20, f"lines of the {size} column's frame")
        rules = re.findall(r"^rect over (-?[\d.]+),(-?[\d.]+) ([\d.]+)x([\d.]+) color\.rule\.\S+$", frame, re.M)
        if len(rules) != 1:
            wrong.append(f"{size}: {len(rules)} rules over the control line, not the one beside the close")
            continue
        x, y, w, h = map(float, rules[0])
        width, height, rows, stride = pixels(f"{size}.png")

        def px(cx, cy):
            o = cy * stride + 1 + cx * 4
            return rows[o:o + 3]

        ground = px(max(0, int(x) - 1), 0)
        top, bottom = int(y), int(y + h) + 1

        def inked(cx):
            return any(sum(abs(a - b) for a, b in zip(px(cx, cy), ground)) > 60 for cy in range(top, bottom))

        reach = 60
        left = [cx for cx in range(max(0, int(x) - reach), int(x)) if inked(cx)]
        right = [cx for cx in range(int(x + w) + 1, min(width, int(x + w) + reach)) if inked(cx)]
        if not left or not right:
            wrong.append(f"{size}: no ink beside the rule (left {bool(left)}, right {bool(right)}): the glyphs are gone or moved")
            continue
        before = x - (max(left) + 1)
        after = min(right) - (x + w)
        print(f"{size}: rule at {x:.1f} px, air {before:.1f} px before it and {after:.1f} px after")
        if abs(before - after) > 1.0:
            wrong.append(f"{size}: the rule has {before:.1f} px of air on one side and {after:.1f} px on the other")

    for w in wrong:
        print("ERROR: " + w, file=sys.stderr)
    if wrong:
        raise SystemExit(1)
    print("OK: the rule beside the column's close stands in the middle of its air, at every size")
    END
  '';

  # WHAT ONLY BTRFS CAN DO IS DONE ONLY ON BTRFS — AND THERE, ONCE.
  #
  # `nix/modules/filesystem.nix` gives a btrfs machine three steps: every
  # person's `~/.cache` (and the containers' storage) a subvolume of its own,
  # the kernel's reclaim of nearly empty data block groups, and a monthly
  # scrub. One predicate (`ronoctua.filesystem.btrfs`) guards all three: a
  # machine on another filesystem must get none of them — a scrub unit that
  # fails every month, a subvolume conversion that cannot run — and is told
  # nothing. And on the installed layout, where `/`, `/home`, `/nix` and the
  # rest are subvolumes of ONE filesystem, the scrub runs once, on `/`
  # (a scrub per mount point would read the same disk six times), and the
  # reclaim is the two DATA lines, never metadata's.
  #
  # Read on the EVALUATED machines: the installed one (`noctua`), and the
  # VM with its filesystems made ext4.
  btrfs-steps-skip-elsewhere =
    let
      installed = self.nixosConfigurations.noctua.config;
      elsewhere =
        (self.nixosConfigurations.vm.extendModules {
          modules = [
            {
              fileSystems."/".fsType = lib.mkForce "ext4";
              fileSystems."/persist".fsType = lib.mkForce "ext4";
            }
          ];
        }).config;
      stepsOf = c: {
        btrfs = c.ronoctua.filesystem.btrfs;
        scrub = c.services.btrfs.autoScrub.enable;
        scrubbed =
          if c.services.btrfs.autoScrub.enable then c.services.btrfs.autoScrub.fileSystems else [ ];
        reclaim = builtins.filter (r: lib.hasInfix "/sys/fs/btrfs/" r) c.systemd.tmpfiles.rules;
        units = builtins.filter (n: lib.hasInfix "-subvolume-" n) (builtins.attrNames c.systemd.services);
        people = builtins.attrNames (lib.filterAttrs (_: u: u.isNormalUser) c.users.users);
      };
      facts = pkgs.writeText "btrfs-steps.json" (
        builtins.toJSON {
          installed = stepsOf installed;
          elsewhere = stepsOf elsewhere;
        }
      );
    in
    mkCheck "btrfs-steps-skip-elsewhere" [ pkgs.python3 ] ''
      python3 - <<'END'
      import json, re, sys
      exec(open("${pyPrelude}").read())

      # PARSED: both machines' steps arrive as the evaluated configuration,
      # JSON; nothing is searched.
      facts = json.load(open("${facts}"))
      on, off = facts["installed"], facts["elsewhere"]
      floor(len(on["people"]), 1, "people on the installed machine")
      wrong = []
      if not on["btrfs"]:
          wrong.append("the installed layout is not seen as btrfs: what is this checking?")
      if on["scrubbed"] != ["/"]:
          wrong.append(f"the installed machine scrubs {on['scrubbed']}: one filesystem, scrubbed once, on /")
      lines = sorted(on["reclaim"])
      want = sorted(f"w /sys/fs/btrfs/*/allocation/data/{k}_reclaim - - - - 1" for k in ("dynamic", "periodic"))
      if lines != want:
          wrong.append(f"the reclaim lines are {lines}: the two of DATA, switched on, and nothing else")
      for person in on["people"]:
          if f"ronoctua-cache-subvolume-{person}" not in on["units"]:
              wrong.append(f"{person}'s cache is not made a subvolume of its own")
      if off["btrfs"]:
          wrong.append("a machine with no btrfs is taken for btrfs")
      for what, got in (("a scrub", off["scrub"]), ("reclaim lines", off["reclaim"]), ("subvolume units", off["units"])):
          if got:
              wrong.append(f"a machine with no btrfs still gets {what}: {got}")

      for w in wrong:
          print("ERROR: " + w, file=sys.stderr)
      if wrong:
          sys.exit(1)
      print(f"OK: btrfs's steps on btrfs only — one scrub of /, the two data reclaims, {len(on['units'])} subvolume units — and none elsewhere")
      END
    '';

  # WHERE CARGO WRITES IS DECIDED IN ONE FILE.
  #
  # `nix/cargo-dirs.nix` is the one place the build directories are named
  # (invariant 16): under the cache, one directory per compiler, so a sweep
  # can release an old compiler's builds whole and nothing lands in the tree
  # (`lean-tree`, `tree-holds-no-build`). A second place that sets
  # `CARGO_TARGET_DIR` or `CARGO_BUILD_BUILD_DIR` by hand — a path written in
  # a script, a `target-dir` in a cargo config — is a build somewhere no sweep
  # knows, and the next compiler bump leaves it behind for ever. Elsewhere the
  # two may be READ, and SET only from `cargoDirs`' own answers.
  cargo-writes-outside-the-tree = mkCheck "cargo-writes-outside-the-tree" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())
    exec(open("${offeredHelpers}").read())

    # FILE-WIDE: an assignment may be written in any file of the tree, so
    # each is the question; Nix, shell and TOML comments are stripped
    # (`hashless`), Rust's too (`code_of`), and each assignment is narrowed
    # to its own value.
    root = pathlib.Path("${self}")
    owner_file = root / "nix" / "cargo-dirs.nix"
    NAMES = r"CARGO_(?:TARGET_DIR|BUILD_BUILD_DIR)"
    SET = re.compile(r"(?:^|[\s;({])(?:export\s+)?(?:environment\.sessionVariables\.)?(" + NAMES + r")\s*=\s*([^\n;]*)", re.M)
    TOML = re.compile(r"^\s*(?:build\.)?(target-dir|build-dir)\s*=", re.M)
    RUST = re.compile(r"\b(?:\.env|set_var)\s*\(\s*\"" + NAMES + r"\"")

    swept, setters, wrong = 0, 0, []
    for f in sorted(root.rglob("*")):
        rel = f.relative_to(root)
        if not f.is_file() or rel.parts[0] in (".git", "docs") or f == owner_file:
            continue
        if f.suffix in (".nix", ".sh", ".bash", ".py", ".toml") or f.name in (".envrc", "config"):
            text = hashless(f.read_text(errors="replace"))
            swept += 1
            for m in SET.finditer(text):
                setters += 1
                value = m.group(2)
                if not re.search(r"cargoDirs\.", value):
                    wrong.append(f"{rel} sets {m.group(1)} by hand ({value.strip()[:60]}): name it in nix/cargo-dirs.nix and take it from `cargoDirs`")
            if f.suffix == ".toml" or f.name == "config":
                m = TOML.search(text)
                if m:
                    wrong.append(f"{rel} gives cargo a `{m.group(1)}` of its own: builds go where nix/cargo-dirs.nix says")
        elif f.suffix == ".rs":
            code = code_of(product(f.read_text(errors="replace")))
            swept += 1
            uncut = uncommented(product(f.read_text(errors="replace")))
            m = RUST.search(uncut)
            if m:
                wrong.append(f"{rel} sets a build directory for a child (`{m.group(0)}`)")
    floor(swept, 500, "files of the tree swept")
    floor(setters, 1, "places that set a build directory from cargoDirs")

    # AND THE ONE FILE STILL NAMES BOTH, under the cache, per compiler.
    named = hashless(owner_file.read_text())
    floor(len(named), 500, "characters of nix/cargo-dirs.nix")
    for needle in ("cargo-target/${"$"}{compiler}/target", "cargo-target/${"$"}{compiler}/build/{workspace-path-hash}"):
        if needle not in named:
            wrong.append(f"nix/cargo-dirs.nix no longer names `{needle}`")

    for w in wrong:
        print(f"ERROR: {w}", file=sys.stderr)
    if wrong:
        raise SystemExit(1)
    print(f"OK: cargo's directories are set from nix/cargo-dirs.nix alone ({setters} places take its answer)")
    END
  '';

  # NO BATTERY STARTS OVER A BUILD INSIDE THE TREE.
  #
  # The flake is evaluated as `git+file`, so a `target/` inside the tree is
  # never copied and no check sees it — it only takes the disk the battery is
  # about to need (this tree once held 18 GB of it). `nix/tree-guard.nix` is
  # the guard `.#gate`, `.#most` and `.#quick` run FIRST; this proves it
  # refuses a planted build, lets a clean tree through, and is still the
  # first thing each of the three does.
  tree-holds-no-build =
    let
      guard = pkgs.callPackage ../nix/tree-guard.nix { };
    in
    mkCheck "tree-holds-no-build"
      [
        pkgs.python3
        pkgs.git
      ]
      ''
        export HOME=$PWD/home
        mkdir -p "$HOME" tree/crates/a/src
        git -C tree init -q
        echo 'fn main() {}' > tree/crates/a/src/main.rs
        # A CLEAN TREE goes through.
        ( cd tree/crates/a && ${guard}/bin/ronoctua-tree-holds-no-build ) > clean.txt 2>&1
        # A CARGO BUILD where cargo would put one, and a buffer's: refused.
        mkdir -p tree/crates/a/target/debug tree/buffers/b/target/wasm32-wasip2
        printf 'Signature: 8a477f597d28d172789f06886806bc55\n' > tree/crates/a/target/CACHEDIR.TAG
        printf 'Signature: 8a477f597d28d172789f06886806bc55\n' > tree/buffers/b/target/CACHEDIR.TAG
        if ( cd tree/crates/a && ${guard}/bin/ronoctua-tree-holds-no-build ) > built.txt 2>&1; then
          echo "ERROR: the guard let a battery start over a build inside the tree:" >&2
          cat built.txt >&2
          exit 1
        fi
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        # PARSED: the guard's two answers, line by line; and the two batteries'
        # scripts, `hashless`, each narrowed to what comes before its first
        # `nix build`.
        # FILE-WIDE: the scripts are Nix strings, not functions.
        said = pathlib.Path("built.txt").read_text()
        wrong = []
        for planted in ("crates/a/target", "buffers/b/target"):
            if planted not in said:
                wrong.append(f"the refusal does not name `{planted}`: {said!r}")
        if pathlib.Path("clean.txt").read_text().strip():
            wrong.append("the guard spoke over a clean tree")

        GUARD = "ronoctua-tree-holds-no-build"
        gate = hashless(pathlib.Path("${../nix/gate.nix}").read_text())
        flake = hashless(pathlib.Path("${../flake.nix}").read_text())
        floor(len(gate), 5000, "characters of nix/gate.nix")
        script = gate[gate.find("text = '''"):]
        first = script.find("nix build")
        if first < 0 or GUARD not in script[:first] or script.find(GUARD) > script.find("keepSources"):
            wrong.append("the batteries (`nix/gate.nix`, `.#gate` and `.#most`) no longer run the guard before anything else")
        quick = flake[flake.find('quick = mkScriptApp "ronoctua-quick"'):]
        quick = quick[: quick.find("\n        ''';")]
        floor(len(quick), 200, "characters of the quick loop's script")
        if GUARD not in quick[: quick.find("nix build")]:
            wrong.append("`.#quick` no longer runs the guard before it builds")

        for w in wrong:
            print("ERROR: " + w, file=sys.stderr)
        if wrong:
            sys.exit(1)
        print("OK: a build inside the tree stops .#gate, .#most and .#quick before they start, and a clean tree does not")
        END
      '';

  # TWO TESTS THAT NEED WHAT A PLAIN `cargo test` DOES NOT HAVE, each run on
  # its own out of the harness the test units already built (`rust.testsOf`):
  # nothing compiled again, and the variables are the ones the crate's tests
  # are given (its `run-env`), never a second copy of them.
  #
  # Each asks for its test by its full path with `--exact`, and refuses a run
  # that did not execute exactly one test: a filter that matched nothing is
  # a green build that tested nothing.

  # THE MERGED SUBTITLES AS LIBASS DRAWS THEM. The merge places every lane
  # itself (`subtitles::merge`) because libass does not keep lane order; the
  # margins are the merge's arithmetic and are unit-tested, but WHERE THE
  # LINES LAND is libass's — lane 1 nearest the foot, lane 2 above it, a top
  # lane at the top. `the_lanes_stack_in_libass` draws a three-lane merge with
  # the pinned ffmpeg's libass and reads each lane's colour back from the
  # frame; here it is given the program and the face it needs.
  subtitles-stack-in-libass =
    let
      # What the player's tests are given while they run (its `run-env`).
      given = rust.test.runEnvOf "ronoctua-player";
    in
    rust.testsOf {
      name = "ronoctua-subtitles-stack-in-libass";
      crate = "ronoctua-player";
      exact = "subtitles::merge::tests::the_lanes_stack_in_libass";
      expect = "test result: ok. 1 passed";
      pre = ''
        test -x "${given.RONOCTUA_FFMPEG or ""}" && test -f "${given.RONOCTUA_FONT_REGULAR or ""}" || {
          echo "ERROR: the test would return early: no ffmpeg or no face" >&2
          exit 1
        }
      '';
    };

  # OPENSUBTITLES' PUBLISHED MOVIEHASH VECTOR, on the published file. The
  # fingerprint is the subtitles' search key (`opensubtitles::moviehash`);
  # its unit tests check the arithmetic on files they write, and only the
  # service's own `breakdance.avi` checks it against the service's answer
  # (`8e245d9679d31e12`). The file is a pinned capture (`nix/test-vectors.nix`,
  # held by `nix/kept-sources.nix`); the test is `#[ignore]`d in a plain
  # `cargo test` and run here with `--ignored`.
  moviehash-published-vectors =
    let
      vectors = import ../nix/test-vectors.nix { inherit (pkgs) fetchurl; };
    in
    rust.testsOf {
      name = "ronoctua-moviehash-published-vectors";
      crate = "ronoctua-lookup";
      exact = "opensubtitles::tests::the_breakdance_vector_holds";
      includeIgnored = true;
      env.RONOCTUA_OSHASH_BREAKDANCE = "${vectors.breakdance}";
      expect = "test result: ok. 1 passed";
    };

  # THE OFFERED VM TESTS (each file says what only it proves).
  #
  # The lookups against fake HTTPS hosts: the pace, the headers, no key in
  # an address or a command line, a subtitle found and played.
  lookupsVm = import ./lookups-vm.nix {
    inherit pkgs lib;
    player = rust.player;
  };
  # The directories against fake HTTPS hosts: nothing before consent, the
  # click after the sound, the recent and the favourites.
  directoriesVm = import ./directories-vm.nix {
    inherit pkgs lib;
    player = rust.player;
  };
  # The store on a machine: the floor as a person's nix reads it, the trim
  # on planted generations, a real switch and a rollback.
  storeVm = import ./store-vm.nix { inherit pkgs lib; };
  # `~/.cache` a subvolume across real reboots, and the login's cargo
  # directories. In `tests/slow.nix`.
  cacheSubvolumeVm = import ./cache-subvolume-vm.nix {
    inherit pkgs lib;
    cargoDirs = import ../nix/cargo-dirs.nix { inherit (rustToolchain) version; };
  };

  # -------------------------------------------------------------------
  # The test tiers, and the guards that keep them total
  # -------------------------------------------------------------------

  # The names `tests/slow.nix` takes out of the everyday battery — and every
  # brain module's own `slow` list, which travels with its folder.
  slow = import ./slow.nix ++ brainModules.slowChecks;
  # And the ten of the editing loop, which are a CHOSEN subset.
  quick = import ./quick.nix;

  # THE GUARD, and why it looks at `raw` and not at the final attrset.
  #
  # It is PART of the attrset, so reading `attrNames` of that same attrset from
  # inside one of its values would recurse. Building the set as `raw` and adding
  # the guard afterwards puts the two in order: it sees everything that existed
  # before it, which is exactly what it has to see.
  tiersAreTotal =
    let
      all = builtins.attrNames raw;
      ghosts = lib.subtractLists all slow;
      everyday = lib.subtractLists slow all;
    in
    mkCheck "test-tiers-are-total" [ pkgs.coreutils ] ''
      ${
        if ghosts == [ ] then
          ""
        else
          ''
            echo "ERROR: tests/slow.nix names a check that no longer exists:" >&2
            ${lib.concatMapStringsSep "\n" (n: ''echo "       ${n}" >&2'') ghosts}
            echo "      A dead line there excludes nothing — it only looks as if it does," >&2
            echo "      and the check it was meant to hold back comes back into the everyday" >&2
            echo "      round with nobody noticing." >&2
            exit 1
          ''
      }
      ${
        if everyday != [ ] then
          ""
        else
          ''
            echo "ERROR: no check was left for the everyday battery." >&2
            echo "      Either tests/slow.nix swallowed everything, or the checks are gone." >&2
            exit 1
          ''
      }
      echo "OK: ${toString (builtins.length everyday)} in .#most, ${toString (builtins.length slow)} only in .#gate"
    '';

  # THE SAME QUESTION, FOR THE SHORT LOOP.
  #
  # `quick` is a CHOSEN subset and does not have to be complete — but it does
  # have to be valid. A renamed check would drop out of it in silence: the list
  # would still have ten lines, and one of them would stop meaning anything.
  quickNamesExist =
    let
      ghosts = lib.subtractLists (builtins.attrNames raw) quick;
    in
    mkCheck "quick-names-exist" [ pkgs.coreutils ] ''
      ${
        if ghosts == [ ] then
          ""
        else
          ''
            echo "ERROR: tests/quick.nix names a check that does not exist:" >&2
            ${lib.concatMapStringsSep "\n" (n: ''echo "       ${n}" >&2'') ghosts}
            echo "      The short loop would run with less than the list says." >&2
            exit 1
          ''
      }
      echo "OK: the ${toString (builtins.length quick)} of the short loop exist"
    '';

  # ===================================================================
  # THE 2026-10-05 WAVE'S CHECKS — each package defines its own here, after
  # its anchor, and names them in `core` after the same anchor there.
  # ===================================================================
  # ── anchor: L01 ──
  # THE POST-QUANTUM STANZA AGAINST THE TEXTS THAT DEFINE IT.
  #
  # `ronoctua-pq` assembles X-Wing itself (the `age` crate in the lock has no
  # `mlkem768x25519`), and a wrong constant there is a file nobody else can
  # open — which we would open ourselves without a word. The answers are copied
  # verbatim out of three documents: X-Wing's own (draft-connolly-cfrg-xwing-
  # kem-11, Appendix C), HPKE's for exactly age's suite (hpkewg/hpke-pq: KEM
  # 0x647a, HKDF-SHA256, ChaCha20Poly1305 — RFC 9180's key schedule through ten
  # messages and five exports, both ways), and the C2SP age spec's own identity,
  # recipient and stanza. Sabotaged once each, the X-Wing label, the HPKE info,
  # the KEM id and ML-KEM's d/z order each broke their own family.
  pq-xwing-vectors = mkCheck "pq-xwing-vectors" [ pkgs.gnugrep pkgs.coreutils ] ''
    if ! ${rust.bins.ronoctua-test-pq}/bin/ronoctua-test-pq vectors > answers.txt; then
      cat answers.txt >&2
      echo "ERROR: a known answer of the PQ stanza is wrong (above)" >&2
      exit 1
    fi
    # EVERY FAMILY ASKED, so a runner that stopped asking cannot pass.
    for due in "xwing-11 9" "hpke-pq 33" "age-spec 5"; do
      set -- $due
      got=$(grep -c "^ok  *$1 " answers.txt || true)
      if [ "$got" != "$2" ]; then
        echo "ERROR: $got known answers of $1 were given, $2 are due" >&2
        exit 1
      fi
    done
    tail -n 1 answers.txt
  '';

  # THE GO `age` DECIDES, both ways.
  #
  # The vectors prove the pieces; this proves the FILE: what we seal opens in
  # the one other implementation of `mlkem768x25519`, and what it seals opens
  # here — the promise `RECOVER.md` makes, that a person's belongings open with
  # the Go `age` and no distro. Through the extracted `ronoctua-seal`, the
  # program the queue runs. Five things:
  #
  #   1. Go's identity: we seal (3 MB across many chunks, and an empty file),
  #      Go opens.
  #   2. Our identity: Go reads the same recipient out of it, Go seals and we
  #      open, we seal and Go opens; a stranger's key opens neither.
  #   3. Mixing PQ with X25519 is refused at SEALING by both, and no file is
  #      left behind. And a job of classical recipients ALONE is refused by us
  #      (`corrupt`): new encryption is post-quantum, and the sealer reads a
  #      classical key only to name a mix — never to seal without the stanza.
  #   4. A mixed file (forged, since no honest sealer writes one) is refused at
  #      OPENING by us (`Why::Mixed`). Go opens it, and the spec allows that —
  #      it asks the sealer not to mix, and lets an identity ignore the stanzas
  #      it does not know — so this half is ours alone.
  #   5. A header of many: Go seals to 45 PQ recipients, ours last — some
  #      70 KB of header, past the 64 KiB our reader once called damaged — and
  #      we open it.
  #
  # 1.3 is the first Go `age` that speaks the stanza. While nixpkgs carries one
  # that new, it is the judge; an older nixpkgs gets 1.3.1 pinned for THIS
  # check only (nothing installs it). The pin is an attribute of the check, so
  # it is built and proved before the day it is needed:
  #   nix build .#checks.x86_64-linux.pq-age-interop.pinnedGoAge
  pq-age-interop =
    let
      pinnedGoAge = pkgs.buildGoModule (finalAttrs: {
        pname = "age";
        version = "1.3.1";
        src = pkgs.fetchFromGitHub {
          owner = "FiloSottile";
          repo = "age";
          tag = "v${finalAttrs.version}";
          hash = "sha256-Qs/q3zQYV0PukABBPf/aU5V1oOhw95NG6K301VYJk8A=";
        };
        vendorHash = "sha256-iVDkYXXR2pXlUVywPgVRNMORxOOEhAmzpSM0xqSQMSQ=";
        subPackages = [
          "cmd/age"
          "cmd/age-keygen"
        ];
        # `v1.3.1` is what `age --version` says, and what the script reads.
        ldflags = [
          "-s"
          "-w"
          "-X main.Version=v${finalAttrs.version}"
        ];
        # As nixpkgs: the plugin test is flaky (FiloSottile/age#517).
        checkFlags = [
          "-skip"
          "TestScript/plugin"
        ];
      });
      goAge = if lib.versionAtLeast pkgs.age.version "1.3" then pkgs.age else pinnedGoAge;
    in
    mkCheck "pq-age-interop" [ goAge pkgs.coreutils pkgs.gnugrep pkgs.diffutils ] ''
      seal=${rust.seal}/bin/ronoctua-seal
      pq=${rust.bins.ronoctua-test-pq}/bin/ronoctua-test-pq
      w=$PWD
      fail() {
        echo "ERROR: $*" >&2
        exit 1
      }
      # One job on the sealer's stdin; its LAST line is the verdict.
      verdict() {
        printf '{"action":%s,"from":"%s","into":"%s"}\n' "$1" "$w/$2" "$w/$3" \
          | "$seal" 2> /dev/null | tail -n 1 || true
      }
      to() { printf '{"do":"seal-to","recipients":[%s]}' "$1"; }
      with() { printf '{"do":"open","identities-file":"%s"}' "$w/$1"; }

      version=$(age --version)
      case "$version" in
        v1.[3-9]* | v1.[1-9][0-9]* | v[2-9]*) ;;
        *) fail "the Go age here is $version, older than v1.3" ;;
      esac

      head -c 3000123 /dev/urandom > big
      : > empty

      # 1. GO'S IDENTITY: we seal, Go opens.
      age-keygen -pq -o go.key 2> /dev/null
      go=$(age-keygen -y go.key)
      case "$go" in age1pq1*) ;; *) fail "Go's -pq recipient is not age1pq1…" ;; esac
      for f in big empty; do
        said=$(verdict "$(to "\"$go\"")" $f $f.ours.age)
        [ "$said" = "done $(stat -c %s $f)" ] || fail "sealing $f to Go's recipient said: $said"
        age -d -i go.key -o $f.back $f.ours.age || fail "Go did not open what we sealed ($f)"
        cmp $f $f.back || fail "Go opened another $f than we sealed"
      done
      grep -a -q '^-> mlkem768x25519 ' big.ours.age || fail "our file has no mlkem768x25519 stanza"

      # 2. OUR IDENTITY: the same recipient for Go, and both ways round.
      ours=$("$pq" identity "$w/our.key")
      [ "$(age-keygen -y our.key)" = "$ours" ] || fail "Go reads another recipient out of our identity"
      age -r "$ours" -o go.age big || fail "Go refused to seal to our recipient"
      grep -a -q '^-> mlkem768x25519 ' go.age || fail "Go's file has no mlkem768x25519 stanza"
      said=$(verdict "$(with our.key)" go.age go.back)
      [ "$said" = "done 3000123" ] || fail "we did not open what Go sealed to us: $said"
      cmp big go.back || fail "we opened another file than Go sealed"
      said=$(verdict "$(to "\"$ours\"")" big mine.age)
      [ "$said" = "done 3000123" ] || fail "sealing to our own recipient said: $said"
      age -d -i our.key -o mine.back mine.age || fail "Go did not open, with our identity, what we sealed"
      cmp big mine.back || fail "Go opened another file than we sealed"
      age-keygen -pq -o stranger.key 2> /dev/null
      if age -d -i stranger.key -o stranger.back mine.age 2> /dev/null; then
        fail "Go opened our file with a stranger's key"
      fi
      said=$(verdict "$(with stranger.key)" go.age stranger.ours)
      [ "$said" = "refused wrong-key" ] || fail "a stranger's key on Go's file said: $said"
      [ ! -e stranger.ours ] || fail "a refused open left a file behind"

      # 3. MIXING, refused at sealing by both.
      age-keygen -o x25519.key 2> /dev/null
      classical=$(age-keygen -y x25519.key)
      if age -r "$ours" -r "$classical" -o go.mixed.age big 2> go.refused; then
        fail "Go sealed to a PQ and a classical recipient together"
      fi
      grep -q 'incompatible recipients' go.refused || fail "Go refused the mix for another reason: $(cat go.refused)"
      [ ! -e go.mixed.age ] || fail "Go left a file behind"
      said=$(verdict "$(to "\"$ours\",\"$classical\"")" big ours.mixed.age)
      [ "$said" = "refused mixed" ] || fail "sealing to a PQ and a classical recipient said: $said"
      [ ! -e ours.mixed.age ] || fail "a refused seal left a file behind"
      said=$(verdict "$(to "\"$classical\"")" big ours.classical.age)
      [ "$said" = "refused corrupt" ] || fail "sealing to a classical recipient alone said: $said"
      [ ! -e ours.classical.age ] || fail "a refused classical seal left a file behind"

      # 4. A MIXED FILE, refused at opening by us.
      "$pq" mixed "$ours" "$classical" "$w/mixed.age"
      grep -a -q '^-> X25519 ' mixed.age || fail "the forged file has no X25519 stanza"
      said=$(verdict "$(with our.key)" mixed.age mixed.back)
      [ "$said" = "refused mixed" ] || fail "opening a mixed file said: $said"
      [ ! -e mixed.back ] || fail "a refused open left a file behind"

      # 5. A HEADER OF MANY, ours last.
      : > many.txt
      for i in $(seq 44); do
        age-keygen -pq -o many.$i.key 2> /dev/null
        age-keygen -y many.$i.key >> many.txt
      done
      printf '%s\n' "$ours" >> many.txt
      age -R many.txt -o many.age big || fail "Go refused to seal to 45 recipients"
      [ "$(grep -a -c '^-> mlkem768x25519 ' many.age)" = 45 ] || fail "Go's file has no 45 stanzas"
      at=$(grep -a -b -m 1 '^--- ' many.age | cut -d: -f1)
      [ "$at" -gt 65536 ] || fail "the header of 45 recipients is only $at bytes"
      said=$(verdict "$(with our.key)" many.age many.back)
      [ "$said" = "done 3000123" ] || fail "we did not open Go's file of 45 recipients ($at bytes of header): $said"
      cmp big many.back || fail "we opened another file than Go sealed to 45"
      echo "OK: $version and ronoctua-seal open each other's mlkem768x25519 files, 45 recipients too; the mix and a classical seal are refused"
    ''
    // {
      inherit pinnedGoAge;
    };

  # THE IDENTITY NEVER PRINTS.
  #
  # `AGE-SECRET-KEY-PQ-1…` opens everything the person sealed, the belongings
  # first; a log line or an error message that carries it is a key handed to
  # whoever reads the journal. So: an identity's `Debug` and its secret's are
  # the public half and `[REDACTED]`, and EVERY answer `ronoctua-seal` gives
  # with an identity in hand — the open, a wrong key, a damaged file, a damaged
  # identity, a loose or linked identity file, a job that carries the identity
  # inline (it has no field for it: the identity reaches it only as the path
  # of a `0600` file), an identity pasted where a recipient goes — says its
  # verdict and nothing of the key. Each verdict is asserted first, so a path
  # that silently stopped running cannot pass for a quiet one.
  #
  # THE SIGNING KEY TOO (the plain-signature package): the person's ML-DSA-65
  # key, which vouches for everything the machines take in clear, travels in
  # `key.age` beside the identity. Its `Debug`, its public key's and a
  # refusal met with it in hand say the fingerprint and the verdict, and
  # nothing of the seed.
  pq-identity-never-prints = mkCheck "pq-identity-never-prints" [ pkgs.coreutils pkgs.gnugrep ] ''
    seal=${rust.seal}/bin/ronoctua-seal
    pq=${rust.bins.ronoctua-test-pq}/bin/ronoctua-test-pq
    w=$PWD
    fail() {
      echo "ERROR: $*" >&2
      exit 1
    }
    me=$("$pq" identity "$w/me.key")
    secret=$(grep '^AGE-SECRET-KEY-PQ-1' me.key)
    [ ''${#secret} = 77 ] || fail "the identity is ''${#secret} characters, not 77"
    data=''${secret#AGE-SECRET-KEY-PQ-1}
    # Two halves of the key, so a print of either is caught, in any case.
    first=''${data:0:20}
    last=''${data: -20}
    leaks() { grep -q -i -F -e "$first" -e "$last" -e "AGE-SECRET-KEY" "$1"; }

    # 1. THE DEBUGS: the public half is there, the secret is not.
    "$pq" debug "$w/me.key" > debug.txt
    grep -q -F "$me" debug.txt || fail "the Debug does not show the recipient — an empty answer would pass"
    grep -q -F '[REDACTED]' debug.txt || fail "the secret's Debug is not [REDACTED]"
    if leaks debug.txt; then
      cat debug.txt >&2
      fail "an identity's Debug prints the identity"
    fi

    # 2. EVERY ANSWER OF THE SEALER, with the identity in hand.
    printf 'note' > plain
    "$pq" identity "$w/other.key" > other.recipient
    printf 'not age' > junk
    job() { printf '{"action":%s,"from":"%s","into":"%s"}' "$1" "$w/$2" "$w/$3"; }
    to() { printf '{"do":"seal-to","recipients":["%s"]}' "$1"; }
    with() { printf '{"do":"open","identities-file":"%s"}' "$w/$1"; }
    ask() {
      printf '%s\n' "$2" | "$seal" > "said.$1" 2>&1 || true
    }
    ask sealed "$(job "$(to "$me")" plain mine.age)"
    ask theirs "$(job "$(to "$(cat other.recipient)")" plain theirs.age)"
    # One character of the key changed: the checksum refuses it.
    at=''${secret:40:1}
    if [ "$at" = q ]; then other=p; else other=q; fi
    (umask 077 && printf '%s\n' "''${secret:0:40}$other''${secret:41}" > damaged.key)
    cp me.key loose.key
    chmod 644 loose.key
    ln -s me.key linked.key
    ask open "$(job "$(with me.key)" mine.age o1)"
    ask wrong "$(job "$(with me.key)" theirs.age o2)"
    ask corrupt "$(job "$(with me.key)" junk o3)"
    ask damaged "$(job "$(with damaged.key)" mine.age o4)"
    ask loose "$(job "$(with loose.key)" mine.age o5)"
    ask linked "$(job "$(with linked.key)" mine.age o6)"
    # Complete but for one field too many: refused for that field alone.
    ask inline "{\"action\":{\"do\":\"open\",\"identities-file\":\"$w/me.key\",\"identity\":\"$secret\"},\"from\":\"$w/mine.age\",\"into\":\"$w/o7\"}"
    ask pasted "$(job "$(to "$secret")" plain o8)"
    for case in "sealed done 4" "theirs done 4" "open done 4" "wrong refused wrong-key" \
      "corrupt refused corrupt" "damaged refused corrupt" "loose refused failed" \
      "linked refused failed" "inline refused failed" "pasted refused corrupt"; do
      name=''${case%% *}
      due=''${case#* }
      said=$(tail -n 1 "said.$name")
      [ "$said" = "$due" ] || fail "$name: the sealer said '$said', '$due' was due"
      if leaks "said.$name"; then
        cat "said.$name" >&2
        fail "$name: the sealer's answer carries the identity"
      fi
    done

    # 3. THE SIGNING KEY: its Debug, its public key's, a refusal with it in
    # hand — the fingerprint and the verdict, never the seed.
    "$pq" signing-key "$w/sign.key" > sign.pub
    seed=$(grep '^RONOCTUA-SIGNING-KEY-MLDSA65-1' sign.key)
    [ ''${#seed} = 94 ] || fail "the signing key is ''${#seed} characters, not 94"
    hex=''${seed#RONOCTUA-SIGNING-KEY-MLDSA65-1}
    seed_first=''${hex:0:20}
    seed_last=''${hex: -20}
    "$pq" debug-signing "$w/sign.key" > signing.txt
    [ "$(grep -c -E 'fingerprint: "[0-9a-f]{64}"' signing.txt)" = 2 ] \
      || fail "the signing key's and its public key's Debug do not both show the fingerprint — an empty answer would pass"
    grep -q -F 'Err(Refusal { why: WrongKey })' signing.txt \
      || fail "a manifest changed after its signature was not refused with the key in hand"
    if grep -q -i -F -e "$seed_first" -e "$seed_last" -e "SIGNING-KEY" signing.txt; then
      cat signing.txt >&2
      fail "the signing key's Debug, or a refusal with it in hand, prints the seed"
    fi
    echo "OK: the Debugs and ten answers of ronoctua-seal say nothing of the identity, nor the signing key's of its seed"
  '';
  # ── anchor: L02 ──
  # THE KEY IS AGREED POST-QUANTUM FIRST — and a host without it is still
  # reached. `ronoctua-http`'s own test, run on its own: the client as every
  # connection has it (`tls::config`, the `aws-lc-rs` provider with
  # `prefer-post-quantum`) shakes hands, in process, with three servers — one
  # that knows `X25519MLKEM768` (agreed), one that knows only X25519 (agreed,
  # classically), one that knows only P-384 (a retry, then agreed). What the
  # hello offers first is asserted too. Out of the harness the test units
  # built (the test graph turns `tls` and `ws` on), like
  # `subtitles-stack-in-libass`; exactly one test, or nothing was proved.
  tls-is-post-quantum-first = rust.testsOf {
    name = "ronoctua-tls-is-post-quantum-first";
    crate = "ronoctua-http";
    exact = "tls::tests::the_hello_offers_the_hybrid_first_and_a_classical_host_is_still_reached";
    expect = "test result: ok. 1 passed";
  };

  # ONE PROVIDER OF THE CRYPTOGRAPHY OUR CODE AND OUR TLS CALL: `aws-lc-rs`.
  #
  # `ring` is still LISTED in `Cargo.lock` — `rustls-webpki` names it behind a
  # weak feature (`ring?/alloc`), and cargo writes such an optional
  # dependency into the lock even when nothing turns it on. So the lock's
  # list of names is not the question; what is BUILT is. `cargo tree`, over
  # the vendored sources and offline, resolves the whole workspace with every
  # feature of every member and every target — and `ring` must not be in that
  # graph at all, while rustls must stand on `aws-lc-rs` with
  # `prefer-post-quantum` on. And no second TLS library may arrive under
  # another name.
  #
  # AND THE PLAN (`nix/rust/plan.json`, 2026-10-12), which is what every unit
  # and both third-party layers are built from: no graph of it — release,
  # loop, test — has a `ring` unit, and each has `aws-lc-rs`.
  one-crypto-implementation =
    let
      vendored = rust.craneLib.vendorCargoDeps { cargoLock = ../Cargo.lock; };
    in
    mkCheck "one-crypto-implementation"
      [
        rustToolchain
        pkgs.gnugrep
        pkgs.coreutils
        pkgs.python3
      ]
      ''
        export CARGO_HOME="$TMPDIR/cargo-home"
        tree() {
          cargo tree --config ${vendored}/config.toml --locked --offline \
            --manifest-path ${self}/Cargo.toml --workspace --all-features --target all "$@"
        }
        tree -e normal,build,dev -i aws-lc-rs > provider.txt
        tree -e normal,build,dev -i ring > ring.txt 2>&1
        tree -e features -i rustls --depth 1 > rustls.txt
        cat provider.txt rustls.txt
        failed=0
        if grep -q '^ring v' ring.txt; then
          echo "ERROR: ring is built again, beside aws-lc-rs:" >&2
          cat ring.txt >&2
          failed=1
        fi
        # THE FLOOR: the provider is there, under rustls and under ours.
        grep -q '^aws-lc-rs v' provider.txt || { echo "ERROR: aws-lc-rs is not built at all" >&2; failed=1; }
        grep -q 'rustls v' provider.txt || { echo "ERROR: rustls does not stand on aws-lc-rs" >&2; failed=1; }
        grep -q 'ronoctua-http v' provider.txt || { echo "ERROR: ronoctua-http does not use aws-lc-rs" >&2; failed=1; }
        grep -q 'rustls feature "prefer-post-quantum"' rustls.txt || {
          echo "ERROR: rustls is built without prefer-post-quantum: the hybrid is offered last" >&2
          failed=1
        }
        if grep -q 'rustls feature "ring"' rustls.txt; then
          echo "ERROR: rustls is built with its ring provider" >&2
          failed=1
        fi
        # PARSED: the plan, by its graphs' units.
        python3 - ${../nix/rust/plan.json} <<'END' || failed=1
        import json, sys
        plan = json.load(open(sys.argv[1]))
        bad = False
        for g, graph in sorted(plan["graphs"].items()):
            pkgs = {u["pkg"] for u in graph["units"].values()}
            if "ring" in pkgs:
                print(f"ERROR: the {g} graph of nix/rust/plan.json builds ring", file=sys.stderr)
                bad = True
            if "aws-lc-rs" not in pkgs:
                print(f"ERROR: the {g} graph of nix/rust/plan.json has no aws-lc-rs: what is this reading?", file=sys.stderr)
                bad = True
        if len(plan["graphs"]) < 3:
            print(f"ERROR: the plan has {len(plan['graphs'])} graphs, not release, loop and test", file=sys.stderr)
            bad = True
        sys.exit(1 if bad else 0)
        END
        # AND NO OTHER TLS LIBRARY UNDER ANOTHER NAME.
        for other in openssl-sys boring-sys native-tls mbedtls-sys aws-lc-fips-sys; do
          if grep -qx "name = \"$other\"" ${../Cargo.lock}; then
            echo "ERROR: $other is in Cargo.lock: a second implementation of the cryptography" >&2
            failed=1
          fi
        done
        [ "$failed" = 0 ] || exit 1
        echo "OK: ring is built nowhere, nor planned in any graph; rustls and our own code stand on aws-lc-rs, post-quantum first"
      '';

  # SSH AGREES ITS KEYS POST-QUANTUM FIRST, on both profiles and on the ISO —
  # and a SERVER of ours accepts nothing NixOS's recommended list refuses: the
  # hybrids first, then X25519 and the SHA-256 group exchange, and no NIST
  # curve, no fixed 2048-to-8192-bit group, nothing with SHA-1 (the ISO's sshd
  # takes a root login). The client keeps OpenSSH's own classical list.
  #
  # Read as SSH ITSELF reads the configuration, not as the module wrote it:
  # `ssh -G` on each system's generated `/etc/ssh/ssh_config`, and `sshd -G -T`
  # on the ISO's `sshd_config` — the effective list, with whatever an include
  # or another module added. Every name must also be one the pinned ssh knows
  # (`ssh -Q kex`): a misspelt algorithm makes ssh refuse the WHOLE file, and
  # every ssh on the machine would stop.
  #
  # TWO THINGS OF THE SANDBOX, both measured. A store file reads as uid 65534
  # in here, and ssh refuses an INCLUDED file that is neither root's nor the
  # user's — so the configuration and what it includes are copied, byte for
  # byte, into files this build owns, the `Include` pointed at the copies.
  # And `sshd -T` names its keywords in mixed case where `ssh -G` writes them
  # in lower case, so the keyword is compared folded. The generated file ends
  # WITHOUT a newline, and its last line is the `KexAlgorithms`: a copy read
  # with a bare `read` dropped it, ssh fell back to its own default — which is
  # this same list — and the check passed with the setting gone. So the copy
  # keeps a last line with no newline, and must carry the directive.
  ssh-kex-is-pq-first =
    let
      table = import ../assets/ssh.nix;
      wanted = lib.concatStringsSep "," (table.postQuantum ++ table.classical);
      served = lib.concatStringsSep "," (table.postQuantum ++ table.serverClassical);
      config = name: self.nixosConfigurations.${name}.config;
      client = name: (config name).environment.etc."ssh/ssh_config".source;
      server = name: lib.concatStringsSep "," (config name).services.openssh.settings.KexAlgorithms;
    in
    mkCheck "ssh-kex-is-pq-first"
      [
        pkgs.openssh
        pkgs.gnugrep
        pkgs.gawk
        pkgs.coreutils
      ]
      ''
        own() {
          n=0
          while IFS= read -r line || [ -n "$line" ]; do
            if [[ $line =~ ^[[:space:]]*Include[[:space:]]+(.+)$ ]]; then
              n=$((n + 1))
              install -m 644 "''${BASH_REMATCH[1]}" "$2.include-$n"
              printf 'Include %s\n' "$PWD/$2.include-$n"
            else
              printf '%s\n' "$line"
            fi
          done < "$1" > "$2"
        }
        said_by() { awk -v key="$1" 'tolower($1) == key { print $2 }'; }
        failed=0
        known=$(ssh -Q kex)
        for name in ${
          lib.concatStringsSep " " (table.postQuantum ++ table.classical ++ table.serverClassical)
        }; do
          grep -qxF "$name" <<<"$known" || {
            echo "ERROR: the pinned ssh does not know '$name'; it would refuse the whole file" >&2
            failed=1
          }
        done
        for name in ${lib.concatStringsSep " " table.postQuantum}; do
          case "$name" in
            mlkem*|sntrup*) ;;
            *) echo "ERROR: '$name' is listed as post-quantum and is not" >&2; failed=1 ;;
          esac
        done
        for list in "${wanted}" "${served}"; do
          case "$list" in
            mlkem768x25519-sha256,*) ;;
            *) echo "ERROR: a list does not open with mlkem768x25519-sha256: $list" >&2; failed=1 ;;
          esac
        done
        # WHAT A SERVER OF OURS NEVER ACCEPTS, whatever the client may offer
        # (each server below is held to exactly this list).
        for name in ${lib.concatStringsSep " " (table.postQuantum ++ table.serverClassical)}; do
          case "$name" in
            ecdh-sha2-*|diffie-hellman-group1-*|diffie-hellman-group14-*|diffie-hellman-group16-*|diffie-hellman-group18-*|*sha1*)
              echo "ERROR: a server of ours accepts $name, which NixOS's recommended list refuses" >&2
              failed=1 ;;
          esac
        done
        for pair in noctua=${client "noctua"} minimal=${client "minimal"} installer=${client "installer"}; do
          own "''${pair#*=}" "''${pair%%=*}.conf"
          grep -qi '^[[:space:]]*KexAlgorithms ' "''${pair%%=*}.conf" || {
            echo "ERROR: the ssh_config of ''${pair%%=*} says no KexAlgorithms at all" >&2
            failed=1
          }
          said=$(ssh -G -F "''${pair%%=*}.conf" example.org | said_by kexalgorithms)
          [ "$said" = "${wanted}" ] || {
            echo "ERROR: ssh on ''${pair%%=*} agrees keys in this order: $said" >&2
            failed=1
          }
        done
        said=$(sshd -G -T -C lport=22 -f ${(config "installer").environment.etc."ssh/sshd_config".source} \
          | said_by kexalgorithms)
        [ "$said" = "${served}" ] || {
          echo "ERROR: the ISO's sshd agrees keys in this order: $said" >&2
          failed=1
        }
        # OFF on the installed systems, and set: a person who turns sshd on
        # gets the same list as the ISO's.
        for said in "${server "noctua"}" "${server "minimal"}"; do
          [ "$said" = "${served}" ] || {
            echo "ERROR: an installed system's sshd would agree keys in this order: $said" >&2
            failed=1
          }
        done
        [ "$failed" = 0 ] || exit 1
        echo "OK: ssh agrees keys post-quantum first: ${wanted}"
        echo "OK: and every sshd of ours accepts only: ${served}"
      '';

  # THE BELONGINGS' SSH IS POST-QUANTUM ONLY, against a real `sshd`.
  #
  # `ronoctua-git`'s test, ignored in a plain `cargo test` (no sshd there), is
  # run here with the pinned one: a git fetch of the belongings' credentials
  # (`pq_only`) from an sshd that offers only X25519 is refused as
  # `NotPostQuantum`, the SAME server is reached by a session that is not
  # narrowed (so the refusal is the narrowing's), and servers offering only
  # ML-KEM or only sntrup761 (GitHub's, until 2026-10-14) get past the key
  # exchange. The Rust list is held to `assets/ssh.nix`. Then the belongings'
  # own test: the deploy key's credentials are `pq_only`, and git's refusal
  # becomes the belongings' sentence.
  belongings-ssh-is-pq-only =
    let
      sshd = "${pkgs.openssh}/bin/sshd";
      # `ronoctua-git`'s tests are given its programs while they run.
      ssh = (rust.test.runEnvOf "ronoctua-git").RONOCTUA_SSH or "";
      git = rust.testsOf {
        name = "ronoctua-belongings-ssh-is-pq-only-git";
        crate = "ronoctua-git";
        exact = "tests::a_post_quantum_only_session_refuses_a_classical_server";
        includeIgnored = true;
        env = {
          RONOCTUA_SSHD = sshd;
          RONOCTUA_SSH_KEYGEN = "${pkgs.openssh}/bin/ssh-keygen";
          RONOCTUA_SSH_PQ_KEX = lib.concatStringsSep "," (import ../assets/ssh.nix).postQuantum;
        };
        expect = "test result: ok. 1 passed";
        pre = ''
          test -x ${sshd} && test -x "${ssh}" || {
            echo "ERROR: the test would not run: no sshd or no ssh" >&2
            exit 1
          }
        '';
      };
      belongings = rust.testsOf {
        name = "ronoctua-belongings-ssh-is-pq-only-belongings";
        crate = "ronoctua-belongings";
        exact = "engine::tests::the_belongings_ssh_is_post_quantum_only";
        expect = "test result: ok. 1 passed";
      };
    in
    pkgs.runCommand "ronoctua-belongings-ssh-is-pq-only" { } ''
      mkdir -p $out
      cat ${git}/log ${belongings}/log > $out/ran.txt
    '';

  # THE BELONGINGS' HTTPS IS POST-QUANTUM ONLY, against a real TLS server.
  #
  # git has no setting for TLS groups; the narrowing is an OpenSSL
  # configuration (`nix/pq-tls.nix`, `OPENSSL_CONF`), and OpenSSL ignores one
  # it cannot use WITHOUT A WORD — so only this shows it is there. The pinned
  # git, under the file the build ships, fetches with the belongings' token
  # (`pq_only`) from `openssl s_server`s: one with X25519 alone, one with the
  # NIST curves alone, one with TLS 1.2 alone — each refused as
  # `NotPostQuantum`, and each REACHED by a token that is not narrowed (so the
  # refusal is the narrowing's) — and ones with `X25519MLKEM768` and
  # `SecP384r1MLKEM1024` alone, reached. Then the belongings' own test: the
  # token's credentials are `pq_only`.
  belongings-https-is-pq-only =
    let
      openssl = "${pkgs.openssl.bin}/bin/openssl";
      # The narrowing `ronoctua-git`'s tests are given while they run.
      narrowing = (rust.test.runEnvOf "ronoctua-git").RONOCTUA_GIT_PQ_TLS or "";
      git = rust.testsOf {
        name = "ronoctua-belongings-https-is-pq-only-git";
        crate = "ronoctua-git";
        exact = "tests::a_post_quantum_only_token_refuses_a_classical_tls_server";
        includeIgnored = true;
        env.RONOCTUA_OPENSSL = openssl;
        expect = "test result: ok. 1 passed";
        pre = ''
          test -x ${openssl} && test -f "${narrowing}" || {
            echo "ERROR: the test would not run: no openssl or no narrowing" >&2
            exit 1
          }
        '';
      };
      belongings = rust.testsOf {
        name = "ronoctua-belongings-https-is-pq-only-belongings";
        crate = "ronoctua-belongings";
        exact = "engine::tests::the_belongings_https_is_post_quantum_only";
        expect = "test result: ok. 1 passed";
      };
    in
    pkgs.runCommand "ronoctua-belongings-https-is-pq-only" { } ''
      mkdir -p $out
      cat ${git}/log ${belongings}/log > $out/ran.txt
    '';

  # NO RSA HOST KEY, anywhere an sshd of ours could start.
  #
  # The ISO's sshd as it would load its keys (`sshd -G -T`: with no `HostKey`
  # line it falls back to RSA, ECDSA and ed25519, so this is the line that
  # matters), the installed systems' `hostKeys` (sshd is off there, and would
  # make an RSA key at its first start without this), what `/persist` keeps,
  # and the rule that removes the pair a machine kept before.
  no-rsa-host-key =
    let
      config = name: self.nixosConfigurations.${name}.config;
      types =
        name: lib.concatMapStringsSep " " (k: k.type or "?") (config name).services.openssh.hostKeys;
      kept = name: lib.concatStringsSep " " (config name).ronoctua.persist.files;
      removes = name: lib.concatStringsSep "\n" (config name).systemd.tmpfiles.rules;
    in
    mkCheck "no-rsa-host-key"
      [
        pkgs.openssh
        pkgs.gnugrep
        pkgs.gawk
        pkgs.coreutils
      ]
      ''
        failed=0
        # `sshd -T` names its keywords in mixed case: compared folded.
        loads=$(sshd -G -T -C lport=22 -f ${(config "installer").environment.etc."ssh/sshd_config".source} \
          | awk 'tolower($1) == "hostkey" { print $2 }')
        [ "$loads" = /etc/ssh/ssh_host_ed25519_key ] || {
          echo "ERROR: the ISO's sshd would load these host keys: $loads" >&2
          failed=1
        }
        for pair in "noctua=${types "noctua"}" "minimal=${types "minimal"}"; do
          [ "''${pair#*=}" = ed25519 ] || {
            echo "ERROR: an sshd on ''${pair%%=*} would make these host keys: ''${pair#*=}" >&2
            failed=1
          }
        done
        for pair in "noctua=${kept "noctua"}" "minimal=${kept "minimal"}"; do
          case "''${pair#*=}" in
            *rsa*) echo "ERROR: /persist on ''${pair%%=*} still keeps an RSA host key" >&2; failed=1 ;;
          esac
        done
        cat > rules.txt <<'END'
        ${removes "noctua"}
        END
        for gone in /persist/etc/ssh/ssh_host_rsa_key /persist/etc/ssh/ssh_host_rsa_key.pub; do
          grep -qE "^ *r $gone " rules.txt || {
            echo "ERROR: nothing removes $gone, which a machine kept before" >&2
            failed=1
          }
        done
        [ "$failed" = 0 ] || exit 1
        echo "OK: every sshd of ours has one host key, ed25519, and /persist keeps no RSA one"
      '';

  # ── anchor: L03 ──
  # A MACHINE'S FLAKE, AS THE TEMPLATE WRITES IT, IS THE REFERENCE MACHINE.
  #
  # `tests/fixtures/machine/` is a machine directory exactly as the installer
  # makes one: the template's `flake.nix` (byte for byte — the check refuses a
  # copy that drifted), the installer's `host.nix` (`host-nix-golden-evaluates`)
  # and a hardware report. Its `outputs`, called with THIS distro as the
  # `ronoctua` input, must give one `nixosConfigurations` attribute named after
  # the person, the two outputs the update's verification reads, and a system
  # whose `toplevel` is the reference `noctua`'s own — the same derivation, so
  # the reference IS what a machine builds and not a lookalike. A flake.nix
  # that claims another contract is refused.
  #
  # It evaluates two whole systems (the template's and the reference), which
  # is the price of the equality, and builds neither.
  machine-template-evaluates =
    let
      fixture = ./fixtures/machine;
      written = import (fixture + "/flake.nix");
      outputs = written.outputs {
        ronoctua = self;
        self = written;
      };
      names = builtins.attrNames outputs.nixosConfigurations;
      built = outputs.nixosConfigurations.${builtins.head names};
      otherContract = builtins.tryEval (
        builtins.attrNames (
          self.lib.machineFlake {
            dir = fixture;
            contract = 2;
          }
        )
      );
      facts = pkgs.writeText "machine-template-facts.json" (
        builtins.toJSON {
          template = builtins.readFile ../templates/machine/flake.nix;
          copy = builtins.readFile (fixture + "/flake.nix");
          url = written.inputs.ronoctua.url;
          inherit names user;
          outputs = builtins.attrNames outputs;
          host = built.config.networking.hostName;
          toplevel = builtins.unsafeDiscardStringContext built.config.system.build.toplevel.drvPath;
          reference = builtins.unsafeDiscardStringContext self.nixosConfigurations.noctua.config.system.build.toplevel.drvPath;
          refusesOtherContract = !otherContract.success;
        }
      );
    in
    mkCheck "machine-template-evaluates" [ pkgs.python3 ] ''
      python3 - <<'END'
      import json, sys
      f = json.load(open("${facts}"))
      wrong = []
      if f["template"] != f["copy"]:
          wrong.append("tests/fixtures/machine/flake.nix is not templates/machine/flake.nix byte for byte")
      if f["url"] != "github:ronoctua/ronoctua-distro/release":
          wrong.append(f"the template follows {f['url']!r}, not the release branch")
      if f["names"] != [f["user"]]:
          wrong.append(f"nixosConfigurations is {f['names']}, not [{f['user']!r}]")
      for name in ("nixosConfigurations", "personEntries", "personFingerprints"):
          if name not in f["outputs"]:
              wrong.append(f"the machine flake has no `{name}`")
      if f["host"] != "noctua-reference":
          wrong.append(f"the fixture's host.nix was not read (hostName {f['host']!r})")
      if not f["toplevel"].endswith(".drv") or f["toplevel"] != f["reference"]:
          wrong.append("the template's system is not the reference `noctua`:\n"
                       f"         {f['toplevel']}\n         {f['reference']}")
      if not f["refusesOtherContract"]:
          wrong.append("a flake.nix written for contract 2 was accepted")
      if wrong:
          print("ERROR: a machine's flake, as the template writes it, is not the reference machine.",
                file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: the template builds `{f['user']}`, the reference machine itself ({f['toplevel']})")
      END
    '';

  # THE MACHINE USES EXACTLY THE PINS THE GATE TESTED.
  #
  # `lib.machine` compares every input the distro received — all the way down
  # the lock graph — with the `narHash` the distro's own `flake.lock` names.
  # This builds the reference machine over FOUR sets of inputs: the real ones
  # (it must build), and three a machine flake could hand the distro — its
  # nixpkgs replaced (`ronoctua.inputs.nixpkgs.follows`), an input of an input
  # replaced (`ronoctua/lanzaboote/crane`), and a `follows` of the distro's own
  # lock rewired (`ronoctua/lanzaboote/nixpkgs`). Each of the three must stop
  # evaluation. Everything but the hash is the real input, so nothing else
  # could be what refused.
  machine-uses-the-distro-pins =
    let
      tamper = input: input // { narHash = "sha256-${lib.fixedWidthString 43 "A" ""}="; };
      replaced = inputs // {
        nixpkgs = tamper inputs.nixpkgs;
      };
      deeper = inputs // {
        lanzaboote = inputs.lanzaboote // {
          inputs = inputs.lanzaboote.inputs // {
            crane = tamper inputs.lanzaboote.inputs.crane;
          };
        };
      };
      followed = inputs // {
        lanzaboote = inputs.lanzaboote // {
          inputs = inputs.lanzaboote.inputs // {
            nixpkgs = tamper inputs.lanzaboote.inputs.nixpkgs;
          };
        };
      };
      builds =
        given:
        builtins.tryEval
          ((machineLib.withInputs given).machine { dir = ./fixtures/machine; }).config.networking.hostName;
      facts = pkgs.writeText "machine-pins-facts.json" (
        builtins.toJSON {
          real = builds inputs;
          replaced = (builds replaced).success;
          deeper = (builds deeper).success;
          followed = (builds followed).success;
        }
      );
    in
    mkCheck "machine-uses-the-distro-pins" [ pkgs.python3 ] ''
      python3 - <<'END'
      import json, sys
      f = json.load(open("${facts}"))
      wrong = []
      if f["real"] != {"success": True, "value": "noctua-reference"}:
          wrong.append(f"the distro's own pins do not build the reference machine: {f['real']}")
      for case, what in (("replaced", "the distro's nixpkgs replaced"),
                         ("deeper", "an input of an input replaced (lanzaboote/crane)"),
                         ("followed", "a follows of the lock rewired (lanzaboote/nixpkgs)")):
          if f[case]:
              wrong.append(f"a machine built with {what}")
      if wrong:
          print("ERROR: a machine does not stop at pins the gate never tested.", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          raise SystemExit(1)
      print("OK: the distro's pins build; a replaced input, a deeper one and a rewired follows refuse")
      END
    '';

  # THE ATTRIBUTE A MACHINE FLAKE BUILDS IS THE ONE EVERYTHING ASKS FOR.
  #
  # It used to be a sentence in two comments (`rescue-flake-target-exists`) and
  # no check. Four places name it, and they must be one name: the attribute
  # the template's flake gives (`nixosConfigurations.<attr>`), the option
  # (`ronoctua.machine.attr`), the person (`ronoctua.user`), and every unit of
  # ours that rebuilds the machine — by `--flake <dir>#<attr>` in what it runs,
  # or by `RONOCTUA_MACHINE_DIR`/`RONOCTUA_MACHINE_ATTR` handed to a program
  # that does. The rescue's rebuild must be one of them.
  machine-flake-target-exists =
    let
      written = import ./fixtures/machine/flake.nix;
      outputs = written.outputs {
        ronoctua = self;
        self = written;
      };
      reference = self.nixosConfigurations.noctua.config;
      ours = lib.filterAttrs (name: _: lib.hasPrefix "ronoctua-" name) reference.systemd.services;
      plain = v: builtins.unsafeDiscardStringContext (toString v);
      facts = pkgs.writeText "machine-target-facts.json" (
        builtins.toJSON {
          names = builtins.attrNames outputs.nixosConfigurations;
          inherit (reference.ronoctua.machine) attr dir;
          person = reference.ronoctua.user;
          units = lib.mapAttrs (_: s: {
            run = plain (s.serviceConfig.ExecStart or "") + "\n" + plain (s.script or "");
            dir =
              if s.environment ? RONOCTUA_MACHINE_DIR then plain s.environment.RONOCTUA_MACHINE_DIR else null;
            attr =
              if s.environment ? RONOCTUA_MACHINE_ATTR then plain s.environment.RONOCTUA_MACHINE_ATTR else null;
          }) ours;
        }
      );
    in
    mkCheck "machine-flake-target-exists" [ pkgs.python3 ] ''
      python3 - <<'END'
      import json, re, sys
      f = json.load(open("${facts}"))
      wrong = []
      if f["names"] != [f["attr"]]:
          wrong.append(f"the template's flake builds {f['names']}, the option says {f['attr']!r}")
      if f["attr"] != f["person"]:
          wrong.append(f"ronoctua.machine.attr is {f['attr']!r} and the person is {f['person']!r}")
      target = f"{f['dir']}#{f['attr']}"
      naming = []
      for unit, u in sorted(f["units"].items()):
          for said in re.findall(r"--flake\s+(\S+)", u["run"]):
              said = said.strip("'\"")
              if said != target:
                  wrong.append(f"{unit} rebuilds `{said}`, not `{target}`")
              else:
                  naming.append(unit)
          if u["dir"] is not None or u["attr"] is not None:
              if (u["dir"], u["attr"]) != (f["dir"], f["attr"]):
                  wrong.append(f"{unit} is handed {u['dir']}#{u['attr']}, not `{target}`")
              else:
                  naming.append(unit)
      if "ronoctua-rescue-rebuild" not in naming:
          wrong.append("the rescue's rebuild (`ronoctua-rescue-rebuild`) names no target at all")
      if wrong:
          print("ERROR: the machine flake's attribute and what asks for it disagree.", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: `{target}` — the template, the option, the person and {len(set(naming))} unit(s)")
      END
    '';

  # THE MACHINE DIRECTORY HAS ONE NAME.
  #
  # It is spelled once, in `nix/machine.nix`; a module reads
  # `ronoctua.machine.dir`, the update's `steps.nix` and `nix/rust.nix` import
  # it, and a program gets `RONOCTUA_MACHINE_DIR`. Written again anywhere, the
  # day it moves the copy keeps pointing at the old place — and the place it
  # points at is the one a rebuild reads. The flake attribute rides with it:
  # `#noctua` written by hand is the person's name spelled again.
  #
  # What it reads is every Nix file of the distro, the brain's modules and
  # every crate — comments, documentation and test modules left out, strings
  # kept, because a string is exactly where the path would be. The installer
  # too: it MAKES the machine directory, under the target's `/mnt`, and a
  # directory it spelled again would be one nothing reads. It asks the
  # machine's flake for the attribute (`nixosConfigurations`), so no file is
  # excused from `#noctua` any more; the set stays, empty, for the day one
  # has to be named — with the reason beside it.
  machine-dir-has-one-name = mkCheck "machine-dir-has-one-name" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the question is whether the literal is ANYWHERE in the code
    # of the installed system; there is no function to narrow to.
    root = pathlib.Path("${self}")
    LITERAL = "/etc/nixos"
    # The attribute, and not a longer one that begins with it
    # (`.#noctua-icon-theme` is a package).
    TARGET = re.compile(r"#noctua(?![\w-])")
    ATTRIBUTE_BY_HAND = set()

    def nix_code(text):
        # Nix with its comments taken off and its strings KEPT — `#` begins a
        # comment only outside a string, and the path would be in a string.
        out, i, n = [], 0, len(text)
        while i < n:
            if text[i] == '"':
                j = i + 1
                while j < n and text[j] != '"':
                    j += 2 if text[j] == "\\" else 1
                out.append(text[i:j + 1])
                i = j + 1
                continue
            if text.startswith("'" + "'", i):
                j = i + 2
                while j < n:
                    if text.startswith("'" * 3, j) or text.startswith("'" + "'$", j) or text.startswith("'" + "'\\", j):
                        j += 3
                        continue
                    if text.startswith("'" + "'", j):
                        break
                    j += 1
                out.append(text[i:j + 2])
                i = j + 2
                continue
            if text[i] == "#":
                while i < n and text[i] != "\n":
                    i += 1
                continue
            if text.startswith("/*", i):
                end = text.find("*/", i + 2)
                i = n if end < 0 else end + 2
                continue
            out.append(text[i])
            i += 1
        return "".join(out)

    def rel(f):
        return f.relative_to(root).as_posix()

    wrong, seen = [], 0
    def judge(f, code):
        global seen
        seen += 1
        if LITERAL in code:
            wrong.append(f"{rel(f)} spells {LITERAL}")
        if TARGET.search(code) and rel(f) not in ATTRIBUTE_BY_HAND:
            wrong.append(f"{rel(f)} spells #noctua")

    one = root / "nix" / "machine.nix"
    if nix_code(one.read_text()).count('"' + LITERAL + '"') != 1:
        wrong.append("nix/machine.nix does not spell the machine directory exactly once")

    nix = [root / "flake.nix"] + sorted((root / "nix").rglob("*.nix")) + sorted((root / "crates").rglob("*.nix"))
    for f in nix:
        r = rel(f)
        if r == "nix/machine.nix":
            continue
        judge(f, nix_code(f.read_text()))
    for f in sorted((root / "nix").rglob("*.py")) + sorted((root / "crates").rglob("*.py")):
        judge(f, hashless(f.read_text()))
    for f in workspace_sources(root / "crates"):
        # A FILE THAT IS A TEST MODULE is a test whole: its `#[cfg(test)]` is
        # on the parent's `mod` line, and `without_tests` cuts nothing here.
        if f.name == "tests.rs" or "tests" in f.relative_to(root / "crates").parts:
            continue
        judge(f, uncommented(without_tests(f.read_text())))
    for f in ATTRIBUTE_BY_HAND:
        if not (root / f).exists():
            wrong.append(f"{f} is gone: drop it from ATTRIBUTE_BY_HAND")
    floor(seen, 1000, "files of the installed system's code")

    if wrong:
        print("ERROR: the machine directory is spelled outside its one name.", file=sys.stderr)
        for w in wrong:
            print("       " + w, file=sys.stderr)
        print("       Read it from `ronoctua.machine.dir` (a module), `nix/machine.nix`", file=sys.stderr)
        print("       (`machineDir`) or `RONOCTUA_MACHINE_DIR` (a program).", file=sys.stderr)
        raise SystemExit(1)
    print(f"OK: {seen} files, and the machine directory is spelled once, in nix/machine.nix")
    END
  '';

  # THE INSTALLER'S host.nix EVALUATES UNDER lib.machine.
  #
  # Two halves. The build half runs the real installer in its dry run with the
  # reference machine's answers and compares the `host.nix` it prints, byte
  # for byte, with `tests/fixtures/machine/host.nix` — so the fixture IS what
  # the installer writes, and an installer that starts writing a new line
  # makes this fail until the fixture is that line too. The evaluation half
  # instantiates the reference machine built from that file through
  # `lib.machine` — the whole `toplevel`, not one option — and reads back
  # what the file said.
  #
  # When it fails because the installer changed: run the same dry run
  # (`RONOCTUA_INST_*` below) and write its `host.nix` into the fixture.
  host-nix-golden-evaluates =
    let
      reference = self.nixosConfigurations.noctua.config;
      facts = pkgs.writeText "host-nix-golden-facts.json" (
        builtins.toJSON {
          toplevel = builtins.unsafeDiscardStringContext reference.system.build.toplevel.drvPath;
          host = reference.networking.hostName;
          disk = reference.ronoctua.disk;
          profile = reference.ronoctua.profile;
          facter = reference.ronoctua.facterReport != null;
        }
      );
    in
    mkCheck "host-nix-golden-evaluates" [ pkgs.python3 ] ''
      # The palettes and the texts (`rust.keyed`): this binary is the unwrapped
      # one, and the colours and the words are data it reads at run time.
      export RONOCTUA_THEMES=${rust.keyed.RONOCTUA_THEMES}
      export RONOCTUA_TEXTS=${rust.keyed.RONOCTUA_TEXTS}
      export RONOCTUA_INST_DISK=/dev/disk/by-id/reference-machine-not-a-disk
      export RONOCTUA_INST_HOSTNAME=noctua-reference
      export RONOCTUA_INST_PASSWORD=fixture-password
      export RONOCTUA_INST_PASSPHRASE=fixture-passphrase
      # The person's repository, mandatory; none of it reaches `host.nix`.
      export RONOCTUA_INST_BELONGINGS=git@example.org:someone/belongings.git
      export RONOCTUA_INST_BELONGINGS_ACCESS=/run/keys/deploy
      export RONOCTUA_INST_BELONGINGS_PASSPHRASE=fixture-belongings-passphrase
      # The reference machine starts from UEFI, with a TPM.
      export RONOCTUA_INSTALLER_SYSROOT=${uefiMachine}
      ${rust.bins.ronoctua-install}/bin/ronoctua-install > said.txt
      python3 - said.txt ${./fixtures/machine/host.nix} ${facts} <<'END'
      import json, sys
      said, golden, facts = sys.argv[1:]
      text = open(said).read()
      if "--- host.nix ---\n" not in text:
          print("ERROR: the installer's dry run no longer prints a host.nix", file=sys.stderr)
          raise SystemExit(1)
      written = text.split("--- host.nix ---\n", 1)[1].split("\n--- ", 1)[0].rstrip("\n") + "\n"
      if written != open(golden).read():
          print("ERROR: tests/fixtures/machine/host.nix is not what the installer writes.", file=sys.stderr)
          print("       The installer writes:", file=sys.stderr)
          print(written, file=sys.stderr)
          raise SystemExit(1)
      f = json.load(open(facts))
      wrong = []
      if not f["toplevel"].endswith(".drv"):
          wrong.append("the reference machine did not instantiate")
      if f["host"] != "noctua-reference":
          wrong.append(f"hostName is {f['host']!r}")
      if f["disk"] != "/dev/disk/by-id/reference-machine-not-a-disk":
          wrong.append(f"the disk is {f['disk']!r}")
      if f["profile"] != "full" or not f["facter"]:
          wrong.append(f"the profile ({f['profile']!r}) or the hardware report did not come from host.nix")
      if wrong:
          print("ERROR: the reference machine is not the one its host.nix describes.", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: the installer's host.nix is the fixture, and it evaluates ({f['toplevel']})")
      END
    '';

  # A BAD ENTRY DOES NOT BREAK THE MACHINE.
  #
  # `tests/fixtures/machine-person/` declares, beside one entry of each source
  # that works, every way an entry can go wrong: a name nixpkgs never had, an
  # alias that throws when read (`autoReconfHook`, kept by nixpkgs as a typo
  # trap), an attribute that is not a package, an unfree package declared
  # without consent, an entry for another machine, one with a field missing and
  # a Flatpak from a remote this machine does not have. Then three variations
  # of the same machine: the update held one entry back (by the fingerprint it
  # has NOW — and by an older one, which holds nothing), the file says a format
  # from the future, and the registry knows two of the declines.
  #
  # Each must evaluate, and the report must say exactly why each entry is
  # where it is. "Evaluate" is everything the entries reach: `/etc` (where the
  # report is) and the person's Home Manager generation (where the programs
  # are). The person's half never touches the system profile
  # (`person-packages-are-per-user`).
  #
  # And the MINIMAL machine, where `allowUnfree` is off and the one predicate
  # is what lets a consented package in (on `full` the Android SDK turns
  # `allowUnfree` on, and the predicate is never asked). Its host turned the
  # system's Flatpak on by hand while the distro's switch is off, so
  # nix-flatpak's per-person list does not exist. It declares, from fixture
  # packages an overlay plants: obsidian with consent (applied — by the
  # predicate, its name in `unfreeNames`), discord without (refused), a
  # consented package whose reading `abort`s — which `tryEval` cannot catch —
  # held by its current fingerprint, a consented unfree package that needs
  # another unfree one (applied: the consent covers what it needs), a free one
  # that needs an unfree one (refused, said as that), and a Flatpak (no
  # source here). The machine must evaluate with the aborting entry held, and
  # the update's verification (`personEntries`, one entry at a time) must
  # evaluate the two consented entries even while the aborting one is NOT
  # held yet.
  person-bad-entry-does-not-break-eval =
    let
      built = machineLib.machine { dir = ./fixtures/machine-person; };
      config = built.config;
      variant = module: (built.extendModules { modules = [ module ]; }).config.ronoctua.person.report;
      heldBy =
        id: fingerprint:
        builtins.toFile "held.json" (
          builtins.toJSON {
            format = 1;
            held = [
              {
                inherit id fingerprint;
                reason = "build-failed";
                since = "2026-10-05T12:00:00Z";
              }
            ];
          }
        );
      nixEntry = attr: unfree: {
        source = "nix";
        id = "nix:${attr}";
        machines = null;
        edited-at = "2026-10-05T12:00:00Z";
        edited-on = "noctua-reference";
        inherit attr unfree;
      };
      minimalData = built.extendModules {
        modules = [
          {
            ronoctua.profile = lib.mkForce "minimal";
            ronoctua.software.flatpak = lib.mkForce false;
            services.flatpak.enable = lib.mkForce true;
            nixpkgs.overlays = [
              (final: prev: {
                fixtureAborts = abort "fixture: reading this package aborts";
                fixtureUnfreeInner = prev.runCommand "fixture-unfree-inner" {
                  meta.license = lib.licenses.unfree;
                } "touch $out";
                fixtureUnfreeOuter = prev.runCommand "fixture-unfree-outer" {
                  meta.license = lib.licenses.unfree;
                  inner = final.fixtureUnfreeInner;
                } "touch $out";
                fixtureFreeOuter = prev.runCommand "fixture-free-outer" {
                  inner = final.fixtureUnfreeInner;
                } "touch $out";
              })
            ];
            ronoctua.person.data = lib.mkForce (
              builtins.toFile "declared.json" (
                builtins.toJSON {
                  format = 1;
                  apps = [
                    (nixEntry "obsidian" true)
                    (nixEntry "discord" false)
                    (nixEntry "fixtureAborts" true)
                    (nixEntry "fixtureUnfreeOuter" true)
                    (nixEntry "fixtureFreeOuter" false)
                    {
                      source = "flatpak";
                      id = "flatpak:org.example.Fixture";
                      machines = null;
                      edited-at = "2026-10-05T12:00:00Z";
                      edited-on = "noctua-reference";
                      app-id = "org.example.Fixture";
                      origin = "flathub";
                    }
                  ];
                }
              )
            );
          }
        ];
      };
      minimal =
        (minimalData.extendModules {
          modules = [
            {
              ronoctua.person.held = lib.mkForce (
                heldBy "nix:fixtureAborts" minimalData.config.ronoctua.person.fingerprints."nix:fixtureAborts"
              );
            }
          ];
        }).config;
      # The verification's view, BEFORE anything is held: only the two
      # consented entries are read (reading the aborting one is its own
      # failure, and stops evaluation as it should).
      verify = machineLib.entriesOf minimalData;
      evaluates = drv: (builtins.tryEval (builtins.unsafeDiscardStringContext drv.drvPath)).success;
      facts = pkgs.writeText "person-bad-entry-facts.json" (
        builtins.toJSON {
          report = config.ronoctua.person.report;
          held = variant {
            ronoctua.person.held = lib.mkForce (heldBy "nix:sl" config.ronoctua.person.fingerprints."nix:sl");
          };
          stale = variant { ronoctua.person.held = lib.mkForce (heldBy "nix:sl" "an-older-fingerprint"); };
          minimal = {
            inherit (minimal.ronoctua.person) report unfreeNames;
            allowUnfree = minimal.nixpkgs.config.allowUnfree;
            flatpakSwitch = minimal.ronoctua.software.flatpak;
            systemFlatpak = minimal.services.flatpak.enable;
            etc = builtins.unsafeDiscardStringContext minimal.system.build.etc.drvPath;
            home =
              builtins.unsafeDiscardStringContext
                minimal.home-manager.users.${user}.home.activationPackage.drvPath;
            verified = {
              obsidian = evaluates verify."nix:obsidian";
              fixtureUnfreeOuter = evaluates verify."nix:fixtureUnfreeOuter";
            };
            verifiable = builtins.attrNames verify;
          };
          newer = variant {
            ronoctua.person.data = lib.mkForce (
              builtins.toFile "declared.json" (
                builtins.toJSON {
                  format = 2;
                  apps = [
                    {
                      source = "nix";
                      id = "nix:cowsay";
                    }
                  ];
                }
              )
            );
          };
          declined =
            (variant {
              ronoctua.apps = {
                fixture-renamed.formerly = [ "fixture-old-name" ];
                fixture-essential.essential = "the-login-shell";
              };
            }).declined;
          etc = builtins.unsafeDiscardStringContext config.system.build.etc.drvPath;
          home =
            builtins.unsafeDiscardStringContext
              config.home-manager.users.${user}.home.activationPackage.drvPath;
        }
      );
    in
    mkCheck "person-bad-entry-does-not-break-eval" [ pkgs.python3 ] ''
      python3 - <<'END'
      import json, sys
      f = json.load(open("${facts}"))
      wrong = []

      def why(report):
          return {s["id"]: (s["reason"], s["detail"]) for s in report["skipped"]}

      r = f["report"]
      expected_applied = ["nix:cowsay", "nix:obsidian", "nix:sl", "flatpak:org.example.Fixture",
                          "appimage:fixture-tool", "web:fixture-web", "android:org.example.fixture"]
      if r["applied"] != expected_applied:
          wrong.append(f"applied: {r['applied']}")
      expected = {
          "nix:gone-from-nixpkgs-fixture": "attr-missing",
          "nix:autoReconfHook": "attr-missing",
          "nix:lib": "not-a-package",
          "nix:discord": "refused-by-meta",
          "nix:hello": "other-machine",
          "nix:figlet": "format-unknown",
          "flatpak:org.example.Elsewhere": "source-off",
      }
      got = {k: v[0] for k, v in why(r).items()}
      if got != expected:
          wrong.append(f"skipped: {got}")
      if any(not detail for _, detail in why(r).values()):
          wrong.append("a skipped entry does not say why")
      if r["machine"] != "noctua-reference" or not r["distro-rev"]:
          wrong.append(f"the report names machine {r['machine']!r}, revision {r['distro-rev']!r}")

      if why(f["held"]).get("nix:sl") != ("held", "build-failed") or "nix:sl" in f["held"]["applied"]:
          wrong.append("an entry held by its current fingerprint was not held")
      if "nix:sl" not in f["stale"]["applied"]:
          wrong.append("an entry held by an OLDER fingerprint stayed held")

      n = f["newer"]
      if n["applied"] != [] or why(n) != {"nix:cowsay": why(n).get("nix:cowsay")} \
              or why(n)["nix:cowsay"][0] != "format-unknown":
          wrong.append(f"a file in a future format: {n}")

      d = f["declined"]
      if d["honoured"] != ["fixture-old-name"] or d["unknown"] != ["fixture-unknown"] \
              or d["refused"] != [{"id": "fixture-essential", "reason": "the-login-shell"}]:
          wrong.append(f"the declines: {d}")

      if not f["etc"].endswith(".drv") or not f["home"].endswith(".drv"):
          wrong.append("the machine's /etc or the person's generation did not instantiate")

      m = f["minimal"]
      if m["allowUnfree"] is not False or m["flatpakSwitch"] is not False or m["systemFlatpak"] is not True:
          wrong.append("the minimal variant is not a machine where the predicate decides and Flatpak "
                       f"is on by hand only (allowUnfree {m['allowUnfree']}, ronoctua.software.flatpak "
                       f"{m['flatpakSwitch']}, services.flatpak.enable {m['systemFlatpak']}): "
                       "it proves nothing")
      mr = m["report"]
      if mr["applied"] != ["nix:obsidian", "nix:fixtureUnfreeOuter"]:
          wrong.append(f"minimal, applied: {mr['applied']} (a consented unfree package must go in "
                       "through the predicate, and one that needs another unfree one by its consent)")
      mw = why(mr)
      want = {
          "nix:discord": ("refused-by-meta", "consent"),
          "nix:fixtureAborts": ("held", "build-failed"),
          "nix:fixtureFreeOuter": ("refused-by-meta", "needs unfree packages"),
          "flatpak:org.example.Fixture": ("source-off", "flatpak"),
      }
      if set(mw) != set(want) or any(mw[k][0] != r or s not in mw[k][1] for k, (r, s) in want.items()):
          wrong.append(f"minimal, skipped: {mw}")
      if m["unfreeNames"] != ["obsidian", "fixture-unfree-outer"]:
          wrong.append(f"minimal, the consented names: {m['unfreeNames']} (a held entry is never read "
                       "for its name, and a consent widens no name)")
      if not m["etc"].endswith(".drv") or not m["home"].endswith(".drv"):
          wrong.append("the minimal machine's /etc or the person's generation did not instantiate")
      if sorted(m["verifiable"]) != sorted(["nix:obsidian", "nix:discord", "nix:fixtureAborts",
                                            "nix:fixtureUnfreeOuter", "nix:fixtureFreeOuter"]):
          wrong.append(f"minimal, the entries the update verifies: {m['verifiable']}")
      if m["verified"] != {"obsidian": True, "fixtureUnfreeOuter": True}:
          wrong.append("the update's verification of a consented entry fails while a sibling that "
                       f"aborts is not held yet: {m['verified']}")
      if wrong:
          print("ERROR: a bad declaration is not skipped and said, or it broke the machine.",
                file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: {len(r['applied'])} applied, {len(r['skipped'])} skipped with their reasons; "
            "held, future format and declines said; the machine evaluates; on minimal the "
            "predicate takes the consent, a held entry that aborts is never read, and each "
            "consented entry verifies alone")
      END
    '';

  # THE PERSON'S PROGRAMS GO TO THE PERSON.
  #
  # Every declared program lands in the person's Home Manager profile (a
  # package, an AppImage's wrapper, a web app's launcher entry), the person's
  # own Flatpak installation, or the list the reconciler installs Android apps
  # from — and NOT in `environment.systemPackages` nor the system's Flatpak
  # installation. And it is there BECAUSE of the declaration: the reference
  # machine, which declares nothing, has none of them.
  person-packages-are-per-user =
    let
      person = (machineLib.machine { dir = ./fixtures/machine-person; }).config;
      reference = self.nixosConfigurations.noctua.config;
      names =
        ps:
        map (
          p:
          let
            r = builtins.tryEval (lib.getName p);
          in
          if r.success then r.value else ""
        ) ps;
      facts = pkgs.writeText "person-per-user-facts.json" (
        builtins.toJSON {
          home = names person.home-manager.users.${user}.home.packages;
          system = names person.environment.systemPackages;
          referenceHome = names reference.home-manager.users.${user}.home.packages;
          referenceSystem = names reference.environment.systemPackages;
          flatpakPerson = map (p: p.appId) person.home-manager.users.${user}.services.flatpak.packages;
          flatpakSystem = map (p: p.appId or p) person.services.flatpak.packages;
          desktop = builtins.attrNames person.home-manager.users.${user}.xdg.desktopEntries;
          android = map (a: "${a.id} ${a.from}") person.ronoctua.declaredAndroid;
        }
      );
    in
    mkCheck "person-packages-are-per-user" [ pkgs.python3 ] ''
      python3 - <<'END'
      import json, sys
      f = json.load(open("${facts}"))
      wrong = []
      for name in ("cowsay", "obsidian", "sl", "ronoctua-appimage-fixture-tool",
                   "ronoctua-web-fixture-web.desktop"):
          if name not in f["home"]:
              wrong.append(f"{name} is not in the person's profile")
          if name in f["system"]:
              wrong.append(f"{name} is in environment.systemPackages")
          if name in f["referenceHome"] or name in f["referenceSystem"]:
              wrong.append(f"{name} is on the reference machine too: the check proves nothing")
      if "org.example.Fixture" not in f["flatpakPerson"]:
          wrong.append("the declared Flatpak is not on the person's installation's list")
      if "org.example.Fixture" in f["flatpakSystem"]:
          wrong.append("the declared Flatpak is on the system installation's list")
      if "ronoctua-web-fixture-web" not in f["desktop"]:
          wrong.append("the web app is not one of the person's launcher entries")
      if f["android"] != ["android:org.example.fixture person"]:
          wrong.append(f"the apks for the reconciler: {f['android']}")
      if wrong:
          print("ERROR: the person's declared programs are not the person's.", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          raise SystemExit(1)
      print("OK: packages, AppImage, web app, Flatpak and apk go to the person, and only by declaring")
      END
    '';

  # A MODULE THAT REACHES ROOT NEEDS AN APPROVAL OF WHAT IT IS NOW.
  #
  # `tests/fixtures/machine-brain/` carries six of the person's brain
  # modules: two with no NixOS half (they run as the person: included), one
  # with a NixOS half that an approval names by its current hash (imported),
  # one no approval names (not imported), one whose approval names the hash
  # it had BEFORE an edit (not imported), and one, approved, that imports a
  # SIBLING by `../` when it can — `my-common`, which needs no approval
  # because it has no NixOS half of its own. The approved module must be
  # imported and the sibling must not: what runs as root is what the
  # approval's hash covers. The NixOS halves each write a file in `/etc`, so
  # "imported" is asked of the built configuration and not of a list; the
  # report must name the two that wait, with the hash an approval would have
  # to name — the one `nix/person-hash.nix` computes now.
  person-root-module-needs-approval =
    let
      fixture = ./fixtures/machine-brain;
      built = (machineLib.machine { dir = fixture; }).config;
      hashOf = id: import ../nix/person-hash.nix (fixture + "/person/brain/${id}");
      approved = (builtins.fromJSON (builtins.readFile (fixture + "/local/approved.json"))).modules;
      facts = pkgs.writeText "person-approval-facts.json" (
        builtins.toJSON {
          etc = builtins.filter (lib.hasPrefix "ronoctua-fixture-") (
            builtins.attrNames built.environment.etc
          );
          inherit (built.ronoctua.person.report) brain;
          included = map baseNameOf built.ronoctua.person.brainModules;
          hashes = lib.genAttrs [
            "my-approved"
            "my-edited"
            "my-unapproved"
            "my-reaching"
          ] hashOf;
          sibling = builtins.pathExists (fixture + "/person/brain/my-common/helper.nix");
          approved = lib.mapAttrs (_: a: a.hash) approved;
        }
      );
    in
    mkCheck "person-root-module-needs-approval" [ pkgs.python3 ] ''
      python3 - <<'END'
      import json, sys
      f = json.load(open("${facts}"))
      wrong = []
      if f["approved"].get("my-approved") != f["hashes"]["my-approved"]:
          wrong.append("the fixture's approval does not name my-approved as it is: the check proves nothing")
      if f["approved"].get("my-edited") in (None, f["hashes"]["my-edited"]):
          wrong.append("the fixture's my-edited is not edited after its approval: the check proves nothing")
      if f["approved"].get("my-reaching") != f["hashes"]["my-reaching"] or not f["sibling"]:
          wrong.append("the fixture's my-reaching is not approved as it is, or my-common has no helper.nix "
                       "for it to reach: the check proves nothing")
      if "ronoctua-fixture-my-common" in f["etc"]:
          wrong.append("an approved module reached a sibling by `../`: root ran code no approval covers")
      if f["etc"] != ["ronoctua-fixture-my-approved", "ronoctua-fixture-my-reaching"]:
          wrong.append(f"the NixOS halves imported: {f['etc']}")
      expected = ["my-approved", "my-common", "my-plain", "my-reaching"]
      if sorted(f["included"]) != expected or sorted(f["brain"]["included"]) != expected:
          wrong.append(f"the modules included: {f['included']}")
      waiting = {a["id"]: a["hash"] for a in f["brain"]["awaiting-approval"]}
      if waiting != {"my-edited": f["hashes"]["my-edited"], "my-unapproved": f["hashes"]["my-unapproved"]}:
          wrong.append(f"the modules awaiting approval: {waiting}")
      if wrong:
          print("ERROR: a module that reaches root is imported without an approval of what it is.",
                file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          raise SystemExit(1)
      print("OK: approved → imported, from its own folder alone; unapproved and edited after "
            "approval → waiting, by their hashes")
      END
    '';

  # A DECLARED WEB APP'S WINDOW ID IS THE RUST'S.
  #
  # The launcher entry of a web app the person DECLARES is written by Nix
  # (`nix/declared-apps/web.nix`), and its `StartupWMClass` repeats the
  # arithmetic of `web::app_id` — how the modeline names the window, and what
  # the imperative copy carries. Nix has no URL parser, so it refuses every
  # address a browser would rewrite before naming the window. This reads the
  # one table the Rust test (`the_declared_web_app_ids_are_this_arithmetic`)
  # holds `web::app_id` to: every `agree` address must pass the Nix shape and
  # give the Rust's id; every `refused` one — which the Rust test proves a
  # browser rewrites — must be refused with a sentence.
  web-app-ids-agree =
    let
      web = import ../nix/declared-apps/web.nix { inherit lib pkgs; };
      table = builtins.fromJSON (builtins.readFile ../crates/ronoctua-software/fixtures/web-app-ids.json);
      entry = row: {
        slug = "fixture";
        name = "Fixture";
        inherit (row) url profile;
      };
      facts = pkgs.writeText "web-app-ids-facts.json" (
        builtins.toJSON {
          agree = map (
            row:
            row
            // {
              shape = web.shape (entry row);
              got = web.appId row.url row.profile;
            }
          ) table.agree;
          refused = map (row: row // { shape = web.shape (entry row); }) table.refused;
        }
      );
    in
    mkCheck "web-app-ids-agree" [ pkgs.python3 ] ''
      python3 - <<'END'
      import json, sys
      f = json.load(open("${facts}"))
      wrong = []
      if len(f["agree"]) < 10 or len(f["refused"]) < 10:
          wrong.append("the table lost its rows: the check proves nothing")
      for row in f["agree"]:
          if row["shape"] is not None:
              wrong.append(f"{row['url']!r} is refused: {row['shape']}")
          elif row["got"] != row["id"]:
              wrong.append(f"{row['url']!r} {row['profile']!r}: Nix gives {row['got']!r}, the Rust {row['id']!r}")
      for row in f["refused"]:
          if not row["shape"]:
              wrong.append(f"{row['url']!r} is taken, and a browser rewrites it before naming the window")
      if wrong:
          print("ERROR: a declared web app would carry another window id than the Rust gives it.",
                file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          raise SystemExit(1)
      print(f"OK: {len(f['agree'])} addresses give the Rust's id, {len(f['refused'])} a browser "
            "rewrites are refused")
      END
    '';
  # ── anchor: L04 ──
  # THE PROGRAM REGISTRY (`nix/modules/distro-apps.nix`) — five checks.
  #
  # The registry is what puts the distro's programs on a machine, and a
  # person's decline (`software/declined.json`) is what takes one off. Each
  # check below asks one half of that promise of the EVALUATED systems and
  # never of the modules' text: what a machine gets is the configuration, not
  # the expression that made it.
  distroAppsTable = import ../assets/distro-apps.nix;

  # A MACHINE WITH DECLINES, and the same machine without them. The full
  # profile, extended twice by evaluation only: a declined file in the shape
  # the person's data has (`crates/ronoctua-person`), one program of the
  # registry renamed (`check-renamed`, once `check-before`), so the rename's
  # promise is asked of the same machinery as everything else, and one this
  # machine does not carry (`check-absent`, `when = false`). One more way in
  # for `htop` (a second `systemPackages` line) is what `still-present` must
  # notice. And the MINIMAL profile with the same declines, where Chrome and
  # VLC are not carried at all: a decline there must not read as one here.
  #
  # Every store path leaves WITHOUT its context: these are facts about what
  # a machine would hold, and building any of it is not the question.
  distroAppsDeclines =
    let
      discard = builtins.unsafeDiscardStringContext;
      base = self.nixosConfigurations.noctua;
      host = base.config.networking.hostName;
      decline = id: machines: {
        inherit id machines;
        edited-at = "2026-10-05T12:00:00Z";
        edited-on = host;
      };
      declined = builtins.toFile "declined.json" (
        builtins.toJSON {
          format = 1;
          apps = [
            (decline "vlc" null)
            (decline "chrome" [ host ])
            (decline "zsh" null)
            (decline "no-such-app" null)
            (decline "emacs" [ "elsewhere" ])
            (decline "orca-slicer" null)
            (decline "claude-code" null)
            (decline "htop" null)
            (decline "check-before" null)
            (decline "check-absent" null)
            (decline "android-sdk" null)
            (decline "flutter" null)
            (decline "tealdeer" null)
            # A LINE OF NO KNOWN SHAPE (`machines` is a list or null): the
            # root applier refuses such a file, and if one arrives anyway it
            # is left out — never a reason for the machine not to evaluate.
            (decline "mpv" host)
          ];
        }
      );
      renamed =
        { pkgs, ... }:
        {
          ronoctua.apps.check-renamed = {
            package = pkgs.hello;
            formerly = [ "check-before" ];
          };
          ronoctua.apps.check-absent = {
            package = pkgs.cowsay;
            when = false;
          };
        };
      # FORCED: the machine's own flake may name a declined file of its own,
      # and the fixture's is the one asked about.
      declines = {
        ronoctua.person.declined = lib.mkForce declined;
      };
      before = base.extendModules { modules = [ renamed ]; };
      after = base.extendModules {
        modules = [
          renamed
          declines
          ({ pkgs, ... }: { environment.systemPackages = [ pkgs.htop ]; })
        ];
      };
      minimal = self.nixosConfigurations.minimal.extendModules {
        modules = [
          renamed
          declines
        ];
      };
      # Every value a session variable or the lifeline's unit carries: a
      # declined program's store path in one of them keeps it in the closure.
      valuesOf = lib.mapAttrsToList (_: v: discard (toString v));
      factsOf =
        system:
        let
          c = system.config;
        in
        {
          installed = map (p: discard (p.outPath or "")) c.environment.systemPackages;
          programs = lib.mapAttrs (_: e: discard e.package.outPath) (
            lib.filterAttrs (_: e: e.package != null) c.ronoctua.apps
          );
          report = c.ronoctua.distroApps.declinedReport;
          registry = builtins.fromJSON c.environment.etc."ronoctua/distro-apps.json".text;
          browser = c.ronoctua.browser.enable;
          editor = c.ronoctua.editor.emacs;
          models = c.xdg.mime.defaultApplications."model/stl" or null;
          lifeline = c.systemd.user.services.ronoctua-lifeline.environment ? RONOCTUA_CLAUDE;
          carried =
            valuesOf c.environment.sessionVariables
            ++ valuesOf c.systemd.user.services.ronoctua-lifeline.environment;
          tldr = {
            service = c.systemd.services ? tealdeer-update;
            step = c.ronoctua.update.steps.tldr-cache or null;
          };
        };
    in
    pkgs.writeText "distro-apps-declines.json" (
      builtins.toJSON {
        before = factsOf before;
        after = factsOf after;
        minimal = builtins.fromJSON minimal.config.environment.etc."ronoctua/distro-apps.json".text;
      }
    );

  # A DECLINE TAKES THE PROGRAM OFF THE MACHINE — and only where it applies.
  #
  # Every program the fixture declines is first shown INSTALLED without the
  # decline: a comparison whose "before" never had the program would pass
  # over a registry that installs nothing. Then: a decline for every machine
  # and one for this machine remove theirs; one for another machine does
  # nothing here; an essential program stays and the report says why; an id
  # the registry never had is reported unknown; a program with a second way
  # in is honoured AND reported still present; the switches that hang off a
  # program (the browser, the model types, the lifeline's AI) follow it; and
  # `/etc/ronoctua/distro-apps.json` says all of it in its frozen shape.
  declining-an-app-removes-it = mkCheck "declining-an-app-removes-it" [ pkgs.python3 ] ''
    python3 - <<'END'
    import json, sys

    # PARSED: the two machines arrive as their evaluated configuration, JSON.
    facts = json.load(open("${distroAppsDeclines}"))
    before, after = facts["before"], facts["after"]
    wrong = []

    def has(side, app):
        return side["programs"][app] in side["installed"]

    declined = ["vlc", "chrome", "orca-slicer", "claude-code", "check-renamed",
                "android-sdk", "flutter", "tealdeer"]
    kept = ["zsh", "emacs", "htop", "mpv"]
    for app in declined + kept:
        if not has(before, app):
            wrong.append(f"without a decline `{app}` is not installed, so its decline proves nothing")
    for app in declined:
        if has(after, app):
            wrong.append(f"`{app}` was declined and is still in `systemPackages`")
    if not has(after, "zsh"):
        wrong.append("`zsh` is essential and a decline took it away")
    if not has(after, "emacs") or not after["editor"]:
        wrong.append("`emacs` was declined for ANOTHER machine and left this one")
    if not has(after, "htop"):
        wrong.append("`htop` came in a second way and the fixture lost it: the still-present case is not reached")
    if has(before, "check-absent") or has(after, "check-absent"):
        wrong.append("`check-absent` is not carried by this machine and was installed")

    # A DECLINED PROGRAM LEAVES THE CLOSURE TOO: no session variable and no
    # variable of the lifeline names its store path. Asked first of the
    # machine without declines, where the SDK's path IS in `ANDROID_HOME` —
    # a probe that finds nothing there finds nothing anywhere.
    def named(side, app):
        return [v for v in side["carried"] if side["programs"][app] in v]
    for app in ("android-sdk", "flutter", "claude-code"):
        if not named(before, app):
            wrong.append(f"without a decline no variable names `{app}`, so its absence later proves nothing")
    for app in declined:
        for value in named(after, app):
            wrong.append(f"`{app}` was declined and a variable still names it: {value}")
    if before["tldr"] != {"service": True, "step": True} or after["tldr"] != {"service": False, "step": False}:
        wrong.append(f"the tldr cache did not follow `tealdeer`: {before['tldr']} before, {after['tldr']} after")

    report = after["report"]
    if sorted(report["honoured"]) != sorted(["vlc", "chrome", "orca-slicer", "claude-code", "htop", "check-before",
                                             "check-absent", "android-sdk", "flutter", "tealdeer"]):
        wrong.append(f"the report's `honoured` is {report['honoured']}")
    if report["refused"] != [{"id": "zsh", "reason": "the-login-shell"}]:
        wrong.append(f"the report's `refused` is {report['refused']}, not zsh with its reason")
    if any("mpv" in report[k] for k in ("honoured", "unknown", "still-present")):
        wrong.append(f"a decline whose `machines` is not a list was read: {report}")
    if report["unknown"] != ["no-such-app"]:
        wrong.append(f"the report's `unknown` is {report['unknown']}")
    if report["still-present"] != ["htop"]:
        wrong.append(f"the report's `still-present` is {report['still-present']}, not htop")
    if before["report"] != {"honoured": [], "refused": [], "unknown": [], "still-present": []}:
        wrong.append(f"a machine with no declines reports {before['report']}")

    # THE SWITCHES THAT HANG OFF A PROGRAM follow it.
    if before["browser"] is not True or after["browser"] is not False:
        wrong.append("declining Chrome did not turn `ronoctua.browser.enable` off")
    if not before["models"] or after["models"] is not None:
        wrong.append("declining OrcaSlicer left the model types opening in it")
    if before["lifeline"] is not True or after["lifeline"] is not False:
        wrong.append("declining Claude Code left the lifeline offering it")

    # AND THE REGISTRY'S FILE SAYS SO, in the shape `ronoctua-person` reads
    # (`reports::DistroApps`, unknown fields refused).
    # `appimage` says which pin built a distro AppImage, and `followed` what
    # the registry made of the person's followed pins (2026-10-20).
    keys = {"id", "name", "source", "desktop-ids", "essential", "group", "on-this-machine", "declined-here", "appimage"}
    for side, name in ((before, "before"), (after, "after")):
        registry = side["registry"]
        if set(registry) != {"format", "apps", "followed"} or registry["format"] != 1:
            wrong.append(f"{name}: distro-apps.json is not `format` 1 with `apps` and `followed`")
        for app in registry["apps"]:
            if set(app) != keys:
                wrong.append(f"{name}: {app.get('id')} has the fields {sorted(app)}")
    # `on-this-machine` is whether the machine CARRIES it, `declined-here`
    # whether the person declined it: two facts, as `reports::DistroApp`
    # froze them. Chrome is the sharp case — its decline turns its own group
    # switch off — and so is the minimal profile, which carries neither
    # Chrome nor VLC.
    expect = {
        "after": {
            "vlc": (True, True),
            "chrome": (True, True),
            "check-renamed": (True, True),
            "check-absent": (True, False),
            "zsh": (True, True),
            "emacs": (False, True),
            "ghostty": (False, True),
        },
        "before": {"chrome": (False, True), "check-absent": (False, False)},
        "minimal": {"chrome": (True, False), "vlc": (True, False), "check-absent": (True, False), "zsh": (True, True)},
    }
    registries = {"after": after["registry"], "before": before["registry"], "minimal": facts["minimal"]}
    for name, apps in expect.items():
        said = {app["id"]: app for app in registries[name]["apps"]}
        for app, (declined_here, on) in apps.items():
            got = said.get(app)
            if got is None or (got["declined-here"], got["on-this-machine"]) != (declined_here, on):
                wrong.append(f"{name}: distro-apps.json says {got} for `{app}`")
    carried = lambda r: {a["id"]: a["on-this-machine"] for a in r["apps"]}
    if carried(before["registry"]) != carried(after["registry"]):
        wrong.append("a decline changed what `on-this-machine` says the machine carries")
    # A DECLINED PROGRAM KEEPS ITS NAME in the registry's file: its launcher
    # entry left with it, and the software centre names it from here
    # (`name`), or by its id where the registry gives none.
    names = {a["id"]: a.get("name", "absent") for a in after["registry"]["apps"]}
    for app, name in (("vlc", "VLC"), ("android-sdk", "Android SDK"), ("flutter", "Flutter"),
                      ("orca-slicer", "OrcaSlicer"), ("htop", None), ("zsh", None)):
        if names.get(app, "absent") != name:
            wrong.append(f"distro-apps.json names `{app}` {names.get(app, 'absent')!r}, not {name!r}")

    # AND A DECLINED ORCASLICER NAMES NO LAUNCHER ENTRY: reading the name is
    # import-from-derivation, which a machine without it must never pay.
    orca = lambda r: next(a["desktop-ids"] for a in r["apps"] if a["id"] == "orca-slicer")
    if len(orca(before["registry"])) != 1 or orca(after["registry"]) != []:
        wrong.append(f"OrcaSlicer's launcher entry is read where it is not installed: {orca(after['registry'])}")

    if wrong:
        print("ERROR: a decline does not do what the registry promises:", file=sys.stderr)
        for w in wrong:
            print("  " + w, file=sys.stderr)
        sys.exit(1)
    print(f"OK: {len(declined)} declined programs left the machine and its variables, zsh stayed and "
          "said why, another machine's decline and an unknown id did nothing, the switches followed")
    END
  '';

  # AN ESSENTIAL PROGRAM SAYS WHY, in every language.
  #
  # The reasons are a closed set (`assets/distro-apps.nix`, the option's
  # enum), each the id of a sentence the software view draws when it refuses
  # a decline. A reason without its sentence would be a refusal with nothing
  # to say; a sentence without a reason, a key nobody reads; a reason no
  # program gives, a set that stopped saying what the registry does.
  distroAppsEssential = pkgs.writeText "distro-apps-essential.json" (
    builtins.toJSON {
      reasons = distroAppsTable.essential;
      registries =
        map
          (
            n:
            builtins.fromJSON
              self.nixosConfigurations.${n}.config.environment.etc."ronoctua/distro-apps.json".text
          )
          [
            "noctua"
            "minimal"
          ];
    }
  );
  essential-apps-say-why = mkCheck "essential-apps-say-why" [ pkgs.python3 ] ''
    python3 - <<'END'
    import json, pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # PARSED: the reasons and the two profiles' registries, JSON.
    facts = json.load(open("${distroAppsEssential}"))
    reasons = facts["reasons"]
    floor(len(reasons), 1, "essential reasons declared")
    wrong = []
    owed = {f"software-essential-why-{r}" for r in reasons}
    for language in ${builtins.toJSON languages}:
        # FILE-WIDE: a key is a module-level line of the merged `.ftl`, and
        # the question is about every key with this prefix in it.
        text = hashless((pathlib.Path("${texts}") / f"{language}.ftl").read_text())
        have = set(re.findall(r"^(software-essential-why-[a-z0-9-]+)\s*=\s*\S", text, re.M))
        for key in sorted(owed - have):
            wrong.append(f"{language} has no sentence for `{key}`")
        for key in sorted(have - owed):
            wrong.append(f"{language} has `{key}`, and no essential reason is called that")

    used = set()
    essentials = 0
    for registry in facts["registries"]:
        for app in registry["apps"]:
            reason = app["essential"]
            if reason is None:
                continue
            essentials += 1
            used.add(reason)
            if reason not in reasons:
                wrong.append(f"`{app['id']}` is essential for `{reason}`, which is not a reason")
    floor(essentials, 1, "essential programs in the two profiles")
    for reason in sorted(set(reasons) - used):
        wrong.append(f"no program of either profile is essential for `{reason}`")

    if wrong:
        print("ERROR: an essential program cannot say why:", file=sys.stderr)
        for w in wrong:
            print("  " + w, file=sys.stderr)
        sys.exit(1)
    print(f"OK: {len(reasons)} reasons, each with its sentence in every language and given by a program")
    END
  '';

  # A PROGRAM'S ID OUTLIVES ITS NAME.
  #
  # A person's decline names a registry id, and travels in their repository
  # to machines that update months apart. An id that vanished — renamed
  # without `formerly`, dropped without `retired` — would turn their "keep
  # this off" into an unknown id and the program would come back. So the
  # ledger in `assets/distro-apps.nix` holds every id ever published, and an
  # id leaves it only into an entry's `formerly` or into `retired`. And the
  # rename itself is asked of a machine: the fixture of
  # `declining-an-app-removes-it` declines `check-before`, which only the
  # renamed `check-renamed` remembers.
  distroAppsIds = pkgs.writeText "distro-app-ids.json" (
    builtins.toJSON (
      let
        appsOf = n: self.nixosConfigurations.${n}.config.ronoctua.apps;
        systems = [
          "noctua"
          "minimal"
          "vm"
        ];
      in
      {
        ledger = distroAppsTable.ids;
        retired = builtins.attrNames distroAppsTable.retired;
        current = lib.unique (lib.concatMap (n: builtins.attrNames (appsOf n)) systems);
        formerly = lib.unique (
          lib.concatMap (n: lib.concatMap (e: e.formerly) (builtins.attrValues (appsOf n))) systems
        );
      }
    )
  );
  distro-app-ids-are-stable = mkCheck "distro-app-ids-are-stable" [ pkgs.python3 ] ''
    python3 - <<'END'
    import json, sys

    # PARSED: the ledger and the three systems' registries, JSON.
    ids = json.load(open("${distroAppsIds}"))
    declines = json.load(open("${distroAppsDeclines}"))
    ledger, current = ids["ledger"], set(ids["current"])
    wrong = []
    if len(current) < 20:
        print(f"ERROR: only {len(current)} programs in the registry; this check stopped reaching them", file=sys.stderr)
        sys.exit(1)
    if ledger != sorted(ledger) or len(set(ledger)) != len(ledger):
        wrong.append("the ledger is not sorted, or names an id twice")
    for app in sorted(current - set(ledger)):
        wrong.append(f"`{app}` is in the registry and not in the ledger — add it the day it is published")
    gone = set(ledger) - current - set(ids["formerly"]) - set(ids["retired"])
    for app in sorted(gone):
        wrong.append(f"`{app}` left the registry without `formerly` or `retired`: a decline of it would be lost")
    for app in sorted(set(ids["retired"]) & current):
        wrong.append(f"`{app}` is retired and still in the registry")
    for app in sorted(set(ids["retired"]) - set(ledger)):
        wrong.append(f"`{app}` is retired and was never in the ledger")

    # THE RENAME, ON A MACHINE.
    after = declines["after"]
    if after["programs"]["check-renamed"] in after["installed"]:
        wrong.append("a decline of `check-before` did not reach `check-renamed`, which was once called that")
    if "check-before" not in after["report"]["honoured"]:
        wrong.append("the report does not count the decline of `check-before` as honoured")

    if wrong:
        print("ERROR: a program's id would not outlive its name:", file=sys.stderr)
        for w in wrong:
            print("  " + w, file=sys.stderr)
        sys.exit(1)
    print(f"OK: {len(ledger)} ids in the ledger, every one still answering, and a rename keeps its decline")
    END
  '';

  # WHAT THE INSTALLER OFFERS TO LEAVE OUT IS THE REGISTRY'S TO TAKE.
  #
  # The installer lists the ledger's `offered` (`nix/offered.nix`) on a `full`
  # installation only, and an unmarked program becomes the person's decline
  # for that hostname. Each half of that rests on the evaluated systems, never
  # on the modules' text: every offered id is a program of `noctua`'s
  # registry that may be declined (no essential reason, not the base the
  # system is made of), carried by `full` and NOT ON `minimal` — not its
  # `when` alone: none of its packages (`package` and every one of
  # `extraPackages`) is in `minimal`'s system packages or session variables,
  # since a switch that does not switch would let one in by another way — so
  # skipping the screen on `minimal` loses nothing; and the decline the
  # installer writes takes it off: declined for this host, it is not
  # installed and none of its packages is in the system's packages nor in the
  # session's variables; declined for another host, every one is still there
  # (which is also what shows the probe finds them at all).
  offeredRegistry =
    let
      discard = builtins.unsafeDiscardStringContext;
      base = self.nixosConfigurations.noctua;
      host = base.config.networking.hostName;
      offered = map (r: r.id) distroAppsTable.offered;
      declinedOn =
        machines:
        builtins.toFile "offered-declined.json" (
          builtins.toJSON {
            format = 1;
            apps = map (id: {
              inherit id machines;
              edited-at = "2026-10-20T12:00:00Z";
              edited-on = host;
            }) offered;
          }
        );
      # FORCED: the machine's own flake may name a declined file of its own.
      declining =
        machines:
        base.extendModules {
          modules = [ { ronoctua.person.declined = lib.mkForce (declinedOn machines); } ];
        };
      # WHAT SAYS THE PROGRAM IS THERE: a nixpkgs entry's package and each
      # of its companions, by their store paths; an AppImage's wrapper, by
      # the name the registry gives it (`ronoctua-appimage-<key>-<version>`).
      # Any other source is said. Asked of the FULL machine's registry, where
      # each program evaluates — and then looked for on every machine.
      markOf =
        e:
        if e.package != null then
          {
            by = "path";
            marks = map (p: discard p.outPath) ([ e.package ] ++ e.extraPackages);
          }
        else if e.appimage != null then
          {
            by = "name";
            marks = [ "ronoctua-appimage-${e.appimage.key}-" ];
          }
        else
          {
            by = "unknown";
            marks = [ ];
          };
      # The registry's word on each offered id.
      entriesOf =
        c:
        lib.genAttrs offered (
          id:
          if c.ronoctua.apps ? ${id} then
            {
              known = true;
              inherit (c.ronoctua.apps.${id}) essential group when;
              installed = c.ronoctua.distroApps.installed.${id};
            }
          else
            { known = false; }
        );
      # WHAT A MACHINE HOLDS: its system packages, by path and by name, and
      # what its session's variables name.
      holdsOf = c: {
        paths = map (p: discard (p.outPath or "")) c.environment.systemPackages;
        names = map (p: p.name or "") c.environment.systemPackages;
        carried = lib.mapAttrsToList (_: v: discard (toString v)) c.environment.sessionVariables;
      };
      factsOf =
        system:
        holdsOf system.config
        // {
          apps = entriesOf system.config;
        };
      # THE MARKS, from the full machine's registry only: a program `minimal`
      # does not carry may be one its nixpkgs refuses to evaluate (an unfree
      # one it never consented to), so its packages are named where they
      # evaluate and looked for in what `minimal` holds.
      fullConfig = base.config;
      marks = lib.genAttrs offered (
        id: if fullConfig.ronoctua.apps ? ${id} then markOf fullConfig.ronoctua.apps.${id} else null
      );
    in
    pkgs.writeText "offered-registry.json" (
      builtins.toJSON {
        inherit host offered marks;
        full = factsOf base;
        minimal = factsOf self.nixosConfigurations.minimal;
        here = factsOf (declining [ host ]);
        elsewhere = factsOf (declining [ "elsewhere" ]);
      }
    );

  offered-programs-are-the-registrys =
    mkCheck "offered-programs-are-the-registrys" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import json, sys

        # PARSED: the ledger's offered ids and four evaluated machines, JSON.
        f = json.load(open("${offeredRegistry}"))
        wrong = []
        if not f["offered"]:
            print("ERROR: the ledger offers nothing; this check stopped reaching it", file=sys.stderr)
            sys.exit(1)

        def found(side, app):
            # Each of the program's packages the machine holds, by its mark.
            m = f["marks"][app]
            if m["by"] == "path":
                return [p for p in m["marks"] if p in f[side]["paths"]]
            return [k for k in m["marks"] if any(n.startswith(k) for n in f[side]["names"])]

        def carried(side, app):
            return [v for v in f[side]["carried"] for k in f["marks"][app]["marks"] if k in v]

        for app in f["offered"]:
            full, minimal = f["full"]["apps"][app], f["minimal"]["apps"][app]
            if not full["known"]:
                wrong.append(f"`{app}` is offered and is no program of the full machine's registry")
                continue
            if full["essential"] is not None:
                wrong.append(f"`{app}` is offered and essential ({full['essential']}): its decline would be refused")
            if full["group"] == "base":
                wrong.append(f"`{app}` is offered and of the base group: `minimal` would carry it and never be asked")
            if not full["when"]:
                wrong.append(f"`{app}` is offered and the full installation does not carry it")
            if minimal.get("known") and minimal["when"]:
                wrong.append(f"`{app}` is carried by `minimal`, which is never asked the list: it could not be left out there")
            m = f["marks"][app]
            if m["by"] == "unknown":
                wrong.append(f"`{app}` comes from a source this check cannot see leave the machine")
                continue
            # NOTHING OF IT ON `minimal`, whatever its switch says.
            for p in found("minimal", app):
                wrong.append(f"`{app}` is on `minimal` all the same, by another way in: {p}")
            for value in carried("minimal", app):
                wrong.append(f"`{app}` is named by a session variable of `minimal`: {value}")
            # DECLINED ELSEWHERE: still here, every package of it — and found,
            # so the absence below is the decline's and not the probe's.
            if not f["elsewhere"]["apps"][app]["installed"]:
                wrong.append(f"`{app}` declined for another machine is not installed on this one")
            for k in m["marks"]:
                if k not in found("elsewhere", app):
                    wrong.append(f"`{app}` declined for another machine is missing {k} (or the probe cannot find it)")
            # DECLINED HERE: gone, every package of it, from the packages and
            # the variables.
            if f["here"]["apps"][app]["installed"]:
                wrong.append(f"`{app}` declined for this machine is still installed")
            for p in found("here", app):
                wrong.append(f"`{app}` declined for this machine is still in `environment.systemPackages`: {p}")
            for value in carried("here", app):
                wrong.append(f"`{app}` declined for this machine is still named by a session variable: {value}")

        if wrong:
            print("ERROR: what the installer offers to leave out is not what the registry takes off:", file=sys.stderr)
            for w in wrong:
                print("  " + w, file=sys.stderr)
            sys.exit(1)
        held = sum(len(f["marks"][a]["marks"]) for a in f["offered"] if f["marks"][a])
        print(f"OK: {len(f['offered'])} offered programs ({held} packages), each carried by full and "
              f"nothing of it on minimal, gone when declined for {f['host']} and kept when declined elsewhere")
        END
      '';

  # EVERY ROW THE INSTALLER COULD NOT MEAN IS REFUSED, EACH IN ITS OWN WORDS.
  #
  # `nix/offered.nix` refuses the build over a malformed `offered` in the
  # ledger, and the tree's ledger is well formed: nothing ever reached a
  # refusal, and a guard that never refused is not tested. Here each defect
  # is planted in a ledger of its own — an empty list, no list, `ids` that is
  # no list, an unknown id, an id that is no slug (text, a set, a list), the
  # same id twice, `none`, a `checked` that is not a boolean, a field no row
  # takes, a row that is not one, no name, a name that is not text, empty,
  # spans lines (a line feed, U+0085, U+2028), holds a control character (a
  # tab, DEL), is white space alone (U+00A0) or has white space at an edge (a
  # space, U+00A0), and two rows of one name — and the refusals are asked of
  # all of them in ONE evaluation (`problemsOf`). Each defect is refused by a
  # sentence of its own kind and no other, naming the row; nothing aborts the
  # evaluation; two ledgers the screen can draw — one naming a row by the
  # `apps` table — are refused by none. And the GUARD: a malformed ledger
  # handed to `nix/offered.nix` as the build hands one fails to evaluate, and
  # a good one does not.
  offeredRefusals =
    let
      inherit
        (pkgs.callPackage ../nix/offered.nix {
          ledgerFile = ../assets/distro-apps.nix;
        })
        problemsOf
        ;
      first = {
        id = "alpha";
        checked = true;
        name = "Alpha";
      };
      second = {
        id = "beta";
        checked = false;
        name = "Beta";
      };
      base = {
        ids = [
          "alpha"
          "beta"
          "gamma"
        ];
        apps.gamma.name = "Gamma Table";
        offered = [
          first
          second
        ];
      };
      # The base with its second row changed, or its rows replaced.
      planted =
        change:
        base
        // {
          offered = [
            first
            (second // change)
          ];
        };
      rows = offered: base // { inherit offered; };
      char = hex: builtins.fromJSON ''"\u${hex}"'';
      ledgers = {
        good = base;
        named-by-the-table = rows [
          first
          second
          {
            id = "gamma";
            checked = true;
          }
        ];
        empty = rows [ ];
        not-a-list = rows "alpha";
        ids-not-a-list = base // {
          ids = null;
        };
        unknown-id = planted { id = "delta"; };
        not-a-slug = planted { id = "be,ta"; };
        id-a-set = planted { id = { }; };
        id-a-list-and-no-name = rows [
          first
          {
            id = [ "x" ];
            checked = true;
          }
        ];
        duplicate-id = planted { id = "alpha"; };
        none = planted { id = "none"; };
        checked-not-bool = planted { checked = "yes"; };
        unknown-field = planted { icon = "beta.svg"; };
        not-a-row = rows [
          first
          "beta"
        ];
        missing-name = rows [
          first
          (builtins.removeAttrs second [ "name" ])
        ];
        name-not-text = planted { name = 3; };
        empty-name = planted { name = ""; };
        name-spans-lines = planted { name = "Be\nta"; };
        name-next-line = planted { name = "Beta" + char "0085"; };
        name-line-separator = planted { name = "Be" + char "2028" + "ta"; };
        name-holds-a-tab = planted { name = "Be\tta"; };
        name-holds-a-delete = planted { name = "Be" + char "007f" + "ta"; };
        name-white-alone = planted { name = char "00a0"; };
        name-edge-space = planted { name = "Beta "; };
        name-edge-nbsp = planted { name = "Beta" + char "00a0"; };
        duplicate-name = planted { name = "Alpha"; };
      };
      # THE GUARD, as the build meets it: the ledger is a FILE `import`ed by
      # `nix/offered.nix`, and a refused one has no derivation.
      evaluates =
        ledger:
        (builtins.tryEval
          (pkgs.callPackage ../nix/offered.nix {
            ledgerFile = builtins.toFile "ledger.nix" ledger;
          }).drvPath
        ).success;
    in
    pkgs.writeText "offered-refusals.json" (
      builtins.toJSON {
        said = lib.mapAttrs (_: problemsOf) ledgers;
        guard = {
          # The same id twice: refused, and still a table that would render
          # — so it is the guard, and nothing after it, that stops it.
          bad = evaluates ''{ ids = [ "alpha" ]; offered = [ { id = "alpha"; checked = true; name = "Alpha"; } { id = "alpha"; checked = false; name = "Again"; } ]; }'';
          good = evaluates ''{ ids = [ "alpha" ]; offered = [ { id = "alpha"; checked = true; name = "Alpha"; } ]; }'';
        };
      }
    );
  offered-refuses-each-malformed-row =
    mkCheck "offered-refuses-each-malformed-row" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import json, sys

        # PARSED: each planted ledger's refusals, as `nix/offered.nix` says
        # them, and whether a ledger evaluates through it, JSON.
        doc = json.load(open("${offeredRefusals}"))
