        "surface/mod.rs": {"must": ["get_keyboard_with_repeat", "get_keyboard("], "must_not": []},
        "lifeline.rs": {
            "must": [],
            "must_not": ["list_bar", "PointerEventKind::Axis", "offset"],
        },
    }
