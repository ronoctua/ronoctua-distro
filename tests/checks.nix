    # cursor; an excused one answers `None`.
    named, follows = set(), set()
    arms = re.sub(r"=>\s*\{\s*None\s*\}", "=> None", table)
    for m in re.finditer(r"((?:ViewState::\w+(?:\([a-z_]+::ID\))?\s*\|?\s*)+)(?:if [^=]*)?=>\s*([^,\n]+)", arms):
        delegates = m.group(2).strip() != "None"
        for v in re.findall(r"ViewState::(\w+)(?:\(([a-z_]+)::ID\))?", m.group(1)):
            name = stems.get(v[1], v[1]) if v[0] == "Region" else v[0]
            named.add(name)
            if delegates:
                follows.add(name)
    # A REGION OF THE SLOT HOST follows its cursor through the host's one
    # line (`hosted_cursor`, which asks the region), for every region
    # `regions.rs` registers — by the id its module ranks it under. One the
    # list above excuses (the manuals, a region now) is RE-MEASURED instead:
    # its `cursor` still answers `None`, or the excuse is stale.
    if re.search(r"ViewState::Region\((\w+)\)\s*=>\s*self\.hosted_cursor\(\1\)", arms):
        for module in re.findall(r"(\w+)::ENTRY\b", uncommented(shell_file("regions.rs").read_text())):
            text = uncommented(shell_file(module + ".rs").read_text())
            m = re.search(r'pub const ID: &str = "([a-z-]+)";', text)
            if not m:
                continue
            named.add(m.group(1))
            if m.group(1) in WITHOUT:
                cursor = body_of(without_tests(text), "cursor")
                if cursor is None or cursor.strip(" \n{}") != "None":
                    bad.append(f"the region `{m.group(1)}` is excused from following and its `cursor` answers something; the excuse is stale")
                continue
            follows.add(m.group(1))
    # A REGION OF THE SLOT HOST — ranked, and drawn by no file of the
    # footer's own — follows its cursor through the host's one line, which
    # asks the region where its cursor is drawn.
    hosted_line = re.search(r"ViewState::Region\([a-z_]+\)\s*=>\s*self\.hosted_cursor\(", arms) is not None
    for v in views:
        if v in WITHOUT or v in named:
            continue
        if v[0].islower() and v not in stems.values() and hosted_line:
            continue
        bad.append(
            f"the view `{v}` is not in `list_cursor`, so its page never follows "
            "its cursor — the arrow walks off the bottom of the region"
        )
    for v in sorted(WITHOUT):
        if v in follows:
            bad.append(f"the view `{v}` is excused from following and now does; the excuse is stale")

    # AND THE ONE CALLER THAT MAKES IT HAPPEN. `typed` is the human-key path;
    # if the call leaves it, every view stops following at once and no test of
    # a single view would say so.
    wrapper = must(body_of(src, "typed"), "`Footer::typed`")
    floor(len(wrapper), 100, "characters of `typed`")
    if "follow_cursor()" not in wrapper:
        bad.append(
            "`Footer::typed` no longer follows the cursor: it is the one place "
            "that knows a PERSON moved something, and an arrival must not"
        )
    # AND NOT FROM THE PAINT, which is the arrival's path.
    painting = must(body_of(src, "draw_and_paint"), "`draw_and_paint`")
    if "follow_cursor" in painting:
        bad.append(
            "`draw_and_paint` follows the cursor: a daemon's arrival redraws "
            "too, and that is the forced scroll the owner reported once already"
        )

    for b in bad:
        print(f"ERROR: {b}", file=sys.stderr)
    if bad:
        raise SystemExit(1)
    print(f"OK: {len(views) - len(WITHOUT)} views follow their cursor, from one place")
    END
  '';

  # A SELECTOR THAT BRANCHES ON NUMBERS IS FED A NUMBER, and never a string.
  #
  # Fluent picks a variant by the ARGUMENT'S TYPE: given the string `"1"` it
  # looks for a variant literally named `1`, does not find one, and falls
  # through to the default. The row then reads `1 screens` on the machine every
  # laptop is — or, the day this check was written, every digit of `644` saying
  # `can read, change and run it`, which is `777` in a sentence about
  # permissions.
  #
  # It is a KNOWN trap: `display.rs` records it in a comment ending *"with every
  # check green"*, and the months were fixed for it once. Then the octal's
  # digits walked into it anyway, and the only reason it was caught is that a
  # test PRINTED the three sentences. So the rule stops being folklore: a key
  # whose value has a numeric branch may only be resolved through `t_args`.
  numeric-selectors-get-numbers = mkCheck "numeric-selectors-get-numbers" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys

    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a call site may be anywhere in any crate, and what bounds the
    # search is the 400 characters of the CALL — its own parentheses — rather
    # than a function. The `.ftl` half is a catalogue with no functions at all.
    #
    # `code_of` on the Rust: a `t_with` written out in a comment as an example
    # is not a call, and this check names the file and the key when it fails.
    root = pathlib.Path("${self}")
    bad = []

    # THE KEYS ARE READ FROM THE `.ftl`, both languages: a selector that is
    # numeric in one and not in the other is a key that answers differently by
    # language, which this finds as well.
    numeric = {}
    for language in ${builtins.toJSON languages}:
        text = (pathlib.Path("${texts}") / (language + ".ftl")).read_text()
        key, body = None, []
        def close(key, body):
            if key is None:
                return
            said = "\n".join(body)
            if re.search(r"\[\s*\d+\s*\]", said):
                numeric.setdefault(key, set()).update(re.findall(r"\{\s*\$(\w+)\s*->", said))
        # A MESSAGE'S VALUE CONTINUES ONLY ON INDENTED LINES, which is
        # Fluent's own rule — and the first version of this swept everything up
        # to the next `key =`, comments and all. It reported
        # `locale-date-mdy`, whose value is `{ $m }/{ $d }/{ $y }`, for the
        # numeric branches of the key TWO comment lines below it.
        for line in text.splitlines():
            m = re.match(r"^([a-z][a-z0-9-]*) =", line)
            if m:
                close(key, body)
                key, body = m.group(1), [line]
            elif key is not None and line[:1].isspace():
                body.append(line)
            else:
                close(key, body)
                key, body = None, []
        close(key, body)

    floor(len(numeric), 3, "keys with a numeric branch")

    # THE CONSTANT IS THE KEY IN THE SHAPE THE GENERATOR WRITES IT.
    consts = {k.upper().replace("-", "_"): k for k in numeric}
    swept = 0

    # AND THE CALL SITES. `t_with` and `t_marked` take `&str` arguments and can
    # only ever hand Fluent a string; `t_args` is the one that carries a type.
    for f in sorted(root.glob("crates/**/*.rs")):
        if "target" in f.parts:
            continue
        text = code_of(f.read_text())
        swept += 1
        for m in re.finditer(r"\bt_(with|marked)\s*\(", text):
            # THE CALL'S OWN PARENTHESES, and not four hundred characters cut
            # at the first `);`. Neither bound is the call: rustfmt ends a
            # nested one `),`, so the window ran past it into the NEXT call and
            # blamed `t_args` for what `t_with` was doing — and a `);` inside a
            # string literal cut it short the other way.
            window = shut_at(text, m.end())
            for const, key in consts.items():
                if re.search(rf"\b{const}\b", window):
                    bad.append(
                        f"{f.relative_to(root)}: `{key}` branches on numbers and is "
                        f"resolved through `t_{m.group(1)}`, which can only pass a "
                        "string — every number falls through to the default branch"
                    )

    floor(swept, 100, "sources of the workspace swept for a call site")
    for b in bad:
        print(f"ERROR: {b}", file=sys.stderr)
    if bad:
        raise SystemExit(1)
    print(
        f"OK: {len(numeric)} keys branch on numbers, and every call site hands "
        "them a number"
    )
    END
  '';

  # THE SWEEP ONLY EVER LOOKS AT A LINK, NEVER THROUGH ONE.
  #
  # This is the one thing in the tree that deletes a person's files by the
  # thousand, and the worst thing it could do is follow `~/.cache/x -> /home`.
  # The unit test plants exactly that and watches it survive; this is the other
  # half — the SOURCE rule, so the defect cannot come back through a call that
  # no fixture happens to exercise.
  #
  # `std::fs::metadata` follows links. `canonicalize` and `read_link` resolve
  # them. None of the three has any business here, and `symlink_metadata` is
  # what has to be present: a walk with neither would be one that does not look
  # at all.
  # THE BRAIN CAN BE PHOTOGRAPHED, and for a long time it could not.
  #
  # Its whole screen is the mind the host pushes in, and `render-png` had no
  # way to push one — so every picture of it was a title over the words "no
  # tasks yet", which the tool's own header called "the honest picture of what
  # they have". It was honest and it was useless: the buffer this repository
  # most needed to review was the one it could not open. The owner said so in
  # as many words.
  #
  # `--mind` closes it, and this is what keeps it closed. The fixture is the
  # DAEMON'S OWN JSON — one line off its socket is a valid argument — so it
  # cannot drift into a shape only the tool understands.
  #
  # WHAT IS ASSERTED, and the first two attempts at it were both wrong.
  #
  # "The two languages differ" does not catch an empty screen: without a mind
  # the page says `Nothing is set up yet` in one and `Nada configurado ainda`
  # in the other, which differ perfectly well. Neither does "there is ink" —
  # a header and one sentence is plenty of ink.
  #
  # What separates the two is how MUCH is on the screen, and the tool already
  # prints it: the number of runs in the frame it drew. An empty brain is a
  # header and a sentence; one with a mind is a list, a log, a footer and a
  # paragraph. The floor is set well under what this fixture produces and well
  # over what an empty screen can reach, and the two numbers are far enough
  # apart that nothing has to be tuned.
  #
  # The size and the difference between languages stay, because they are cheap
  # and they close the rest of the chain in one comparison — component,
  # display list, i18n, tokens, wgpu, pixel.
  the-brain-is-photographable = mkCheck "the-brain-is-photographable" [ pkgs.python3 ] ''
    # The palettes and the texts (`rust.keyed`): this binary is the unwrapped
    # one, and the colours and the words are data it reads at run time.
    export RONOCTUA_THEMES=${rust.keyed.RONOCTUA_THEMES}
    export RONOCTUA_TEXTS=${rust.keyed.RONOCTUA_TEXTS}
    export VK_DRIVER_FILES=${xvfb.icd}
    export VK_ICD_FILENAMES=${xvfb.icd}
    export LIBGL_ALWAYS_SOFTWARE=1
    export RONOCTUA_COVERAGE_FONTS=${rust.atRunTime.RONOCTUA_COVERAGE_FONTS}

    # FICTIONAL IDS, and the keys beside them: the shell draws the key a
    # module declared and builds none out of its id, so a fixture that names
    # no real module still draws words and not brackets — and a real module's
    # id written here would be a place outside its folder that names it.
    cat > mind.json <<'JSON'
    {"now":1789800000,
     "pulse":{"at":1789800000,"ram-used-pct":31,"memory-stall":4,"cpu-stall":40,"on-battery":false},
     "tasks":[
       {"id":"fixture-routine","kind":"routine","standing":"idle","enabled":true,
        "interval-days":7,"part-of-day":"afternoon","next":1789886400,"hold":null,"why-not":"",
        "last":{"task":"fixture-routine","began":1789540000,"ended":1789540291,"kind":"done",
                "at":"","why":"","trouble":"","steps":[]},
        "history":[{"task":"fixture-routine","began":1789540000,"ended":1789540291,"kind":"done",
                    "at":"","why":"","trouble":"","steps":[]}],
        "steps":[{"id":"a-root-step","command":"nix flake update","needs-root":true,
                  "on":true,"on-by-default":true,"name-key":"brain-steps","does-key":"about-brain-run"}],
        "calendar":true,"name-key":"brain-title","does-key":"about-brain-run"},
       {"id":"fixture-watch","kind":"watch","standing":"idle","enabled":true,
        "interval-days":7,"part-of-day":"any","next":0,"hold":null,"why-not":"",
        "last":null,"history":[],"steps":[],
        "calendar":false,"name-key":"brain-log","does-key":"about-brain-log","screen-generation":1,
        "actions":[{"id":"act","label":"cmd-brain-act","row":false,"asks":null}]}],
     "queue":[],"running":"","announcement":null,"rehearsing":null,"postponed":null,
     "journal":[{"task":"fixture-routine","began":1789500000,"ended":1789500000,"kind":"held",
                 "at":"","why":"ram","trouble":"","steps":[]},
                {"task":"fixture-routine","began":1789600000,"ended":1789600000,"kind":"held",
                 "at":"","why":"ram","trouble":"","steps":[]},
                {"task":"fixture-routine","began":1789700000,"ended":1789700000,"kind":"held",
                 "at":"","why":"ram","trouble":"","steps":[]}],
     "prefs":{"gate":{"ram-ceiling-pct":70,"cpu-stall-per-mille":200,"abort-on-battery":true},
              "tasks":{}},
     "notices":[{"module":"fixture-watch","what":{"id":"said","says":"about-brain-log","args":[],
                 "level":"warn","since":1789790000,"controls":["act"],"dismiss":true,"snooze":[10]}}]}
    JSON
    # AND THE WATCH'S OWN PAGE, one answer of the socket to `Ask::Screen`.
    cat > screen.json <<'JSON'
    {"say":"screen","module":"fixture-watch","generation":1,"screen":{"sections":[
      {"heading":"brain-history","rows":[
        {"id":"a","label":{"key":"brain-last-run"},"value":{"moment":1789790000},
         "note":{"data":"what the module wrote"},"tone":"watching","act":"act"},
        {"id":"b","label":{"key":"brain-next"},"value":{"bytes":412000000},
         "note":"empty","tone":"danger","act":null}]},
      {"heading":"brain-steps","rows":[
        {"id":"c","label":{"key":"brain-enabled"},"value":{"count":3},
         "note":{"data":"and a note under it"},"tone":"quiet","act":null}]}]}}
    JSON

    : > runs.txt
    for language in ${lib.concatStringsSep " " languages}; do
      ${rust.bins.ronoctua-render-png}/bin/ronoctua-render-png \
        ${buffers.brain}/lib/ronoctua_buffer_brain.wasm \
        --mind mind.json --columns 100 --lines 30 --language "$language" \
        --out "$PWD/$language.png" | tee -a runs.txt
      # AND THE PAGE BEHIND ONE, which is the half a mind is needed for twice:
      # without a task there is nothing to open. THE PAGE OPENS ON ITS
      # NOTICES when it has any, so `Tab` takes the keyboard to the tasks.
      ${rust.bins.ronoctua-render-png}/bin/ronoctua-render-png \
        ${buffers.brain}/lib/ronoctua_buffer_brain.wasm \
        --mind mind.json --columns 100 --lines 30 --language "$language" \
        --key tab --key enter --out "$PWD/$language-task.png" | tee -a runs.txt
      # AND A MODULE'S OWN PAGE, which only the host pushes, and only while
      # its task's page is open: the watch's, a calendar it does not keep.
      ${rust.bins.ronoctua-render-png}/bin/ronoctua-render-png \
        ${buffers.brain}/lib/ronoctua_buffer_brain.wasm \
        --mind mind.json --columns 100 --lines 30 --language "$language" \
        --key tab --key down --key enter --screen screen.json \
        --out "$PWD/$language-module.png" | tee -a runs.txt
      # AND THE POINTER AT REST, which is the third thing a photograph could
      # not reach. The wall carries a hover now, and a screen this tool cannot
      # drive is a screen nobody reviews — the hole is in the photographer,
      # never in the buffer.
      ${rust.bins.ronoctua-render-png}/bin/ronoctua-render-png \
        ${buffers.brain}/lib/ronoctua_buffer_brain.wasm \
        --mind mind.json --columns 100 --lines 30 --language "$language" \
        --hover 30,5 --out "$PWD/$language-hover.png" | tee -a runs.txt
    done

    # THE HOVER LIGHTS A ROW — the second task's, under the notices and the
    # list's own title — and a row the CURSOR is not on: the two are
    # different questions and wear different grounds. Asked of the display
    # list, because a tone this close is not a thing to assert from pixels.
    ${rust.bins.ronoctua-render-png}/bin/ronoctua-render-png \
      ${buffers.brain}/lib/ronoctua_buffer_brain.wasm \
      --mind mind.json --columns 100 --lines 30 --language en-GB \
      --hover 30,5 --list > hovered.txt
    # BY THE TWO THINGS THAT MATTER, and not by the whole `Debug` spelling:
    # the row and the ground it wears. Written out in full it broke the day the
    # band gained a column and a width — a change this check has no opinion
    # about, and a check that argues with every edit argues with none of them.
    # A CURSOR'S OWN HOVER: a buffer paints every hand in its colour, and
    # it is the HOST that turns one lone cursor back into the neutral hover —
    # this list is what the buffer drew, before the host.
    grep -E 'Selection \{ line: 5,.*cursor-hover-one' hovered.txt > /dev/null \
      || { echo "ERROR: the pointer rested on a row and nothing lit under it." >&2; exit 1; }
    grep -q 'surface-selection' hovered.txt \
      || { echo "ERROR: the cursor's own band went away with the hover." >&2; exit 1; }

    python3 - <<'END'
    import pathlib, struct, sys, zlib
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: what is read here is a log this check itself produced and a
    # set of PNGs, neither of which has a function in it.
    # PARSED: the pictures are decoded — the IDAT chunks are inflated and the
    # bytes compared — and the log is split on a fixed word. Neither is
    # searched for a name, so there is no prose for a comment to hide in and
    # nothing for a stripper to take off.

    def pixels(name):
        raw = pathlib.Path(name).read_bytes()
        if raw[:8] != b"\x89PNG\r\n\x1a\n":
            sys.exit("ERROR: " + name + " is not a PNG")
        wide, tall = struct.unpack(">II", raw[16:24])
        # The IDAT, decompressed and un-filtered enough to count colours: every
        # row is one filter byte and then RGBA.
        data = b"".join(
            raw[i + 8 : i + 8 + struct.unpack(">I", raw[i : i + 4])[0]]
            for i in range(8, len(raw))
            if raw[i + 4 : i + 8] == b"IDAT"
            for _ in [0]
        )
        return wide, tall, zlib.decompress(data)

    # HOW MANY RUNS THE FRAME HAD. An empty brain draws about sixteen — the
    # header's ladder and one sentence. This fixture draws over forty.
    FLOOR = 30

    seen = {}
    for language in "${lib.concatStringsSep " " languages}".split():
        for what in (language, language + "-task", language + "-module"):
            wide, tall, body = pixels(what + ".png")
            if (wide, tall) == (0, 0):
                sys.exit("ERROR: " + what + " has no size")
            seen[what] = body

    floor(len(seen), 6, "pictures taken of the brain")
    drew = 0
    for line in pathlib.Path("runs.txt").read_text().splitlines():
        if " runs," not in line:
            continue
        drew += 1
        drawn = int(line.split(" runs,")[0].split()[-1])
        if drawn < FLOOR:
            sys.exit(
                "ERROR: a page drew only " + str(drawn) + " runs (" + line.strip() + "). "
                "The brain drew its empty screen, which is what `--mind` exists to stop."
            )
    floor(drew, 8, "pages whose run count was read back")

    for what in ("", "-task", "-module"):
        bodies = {l: seen[l + what] for l in "${lib.concatStringsSep " " languages}".split()}
        if len(set(map(bytes, bodies.values()))) != len(bodies):
            sys.exit(
                "ERROR: the brain's" + (what or " home") + " page is the same in every language — "
                "which is what an empty screen looks like"
            )

    print("OK: the brain's pages and a module's own draw, in every language, from the daemon's own socket")
    END
  '';

  # EVERY KEY THE BRAIN BINDS IS A KEY ITS SCREEN TEACHES.
  #
  # THE DEFECT THIS CATCHES is one the owner reported twice, in those words:
  # they asked for a way to run a task by hand and to switch one off, and both
  # times the answer was that the keys existed — `m r` and `m o` — and neither
  # appeared anywhere on the page. A key that is not on the screen is a key
  # nobody has.
  #
  # It went unnoticed because the page taught from a hand-written list, so the
  # list and the keymap were two truths. The buffer's own test asserts they
  # agree; this asserts the SHAPE that makes agreeing possible — the header is
  # built from tables of pairs and not from runs written out one by one, so a
  # key added to the keymap and not to a table is a test failure rather than a
  # silence.
  the-brain-header-is-generated = mkCheck "the-brain-header-is-generated" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: `KEYMAP` and the five `*_TEACHES` tables are module-level.
    # `rungs` is narrowed by name below.
    #
    # `uncommented` and never `code_of`: a KEY and a command id are string
    # literals, and emptying them would leave two empty sets that agree.
    src = uncommented((pathlib.Path("${self}") / "buffers" / "brain" / "src" / "lib.rs").read_text())
    floor(len(src), 10000, "characters of the brain buffer's lib.rs")

    bound = set(re.findall(r'\("([^"]+)", "brain-[^"]+"\),', src))
    floor(len(bound), 5, "keys the brain binds")

    # WHAT THE PAGES TEACH, out of the same shape.
    taught = set()
    # AND `ALSO_TEACHES`, the row's second action, taught on a module's page
    # while the row under the cursor offers one.
    for table in ("HOME_TEACHES", "TASK_TEACHES", "ANSWER_TEACHES", "NOTICE_TEACHES", "ALSO_TEACHES"):
        block = re.search(table + r": &\[Teach\] = &\[(.*?)\];", src, re.S)
        if not block:
            sys.exit("ERROR: `" + table + "` went away; the header is built from it")
        taught |= set(re.findall(r'\("([^"]+)",', block.group(1)))
    floor(len(taught), 5, "keys the pages teach")

    missing = sorted(k for k in bound if k not in taught)
    if missing:
        sys.exit(
            "ERROR: the brain binds keys no page teaches: " + ", ".join(missing)
            + ". A key that is not on the screen is a key nobody has."
        )

    # AND THE HEADER IS DRAWN FROM THE TABLES. A `put` of a literal notation in
    # the header's own builder is the hand-written list coming back.
    head = must(body_of(src, "header"), "`State::header`")
    floor(len(head), 400, "characters of the header's builder")
    for literal in re.findall(r'Run::datum\("([^"]+)"\)', head):
        sys.exit("ERROR: the header draws the literal `" + literal + "` instead of a table's pair")

    # AND IT IS LAID OUT ONCE. The height, the ink and the POINTER all read
    # `ladder`; three walks of the same table is how a rung comes to answer
    # for its neighbour — the same class of defect the scrollbar had, where
    # what paints and what catches were two arithmetics.
    ladder = must(body_of(src, "ladder"), "`State::ladder`")
    floor(len(ladder), 400, "characters of `ladder`")
    for who, why in (
        ("header", "the header paints a ladder it laid out itself"),
        ("header_rows", "the height counts a ladder of its own"),
        ("clicked", "a click on a shortcut is resolved by a second walk"),
    ):
        body = must(body_of(src, who), "`State::" + who + "`")
        if "ladder()" not in body:
            sys.exit("ERROR: " + why + " — one walk, read three times")

    print("OK: every key the brain binds is taught, and the header is one walk read three times")
    END
  '';

  # THE BRAIN READS WHERE THE UNITS WRITE, and it did not.
  #
  # `ronoctua_brain_daemon::runner::reports_dir` said `/run/ronoctua-brain` and
  # NOTHING ON THE MACHINE EVER WROTE THERE: the person's units write into
  # `%t`, which for them is `$XDG_RUNTIME_DIR`, and the update's script kept a
  # TSV in a third place. `Report::watch` polls one path's mtime, so a path
  # that never appears never changes — every run the brain started sat there
  # until its patience ran out and came back `runaway`. Two hours, on a rebuild
  # that had worked.
  #
  # Nothing could have caught it. Every test points `Runner::reporting_in` at a
  # scratch directory, which is right — a test that wrote into the real one
  # would be a test that talks to the machine — and that is exactly why none of
  # them named it.
  #
  # So this reads the places the name is spelled and refuses a disagreement:
  # the daemon's constant, and the units EVERY brain module declares — read
  # out of the manifests (`brainModules`) and as the machine gets them, the
  # evaluated configuration of the VM, not a file. A module with a `run` or a
  # `rehearse` unit is covered by being declared: no id is written here, and a
  # new module with units is checked the day its folder appears.
  #
  # (It read `nix/modules/cache.nix` by path, for the sweep's and the trash's
  # units, until those moved into their modules' folders; what is left of a
  # module's units that only that module knows — which directory it walks,
  # which one run acts — is that module's own check.)
  the-brain-reads-what-the-units-write =
    let
      vm = self.nixosConfigurations.vm.config;
      # READ AS WORDS, WITHOUT THEIR STORE PATHS: a command line names a
      # binary of the workspace, and a file quoting it would make this check
      # build the workspace to compare two strings.
      words =
        v:
        builtins.unsafeDiscardStringContext (
          if builtins.isList v then lib.concatStringsSep " " (map toString v) else toString v
        );
      unitFacts =
        unit:
        let
          n = lib.removeSuffix ".service" unit.name;
          found = vm.systemd.user.services.${n} or vm.systemd.services.${n} or null;
          s = if found == null then { } else found.serviceConfig;
        in
        {
          inherit (unit) name;
          present = found != null;
          execStart = words (s.ExecStart or "");
          runtimeDirectory = words (s.RuntimeDirectory or "");
          readWritePaths = map words (lib.toList (s.ReadWritePaths or [ ]));
        };
      reporting = map (m: {
        inherit (m) id;
        units = lib.mapAttrs (_: unitFacts) (
          lib.filterAttrs (which: _: which == "run" || which == "rehearse") m.units
        );
      }) (builtins.filter (m: m.units ? run || m.units ? rehearse) brainModules.every);
      facts = pkgs.writeText "brain-reporting-units.json" (builtins.toJSON reporting);
    in
    mkCheck "the-brain-reads-what-the-units-write" [ pkgs.python3 ] ''
      python3 - <<'END'
      import json, pathlib, re, sys
      exec(open("${pyPrelude}").read())

      root = pathlib.Path("${self}")
      # PARSED: every module's units arrive as the evaluated configuration,
      # JSON, beside the ids their manifests declare.
      # THE CODE AND NOT THE PROSE. The comment beside `reports_dir` names the
      # old path on purpose — it is the whole story of the defect — and a check
      # that read it would refuse the explanation of what it is checking for.
      # FILE-WIDE: a constant and a function's body in the runner, a
      # generator's variable, and — for a module whose unit does not name its
      # report — any file of that module's own folder.
      #
      # The local `code` dropped a line that BEGAN with a comment marker.
      # `uncommented` and `hashless` are the prelude's, one per language, and
      # they take a comment off the end of a line too; `uncommented` also
      # knows that a `//` inside a string is not a comment, which matters
      # here because every needle below is a PATH.

      runner = uncommented((root / "crates" / "ronoctua-brain-daemon" / "src" / "runner.rs").read_text())
      floor(len(runner), 1000, "characters of runner.rs")
      wrong = []

      said = re.search(r'pub const REPORTS_LEAF: &str = "([^"]+)";', runner)
      if not said:
          sys.exit("ERROR: `REPORTS_LEAF` went away; it is the name the units have to agree with")
      leaf = said.group(1)

      # THE DAEMON LOOKS IN THE RUNTIME DIRECTORY, and the unit's `%t` is that
      # directory. A daemon that resolved an absolute path of its own would be
      # back where this started.
      if "XDG_RUNTIME_DIR" not in runner:
          sys.exit("ERROR: the brain no longer resolves its reports under the runtime directory")
      for absolute in ("/run/ronoctua-brain", "/var/run/ronoctua-brain"):
          if absolute in runner:
              sys.exit(
                  "ERROR: the brain looks in " + absolute + ", which no unit of the person's can write"
              )

      # A REHEARSAL IS WATCHED IN ITS OWN FILE, beside the real one — a unit
      # that wrote the plain name would have its rehearsal watched against
      # the last true run's file.
      built = must(body_of(runner, "report_in"), "the runner's `report_in`")
      for shape in ('"{task}.json"', '"{task}-rehearsal.json"'):
          if shape not in built:
              wrong.append("the runner no longer names a report " + shape)

      # AND EVERY MODULE'S UNITS WRITE THERE, each under its own id: the run
      # `<id>.json`, the rehearsal `<id>-rehearsal.json`.
      modules = json.load(open("${facts}"))
      floor(len(modules), 1, "brain modules whose manifests declare a run or a rehearsal")
      folders = pathlib.Path("${../crates/ronoctua-brain/modules}")
      # A REPORT IS OWED ONLY TO A MODULE THAT WAITS FOR ONE. A run that
      # watches its unit end (`Run::watch`, in the module's code and not its
      # tests) reads the report; a run that only STARTS a unit which lives for
      # the session (the search index: `systemctl start` and done, its state
      # read from the index's own `status.json`) waits for nothing, and a
      # report its unit wrote would be read by nobody.
      def waits(i):
          return any(
              re.search(r"\.watch\(", code_of(without_tests(f.read_text(errors="replace"))))
              for f in sorted((folders / i).rglob("*.rs")) if f.is_file()
          )
      waiting = 0
      for m in modules:
          i = m["id"]
          watched = waits(i)
          waiting += watched
          for which, u in sorted(m["units"].items()):
              report = i + (".json" if which == "run" else "-rehearsal.json")
              if not u["present"]:
                  wrong.append(f"{i}: its manifest names {u['name']}, and the machine has no such unit")
                  continue
              named = f"%t/{leaf}/"
              if watched and named in u["execStart"]:
                  if f"{named}{report}" not in u["execStart"].split():
                      wrong.append(f"{i}: {u['name']} writes into %t/{leaf} and not {report}, which the brain watches")
              elif watched:
                  # A UNIT THAT DOES NOT NAME ITS REPORT runs something that
                  # writes it by itself — a generated script — and then the
                  # module's own folder has to spell the same directory.
                  spelled = any(
                      re.search(r'REPORTS_LEAF\s*[:=][^\n]*"' + re.escape(leaf) + '"', f.read_text(errors="replace"))
                      for f in sorted((folders / i).rglob("*")) if f.is_file()
                  )
                  if not spelled:
                      wrong.append(f"{i}: {u['name']} does not write %t/{leaf}/{report}, and nothing in its folder spells `{leaf}`")
              # AND A UNIT WHOSE SANDBOX OPENS THE DIRECTORY MAKES IT FIRST: a
              # `ReadWritePaths` naming a path that is not there fails the unit
              # with 226/NAMESPACE before the program runs (measured) — on a
              # session where nothing had made it yet, the sweep never started
              # and the brain waited out its patience.
              opens = any(p.lstrip("-") == f"%t/{leaf}" for p in u["readWritePaths"])
              if opens and leaf not in u["runtimeDirectory"].split():
                  wrong.append(f"{i}: {u['name']} opens %t/{leaf} and does not make it (RuntimeDirectory)")

      floor(waiting, 3, "brain modules whose run waits for its unit's report")

      if wrong:
          for w in wrong:
              print("ERROR: " + w, file=sys.stderr)
          sys.exit(1)
      print(f"OK: the brain reads %t/{leaf}, and the units of the {waiting} module(s) that wait for a report write there under their ids, rehearsals included")
      END
    '';

  the-sweep-only-looks-at-links = mkCheck "the-sweep-only-looks-at-links" [ pkgs.python3 ] ''
