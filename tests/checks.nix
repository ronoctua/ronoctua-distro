  # by Chrome's own call of the host, and a kiosk paired, driven and let go —
  # the only place the bridge meets a browser. Chrome is let in by name, the
  # `uade` precedent (`nix/player-tools.nix`).
  kioskVm = import ./kiosk-vm.nix {
    inherit pkgs lib inputs;
    ronoctua = {
      inherit fonts fontconfigConf iconSuperpack;
      inherit themes themed defaultTheme;
      inherit cursors;
      inherit scroll;
      inherit extension;
      shell = rust.shell;
      transfers = rust.transfers;
      browser = rust.browser;
    };
  };

  # The contract against the pinned compositor (milestone 4). See the file
  # for why there is no second version any more.
  compositorContract = import ./compositor-contract.nix {
    inherit pkgs lib scroll;
    ronoctua-shell = rust.shell;
    # The contract's driver, a program of its own (`rust.bins`): the shell's
    # bundle holds only the footer and what it finds beside itself.
    contract = rust.bins.ronoctua-contract;
  };

  # -------------------------------------------------------------------
  # Granular checks of milestone 1
  # -------------------------------------------------------------------

  # THE FLAKE'S TREE MUST NOT GET FAT. It cost 793 GB to find out.
  #
  # It is git's index that Nix uses to filter a flake's source, and the copy is
  # content-addressed: EVERY EDIT mints a new one. Before the repository had an
  # index there was nothing to filter by, so `nix flake check` copied the WHOLE
  # directory into the store.
  #
  # With an 18 GB `target/` inside, that gave 44 copies and 793 GB: 94% of the
  # store and 42% of the disk, with nothing warning. The `nix/rust.nix` already
  # filtered the source `crane` compiles, but that filter runs LATER — the 19 GB
  # copy has already happened at evaluation time.
  #
  # WHAT THIS CHECK SEES is `${self}`, which is only what git tracks: a build
  # directory that `.gitignore` hides never reaches it, and neither does one a
  # `cargo` outside the devshell left beside a manifest. That half is kept by
  # where cargo writes — `nix/cargo-dirs.nix`, exported by the devshell and,
  # for the intermediates, by every installed session. This check is what
  # stops a TRACKED build from being lost in the tree: the cost is invisible
  # day to day and only shows up when the disk fills.
  #
  # A THIRD-PARTY LAYER SEES ONLY WHAT IT USES.
  #
  # crane's `buildDepsOnly` layer (the 483 third-party crates against stubs,
  # gone with crane's whole-workspace builds on 2026-10-12) read none of the
  # generated inputs; and yet all 31 `RONOCTUA_*` were in its environment,
  # because it was handed the whole of what our crates are compiled with.
  #
  # Nix addresses a derivation by its inputs. With `RONOCTUA_BUFFER_MEMORY` in
  # there, editing a buffer changed the layer's hash and paid 4m46 of
  # compilation for a value nothing in it reads — and made the layer WAIT for
  # five wasm builds it never consumes. A `.ftl` or a token did the same.
  #
  # The layers that remain are the two the profile bench measures a variant
  # on (`nix/rust/layers.nix`, phase 1 of nix-design §1.4), each three
  # derivations — the layer's own workspace, cargo over it, the index. This
  # reads their attributes at evaluation time: no build, no
  # import-from-derivation. It is the environment that is checked because the
  # environment is how a value gets in. The third-party UNITS the build is
  # made of are `third-party-units-see-nothing-of-ours`' question, and what
  # each unit of ours is given is `units-see-only-what-they-read`.
  #
  # AND NO CARGO DIRECTORY, in a layer or in any unit. A `CARGO_TARGET_DIR`
  # or a `CARGO_BUILD_BUILD_DIR` (`nix/cargo-dirs.nix` is where they belong)
  # sends cargo — the layer's, or a build script's — to write and look
  # somewhere else than the build hands it, with no error at all.
  deps-layer-is-lean =
    let
      # BOTH LAYERS, one per cargo profile, with what each is made of.
      of = layer: lib.filter (lib.hasPrefix "RONOCTUA_") (lib.attrNames layer.drvAttrs);
      unitLayers = {
        release = rust.layers.release;
        release-raw = rust.layers.release.raw;
        release-workspace = rust.layers.release.raw.workspace;
        loop = rust.layers.loop;
        loop-raw = rust.layers.loop.raw;
        loop-workspace = rust.layers.loop.raw.workspace;
      };
      leaked = lib.concatMap of (lib.attrValues unitLayers);
      # Every unit, by flavour and kind.
      units =
        lib.concatMap
          (
            flavour:
            lib.concatMap
              (
                kind:
                lib.mapAttrsToList (name: d: lib.nameValuePair "${flavour}.${kind}.${name}" d) (
                  rust.${flavour}.${kind} or { }
                )
              )
              [
                "libs"
                "scripts"
                "bins"
                "testBins"
                "testRuns"
                "clippy"
              ]
          )
          [
            "release"
            "loop"
            "test"
          ];
      # A variable reaches cargo as an attribute or through `env`; both count.
      dirsOf =
        name: d:
        map (v: "${name}: ${v}") (
          lib.filter (v: builtins.match "CARGO_[A-Z_]*DIR" v != null) (
            lib.attrNames d.drvAttrs ++ lib.attrNames (d.drvAttrs.env or { })
          )
        );
      # The layers, every derivation of `nix/rust.nix` that takes a crane
      # layer (none since crane's whole-workspace builds went; one that came
      # back is asked too), and every unit.
      onALayer =
        unitLayers
        // lib.filterAttrs (_: d: (d.drvAttrs.cargoArtifacts or null) != null) rustDerivations
        // lib.filterAttrs (_: d: d.drvAttrs ? unit) (lib.listToAttrs units);
      redirected = lib.concatLists (lib.mapAttrsToList dirsOf onALayer);
      # The census has to reach the builds that matter, or an empty list
      # proves nothing: the shell's test harnesses and its clippy are the two
      # an edit of the footer waits on.
      reached = onALayer ? "test.testBins.ronoctua-shell" && onALayer ? "test.clippy.ronoctua-shell";
    in
    mkCheck "deps-layer-is-lean" [ ] ''
      if [ "${lib.boolToString reached}" != true ]; then
        echo "ERROR: the census of nix/rust.nix no longer reaches the shell's test harnesses and clippy;" >&2
        echo "      finding no cargo directory there would prove nothing." >&2
        exit 1
      fi
      leaked="${lib.concatStringsSep " " leaked}"
      if [ -n "$leaked" ]; then
        echo "ERROR: a dependency layer was given variables it does not use:" >&2
        for v in $leaked; do echo "  $v" >&2; done
        echo >&2
        echo "      A layer takes \`buildBase\` and nothing of \`generated\` (nix/rust.nix)." >&2
        echo "      Each one of those costs a layer's recompilation every time its value" >&2
        echo "      changes — and a .wasm changes every time somebody edits the buffer." >&2
        exit 1
      fi
      redirected=${lib.escapeShellArg (lib.concatStringsSep "\n" redirected)}
      if [ -n "$redirected" ]; then
        echo "ERROR: a layer or a unit names a cargo directory of its own:" >&2
        echo "$redirected" | sed 's/^/  /' >&2
        echo >&2
        echo "      With the directory moved, cargo writes and looks where the build" >&2
        echo "      does not hand it, silently. The cargo directories belong to" >&2
        echo "      nix/cargo-dirs.nix, which only the devshell, the loop and the" >&2
        echo "      session read." >&2
        exit 1
      fi
      echo "OK: no dependency layer carries a RONOCTUA_* at all, and" \
        "the ${toString (lib.length (lib.attrNames onALayer))} builds on a layer or a unit name no cargo directory"
    '';

  # EVERY DERIVATION `nix/rust.nix` MAKES, by name, for the checks that ask the
  # same question of each. `tryEval`, because an attribute of that set that is
  # a table or a function must not stop the census.
  rustDerivations = lib.filterAttrs (
    _: v:
    let
      is = builtins.tryEval (lib.isDerivation v);
    in
    is.success && is.value
  ) rust;

  # A LEAF BUILD KEEPS NOTHING BUT ITS VERDICT.
  #
  # crane's default, for everything that is not `buildPackage`, is to tar and
  # zstd the whole `target/` into `$out`. For crane's dependency layers that
  # was the product — the next build unpacked it. For its tests, clippy and
  # formatter it was gigabytes per edit that nothing read (a check needs the
  # build to succeed, not its objects), each one holding a link to the loop's
  # layer as well. Those builds went on 2026-10-12, with their layers, and
  # nothing of `nix/rust.nix` is a crane build of our crates any more.
  #
  # The day somebody adds a `cargoDoc`, a `cargoNextest` or a `cargoTest`
  # back, it comes with the default again. So this asks every derivation of
  # `nix/rust.nix` whether it archives its build, and none may. Read from
  # the attributes, at evaluation time: no build.
  #
  # AND THE UNITS KEEP ONLY THEIR PRODUCT (2026-10-12). A unit is built by
  # the driver (`nix/scripts/rust-unit.py`), which ends every build by
  # refusing anything beyond what that kind of unit IS: a library its rlib,
  # its build script's `OUT_DIR` and `nix-support/`; a program its `bin/`;
  # the test harnesses theirs; a test run, clippy and rustfmt a verdict (and
  # the run's log); a measurement two numbers; a third-party unit what a
  # library keeps. Only a third-party layer holds a `deps/` of compiled crates. This asks every unit, at evaluation, that
  # its kind (`passthru.kind`) is the mode the driver runs it in and one the
  # driver knows what to keep of — and asks the driver itself, on a planted
  # output of each kind, that it keeps the product and refuses a `deps/`.
  leaf-builds-keep-no-artifacts =
    let
      archivingOf = lib.filterAttrs (_: d: d.drvAttrs.doInstallCargoArtifacts or false);
      leaves = lib.attrNames (archivingOf rustDerivations);
      # And the question is not blind: a derivation that archives, as a crane
      # leaf does by default, is found (planted, never built).
      plantedFound =
        (archivingOf {
          planted = pkgs.runCommand "planted-crane-leaf" { doInstallCargoArtifacts = true; } "";
        }) ? planted;
      # The census reaches `nix/rust.nix`'s derivations, or finding no leaf
      # proves nothing: the named programs a module runs are among them.
      reached = lib.all (n: rustDerivations ? ${n}) [
        "installer"
        "rescue"
        "brain"
        "transfers"
        "shell"
        "tests"
        "clippy"
        "fmt"
      ];
      units =
        lib.concatMap
          (
            flavour:
            lib.concatMap (kind: lib.attrValues (rust.${flavour}.${kind} or { })) [
              "deps"
              "libs"
              "scripts"
              "bins"
              "testBins"
              "testRuns"
              "clippy"
            ]
          )
          [
            "release"
            "loop"
            "test"
          ]
        ++ lib.attrValues rust.test.fmt;
      unitKinds = pkgs.writeText "unit-kinds.json" (
        builtins.toJSON (
          map (d: {
            inherit (d) name;
            kind = d.passthru.kind or null;
            mode = d.drvAttrs.unit.mode or null;
            archives = d.drvAttrs.doInstallCargoArtifacts or false;
          }) units
        )
      );
    in
    mkCheck "leaf-builds-keep-no-artifacts" [ pkgs.python3 ] ''
      # THE UNITS: each kind the driver's own, and the driver's refusal.
      python3 - ${unitKinds} ${../nix/scripts/rust-unit.py} <<'END'
      import importlib.util, json, os, sys, tempfile
      exec(open("${pyPrelude}").read())

      # PARSED: the units' attributes as Nix evaluated them, and the driver,
      # imported and asked.
      units = json.load(open(sys.argv[1]))
      spec = importlib.util.spec_from_file_location("rust_unit", sys.argv[2])
      driver = importlib.util.module_from_spec(spec)
      spec.loader.exec_module(driver)
      floor(len(units), 600, "units")
      wrong = []
      kinds = set()
      for u in units:
          kinds.add(u["kind"])
          if u["kind"] not in driver.KEEPS:
              wrong.append(f"{u['name']} is a {u['kind']} unit, which the driver keeps nothing of")
          if u["mode"] != u["kind"]:
              wrong.append(f"{u['name']} is a {u['kind']} unit run in the driver's {u['mode']} mode")
          if u["archives"]:
              wrong.append(f"{u['name']} archives its build")
      floor(len(kinds), 7, "kinds of unit")
      for kind in sorted(kinds & set(driver.KEEPS)):
          with tempfile.TemporaryDirectory() as d:
              out = os.path.join(d, "out")
              for entry in sorted(driver.KEEPS[kind]):
                  os.makedirs(os.path.join(out, entry))
              if driver.kept_beyond(kind, out, None):
                  wrong.append(f"the driver refuses a {kind} unit's own product: {driver.kept_beyond(kind, out, None)}")
              os.makedirs(os.path.join(out, "deps"), exist_ok=True)
              open(os.path.join(out, "deps", "libserde-0123.rlib"), "w").close()
              if not any("deps/" in w for w in driver.kept_beyond(kind, out, None)):
                  wrong.append(f"the driver keeps a deps/ in a {kind} unit")
      if wrong:
          print("ERROR: a unit keeps more than its product:", file=sys.stderr)
          for w in wrong:
              print("  " + w, file=sys.stderr)
          sys.exit(1)
      print(f"OK: {len(units)} units in {len(kinds)} kinds, each kept to its product by the driver")
      END

      # THE FLOOR: the census has to reach `nix/rust.nix`'s derivations, or
      # it would report no leaf, and pass.
      if [ "${lib.boolToString reached}" != true ]; then
        echo "ERROR: the census no longer reaches nix/rust.nix's derivations (the named" >&2
        echo "      programs, the shell's bundle, the three aggregates) and proves nothing." >&2
        exit 1
      fi
      if [ "${lib.boolToString plantedFound}" != true ]; then
        echo "ERROR: a planted derivation that archives its target/ was not found: this census is blind" >&2
        exit 1
      fi
      leaves="${lib.concatStringsSep " " leaves}"
      if [ -n "$leaves" ]; then
        echo "ERROR: a leaf build archives its whole target/ into the store:" >&2
        for l in $leaves; do echo "  rust.$l" >&2; done
        echo >&2
        echo "      crane defaults \`doInstallCargoArtifacts\` to true for everything" >&2
        echo "      that is not buildPackage. The build is one derivation per unit" >&2
        echo "      (nix/rust/units.nix), and a unit keeps only its product." >&2
        exit 1
      fi
      echo "OK: none of the" \
        "${toString (lib.length (lib.attrNames rustDerivations))} rust derivations archives a target/"
    '';

  # THE LOCAL `cargo` BUILDS LEAN.
  #
  # `[profile.dev]` is what every `cargo test -p`, `cargo clippy` and
  # rust-analyzer run compiles at, and full debug info was most of it: one test
  # binary of the shell was 716 MiB, 631 of them `.debug_*`. The root
  # `Cargo.toml` asks for line tables in our crates and nothing in the
  # dependencies — the backtrace a panic prints, and no more.
  #
  # And `release` and `loop` carry no debug info at all: stdenv strips `bin/`
  # with `-S`, so `debug = 1` there never reached a machine and only made the
  # dependency layer bigger and the LTO link slower. It came back once "to
  # diagnose a missed frame", which is how it would come back again.
  #
  # # PARSED
  #
  # By Nix's own TOML reader, so a comment cannot answer for a setting. And
  # the two places that beat the manifest without touching it: a
  # `CARGO_PROFILE_*` in the devshell (the environment beats every file) and a
  # `.cargo/config*` in the tree (config beats the manifest).
  cargo-dev-profile-is-lean =
    let
      manifest = builtins.fromTOML (builtins.readFile ../Cargo.toml);
      profile = manifest.profile or { };
      # What cargo reads as "no debug info": `false`, `0` and `"none"`.
      none =
        v:
        builtins.elem v [
          false
          0
          "none"
        ];
      shown = v: builtins.toJSON v;
      devDebug = profile.dev.debug or null;
      depsDebug = profile.dev.package."*".debug or null;
      # An override may lower a crate's debug info, never raise it past line
      # tables: that is the dev profile undone one crate at a time.
      raised =
        where: packages:
        lib.mapAttrsToList (n: p: "${where}.package.\"${n}\" asks for debug = ${shown p.debug}") (
          lib.filterAttrs (_: p: p ? debug && !(none p.debug) && p.debug != "line-tables-only") packages
        );
      shell = self.devShells.${system}.default.drvAttrs;
      overrides = lib.filter (lib.hasPrefix "CARGO_PROFILE_") (
        lib.attrNames shell ++ lib.attrNames (shell.env or { })
      );
      problems =
        lib.optional (
          devDebug != "line-tables-only"
        ) "[profile.dev] debug is ${shown devDebug}, and it has to be \"line-tables-only\""
        ++ lib.optional (
          !(none depsDebug)
        ) "[profile.dev.package.\"*\"] debug is ${shown depsDebug}, and the dependencies take none"
        ++ lib.optional (
          (profile.test or { }) ? debug
          && !(none profile.test.debug)
          && profile.test.debug != "line-tables-only"
        ) "[profile.test] debug is ${shown profile.test.debug}, which undoes the dev profile for every test"
        # `"*"` is the line above, and stricter: the dependencies take none.
        ++ raised "profile.dev" (removeAttrs (profile.dev.package or { }) [ "*" ])
        ++ raised "profile.test" (profile.test.package or { })
        ++
          lib.concatMap
            (
              name:
              lib.optional ((profile.${name} or { }) ? debug && !(none profile.${name}.debug))
                "[profile.${name}] debug is ${shown profile.${name}.debug}; stdenv strips it from every installed binary"
            )
            [
              "release"
              "loop"
            ]
        ++ map (v: "the devshell sets ${v}, which beats the manifest for every build in it") overrides
        ++ lib.optional (lib.hasInfix "CARGO_PROFILE_" (
          shell.shellHook or ""
        )) "the devshell's hook exports a CARGO_PROFILE_*, which beats the manifest";
    in
    mkCheck "cargo-dev-profile-is-lean" [ pkgs.findutils ] ''
      problems=${lib.escapeShellArg (lib.concatStringsSep "\n" problems)}
      # `.cargo/config*` anywhere in the tree: its `[profile]` would beat the
      # manifest, and its `build-dir` would move a crane build off its layer.
      configs=$(find ${self} -path '*/.cargo/config*' -print)
      if [ -n "$configs" ]; then
        problems="$problems
      a cargo config in the tree beats the manifest: $configs"
      fi
      if [ -n "$(echo "$problems" | tr -d '[:space:]')" ]; then
        echo "ERROR: the local cargo would not build lean:" >&2
        echo "$problems" | sed '/^ *$/d; s/^ */  /' >&2
        exit 1
      fi
      echo "OK: dev builds line tables for our crates and nothing for the" \
        "dependencies; release and loop carry none"
    '';

  lean-tree = mkCheck "lean-tree" [ ] ''
    # KiB. What this catches is a BUILD inside the tree (793 GB once), which is
    # gigabytes, not the source growing: measured 19 760 KiB at HEAD and
    # 22 332 KiB with the software centre (2026-09-27), against a comment that
    # still said 1.3 MB from the first commit; 31 684 KiB with the first wave of
    # the 2026-09-30 batch (the brain's modules, the catalogue, the security
    # centre and a dozen boundary crates — source, every file of it tracked);
    # 44 080 KiB with the 2026-10-05 wave (the machine's own flake, the
    # belongings' format 2, the post-quantum crates, /private, Incus, the LLM
    # accounts — 33 176 KiB of it is `crates/`, and no build directory).
    #
    # BY LENGTH, the files alone. Those numbers were `du`'s blocks, and a
    # store's blocks are its filesystem's: ZFS compressed the same tree to
    # 23 319 KiB, and ext4 rounds each of its 2 247 files up to 4 KiB — a
    # ceiling held on one machine broken on the next with nothing changed.
    # A directory's own size is the filesystem's too, so only the regular
    # files are summed: 49 128 KiB on 2026-10-23, on every machine. The
    # ceiling keeps ~30% above the source, as before. Measure again before
    # moving it.
    cap=65536
    tree_size=$(find ${self} -name .git -prune -o -type f -printf '%s\n' | awk '{ s += $1 } END { printf "%d\n", s / 1024 }')
    echo "flake source: $tree_size KiB of files (ceiling $cap KiB)"
    if [ "$tree_size" -gt "$cap" ]; then
      echo >&2
      echo "ERROR: the tree copied into the store is $tree_size KiB." >&2
      echo >&2
      echo "Every edit to ANY file mints a copy of this size." >&2
      echo "Look for a build directory inside the tree:" >&2
      du -sh --apparent-size ${self}/* 2>/dev/null | sort -rh | head -5 >&2
      echo >&2
      echo "Builds go to \$CARGO_TARGET_DIR, outside the tree." >&2
      exit 1
    fi
  '';

  # The mistake section 1 of the document explicitly says to avoid: the
  # .gitignore swallowing the font files that come to live in the repo.
  #
  # We cannot run `git check-ignore` against the real repository (there is no
  # git, by the decision of section 1), so we assemble a throwaway repo with
  # OUR .gitignore and the real tree of paths.
  gitignore-keeps-fonts = mkCheck "gitignore-keeps-fonts" [ pkgs.git ] ''
    export HOME=$TMPDIR
    mkdir -p repo && cd repo
    git init -q .
    cp ${../.gitignore} .gitignore

    # Recreates the real paths as empty files. The fonts are NOT here any more
    # (they are a Release asset), so what has to survive the .gitignore is the
    # hand-kept content and the code.
    while IFS= read -r f; do
      mkdir -p "$(dirname "$f")"
      : > "$f"
    done < ${
      pkgs.writeText "tracked-paths.txt" (
        lib.concatStringsSep "\n" [
          "assets/lexicon/tags.en-pt.toml"
          "assets/lexicon/overlay.toml"
          "assets/icons/tray-glyphs.nix"
          "assets/tokens/.keep"
          "nix/fonts.nix"
          "nix/scripts/fix-font-names.py"
          "nix/scripts/make-console-psf.py"
          "docs/ARCHITECTURE.md"
          "tests/checks.nix"
          "flake.nix"
          "AGENTS.md"
          "README.md"
        ]
      )
    }

    failed=0
    while IFS= read -r f; do
      if git check-ignore -q "$f"; then
        echo "ERROR: .gitignore is swallowing $f" >&2
        failed=1
      fi
    done < <(find assets nix docs tests -type f 2>/dev/null; ls flake.nix AGENTS.md README.md)
    [ $failed -eq 0 ] || exit 1
    echo "OK: no versioned source is ignored"

    # And the other way round: what MUST be ignored.
    for f in .TEMP/x.ttf result nix/hosts/host.nix foo.qcow2 a.key some.age; do
      mkdir -p "$(dirname "$f")"; : > "$f"
      git check-ignore -q "$f" || { echo "ERROR: $f is not being ignored" >&2; exit 1; }
    done
    echo "OK: secrets, artefacts and host.nix are ignored"
  '';

  # Proof that the naming fix caught: ONE typographic family and 135 distinct
  # (family, subfamily) pairs, with no collision between SemiExtended
  # (usWidthClass 6) and Extended (7).
  #
  # The TTFs are fixed and MUST have a unique family. The WOFF2s pass through
  # untouched on purpose (see the note in nix/fonts.nix), so on them we only
  # take inventory — demanding a unique family there would assert something false.
  fonts-single-family = mkCheck "fonts-single-family" [ py ] ''
    echo "### corrected: one family, and it is required ###"
    python3 ${../nix/scripts/fix-font-names.py} ${fonts.corrected}/TTF-nerdfonts \
      --family "NoctuaIosevka Nerd Font Mono" --expect-count 135 --dry-run
    python3 ${../nix/scripts/fix-font-names.py} ${fonts.corrected}/TTF \
      --family "Noctua Iosevka" --expect-count 135 --dry-run

    echo
    echo "### intactos: so inventario ###"
    python3 ${../nix/scripts/fix-font-names.py} ${fonts.corrected}/WOFF2-nerdfonts \
      --family "NoctuaIosevka Nerd Font Mono" --expect-count 135 --inventory
    python3 ${../nix/scripts/fix-font-names.py} ${fonts.corrected}/WOFF2 \
      --family "Noctua Iosevka" --expect-count 135 --inventory
  '';

  # Invariants of the inventory, measured and not assumed. If the font is
  # swapped for another build, this fails and forces a review of the plan —
  # instead of the footer silently going out of alignment.
  fonts-metrics = mkCheck "fonts-metrics" [ py ] ''
    python3 - <<'PY'
    from fontTools.ttLib import TTFont
    import glob, sys

    failed = False
    expected_cp = 18053
    advances = {3: 456, 4: 548, 5: 600, 6: 658, 7: 720}

    for p in sorted(glob.glob("${fonts.corrected}/TTF-nerdfonts/*.ttf")):
        f = TTFont(p, lazy=True)
        cmap = f.getBestCmap()
        os2 = f["OS/2"]
        head = f["head"]

        if head.unitsPerEm != 1000:
            print(f"ERROR {p}: unitsPerEm {head.unitsPerEm} != 1000"); failed = True
        if len(cmap) != expected_cp:
            print(f"ERROR {p}: {len(cmap)} codepoints, expected {expected_cp}"); failed = True

        # Exact monospacing: ONE advance per face, that of its own width.
        width = os2.usWidthClass
        adv = {f["hmtx"][g][0] for g in cmap.values()}
        if len(adv) != 1:
            print(f"ERROR {p}: {len(adv)} distinct advances; it is not monospaced"); failed = True
        elif adv.pop() != advances[width]:
            print(f"ERROR {p}: the wrong advance for usWidthClass {width}"); failed = True
        f.close()

    if failed:
        sys.exit(1)
    print("OK: 135 faces, 18,053 codepoints each, monospaced, upem 1000")
    print("OK: cell = 0.600 em at the normal width — the footer's arithmetic holds")
    PY
  '';

  # THE ICON HAS TO BE THE SIZE OF THE TEXT NEXT TO IT — and it was not.
  #
  # Reported from the screen: "the bell looks much too small, smaller than the
  # rest of the letters and numbers". It was true and it is measurable: the ink
  # of `cod-bell` is 600 units tall against 751 for the digit `0`, so at the
  # same point size the bell comes out a fifth shorter. Nothing failed; it just
  # looked wrong, which is the class of defect that survives for months.
  #
  # The fix is the `font.size.icon` token, and this is what keeps it honest: the
  # two numbers come from the token file, the ink comes from the real face, and
  # a new chrome icon whose drawing is out of scale fails HERE instead of on
  # somebody's screen.
  #
  # 85%..115% and not "equal": these are different families of drawing (a bell,
  # a swap arrow, a pie) and they are not going to agree to the unit. What the
  # band excludes is what the eye reads as another size.
  chrome-icons-match-the-text =
    let
      typography = import ../assets/tokens/typography.nix;
    in
    mkCheck "chrome-icons-match-the-text" [ py pkgs.gnugrep ] ''
      python3 - <<'PY'
      from fontTools.ttLib import TTFont
      from fontTools.pens.boundsPen import BoundsPen
      import json, sys

      BASE = ${toString typography.size.base}
      TOLERANCE = ${toString typography.chromeTolerance}
      ICON = ${toString typography.size.icon}

      # THE ICONS THE CHROME DRAWS INLINE WITH TEXT, at `font.size.icon`.
      #
      # They are named here, and not derived by prefix, because the prefix is
      # not the property: `transfer-paused` and `transfer-running` share the
      # family and are drawn in the transfer PANEL, on the grid, next to a row
      # of their own. What this list holds is what sits shoulder to shoulder
      # with digits on one line.
      INLINE = [
          "notification-pending",
          # THE BATTERY'S LADDER AND THE PROFILE'S MARK sit beside the `NN%`
          # digits and the rest of the line, so they are measured here too.
          "battery-low",
          "battery-half",
          "battery-high",
          "battery-full",
          "battery-charging-empty",
          "battery-charging-low",
          "battery-charging-half",
          "battery-charging-high",
          "battery-charging-full",
          "battery-danger",
          "profile-power-saver",
          "profile-balanced",
          # THE DEVICE MARKS sit beside the same `NN%` digits, four at a time.
          "bluetooth-device-headphones",
          "bluetooth-device-headset",
          "bluetooth-device-speaker",
          "bluetooth-device-keyboard",
          "bluetooth-device-mouse",
          "bluetooth-device-gamepad",
          "bluetooth-device-tablet",
          "bluetooth-device-phone",
          "bluetooth-device-computer",
          "bluetooth-device-watch",
          "bluetooth-device-camera",
          "bluetooth-device-printer",
          "bluetooth-device-network",
          "bluetooth-device-display",
          "bluetooth-device-unknown",
          "bluetooth-connected",
          "bluetooth-off",
          # THE SOFTWARE VIEW'S TWO: a trial running and Android on.
          "software-trial",
          "software-android",
          # THE WAY OUT'S THREE, beside the same digits.
          "no-internet",
          "airplane",
          "vpn",
          "tailscale",
          "tor",
          # AND THE NETWORK VIEW'S ROWS, whose glyph is the first thing in the
          # row's LABEL — shoulder to shoulder with the interface's name and
          # the network's. It used to be a column of its own, which is why the
          # arc-shaped `wifi_strength` family went unmeasured for so long.
          "wifi-none",
          "wifi-weak",
          "wifi-fair",
          "wifi-good",
          "wifi-strong",
          "wifi-off",
          "network-secured",
          "ethernet",
          # The two things one does to a notification with the mouse, and the
          # second drawing of the first: the closed envelope that puts a row
          # back to unread.
          "notification-mark-read", "notification-mark-unread", "notification-delete",
          # And the generic marks, for what nobody named a glyph for.
          "info", "warning", "error",
          "transfer",
          "countdown-one", "countdown-two", "countdown-three", "countdown-four",
          "countdown-five", "countdown-six", "countdown-seven", "countdown-eight",
          # AND THE TWO FRAMES OF "AN UPDATE IS RUNNING", which sit in the
          # modeline beside the buffer's name and the marks beside it. They are
          # measured for the same reason the pie is: an animation whose frames
          # are 20% shorter than the text next to them does not read as one
          # drawing moving, it reads as the line twitching. Here the two frames
          # are the same circle filled and hollow, so the measurement is also
          # what keeps them the same drawing.
          "working-one", "working-two",
          # AND THE PLAYER'S PAIR, one segment of two glyphs (`player_mark`)
          # with the workspace numbers right beside it: play or pause, and
          # next. Two drawings side by side at two sizes read as two things.
          "player", "pause", "player-next",
      ]

      face = "${fonts.corrected}/TTF-nerdfonts/NoctuaIosevkaNerdFontMono-Regular.ttf"
      f = TTFont(face, lazy=True)
      cmap = f.getBestCmap()
      glyphs = f.getGlyphSet()
      icons = json.load(open("${glyphdb.db}/icons.json"))

      # THE MARKS FACE IS ONE OF THE READERS TOO.
      #
      # A mark this repository draws is an icon on the same modeline, beside
      # the same text, and it has to answer the same band — but it lives in
      # another face (`nix/marksgen.nix`), so asking the Nerd Font for its
      # codepoint is a `KeyError` and not a measurement. Both faces are asked,
      # in the order the renderer asks them.
      marks_face = TTFont("${marksdb.db}/NoctuaMarks.ttf", lazy=True)
      marks_cmap = marks_face.getBestCmap()
      marks_glyphs = marks_face.getGlyphSet()

      def ink(cp):
          table, shapes = (cmap, glyphs) if cp in cmap else (marks_cmap, marks_glyphs)
          if cp not in table:
              raise SystemExit(
                  f"U+{cp:05X} is in no face this check knows: neither the Nerd "
                  "Font nor the marks."
              )
          pen = BoundsPen(shapes)
          shapes[table[cp]].draw(pen)
          return pen.bounds

      x0, y0, x1, y1 = ink(ord("0"))
      digit = (y1 - y0) * BASE / 1000.0
      # THE CELL, and how far into it the neighbouring digit's ink begins.
      #
      # A chrome glyph is drawn bigger than the grid and centred on its cell, so
      # its ink DOES leave the cell — by design, and harmlessly, as long as it
      # stops short of where the character beside it starts drawing. That is
      # what this number is: `0` has 80 units of left bearing, which at the base
      # size is 1,44 px of air the icon may borrow.
      cell = BASE * 0.6
      bearing = x0 * BASE / 1000.0
      print(f"digit `0` at {BASE} px: {digit:.2f} px of ink, bearing {bearing:.2f} px")

      # THE ONE SHAPE THE BAND CANNOT MEASURE, by name and with its reason.
      #
      # The band asks whether a drawing is as tall as the digit, because the
      # defect it was born from was a bell with room to grow that was not
      # using it. A WIDE drawing has no such room: its ink already spans the
      # cell, and a size that made it as tall as the digit would push it into
      # the character beside it. There is no square keyboard in the font, and
      # a keyboard is what the row is about — so this one is measured by the
      # other rule: it must FILL the cell and it must not be a sliver. The
      # `deviations` of `owl.reference.nix`, in another file.
      WIDE = {
          "bluetooth-device-keyboard": "a keyboard is drawn wide and flat; nothing square in the font means keyboard",
          "tailscale": "four dots, three across and one under the middle: three cells wide by two tall, and a dot has to stay round",
      }
      FLOOR = 0.60

      failed = False
      for token in INLINE:
          if token not in icons:
              print(f"ERROR: `{token}` is not an icon token (renamed?)")
              failed = True
              continue
          gx0, gy0, gx1, gy1 = ink(icons[token]["codepoint"])
          # THE SIZE THIS GLYPH IS DRAWN AT — measured by `gen-glyphdb.py`
          # against this same face, and generated into
          # `tokens::icon::chrome_size`. `font.size.icon` is its ceiling: a
          # small drawing is brought up to the digit; a tall one (the vertical
          # battery, 908 units against the digit's 751) is brought DOWN to
          # it, and this is where a drawing of another proportion is caught
          # instead of on somebody's screen.
          size = float(icons[token]["chrome"])
          if size > ICON:
              print(f"ERROR: `{token}` is drawn at {size} px, past font.size.icon ({ICON})")
              failed = True
              continue
          h = (gy1 - gy0) * size / 1000.0
          pct = 100.0 * h / digit
          # The run is placed so its ADVANCE is centred on the cell — see
          # `render::Size::OnTheCell` — and the ink rides wherever the font put
          # it inside that advance, which is not always the middle.
          shift = (cell - size * 0.6) / 2.0
          over = max(-(gx0 * size / 1000.0 + shift), gx1 * size / 1000.0 + shift - cell)
          ink_wide = (gx1 - gx0) * size / 1000.0
          if token in WIDE:
              # As large as the cell allows, and not a sliver.
              tall = ink_wide >= cell and h >= FLOOR * digit
              why = "  (wide: " + WIDE[token] + ")"
          else:
              tall = 100.0 - TOLERANCE <= pct <= 100.0 + TOLERANCE
              why = ""
          wide = over < bearing
          mark = "ok " if tall and wide else "NO "
          print(
              f"{mark} {token:24s} {icons[token]['glyph']:28s} "
              f"{size:4.0f} px -> {h:5.2f} px {pct:5.1f}%  overflows {over:5.2f} px{why}"
          )
          if not tall:
              failed = True
          if not wide:
              print(f"       `{token}` invades the ink of the character beside it")
              failed = True

      if failed:
          print("")
          print("ERROR: a chrome icon is out of scale with the text beside it.")
          print("      Either `font.size.icon` changed, or the new glyph has a drawing")
          print("      that no size within the ceiling brings to the digit's height —")
          print("      change the glyph, not the ceiling: it holds for all the others.")
          sys.exit(1)
      print("")
      # AND NOBODY WIDENS THE EXCEPTION QUIETLY: the list is named here, and
      # a token that stops being drawn inline has to leave both lists.
      unused = sorted(t for t in WIDE if t not in INLINE)
      if unused:
          print(f"ERROR: the wide exception names a glyph the chrome does not draw inline: {unused}")
          sys.exit(1)
      print(
          f"OK: {len(INLINE)} chrome icons at the digit's height "
          f"({len(WIDE)} wide by their own drawing), and none touches it"
      )
      PY

      # AND NOBODY introduces an inline size without passing through here.
      #
      # The list above only holds while a glyph centred on its cell is asked for
      # with the sizes this check measures: the token, or the generated
      # `icon::chrome_size`, which is the same measurement written into the
      # Rust. A size written
      # loose would escape the measurement entirely — and the way to find out
      # would again be by looking at the screen.
      #
      # The shell is the whole scope on purpose: a wasm buffer cannot ask for a
      # size in px (invariant 11 gives it a Scale, and the host resolves it), so
      # every chrome glyph in the system is drawn from here.
      python3 - <<'PY'
      import pathlib, re, sys

      # BOTH SPELLINGS OF THE ONE ANSWER. `surface::chrome_size` takes the run's
      # text and `chrome_size_of` takes a `char` — the two chevrons hold one
      # already, and making them build a `String` for it to be taken apart again
      # was a cost per frame. They are the same measurement.
      MEASURED = re.compile(r"chrome_size(_of)?\(")

      # AND ONE EXCEPTION, NAMED, because it is not a chrome glyph at all.
      #
      # `files::run_size` is the size of a run standing in for a PICTURE: the
      # glyph a thumbnail shows when the file has none. Its size is the room the
      # picture would have had, not the digit's height, and holding it to the
      # digit's height is what the owner photographed — *"os glifos dos itens
      # que não tem thumbnail aparecem minúsculos em vez de adaptar o tamanho"*.
      #
      # It is centred for the reason every other `OnTheCell` is: a run bigger
      # than the grid has to be centred on the cells it covers or it hangs off
      # their left. And it is ONE function, so this exception is one line rather
      # than a hole: anything else that wants a loose size is still refused.
      #
      # AND THE ICONS APP'S STAGE (`icons_page::centred_run`), for the same
      # reason: the icon on its page is the SUBJECT, drawn at the size the
      # person chose on the page and grown from its centre
      # (`the-icon-grows-from-its-centre`) — not a glyph of the chrome.
      EXCEPT = {("fields.rs", "run_size"), ("icons_page.rs", "centred_run")}

      exec(open("${pyPrelude}").read())
      exec(open("${shellPrelude}").read())

      # FILE-WIDE: a glyph centred in its cell with a loose size is an offence
      # wherever it is written — there is no function to narrow to, because the
      # point is that it may appear in one that does not exist yet. `whose` is
      # the prelude's copy of the `walls` idiom, and it is what names the
      # function a hit landed in.
      #
      # TWO VARIANTS CENTRE A GLYPH ON ITS CELL since the on-screen keyboard
      # (e9a333f): `OnTheCell(px)`, and `Lowered(by, Some(px))` for a legend a
      # fraction of a line down — the renderer sizes and nudges both by one
      # expression (`Size::px`, `Size::nudge`). Both are MADE only from the
      # measurement, and it is the ARGUMENT that is read, not a window of text
      # after the name. A PATTERN is not a making: `OnTheCell(v) =>` reads a
      # size made elsewhere, and the `v` it binds may be handed straight on, in
      # that arm, to `Lowered(by, Some(v))` — it already passed through here.
      # AND `Placed(across, by, px)` since the icons' stage (2026-10-04): a run
      # at any pixel, whose size is its third argument.
      CENTRED = re.compile(r"Size::(OnTheCell|Lowered|Placed)\(")
      ARM = re.compile(r"\s*=>\s*\{?\s*(?:\w+::)*")

      def split_top(args):
          # The arguments of one call, split at its own commas only.
          parts, deep, cur = [], 0, []
          for ch in args:
              if ch in "([{":
                  deep += 1
              elif ch in ")]}":
                  deep -= 1
              if ch == "," and deep == 0:
                  parts.append("".join(cur).strip())
                  cur = []
              else:
                  cur.append(ch)
          parts.append("".join(cur).strip())
          return [p for p in parts if p]

      loose, sources, made = [], 0, 0
      for f in sorted(shell_files("**/*.rs")):
          body = code_of(f.read_text())
          sources += 1
          bound = []  # (where an `OnTheCell(<name>)` pattern shuts, <name>)
          for m in CENTRED.finditer(body):
              args = shut_at(body, m.end())
              shut = m.end() + len(args) + 1
              after = body[shut:].lstrip()
              parts = split_top(args)
              pattern = (
                  after.startswith(("=>", "if "))
                  or (after.startswith("|") and not after.startswith("||"))
                  or (after.startswith("=") and not after.startswith("=="))
                  or any(p in ("_", "..") for p in parts)
              )
              if pattern:
                  if m.group(1) == "OnTheCell" and len(parts) == 1 and re.fullmatch(r"[a-z_]\w*", parts[0]):
                      bound.append((shut, parts[0]))
                  continue
              if m.group(1) == "OnTheCell":
                  size = parts[0] if parts else ""
              elif m.group(1) == "Placed":
                  if len(parts) < 3:
                      continue
                  size = parts[2]
              else:
                  if len(parts) < 2 or parts[1] == "None":
                      continue  # the grid's own size, lowered: nothing centred
                  inner = re.fullmatch(r"Some\((.*)\)", parts[1], re.S)
                  size = inner.group(1).strip() if inner else parts[1]
              made += 1
              if MEASURED.search(size):
                  continue
              if any(name == size and ARM.fullmatch(body[end : m.start()]) for end, name in bound):
                  continue
              inside = whose(body, m.start())
              if (f.name, inside) in EXCEPT:
                  continue
              line = body[: m.start()].count("\n") + 1
              loose.append(f"{f.name}:{line} (in `{inside}`)")
      floor(sources, 30, "sources of the shell swept for a loose size")
      floor(made, 4, "centred sizes made in the shell")

      if loose:
          print("ERROR: a glyph centred in the cell with a size outside the measurement:")
          for l in loose:
              print("       " + l)
          print("      The chrome's size has ONE rule: font.size.icon as the ceiling, and")
          print("      icon::chrome_size for what the glyph generator measured.")
          print("      The exceptions are " + ", ".join(f"`{w}` ({n})" for n, w in sorted(EXCEPT))
                + ", named in this check.")
          sys.exit(1)
      print(f"OK: every glyph centred in a cell ({made} made) uses the measured size")
      PY

      # AND WHERE THE INK BEGINS AND ENDS ACROSS, MEASURED AGAIN.
      #
      # `tokens::icon::ink_across` is what the column's rule stands between
      # (`column::close_rule`, `column-rule-has-equal-air`): the close
      # glyph's right edge and the widest size's left one, in ems, written by
      # the glyph generator (`gen-glyphdb.py`, `across`). Its numbers are only
      # as true as that one measurement — a font bump, or a generator that
      # stopped reading the right face, would move the rule a pixel off the
      # eye's middle and nothing would say so. Every glyph the shell asks
      # `ink_across` (or the column's `ink_of`) about is measured here again,
      # against the face that draws it, and must agree to the ten-thousandth
      # of an em the table keeps.
      python3 - <<'PY'
      from fontTools.ttLib import TTFont
      from fontTools.pens.boundsPen import BoundsPen
      import json, pathlib, re, sys
      exec(open("${pyPrelude}").read())
      exec(open("${shellPrelude}").read())

      # FILE-WIDE: a glyph may be asked about from any file of the shell; each
      # call's argument is narrowed by its parentheses (`shut_at`), and a
      # size's glyph through `Size::glyph`'s own arms (`body_of`).
      icons = json.load(open("${glyphdb.db}/icons.json"))
      faces = []
      for path in ("${fonts.corrected}/TTF-nerdfonts/NoctuaIosevkaNerdFontMono-Regular.ttf",
                   "${marksdb.db}/NoctuaMarks.ttf"):
          face = TTFont(path, lazy=True)
          faces.append((face, face.getBestCmap(), face.getGlyphSet()))

      def across(cp):
          for face, table, shapes in faces:
              if cp in table:
                  pen = BoundsPen(shapes)
                  shapes[table[cp]].draw(pen)
                  if pen.bounds is None:
                      return None
                  em = float(face["head"].unitsPerEm)
                  return [round(pen.bounds[0] / em, 4), round(pen.bounds[2] / em, 4)]
          raise SystemExit(f"U+{cp:05X} is in no face this check knows")

      column = code_of(shell_file("column.rs").read_text())
      floor(len(column), 20000, "characters of column.rs")
      sizes = re.findall(r"tokens::icon::([A-Z_]+)", must(body_of(column, "glyph"), "`column::Size::glyph`"))
      asked = set()
      swept = 0
      for f in sorted(shell_files("**/*.rs")):
          body = code_of(without_tests(f.read_text()))
          swept += 1
          for m in re.finditer(r"\b(?:ink_across|ink_of)\s*\(", body):
              argument = shut_at(body, m.end()).split(",")[0]
              if body[max(0, m.start() - 3):m.start()] == "fn ":
                  continue
              named = re.findall(r"tokens::icon::([A-Z_]+)", argument)
              if re.search(r"\bSize::\w+\.glyph\(\)|\.glyph\(\)", argument):
                  named += sizes
              asked |= set(named)
      floor(swept, 30, "sources of the shell swept for `ink_across`")
      floor(len(asked), 2, "glyphs the shell asks `ink_across` about")
      wrong = []
      for constant in sorted(asked):
          token = constant.lower().replace("_", "-")
          if token not in icons:
              wrong.append(f"`tokens::icon::{constant}` is asked where its ink is, and `{token}` is no icon token")
              continue
          kept = icons[token].get("across")
          fresh = across(icons[token]["codepoint"])
          if kept is None or fresh is None:
              wrong.append(f"`{token}` has no ink across to stand a rule by (kept {kept}, measured {fresh})")
          elif any(abs(a - b) > 0.0001 for a, b in zip(kept, fresh)):
              wrong.append(f"`{token}`'s ink across is kept as {kept} and measures {fresh} on the face")
          else:
              print(f"ok  {token:16s} {icons[token]['glyph']:14s} ink across {fresh[0]:.4f} to {fresh[1]:.4f} of the size")
      for w in wrong:
          print("ERROR: " + w, file=sys.stderr)
      if wrong:
          sys.exit(1)
      print(f"OK: the ink across of the {len(asked)} glyphs a rule is stood by measures as kept")
      PY
    '';

  # The guard of section 6.3: the Nerd Fonts version comes from the FILE ITSELF
  # (nameID 5), not from a constant. If the font is updated without the
  # matching glyphnames.json, the PUA codepoints move silently.
  fonts-nerdfonts-version = mkCheck "fonts-nerdfonts-version" [ py ] ''
    python3 - <<'PY'
    from fontTools.ttLib import TTFont
    import re, sys

    p = "${fonts.corrected}/TTF-nerdfonts/NoctuaIosevkaNerdFontMono-Regular.ttf"
    v = TTFont(p, lazy=True)["name"].getDebugName(5)
    m = re.search(r"Nerd Fonts (\d+\.\d+\.\d+)", v or "")
    if not m:
        print(f"ERROR: nameID 5 does not declare a Nerd Fonts version: {v!r}"); sys.exit(1)

    expected = "3.4.0"   # has to match the flake's `nerd-fonts` input
    if m.group(1) != expected:
        print(f"ERROR: the font has Nerd Fonts {m.group(1)}, the flake pins {expected}.")
        print("      Update the nerd-fonts input along with the font, or the")
        print("      PUA codepoints move with nobody noticing.")
        sys.exit(1)
    print(f"OK: Nerd Fonts {m.group(1)} matches the flake's input")
    PY
  '';

  # The icon table is generated from the REAL SOURCE FILE (section 6.3), never
  # hard-coded. This check proves that the generation happens and that the
  # result matches what the inventory measured.
  icons-table-generated = mkCheck "icons-table-generated" [ pkgs.jq ] ''
    db=${glyphdb.db}

    for f in icons.json glyphs.json coverage.md; do
      test -s "$db/$f" || { echo "ERROR: $f was not generated" >&2; exit 1; }
    done

    n=$(jq 'length' "$db/icons.json")
    echo "icon tokens: $n"
    [ "$n" -ge 40 ] || { echo "ERROR: the icon table is suspiciously small" >&2; exit 1; }

    # Every token has a glyph, a codepoint and a char — and the codepoint is in the PUA.
    jq -e 'to_entries | all(.value | has("glyph") and has("codepoint") and has("char"))' \
      "$db/icons.json" >/dev/null \
      || { echo "ERROR: an incomplete icon entry" >&2; exit 1; }

    g=$(jq 'length' "$db/glyphs.json")
    echo "glyphs indexed: $g"
    [ "$g" -eq 10473 ] || {
      echo "ERROR: expected 10473 Nerd Fonts glyphs, found $g." >&2
      echo "      If the font changed, the inventory in docs/ARCHITECTURE.md" >&2
      echo "      has to be redone before carrying on." >&2
      exit 1
    }

    # The 126 without a name have to stay in the index: dropping them would be
    # lying about what the font has (section 6.5).
    unnamed=$(jq '[.[] | select(.name == null)] | length' "$db/glyphs.json")
    echo "glyphs with no name in glyphnames.json: $unnamed"
    [ "$unnamed" -eq 126 ] || { echo "ERROR: expected 126 with no name" >&2; exit 1; }

    echo "OK: the icon table and the glyph database are generated from the real file"
  '';

  # THE NOTIFICATION CATALOGUE COMES OUT OF NIX, and the two vocabularies agree.
  #
  # `assets/notifications.nix` is the single place every notification and every
  # pre-created filter of the distro is declared (section 4.2). The generator
  # already refuses an invalid field at build time — this is the OTHER half:
  # that the words the generator accepts are the words the Rust knows.
  #
  # They are two lists, in two languages, and nothing but this compares them. A
  # `show = "brief"` the generator accepts and the Rust has never heard of would
  # come out as a table that does not compile — or worse, as a name the Rust
  # spells differently and silently reads as something else.
  notifications-table-generated = mkCheck "notifications-table-generated" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import pathlib, re, sys

    exec(open("${pyPrelude}").read())
    exec(open("${shellPrelude}").read())

    # FILE-WIDE: the generator's sets and the generated table are both
    # module-level. `impl <enum>` and its `id()` are narrowed by `scope` and by
    # name below.
    #
    # `hashless` for the Python generator and `uncommented` for the Rust: every
    # name compared here is a string literal on both sides.
    generator = hashless(pathlib.Path("${../nix/scripts/gen-notifications.py}").read_text())
    table = uncommented(pathlib.Path("${notificationsRs}/notifications.rs").read_text())
    keys = pathlib.Path("${notificationsRs}/keys.txt").read_text().split()
    floor(len(generator), 1000, "characters of gen-notifications.py")
    floor(len(table), 1000, "characters of the generated table")
    floor(len(keys), 20, "keys the catalogue requires")

    failed = False

    # (a) the table was generated, and it is not empty.
    for wanted in ("fn generated_entries()", "fn generated_rules()"):
        if wanted not in table:
            print(f"ERROR: the table has no `{wanted}`")
            failed = True
    entries = table.count("Entry {")
    rules = table.count("Rule {")
    print(f"catalogue: {entries} entries, {rules} filters, {len(keys)} keys required")
    if entries < 1 or rules < 1 or not keys:
        print("ERROR: the generation came out empty or truncated")
        failed = True

    # (b) the vocabularies. The generator names them as sets of strings; the
    #     Rust names them in the `id()` of each enum. Both are parsed from the
    #     SOURCE, so a rename on either side shows up here.
    def from_generator(name):
        m = re.search(name + r" = \{([^}]*)\}", generator)
        assert m, name
        return set(re.findall(r'"([^"]+)"', m.group(1)))

    def from_rust(path, enum):
        """The names in the `id()` of one enum.

        Two levels of narrowing, and both are needed: `presentation.rs` holds
        `Show` AND `Life`, and `rule.rs` holds `Field` AND `Test`, so grabbing
        every arrow in the file gives one enum the other's names.
        """
        src = uncommented(pathlib.Path(path).read_text())
        impl = scope(src, rf"\nimpl {enum}\b")
        if not impl:
            print(f"ERROR: could not find `impl {enum}` in {path}")
            return set()
        fn = body_of(impl, "id")
        if not fn:
            print(f"ERROR: `{enum}` has no `id()` — the name would have no way of going and coming back")
            return set()
        return set(re.findall(r'=> "([^"]+)"', fn))

    NOTIFY = "${../crates/ronoctua-notify/src}"
    pairs = [
        ("SHOW", f"{NOTIFY}/presentation.rs", "Show"),
        ("LIFE", f"{NOTIFY}/presentation.rs", "Life"),
        ("FIELDS", f"{NOTIFY}/rule.rs", "Field"),
        ("PROGRAMS", f"{NOTIFY}/action.rs", "Program"),
    ]
    for name, path, enum in pairs:
        a, b = from_generator(name), from_rust(path, enum)
        if a != b:
            print(f"ERROR: `{name}` differs between the generator and the Rust")
            print(f"       only in the generator: {sorted(a - b)}")
            print(f"       only in the Rust:      {sorted(b - a)}")
            failed = True
        else:
            print(f"ok  {name:10s} {len(a)} identical names on both sides")

    # (c) every text key it demands has the shape the manager derives.
    for k in keys:
        if not re.fullmatch(r"notif-[a-z0-9-]+", k):
            print(f"ERROR: the key `{k}` is outside the `notif-<...>` shape")
            failed = True

    # (d) AND THE TAG THE SHELL STAMPS IS A TAG THE TABLE RECOGNISES.
    #
    # The out-of-memory notification is raised by the shell and recognised by
    # the catalogue through a tag — a string that has to be the same on both
    # sides with no compiler between them. Diverging, the notification arrives
    # as a stranger: quiet, short, with no action and no explanation of why a
    # window disappeared.
    #
    # The tags are one module of the shell's (`tags.rs`): the views that raise
    # them and the footer's events that recognise them both read it.
    tags = uncommented(shell_file("tags.rs").read_text())
    stamped = set(re.findall(r'pub const [A-Z_]+: &str = "([a-z-]+)";', tags))
    floor(len(stamped), 16, "tags stamped by the shell (tags.rs)")
    known = set(re.findall(r'Test::Is\("([a-z-]+)"\.to_owned\(\)\)', table))
    for tag in stamped:
        if tag not in known:
            print(f"ERROR: the shell stamps `{tag}` and no entry recognises it")
            failed = True
    if stamped:
        print(f"ok  tags stamped by the shell and recognised: {sorted(stamped)}")

    if failed:
        sys.exit(1)
    print("OK: the catalogue is generated from the Nix, and the two vocabularies match")
    PY
  '';

  # THE PROGRAMS THE CAPTURE NEEDS COME FROM THE ENVIRONMENT.
  #
  # This check used to be about somebody else's strings: the compositor raised
  # the screenshot notification itself, with its own app name and its own
  # English summary, and our catalogue entry FILTERED on all three. Upstream
  # changing any of them would have stopped the entry matching in silence.
  #
  # THAT HALF IS GONE, because the notification is ours now — this compositor
  # takes no screenshots at all, so `grim` takes the picture and the shell
  # raises the notification with words that were already in every language.
  #
  # WHAT SURVIVES IS THE HALF ABOUT OUR OWN CODE, and it is the half that has
  # actually caught something: three programs reach the shell through the
  # ENVIRONMENT rather than being baked in, and a store path compiled into the
  # binary is a reference no profile switch can remove — it would put the
  # program in every closure, including the minimal profile that has no media
  # at all, and make `ronoctua.media.enable = false` a switch that switches
  # nothing off.
  screenshot-notification-contract = mkCheck "screenshot-notification-contract" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import pathlib, sys
    exec(open("${pyPrelude}").read())
    exec(open("${shellPrelude}").read())

    # FILE-WIDE: the offence is a NAME being absent from a whole
    # file, or present in the wrong one. There is no function to narrow to —
    # `RONOCTUA_GRIM` may be read anywhere in `capture.rs`, and what
    # `nix/rust.nix` must NOT contain it must not contain anywhere. A
    # `body_of` here would pass the day somebody moved the read one function
    # over.
    #
    # PROSE: and the subject IS the words — which name a path arrives under —
    # rather than the shape of any function.
    capture = uncommented(shell_file("capture.rs").read_text())
    built = hashless(pathlib.Path("${../nix/rust.nix}").read_text())
    module = hashless(pathlib.Path("${../nix/modules/scroll.nix}").read_text())
    floor(len(capture), 1000, "characters of capture.rs")
    floor(len(built), 1000, "characters of nix/rust.nix")
    floor(len(module), 1000, "characters of the compositor's module")

    failed = []

    # (a) THE CAPTURE READS ITS PROGRAM FROM THE ENVIRONMENT — in the
    # overlay, which is where the screen is read now.
    if 'std::env::var("RONOCTUA_GRIM")' not in capture:
        failed.append("capture.rs does not read RONOCTUA_GRIM from the environment")

    # (b) AND IT IS NOT BAKED IN. `nix/rust.nix` is the compilation's
    # environment: a name there becomes an `option_env!` and a store
    # reference nothing can remove.
    for baked in ("RONOCTUA_GRIM", "RONOCTUA_SWAPPY"):
        if baked in built:
            failed.append(f"{baked} is in nix/rust.nix; it would be compiled in")

    # (c) AND THE MODULE PUTS THEM THERE, or the feature is offered and does
    # nothing — which is worse than not being offered.
    for given in ("RONOCTUA_GRIM", "RONOCTUA_SCREENSHOTS"):
        if given not in module:
            failed.append(f"{given} is not set by the compositor's module")

    if failed:
        print("ERROR: the capture's plumbing is wrong:", file=sys.stderr)
        for f in failed:
            print(f"  {f}", file=sys.stderr)
        sys.exit(1)
    print("OK: the capture's programs come from the environment, and the module sets them")
    PY
  '';

  # A SWITCH THAT SWITCHES NOTHING OFF HAS TO SAY SO.
  #
  # The trap has a name in `AGENTS.md` — "interruptor que não interrompe" — and
  # the project has paid for it twice: `notoExtra` and `icons.superpack` were
  # both switches that turned nothing off, and the way anybody found out was by
  # measuring the closure.
  #
  # Two fields of the presentation are in that state ON PURPOSE: `vibrate` has
  # no device on a machine like this, and `audio` is not implemented (it is in
  # `docs/PENDING.md`). They exist because the external API the owner is going
  # to put online will set them, and dropping them at the door would make one
  # notification mean different things depending on where it came in.
  #
  # So they are not silent: each is in `ronoctua_notify::INERT` with a text key
  # saying why, the manager draws that next to the switch, and this check makes
  # sure the three lists — the field, the reason, and both `.ftl`s — agree.
  switches-that-do-nothing-say-so = mkCheck "switches-that-do-nothing-say-so" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())
    exec(open("${shellPrelude}").read())

    notify = pathlib.Path("${../crates/ronoctua-notify/src}")
    # FILE-WIDE: `INERT` and the fields of `Presentation` are module-level,
    # and what is asked of each door is whether it draws the reason anywhere.
    #
    # `uncommented` and never `code_of`: a field name and the key that explains
    # it are string literals inside the `INERT` table, and emptying them would
    # leave a check with nothing to read.
    presentation = uncommented((notify / "presentation.rs").read_text())
    manager = uncommented(shell_file("notifications.rs").read_text())
    floor(len(presentation), 500, "characters of presentation.rs")
    floor(len(manager), 1000, "characters of notifications.rs")

    failed = False

    # THE LIST, from the Rust that declares it.
    inert = re.findall(
        r'Inert \{\s*field: "([a-z-]+)",\s*why: "([a-z-]+)",',
        presentation,
    )
    floor(len(inert), 2, "switches declared inert")
    print(f"switches declared inert: {[f for f, _ in inert]}")

    # (a) every one of them is a real field of `Presentation`.
    fields = set(re.findall(r"^    pub ([a-z_]+):", presentation, re.M))
    for field, why in inert:
        if field.replace("-", "_") not in fields:
            print(f"ERROR: `{field}` is not a field of Presentation")
            failed = True
        for language in ${builtins.toJSON languages}:
            ftl = pathlib.Path("${texts}/" + language + ".ftl").read_text()
            if not re.search(rf"^{why} *=", ftl, re.M):
                print(f"ERROR: {language} does not explain `{field}` (`{why}` is missing)")
                failed = True

    # (b) AND THE MANAGER READS THAT LIST, rather than keeping a second one.
    #     Two lists is one more thing to keep in step, and the day they
    #     diverge is the day a switch goes quiet again.
    #
    #     THE COMMENTS DO NOT COUNT. The first version of this test looked for
    #     the name anywhere in the file and passed on a doc link — a check
    #     against the CRITERION and not against the CODE, which is the way
    #     `AGENTS.md` puts it. Only a line that is not a comment answers.
    # The `startswith` test is gone: `uncommented` took the comments off
    # already, and it takes one off the END of a line too.
    reads_it = "ronoctua_notify::INERT" in manager
    if not reads_it:
        print("ERROR: the manager does not read `INERT`; the reason would not reach the screen")
        failed = True
    # (b2) AND IT REACHES THE SCREEN. The reason used to be a third column on
    #      the row; the owner asked for it gone, so it moved to the message
    #      line — which means there has to be something that PUTS it there.
    #      Without this, "removed from the row" and "removed from the system"
    #      look the same to a check. It is `View::note` (the hint line is
    #      `View::hint`, generated from the key table, and the note wins
    #      over it on the same line).
    if "pub fn note(" not in manager:
        print("ERROR: the manager has no way of saying the reason")
        failed = True
    # THE WINDOW draws the view's note on its own line.
    drawn = uncommented(shell_source("notifications_window.rs"))
    floor(len(drawn), 1000, "characters of notifications_window.rs")
    if "manager.note(" not in drawn and "view.note(" not in drawn:
        print("ERROR: the window does not draw the reason on the message line")
        failed = True
    # THE FOOTER'S DOOR IS TWO HALVES now, and both have to be there: the
    # manager's region of the slot host SAYS the reason (`Region::note`, which
    # asks `View::note`), and the FOOTER DRAWS what the shown region says on
    # the line it explains things on — the host asks it (`hosted_note`) and
    # the explanation's chain in `Footer::paint` puts the answer there. A
    # region that says it to a footer that never asks says it to nobody.
    region = uncommented(without_tests(shell_source("notifications_region.rs")))
    floor(len(region), 1000, "characters of notifications_region.rs")
    says = body_of(region, "note")
    if says is None or "view.note(" not in says:
        print("ERROR: the manager's region does not say the reason (`Region::note`)")
        failed = True
    footer = uncommented(without_tests(shell_source("surface.rs")))
    floor(len(footer), 100000, "characters of the footer's module")
    asks = body_of(footer, "hosted_note")
    if asks is None or not re.search(r"\.note\(\s*&", asks):
        print("ERROR: the footer does not ask the shown region what its row has to add (`hosted_note`)")
        failed = True
    painted = must(body_of(footer, "paint"), "`Footer::paint`")
    if not re.search(r"self\.hosted_note\(\)\s*\.map\(\s*\|(\w+)\|\s*vec!\[\s*crate::chrome::Piece::said\(\1\)", painted):
        print("ERROR: the footer does not draw what the shown region has to add on the line it explains things on")
        failed = True

    # (c) and every knob it draws is either inert-with-a-reason or does
    #     something. A knob nobody can find in either list is the defect.
    knobs = set(re.findall(r'Self::(\w+) => "([a-z-]+)",', manager))
    names = {name for _, name in knobs}
    floor(len(names), 4, "knobs the manager draws")
    for field, _ in inert:
        if field not in names:
            print(f"ERROR: `{field}` is inert and the manager does not even draw it")
            failed = True

    if failed:
        sys.exit(1)
    print("OK: every switch with no effect says on screen why it has none")
    PY
  '';

  # THE DOOR TO BLUEZ IS UPSTREAM'S, AND IT IS ALREADY OPEN.
  #
  # BlueZ has no polkit actions: its bus policy lets `context="default"` send
  # to `org.bluez`, and that is the whole door. This check reads the INSTALLED
  # file rather than trusting the sentence — the day a release narrows it, the
  # radio would go quiet with nothing saying why, and this is what says why.
  # It also holds our own side: no module of ours writes a bluez polkit rule
  # (there is nothing to widen), and the crate spawns nothing privileged.
  bluetooth-bus-policy-is-open = mkCheck "bluetooth-bus-policy-is-open" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: what is asked of each of our own files is whether it spawns a
    # privileged program ANYWHERE in it, and whether it asks for a bus name at
    # all. Neither is a question about one function. The bluez policy is XML
    # and is narrowed by its own `<policy>` elements below.
    policy = pathlib.Path(
      "${pkgs.bluez}/share/dbus-1/system.d/bluetooth.conf"
    ).read_text()
    floor(len(policy), 500, "characters of bluez's bus policy")
    wrong = []

    # 1. ANY CLIENT MAY TALK TO THE DAEMON.
    default = re.search(r'<policy context="default">(.*?)</policy>', policy, re.S)
    if not default:
        wrong.append("bluez no longer has a default policy at all")
    elif 'send_destination="org.bluez"' not in default.group(1):
        wrong.append("bluez stopped letting an ordinary client talk to it")

    # 2. AND THE DAEMON MAY CALL BACK INTO AN AGENT OF OURS.
    root = re.search(r'<policy user="root">(.*?)</policy>', policy, re.S)
    if not root or 'send_interface="org.bluez.Agent1"' not in root.group(1):
        wrong.append("bluez may no longer call an agent; pairing would answer nothing")

    # 3. NOTHING OF OURS WIDENS IT, and nothing of ours asks.
    #
    # THE CODE, NOT THE PROSE. Every file here EXPLAINS that it writes no
    # rule and spawns nothing, and a check that read the whole text would
    # fail on the explanation — which is how this one first failed.
    # The hand-written stripper here took a comment off only where it BEGAN a
    # line. `hashless` and `uncommented` are the prelude's, and they take one
    # off the end of a line too.

    modules = pathlib.Path("${../nix/modules}")
    bluetooth = hashless((modules / "bluetooth.nix").read_text())
    floor(len(bluetooth), 200, "characters of nix/modules/bluetooth.nix")
    if "polkit" in bluetooth:
        wrong.append("nix/modules/bluetooth.nix writes a polkit rule")
    if "hardware.bluetooth" not in bluetooth:
        wrong.append("nix/modules/bluetooth.nix does not turn the radio on")
    crate = pathlib.Path("${../crates/ronoctua-bluetooth/src}")
    swept = 0
    for f in sorted(crate.glob("*.rs")):
        # `uncommented` and never `code_of`: the four programs below are named
        # in STRING literals — `Command::new("pkexec")` — and emptying the
        # strings would leave this loop unable to find any of them.
        body = uncommented(f.read_text())
        swept += 1
        for asked in ("pkexec", "pkttyagent", "sudo ", "systemd-run"):
            if asked in body:
                wrong.append(f"{f.name} spawns `{asked.strip()}`")
        # AND THE AGENT ASKS FOR NO NAME: dbus's default policy refuses one,
        # and the error reads exactly like an absent daemon. Two ways to ask
        # — a connection BUILDER carrying `.name`, or `request_name` on a
        # connection — and neither may appear. It looks for the builder and
        # not for the word: a THREAD's name is another thing entirely, and
        # both are spelled `.name(`, which is what the first version of this
        # guard matched — it also matches the four THREAD builders in this crate.
        if "connection::Builder" in body or "request_name" in body:
            wrong.append(f"{f.name} asks for a well-known bus name")

    floor(swept, 3, "sources of ronoctua-bluetooth swept for a privileged call")
    if wrong:
        for w in wrong:
            print("ERROR: " + w, file=sys.stderr)
        sys.exit(1)
    print("OK: bluez's own door is open, and nothing of ours touches it")
    END
  '';

  # THE POWER MODULE WRITES NO POLKIT RULE — the disks' argument, verbatim:
  # logind's and power-profiles-daemon's own actions already answer `yes` to
  # an active session, and a rule of ours could only widen a door that is the
  # right width. Both directions: the module has none, and the four that
  # MUST have one still do.
  power-adds-no-polkit-rule-of-its-own =
    mkCheck "power-adds-no-polkit-rule-of-its-own" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        modules = pathlib.Path("${../nix/modules}")
        # AND EVERY BRAIN MODULE'S NIXOS HALF, which is a module like these and
        # travels in its folder.
        brain_halves = sorted(pathlib.Path("${../crates/ronoctua-brain/modules}").glob("*/module.nix"))
        # FILE-WIDE: a polkit rule anywhere in a module is the offence, and a
        # Nix module has no functions to narrow to. `hashless` is what stops a
        # rule written out in a `#` comment — the shape one is usually left
        # behind in — from reading as a rule.
        power = hashless((modules / "power.nix").read_text())
        floor(len(power), 200, "characters of nix/modules/power.nix")
        wrong = []
        swept = 0

        # 1. THE MODULE ACTUALLY TURNS THE DAEMONS ON.
        for daemon in ("services.upower", "services.power-profiles-daemon"):
            if daemon not in power:
                wrong.append(f"nix/modules/power.nix does not mention {daemon}")

        # 2. AND WRITES NO RULE.
        if "polkit" in power and "extraConfig" in power:
            wrong.append("nix/modules/power.nix writes a polkit rule")

        # 3. NOR DOES ANY OTHER MODULE NAME A LOGIND, UPOWER OR PROFILE ACTION.
        for f in sorted(modules.glob("*.nix")) + brain_halves:
            body = hashless(f.read_text()).lower()
            swept += 1
            for action in ("org.freedesktop.login1.", "org.freedesktop.upower.", "powerprofiles."):
                if action in body and "polkit.addrule" in body and f.name != "rescue.nix":
                    wrong.append(f"{f.name} names a {action} action in a polkit rule")

        # 4. AND THE RULES THAT SHOULD EXIST STILL DO. (The update's moved into
        #    its brain module's folder with it, whose own check reads the rule
        #    as the machine gets it. The file manager's left with its root
        #    helper, which goes through the sudo door now; the security
        #    centre's shields took its place — the one rule that batch added.)
        floor(len(brain_halves), 1, "brain modules' NixOS halves swept")
        for name in ["security.nix", "rescue.nix", "memory.nix", "keyboard.nix"]:
            floor(swept, 10, "modules swept for a power action")
            body = hashless((modules / name).read_text())
            if "polkit.addRule" not in body:
                wrong.append(f"{name} lost the polkit rule it MUST have")

        if wrong:
            for w in wrong:
                print("ERROR: " + w, file=sys.stderr)
            sys.exit(1)
        print("OK: the power module leaves polkit to logind and the profile daemon")
        END
      '';

  # THE FRAGMENT THE COMPOSITOR IS ASKED TO READ, READ BY THE COMPOSITOR.
  #
  # `ronoctua-display` writes `scroll-display.conf` at runtime and the compositor includes
  # it. A fragment the compositor cannot parse does not fail quietly on one monitor: it
  # fails the WHOLE config load, so every other monitor's settings go with it
  # and the person is left with a compositor on its defaults.
  #
  # NOTHING IN RUST CAN CATCH THAT. The grammar is the compositor's, it changes when
  # the compositor changes, and a unit test asserting our own string against our own
  # expectation proves only that we did not change our mind. What proves it is
  # `the compositor validate`, from the SAME binary the session runs.
  #
  # AND THE TEXT COMES OUT OF THE SOURCE, not out of a fixture beside it. The
  # test `the_whole_grammar_comes_out_at_once` already pins the writer's
  # output character for character; lifting that literal is what makes the two
  # halves impossible to drift apart — change the writer and the test's
  # expectation changes, and this validates the new one.
  #
  # THE WHOLE GENERATED CONFIG, READ BY THE COMPOSITOR THAT WILL RUN IT.
  #
  # # Why it exists
  #
  # Because the migration to this compositor shipped TWO defects that every
  # other gate in this repository passed over, and both were found by running
  # this command by hand:
  #
  #   - `bindsym Mod+Left focus left`. `Mod` is not a modifier here — the table
  #     is `Shift Lock Control Ctrl Mod1 Alt Mod2 Mod3 Mod4 Super Mod5`
  #     (`get_modifier_mask_by_name`) — so EVERY chord in the session was
  #     refused, one line at a time, while the leader and the emergency binds
  #     went on working. `nix/compositor-binds.nix` now refuses the prefix
  #     itself, which is earlier; this is what would have caught it anyway.
  #   - `bindsym Super+WheelScrollDown …`, the previous compositor's name for
  #     the wheel. Here it is `button5`.
  #
  # Neither is visible in any source: they are strings that only the
  # compositor's own parser can judge.
  #
  # # Why the failure mode is so quiet
  #
  # Because a bad line does NOT fail the load. `cmd_bindsym` returns
  # `CMD_INVALID` for that line and the rest of the file goes on — so the
  # symptom is one shortcut, or a whole family of them, doing nothing, with the
  # reason in a log nobody opens and in a nag window this distro refuses
  # (invariant 14). That is the defect class with no screen.
  #
  # # Why it runs in a sandbox, when it was written down that it could not
  #
  # `--validate` brings the SERVER up before it reads anything — libseat, a VT,
  # a backend, a renderer — and in a sandbox that ends in a core dump. Two
  # variables remove all of it: `WLR_BACKENDS=headless` takes away the seat and
  # the VT, `WLR_RENDERER=pixman` takes away EGL, GBM and the DRM node. With
  # both, the whole thing costs about ten milliseconds. `XDG_RUNTIME_DIR` still
  # has to exist, and a directory in the build tree is one.
  #
  # AND THE VERDICT IS THE OUTPUT, never `$?` — see
  # `display-fragment-validates`, which carries the measurement: an error
  # inside an `include` never reaches the exit status, because
  # `load_include_configs` returns `void`.
  # ONLY THE COMPOSITION ROOT NAMES THE COMPOSITOR.
  #
  # # What invariant 3 promises
  #
  # *"`ronoctua-scroll` é o ÚNICO crate da árvore que sabe qual compositor é,
  # e nenhum outro o nomeia."* That is the owner's constraint in his own words
  # — *"tudo que desenvolvermos deve funcionar como um contrato independente,
  # ou seja, não deve depender de externos como WMs"* — and a promise like that
  # is worth exactly what enforces it.
  #
  # # What it cost to be untrue
  #
  # Nine places across three crates each opened their own
  # `ronoctua_scroll::Scroll`, so the sentence above described a tree that did
  # not match it. The failure mode is slow and certain: the day a second
  # adapter exists, eight of the nine get updated and one does not, and what
  # that one does is connect to a compositor nobody is running.
  #
  # # What this counts, and what it deliberately does not
  #
  # It counts CONNECTIONS and allows exactly one per program, which is that
  # program's composition root. Everything downstream holds a `dyn Compositor`.
  # A program is its crate, and THE SHELL IS ONE PROGRAM IN MANY CRATES
  # (`_SHELL_CRATE`, the prelude's: `ronoctua-shell`, every
  # `ronoctua-shell-*`, the buffer's PNG camera): counted crate by crate, the
  # 2026-10-12 split would let each of them open its own, one opener in the
  # kit and one in the lifeline, and pass — the very drift this exists for,
  # in a family that grows to some forty crates. So they are counted together,
  # as they were while the shell was one crate.
  #
  # It does NOT count the deeds table (`ronoctua_scroll::deeds`,
  # `ronoctua_scroll::wire`). That is a different kind of naming: the table is
  # generated from `assets/compositor-deeds.nix`, which is OURS, and what is
  # adapter-shaped about it is the command grammar the words are written in.
  # `ronoctua-compositor` owns the `Deed` and the `Arity`; the adapter owns the
  # spelling. Counting it would make the rule refuse the thing it protects.
  only-the-composition-root-names-the-compositor =
    mkCheck "only-the-composition-root-names-the-compositor" [ pkgs.python3 ]
      ''
        python3 - <<'PY'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        # FILE-WIDE: the offence is a connection opened ANYWHERE in a crate, and
        # narrowing to a function is what would miss it — a second one appears in
        # whichever function needed it that day.
        #
        # `code_of` and not `uncommented`: the needle is CODE, and the doc
        # comments beside each root name the very call being counted. A stripper
        # that left comments in would count the prose about the rule as a
        # breach of it.
        root = pathlib.Path("${../crates}")
        OPENS = re.compile(r"ronoctua_scroll::Scroll::(open|connect|connect_at)\b")

        # ONE PROGRAM, ONE ROOT: every shell crate is the shell
        # (`_SHELL_CRATE`, found by name, so a crate split off joins with no
        # edit here), and any other crate is a program of its own.
        SHELL = "the shell (ronoctua-shell, ronoctua-shell-*, ronoctua-render-png)"

        def program_of(crate):
            return SHELL if _SHELL_CRATE.fullmatch(crate) else crate

        seen = {}
        total = 0
        shell_crates_seen = set()
        for f in sorted(root.rglob("*.rs")):
            crate = f.relative_to(root).parts[0]
            # THE ADAPTER ITSELF IS THE EXCEPTION, and it is the whole point:
            # it is where knowing which compositor this is belongs.
            if crate == "ronoctua-scroll":
                continue
            if _SHELL_CRATE.fullmatch(crate):
                shell_crates_seen.add(crate)
            hits = OPENS.findall(code_of(f.read_text()))
            total += len(hits)
            if hits:
                seen.setdefault(program_of(crate), []).append((str(f.relative_to(root)), len(hits)))

        # AND THE SHELL'S CRATES ARE THERE TO BE COUNTED: a family this check
        # stopped recognising would be counted crate by crate again, silently.
        floor(len(shell_crates_seen), 10, "shell crates counted as the shell")

        # A FLOOR, because zero would mean this check had stopped seeing the
        # tree — three crates talk to a compositor and each needs its one root.
        floor(total, 3, "connections opened outside the adapter")

        wrong = []
        for program, files in sorted(seen.items()):
            count = sum(n for _, n in files)
            if count > 1:
                where = ", ".join(f"{q} ({n})" for q, n in files)
                wrong.append(f"{program} opens {count} connections: {where}")

        if wrong:
            print("ERROR: a program names the adapter in more than one place.", file=sys.stderr)
            for w in wrong:
                print(f"  {w}", file=sys.stderr)
            print(file=sys.stderr)
            print("       One per program — the shell's crates are one — and", file=sys.stderr)
            print("       everything below it holds a `dyn Compositor`.", file=sys.stderr)
            print("       Invariant 3 says no crate but the adapter knows which", file=sys.stderr)
            print("       compositor this is; a second opener is how that stops", file=sys.stderr)
            print("       being true.", file=sys.stderr)
            sys.exit(1)

        print(f"OK: {len(seen)} programs reach a compositor, one composition root each"
              f" ({len(shell_crates_seen)} shell crates counted as one)")
        for program, files in sorted(seen.items()):
            print(f"    {program}: {files[0][0]}")
        PY
      '';

  # THE SESSION REACHES ITS TARGET, and every unit on the way RESOLVES.
  #
  # # The defect this exists for, which it has already caught
  #
  # `nix/modules/scroll.nix` reads `ronoctua.scroll` for one line — the unit's
  # `ExecStart` — and the flake was not passing it. Nothing said so for a whole
  # migration, because the thing everybody builds is the CONFIG FILE, and that
  # file never names the binary: `nix build …environment.etc."scroll/config"`
  # forces the text and not the program. The gap appeared only when some other
  # check happened to evaluate a whole system, and then it appeared as
  # `attribute 'scroll' missing` inside `services.dbus.packages`, which names
  # neither the module nor the cause.
  #
  # # Why a check and not a VM
  #
  # Because what broke is EVALUATION, and a VM would have to boot to find it —
  # minutes, for something a forced attribute answers in seconds. The VM tests
  # that do boot a session are the ones that prove it comes UP; this proves
  # there is something to bring up at all.
  #
  # # What it forces
  #
  # The whole chain a login walks: the compositor's unit, the target the
  # compositor's own `exec` starts, and the footer that hangs off it. Each is
  # read to a STRING, because an unforced attribute set is exactly what the
  # missing `scroll` hid behind.
  the-session-reaches-its-target =
    let
      vm = self.nixosConfigurations.vm.config;
      compositor = vm.systemd.user.services.scroll;
      footer = vm.systemd.user.services.ronoctua-footer;
      target = vm.systemd.user.targets.scroll-session;
      # A STORE PATH, forced. `ExecStart` is where the missing package landed,
      # and reading it is what turns "the attribute is absent" from a surprise
      # three modules away into this check's own message.
      started = compositor.serviceConfig.ExecStart;
      footerStarted = footer.serviceConfig.ExecStart;
    in
    mkCheck "the-session-reaches-its-target" [ pkgs.gnugrep ] ''
      # THE COMPOSITOR'S UNIT RUNS THE COMPOSITOR, by store path.
      #
      # A NAME here would be a unit with a minimal PATH looking for a binary
      # that is not on it — the trap `AGENTS.md` records for every spawn in a
      # unit, and the one that left production with no footer at all once.
      case "${started}" in
        /nix/store/*/bin/scroll\ -c\ /etc/scroll/config) ;;
        *)
          echo "ERROR: the compositor's unit does not run a store path:" >&2
          echo "       ${started}" >&2
          exit 1
          ;;
      esac

      # `Type=exec` AND NOT `notify`, which is a measurement rather than a
      # taste: this compositor has no `sd_notify` and no `--session`, so a
      # `notify` unit would sit waiting for a readiness message that never
      # comes and time out. `exec` means "started", which is the most systemd
      # can honestly know here — the rest is the config's own three `exec`
      # lines, which run after the backend, the renderer and the socket.
      if [ "${compositor.serviceConfig.Type}" != "exec" ]; then
        echo "ERROR: the compositor's unit is Type=${compositor.serviceConfig.Type}." >&2
        echo "       It has no sd_notify; anything but \`exec\` waits for a" >&2
        echo "       readiness message that is never sent." >&2
        exit 1
      fi

      # AND THE TARGET THE CONFIG STARTS EXISTS, with a description of its
      # own. A `systemctl --user start` of a target nobody declared succeeds
      # and starts nothing, which is the quietest possible way for a session
      # to come up with no footer.
      if [ -z "${target.description}" ]; then
        echo "ERROR: scroll-session.target has no description; is it declared?" >&2
        exit 1
      fi

      # AND THE CHAIN FROM THE TARGET TO THE FOOTER CLOSES.
      #
      # It is two links, and the first is the one worth writing down.
      # `scroll-session.target` carries `BindsTo=graphical-session.target`,
      # and `BindsTo=` includes the effect of `Requires=` — "if this unit gets
      # activated, the units listed will be activated as well"
      # (systemd.unit(5)) — so the config's `systemctl --user start
      # scroll-session.target` reaches `graphical-session.target` too, with
      # `Before=` putting them in that order. The second link is the footer
      # hanging off whichever of the two.
      #
      # Asserting only the second was this check's own first mistake: it
      # demanded the footer name `scroll-session.target` and called a working
      # chain broken. What matters is that SOMETHING the compositor starts
      # reaches the footer, and the ordering the module documents is real.
      echo "${builtins.concatStringsSep " " target.bindsTo}" | grep -qw "graphical-session.target" || {
        echo "ERROR: scroll-session.target does not bind graphical-session.target." >&2
        echo "       Then starting it reaches nothing: \`BindsTo=\` is what" >&2
        echo "       pulls the second target in, and the footer hangs off that." >&2
        exit 1
      }
      echo "${builtins.concatStringsSep " " footer.wantedBy}" \
        | grep -qE "(scroll-session|graphical-session)\.target" || {
        echo "ERROR: nothing on the compositor's chain starts the footer." >&2
        echo "       It is wanted by: ${builtins.concatStringsSep " " footer.wantedBy}" >&2
        echo "       The session would come up with no modeline, no minibuffer" >&2
        echo "       and no leader — which is what happened once already." >&2
        exit 1
      }

      case "${footerStarted}" in
        /nix/store/*/bin/ronoctua-shell*) ;;
        *)
          echo "ERROR: the footer's unit does not run a store path:" >&2
          echo "       ${footerStarted}" >&2
          exit 1
          ;;
      esac

      echo "OK: the compositor's unit, its target and the footer all resolve"
      echo "    compositor: ${started}"
      echo "    footer:     ${footerStarted}"
    '';

  compositor-config-valid = mkCheck "compositor-config-valid" [ scroll ] ''
    export XDG_RUNTIME_DIR="$PWD/run"
    mkdir -p "$XDG_RUNTIME_DIR"
    export WLR_BACKENDS=headless
    export WLR_RENDERER=pixman

    cp ${self.nixosConfigurations.vm.config.environment.etc."scroll/config".source} config
    chmod +w config

    scroll --validate --config config > said.txt 2>&1 || true
    if grep -q 'Error' said.txt; then
      echo "ERROR: the compositor refused a line of the config it will run." >&2
      echo "       A refused line does not fail the load — it is one" >&2
      echo "       shortcut, or one family of them, doing nothing." >&2
      cat said.txt >&2
      exit 1
    fi

    # AND A BROKEN ONE IS REFUSED, which is the half that makes it a gate.
    # `Mod` is the exact spelling the migration shipped, so the negative
    # half is the defect itself rather than a stand-in for it.
    sed 's/^bindsym --whole-window Super+/bindsym --whole-window Mod+/' config > broken
    sed -i 's/^bindsym --no-repeat Super+/bindsym --no-repeat Mod+/' broken
    sed -i 's/^bindsym Super+/bindsym Mod+/' broken
    if ! grep -q '^bindsym.*Mod+' broken; then
      echo "ERROR: the sabotage changed nothing, so the refusal below would" >&2
      echo "       prove nothing. Has the prefix stopped being \`Super\`?" >&2
      exit 1
    fi
    scroll --validate --config broken > broke.txt 2>&1 || true
    # `Unknown key or button 'Mod'` and not `Unknown modifier`: the parser
    # splits the chord on `+`, fails to find `Mod` in the modifier table, and
    # then tries the last-resort reading — that it is the KEY. Which is the
    # message a person would have to recognise in a log to ever find this.
    if ! grep -q "Unknown key or button 'Mod'" broke.txt; then
      echo "ERROR: the compositor said nothing about \`Mod\`, so the pass" >&2
      echo "       above proves nothing at all." >&2
      cat broke.txt >&2
      exit 1
    fi
    # AND THE NESTED LOOP'S, which is not the same file: its prefix is Alt,
    # and the `Super+Alt+…` shortcuts of the compositor's own configuration
    # take other keys there (`Chord::nested`). A line refused only in the
    # loop would be a shortcut that works installed and does nothing in
    # `.#dev`.
    cp ${devApp.config} nested
    chmod +w nested
    scroll --validate --config nested > nested.txt 2>&1 || true
    if grep -q 'Error' nested.txt; then
      echo "ERROR: the compositor refused a line of the NESTED loop's config." >&2
      cat nested.txt >&2
      exit 1
    fi
    echo "OK: the compositor reads every line of the config it will run, installed and nested"
  '';

  # THE POINTERS FRAGMENT, IN FRONT OF A REAL COMPOSITOR — the sibling of
  # `display-fragment-validates`, and for the same measured reason: an
  # `include` that fails to parse fails in silence (`load_include_configs` is
  # `void`), so a misspelt setting is a device that simply does not take it.
  #
  # What is validated is `every_line_the_writer_can_emit` — every one of the
  # nineteen settings, the seat lines and the header — pinned by the writer's
  # own test, so this reads what `text_of` really emits and not a copy.
  pointers-fragment-validates =
    mkCheck "pointers-fragment-validates"
      [
        pkgs.python3
        scroll
      ]
      ''
        python3 - <<'END'
        import pathlib, sys
        exec(open("${pyPrelude}").read())

        # FILE-WIDE: what is read here is a raw literal pinned inside a test,
        # found by the test's name, and `uncommented` keeps literals —
        # `code_of` would empty the very text being validated.
        source = uncommented(
            pathlib.Path("${../crates/ronoctua-pointers/src}/fragment.rs").read_text()
        )
        floor(len(source), 2000, "characters of the pointers fragment.rs")
        PINNED = "fn every_line_the_writer_can_emit"
        at = source.find(PINNED)
        begin = source.find('r#"', at)
        # FROM PAST THE OPENING: the fragment starts with its `#` header, so
        # `r#"#` itself contains the closing `"#`.
        end = source.find('"#', begin + 3)
        if at < 0 or begin < 0 or end < 0:
            print(f"ERROR: {PINNED} no longer pins a raw literal", file=sys.stderr)
            sys.exit(1)
        text = source[begin + 3 : end]
        # EVERY SPELLING HAS TO BE IN IT, or this validates a file that
        # exercises nothing. The list is `wire::input_command`'s own.
        missing = [
            w
            for w in (
                "focus_follows_mouse ", "hide_cursor ", "when-typing ", " attach ",
                "xcursor_theme ", " events ", "pointer_accel ", "accel_profile ",
                "natural_scroll ", "left_handed ", "scroll_factor ", " tap ",
                "tap_button_map ", " drag ", "drag_lock ", "three_finger_drag ",
                "click_method ", "clickfinger_button_map ", "middle_emulation ",
                "scroll_method ", "scroll_button ", "scroll_button_lock ", " dwt ",
                " dwtp ",
            )
            if w not in text
        ]
        if missing:
            print("ERROR: the pinned fragment does not exercise " + ", ".join(missing), file=sys.stderr)
            sys.exit(1)
        pathlib.Path("fragment.conf").write_text(text)
        print(text)
        END

        export XDG_RUNTIME_DIR="$PWD/run"
        mkdir -p "$XDG_RUNTIME_DIR"
        export WLR_BACKENDS=headless
        export WLR_RENDERER=pixman

        # THE VERDICT IS THE OUTPUT, not the exit status — an include's errors
        # never reach it (see `display-fragment-validates`).
        printf 'include "%s/fragment.conf"\n' "$PWD" > with-fragment.conf
        scroll --validate --config with-fragment.conf > said.txt 2>&1 || true
        if grep -q 'Error' said.txt; then
          echo "ERROR: the compositor REFUSED the fragment the pointer settings write." >&2
          echo "       Every line it could not read is a setting a device never took." >&2
          cat said.txt >&2
          exit 1
        fi

        # AND A BROKEN ONE IS REFUSED. `pointer_accel` is a `strtof` with a
        # range check, so a word there is certainly a refusal.
        sed 's/pointer_accel -0.250/pointer_accel fast/' fragment.conf > broken.conf
        if cmp -s fragment.conf broken.conf; then
          echo "ERROR: the sabotage changed nothing; the refusal below would prove nothing." >&2
          exit 1
        fi
        printf 'include "%s/broken.conf"\n' "$PWD" > with-broken.conf
        scroll --validate --config with-broken.conf > broke.txt 2>&1 || true
        if ! grep -q 'Error' broke.txt; then
          echo "ERROR: the compositor said nothing about a speed that is a word," >&2
          echo "       so the pass above proves nothing at all." >&2
          cat broke.txt >&2
          exit 1
        fi
        echo "OK: the compositor reads every line the pointer settings write, and refuses a broken one"
      '';

  display-fragment-validates =
    mkCheck "display-fragment-validates"
      [
        pkgs.python3
        scroll
      ]
      ''
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        # FILE-WIDE: what is read here is a raw literal pinned inside a test,
        # found by the test's own name — there is no function to narrow to that
        # is not the one already being searched for.
        #
        # `uncommented` and NEVER `code_of`: the payload IS a literal. This
        # check takes the fragment the writer pins and hands it to the compositor, so a
        # stripper that emptied it would validate an empty file and call that
        # a pass.
        source = uncommented(
            pathlib.Path("${../crates/ronoctua-display/src}/fragment.rs").read_text()
        )
        floor(len(source), 2000, "characters of fragment.rs")

        # THE ONE LITERAL, and not every literal that happens to start with
        # `output`. Other tests in that file pin FRAGMENTS of a block — the
        # escaping test pins a name and nothing else — and sweeping those in
        # would validate half a monitor's worth of config and call it proof. The
        # first version of this did exactly that.
        PINNED = "fn the_whole_grammar_comes_out_at_once"
        at = source.find(PINNED)
        if at < 0:
            print(
                f"ERROR: {PINNED} is gone from fragment.rs, so there is no "
                "pinned fragment to validate. That test is where the writer's "
                "output is written down; this check is the compositor reading "
                "it.",
                file=sys.stderr,
            )
            sys.exit(1)
        begin = source.find('r#"', at)
        end = source.find('"#', begin)
        if begin < 0 or end < 0:
            print(f"ERROR: {PINNED} no longer pins a raw literal", file=sys.stderr)
            sys.exit(1)
        text = source[begin + 3 : end] + "\n"

        # AND THE ESCAPED NAME GOES IN TOO, which is the one case where our own
        # expectation proving our own string is worth nothing. `escaped()` is
        # OUR answer to the config's grammar; monitors really are sold with a `"` in
        # the name, and a wrong answer takes the whole configuration load down
        # — every monitor unapplied, from one quote. Only the compositor can
        # say whether that answer is right, and this is the only place it is
        # asked.
        ESCAPED = "fn a_quote_in_a_model_name_cannot_break_the_file"
        at = source.find(ESCAPED)
        if at < 0:
            print(
                f"ERROR: {ESCAPED} is gone, so nothing pins what an escaped "
                "name comes out as.",
                file=sys.stderr,
            )
            sys.exit(1)
        # THE EXPECTATION, not the input: the `out.contains(r#"…"#)` beside it.
        # By FINDS and not a regular expression — the literal is full of quotes
        # and backslashes, which is the whole point of it.
        opens = source.find('assert!(out.contains(r#"', at)
        shuts = source.find('"#', opens + len('assert!(out.contains(r#"'))
        if opens < 0 or shuts < 0:
            print(f"ERROR: {ESCAPED} no longer pins the escaped output", file=sys.stderr)
            sys.exit(1)
        node = source[opens + len('assert!(out.contains(r#"') : shuts]
        text += node + " {\n    enable\n}\n"

        # AND THE HEADER THE WRITER PUTS ON TOP OF ALL OF IT.
        #
        # This check used to validate the BLOCKS and nothing else, and the
        # file `text_of` emits is a header plus those blocks. The header was
        # written with `//` comments — which this compositor does not have. It
        # answered every line with `Unknown/invalid command '//'` and then
        # `Error(s) loading config!`, so every monitor's settings were refused
        # over a comment, on every machine, with nothing saying so: `reload`
        # answers `success` whatever parsed and `scrollnag_command -` refuses
        # the window it would otherwise raise. The blocks were valid the whole
        # time, so this check was green.
        #
        # What is validated now is the file, not a piece of it.
        opens = source.find('String::from(')
        opens = source.find('"', opens)
        shuts = opens + 1
        while True:
            shuts = source.find('"', shuts)
            if shuts < 0 or source[shuts - 1] != "\\":
                break
            shuts += 1
        if opens < 0 or shuts < 0:
            print("ERROR: `text_of` no longer opens with a literal header", file=sys.stderr)
            sys.exit(1)
        # A RUST LITERAL, UNESCAPED: a `\` at the end of a line eats the newline
        # and the indentation after it, and `\n` is a newline.
        header = re.sub(r"\\\n\s*", "", source[opens + 1 : shuts]).replace("\\n", "\n")
        if not header.strip():
            print("ERROR: the header came out empty; it would validate nothing", file=sys.stderr)
            sys.exit(1)
        text = header + text

        pathlib.Path("fragment.conf").write_text(text)

        # EVERY NODE THE WRITER CAN EMIT HAS TO BE IN IT, or this would validate
        # a file that exercises nothing. The list is `text_of`'s own.
        missing = [
            node
            for node in (
                "disable",
                "enable",
                "mode ",
                "scale ",
                "transform ",
                "position ",
                "adaptive_sync ",
            )
            if node not in text
        ]
        if missing:
            print(
                "ERROR: the pinned fragment does not exercise " + ", ".join(missing),
                file=sys.stderr,
            )
            print("       Validating it would prove nothing about them.", file=sys.stderr)
            sys.exit(1)
        print(text)
        END

        # THE SANDBOX'S OWN RUNTIME DIRECTORY. The compositor aborts without
        # one, and on this path it never writes anything into it.
        export XDG_RUNTIME_DIR="$PWD/run"
        mkdir -p "$XDG_RUNTIME_DIR"
        export WLR_BACKENDS=headless
        export WLR_RENDERER=pixman

        # THE VERDICT IS THE OUTPUT AND NOT THE EXIT STATUS, and that is a
        # measurement rather than a preference.
        #
        # `--validate` returns what `load_config` returns, and an INCLUDE never
        # reaches it: `load_include_configs` returns `void` and throws away
        # every `load_include_config` result (`sway/config.c`). Measured — a
        # fragment carrying `scale not-a-number`, included from a main file,
        # prints `Error on line 2 ... Invalid scale.` and then `Error(s)
        # loading config!`, and exits ZERO. A gate on `$?` here would have
        # passed on every broken fragment there can be.
        printf 'include "%s/fragment.conf"\n' "$PWD" > with-fragment.conf
        scroll --validate --config with-fragment.conf > said.txt 2>&1 || true
        if grep -q 'Error' said.txt; then
          echo "ERROR: the compositor REFUSED the fragment the display view writes." >&2
          echo "       Every output line it could not read is a monitor left on" >&2
          echo "       the compositor's own choice, with only a log line." >&2
          cat said.txt >&2
          exit 1
        fi

        # AND A BROKEN ONE IS REFUSED, which is the half that makes it a gate.
        #
        # A SCALE THAT IS NOT A NUMBER, because `output_cmd_scale` is a
        # `strtof` and anything left over after it is `Invalid scale.` — the one
        # mutation of this grammar that is certainly a refusal rather than a
        # value the compositor quietly tolerates. `transform sideways` was
        # tried first and was ACCEPTED, which is exactly why a negative half
        # has to be RUN rather than assumed.
        sed 's/^    scale .*/    scale not-a-number/' fragment.conf > broken.conf
        printf 'include "%s/broken.conf"\n' "$PWD" > with-broken.conf
        scroll --validate --config with-broken.conf > broke.txt 2>&1 || true
        if ! grep -q 'Invalid scale' broke.txt; then
          echo "ERROR: the compositor said nothing about a scale that is not a" >&2
          echo "       number, so the pass above proves nothing at all." >&2
          cat broke.txt >&2
          exit 1
        fi
        echo "OK: the compositor reads the fragment the view writes, and refuses a broken one"
      '';

  # THE TEXT HAS ONE SIZE, AND THE PERSON CAN MOVE IT.
  #
  # `font.size.base` is the ANCHOR the chosen percentage is measured against,
  # not the size to draw at. A site that reads it directly draws at a size
  # nothing can move — and it does so silently: the pixel is right, the layout
  # is right, and the only symptom is one piece of the screen that ignores the
  # setting. That is a defect nobody reports as a defect, which is why it is a
  # check and not a test.
  #
  # It cost every draw call in the shell to make true once. What this stops is
  # the next one — and the count belongs HERE, printed on every build, because
  # three comments elsewhere once carried three different numbers and none of
  # them was right.
  #
  # COMMENTS MAY STILL NAME THE TOKEN — they are ABOUT it, and the story of
  # why there is one size is worth keeping. What may not happen is a line of
  # code reading it.
  #
  # And it checks the other direction too: a check that only forbade would
  # pass on the day somebody deleted the accessor.
  one-text-size = mkCheck "one-text-size" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())
    exec(open("${shellPrelude}").read())

    tokens = pathlib.Path("${../crates/ronoctua-tokens/src}/lib.rs").read_text()
    wrong = []

    # 1. NO CODE LINE IN THE SHELL READS THE ANCHOR.
    #
    # FILE-WIDE: the question is "does any line of any file in the shell read
    # the anchor", which is about the tree and not about one function. The
    # floor below is what keeps it honest — a sweep that stopped finding files
    # would otherwise report nothing wrong.
    #
    # THE PROSE COMES OFF FIRST, and the strings before it. A comment may NAME
    # the anchor — it is about the anchor — and a `//` inside a string literal
    # is not a comment at all: cutting there would hide everything after it,
    # so `let u = "http://x"; let s = SIZE_BASE;` was invisible. `code_of` in
    # the prelude is the one answer to both, and it knows about raw strings
    # and lifetimes besides, which this hand-written one did not.
    def code(line):
        return code_of(line)

    seen_files = 0
    asks = 0
    for f in sorted(shell_files("**/*.rs")):
        seen_files += 1
        body = f.read_text()
        asks += body.count("tokens::text::size()")
        for n, line in enumerate(body.splitlines(), 1):
            # THE BARE NAME TOO. `use ronoctua_tokens::font::{self, SIZE_BASE}`
            # and then `SIZE_BASE` reads the anchor without ever writing the
            # path, which the first version of this let through.
            if re.search(r"\bSIZE_BASE\b", code(line)):
                rest = shell_name(f)
                wrong.append(
                    f"{rest}:{n} draws at `font::SIZE_BASE`, which the person cannot move. "
                    "Ask `ronoctua_tokens::text::size()`."
                )

    floor(seen_files, 30, "files of the shell swept for a fixed size")

    # 2. THE ACCESSOR EXISTS, AND IS THE ANCHOR SCALED.
    if "pub mod text {" not in tokens:
        wrong.append("ronoctua-tokens lost its `text` module")
    if not re.search(r"pub fn scaled\(size: f32\) -> f32 \{\s*size \* f32::from\(percent\(\)\) / 100\.0", tokens):
        wrong.append("`text::scaled` no longer moves a size by the chosen percentage")
    if not re.search(r"pub fn size\(\) -> f32 \{\s*scaled\(super::font::SIZE_BASE\)", tokens):
        wrong.append("`text::size` is no longer the scaled base")
    for name in ("SCALE_FLOOR", "SCALE_CEILING", "SCALE_STEP"):
        if name not in tokens:
            wrong.append(f"`font::{name}` is not read by the tokens crate any more")

    # 3. EVERY OTHER SIZE MOVES WITH IT, and only two files may name one —
    #    the painter's scale and the glyph beside the text (`glyph.rs`, which
    #    was the footer's until every door came to lead a run with a glyph).
    #
    #    `font.size.small` is 15 against a base of 18. Left unscaled it
    #    becomes the TALLER of the two below 84%, a small run takes two cells
    #    instead of one, and a picture loses runs on a grid that has not
    #    changed — measured, thirteen at 100% and eleven at 80%. What proves
    #    the arithmetic is a property test in the shell; what this keeps down
    #    is the number of PLACES a fixed size can be read from at all.
    # THE WHOLE PATH, not the file's name: keyed on the name, a new
    # `src/anywhere/paint.rs` would have been exempt by being called that.
    resolvers = {"paint.rs", "glyph.rs"}
    for f in sorted(shell_files("**/*.rs")):
        body = f.read_text()
        here = str(shell_name(f))
        names = [
            n
            for n, line in enumerate(body.splitlines(), 1)
            if re.search(r"\bfont::SIZE_", code(line))
        ]
        if names and here not in resolvers:
            wrong.append(
                f"{shell_name(f)}:{names[0]} reads a fixed size. Only "
                + " and ".join(sorted(resolvers))
                + " resolve one, and they scale it."
            )
        # AND IN A RESOLVER, EVERY MENTION IS INSIDE A `text::scaled(` CALL.
        # The test was "the file says `text::scaled` somewhere", which a
        # 13 000-line `surface.rs` always does: a bare
        # `const _BIG: f32 = tokens::font::SIZE_XXLARGE;` added to it passed.
        # By PARENTHESES and not by line, because a resolver may spread the
        # call over five of them.
        if names and here in resolvers:
            text = "\n".join(code(l) for l in body.splitlines())
            depth, scaled_at = 0, []
            at = 0
            while at < len(text):
                if text.startswith("text::scaled(", at):
                    at += len("text::scaled(")
                    scaled_at.append(depth)
                    depth += 1
                    continue
                if text[at] == "(":
                    depth += 1
                elif text[at] == ")":
                    depth -= 1
                    if scaled_at and scaled_at[-1] == depth:
                        scaled_at.pop()
                elif text.startswith("font::SIZE_", at) and not scaled_at:
                    line = text.count("\n", 0, at) + 1
                    wrong.append(
                        f"{shell_name(f)}:{line} names a fixed size outside a "
                        "`text::scaled(…)`, so it does not move with the size"
                    )
                at += 1
        if names and "text::scaled" not in body:
            wrong.append(f"{f.name} reads a fixed size and never scales one")

        # AND EVERY DOOR ASKS. Rule 1 forbids reading the ANCHOR; nothing
        # required a door to read the SIZE — so replacing every
        # `tokens::text::size()` in one door with a literal `18.0` passed, and
        # the only net left was the global floor, which has twenty sites of
        # slack against a door that has five. That is the defect this check
        # names in its own error string: "one piece of the screen that ignores
        # the setting".
        #
        # A DOOR IS A FILE WITH A `CompositorHandler`, the same population
        # `every-window-knows-its-scale` sweeps — ten of them, each asking five
        # or six times today, so the rule costs nothing and catches a door that
        # stops.
        # AGAINST THE CODE, not the prose. These two read `body` raw for a
        # round, so a door could replace every real call with a literal and
        # keep a doc line naming the accessor — a check about the CRITERION
        # and not about the CODE, inside a check written to refuse exactly
        # that.
        without_prose = "\n".join(code(l) for l in body.splitlines())
        if "impl CompositorHandler for" in body and "tokens::text::size()" not in without_prose:
            wrong.append(
                f"{f.name} draws a whole door and never asks for the size, so "
                "everything in it ignores the setting"
            )
        # AND EVERY DOOR HEARS THE SIZE MOVE. Asking once at start-up is a door
        # that is right until somebody changes the size, and then wrong beside
        # the nine that are not — which `toolkits.rs` records as the first
        # version of this, and calls "worse than no watch at all". An absent
        # call compiles, which is the shape three other checks in this file
        # exist for.
        # AND A PIXMAP CACHE IS EMPTIED WHERE THE SIZE CHANGES. An `Rgba` is
        # rasterised at a number of PIXELS, and every one of those numbers now
        # comes from `text::size()` — so a cache the size cannot reach keeps
        # the old texture on the GPU, which is the defect the theme's own cache
        # key exists for, on a second axis: a finder opened before a change to
        # 200% and again after it drew 18 px textures over 36 px boxes for the
        # life of the footer.
        #
        # A MAP OF THEM, not any mention: a channel carrying an `Rgba` and a
        # function answering one are not caches, and three files have those.
        #
        # INSIDE THE FUNCTION THAT RESHAPES THE TEXT, not anywhere in the file.
        # The first version asked for a `.clear()` somewhere, and a
        # 13 000-line file always has one — so deleting the real one passed.
        #
        # THE OTHER ANSWER is putting the size in the KEY, which `buffer.rs`
        # does: it has no size reaction to hang a clear on. What proves that
        # half is `the_svg_key_changes_with_the_theme`, which asserts two sizes
        # give two keys and goes red the moment the size leaves the format
        # string — a check cannot tell a key that carries a number from one
        # that names a variable, and a test can.
        #
        # AND A MISSING ANCHOR IS AN ERROR, NOT A SKIP. `at == -1` made `opens`
        # `-1` and the whole rule fell through in silence — so hoisting the
        # call (`let wanted = tokens::text::size(); … t.draw_at(wanted);`),
        # which is an ordinary refactor with no clippy complaint, turned this
        # rule off and the `.clear()` could then simply be deleted.
        if re.search(r"HashMap<[^>]*image::Rgba", without_prose):
            at = without_prose.find("draw_at(tokens::text::size())")
            # THE OTHER ANSWER, AND IT IS THE ONE THE FOOTER USES NOW: the key
            # carries the side. A file that builds its keys through such a
            # function needs no reaction to hang a clear on.
            keyed = any(
                name in without_prose
                for name in ("pixmap_key(", "svg_key(", "thumb_key(")
            )
            if at == -1 and not keyed:
                wrong.append(
                    f"{f.name} caches a rasterised pixmap, does not build its "
                    "key through one of the size-carrying key functions, and "
                    "has no `draw_at(tokens::text::size())` for this rule to "
                    "anchor on — so it was being skipped in silence"
                )
            opens = max(
                without_prose.rfind("\n    fn ", 0, at),
                without_prose.rfind("\n    pub fn ", 0, at),
            ) if at != -1 else -1
            if at != -1 and opens == -1 and not keyed:
                wrong.append(
                    f"{f.name}: the size reaction is not inside a method, so "
                    "this rule cannot read it"
                )
            if opens != -1:
                depth, i, reacts = 0, without_prose.find("{", opens), ""
                j = i
                while j < len(without_prose):
                    if without_prose[j] == "{":
                        depth += 1
                    elif without_prose[j] == "}":
                        depth -= 1
                        if depth == 0:
                            reacts = without_prose[i : j + 1]
                            break
                    j += 1
                if ".clear()" not in reacts and not keyed:
                    wrong.append(
                        f"{f.name} caches a rasterised pixmap and neither empties "
                        "it where the size changes nor keys it by the size"
                    )

        if "impl CompositorHandler for" in body and "toolkits::watch(" not in without_prose:
            wrong.append(
                f"{f.name} never watches `display.json`, so it keeps the size "
                "it started with while the rest of the shell moves"
            )

        # AND NOBODY PASSES A NUMBER WHERE THE SIZE GOES.
        #
        # Rule 3 forbids reading the ANCHOR (`font::SIZE_`) and requires each
        # door to ask for the SIZE at least ONCE — and neither of those reaches
        # a bare `18.0`. So replacing four of a door's five
        # `tokens::text::size()` with a literal left that door mostly ignoring
        # the setting, and the only net was the global floor, which has twenty
        # sites of slack against a door that has five. "One piece of the screen
        # that ignores the setting" is this check's own error string.
        #
        # What CONSUMES a size is a short closed list, and a number is never
        # the right argument to any of them: the whole point is that the number
        # comes from one place.
        for fn in (
            "metrics::line_height",
            "metrics::cell_width",
            "metrics::footer_height",
            "draw_at",
            "text::scaled",
        ):
            for m in re.finditer(
                re.escape(fn) + r"\(\s*([0-9][0-9_]*(?:\.[0-9_]*)?)(?:f32|f64)?\s*\)",
                without_prose,
            ):
                wrong.append(
                    f"{shell_name(f)}: `{fn}({m.group(1)})` puts a number "
                    "where the chosen size goes, so that piece of the screen "
                    "ignores the setting"
                )

    # 3b. AND EVERY PIXMAP CACHE KEY CARRIES THE SIDE.
    #
    #     This is the rule the one above could not state. An `Rgba` is
    #     rasterised at a number of PIXELS and those numbers come from
    #     `text::size()`, so the same picture at 100% and at 200% is two
    #     pictures — and the GPU's own cache (`ronoctua_render::image::Images`)
    #     has NO per-key removal at all: its `clear()` empties the frame's
    #     batch and leaves the textures, its `dump()` only acts above a ceiling
    #     and then keeps what is on screen. Emptying a host-side map therefore
    #     cannot reach it. Only a key it has not seen can.
    #
    #     That is exactly how the first fix here failed: `icons.clear()` was
    #     added, this check's shape rule went green, and the finder went on
    #     drawing 18 px textures stretched into 36 px boxes for the life of the
    #     footer — the sentence the rule above describes, surviving the rule
    #     above.
    for where, fn in (("launch.rs", "pixmap_key"), ("buffer.rs", "svg_key")):
        src = shell_file(where).read_text()
        m = re.search(r"fn " + fn + r"\(([^)]*)\)", "\n".join(code(l) for l in src.splitlines()))
        if not m:
            wrong.append(
                f"{where}: `{fn}` is gone, and it is what puts the size into the "
                "cache key that reaches the GPU"
            )
        elif "side" not in m.group(1):
            wrong.append(
                f"{where}: `{fn}` does not take a side, so one drawing at two "
                "sizes spells one key and the GPU keeps the first — which "
                "nothing downstream can undo"
            )

    # 3c. AND THE SIZE REACHES THE APPLICATIONS THAT ARE NOT OURS.
    #
    #     The size does not stop at our own windows, and the channel it takes
    #     was MEASURED rather than assumed. Two facts decided it, and both are
    #     in the binaries:
    #
    #     - `qgnomeplatform` 0.8.4 subscribes to `changed::font-name`,
    #       `changed::monospace-font-name` and five more on
    #       `org.gnome.desktop.interface` — and NOT to `text-scaling-factor`.
    #       So Qt never followed the multiplier, whatever the `full` profile
    #       paid for its platform theme.
    #     - GTK renders at `points x (gtk-xft-dpi/96)`, and `gtk-xft-dpi` comes
    #       from that same multiplier. So writing BOTH scales GTK twice.
    #
    #     There is no channel that reaches Qt and misses GTK. The size
    #     therefore travels in the font description, the multiplier is reset,
    #     and Ghostty — which reads neither, having a `font-size` of its own —
    #     is given a file. Each of those three is a rule here, because each of
    #     them can be silently undone by one line.
    #     READ WITH THE STRINGS KEPT. `code` above strips string literals as
    #     well as comments — right for the rules that hunt for identifiers, and
    #     wrong here, where the KEY NAMES and the dconf verbs are the evidence.
    #     Comments still go, so a sentence cannot satisfy any of this.
    toolkits = shell_file("toolkits.rs").read_text()
    plain = "\n".join(
        (l if (cut := l.find("//")) < 0 else l[:cut]) for l in toolkits.splitlines()
    )
    for what, why in (
        (
            "font-name",
            "the size no longer travels in the font description, so Qt stops "
            "following it",
        ),
        (
            '"reset", SCALING_KEY',
            "the multiplier is not put back, so GTK scales the font AND the "
            "multiplier — the square of what was asked for",
        ),
        (
            "SIZE_FILE",
            "Ghostty is not told its own size, and it reads neither of the "
            "other two channels",
        ),
        (
            "TERMINAL_POINTS",
            "the terminal's base size is a number written here instead of the "
            "token `nix/modules/terminal.nix` reads, so the two can drift",
        ),
    ):
        if what not in plain:
            wrong.append(f"toolkits.rs no longer names `{what}`: {why}")
    #     AND THE MULTIPLIER IS NEVER WRITTEN AGAIN. Resetting it and then
    #     writing it is the same defect with an extra step.
    if re.search(r'"write",\s*SCALING_KEY', plain):
        wrong.append(
            "toolkits.rs writes the scaling multiplier again; with the size in "
            "the font description that scales GTK twice"
        )

    # 4. ONE SHELL SOURCE SETS THE SIZE, for the reason `theme::set` carries:
    #    it is process-wide and the tests run in parallel, so a second one
    #    changes it under the first — and the failure is a FLAKE, which is the
    #    worst kind to hand somebody.
    setters = len(re.findall(r"\btext::set\(", tokens))
    if setters == 0:
        wrong.append("nothing ever sets the text size, so the range is untested")
    #    IT IS ABOUT TESTS, not about production code. The footer sets the
    #    size when the file says so, and must — the check counts only what
    #    comes AFTER a `#[cfg(test)]`, which is where a racing setter would
    #    be. `src/bin/` is exempt for a different reason: each of those is a
    #    SEPARATE PROCESS with its own atomic, so `render-png`'s `--text`
    #    cannot race anything at all.
    def setters_in_tests(body):
        # FROM THE LAST `#[cfg(test)]`, not the first. This repository puts the
        # test module at the END of a file, and a `#[cfg(test)]` HELPER
        # somewhere above — an ordinary thing in a fourteen-thousand-line
        # source — would otherwise sweep the production setters below it into
        # the count and accuse them of being a second test.
        at = body.rfind("#[cfg(test)]")
        return 0 if at < 0 else len(re.findall(r"\btext::set\(", body[at:]))

    loud = sorted(
        f.name
        for f in shell_files("**/*.rs")
        if "bin/" not in str(shell_name(f)) and setters_in_tests(f.read_text())
    )
    if len(loud) > 1:
        wrong.append(
            "more than one shell TEST sets the text size, and the tests run in "
            "parallel: " + ", ".join(loud)
        )

    # 5. VACUITY. A rename of the accessor would leave this passing over a
    #    shell that reads the anchor everywhere under another name.
    if seen_files < 20:
        wrong.append(f"only {seen_files} shell sources were read; the glob is wrong")
    # THE FLOOR IS CLOSE TO THE REAL COUNT, not a quarter of it: at 60 a
    # regression could delete a fifth of the call sites and still pass. It is
    # a floor and not an equality because adding a draw call is ordinary and
    # should not fail a check about something else.
    if asks < 75:
        wrong.append(
            f"only {asks} sites ask for the size, and the shell asks far more "
            "often than that — something stopped asking"
        )

    if wrong:
        for w in wrong:
            print("ERROR: " + w, file=sys.stderr)
        sys.exit(1)
    print(f"OK: {asks} sites in {seen_files} shell sources ask for one size, and it moves")
    END
  '';

  # THE FRAGMENT'S NAME IS WRITTEN IN FOUR PLACES AND NOTHING TIED THEM.
  #
  # `fragment::FILE` is what the shell WRITES; `nix/modules/scroll.nix` and
  # `nix/dev.nix` are what the compositor INCLUDES; `tests/display-vm.nix`
  # writes its own config with its own copy. Each includes from the directory
  # ITS shell writes to: `ronoctua/` for the system, and `ronoctua-<instance>/`
  # for the development loop, which is a second copy with roots of its own
  # (beecbd6). Renaming the constant left the
  # real machine including a file nobody writes — the feature stops persisting,
  # and every test stays green, because the VM includes its own hand-written
  # line rather than the one the module generates.
  #
  # `display-fragment-validates` cannot see it: it validates the CONTENT.
  # The contract test's syntax gate cannot either: it proves the generated config parses,
  # and an include of a file that is not there is `optional=true` and parses
  # fine. This is the same shape `MOST_SCALE` was given one home for.
  display-fragment-has-one-name = mkCheck "display-fragment-has-one-name" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the name is a module-level constant and the includes are lines
    # of three configuration files. Neither is inside a function.
    #
    # `uncommented` for the Rust, because the NAME is the string literal being
    # read out; `hashless` for the Nix, whose comment is `#`.
    # TWO FRAGMENTS NOW, under the same rule: the screens (`ronoctua-display`)
    # and the pointers (`ronoctua-pointers`). One loop, so the second is held
    # to exactly what the first was — a sibling check copied beside it would
    # be the next thing to drift.

    # THE DIRECTORY IS THE INSTANCE'S (beecbd6), and it is derived from the
    # rule the Rust follows rather than typed here: `ronoctua_xdg::config_dir()`
    # is `<config>/name()`, and `name()` is NAME, or NAME-<instance> when
    # RONOCTUA_INSTANCE is set. The development loop sets it, so ITS compositor
    # must include what ITS footer writes; an include of `ronoctua/` there
    # would read the installed session's file.
    xdg = uncommented(pathlib.Path("${../crates/ronoctua-xdg/src}/lib.rs").read_text())
    floor(len(xdg), 1500, "characters of ronoctua-xdg's lib.rs")
    m = re.search(r'pub const NAME: &str = "([a-z-]+)";', xdg)
    if not m:
        print("ERROR: `ronoctua_xdg::NAME` is not there to build the directory from", file=sys.stderr)
        raise SystemExit(1)
    base = m.group(1)
    if 'format!("{NAME}-{i}")' not in must(body_of(xdg, "name"), "`ronoctua_xdg::name`"):
        print("ERROR: `ronoctua_xdg::name` no longer names an instance NAME-<instance>", file=sys.stderr)
        raise SystemExit(1)
    if "base.join(name())" not in must(body_of(xdg, "config_dir"), "`ronoctua_xdg::config_dir`"):
        print("ERROR: `ronoctua_xdg::config_dir` is no longer `<config>/name()`", file=sys.stderr)
        raise SystemExit(1)
    # The same filter `ronoctua_xdg::instance` applies: a value it refuses
    # falls back to NAME, and the include would name a directory nobody writes.
    instances = re.findall(r"^\s*export RONOCTUA_INSTANCE=([a-z0-9-]{1,16})\s*$",
                           hashless(pathlib.Path("${../nix/dev.nix}").read_text()), re.M)
    if len(instances) != 1:
        print("ERROR: nix/dev.nix must export exactly one RONOCTUA_INSTANCE that"
              " `ronoctua_xdg::instance` accepts, and it exports " + str(instances), file=sys.stderr)
        raise SystemExit(1)

    for crate_label, fragment_rs, lib_rs in (
        ("crates/ronoctua-display", "${../crates/ronoctua-display/src/fragment.rs}", "${../crates/ronoctua-display/src}/lib.rs"),
        ("crates/ronoctua-pointers", "${../crates/ronoctua-pointers/src/fragment.rs}", "${../crates/ronoctua-pointers/src}/lib.rs"),
    ):
        rust = uncommented(pathlib.Path(fragment_rs).read_text())
        floor(len(rust), 200, "characters of fragment.rs")
        m = re.search(r'pub const FILE: &str = "([^"]+)";', rust)
        if not m:
            print("ERROR: `fragment::FILE` is not there to compare against in " + crate_label, file=sys.stderr)
            raise SystemExit(1)
        name = m.group(1)

        # AN `include` LINE, not a mention. `scroll-display.conf` appears in
        # `nix/modules/scroll.nix` twice — once inside an error message and once in
        # the real include — so deleting the include left the compositor reading
        # nothing while this check stayed green on the sentence. Same shape in the
        # VM test, where one of the two is a comment.
        # AND THE LINE IS CODE, NOT PROSE.
        #
        # The header above says "an `include` LINE, not a mention" and then read
        # raw text, so the sentence was not enforced: deleting the real include and
        # leaving `# we used to include scroll-display.conf here` kept this green,
        # which is exactly the state the error message below describes.
        # This was a local `code_of` that took a `#` off each line and handed back
        # a LIST. It is `hashless` now — the prelude's, which answers with text —
        # and the name no longer shadows the Rust-shaped stripper of the same name.

        # AND THE WHOLE PATH, NOT THE BASENAME.
        #
        # `name` is `scroll-display.conf`, and the shell writes it into
        # `ronoctua_store::config_dir()`. An include of the same basename in ANOTHER
        # directory — `~/.config/scroll/` is the plausible one, since the theme
        # fragment lives there — matches on the basename and reads a file nobody
        # writes. So the directory the shell writes to has to be in the line too.
        # THE SEGMENT, JOINED TO THE NAME, and not the word on its own: these
        # lines interpolate `config.ronoctua.user`, so a path through
        # `.config/scroll/` still has "ronoctua" somewhere in it and a bare word
        # test passes over exactly the swap it is meant to catch.
        wrong = []
        for label, path, directory in (
            ("nix/modules/scroll.nix", "${../nix/modules/scroll.nix}", base),
            ("nix/dev.nix", "${../nix/dev.nix}", base + "-" + instances[0]),
            ("tests/display-vm.nix", "${../tests/display-vm.nix}", base),
        ):
            where_written = directory + "/" + name
            lines = [
                l
                for l in hashless(pathlib.Path(path).read_text()).splitlines()
                if "include" in l and name in l
            ]
            if not lines:
                wrong.append(label)
            elif not any(where_written in l for l in lines):
                wrong.append(
                    label + f" (includes `{name}` from a directory that is not the "
                    f"one the shell writes to, which has `{where_written}` in it)"
                )

        # AND THE WRITER USES THE CONSTANT. Proving the constant exists says
        # nothing about the file the shell actually opens: a literal at the one
        # `write_atomically` reproduces the whole defect with every name in place.
        #
        # ASKED OF THE CALL, not of the file. `"fragment::FILE" in crate` is true
        # while the constant is merely MENTIONED — in the read-back one line above
        # the write, or in a comment — so swapping the write itself for a literal
        # left this green, and a later rename then writes one name and includes
        # another. That is the one scenario this whole check exists for.
        crate = code_of(pathlib.Path(lib_rs).read_text())
        floor(len(crate), 2000, crate_label + "'s lib.rs characters")
        writes = re.findall(r"write_atomically\(([^;]*?)\)\s*(?:\.|;|$)", crate, re.S)
        frag = [w for w in writes if "fragment::FILE" in w]
        if not writes:
            wrong.append(crate_label + " (no `write_atomically` to read)")
        elif not frag:
            wrong.append(
                crate_label + " (no `write_atomically` names "
                "`fragment::FILE`, so the fragment is written under some other name)"
            )
        if wrong:
            break
    if wrong:
        print(f"ERROR: the shell writes `{name}` and these do not include it:", file=sys.stderr)
        print("", file=sys.stderr)
        for w in wrong:
            print("       " + w, file=sys.stderr)
        print("", file=sys.stderr)
        print("       A rename that misses one of them leaves the compositor", file=sys.stderr)
        print("       including a file nobody writes: every setting is saved,", file=sys.stderr)
        print("       nothing survives a restart, and no other check can see it", file=sys.stderr)
        print("       — `display-fragment-validates` reads the CONTENT, and", file=sys.stderr)
        print("       the syntax gate is happy with an include of a file", file=sys.stderr)
        print("       that is not there.", file=sys.stderr)
        raise SystemExit(1)

    print(f"OK: `{name}` is the name the shell writes and all three configs include")
    END
  '';

  # THE PANEL'S BRIGHTNESS RULE LANDS, and it is the only privileged door the
  # display feature opens for a BUILT-IN screen. Read out of the evaluated
  # configuration, so the default the module promises is the one the machine
  # gets — the same shape as `power-thresholds-rule-lands` below, and for the
  # same reason: `GROUP=`/`MODE=` do not reach a sysfs attribute, so the rule
  # is a `RUN` of store paths, and getting the TARGET PATH wrong hands nothing
  # over while still looking like a rule.
  #
  # AND THE OTHER HALF OF THE FEATURE: an external monitor answers over I2C,
  # which needs `i2c-dev` loaded. It is checked here because it is the same
  # promise — "the brightness on this screen can be moved" — and because a
  # module that quietly stopped loading it would leave the view saying every
  # external monitor has its brightness on its own buttons.
  #
  # WHAT THIS CANNOT SAY, and `display-vm.nix` is where it is said: that the
  # module READS its own option. Both halves here compare the rule against the
  # same evaluated configuration the module wrote, and the option's default is
  # `users` — so a module that ignored `brightnessGroup` and hardcoded the
  # literal would pass. Proving it read would mean evaluating a second NixOS
  # configuration with an override, which is minutes against this check's
  # milliseconds. The VM node sets `brightnessGroup = "video"` instead, and
  # asserts the rule says so.
  display-brightness-rule-lands =
    let
      rules = self.nixosConfigurations.noctua.config.services.udev.extraRules;
      group = self.nixosConfigurations.noctua.config.ronoctua.display.brightnessGroup;
      i2c = self.nixosConfigurations.noctua.config.hardware.i2c.enable;
      modules = builtins.concatStringsSep " " self.nixosConfigurations.noctua.config.boot.kernelModules;
    in
    mkCheck "display-brightness-rule-lands" [ pkgs.python3 ] ''
      python3 - <<'END'
      import re, sys
      rules = """${rules}"""
      group = "${group}"
      wrong = []

      lines = [l for l in rules.splitlines() if "SUBSYSTEM==\"backlight\"" in l]
      if not lines:
          wrong.append("no udev rule for a backlight")
      for l in lines:
          # A RULE THAT FIRES ON A DEVICE WITHOUT THE FILE runs `chgrp` on a
          # path that is not there, once per boot, for nothing.
          if 'TEST=="brightness"' not in l:
              wrong.append("the backlight rule runs on a device with no `brightness`")
          # `change` AND `add`: a laptop that suspends comes back with the
          # ownership reset, and the symptom is a key that worked this morning.
          if 'ACTION=="add|change"' not in l:
              wrong.append("the backlight rule does not survive a resume")
          target = re.escape("/sys$devpath/brightness")
