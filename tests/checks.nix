  #
  # This mark is the only one in the system whose very existence is a choice,
  # and one of its three settings deliberately draws while everything is WELL —
  # asked for by the owner, and theirs to ask for. What may not change without
  # somebody deciding it is the DEFAULT: a distro whose modeline carries a
  # glyph on a machine where nothing is wrong has given up the rule that line
  # is built on.
  syncthing-mark-is-silent-by-default =
    mkCheck "syncthing-mark-is-silent-by-default"
      [
        pkgs.python3
      ]
      ''
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        crate = pathlib.Path("${../crates/ronoctua-syncthing/src}")
        shell = pathlib.Path("${../crates/ronoctua-shell/src}")
        # FILE-WIDE: the `#[default]` attribute and the footer's call are
        # module-level facts. `shows` and `syncthing_mark` are narrowed by name.
        prefs = code_of((crate / "prefs.rs").read_text())
        floor(len(prefs), 500, "characters of prefs.rs")
        wrong = []

        # 1. THE DEFAULT IS `WhenOff`, and it is derived rather than written out —
        #    so the `#[default]` attribute is the whole of it.
        body = prefs.split("#[cfg(test)]")[0]
        marked = re.findall(r"#\[default\]\s*\n\s*(\w+)", body)
        if marked != ["WhenOff"]:
            wrong.append(f"the default is {marked}, and may only be ['WhenOff']")

        # 2. AND `WhenOff` DRAWS NOTHING WHILE IT IS SYNCING. The arithmetic is one
        #    function; this is what says it did not get turned round.
        shows = body_of(body, "shows")
        if not shows:
            wrong.append("`Mark::shows` went away or changed shape")
        else:
            arms = shows
            floor(len(arms), 40, "characters of `Mark::shows`")
            if "Self::WhenOff => !syncing" not in arms:
                wrong.append("`WhenOff` no longer means `nothing is travelling`")
            if "Self::Never => false" not in arms:
                wrong.append("`Never` no longer means never")

        # 3. AND THE FOOTER ASKS THE PREFERENCE BEFORE IT DRAWS. A modeline that
        #    read the snapshot alone would draw the mark for everybody.
        surface = code_of((shell / "surface.rs").read_text())
        floor(len(surface), 100000, "characters of surface.rs")
        if "self.syncthing_prefs.mark.shows(syncing)" not in surface:
            wrong.append("the footer draws the mark without asking the preference")

        # 4. AND IT WAITS FOR A READING. With no snapshot at all the arithmetic
        #    answered "not syncing" and the mark came on — a glyph for the first
        #    second of every boot, and for ever on a machine where the long poll
        #    never answers. `modeline-vm` measures `segments=0` at rest and is
        #    what caught it; this is the same promise read off the source, so a
        #    rewrite that loses the `?` fails here instead of in a VM ten
        #    minutes later. A service that is genuinely DOWN still draws: the
        #    watching thread sends a snapshot saying so, which is a fact.
        mark = body_of(surface, "syncthing_mark")
        if not mark:
            wrong.append("`syncthing_mark` went away or changed shape")
        elif "self.syncthing_snapshot.as_ref()?" not in mark:
            wrong.append("the mark is drawn before any reading has arrived")
        elif not (
            "Standing::Absent" in mark and "Standing::Unknown" in mark
        ):
            wrong.append(
                "the mark is drawn where it cannot be justified — `Absent` is a "
                "machine that never installed Syncthing (`is-active` answers "
                "`inactive` for one of those too, and only `LoadState` tells them "
                "apart), and `Unknown` is one where systemd could not be asked"
            )

        for w in wrong:
            print(f"ERROR: {w}", file=sys.stderr)
        if wrong:
            raise SystemExit(1)
        print("OK: at its default the mark is drawn only when nothing is travelling")
        END
      '';

  # THE POLKIT RULE IS ONE MILLIMETRE WIDE — `tor-polkit-is-narrow`'s twin.
  #
  # Seven of our modules write a polkit rule and every one of them names ONE
  # unit inside `manage-units` — the census in `polkit-rules-are-the-ones-we-know`
  # is where they are signed for. What each needs beside that census is a check
  # of its own about WHICH unit and WHICH verbs, and this is Syncthing's: one
  # action, two verbs, one unit, one user, and nothing else in the condition.
  #
  # Read from the installed rule and from `ronoctua_syncthing::unit::UNIT`, and
  # compared in BOTH directions, so a rule that grew and a rule that stopped
  # matching the crate each fail.
  syncthing-polkit-is-narrow =
    let
      rules = self.nixosConfigurations.vm.config.security.polkit.extraConfig;
    in
    mkCheck "syncthing-polkit-is-narrow"
      [
        pkgs.python3
        pkgs.gnugrep
      ]
      ''
        crate=${../crates/ronoctua-syncthing/src}/unit.rs
        unit=$(grep -oE 'pub const UNIT: &str = "[^"]+"' "$crate" | grep -oE '"[^"]+"' | tr -d '"')
        [ -n "$unit" ] || { echo "ERROR: the crate does not name the unit" >&2; exit 1; }
        export RONOCTUA_UNIT="$unit"
        export RONOCTUA_USER=${self.nixosConfigurations.vm.config.ronoctua.user}
        cat > rules.js <<'RULES'
        ${rules}
        RULES
        python3 - <<'END'
        import os, re, sys

        unit = os.environ["RONOCTUA_UNIT"]
        user = os.environ["RONOCTUA_USER"]
        text = open("rules.js").read()
        wrong = []

        rules = re.split(r"polkit\.addRule", text)[1:]
        ours = [r for r in rules if unit in r]
        if len(ours) != 1:
            wrong.append(f"{len(ours)} rules mention {unit}; there may be one")

        for rule in ours:
            results = set(re.findall(r"polkit\.Result\.(\w+)", rule))
            if results != {"YES"}:
                wrong.append(f"the rule answers {sorted(results)}, and may only answer YES")

            actions = set(re.findall(r'action\.id\s*==\s*"([^"]+)"', rule))
            if actions != {"org.freedesktop.systemd1.manage-units"}:
                wrong.append(f"the rule is about {sorted(actions)}")

            units = set(re.findall(r'lookup\("unit"\)\s*==\s*"([^"]+)"', rule))
            if units != {unit}:
                wrong.append(f"the rule names the units {sorted(units)}, and may name {unit}")

            # START AND STOP, AND NOTHING WIDER. `restart` and `reload` are
            # wider doors and `enable` survives a reboot — and Syncthing
            # restarts ITSELF over the loopback, with no privilege at all, so
            # there is nothing a wider verb would buy.
            verbs = set(re.findall(r'lookup\("verb"\)\s*==\s*"([^"]+)"', rule))
            if verbs != {"start", "stop"}:
                wrong.append(f"the rule allows the verbs {sorted(verbs)}")

            users = set(re.findall(r'subject\.user\s*==\s*"([^"]+)"', rule))
            if users != {user}:
                wrong.append(f"the rule is for {sorted(users)}, and may be for {user}")

            # AND THE CONDITION IS NOTHING BUT THOSE FOUR TESTS. Every
            # recognised comparison is struck out and what is left has to be
            # punctuation: a surviving word is something nobody audited.
            condition = rule[rule.index("if") : rule.index("return")]
            for pattern in (
                r'action\.id\s*==\s*"[^"]+"',
                r'action\.lookup\("(?:unit|verb)"\)\s*==\s*"[^"]+"',
                r'subject\.user\s*==\s*"[^"]+"',
            ):
                condition = re.sub(pattern, " ", condition)
            leftover = re.findall(r"[A-Za-z_][A-Za-z0-9_.]*", condition)
            leftover = [w for w in leftover if w != "if"]
            if leftover:
                wrong.append(f"the condition also tests {sorted(set(leftover))}")

        for w in wrong:
            print(f"ERROR: {w}", file=sys.stderr)
        if wrong:
            raise SystemExit(1)
        print(f"OK: start and stop of {unit}, for {user}, and nothing else")
        END
      '';

  # EVERY OPTION'S LABEL EXISTS IN BOTH LANGUAGES — `audio-names-have-text`'s
  # twin, and it matters more here: there are a hundred and fifty-one keys and
  # they come out of a generator, so nobody is going to notice one missing by
  # reading. On screen a key nobody wrote draws as `[syncthing-opt-…]`.
  syncthing-options-have-text = mkCheck "syncthing-options-have-text" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    owed = pathlib.Path("${syncthingOptionsRs}/keys.txt").read_text().split()
    root = pathlib.Path("${../assets/i18n}")
    wrong = []

    # FILE-WIDE: a generated list of keys against the catalogues. Neither has
    # a function in it, and `hashless` is what makes a key that was COMMENTED
    # OUT of a `.ftl` count as missing rather than as present.
    floor(len(owed), 100, "option keys the generator owes")

    for ftl in sorted(root.glob("*.ftl")):
        have = set(re.findall(r"^([a-z0-9-]+) *=", hashless(ftl.read_text()), re.M))
        floor(len(have), 500, "keys declared by " + ftl.name)
        for key in owed:
            if key not in have:
                wrong.append(f"{ftl.name} does not carry `{key}`")

    for w in wrong[:20]:
        print(f"ERROR: {w}", file=sys.stderr)
    if len(wrong) > 20:
        print(f"ERROR: … and {len(wrong) - 20} more", file=sys.stderr)
    if wrong:
        raise SystemExit(1)
    print(f"OK: {len(owed)} option keys, in every declared language")
    END
  '';

  # THE MACHINE'S CLOCK, and the three things this person may do to it.
  #
  # # What it catches
  #
  # A door widened past what `ronoctua-clock` actually calls. Upstream's
  # `org.freedesktop.timedate1.policy` answers `auth_admin_keep` to FOUR
  # actions and this system grants three of them; the fourth — `set-local-rtc`
  # — decides whether the hardware clock runs in local time, nothing in this
  # tree asks for it, and adding it would be a door held open for nobody.
  #
  # It reads BOTH SIDES and compares them: the rule the system installs, and
  # the `ACTIONS` constant the crate calls through. An action granted and never
  # called is as much a finding as one called and never granted — the first is
  # width nobody uses, the second is a key that comes back refused.
  # A MARK ANCHORED TO THE BORDER IS DRAWN AT THE BORDER, and found there.
  #
  # # What it catches
  #
  # The grid does not reach the surface's edge: `columns` is
  # `floor(width / cell)`, so between the last cell and the border there is a
  # remainder of nought to one cell, and it changes with the window. A run
  # placed by counting cells from the LEFT therefore sits `cell + remainder`
  # from the border while every mark on the modeline sits an exact cell from
  # it — which is what the owner read beside the glance's countdown, and what
  # `ronoctua_render::Span::edge` exists to end.
  #
  # Both halves are checked, because only both together are the promise: the
  # INK has to carry `edge: true`, and the POINTER has to be asked through
  # `chrome::at_the_edge`. Half of it is worse than neither — the ink moves by
  # the remainder and the hit test does not follow, which is a control that
  # answers a cell away from where it is drawn.
  a-mark-at-the-edge-is-drawn-at-the-edge =
    mkCheck "a-mark-at-the-edge-is-drawn-at-the-edge" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        shell = pathlib.Path("${../crates/ronoctua-shell/src}")
        wrong = []

        # THE PLACEMENT IS ONE FUNCTION, and the pointer's reading is its twin.
        chrome = code_of((shell / "chrome.rs").read_text())
        for name in ("pub const fn from_the_edge", "pub fn at_the_edge"):
            if name not in chrome:
                wrong.append(f"`{name}` is gone from chrome.rs; the placement has no single answer")

        # AND EVERY PIECE PLACED BY IT SAYS SO.
        #
        # The four lines that live above or below the modeline lay their
        # right-hand cluster out from the border. In `world` and `sound` the
        # column IS `from_the_edge(...)`; in `band` and `brain` it travels in a
        # `right`/`start` variable that only ever comes from it. Either way the
        # literal has to carry `edge: true` — and one that does not is a mark that
        # inherits the grid's remainder as a margin.
        EDGE_AT = ("crate::chrome::from_the_edge(", "right,", "start,", "start +")
        seen, anchored = 0, 0
        for name in ("band.rs", "brain.rs", "world.rs", "sound.rs"):
            text = without_tests((shell / name).read_text())
            for m in re.finditer(r"Piece \{", text):
                deep, i = 0, text.index("{", m.start())
                j = i
                while j < len(text):
                    if text[j] == "{":
                        deep += 1
                    elif text[j] == "}":
                        deep -= 1
                        if deep == 0:
                            break
                    j += 1
                body = code_of(text[i : j + 1])
                at = re.search(r"at:\s*([^\n]*)", body)
                if not at:
                    continue
                seen += 1
                from_the_edge = any(w in at.group(1) for w in EDGE_AT)
                says = "edge: true" in body
                if from_the_edge and not says:
                    wrong.append(
                        f"{name}: a piece placed at `{at.group(1).strip()}` does not carry "
                        "`edge: true`, so its ink sits the grid's remainder from the border"
                    )
                if from_the_edge:
                    anchored += 1
                if not from_the_edge and says:
                    wrong.append(
                        f"{name}: a piece placed at `{at.group(1).strip()}` claims `edge: true`, "
                        "which would draw it from the border it was not measured against"
                    )
        floor(seen, 12, "Piece literals read out of the four lines")
        floor(anchored, 4, "pieces anchored to the border")

        # AND THE POINTER IS ASKED THE SAME WAY. `band::at` and `brain::at` are
        # the two that answer a CONTROL, and each has to branch on the piece's own
        # anchoring rather than comparing everything against one reading.
        for name in ("band.rs", "brain.rs"):
            body = body_of(without_tests((shell / name).read_text()), "at") or ""
            floor(len(body), 60, f"characters of {name}'s hit test")
            if "p.edge" not in body:
                wrong.append(f"{name}: `at` does not read the piece's own anchoring")
            if "from_the_edge" not in body:
                wrong.append(f"{name}: `at` is not given the cell counted from the border")

        # AND THE DOOR HANDS BOTH READINGS OVER.
        surface = code_of((shell / "surface.rs").read_text())
        if "at_the_edge(" not in surface:
            wrong.append("surface.rs: the pointer is never resolved from the border")
        if surface.count("piece.edge") < 3:
            wrong.append("surface.rs: a line paints its pieces without their own anchoring")

        if wrong:
            print("ERROR: a mark anchored to the border is not drawn or not found there.", file=sys.stderr)
            print("", file=sys.stderr)
            for w in wrong:
                print("       " + w, file=sys.stderr)
            print("", file=sys.stderr)
            print("       `columns` is floor(width / cell), so the last cell does not", file=sys.stderr)
            print("       touch the border. One function says where a run anchored", file=sys.stderr)
            print("       there begins and its twin reads the pointer the same way;", file=sys.stderr)
            print("       both doors have to read the same answer.", file=sys.stderr)
            raise SystemExit(1)

        print(f"OK: {anchored} of {seen} pieces anchored to the border, and found there")
        END
      '';

  # A PLACE'S GROUND IS BUILT IN ONE PLACE, and it is where the air is spent.
  #
  # # What it catches
  #
  # A second `Stripe` built by hand. The ground used to begin exactly where
  # the first letter began and run on to wherever the next place started — so
  # every place had nothing on the left and two cells on the right, and the
  # LAST one had the whole rest of the bar. The owner measured it.
  #
  # The arithmetic itself is held by `a_grounds_air_is_the_same_on_both_sides`,
  # which reads what `line` actually produced. What this holds is that there is
  # only ONE arithmetic to be right about: a literal written beside the call is
  # a second answer, and it is exactly how the first one got there.
  a-glance-stripe-has-equal-air = mkCheck "a-glance-stripe-has-equal-air" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    text = without_tests(pathlib.Path("${../crates/ronoctua-shell/src}/world.rs").read_text())
    code = code_of(text)
    wrong = []

    # ONE CONSTRUCTOR, and the air is inside it.
    round_of = body_of(text, "round") or ""
    floor(len(round_of), 60, "characters of the ground's constructor")
    if "GLANCE_AIR" not in round_of:
        wrong.append("`Stripe::round` no longer spends `space.glance.air`")
    if code.count("GLANCE_AIR") != round_of.count("GLANCE_AIR"):
        wrong.append("the air is spent somewhere other than `Stripe::round`")

    # AND NOBODY BUILDS ONE BY HAND. The constructor writes `Self { … }`, so
    # a `Stripe { … }` anywhere in this file is a ground built beside it —
    # which is a second arithmetic, and is exactly how the first one came to
    # have no air on the left at all.
    # NOT the declaration and not the `impl`: what is looked for is a
    # CONSTRUCTION, which is the name with no `struct` or `impl` in front.
    literals = len(re.findall(r"(?<!struct )(?<!impl )\bStripe\s*\{", code))
    if literals:
        wrong.append(
            f"{literals} `Stripe` literal(s) are built outside `Stripe::round`, "
            "so their air is a second arithmetic"
        )
    floor(len(re.findall(r"\bSelf\s*\{", code_of(round_of))), 1, "grounds built by the constructor")
    if "Stripe::round(" not in code:
        wrong.append("`line` no longer builds its grounds through `Stripe::round`")

    if wrong:
        print("ERROR: the glance's grounds do not all come from one arithmetic.", file=sys.stderr)
        print("", file=sys.stderr)
        for w in wrong:
            print("       " + w, file=sys.stderr)
        raise SystemExit(1)

    print("OK: one constructor, and the air is spent inside it")
    END
  '';

  # AN EXPLANATION WRAPS; IT IS NOT CUT.
  #
  # # What it catches
  #
  # `elide_end` in the note builder of `LEADER s l`. These sentences are the
  # part of that screen that says what a setting does and WHERE it takes
  # effect, and the half an ellipsis takes is always the end — which is where
  # the consequence is. The owner asked for them to break instead, in both
  # doors, and both doors get it for nothing because a wrapped note is simply
  # more rows.
  a-note-is-wrapped-and-not-cut = mkCheck "a-note-is-wrapped-and-not-cut" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, sys
    exec(open("${pyPrelude}").read())

    root = pathlib.Path("${../crates/ronoctua-shell/src}")
    wrong = []

    # THE ONE FUNCTION THE SEVEN VIEWS SHARE. A ceiling and a wrap, and the
    # answer is never empty — see `chrome::note_lines`.
    chrome = code_of(body_of(without_tests((root / "chrome.rs").read_text()), "note_lines") or "")
    floor(len(chrome), 60, "characters of the note wrapper")
    if "layout::wrap(" not in chrome:
        wrong.append("chrome::note_lines does not wrap")

    # EVERY LABEL-AND-VALUE VIEW, and the door or doors onto its note builder.
    # The file, the builder, and the names that must reach it. `display.rs` was
    # the eighth and was not on the list of six that this was written for: it
    # cuts the sentence the screen exists to draw on the worst day, *"The
    # compositor could not read its configuration…"*.
    views = {
        "locale.rs": ("sentence", ["note", "note_with"]),
        "audio.rs": ("said", ["note", "aside"]),
        "power.rs": ("sentence", ["note"]),
        "bluetooth.rs": ("sentence", ["note"]),
        "network.rs": ("sentence_coloured", ["note", "sentence"]),
        "syncthing.rs": ("said", ["note"]),
        "geo.rs": ("sentence", ["note"]),
        "display.rs": ("told", ["note"]),
    }
    for name, (builder, doors) in views.items():
        # `code_of` ON EACH BODY, and never the raw file: these files discuss
        # `elide_end` at length, and a check that searched their comments would
        # be answered by the paragraph explaining why it is gone.
        text = without_tests((root / name).read_text())
        body = code_of(body_of(text, builder) or "")
        floor(len(body), 60, f"characters of {name}'s note builder")
        if "note_lines(" not in body:
            wrong.append(f"{name}: `{builder}` does not go through chrome::note_lines")
        if "elide_end" in body:
            wrong.append(f"{name}: `{builder}` still cuts with an ellipsis")
        # AND EVERY NOTE GOES THROUGH IT. A row pushed beside the builder is a
        # second way to draw a sentence — which is how one of them comes to be
        # cut again.
        for door in doors:
            one = code_of(body_of(text, door) or "")
            floor(len(one), 20, f"characters of {name}'s `{door}`")
            if f"self.{builder}(" not in one and not any(
                f"self.{other}(" in one for other in [builder] + doors
            ):
                wrong.append(f"{name}: `{door}` does not go through the note builder")

    if wrong:
        print("ERROR: an explanation is cut rather than wrapped.", file=sys.stderr)
        print("", file=sys.stderr)
        for w in wrong:
            print("       " + w, file=sys.stderr)
        print("", file=sys.stderr)
        print("       Half a sentence is worse than none: what the ellipsis takes", file=sys.stderr)
        print("       is the end, which is where the consequence is.", file=sys.stderr)
        raise SystemExit(1)

    print(f"OK: {len(views)} label-and-value views wrap their notes, in both doors")
    END
  '';

  # THE PHOTO BATTERY'S SCRIPT FITS IN ONE KERNEL ARGUMENT.
  #
  # # What it catches, and it is MUTE without this
  #
  # The whole of `nix/shots.nix`'s Python reaches the builder as ONE
  # environment variable, and `execve` caps a single argument or variable at
  # `MAX_ARG_STRLEN` — 128 KiB, a constant of the kernel and not of Nix. Past
  # it the build dies with
  #
  #     error: executing '…/bash': Argument list too long
  #
  # which names neither the file, nor the variable, nor the size. It was met
  # while adding the glance's scene: 131 779 bytes against 131 072, over by
  # seven hundred, after a delivery that had nothing to do with any of it.
  #
  # # What to do when it trips
  #
  # MOVE THE PROSE, not the assertions. Half that script is comments, and they
  # are the repository's reasons — but a scene's reasons belong beside its id
  # in `nix/shots-scenes.nix`, which is Nix and never reaches the kernel. That
  # move bought three kilobytes the day this check was written.
  #
  # The margin is ONE KILOBYTE because that is what is left. It is about a
  # paragraph, which is the right unit of warning: the next paragraph is the
  # one that would have broken it.
  the-shots-script-fits-in-an-argument =
    let
      script = self.packages.${pkgs.stdenv.hostPlatform.system}.shots.driver.testScript;
    in
    mkCheck "the-shots-script-fits-in-an-argument" [ pkgs.python3 ] ''
      cat > script.py <<'SCRIPT'
      ${script}
      SCRIPT
      python3 - <<'END'
      import pathlib, sys

      # THE HEREDOC ABOVE IS INDENTED BY NIX, so the size is measured on the
      # eval'd string and not on this copy: what matters is the byte count of
      # what goes into the environment.
      size = len(pathlib.Path("script.py").read_bytes())

      # `MAX_ARG_STRLEN` — 32 pages, and a page is 4 KiB on every platform this
      # builds for. Written out because the kernel does not export it and
      # nothing in the failure says it.
      WALL = 32 * 4096
      MARGIN = 1024

      if size > WALL - MARGIN:
          print(
              f"ERROR: the photo battery's script is {size} bytes, and one kernel "
              f"argument holds {WALL}.",
              file=sys.stderr,
          )
          print("", file=sys.stderr)
          print("       Past that the build dies with `Argument list too long`,", file=sys.stderr)
          print("       naming neither the file nor the variable nor the size.", file=sys.stderr)
          print("", file=sys.stderr)
          print("       Half that script is comments. A scene's reasons belong", file=sys.stderr)
          print("       beside its id in nix/shots-scenes.nix, which is Nix and", file=sys.stderr)
          print("       never reaches the kernel; move them there.", file=sys.stderr)
          raise SystemExit(1)

      print(f"OK: {size} bytes of script, {WALL - size} under one kernel argument")
      END
    '';

  timedate-polkit-is-narrow =
    let
      rules = self.nixosConfigurations.vm.config.security.polkit.extraConfig;
    in
    mkCheck "timedate-polkit-is-narrow" [ pkgs.python3 ] ''
      export RONOCTUA_USER=${self.nixosConfigurations.vm.config.ronoctua.user}
      cat > rules.js <<'RULES'
      ${rules}
      RULES
      python3 - <<'END'
      import os, pathlib, re, sys
      exec(open("${pyPrelude}").read())

      user = os.environ["RONOCTUA_USER"]
      # FILE-WIDE: the merged rules of the whole system are one JavaScript
      # file with no function of ours to narrow to; each rule is taken out
      # below by splitting at `polkit.addRule`.
      text = pathlib.Path("rules.js").read_text()
      floor(len(text), 500, "characters of the merged polkit rules")
      wrong = []

      # FILE-WIDE: the proxy module is one `pub const ACTIONS` and a trait;
      # what is looked for is every action id it names, which is the whole of
      # what it may reach through the rule.
      # WHAT THE CRATE CALLS. `uncommented` and never `code_of`: these are
      # STRING literals, and emptying them would leave a check comparing two
      # empty sets and calling them agreed.
      crate = uncommented(pathlib.Path("${../crates/ronoctua-clock/src}/timedate.rs").read_text())
      called = set(re.findall(r'"(org\.freedesktop\.timedate1\.[a-z-]+)"', crate))
      floor(len(called), 3, "actions named by the crate")

      # AND WHAT THE SYSTEM GRANTS. Every rule of the whole configuration,
      # split at `polkit.addRule`; the ones that mention timedated are ours.
      rules = re.split(r"polkit\.addRule", text)[1:]
      ours = [r for r in rules if "timedate1" in r]
      if len(ours) != 1:
          wrong.append(f"{len(ours)} rules mention timedated; there may be one")

      for rule in ours:
          # 1. THE RESULT. With no polkit agent in this session, `AUTH_*` is a
          #    refusal that looks like a bug; `YES` is the only answer that
          #    works, and it is the one that has to be narrow.
          results = set(re.findall(r"polkit\.Result\.(\w+)", rule))
          if results != {"YES"}:
              wrong.append(f"the rule answers {sorted(results)}, and may only answer YES")

          # 2. THE ACTIONS, against what the crate calls — both directions.
          granted = set(re.findall(r'action\.id\s*==\s*"([^"]+)"', rule))
          for extra in sorted(granted - called):
              wrong.append(f"granted and never called: {extra}")
          for missing in sorted(called - granted):
              wrong.append(f"called and never granted: {missing}")
          if "org.freedesktop.timedate1.set-local-rtc" in granted:
              wrong.append("set-local-rtc is granted, and nothing in this tree asks for it")

          # 3. THE USER — one, and ours.
          users = set(re.findall(r'subject\.user\s*==\s*"([^"]+)"', rule))
          if users != {user}:
              wrong.append(f"the rule is for {sorted(users)}, and may be for {user}")

          # 4. AND THE CONDITION IS NOTHING BUT THOSE TWO TESTS.
          #
          #    The sets above say WHICH literals appear; this says nothing ELSE
          #    does — a `subject.local`, an `isInGroup`, a second action family.
          #    Every recognised comparison is struck out and what is left has
          #    to be punctuation.
          body = re.search(r"if\s*\((.*?)\)\s*\{", rule, re.S)
          if not body:
              wrong.append("the rule has no condition at all")
          else:
              left = body.group(1)
              for known in (
                  r'action\.id\s*==\s*"[^"]+"',
                  r'subject\.user\s*==\s*"[^"]+"',
              ):
                  left = re.sub(known, "", left)
              leftover = re.sub(r"[\s()&|]", "", left)
              if leftover:
                  wrong.append(f"the condition tests something else as well: {leftover!r}")

      if wrong:
          print("ERROR: the clock's polkit rule is not narrow.", file=sys.stderr)
          print("", file=sys.stderr)
          for w in wrong:
              print("       " + w, file=sys.stderr)
          print("", file=sys.stderr)
          print("       There is no polkit agent in this session, so the rule answers", file=sys.stderr)
          print("       YES and never asks. What buys that width back is that the door", file=sys.stderr)
          print("       is exactly as wide as ronoctua-clock reaches through it.", file=sys.stderr)
          raise SystemExit(1)

      print(f"OK: one rule, {len(called)} actions, {user}, and YES")
      END
    '';

  tor-polkit-is-narrow =
    let
      # The merged rule text of the real system, and the crate's unit name.
      rules = self.nixosConfigurations.vm.config.security.polkit.extraConfig;
    in
    mkCheck "tor-polkit-is-narrow"
      [
        pkgs.python3
        pkgs.gnugrep
      ]
      ''
        crate=${../crates/ronoctua-tunnel/src}/tor.rs
        unit=$(grep -oE 'pub const UNIT: &str = "[^"]+"' "$crate" | grep -oE '"[^"]+"' | tr -d '"')
        [ -n "$unit" ] || { echo "ERROR: the crate does not name the unit" >&2; exit 1; }
        export RONOCTUA_UNIT="$unit"
        export RONOCTUA_USER=${self.nixosConfigurations.vm.config.ronoctua.user}
        cat > rules.js <<'RULES'
        ${rules}
        RULES
        python3 - <<'END'
        import os, re, sys

        unit = os.environ["RONOCTUA_UNIT"]
        user = os.environ["RONOCTUA_USER"]
        text = open("rules.js").read()
        wrong = []

        # EVERY RULE OF THE WHOLE SYSTEM, split at `polkit.addRule`. The one
        # about `manage-units` is the one this check is about; any OTHER rule
        # that mentions our unit is a second door nobody audited.
        rules = re.split(r"polkit\.addRule", text)[1:]
        ours = [r for r in rules if unit in r]
        if len(ours) != 1:
            wrong.append(f"{len(ours)} rules mention {unit}; there may be one")

        for rule in ours:
            # 1. THE RESULT. In a session with no polkit agent, `AUTH_*` is a
            #    refusal that looks like a bug; `YES` is the only answer that
            #    works, and it is the one that has to be narrow.
            results = set(re.findall(r"polkit\.Result\.(\w+)", rule))
            if results != {"YES"}:
                wrong.append(f"the rule answers {sorted(results)}, and may only answer YES")

            # 2. THE ACTION.
            actions = set(re.findall(r'action\.id\s*==\s*"([^"]+)"', rule))
            if actions != {"org.freedesktop.systemd1.manage-units"}:
                wrong.append(f"the rule is about {sorted(actions)}")

            # 3. THE UNITS — every literal compared against `unit`, and there
            #    is one.
            units = set(re.findall(r'lookup\("unit"\)\s*==\s*"([^"]+)"', rule))
            if units != {unit}:
                wrong.append(f"the rule names the units {sorted(units)}, and may name {unit}")

            # 4. THE VERBS — exactly start and stop. `restart`, `reload` and
            #    `enable` are wider doors, and `enable` survives a reboot.
            verbs = set(re.findall(r'lookup\("verb"\)\s*==\s*"([^"]+)"', rule))
            if verbs != {"start", "stop"}:
                wrong.append(f"the rule allows the verbs {sorted(verbs)}")

            # 5. THE USER — one, and ours.
            users = set(re.findall(r'subject\.user\s*==\s*"([^"]+)"', rule))
            if users != {user}:
                wrong.append(f"the rule is for {sorted(users)}, and may be for {user}")

            # 6. AND THE CONDITION IS NOTHING BUT THOSE FOUR TESTS.
            #
            #    The four sets above say WHICH literals appear; this says that
            #    nothing ELSE appears — a `subject.local`, a second action, a
            #    group, an `isInGroup`. Every recognised comparison is struck
            #    out and what is left has to be punctuation: if a word
            #    survives, something was added that nobody audited.
            #
            #    It is written this way because "no `||`" is not the rule —
            #    the two verbs are legitimately one — and a check that
            #    forbade the shape rather than the WIDTH would have to be
            #    turned off the day a second verb is wanted.
            body = re.search(r"if\s*\((.*?)\)\s*\{", rule, re.S)
            if not body:
                wrong.append("the rule has no condition at all")
            else:
                left = body.group(1)
                for known in (
                    r'action\.id\s*==\s*"[^"]+"',
                    r'action\.lookup\("verb"\)\s*==\s*"[^"]+"',
                    r'action\.lookup\("unit"\)\s*==\s*"[^"]+"',
                    r'subject\.user\s*==\s*"[^"]+"',
                ):
                    left = re.sub(known, "", left)
                leftover = re.sub(r"[\s()&|]", "", left)
                if leftover:
                    wrong.append(f"the condition tests something else as well: {leftover!r}")

        # AND THE MODULE STILL KEEPS TOR OFF AT BOOT, and does not proxy the
        # whole system — the two decisions the rule's width rests on.
        module = open("${../nix/modules/tor.nix}").read()
        if "wantedBy = lib.mkIf (!cfg.autostart)" not in module:
            wrong.append("the module no longer keeps Tor off at boot by default")
        if re.search(r"transparent\s*=\s*true", module):
            wrong.append("the module turns on transparent proxying")

        if wrong:
            print("ERROR: the one polkit rule this system adds is not narrow.", file=sys.stderr)
            print("", file=sys.stderr)
            for w in wrong:
                print("       " + w, file=sys.stderr)
            print("", file=sys.stderr)
            print("       There is no polkit agent in this session, so the rule answers", file=sys.stderr)
            print("       YES and never asks. What buys that width back is that the door", file=sys.stderr)
            print("       is one millimetre wide: one unit, two verbs, one user.", file=sys.stderr)
            raise SystemExit(1)

        print(f"OK: one rule, {unit}, the verbs start and stop, {user}, and YES")
        END
      '';

  # THE HOST'S LIBRARIES NEVER GO ON `LD_LIBRARY_PATH` — except for NVIDIA.
  #
  # `LD_LIBRARY_PATH` beats `DT_RUNPATH`, so a directory put there to reach ONE
  # library brings every other library in it. `/usr/lib64` was put there for the
  # host's `libEGL.so.1`, and `libc.so.6` came along — and the process then ran
  # the host's libc against Nix's `ld.so`. glibc's `GLIBC_PRIVATE` symbols only
  # match between a `libc.so.6` and the `ld.so` of the SAME build, so the day the
  # host's glibc moved, `nix run .#dev` died with:
  #
  #   the compositor: symbol lookup error: /usr/lib64/libc.so.6:
  #         undefined symbol: __pointer_chk_guard, version GLIBC_PRIVATE
  #
  # Measured then: host 2.44, Nix 2.42, the symbol absent from the host's. There
  # is no version to juggle — the fix is not to put the host's libraries there,
  # and for AMD and Intel that costs nothing, because what talks to the card is
  # the KERNEL driver and mesa is a userspace library Nix has a copy of.
  #
  # NVIDIA is the one real exception: its blob has to match its kernel module.
  # That branch is allowed, and it prints what it is doing.
  graphics-does-not-mix-libc =
    mkCheck "graphics-does-not-mix-libc"
      [
        pkgs.gnugrep
        pkgs.gawk
        pkgs.coreutils
      ]
      ''
        script=${devApp}/bin/ronoctua-dev
        failed=0

        # THE ORDINARY PATH EXISTS: a check that only forbids goes green on a
        # script that stopped setting up graphics at all.
        grep -q 'ronoctua-graphics/lib' "$script" || {
          echo "ERROR: the loop does not put Nix's mesa on LD_LIBRARY_PATH." >&2
          echo "      Without it the compositor comes up with no EGL and dies with DisplayNotSupported." >&2
          failed=1
        }

        # AND EVERY MENTION OF THE HOST'S LIBRARIES IS INSIDE THE NVIDIA BRANCH.
        #
        # The block is cut out and what is left must not mention `/usr/lib` at
        # all. Grepping for the branch's presence would not do: the branch could
        # be there and a second export outside it.
        outside=$(awk '
          /if \[ "\$only_nvidia" = yes \]/ { inside = 1 }
          inside && /^      fi$/ { inside = 0; next }
          !inside { print }
        ' "$script" | grep -n '/usr/lib' || true)
        if [ -n "$outside" ]; then
          echo "ERROR: the loop puts a HOST library on the path outside the NVIDIA branch:" >&2
          echo "$outside" >&2
          echo "      The host's libc goes with it, and it does not match Nix's ld.so." >&2
          failed=1
        fi

        [ "$failed" = 0 ] || exit 1
        echo "OK: the driver comes from Nix, and the host's only on the NVIDIA branch"
      '';

  # THE GENERATED MIME TABLE IS A BUILD INPUT, AND STAYS ONE.
  #
  # `nix/mimegen.nix` turns freedesktop's 125 KB of data into a Rust table at
  # BUILD time. What must never happen is that derivation becoming a runtime
  # reference — which is what an `option_env!` holding its path, or a crate
  # that decided to read `share/mime` directly, would do. The trap `AGENTS.md`
  # records: a derivation references what its BYTES cite.
  #
  # WHAT THIS CHECK DOES NOT CLAIM, and the first version of it did.
  #
  # It used to forbid `shared-mime-info` from the closure outright, and that
  # was a check written against what its author hoped instead of against what
  # it can prove — the mistake this file's own header names. The package is in
  # the shell's closure and was there before the file manager existed:
  # `RONOCTUA_XDG_OPEN` points at `xdg-utils`, and `xdg-open` needs the
  # database to know what opens what. Measured with `nix why-depends`, not
  # assumed:
  #
  #   ronoctua-shell → ronoctua-0.1.0 → xdg-utils → shared-mime-info
  #
  # That is the TOOL arriving, and this check is about the TABLE. The two are
  # different things that share a name.
  files-closure-has-no-mime-db =
    let
      closure = pkgs.closureInfo { rootPaths = [ rust.shell ]; };
    in
    mkCheck "files-closure-has-no-mime-db" [ pkgs.gnugrep pkgs.coreutils ] ''
      if found=$(grep -e '-ronoctua-mimedb-' ${closure}/store-paths); then
        echo "ERROR: the generated table is in the RUNTIME closure:" >&2
        echo "$found" >&2
        echo "      It is read at COMPILE time — build.rs copies it to" >&2
        echo "      OUT_DIR and the binary carries the DATA. A reference here" >&2
        echo "      means somebody started reading it at run time, and with it" >&2
        echo "      comes the whole shared-mime-info." >&2
        exit 1
      fi

      # AND THE MANAGER IS THERE. A check that only forbids goes green on a
      # shell that lost the feature altogether — the lesson `iso-has-no-toolchain`
      # already learned. `bsdtar` is the file manager's one new runtime
      # reference, so its absence means the compressing half is gone.
      grep -q -e '-libarchive-' ${closure}/store-paths || {
        echo "ERROR: libarchive is not in the closure; the manager's `bsdtar`" >&2
        echo "      went away, and compressing and extracting would fail on a missing path." >&2
        exit 1
      }
      echo "OK: $(wc -l < ${closure}/store-paths) paths; the table is not in the runtime and bsdtar is"
    '';

  # THE COLUMNS GIVE WAY IN THE ORDER THE CODE STATES.
  #
  # An order that drifts with the last edit turns the narrow case into whatever
  # happened to survive. The unit test beside `GIVE_WAY` sweeps every width from
  # one cell to a hundred and twenty and asserts both halves — the order, and
  # that nothing leaks past the edge. This check exists so the constant cannot
  # be reordered without the test being re-read: it pins the FIRST to give way
  # and the one that never does.
  # THE WATCH IS WIRED, and that is a different question from whether it works.
  #
  # `ronoctua_files::notice` has eight tests against a real filesystem, and they
  # answer "does the watcher fire". They cannot answer "do the doors call it, in
  # every place they must" — and that gap is not hypothetical. It is the lesson
  # at the top of this file, and it happened again while this feature was being
  # written: the footer armed its watch only because the disks thread happened to
  # send a `Racked`, whose handler points it. On a machine with no udisks2 the
  # manager would have refreshed only after the first keypress, with eight green
  # tests and two correct screenshots saying otherwise.
  #
  # Four claims, all read off the source. None of them compiles anything.
  files-notices-the-directory = mkCheck "files-notices-the-directory" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the census is "which files build a files::View", which is a
    # question about the whole tree. Inside a door it narrows twice — by
    # function, through the indent walk below, and by braces, through `scope`
    # on the `Report::Stirred` arm.
    crates = pathlib.Path("${../crates}")
    bad = []

    def production(path, text):
        """The part of a file that is not its test module.

        Every crate here puts its tests in one '#[cfg(test)] mod tests' at
        the end, and 'files::View::at' is called fifteen times inside one of
        them. Counting those as doors would make claim one meaningless.

        AND A FILE THAT IS A TEST MODULE HAS NO PRODUCTION PART AT ALL. The
        attribute then sits on the `mod tests;` line in the PARENT — there is
        nothing in the file itself to find — so a sweep that only looked for
        `#[cfg(test)]` read a whole file of tests as a door. It reported
        `geo/tests.rs`, whose `View` is not this one, for never watching a
        directory.
        """
        if path.name == "tests.rs" or "tests" in path.parts:
            return ""
        cut = text.find("#[cfg(test)]")
        return text if cut < 0 else text[:cut]

    # `body_from` was a seventh copy of the brace walk. `scope` is the
    # prelude's, and it takes a PATTERN for the header rather than a literal.

    files = {f: production(f, code_of(f.read_text())) for f in sorted(crates.rglob("*.rs"))}
    floor(len(files), 100, "sources of the workspace swept for a door")

    # ONE. Every door that builds a view builds a watcher.
    #
    # This is the reported bug in check form: the window door existed for
    # months with no way at all to notice a directory changing.
    doors = [f for f, body in files.items() if "View::at(" in body]
    floor(len(doors), 2, "doors that build a files::View")
    for f in doors:
        if "Notice::watching" not in files[f]:
            bad.append(
                f"{f.relative_to(crates)}: builds a files::View and never a "
                "notice::Notice — this door cannot see a directory change"
            )

    # TWO. Whatever builds the view also points the watch at it.
    #
    # The defect this catches, exactly: arming left to whichever report
    # happened to arrive first.
    for f in doors:
        text = files[f]
        for m in re.finditer(r"\n(\s*)(?:pub )?fn (\w+)", text):
            indent, name = m.group(1), m.group(2)
            rest = text[m.end() :]
            stop = re.search("\n" + indent + "}\n", rest)
            inside = rest[: stop.start()] if stop else rest
            if "View::at(" in inside and "follow_the_place" not in inside:
                bad.append(
                    f"{f.relative_to(crates)}: '{name}' opens a view without "
                    "pointing the watch at it"
                )

    # THREE. Every place that drops the view rests the watch.
    #
    # The second site is the one nobody remembers: losing keyboard focus
    # drops the manager without anything having been closed, and a watch left
    # on the last directory wakes a footer with no view for the rest of the
    # session.
    for f, text in files.items():
        for m in re.finditer(r"\n[^\n]*\bfiles = None;", text):
            after = text[m.end() : m.end() + 200]
            if "rest_the_watch" not in after and "rest()" not in after:
                line = text[: m.start()].count("\n") + 2
                bad.append(
                    f"{f.relative_to(crates)}:{line}: the view is dropped and "
                    "the watch is not rested"
                )

    # FOUR. The nudge is answered with a re-read, never with the poll.
    #
    # THE ONE THAT PINS A DECISION RATHER THAN A WIRE. An arm that consulted
    # 'View::stale' compiles, runs, and passes every test there is — and
    # silently stops noticing a file rewritten in place, which is half of why
    # this is a watch and not a clock. 'sidebar_stale' is a different
    # identifier and is meant to be there: our own 'save_sidebar' writes that
    # file, so an unconditional re-read would throw the sidebar's cursor away
    # every time something is pinned.
    arms = 0
    for f, text in files.items():
        arm = scope(text, r"Report::Stirred\s*=>")
        if arm is None:
            continue
        arms += 1
        where = f.relative_to(crates)
        if "reread(" not in arm:
            bad.append(f"{where}: the Stirred arm does not re-read")
        if ".stale()" in arm:
            bad.append(
                f"{where}: the Stirred arm asks View::stale — that is the "
                "directory's mtime, which a file rewritten in place does not move"
            )
    if arms != len(doors):
        bad.append(
            f"{arms} doors answer Report::Stirred, but {len(doors)} build a view"
        )

    if bad:
        print("ERROR: the directory watch is not wired the way it is meant to be.", file=sys.stderr)
        print("", file=sys.stderr)
        for b in bad:
            print("       " + b, file=sys.stderr)
        print("", file=sys.stderr)
        print("       Every one of these compiles and passes the unit tests. What", file=sys.stderr)
        print("       they cost is a listing that quietly stops refreshing, which", file=sys.stderr)
        print("       is the report this feature answers.", file=sys.stderr)
        raise SystemExit(1)

    # AND THE WATCHER ITSELF IS STILL THERE, with the mask it was argued
    # into. Without this the check goes green on a tree where the whole
    # thing was deleted, and MODIFY creeping back in is a hose: it fires on
    # every write, so one log being appended to would re-read the directory
    # without pause.
    notice = crates / "ronoctua-files" / "src" / "notice.rs"
    if not notice.is_file():
        print("ERROR: crates/ronoctua-files/src/notice.rs is gone.", file=sys.stderr)
        raise SystemExit(1)
    mask = code_of(notice.read_text())
    floor(len(mask), 1000, "characters of notice.rs")
    for flag in ("CREATE", "DELETE", "MOVED_TO", "MOVED_FROM", "ATTRIB", "CLOSE_WRITE"):
        if f"WatchFlags::{flag}" not in mask:
            print(f"ERROR: the watch no longer asks for {flag}.", file=sys.stderr)
            raise SystemExit(1)
    if "WatchFlags::MODIFY" in mask:
        print("ERROR: the watch asks for MODIFY, which fires on every write.", file=sys.stderr)
        print("       A log being appended to would re-read the directory in a", file=sys.stderr)
        print("       loop. CLOSE_WRITE is the moment a listing cares about.", file=sys.stderr)
        raise SystemExit(1)
    print(f"OK: {len(doors)} doors watch what they show, and answer the nudge with a re-read")
    END
  '';

  # THE SHAPE IS DRAWN IN THIS PROCESS, and nothing it needs is a program.
  #
  # `ronoctua-inspect` spawns five programs and the number is load-bearing:
  # every one of them is a store path, they are named by `RONOCTUA_*` in three
  # Nix files, and `profile-minimal-closes` allow-lists them one by one. A sixth
  # arriving because somebody "just called a converter" for the next format is
  # the cheapest possible way to add a hundred megabytes to a laptop image.
  #
  # `files-closure-has-no-mime-db` would eventually say so — after a release
  # build of the whole shell. This says it in seconds, off the source, and names
  # the file.
  inspect-mesh-is-in-process = mkCheck "inspect-mesh-is-in-process" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a reach for a program anywhere in a reader is the offence,
    # and the table's row is a module-level literal. `How::tool` is narrowed by
    # name below.
    #
    # `uncommented` and never `code_of`: the eleven media types the mesh row
    # claims are STRING literals, and emptying them would leave the row
    # claiming nothing and the check agreeing.
    src = pathlib.Path("${../crates/ronoctua-inspect/src}")
    bad = []
    mesh = src / "mesh"
    solid = src / "solid.rs"

    # ONE. NO READER AND NOT THE RASTERISER NAMES A PROGRAM.
    #
    # `Command` and `tools::` are the two doors to one, and `Tool` is the
    # enum that would have to grow first — so a sixth program cannot be
    # reached from here without one of the three appearing.
    #
    # THE WHOLE DIRECTORY, and not one file: `mesh.rs` became `mesh/` when
    # it grew from two formats to eleven, and a check that named one file
    # would have gone green on ten readers it never looked at.
    if not mesh.is_dir():
        bad.append("the mesh readers are gone")
    readers = sorted(mesh.glob("*.rs")) if mesh.is_dir() else []
    floor(len(readers), 12, "files under mesh/")
    for f in readers + [solid]:
        if not f.is_file():
            bad.append(f"{f.name} is gone")
            continue
        body = uncommented(f.read_text())
        for word in ("Command", "tools::", "Tool::", "std::process"):
            if word in body:
                bad.append(f"{f.name} names '{word}' — a shape is drawn here, not fetched")

    # TWO. The count of programs is pinned, so a new one has to be argued for.
    #
    # Not a forbidden list of names: what is asserted is the COUNT, so one of
    # any name at all lands here and somebody has to come and change this line
    # on purpose.
    #
    # IT WAS FIVE, THEN EIGHT, AND IS SIX. `catdoc`, `xls2csv` and `catppt`
    # arrived together — one package, 36,6 MiB measured — for the three OLE
    # office formats, which are not XML and which no library in this tree
    # read. TWO OF THE THREE LEFT AGAIN, and both times the reason was a
    # measurement against the binary this flake actually pins: `catppt` answers
    # zero bytes with exit status zero on a real `.ppt`, and `catdoc` answers
    # zero bytes with exit 69 on a real `.doc`. So `crate::ppt` walks the
    # records and `crate::doc` the piece table, both over `crate::ole`, and
    # neither needs anything installed. That is this check's own argument
    # running the other way, and it is the only direction it is ever nice to go.
    #
    # None of them weakens clause ONE by a line: the mesh readers and the
    # rasteriser still name no program at all, which is the thing this check is
    # called after.
    tools = uncommented((src / "tools.rs").read_text())
    floor(len(tools), 500, "characters of tools.rs")
    if "pub const ALL: [Self; 6]" not in tools:
        bad.append("tools.rs no longer declares exactly six programs")

    # THREE. The table's mesh row asks for no program.
    pixels = uncommented((src / "pixels.rs").read_text())
    floor(len(pixels), 1000, "characters of pixels.rs")
    tool = body_of(pixels, "tool")
    if tool is None:
        bad.append("pixels.rs has no How::tool — what does the grep match?")
    else:
        floor(len(tool), 40, "characters of `How::tool`")
        arms = re.findall(r"([^=>\n{}]+)=>\s*([^,\n]+),", tool)
        found = [(a, b) for a, b in arms if "Mesh" in a]
        if not found:
            bad.append("How::Mesh has no arm in How::tool")
        for a, b in found:
            if "None" not in b:
                bad.append(f"How::Mesh asks for a program: {b.strip()}")

    # AND THE ROW IS STILL THERE, claiming every shape. Without this the
    # check goes green on a tree where the whole feature was deleted, which
    # is the shape `persistence-takes-its-root-as-a-parameter` already
    # guards against with its own closing clause.
    row = re.search(r'id:\s*"mesh".*?how:\s*How::Mesh', pixels, re.S)
    if row is None:
        bad.append("no row in the table claims a mesh")
    else:
        for kind in (
            "model/stl",
            "model/3mf",
            "model/obj",
            "model/x-ply",
            "model/x-off",
            "model/gltf+json",
            "model/gltf-binary",
            "model/vnd.collada+xml",
            "model/x-amf",
            "model/step",
            "model/iges",
        ):
            if kind not in row.group(0):
                bad.append(f"the mesh row no longer claims {kind}")
    if solid.is_file() and "pub fn draw(" not in uncommented(solid.read_text()):
        bad.append("solid.rs no longer draws anything")

    if bad:
        print("ERROR: the mesh preview is not the in-process one it is meant to be.", file=sys.stderr)
        print("", file=sys.stderr)
        for b in bad:
            print("       " + b, file=sys.stderr)
        print("", file=sys.stderr)
        print("       A program here is a store path, three Nix files to set a", file=sys.stderr)
        print("       variable in, and one more line in the closure sweep. The", file=sys.stderr)
        print("       rasteriser is two hundred lines and costs none of that.", file=sys.stderr)
        raise SystemExit(1)
    print(f"OK: {len(readers)} files read and draw in process, and the six programs are six")
    END
  '';

  files-columns-degrade = mkCheck "files-columns-degrade" [ pkgs.gnugrep ] ''
    view=${../crates/ronoctua-shell/src}/files.rs
    order=$(sed -n '/^pub const GIVE_WAY/,/^];/p' "$view" | grep -oE 'Column::[A-Za-z]+' | tr -d ' ')
    first=$(echo "$order" | head -1)
    [ "$first" = "Column::Group" ] || {
      echo "ERROR: the first column to give way became $first, and it was the group." >&2
      echo "      If the change is deliberate, the test next to GIVE_WAY says why." >&2
      exit 1
    }
    echo "$order" | grep -q 'Column::Name' && {
      echo "ERROR: the name is in GIVE_WAY. It never gives way: a table about" >&2
      echo "      files that does not say which ones is a table about nothing." >&2
      exit 1
    }
    echo "OK: gives way in the order $(echo "$order" | tr '\n' ' ')"
  '';

  # NOTHING THE CONSOLE SPAWNS COMES BY NAME.
  #
  # It runs from a unit on a VT, where `PATH` is minimal, and it is opened
  # BECAUSE something is already broken — a name that does not resolve fails on
  # the one screen that exists to explain failures.
  #
  # Two sides, both from real artifacts: the variables the crate reads, and the
  # table `nix/rust.nix` sets. It is `shell-finds-its-buffers` again, on the
  # other application.
  rescue-runs-by-path = mkCheck "rescue-runs-by-path" [ pkgs.gnugrep ] ''
    src=${../crates/ronoctua-rescue/src}
    failed=0

    read_it=$(grep -ohE 'option_env!\("RONOCTUA_[A-Z_]+"\)' "$src"/*.rs \
      | grep -oE 'RONOCTUA_[A-Z_]+' | sort -u)
    [ -n "$read_it" ] || {
      echo "ERROR: the console reads no variable at all — does it spawn by name?" >&2
      exit 1
    }
    echo "o console le: $(echo "$read_it" | tr '\n' ' ')"

    baked="${lib.concatStringsSep " " (lib.attrNames rust.generated)}"
    for v in $read_it; do
      case " $baked " in
        *" $v "*) ;;
        *)
          echo "ERROR: the console reads $v and the build does not bake it in — it would fall" >&2
          echo "      on a unit's minimal 'PATH' and would fail far from here." >&2
          failed=1
          ;;
      esac
    done

    [ "$failed" = 0 ] || exit 1
    echo "OK: every rescue program comes by store path"
  '';

  # THE POLKIT RULE ALLOWS EXACTLY WHAT THE CONSOLE ASKS FOR.
  #
  # Two directions, and the second is the one that rots: a row without its unit
  # fails in front of the person, which is loud; a unit left in the rule after
  # its row went away is privilege granted to nobody, which is silent and stays.
  #
  # The exemption list is spelled out with its reason. `keyd.service` is reached
  # by a FREE row and is not this rule's business — `nix/modules/keyboard.nix`
  # already allows exactly it, and `Ctrl+Shift+L` already fires it.
  rescue-polkit-is-narrow =
    let
      rule = self.nixosConfigurations.noctua.config.security.polkit.extraConfig;
    in
    mkCheck "rescue-polkit-is-narrow"
      [
        pkgs.gnugrep
        pkgs.coreutils
      ]
      ''
        cat > rule.js <<'END'
        ${rule}
        END
        # THE WHOLE CRATE, and not just the registry. The unit that installs an
        # edited `host.nix` is named in `edit.rs` — this check found that by
        # refusing, which is what a two-way comparison is for.
        src=${../crates/ronoctua-rescue/src}
        failed=0

        # What the console names, minus what the session owns. A user unit does
        # not reach polkit at all: there is no display manager here, and the
        # compositor and the footer are the person's own units.
        wanted=$(grep -rohE '"[A-Za-z@.-]+\.(service|target)"' "$src" | tr -d '"' | sort -u)
        for u in $wanted; do
          case "$u" in
            # The session's own, and the keyboard's — see above.
            ronoctua-footer.service|scroll.service|graphical-session.target) continue ;;
            pipewire.service|pipewire-pulse.service|wireplumber.service) continue ;;
            keyd.service) continue ;;
          esac
          grep -qF "\"$u\"" rule.js || {
            echo "ERROR: the console asks for '$u' and the polkit rule does not allow it;" >&2
            echo "      the row would fail in front of the person." >&2
            failed=1
          }
        done

        # And back: every unit the rule names has to be one the console asks for.
        for u in $(grep -ohE '"ronoctua-rescue[A-Za-z@.-]*\.service"' rule.js | tr -d '"' | sort -u); do
          grep -rqF "\"$u\"" "$src" || {
            echo "ERROR: the rule allows '$u' and no console row asks for it —" >&2
            echo "      a privilege granted to nobody, which is what nobody audits." >&2
            failed=1
          }
        done

        [ "$failed" = 0 ] || exit 1
        echo "OK: the rule allows exactly what the console asks for"
      '';

  # `Ctrl+Alt+Del` IS OURS — and the hard way out stays systemd's.
  #
  # Two halves, and the check exists because the second is the one a person
  # would not think to look for. Taking the key over means taking what it did:
  # if the burst stopped rebooting too, a machine whose everything is frozen
  # would have no way out at all, and nothing would say so until that day.
  ctrl-alt-del-is-ours =
    let
      # `ctrl-alt-del.target` is a SYMLINK to whatever `ctrlAltDelUnit` names —
      # that is the option NixOS gives for this, and the two roads that look
      # more obvious are documented in `nix/modules/rescue.nix` as the failures
      # they are.
      aimed = self.nixosConfigurations.noctua.config.systemd.ctrlAltDelUnit;
      target = self.nixosConfigurations.noctua.config.systemd.targets.ronoctua-rescue;
      burst =
        self.nixosConfigurations.noctua.config.systemd.settings.Manager.CtrlAltDelBurstAction
          or "reboot-force";
    in
    mkCheck "ctrl-alt-del-is-ours" [ ] ''
      [ "${aimed}" = "ronoctua-rescue.target" ] || {
        echo "ERROR: Ctrl+Alt+Del points at '${aimed}', which is not the rescue." >&2
        exit 1
      }
      wants="${lib.concatStringsSep " " target.wants}"
      case "$wants" in
        *ronoctua-rescue.service*) ;;
        *)
          echo "ERROR: ctrl-alt-del.target does not open the rescue; it wants: $wants" >&2
          echo "      A key that is taken and opens nothing is a key thrown away." >&2
          exit 1
          ;;
      esac

      # The way out that does not pass through us.
      [ "${burst}" = "reboot-force" ] || {
        echo "ERROR: CtrlAltDelBurstAction is '${burst}'; the seven presses in two" >&2
        echo "      seconds were the only way out with everything locked up." >&2
        exit 1
      }

      echo "OK: one press opens the rescue, seven still force a reboot"
    '';

  # THE RESCUE CONSOLE CARRIES NO COMPILER.
  #
  # He exists for a machine that is broken, and the cheapest way to make him
  # useless is to link something that drags a toolchain: `ronoctua-term` cites
  # `libghostty-vt` (Zig, clang, LLVM — 1,70 GiB) and `ronoctua-render` cites
  # mesa. Neither would FAIL anything; both would quietly make the rescue
  # console the heaviest thing in the system.
  #
  # `nix/rust.nix`'s `rescue` exists to be measured: a derivation references
  # what its own bytes cite.
  rescue-has-no-toolchain =
    let
      closure = pkgs.closureInfo { rootPaths = [ rust.rescue ]; };
    in
    mkCheck "rescue-has-no-toolchain"
      [
        pkgs.gnugrep
        pkgs.coreutils
      ]
      ''
        failed=0
        for unwanted in -zig- -clang- -llvm- -mesa- -vulkan-loader-; do
          if found=$(grep -e "$unwanted" ${closure}/store-paths); then
            echo "ERROR: the rescue console drags $unwanted along:" >&2
            echo "$found" >&2
            failed=1
          fi
        done
        [ "$failed" = 0 ] || exit 1
        echo "OK: $(wc -l < ${closure}/store-paths) paths, and no compiler"
      '';

  # WHATEVER THE SHELL LOOKS FOR NEXT DOOR, THE DEV LOOP HAS TO BUILD.
  #
  # Two binaries are found by ASKING THE FILESYSTEM rather than by a store path
  # in a variable — `ronoctua-rescue` and `ronoctua-transfers` — and they have
  # to be: they come out of the same build as the shell, so a path baked into
  # one would be that derivation referencing itself.
  #
  # Installed, they are next door: `rust.shell` is a `symlinkJoin` over the
  # whole workspace. In the nested loop they are next door too — until the FIRST
  # edit, when `RONOCTUA_FOOTER_BIN` moves to `$CARGO_TARGET_DIR/loop/` and
  # only what `cargo build` named is there.
  #
  # AND THE LINE HAS TO BE A COMMAND CARGO ACCEPTS, which is the second half and
  # was not here. `--bin` names a target inside the packages `-p` selected, so
  # `--bin ronoctua-rescue` with no `-p ronoctua-rescue` is not a build missing
  # one binary: cargo refuses the WHOLE command with "no bin target named
  # `ronoctua-rescue` in `ronoctua-shell`". The dev loop caught that in its
  # `else` branch, printed "the compilation failed" and kept the old footer —
  # so hot reload had quietly stopped existing, for every edit of every session,
  # and what it looked like was a loop one had to restart by hand.
  #
  # Checking the NAME is what let that through: the name was there, spelt
  # correctly, in a command that could not run. So the packages are checked too,
  # against the manifests that declare the binaries.
  #
  # The symptom is the worst kind there is: everything works, and then one edit
  # quietly takes a feature away. A missing transfer queue looks exactly like
  # "nothing is running", and a missing rescue console looks exactly like a key
  # that does nothing. This check is what noticed that the rescue console had
  # been in that state the whole time.
  dev-rebuilds-what-sits-beside =
    mkCheck "dev-rebuilds-what-sits-beside"
      [
        pkgs.gnugrep
        pkgs.coreutils
        pkgs.python3
      ]
      ''
        shell=${../crates/ronoctua-shell/src}
        queue=${../crates/ronoctua-transfers/src}
        # AND THE BRAIN'S, for the same reason the queue's is here: it looks its
        # own daemon up beside `current_exe()`, so the nested loop has to build
        # that binary or the footer would find yesterday's one and nothing would
        # say so.
        brain=${../crates/ronoctua-brain/src}
        # AND THE STUDIO'S: the camera app and the settings view start it from
        # beside themselves when nobody answers its socket.
        studio=${../crates/ronoctua-studio/src}
        # AND THE PLAYER'S, for the same reason: its client starts the daemon
        # from beside whoever asked.
        player=${../crates/ronoctua-player/src}
        failed=0

        # The names come from the CODE that looks them up, never from a list
        # written here: a list would be a third place to keep in step.
        beside=$(grep -rhoE 'parent\(\)\?\.join\("[a-z-]+"' "$shell" "$queue" "$brain" "$studio" "$player" \
          | grep -oE '"[a-z-]+"' | tr -d '"' | sort -u)
        [ -n "$beside" ] || {
          echo "ERROR: nobody looks for a binary beside it — what does the grep match?" >&2
          exit 1
        }

        for b in $beside; do
          grep -q -- "--bin $b" ${../nix/dev.nix} || {
            echo "ERROR: the footer looks for $b beside it, and the dev loop does not build it." >&2
            echo "      After the FIRST edit it goes away, in silence." >&2
            failed=1
          }
        done

        [ "$failed" = 0 ] || exit 1
        echo "ok: $(echo "$beside" | wc -l) binaries beside it, and the loop names them all"

        # AND EVERY `--bin` IS INSIDE A PACKAGE THE SAME LINE SELECTED.
        #
        # Which package owns a binary comes from the MANIFESTS, never from a
        # list here: `[[bin]] name = "x"` in a crate, or the crate's own name
        # when the binary is the package's default.
        python3 - <<'PY'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        # FILE-WIDE: a `cargo build` line in a shell script and the `[[bin]]`
        # blocks of a dozen manifests. Neither has a function to narrow to;
        # the `cargo build … 2>&1` match and the split on `[[bin]]` are the
        # narrowing.
        #
        # `hashless` for both, whose comment is `#`: a `--bin` named in a
        # comment is not a binary the loop builds, and a `name =` commented out
        # of a manifest is not a binary that exists.
        dev = hashless(pathlib.Path("${../nix/dev.nix}").read_text())
        floor(len(dev), 2000, "characters of nix/dev.nix")
        # The reload's command: from `cargo build` to the `; then` that ends it.
        line = re.search(r"cargo build (.*?)2>&1", dev, re.S)
        if not line:
            sys.exit("ERROR: the dev loop no longer runs a `cargo build` — what does it run?")
        words = line.group(1).replace("\\\n", " ").split()
        chosen = {w for f, w in zip(words, words[1:]) if f == "-p"}
        wanted = [w for f, w in zip(words, words[1:]) if f == "--bin"]
        floor(len(chosen), 1, "packages the loop's command selects")
        floor(len(wanted), 1, "binaries the loop's command names")

        # Every binary the tree declares, and which package declares it.
        owner, seen = {}, 0
        for manifest in sorted(pathlib.Path("${../crates}").glob("*/Cargo.toml")):
            text = hashless(manifest.read_text())
            seen += 1
            crate = re.search(r'^name = "([\w-]+)"', text, re.M)
            if crate:
                owner.setdefault(crate.group(1), crate.group(1))
            for block in text.split("[[bin]]")[1:]:
                named = re.search(r'^name = "([\w-]+)"', block, re.M)
                if named and crate:
                    owner[named.group(1)] = crate.group(1)

        floor(seen, 10, "manifests read for a binary's owner")
        gaps = []
        for b in wanted:
            has = owner.get(b)
            if has is None:
                gaps.append(f"`--bin {b}` is a binary no crate in this tree declares")
            elif has not in chosen:
                gaps.append(
                    f"`--bin {b}` lives in `{has}`, and the line selects "
                    + ", ".join("`" + c + "`" for c in sorted(chosen))
                )
        if gaps:
            print("ERROR: the dev loop's `cargo build` is not a command cargo accepts:")
            for g in gaps:
                print("  - " + g)
            print("")
            print("       cargo refuses the WHOLE command, so the loop falls into its")
            print("       `else`, says the compilation failed, and keeps the old footer.")
            print("       Hot reload stops existing, for every edit of every session.")
            sys.exit(1)
        print(f"OK: {len(wanted)} binaries beside it, each inside a package the line selects")
        PY
      '';

  # AND THE LOOP'S PROFILE NEVER REACHES A MACHINE.
  #
  # `[profile.loop]` trades run time for build time: no `lto`, sixteen codegen
  # units, no symbols. That is right for `nix run .#dev`, where one LOOKS at the
  # interface, and wrong for everything that is installed.
  #
  # # Why a check and not care
  #
  # Because the failure has no symptom. A binary built at the loop's profile
  # runs, draws, and passes every test and every driver — it is merely slower,
  # on somebody else's machine, months later. Nothing on a screen says which
  # profile a program was built at, and `nix why-depends` is not run on a
  # Tuesday.
  #
  # It reads the CLOSURE of the seven things a machine actually installs: the
  # wrapper the unit starts and the six extracted binaries. A loop-profile path
  # in any of them is the mistake, whether it arrived by an edited `flake.nix`,
  # a module, or an `overrideAttrs` nobody read.
  the-loop-profile-is-never-installed =
    let
      installed = pkgs.closureInfo {
        rootPaths = [
          rust.shell
          rust.installer
          rust.rescue
          rust.transfers
          rust.brain
          rust.filesRoot
          rust.formatDisk
        ];
      };
    in
    mkCheck "the-loop-profile-is-never-installed"
      [
        pkgs.gnugrep
        pkgs.coreutils
      ]
      ''
        # THE TWO PROFILES HAVE TO BE TWO. Without this the check would pass on
        # the day somebody made them the same thing — the closure would be clean
        # because there would be nothing left to find.
        loop=${rust.loopWorkspace.drvPath}
        plain=${rust.workspace.drvPath}
        [ "$loop" != "$plain" ] || {
          echo "ERROR: the loop's workspace and the installed one are one derivation." >&2
          echo "      Then this check proves nothing — see the root Cargo.toml." >&2
          exit 1
        }

        failed=0
        for mark in -ronoctua-loop- -ronoctua-shell-loop- -ronoctua-deps-loop-; do
          if found=$(grep -e "$mark" ${installed}/store-paths); then
            echo "ERROR: something installed was built at the loop's profile:" >&2
            echo "$found" >&2
            echo "      It runs, and it is slower, and nothing on a screen says so." >&2
            failed=1
          fi
        done
        [ "$failed" = 0 ] || exit 1
        echo "OK: the seven installed programs carry no loop-profile build"
      '';

  # THE QUEUE'S UNIT IS A COPY, NOT A DESKTOP.
  #
  # `ronoctua-transfers` is a user service that outlives the session — it is
  # what keeps a copy of forty gibibytes alive across a footer restart. Handing
  # it `rust.shell` instead of the extracted binary would put wgpu, the wasm
  # runtime, the renderer and three embedded fonts inside a unit that never
  # opens a window, and would hold every one of those store paths alive for as
  # long as the machine is on.
  #
  # Nothing would fail. That is exactly why this is a check and not a comment:
  # `nix why-depends` on the unit is what would say so, and nobody runs that on
  # a Tuesday.
  transfers-unit-is-narrow =
    let
      closure = pkgs.closureInfo { rootPaths = [ rust.transfers ]; };
    in
    mkCheck "transfers-unit-is-narrow"
      [
        pkgs.gnugrep
        pkgs.coreutils
      ]
      ''
        failed=0
        for unwanted in -zig- -clang- -llvm- -mesa- -vulkan-loader- -noctua-iosevka- -icons-superpack-; do
          if found=$(grep -e "$unwanted" ${closure}/store-paths); then
            echo "ERROR: the queue's unit drags $unwanted in:" >&2
            echo "$found" >&2
            failed=1
          fi
        done
        [ "$failed" = 0 ] || exit 1
        echo "OK: $(wc -l < ${closure}/store-paths) paths, and none of them draws"
      '';

  # A TEST MAY NOT REACH THE MACHINE, and this one was paid for out loud.
  #
  # `ronoctua-brain`'s `systemd` module had a unit test that called
  # `start("ronoctua-does-not-exist.service")`. The reasoning was sound and
  # wrong: a unit that is not there cannot do any harm. But `systemctl start`
  # on a SYSTEM unit is authorised by polkit BEFORE systemd looks the unit up,
  # so every `cargo test` opened a real authentication prompt on the owner's
  # laptop — and, because there is no polkit agent in the session, sat there
  # until it timed out. The suite took 25 s; without the call it takes 0,3.
  #
  # Nothing failed. Nothing was logged. It surfaced because the owner was asked
  # for his fingerprint five times in a row and came to ask what was going on —
  # which is the same failure this repository already reasons about from the
  # other end: he is not always near the laptop, and a prompt nobody sees is a
  # refusal nobody made.
  #
  # So: inside `#[cfg(test)]`, no program that authorises, spawns a unit, or
  # asks for a password. What a test may check is the SHAPE of the invocation,
  # which is a pure function.
  tests-do-not-touch-the-machine = mkCheck "tests-do-not-touch-the-machine" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the offence is a spawn ANYWHERE below `mod tests {`, and the
    # cut at that line is the narrowing.
    #
    # `uncommented` and never `code_of`: every program named here is a STRING
    # literal — `Command::new("systemctl")` — so emptying the strings would
    # leave a check that can find nothing at all.
    root_dir = pathlib.Path("${self}")

    # The programs a test must never start. `systemd-run` is on the list for a
    # second reason on top of polkit: it is SYNCHRONOUS with `--scope`, and
    # this project has already frozen its own footer on that once.
    # NAMED ANYWHERE IN THE CALL, literal or variable: these are the programs
    # that go through polkit or block on a scope, and a test must not reach one
    # however it spells the path.
    #
    # It used to have a first alternative matching `Command::new("` — any
    # literal at all — which made it a duplicate of the sweep below and, worse,
    # overrode its one allowance.
    FORBIDDEN = re.compile(
        r'Command::new\([^)]*\b(sudo|pkexec|systemd-run|systemctl|loginctl'
        r'|udisksctl|SYSTEMCTL)\b'
    )
    # A SPAWN WHOSE PROGRAM IS A LITERAL, which is the shape every dangerous
    # one has: `Command::new("systemctl")`, `Command::new("sudo")`.
    #
    # It used to be ANY spawn at all, and the argument for that was good — a
    # list somebody has to keep complete is a list that goes stale. What broke
    # it is that the preview grew tests which BUILD their fixtures: three in
    # `inspect/motion.rs` make a video with the ffmpeg the FLAKE provides, and
    # one in `shell/motion.rs` pipes through `/bin/sh`. Those reach no polkit
    # and block on no scope, and the check went red the day they arrived and
    # stayed red — through two commits, because `most` is not run every time.
    # A check that is red for a reason nobody accepts stops being read.
    #
    # So the rule is the DANGER and not the act: a program named by a literal
    # is one this repository chose by name, and those are the ones that can be
    # `systemctl`. A program that arrives in a variable came out of the
    # environment the flake set, and WHICH programs may exist there at all is
    # already policed by `inspect-mesh-is-in-process` and by the closure sweep.
    SPAWN = re.compile(r'Command::new\(\s*"([^"]*)"')
    # The one literal a test may name: it starts no daemon and asks nobody for
    # permission.
    ALLOWED = {"/bin/sh"}

    gaps, swept, tails = [], 0, 0
    for rs in sorted((root_dir / "crates").rglob("*.rs")):
        if "target" in rs.parts:
            continue
        source = uncommented(rs.read_text())
        swept += 1
        # Everything from `mod tests {` to the end of the file: a test module is
        # conventionally last here, and taking the tail is what makes this
        # robust against nesting rather than counting braces.
        at = source.find("mod tests {")
        if at < 0:
            continue
        tails += 1
        tail = source[at:]
        for n, line in enumerate(tail.splitlines(), 1):
            stripped = line.strip()
            m = SPAWN.search(line)
            if (m and m.group(1) not in ALLOWED) or FORBIDDEN.search(line):
                rel = rs.relative_to(root_dir)
                gaps.append(f"{rel}: mod tests + {n}: {stripped[:70]}")

    floor(swept, 100, "sources of the workspace swept for a test")
    floor(tails, 30, "test modules found")
    if gaps:
        print("ERROR: a test starts a program on the machine.", file=sys.stderr)
        print("", file=sys.stderr)
        for g in gaps:
            print(f"       {g}", file=sys.stderr)
        print("", file=sys.stderr)
        print("       `systemctl start` on a SYSTEM unit goes through polkit", file=sys.stderr)
        print("       BEFORE systemd looks for the unit — so even asking for one", file=sys.stderr)
        print("       that does not exist opens a real fingerprint request, and with no", file=sys.stderr)
        print("       agent in the session it waits until it times out.", file=sys.stderr)
        print("", file=sys.stderr)
        print("       What a test checks is the SHAPE of the call, and a shape is a", file=sys.stderr)
        print("       pure function: see `systemd::argv`.", file=sys.stderr)
        raise SystemExit(1)
    print("OK: no test starts a program on the machine")
    END
  '';

  # THE BRAIN'S UNIT DECIDES, IT DOES NOT DRAW.
  #
  # The same argument `transfers-unit-is-narrow` makes about the queue, and a
  # sharper version of it: this daemon runs for as long as the machine is on,
  # its whole job is to watch a clock and a report file, and it has no screen at
  # all. Handing it `rust.shell` instead of the extracted binary would hold wgpu,
  # the wasm runtime, the renderer and three embedded fonts alive permanently,
  # for a program that never opens a window.
  #
  # Nothing would fail — which is why this is a check and not a comment. And it
  # is the same measurement `AGENTS.md` demands in place of trusting a switch:
  # a derivation references what its BYTES cite, so measure the closure rather
  # than believing the `[[bin]]`.
  brain-unit-is-narrow =
    let
      closure = pkgs.closureInfo { rootPaths = [ rust.brain ]; };
    in
    mkCheck "brain-unit-is-narrow"
      [
        pkgs.gnugrep
        pkgs.coreutils
      ]
      ''
        failed=0
        # `-wasmtime-` on top of the queue's list: the brain loads no component,
        # and the runtime arriving here would mean it had been handed the whole
        # workspace again.
        for unwanted in -zig- -clang- -llvm- -mesa- -vulkan-loader- \
                        -noctua-iosevka- -icons-superpack- -wasmtime-; do
          if found=$(grep -e "$unwanted" ${closure}/store-paths); then
            echo "ERROR: the brain's unit drags $unwanted in:" >&2
            echo "$found" >&2
            failed=1
          fi
        done
        [ "$failed" = 0 ] || exit 1
        echo "OK: $(wc -l < ${closure}/store-paths) paths, and none of them draws"
      '';

  # THE QUEUE'S SOCKET IS THE PERSON'S, AND NOBODY ELSE'S.
  #
  # `XDG_RUNTIME_DIR` is `0700` and per user. A control socket in `/tmp` would
  # be a door anybody on the machine can knock on — and what is behind this one
  # is "copy that there" and "delete those", with the person's own privileges.
  #
  # `leader::socket_path` states the same rule for the footer's socket and has
  # no check; this one does, because the failure is silent: a fallback to `/tmp`
  # WORKS, and works better — it works when `XDG_RUNTIME_DIR` is missing, which
  # is exactly when it should refuse.
  transfers-socket-is-private = mkCheck "transfers-socket-is-private" [ pkgs.gnugrep ] ''
    src=${../crates/ronoctua-transfers/src}
    grep -q 'XDG_RUNTIME_DIR' "$src/wire.rs" || {
      echo "ERROR: the socket stopped coming out of XDG_RUNTIME_DIR." >&2; exit 1; }

    # NO FALLBACK. Not `unwrap_or`, not `/tmp`, not `std::env::temp_dir`.
    #
    # The failure this refuses is a SILENT one: a fallback to /tmp works, and
    # works better — it works when XDG_RUNTIME_DIR is missing, which is
    # exactly when it should refuse.
    #
    # The tests build their trees under the temporary directory and that is
    # fine; what may not go there is the SOCKET.
    hits=$(grep -nE '/tmp|temp_dir' "$src"/*.rs "$src"/bin/*.rs || true)
    # A comment is prose, and one of them is this very rule written out.
    bad=$(echo "$hits" | grep -vE ':[0-9]+: *//' || true)
    # A test builds its tree under the temporary directory, which is what a
    # temporary directory is for. What may not go there is the SOCKET.
    bad=$(echo "$bad" | grep -vE 'std::env::temp_dir\(\)' || true)
    bad=$(echo "$bad" | grep -vE '^ *$' || true)
    [ -z "$bad" ] || {
      echo "ERROR: the queue fell back to /tmp somewhere:" >&2
      echo "$bad" >&2
      exit 1
    }
    echo "OK: the queue's socket belongs to the user, with no plan B"
  '';

  # EVERY ENGINE, EVERY STAGE AND EVERY KIND OF WORK HAS WORDS IN BOTH LANGUAGES.
  #
  # The key is ASSEMBLED at runtime — `transfers-stage-{}` with `Stage::word()`
  # — so it is one of the keys `docs/ARCHITECTURE.md` describes as having seven
  # derivatives and being invisible to every search in the code. A variant added
  # without its `.ftl` line does not fail to compile; it draws the raw key on
  # screen, which is precisely the shape invariant 8 exists to refuse and which
  # was reported from this system's own screen once already.
  transfers-words-are-total = mkCheck "transfers-words-are-total" [ pkgs.gnugrep pkgs.coreutils ] ''
    job=${../crates/ronoctua-transfers/src}/job.rs
    failed=0

    # The words come out of the `word()` tables — the same place the Rust
    # builds the key from. Reading the enum's variants instead would be a
    # second spelling of the same list.
    first=""
    words=$(grep -oE '=> "[a-z]+",' "$job" | grep -oE '"[a-z]+"' | tr -d '"' | sort -u)
    [ -n "$words" ] || { echo "ERROR: could not find a single word in job.rs" >&2; exit 1; }

    for w in $words; do
      for prefix in transfers-work transfers-stage transfers-engine; do
        # A word belongs to exactly one of the three families; what this loop
        # demands is that WHEREVER it appears in one language it appears in
        # ALL of them. Comparing two counts was the old shape and it could not
        # grow: with a third language the pair would still have agreed while
        # the newcomer said nothing.
        counts=""
        for language in ${lib.concatStringsSep " " languages}; do
          n=$(grep -c "^$prefix-$w = " ${../assets/i18n}/$language.ftl || true)
          counts="$counts $language=$n"
          if [ -z "$first" ]; then first=$n; fi
          if [ "$n" != "$first" ]; then
            echo "ERROR: $prefix-$w does not exist in every language ($counts )" >&2
            failed=1
          fi
        done
        first=""
      done
      # And it has to exist in AT LEAST one family, or it is a variant
      # nothing can draw. The base language answers for all of them: the
      # loop above has just proved they agree.
      total=$(grep -c "^transfers-[a-z]*-$w = " \
        ${../assets/i18n}/${builtins.head languages}.ftl || true)
      if [ "$total" = 0 ]; then
        echo "ERROR: the word $w from job.rs has no text at all" >&2
        failed=1
      fi
    done

    [ "$failed" = 0 ] || exit 1
    echo "OK: $(echo "$words" | wc -l) queue words, in ${toString (builtins.length languages)} languages"
  '';

  # THE EDITOR WRITES WHERE THE UNIT READS.
  #
  # The path crosses the border as a STRING: the crate writes to it and a root
  # oneshot reads from it. Divergent, saving would report success and install
  # nothing — the exact silence `AGENTS.md` says needs a check.
  rescue-staging-agrees = mkCheck "rescue-staging-agrees" [ pkgs.gnugrep ] ''
    grep -q 'staged = "/run/ronoctua-rescue/staged"' ${../nix/modules}/rescue.nix || {
      echo "ERROR: the module changed the path where it reads the edited file." >&2; exit 1; }
    grep -q 'pub const STAGED: &str = "/run/ronoctua-rescue/staged"' \
      ${../crates/ronoctua-rescue/src}/edit.rs || {
      echo "ERROR: the editor changed the path where it writes; saving would install nothing." >&2; exit 1; }
    echo "OK: the editor writes where the unit reads"
  '';

  # HOT RELOAD RELOADS — behavior, not existence.
  #
  # The criterion of milestone 3 says "brings up the compositor + shell WITH HOT RELOAD".
  # The old check listed the `devApp` with the comment "it has to exist and be
  # executable", and an app that never reloads anything passes that easily. That
  # is how the milestone closed without the feature.
  #
  # This check exercises the real mechanism: it brings the watcher up over a
  # temporary directory, touches a `.rs`, and asserts that the command fired.
  # With no compositor and no GPU — that is why it fits in `nix flake check`,
  # which is where the milestone is proved.
  reload-reloads =
    mkCheck "reload-reloads"
      [
        reloadApp
        pkgs.procps
      ]
      ''
        export HOME=$TMPDIR
        mkdir -p obs
        : > obs/initial.rs

        # The command records WHAT changed, and not just that it fired: the
        # nested loop branches on that path — a `.rs` under `buffers/` is a
        # component and is built by nix, everything else is the workspace and is
        # built by cargo. If the variable stopped arriving, the loop would go on
        # reloading and would silently take the wrong branch every time.
        RONOCTUA_RELOAD_CMD="echo \"fired \$RONOCTUA_RELOAD_FILE\" >> $PWD/marker" \
          ronoctua-reload "$PWD/obs" &
        watcher=$!
        trap 'kill $watcher 2>/dev/null || true' EXIT

        # The `inotifywait` has to be ARMED before the write: touching the file too
        # early and the event is lost and the check fails with no defect at all.
        for _ in $(seq 50); do
          [ -e /proc/$watcher ] || break
          sleep 0.2
          grep -q . /dev/null 2>/dev/null && break
        done
        sleep 3

        echo 'fn main() {}' > obs/changed.rs

        ok=no
        for _ in $(seq 50); do
          [ -s marker ] && { ok=yes; break; }
          sleep 0.2
        done
        [ "$ok" = yes ] || {
          echo "ERROR: changing a .rs did NOT fire the command." >&2
          echo "Milestone 3's hot reload is not working." >&2
          exit 1
        }
        grep -q "fired .*obs/changed.rs" marker || {
          echo "ERROR: it fired without saying WHICH file changed." >&2
          echo "      The nested loop chooses between nix and cargo by that path;" >&2
          echo "      without it, every edited buffer would fall into the workspace branch." >&2
          cat marker >&2
          exit 1
        }

        # And the other way round: a change that is NOT code must not fire. Without
        # this the watcher would recompile on every `.swp` from the editor.
        : > marker
        echo 'I am not code' > obs/README.txt
        sleep 2
        [ ! -s marker ] || {
          echo "ERROR: a file that is neither .rs nor .wit fired the rebuild." >&2
          exit 1
        }

        # IT DIES WHEN IT IS TOLD TO DIE.
        #
        # # The defect this catches, and that only shows up in use
        #
        # The watcher's last command was a pipeline in the FOREGROUND, and bash defers
        # a signal until the running command finishes — an `inotifywait -m` never
        # finishes. The `kill` from `nix/dev.nix` hung forever: the watcher survived
        # the Ctrl+C, was adopted by `systemd --user`, and every `nix run .#dev` left
        # one more of them recompiling the tree in the background.
        #
        # Nothing reported it. The two tests above passed with the defect present,
        # because firing and dying are different things — and the second is only found
        # out hours later, when the machine is full of them.
        kill "$watcher" 2>/dev/null || true
        died=no
        for _ in $(seq 50); do
          [ -e /proc/$watcher ] || { died=yes; break; }
          sleep 0.2
        done
        [ "$died" = yes ] || {
          echo "ERROR: the watcher IGNORED the SIGTERM and is still alive." >&2
          echo "      It will be adopted by init and will recompile on its own for" >&2
          echo "      ever after. See the \`wait\` at the end of nix/reload.nix." >&2
          exit 1
        }

        # AND IT TAKES THE CHILDREN WITH IT. Killing only the script would leave the
        # `inotifywait` alive, waiting for an event nobody reads any more — invisible,
        # because its name does not bring this project to mind.
        leftover=$(pgrep -c inotifywait 2>/dev/null || true)
        [ "''${leftover:-0}" = 0 ] || {
          echo "ERROR: $leftover inotifywait processes were left after killing the watcher." >&2
          exit 1
        }

        echo "OK: .rs fires, the rest does not, and it dies when told"
      '';

  # ONE FOOTER PER SESSION — the second replaces the first, it does not add to it.
  #
  # # The defect this catches
  #
  # Restarting the footer was a FUNCTION inside `nix/dev.nix`, and the hot
  # reload's `rebuild` runs in the WATCHER's process. The function got there
  # through `export -f`, but the `rodapepid` it read is a shell variable, and a
  # shell variable does not cross a process. Under the watcher's `set -u` that
  # does not become a false `if`: it becomes `unbound variable`, which brings the
  # whole shell down — and the loop's `|| true` does not save it.
  #
  # In order: the old footer did not die, the new one did not come up, and the
  # watcher died. On screen, "compiling…" and nothing else, forever.
  #
  # The `reload-reloads` above does not catch this, and that is not its fault: it
  # proves that the command FIRES. Firing and restarting are different things,
  # and the second is only found out when two footers fight over the keyboard —
  # the shortcut list opens and no key works.
  footer-is-single =
    mkCheck "footer-is-single"
      [
        singleFooter
        pkgs.procps
      ]
      ''
        export HOME=$TMPDIR
        pidfile="$PWD/footer.pid"

        # A "footer" that only stands there. What is measured is the supervision, and a
        # real binary would bring a compositor, a GPU and fonts along with it.
        #
        # `printf` and not a heredoc: inside an indented Nix string the heredoc would
        # carry the indentation along, and a shebang with a space in front is not a
        # shebang — the error would show up as "file not executable", which does not
        # point at the cause.
        printf '#!/bin/sh\nexec sleep 300\n' > falso
        chmod +x falso

        ronoctua-footer-single "$pidfile" "$PWD/falso"
        first=$(cat "$pidfile")
        kill -0 "$first" || {
          echo "ERROR: the first footer did not come up." >&2
          exit 1
        }

        # THE SECOND. This is where the defect was.
        ronoctua-footer-single "$pidfile" "$PWD/falso"
        second=$(cat "$pidfile")

        [ "$first" != "$second" ] || {
          echo "ERROR: the pidfile did not change; the second footer did not come up." >&2
          exit 1
        }

        if kill -0 "$first" 2>/dev/null; then
          echo "ERROR: the previous footer ($first) is still alive_flag." >&2
          echo "      Two footers on the same display fight over the keyboard: the" >&2
          echo "      shortcut list opens on one and the keys go to the other." >&2
          exit 1
        fi

        kill -0 "$second" || {
          echo "ERROR: the new footer ($second) is not alive_flag." >&2
          exit 1
        }

        # AND THERE IS ONLY ONE. Counting is what separates "it replaced" from "it
        # killed the old one and brought up two".
        #
        # The `|| true` is INSIDE the braces: `pgrep` with no match at all exits 1,
        # and with `pipefail` that would bring the check down before counting.
        alive=$( { pgrep -f 'sleep 300' || true; } | wc -l)
        [ "$alive" = 1 ] || {
          echo "ERROR: there are $alive live footers; there should be exactly 1." >&2
          exit 1
        }

        kill "$second" 2>/dev/null || true
        echo "OK: the second footer replaces the first, and exactly one is left"
      '';

  # THE WATCHER STOPS WHEN THERE IS NOTHING LEFT TO WATCH FOR.
  #
  # # Why this check exists
  #
  # Because the owner ended a session with Ctrl+C and his terminal filled with
  # `footer <pid> standing` and `Error: raise the lifeline`, one turn every
  # 2.01 s, for an hour — measured on his machine, about 2000 turns and 8000
  # processes, with the watcher reparented to `systemd --user` and immune to a
  # second Ctrl+C.
  #
  # The loop in `footer-single.nix` re-executes the script, which starts
  # another footer AND another copy of the watcher, and it had no stopping
  # condition of any kind: no counter, no deadline, and no question about
  # whether there was still a compositor to draw on.
  #
  # # Why three existing checks could not see it
  #
  # `footer-is-single` exercises only the HAPPY path, where the restart
  # announces itself and the watcher takes its early exit. `dev-exits-clean`
  # runs `ronoctua-dev` against a display that does not exist, so the script
  # exits before a footer is ever started and no watcher is ever born. And
  # `a-dead-footer-is-not-a-dead-desktop` greps the script for the substrings
  # `lifeline` and `onpurpose` — both of which were present the whole time the
  # defect was.
  #
  # So this one reproduces it instead of reading about it: a footer killed from
  # OUTSIDE, with nothing announced, under a compositor that has gone.
  a-dead-footer-stays-dead =
    mkCheck "a-dead-footer-stays-dead"
      [
        singleFooter
        pkgs.procps
      ]
      ''
        export HOME=$TMPDIR
        pidfile="$PWD/footer.pid"

        # The same standing-there footer `footer-is-single` uses, and `printf`
        # for the same reason: a heredoc in an indented Nix string carries the
        # indentation into the shebang.
        printf '#!/bin/sh\nexec sleep 300\n' > falso
        chmod +x falso

        # A PID THAT CANNOT ANSWER, in the variable `dev.nix` exports.
        #
        # It used to be a socket NAME with the pid inside it, because the
        # previous compositor put it there. This one takes `SCROLLSOCK` as a
        # path with nothing to read, so `dev.nix` hands the pid over directly
        # (`RONOCTUA_COMPOSITOR_PID`) and this is the same question asked of the
        # same variable.
        #
        # A shell that has already exited is the cheapest dead PID there is; the
        # loop below is against the one chance in millions that it was recycled
        # before we looked.
        gone=$(sh -c 'echo $$')
        for _ in 1 2 3; do
          kill -0 "$gone" 2>/dev/null || break
          gone=$(sh -c 'echo $$')
        done
        export RONOCTUA_COMPOSITOR_PID="$gone"

        ronoctua-footer-single "$pidfile" "$PWD/falso"
        first=$(cat "$pidfile")
        kill -0 "$first" || {
          echo "ERROR: the footer did not come up; the rest proves nothing." >&2
          exit 1
        }

        # AND THE WATCHER IS REACHABLE, which is the half `dev.nix` needs: it
        # held the footer's PID in a file and the watcher's in nothing at all,
        # so the one thing that could resurrect a footer was the one thing the
        # session could not stop.
        [ -s "$pidfile.watcher" ] || {
          echo "ERROR: the watcher did not write its PID beside the footer's." >&2
          echo "      Without it, ending a session cannot stop the one process" >&2
          echo "      that starts footers." >&2
          exit 1
        }

        # FROM OUTSIDE, AND UNANNOUNCED — which is what a crash looks like, and
        # is what ending the session looked like for a year.
        kill "$first"

        # Six seconds is four turns of the old loop: the poll is one second and
        # the pause before a restart is another.
        sleep 6

        alive=$( { pgrep -f 'sleep 300' || true; } | wc -l)
        [ "$alive" = 0 ] || {
          echo "ERROR: $alive footer(s) came back with no compositor to draw on." >&2
          echo "      This is the loop the owner watched for an hour: each turn" >&2
          echo "      starts a footer that finds no Wayland display, dies, and" >&2
          echo "      leaves another watcher behind to do it again." >&2
          exit 1
        }

        # AND THE WATCHER TOOK ITS OWN PIDFILE WITH IT, so the next session does
        # not find a file naming a process that is gone.
        [ ! -e "$pidfile.watcher" ] || {
          echo "ERROR: the watcher left its pidfile behind." >&2
          exit 1
        }

        echo "OK: with the compositor gone, a dead footer stays dead"
      '';

  # THE SESSION ANNOUNCES THE DEATH IT ASKS FOR, AND IN THAT ORDER.
  #
  # # Why this is a check and not a comment
  #
  # `a-dead-footer-stays-dead` beside this one proves the watcher stops when
  # the compositor has gone. This one proves the OTHER half, which no behaviour
  # test in a sandbox can reach: that ending a session says so.
  #
  # `footer-single.nix` tells a death that was asked for from a crash by one
  # file — `<pidfile>.onpurpose` — and for a year `dev.nix`'s `shutdown` killed
  # the footer without writing it, and then deleted the pidfile on the way out
  # so the guard could never match even by accident. Every Ctrl+C therefore
  # read as a crash.
  #
  # ORDER IS HALF THE RULE, and it is the half a sabotage found: writing the
  # file AFTER the kill is a race the watcher usually wins, because it wakes
  # within a second of the footer dying and reads the file that is not there
  # yet. So the check reads the positions and not just the presence.
  #
  # It strips comment lines first. Two checks in this file have gone green over
  # a name that appeared only in prose, and the fix both times was this.
  the-dev-loop-ends-with-the-session =
    mkCheck "the-dev-loop-ends-with-the-session" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        # FILE-WIDE: what is asked is the ORDER of lines in two shell scripts —
        # which export comes before which launch, which write before which
        # kill. A script has no functions to narrow to.
        #
        # A COMMENT IS NOT A PROMISE. Both files are Nix strings holding shell,
        # and both comment with `#`. `hashless` is the prelude's answer, and it
        # is the better one: it takes a `#` off the END of a line too, which
        # the `startswith` test let stand.
        def code(path):
            return hashless(pathlib.Path(path).read_text())

        dev = code("${../nix/dev.nix}")
        single = code("${../nix/footer-single.nix}")
        floor(len(dev), 2000, "characters of nix/dev.nix")
        floor(len(single), 1000, "characters of nix/footer-single.nix")
        bad = []

        # --- ONE. The session can reach the watcher at all -------------------
        if ".watcher" not in single:
            bad.append("footer-single.nix no longer records the watcher's PID; "
                       "nothing outside it could then stop it")
        if 'kill "$(cat "$RONOCTUA_FOOTER_PID.watcher")"' not in dev:
            bad.append("dev.nix's shutdown does not stop the footer's watcher")

        # --- TWO. It announces, and it announces FIRST -----------------------
        said = dev.find('> "$RONOCTUA_FOOTER_PID.onpurpose"')
        killed = dev.find('kill "$footer"')
        if said < 0:
            bad.append("dev.nix's shutdown does not write .onpurpose; every Ctrl+C "
                       "would read as a crash and raise another footer")
        elif killed < 0:
            bad.append("dev.nix's shutdown no longer kills the footer by that name")
        elif said > killed:
            bad.append("dev.nix writes .onpurpose AFTER killing the footer; the "
                       "watcher wakes within a second and reads a file that is "
                       "not there yet")

        # --- THREE. And the session says who it is, before the footer --------
        told = dev.find('export RONOCTUA_DEV_PID=')
        started = dev.find("ronoctua-footer-single \\\\")
        if told < 0:
            bad.append("dev.nix does not export RONOCTUA_DEV_PID; the watcher "
                       "cannot tell a live session from a finished one")
        elif started >= 0 and told > started:
            bad.append("RONOCTUA_DEV_PID is exported AFTER the footer starts, so "
                       "the first footer of every session is watched by a watcher "
                       "that cannot see the session")

        # --- AND THE SESSION HANDS THE PID OVER ------------------------------
        #
        # The watcher below asks `RONOCTUA_COMPOSITOR_PID`, and a question
        # asked of a variable nobody exports is a guard that always answers
        # "still there" — which is the crash loop this whole check exists for.
        if "export RONOCTUA_COMPOSITOR_PID=" not in dev:
            bad.append("dev.nix does not export RONOCTUA_COMPOSITOR_PID; the "
                       "watcher's question about the compositor answers yes "
                       "for ever")

        # --- FOUR. The watcher declares all three, and the ceiling -----------
        for want, why in [
            ('$pidfile.onpurpose', "the guard that tells a requested death from a crash"),
            # THE COMPOSITOR'S PID, HANDED OVER — not derived from a socket
            # name. The previous compositor put its pid in the socket's
            # FILENAME, so the watcher read it from there and `dev.nix` had to
            # export nothing. This one takes `SCROLLSOCK` as a path, and the
            # loop gives it a `mktemp -u` name with nothing in it to read.
            ("RONOCTUA_COMPOSITOR_PID",
             "the guard that asks whether a compositor is still there"),
            ("RONOCTUA_DEV_PID", "the guard that asks whether the session is still there"),
            ("RONOCTUA_FOOTER_TRIES", "the ceiling on a footer that dies as it starts"),
        ]:
            if want not in single:
                bad.append(f"footer-single.nix lost {want} — {why}")

        # AND THE COMPOSITOR IS ASKED BY PID, never by whether its socket file is
        # on disk. A Wayland server killed by a signal leaves the socket behind:
        # measured, one was still there an hour after its the compositor was gone, so a
        # `[ -S ... ]` test would pass with the whole defect in place.
        if re.search(r"\[\s*-S\s", single):
            bad.append("footer-single.nix tests for a socket FILE; a killed "
                       "compositor leaves its socket on disk, so that question "
                       "answers yes for ever")

        if bad:
            for b in bad:
                print("ERROR: " + b, file=sys.stderr)
            sys.exit(1)
        print("OK: the session announces the death it asks for, and says who it is")
        END
      '';

  # THE POINTER LIGHTS WHAT THE CLICK WOULD TAKE.
  #
  # # Why this is a check
  #
  # Because the two are separate code in separate files and they drifted apart
  # twice, in opposite directions.
  #
  # `Field::covers` deliberately owns the one cell AFTER a field, so that a
  # click in the gap between two columns is not a dead click. The first time,
  # the painters did NOT count that gap and the hit test did: the last cell of
  # every field lit nothing and clicked something. The fix taught the painters
  # to call `covers` — which is the wrong half of the unification, and it is
  # what produced the second defect: `covers` answers "MAY this field own the
  # cell", so where fields are packed shoulder to shoulder both the field
  # before the cell and the field on it say yes, and a painter that asks per
  # field lights BOTH.
  #
  # The owner read that one off the screen, on the one row of this manager
  # where ten fields sit with no gap between them: *"ao colocar o cursor sobre
  # uma das letras de permissão, mais de uma (duas) letras estão alterando para
  # a cor de destaque do hover, mas deveria ser apenas uma"*. `owner:group` is
  # packed the same way and had the same defect.
  #
  # So the rule is not "count the gap" and not "do not count it": it is that
  # ONE walk answers both questions. `files::lit_field` is that walk, and this
  # check is what keeps both doors asking it.
  the-pointer-lights-what-the-click-takes =
    mkCheck "the-pointer-lights-what-the-click-takes" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        # FILE-WIDE: for the two doors, the offence is a `covers` asked per
        # field ANYWHERE a row is painted, and there were two such loops in
        # two different methods. `lit_field` itself is narrowed by name.
        home = pathlib.Path("${../crates/ronoctua-shell/src}")
        bad = []

        # THE ONE WALK, and it is a free function because two different types
        # carry the same fields: the manager's `Row` and the footer's expansion
        # row. A method on either would have been a second ruler for the other.
        files = code_of((home / "files.rs").read_text())
        floor(len(files), 10000, "characters of files.rs")
        # BY NAME AND BRACES. The whole signature was written out here, so
        # adding a parameter to `lit_field` reported that it had been deleted —
        # and `rposition` was looked for in the WHOLE FILE, where any other
        # backwards walk answered for it.
        lit = body_of(files, "lit_field")
        if lit is None:
            bad.append("files.rs no longer defines lit_field; there is nothing for "
                       "the two doors to agree through")
        elif "rposition" not in lit:
            bad.append("lit_field no longer walks from the RIGHT; with `position` "
                       "the cell under a character answers for the character "
                       "BEFORE it, through the gap rule")
        else:
            floor(len(lit), 30, "characters of `lit_field`")
        if "lit_field(&self.fields, cell)" not in files:
            bad.append("Row::field_index_at no longer goes through lit_field, so "
                       "the click and the paint are two walks again")

        # AND NEITHER PAINTER DECIDES FOR ITSELF. What is refused is `covers`
        # inside the loop that paints a row's fields — the shape the defect had
        # in both doors.
        for door, what in [("files_window.rs", "the window"), ("surface.rs", "the footer")]:
            src = code_of((home / door).read_text())
            floor(len(src), 10000, "characters of " + door)
            for hit in re.finditer(r"for \(?[^\n]*\bfields\b[^\n]*\{\n((?:[^\n]*\n){0,6})", src):
                if ".covers(" in hit.group(1):
                    line = src[: hit.start()].count("\n") + 1
                    bad.append(f"{door}:{line} asks `covers` per field while painting "
                               f"a row — {what} door would light two fields where "
                               f"they are packed with no gap")
            if "lit_field" not in src and "field_index_at" not in src:
                bad.append(f"{door} does not ask which field is lit; it cannot be "
                           f"drawing the pointer's subject")

        if bad:
            for b in bad:
                print("ERROR: " + b, file=sys.stderr)
            sys.exit(1)
        print("OK: one walk answers both 'which field lights' and 'which field is clicked'")
        END
      '';

  # THE CRATE THAT BELONGS TO NO APP STAYS THAT WAY.
  #
  # # Why this is a check and not a habit
  #
  # `ronoctua-atlas` is the globe's half that has no colour, no filesystem, no
  # clock and no dependency — which is what lets the installer (where there is
  # no store yet) and a future app ask it where a coordinate is without linking
  # a rasteriser, and what keeps it able to compile for `wasm32-wasip2`.
  #
  # None of that is visible from the inside: a crate that grows a dependency
  # still builds, still passes every test, and only stops being portable months
  # later when somebody tries. `ronoctua-syntax` keeps the same discipline by
  # prose; this turns it on the one that came after it.
  #
  # NOTE THAT PASSING DOES NOT MAKE IT INVARIANT 12's FOURTH CRATE. That
  # sentence names three, and adding to it is the owner's decision — this only
  # proves the capability is there to be claimed.
  atlas-crate-is-pure = mkCheck "atlas-crate-is-pure" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: purity is a property of the FILE — a `std::fs` anywhere in it
    # is the offence — and the dependency block is found by its header below.
    home = pathlib.Path("${../crates/ronoctua-atlas}")
    bad = []

    # --- ONE. No dependency at all ---------------------------------------
    # `hashless`: a manifest's comment begins with `#`, and a dependency
    # commented out is not a dependency.
    manifest = hashless((home / "Cargo.toml").read_text())
    floor(len(manifest), 100, "characters of Cargo.toml")
    block = re.search(r"\n\[dependencies\]\n(.*?)(\n\[|\Z)", manifest, re.S)
    lines = [
        l
        for l in (block.group(1).splitlines() if block else [])
        if l.strip() and not l.lstrip().startswith("#")
    ]
    if lines:
        bad.append(
            f"ronoctua-atlas has {len(lines)} dependency/ies; it is the crate that "
            "belongs to no app, and zero is what makes that true: "
            + ", ".join(l.split("=")[0].strip() for l in lines)
        )

    # --- TWO. `no_std`, and nothing that needs one -----------------------
    lib = code_of((home / "src/lib.rs").read_text())
    floor(len(lib), 1000, "characters of lib.rs")
    if "#![no_std]" not in lib:
        bad.append("lib.rs does not declare #![no_std]; the names it must not use "
                   "would be in scope again")
    swept = 0
    for source in sorted(home.rglob("*.rs")):
        text = code_of(source.read_text())
        swept += 1
        for forbidden, why in [
            ("std::fs", "a filesystem"),
            ("std::env", "the environment"),
            ("std::thread", "a thread"),
            ("option_env!", "a store path baked at compile time"),
        ]:
            if forbidden in text:
                bad.append(f"{source.name} reaches for {forbidden} — {why} is the "
                           "caller's, and this crate is compiled where it does not exist")

    floor(swept, 3, "sources of ronoctua-atlas swept for an impurity")
    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        sys.exit(1)
    print("OK: ronoctua-atlas has no dependency, no std and no environment")
    END
  '';

  # AND IT GIVES BACK A ROLE, NEVER A COLOUR.
  #
  # `ronoctua-syntax`'s rule, one subject along and for the same reason: the
  # crate is compiled inside components that receive no token value, so a colour
  # cannot cross that boundary. What crosses is an `Ink`, and the ONE place that
  # turns one into the other is `globe::ink_color` — whose `match` is
  # exhaustive, so a role added to the crate is a compile error in exactly one
  # file rather than a shape drawn in whatever colour was last set.
  atlas-returns-a-role = mkCheck "atlas-returns-a-role" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a hand-written colour anywhere in the crate is the offence, so
    # the file is the question. `ink_color` and `enum Ink` are narrowed by name
    # below.
    #
    # `uncommented` and never `code_of`: the second assertion looks for a HEX
    # LITERAL, and `code_of` would empty every string in the crate — leaving a
    # check that can no longer find the thing it exists to refuse.
    crate = pathlib.Path("${../crates/ronoctua-atlas}")
    shell = pathlib.Path("${../crates/ronoctua-shell/src}")
    bad = []
    swept = 0

    for source in sorted(crate.rglob("*.rs")):
        text = uncommented(source.read_text())
        swept += 1
        if "ronoctua_tokens" in text:
            bad.append(f"{source.name} names ronoctua_tokens; a colour is a token "
                       "value and this crate is compiled where there is none")
        hex_literal = re.search(r'"#[0-9A-Fa-f]{6}', text)
        if hex_literal:
            bad.append(f"{source.name} writes a colour out by hand (invariant 9)")

    # --- AND THE WALL IS ONE `match`, and exhaustive ---------------------
    floor(swept, 3, "sources of ronoctua-atlas swept for a colour")
    wall = uncommented((shell / "globe.rs").read_text())
    floor(len(wall), 4000, "characters of globe.rs")
    # BY NAME, not by the signature: adding a parameter to `ink_color` used to
    # be reported as the function having been deleted.
    arm = body_of(wall, "ink_color")
    if arm is None:
        bad.append("globe.rs no longer holds ink_color; there is no single place "
                   "that turns a role into a colour")
    else:
        floor(len(arm), 100, "characters of `ink_color`")
    role = uncommented((crate / "src/globe.rs").read_text())
    ink = scope(role, r"pub enum Ink\b")
    if ink is None:
        bad.append("ronoctua-atlas no longer declares `enum Ink`")
    else:
        names = re.findall(r"\n    (\w+),", ink)
        floor(len(names), 3, "roles the atlas answers with")
        for name in names:
            if arm is None or f"Ink::{name}" not in arm:
                bad.append(f"Ink::{name} has no colour in globe::ink_color")
    if "_ =>" in (arm or ""):
        bad.append("ink_color has a catch-all arm; the next role added would be "
                   "drawn in whatever colour that arm names")

    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        sys.exit(1)
    print("OK: the atlas answers with a role, and one exhaustive match turns it into a colour")
    END
  '';

  # THE WORLD ARRIVES AT RUN TIME, AND NOT AT COMPILE TIME.
  #
  # Six megabytes of borders and place names, in `atRunTime` and never in
  # `generated`. The difference is measured and written in `nix/rust.nix`: a
  # store path in `generated` is a compilation INPUT, so re-baking the table —
  # a newer Natural Earth tag, a fresher GeoNames dump, `cities1000` instead of
  # `cities500` — would rebuild all thirty-three crates at the 2m15–5m46 that
  # file records, and make both dependency layers wait on it.
  #
  # It is `deps-layer-is-lean`'s argument turned on one variable, plus the half
  # that check cannot see: that `nix/dev.nix` exports it BEFORE the footer
  # starts, so the globe does not work on an installed machine and do nothing in
  # the loop — which is the first place anybody looks.
  atlas-is-at-run-time = mkCheck "atlas-is-at-run-time" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: for the Rust half, what is asked is whether `globe.rs` reaches
    # for the path through `option_env!` ANYWHERE in it. The Nix half is
    # narrowed to one attribute block by `block` below.
    #
    # `hashless` for the Nix, whose comment is `#`; `uncommented` for the Rust,
    # because both needles there are string literals — the name of the variable
    # is the whole of what is being asserted.
    rust = hashless(pathlib.Path("${../nix/rust.nix}").read_text())
    floor(len(rust), 2000, "characters of nix/rust.nix")
    bad = []

    def block(name):
        m = re.search(r"\n  " + name + r" = [^\n]*\{(.*?)\n  \};", rust, re.S)
        return m.group(1) if m else ""

    if "RONOCTUA_ATLAS" not in block("atRunTime"):
        bad.append("RONOCTUA_ATLAS is not in atRunTime; the wrapper would not set it")
    for wrong in ("generated", "buildBase"):
        if "RONOCTUA_ATLAS" in block(wrong):
            bad.append(
                f"RONOCTUA_ATLAS is a {wrong} input: re-baking the atlas would "
                "rebuild 33 crates (2m15-5m46 measured), for a value no "
                "compilation reads"
            )

    # AND THE READER ASKS THE ENVIRONMENT, never the compiler.
    globe = uncommented(pathlib.Path("${../crates/ronoctua-shell/src}/globe.rs").read_text())
    floor(len(globe), 4000, "characters of globe.rs")
    if 'option_env!("RONOCTUA_ATLAS")' in globe:
        bad.append("globe.rs bakes the atlas path in with option_env!; the store "
                   "path would be a reference this binary carries into every closure")
    if 'var_os("RONOCTUA_ATLAS")' not in globe:
        bad.append("globe.rs does not read RONOCTUA_ATLAS from the environment")

    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        sys.exit(1)
    print("OK: the world arrives at run time, and re-baking it costs no compilation")
    END
  '';

  # THE ATTRIBUTION IS CARRIED IN ALL FOUR PLACES.
  #
  # GeoNames is CC BY 4.0 and the street packs are ODbL: both REQUIRE
  # attribution, and this repository is MIT + OFL (invariant 2), so none of it
  # may be silent. The four are the repository's own licence file, the header of
  # the file that names the sources, the SCREEN, and — the one that cannot be
  # separated from the data — a section inside the baked table itself.
  atlas-credits-are-carried = mkCheck "atlas-credits-are-carried" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, sys
    exec(open("${pyPrelude}").read())

    # PROSE: the attribution IS prose, and it lives in four whole files.
    # FILE-WIDE: none of the four has a function in it. CC BY 4.0 is
    # satisfied by the words being there — in a licence file, in a comment
    # above the sources, in a sentence on the screen. Stripping the comments
    # would take away three of the four places it lives.
    bad = []
    places = {
        "LICENSE-DATA.txt": pathlib.Path("${../LICENSE-DATA.txt}"),
        "assets/atlas.nix": pathlib.Path("${../assets/atlas.nix}"),
        "en-GB.ftl": pathlib.Path("${../assets/i18n/en-GB.ftl}"),
        "pt-BR.ftl": pathlib.Path("${../assets/i18n/pt-BR.ftl}"),
    }
    for name, path in places.items():
        if not path.exists():
            bad.append(f"{name} does not exist, and it is one of the four places "
                       "the attribution lives")
            continue
        text = path.read_text()
        if "GeoNames" not in text:
            bad.append(f"{name} does not name GeoNames — CC BY 4.0 requires the "
                       "attribution, and the screen is one of the four places")

    # AND THE TABLE CARRIES IT TOO, which is what makes a copy of the file
    # impossible to separate from its licence.
    floor(len(places), 4, "places the attribution has to live")
    gen = pathlib.Path("${../nix/scripts/gen-atlas.py}").read_text()
    floor(len(gen), 2000, "characters of gen-atlas.py")
    if "--credits" not in gen:
        bad.append("gen-atlas.py writes no credits section into the table")

    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        sys.exit(1)
    print("OK: the attribution is in the licence file, the sources, the screen and the table")
    END
  '';

  # THE METRES IN THE COMMENT ARE THE METRES IN THE CODE.
  #
  # AGENTS.md's own rule — *"meça de novo antes de confiar num tamanho escrito
  # num comentário"* — mechanised on the one number this feature rests on. The
  # quantisation is what makes six megabytes enough, and the argument for it is
  # that 611 m sits BELOW the resolution of 1:50 m data. A step that drifted
  # from its comment would leave that argument attached to a number that is no
  # longer true.
  #
  # It also refuses the other half: the generator and the reader must use ONE
  # grid. Two definitions of a grid is an index that finds nothing at the edges.
  atlas-quantisation-is-declared = mkCheck "atlas-quantisation-is-declared" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the three constants are module-level, in two files, and there
    # is no function to narrow to.
    #
    # HALF OF THIS CHECK IS ABOUT THE PROSE, and that half reads `raw` on
    # purpose: it compares the metres the comment CLAIMS against the metres the
    # constant works out to. The other half is about the constants, and reads
    # the stripped text — so a number written in a sentence can no longer
    # answer for a number in the code.
    raw = pathlib.Path("${../crates/ronoctua-atlas/src}/baked.rs").read_text()
    code = code_of(raw)
    floor(len(code), 500, "characters of baked.rs")
    # THE PROSE, UNWRAPPED. A doc comment carries `//!` at the start of every
    # line, so a sentence that wrapped has a marker in the middle of it — and a
    # check that searched the file as it is would report a missing comment that
    # is right there.
    baked = re.sub(r"\n\s*//[/!]?", " ", raw)
    gen = hashless(pathlib.Path("${../nix/scripts/gen-atlas.py}").read_text())
    floor(len(gen), 2000, "characters of gen-atlas.py")
    bad = []

    steps = re.search(r"pub const LON_STEPS: f32 = ([\d_]+)\.0;", code)
    if steps is None:
        bad.append("baked.rs no longer declares LON_STEPS")
    else:
        n = float(steps.group(1).replace("_", ""))
        # One step of longitude at the equator, on a sphere of 6 371 km.
        metres = 360.0 / n * 111_320.0
        # ACROSS A LINE BREAK, because prose wraps: the number and the words
        # after it are not always on one line, and a check that only matched
        # them together would report a missing comment that is there.
        said = re.search(r"about\s+(\d+)\s*m at the equator", baked, re.S)
        if said is None:
            bad.append("baked.rs no longer says how many metres a step is")
        elif abs(int(said.group(1)) - metres) > 5:
            bad.append(
                f"the longitude step is {metres:.0f} m and the comment says "
                f"{said.group(1)} m"
            )

        # AND THE GENERATOR USES THE SAME GRID.
        theirs = re.search(r"STEPS = ([\d_]+)\.0", gen)
        if theirs is None or float(theirs.group(1).replace("_", "")) != n:
            bad.append("gen-atlas.py quantises on a different grid from baked.rs; "
                       "an index built on one and read on the other finds nothing "
                       "at the edges")

    for name in ("CELLS_LON", "CELLS_LAT"):
        mine = re.search(name + r"(?::  *usize)? = (\d+)", code)
        theirs = re.search(name + r" = (\d+)", gen)
        if not mine or not theirs or mine.group(1) != theirs.group(1):
            bad.append(f"{name} differs between the reader and the generator")

    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        sys.exit(1)
    print("OK: the grid is one grid, and the metres in the comment are the metres in the code")
    END
  '';

  # A LAKE IS A HOLE, AND ONE LINE DECIDES IT.
  #
  # Nothing in the data tags an inner ring: a lake inside a country and an
  # island inside a lake are both just rings. The even-odd rule makes the answer
  # their PARITY, which is right without anybody deciding which is which — and
  # the winding rule would fill the Caspian with land.
  #
  # The same line is in two places by necessity (the lookup counts crossings,
  # the painter fills), and this refuses the other rule in both.
  atlas-fill-is-even-odd = mkCheck "atlas-fill-is-even-odd" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a fill rule is named where the path is built, and the parity
    # test is one line of one function — but the offence is either of them
    # appearing ANYWHERE in its file, which is what makes the file the right
    # question. The strip is what stops the prose explaining the rule from
    # answering for the rule.
    bad = []
    painter = code_of(pathlib.Path("${../crates/ronoctua-shell/src}/globe.rs").read_text())
    floor(len(painter), 4000, "characters of globe.rs")
    if "FillRule::Winding" in painter:
        bad.append("globe.rs fills with the winding rule — a shapefile does not "
                   "tag inner rings, so this puts land in the Caspian")
    if "FillRule::EvenOdd" not in painter:
        bad.append("globe.rs no longer names EvenOdd; the fill rule is the line "
                   "that decides whether a lake is a hole")

    lookup = code_of(pathlib.Path("${../crates/ronoctua-atlas/src}/lookup.rs").read_text())
    floor(len(lookup), 1000, "characters of lookup.rs")
    if "crossings % 2 == 1" not in lookup:
        bad.append("lookup.rs no longer answers by parity; a point inside a lake "
                   "inside a country would come back as being in neither")

    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        sys.exit(1)
    print("OK: parity decides what is inside, in the lookup and in the painter")
    END
  '';

  # THE GLOBE'S TEXTURE KEY CARRIES ITS OWNER — the one silent failure.
  #
  # A texture is named by what it is OF, how big it is and which theme painted
  # it. With two views able to show a globe, that is not enough: one coordinate
  # at one size in one theme resolves to a single key, both views redraw under
  # it every frame, and they overwrite each other — with nothing on screen and
  # nothing in any log saying so. `Images` has no remove-by-key either, so the
  # collision would outlive one of them closing.
  #
  # The owner enum exists before its second variant is reached for exactly this
  # reason: a key that gains a part later is a key that was colliding until it
  # did.
  globe-keys-are-unique-per-owner = mkCheck "globe-keys-are-unique-per-owner" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: `Globe::new`'s signature and the absence of a `Default` are
    # module-level facts. `texture_key` is narrowed by name below.
    globe = code_of(pathlib.Path("${../crates/ronoctua-shell/src}/globe.rs").read_text())
    floor(len(globe), 4000, "characters of globe.rs")
    bad = []

    key = body_of(globe, "texture_key")
    if key is None:
        bad.append("globe.rs no longer builds a texture key")
    else:
        body = key
        floor(len(body), 40, "characters of `texture_key`")
        for part, why in [
            ("owner", "two views showing one coordinate would overwrite each "
                      "other's frame every tick"),
            ("key", "two files would share one picture"),
            ("size", "a resized panel would draw the texture it had before"),
            ("theme", "a theme change would leave the old ink on the GPU"),
        ]:
            if part not in body:
                bad.append(f"the globe's texture key does not carry its {part}: {why}")

    if "pub fn new(owner: Owner)" not in globe:
        bad.append("Globe::new does not take an Owner; the key could then be "
                   "built without one")
    if re.search(r"impl Default for Globe", globe):
        bad.append("Globe has a Default; an owner that can be defaulted is an "
                   "owner two views can share by accident")

    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        sys.exit(1)
    print("OK: a globe's texture is named by its owner, its subject, its size and its theme")
    END
  '';

  # THE MANAGER DRAWS TWO PICTURES, AND THE CEILING KNOWS IT.
  #
  # `Images::prepare` takes what fits and DROPS the rest, with no error
  # anywhere. So a ceiling one too low means the globe simply never reaches the
  # GPU on a full region — the one failure in this whole feature with no
  # symptom at all.
  files-panels-have-two-pictures = mkCheck "files-panels-have-two-pictures" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: `CEILING` and the `Painted` struct are module-level — neither
    # is inside a function — and the `re.search` for the constant below is the
    # narrowing that matters.
    image = code_of(pathlib.Path("${../crates/ronoctua-render/src}/image.rs").read_text())
    window = code_of(pathlib.Path("${../crates/ronoctua-shell/src}/files_window.rs").read_text())
    floor(len(image), 4000, "characters of image.rs")
    floor(len(window), 10000, "characters of files_window.rs")
    bad = []

    if "MANAGER_PICTURES" not in image:
        bad.append("image.rs no longer says how many pictures the manager draws")
    ceiling = re.search(r"const CEILING: usize =(.*?);", image, re.S)
    if ceiling is None or "MANAGER_PICTURES" not in ceiling.group(1):
        bad.append(
            "the image ceiling does not count the manager's pictures; the globe "
            "would be dropped silently on a full region"
        )
    if "pub pictures: Vec<(String, ronoctua_render::image::Area)>" not in window:
        bad.append("Painted still carries ONE picture; the globe and the preview "
                   "cannot both be drawn")

    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        sys.exit(1)
    print("OK: the manager may draw two pictures, and the ceiling counts them")
    END
  '';

  # THE GRID IS ONE ARITHMETIC, and it is not this crate's.
  #
  # `ronoctua_design::Grid` exists because the three icon browsers each had
  # their own placement sum, and its own header records the symptom: "the click
  # landing on one item while the screen showed another". The manager's grid is
  # a fourth caller, and a fourth copy would be that defect a fourth time — on
  # the one screen where a mis-click deletes a file rather than picking an icon.
  the-grid-is-one-arithmetic = mkCheck "the-grid-is-one-arithmetic" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: "does any function outside the named ones divide by `across`"
    # is a question about the whole file by construction — the offence is a
    # SECOND arithmetic appearing anywhere. `whose` is what says which function
    # each hit landed in, and it is the prelude's copy of the `walls` idiom
    # this check used to carry by hand.
    files = pathlib.Path("${../crates/ronoctua-shell/src}/files.rs").read_text()
    grid = code_of(pathlib.Path("${../crates/ronoctua-design/src}/grid.rs").read_text())
    floor(len(grid), 1000, "characters of grid.rs")
    bad = []

    # THE DEFINITION STILL DEFINES. A check that only forbids would pass on the
    # day somebody deleted the pair and went back to hand.
    for name in ("pub fn at(", "pub fn index_at(", "pub const fn fitted("):
      if name not in grid:
        bad.append(f"ronoctua-design's Grid no longer has `{name}`")

    # AND THE MANAGER GOES THROUGH IT, in both directions.
    for name, why in (
      ("g.at(i)", "places a row"),
      ("g.index_at(", "finds the row a cell is on"),
      ("Grid::fitted(", "works out how many fit"),
    ):
      if name not in files:
        bad.append(f"files.rs no longer asks `{name}` to be what {why}")

    # AND NOBODY WORKS A SHELF OUT BY HAND.
    #
    # `across` is the number a second arithmetic would divide by. The places
    # that legally do are the ones converting BETWEEN units — entries to
    # shelves and back — and they are NAMED here, so a sixth one has to be
    # argued for rather than appear.
    #
    # THE PROSE IS CUT FIRST. The first shape of this read `/// … a band across
    # it` as a division, because a doc comment begins with a slash and this
    # file is mostly doc comments — a check that fires on its own explanations
    # teaches nothing.
    #
    # AND THE TESTS ARE CUT OFF, for the reason every other sweep of this file
    # cuts them: a test that PROVES the offset lands on a whole shelf has to do
    # the arithmetic to say so, and refusing it would be refusing the proof.
    # `files.rs` has a `#[cfg(test)]` inside a doc comment, so the LAST one is
    # the module.
    cut = [m.start() for m in re.finditer(r"^#\[cfg\(test\)\]", files, re.M)]
    files = files[: cut[-1]] if cut else files
    code = code_of(files)
    floor(len(code), 10000, "characters of files.rs before its tests")
    named = ("listing_room", "visual_cursor", "follow", "wheel", "thumb_shape",
             "shelf_rows", "moving_thumbs", "grid_pictures", "wants_thumbs",
             "sections_of")
    seen = 0
    for m in re.finditer(r"[/%]\s*(?:usize::from\()?\s*(?:g\.)?across\b", code):
      seen += 1
      inside = whose(code, m.start())
      if inside not in named:
        bad.append(f"`{inside}` divides by `across` and is not one of the named "
                   "conversions; that is a second grid arithmetic")
    floor(seen, 3, "conversions between entries and shelves")

    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        print("       `ronoctua_design::Grid` is the one placement sum this", file=sys.stderr)
        print("       project has, and `at`/`index_at` are the same sum in both", file=sys.stderr)
        print("       directions on purpose. See its own header.", file=sys.stderr)
        sys.exit(1)
    print("OK: the manager's grid is ronoctua-design's, in both directions")
    END
  '';

  # BOTH DOORS DRAW THUMBNAILS, because there are two and the view is one.
  #
  # This feature shipped once with the WINDOW wired and the footer not, and the
  # owner photographed the difference: *"a versão de rodapé não carrega as
  # thumbnails"*. Nothing failed — the footer drew glyphs, which is what a cell
  # with no picture is supposed to draw — so the half that was missing looked
  # exactly like a folder of documents.
  #
  # `every-list-window-has-a-bar` is the same shape, and it found its fifth
  # window by itself.
  both-doors-draw-thumbnails = mkCheck "both-doors-draw-thumbnails" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the question is whether a DOOR calls a thing at all, and a
    # door may call it from any of its handlers — there is no one function to
    # narrow to. What the strip buys is that the list of calls in this check's
    # own prose, quoted in a comment in either door, cannot answer for it.
    shell = pathlib.Path("${../crates/ronoctua-shell/src}")
    bad = []

    # WHAT A DOOR HAS TO DO to draw a grid, and what each one is for. A door
    # that did five of the six would look like a folder of documents.
    OWED = {
      "thumbs::pool(": "start the workers that make thumbnails",
      "wants_thumbs(": "ask for the ones on screen",
      "grid_pictures(": "work out where each one goes",
      "thumb_pixels(": "upload them",
      "thumbs::animator(": "start the thread that walks what moves",
      "hover_thumb(": "start a film under the pointer",
    }
    for door in ("files_window.rs", "surface.rs"):
      body = code_of((shell / door).read_text())
      floor(len(body), 10000, "characters of " + door)
      for call, why in OWED.items():
        if call not in body:
          bad.append(f"{door} does not `{call}` — it cannot {why}")

    # AND THE VIEW STILL OFFERS THEM, so a check that only reads the doors
    # cannot be satisfied by deleting the feature.
    files = code_of((shell / "files.rs").read_text())
    floor(len(files), 10000, "characters of files.rs")
    for name in ("pub fn wants_thumbs", "pub fn grid_pictures", "pub fn hover_thumb",
                 "pub fn moving_thumbs", "pub fn thumb_pixels"):
      if name not in files:
        bad.append(f"files.rs no longer has `{name}`")

    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        print("       ONE view, TWO doors: what one of them draws the other", file=sys.stderr)
        print("       draws. A half-wired door shows glyphs, which is what a", file=sys.stderr)
        print("       cell with no picture is meant to show — so the missing", file=sys.stderr)
        print("       half looks exactly like a folder of documents.", file=sys.stderr)
        sys.exit(1)
    print("OK: both doors make, place, upload and animate thumbnails")
    END
  '';

  # THE GRID NEVER HANDS THE RENDERER MORE PICTURES THAN IT DRAWS.
  #
  # `Images::prepare` takes what fits and DROPS the rest with nothing in any log
  # — its own comment calls that the one silent failure in the feature. So the
  # ceiling is honoured from BOTH ends: the renderer counts a screenful of
  # thumbnails into its ceiling, and the manager steps the thumbnail SIZE up
  # rather than asking for more cells than that. The two have to name one token
  # or the promise is a coincidence.
  the-grid-never-drops-a-picture = mkCheck "the-grid-never-drops-a-picture" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: for the renderer's half, `CEILING` and the buffer sized by it
    # are module-level, not inside a function. The manager's half is narrowed
    # to `thumb_item` by name.
    image = code_of(pathlib.Path("${../crates/ronoctua-render/src}/image.rs").read_text())
    files = code_of(pathlib.Path("${../crates/ronoctua-shell/src}/files.rs").read_text())
    floor(len(image), 4000, "characters of image.rs")
    floor(len(files), 10000, "characters of files.rs")
    bad = []

    ceiling = re.search(r"const CEILING: usize =(.*?);", image, re.S)
    if ceiling is None or "FILES_THUMBMOST" not in ceiling.group(1):
      bad.append("the renderer's ceiling does not count a screenful of "
                 "thumbnails; a grid would draw the first few and drop the rest "
                 "with nothing anywhere saying so")

    # AND THE INSTANCE BUFFER IS SIZED BY THE SAME NUMBER, or the ceiling is a
    # promise the vertex buffer cannot keep.
    if "size_of::<Instance>() * CEILING" not in image.replace("std::mem::", ""):
      bad.append("the instance buffer is no longer sized by CEILING")

    # AND THE MANAGER REFUSES TO ASK FOR MORE.
    item = body_of(files, "thumb_item")
    if item is None:
      bad.append("files.rs no longer chooses the thumbnail size in `thumb_item`")
    else:
      body = item
      if "FILES_THUMBMOST" not in body:
        bad.append("thumb_item does not bound itself by `space.files.thumbMost`; "
                   "a wide screen would ask for pictures the renderer drops")
      if ".fit()" not in body:
        bad.append("thumb_item does not count how many would fit")

    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        sys.exit(1)
    print("OK: both ends of the picture ceiling name one token")
    END
  '';

  # A THUMBNAIL IS ASKED FOR AT THE SIZE IT IS DRAWN.
  #
  # `picture_in` gives up `space.files.pictureAir` on all four sides and
  # `Area::centre` then SHRINKS whatever it is handed to fit what is left — so a
  # picture decoded at the box's outer size is always drawn a little smaller
  # than it was decoded. The owner photographed exactly that twice, as a map
  # that changed size between two scroll positions, and `files::globe_texture`
  # is where the subtraction was put so it could not be forgotten again.
  a-thumbnail-is-asked-at-the-size-it-is-drawn =
    mkCheck "a-thumbnail-is-asked-at-the-size-it-is-drawn" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        files = code_of(pathlib.Path("${../crates/ronoctua-shell/src}/files.rs").read_text())
        floor(len(files), 10000, "characters of files.rs")
        bad = []

        side = body_of(files, "thumb_side")
        if side is None:
          bad.append("files.rs no longer works out a thumbnail's decode size in "
                     "`thumb_side`")
        else:
          body = side
          floor(len(body), 100, "characters of `thumb_side`")
          if "FILES_PICTUREAIR" not in body:
            bad.append("thumb_side does not give up the air `picture_in` sheds, so "
                       "every thumbnail is decoded larger than it is drawn and "
                       "`Area::centre` shrinks it — the defect `globe_texture` "
                       "exists to stop")
          if "* 2.0" not in body:
            bad.append("thumb_side gives up the air on two sides and not four")

        # AND THE GLOBE'S OWN SUBTRACTION IS STILL THERE, which is what this one
        # was copied from: a check that only guards the copy would pass the day
        # the original went.
        if "pub fn globe_texture(" not in files:
          bad.append("files.rs no longer has `globe_texture`")

        if bad:
            for b in bad:
                print("ERROR: " + b, file=sys.stderr)
            sys.exit(1)
        print("OK: a thumbnail is decoded at the size it is drawn at")
        END
      '';

  # ONLY WHAT IS ON SCREEN IS ASKED ABOUT.
  #
  # One thumbnail costs a CHILD PROCESS — 109 ms for a 22 KB JPEG and 167 for a
  # 355 MB video, measured, because what is paid for is the process. A folder of
  # five thousand asked about at once is five thousand forks. The precedent is
  # literal: `Footer::request_visible_icons`, whose own comment says four
  # hundred icons cost seconds and three hundred and eighty are not on screen.
  only-visible-cells-are-asked-for = mkCheck "only-visible-cells-are-asked-for" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    files = code_of(pathlib.Path("${../crates/ronoctua-shell/src}/files.rs").read_text())
    floor(len(files), 10000, "characters of files.rs")
    bad = []

    for name in ("wants_thumbs", "moving_thumbs", "grid_pictures"):
      fn = body_of(files, name)
      if fn is None:
        bad.append(f"files.rs no longer has `{name}`")
        continue
      body = fn
      floor(len(body), 100, "characters of `" + name + "`")
      # THE WALK STOPS WHERE THE SCREEN DOES. `Section::line_of` answers `None`
      # past the last shelf that fits, which is the one place that knows.
      if "line_of(" not in body:
        bad.append(f"{name} does not ask `line_of` where the screen ends; it "
                   "would walk the whole directory")
      if "break" not in body:
        bad.append(f"{name} does not stop walking when the screen ends")

    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        sys.exit(1)
    print("OK: the grid asks only about the cells on screen")
    END
  '';

  # AN ANIMATOR HOLDS ONE FRAME, never the film.
  #
  # Measured on the owner's own sample: a forty-four-frame GIF decoded whole at
  # a thumbnail's size is 4,3 MiB, so fifty of them is 215 MiB — which is what
  # he asked this feature not to cost, in those words. Held one frame at a time
  # through `image`'s lazy iterator it is 2,35 ms and a decoder's canvas.
  an-animator-holds-one-frame = mkCheck "an-animator-holds-one-frame" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: "does anything in this file collect a film's frames" is a
    # question about the FILE — a collect anywhere costs the memory — and the
    # sweep below reports the line it found. `retune` is narrowed by name.
    thumbs = code_of(pathlib.Path("${../crates/ronoctua-shell/src}/thumbs.rs").read_text())
    floor(len(thumbs), 4000, "characters of thumbs.rs")
    bad = []

    if "image::Frames<'static>" not in thumbs:
      bad.append("the animator no longer holds a lazy frame iterator")
    # WHAT WOULD BREAK IT: materialising the frames.
    for m in re.finditer(r"frames[^\n]*\.collect\(\)|collect::<Vec<[^>]*Frame", thumbs):
      line = thumbs[: m.start()].count("\n") + 1
      bad.append(f"thumbs.rs:{line} collects a film's frames; fifty animated "
                 "GIFs would be 215 MiB, measured")
    # AND THE CEILING ON HOW MANY MOVE AT ONCE.
    tune = body_of(thumbs, "retune")
    if tune is None or "FILES_THUMBANIMATORS" not in tune:
      bad.append("the animator does not stop at `space.files.thumbAnimators`; "
                 "a folder of sixty GIFs would open sixty decoders")

    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        sys.exit(1)
    print("OK: the animator holds one frame per cell, and only so many cells")
    END
  '';

  # A PANEL'S RESERVED LINES ARE NOT ITS ROWS.
  #
  # `Section::above` used to be the listing's alone — the path and the header.
  # The globe takes lines off the top of the info panel the same way, so every
  # place that turned a LINE into a ROW had to learn it: the pointer on the
  # picture answered for the first fact, and paging by the region's height
  # stepped past facts nobody had seen.
  files-panel-rows-skip-the-reserve = mkCheck "files-panel-rows-skip-the-reserve" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, sys
    exec(open("${pyPrelude}").read())

    files = code_of(pathlib.Path("${../crates/ronoctua-shell/src}/files.rs").read_text())
    floor(len(files), 10000, "characters of files.rs")
    bad = []

    # NARROWED TO `row_of_line`, because the two arms below are the answer about
    # which line of a section is which ROW and nothing else's. Read against the
    # whole file, an arm written out in a comment — or the same shape in a
    # neighbouring `match` — answers for them.
    #
    # IT USED TO READ `hit`, which is where the arms lived until a drop needed
    # the same answer WITHOUT a field under the pointer (`View::row_under`, and
    # a folder has no size to draw). The arithmetic moved into one function that
    # both read, which is the promise getting STRONGER — and this check went red
    # on the move, which is the right way round: the sum has a home, so the
    # check reads the home. The name is not `row_of`: there is a METHOD of that
    # name in the same file that builds a `Row`, and `body_of` finds a name.
    row_of = must(body_of(files, "row_of_line"), "files.rs's `row_of_line`")
    floor(len(row_of), 100, "characters of `row_of_line`")
    if "_ if inside < sec.above => None," not in row_of:
        bad.append("row_of_line() does not skip a panel's reserved lines; the pointer "
                   "on the globe would answer for the first fact")
    if "_ => Some(sec.offset + inside - sec.above)," not in row_of:
        bad.append("row_of_line() adds a panel's reserve to its row index")
    # AND BOTH READINGS GO THROUGH IT. A second one written out would be the
    # defect this file exists to refuse, one column along.
    for who in ("hit", "row_under"):
        body = must(body_of(files, who), f"files.rs's `{who}`")
        if "row_of_line(" not in body:
            bad.append(f"{who}() works the row out itself instead of asking row_of_line()")
    if "pub fn info_room(&self)" not in files:
        bad.append("there is no one answer for how many ROWS the info panel has")
    if "self.info_room()" not in files:
        bad.append("nothing asks info_room(); the facts would page by the "
                   "region's lines and step past what the globe covers")

    if bad:
        for b in bad:
            print("ERROR: " + b, file=sys.stderr)
        sys.exit(1)
    print("OK: a panel's reserved lines are not counted as its rows")
    END
  '';

  # THE FOOTER'S LOG OUTLIVES THE TERMINAL.
  #
  # # Why this is a check
  #
  # Because the shortcuts hung FOUR times and on all four there was no proof at
  # all: the log went to the terminal and nowhere else. When the owner writes "it
  # happened again", what exists is the description of the symptom — which does
  # not tell "the key did not arrive" from "it arrived with a stuck modifier",
  # and the two are fixed in opposite places.
  #
  # The check also asserts what has already broken once in this same file: the
  # pidfile keeps the FOOTER's PID. Resolving the log with a `tee` in the middle
  # would make `$!` be the tee's, and the pidfile would keep the wrong process —
  # which is exactly the defect `footer-is-single` exists in order not to have.
  footer-logs-to-file =
    mkCheck "footer-logs-to-file"
      [
        singleFooter
        pkgs.procps
      ]
      ''
        export HOME=$TMPDIR
        pidfile="$PWD/footer.pid"
        export RONOCTUA_LOG="$PWD/footer.log"

        # THE FAKE ONE SAYS ITS OWN PID in the log. It is what makes it possible to
        # check that the pidfile keeps IT, and not a wrapper — after the `exec` the
        # command line becomes `sleep 300` and is no good for identifying anyone.
        printf '#!/bin/sh\necho "footer-mark $$"\nexec sleep 300\n' > falso
        chmod +x falso

        ronoctua-footer-single "$pidfile" "$PWD/falso"
        pid=$(cat "$pidfile")

        for _ in $(seq 50); do
          [ -s "$RONOCTUA_LOG" ] && break
          sleep 0.1
        done

        grep -q "footer-mark" "$RONOCTUA_LOG" || {
          echo "ERROR: the footer's log did not go to \$RONOCTUA_LOG." >&2
          echo "      With no file, the next time the shortcuts lock up there" >&2
          echo "      is no way to diagnose it that the four before it did not have:" >&2
          echo "      with nothing." >&2
          exit 1
        }

        # THE PIDFILE KEEPS THE FOOTER, and not a wrapper.
        reported=$(awk '/footer-mark/ {print $2; exit}' "$RONOCTUA_LOG")
        [ "$reported" = "$pid" ] || {
          echo "ERROR: the footer says it is pid $reported and the pidfile holds $pid." >&2
          echo "      A 'tee' in between would make \$! its own — and the shutdown" >&2
          echo "      in dev.nix would kill the wrong process." >&2
          exit 1
        }

        # AND THE SECOND ONE APPENDS, it does not wipe: the hot reload restarts the
        # footer on every edit, and a log truncated per restart loses precisely the
        # piece before the defect.
        ronoctua-footer-single "$pidfile" "$PWD/falso"
        second=$(cat "$pidfile")
        for _ in $(seq 50); do
          [ "$(grep -c "footer-mark" "$RONOCTUA_LOG")" = 2 ] && break
          sleep 0.1
        done
        n=$(grep -c "footer-mark" "$RONOCTUA_LOG")
        [ "$n" = 2 ] || {
          echo "ERROR: the log has $n marks after two footers; expected 2." >&2
          echo "      The restart is TRUNCATING the log." >&2
          exit 1
        }

        kill "$second" 2>/dev/null || true
        echo "OK: the footer's log goes to a file, builds up across restarts,"
        echo "    and the pidfile still points at the footer"
      '';

  # ZERO grid diff on the VT corpus (milestone 7, section 7.10).
  #
  # With a single engine, this is a golden file — it catches a regression, not a
  # divergence of interpretation. It is the degradation risk R1 prescribes, and
  # the binary itself says so in its output so nobody confuses the two.
  term-differential = mkCheck "term-differential" [ ] ''
    ${rust.workspace}/bin/ronoctua-term-diff \
      ${../tests/corpus-vt} ${../tests/golden-vt}
  '';

  installer-dryrun = mkCheck "installer-dryrun" [ ] ''
    # THE SECRETS ARE NAMED ONCE, and the grep below reads the same variables.
    #
    # They used to be typed twice — once in the `export` and once in the `grep`
    # — and a rename touched only one side: the check exported
    # `frase-secret_one-de-teste` and searched for `frase-secreta-de-teste`. It
    # went on passing while unable to detect a leaked passphrase at all, which is
    # the leak it exists for and the more damaging of the two.
    password=test-password
    passphrase=test-passphrase

    export RONOCTUA_INST_DISK=/dev/nvme0n1
    export RONOCTUA_INST_HOSTNAME=noctua-teste
    export RONOCTUA_INST_PASSWORD="$password"
    export RONOCTUA_INST_PASSPHRASE="$passphrase"
    # NOT the base language, and derived rather than named: the dry run has to
    # prove the ANSWER reaches `host.nix`, and a value equal to the default
    # would pass even if the answer were being dropped. `builtins.head` is the
    # base, so the last of the list is the one that cannot be it.
    export RONOCTUA_INST_LANGUAGE=${builtins.elemAt languages (builtins.length languages - 1)}
    # The sixth question. `br` and not the default: the dry run has to prove the
    # ANSWER reaches `host.nix`, and a value equal to the default would pass
    # even if the answer were being dropped.
    export RONOCTUA_INST_KEYBOARD=br
    # And the profile, `minimal` and not the default, for the same reason: an
    # answer equal to the default passes even when it is being dropped.
    export RONOCTUA_INST_PROFILE=minimal

    out_text=$(${rust.workspace}/bin/ronoctua-install)
    echo "$out_text"

    # The `host.nix` must NOT carry a secret (section 9): it goes to backup.
    if echo "$out_text" | grep -qF -e "$password" -e "$passphrase"; then
      echo "ERROR: the generated host.nix contains a secret" >&2
      exit 1
    fi

    # NO label may come out as a raw key.
    #
    # `Texts::t` gives back `[api_key]` for a key that does not exist — on purpose,
    # so as not to bring the shell down over a missing text. The side effect is
    # that an unregistered key gets past ALL the other guards: `gen-i18n.py` only
    # compares `pt-BR` with `en-GB`, and the compiler only protects whoever uses
    # `api_key::*`. The installer used a literal, and printed
    # `[inst-step-partition]` with nothing complaining.
    #
    # This line is what closes the hole at the flake's level.
    if echo "$out_text" | grep -q '\[inst-'; then
      echo "ERROR: a label came out as a raw key — invariant 8" >&2
      echo "$out_text" | grep '\[inst-' >&2
      exit 1
    fi

    # The LUKS key is written BEFORE the first destructive step. `disko` reads it
    # in the first second; the file being missing after the disk has been wiped is
    # the worst possible moment to find out.
    order=$(echo "$out_text" | grep -n 'disko-luks.key\|disko --mode' | cut -d: -f1)
    first_key=$(echo "$order" | head -1)
    disko_at=$(echo "$order" | tail -1)
    [ "$first_key" -lt "$disko_at" ] || {
      echo "ERROR: the LUKS key is written after disko has run" >&2; exit 1; }

    # THE PROFILE REACHES THE GENERATED `host.nix`.
    #
    # It is the line that decides whether the machine installs 22,8 GiB or 6,9,
    # and it is written on BOTH answers — `full` is the module's own default, so
    # a file that only mentions the profile when it differs would be a file one
    # has to already know the default to read.
    echo "$out_text" | grep -q 'ronoctua.profile = "minimal"' || {
      echo "ERROR: the profile's answer does not reach host.nix" >&2; exit 1; }

    # The password hash is written. Without it `base.nix` points
    # `hashedPasswordFile` at a file nobody creates, and the installed system comes
    # up with `mutableUsers = false` and no valid password — a machine nobody gets
    # into.
    echo "$out_text" | grep -q '/mnt/persist/etc/shadow/noctua' || {
      echo "ERROR: the plan does not write the password hash" >&2; exit 1; }

    # AND NOTHING ENROLS THE TPM. This demanded the opposite — the four PCRs,
    # 15 included — and it was right about the plan and wrong about the
    # machine: PCRs 11, 12 and 15 are extended only by a MEASURED UKI, which
    # needs lanzaboote and Secure Boot, and that chain is not installed. The
    # sealing matched on every boot for any volume, so the disk opened with
    # nothing asked and the protection meant to pay for that never existed.
    # `docs/ARCHITECTURE.md` carries the decision; this keeps it.
    if echo "$out_text" | grep -q 'cryptenroll'; then
      echo "ERROR: the plan enrols the TPM, which gives the disk away to" >&2
      echo "       whoever carries the laptop off — the sealing cannot hold" >&2
      echo "       without a measured UKI, and there is none here." >&2
      exit 1
    fi

    # And without `--execute` nothing runs. An installer that wipes a disk by
    # default is a dangerous command.
    #
    # The sentence comes from the `.ftl`, so matching the TEXT would tie the check
    # to one language — and the sandbox does not define `LANG`, so it would be
    # `en-GB`. What does not change with the language is the mention of
    # `--execute`, which is what the line actually promises.
    echo "$out_text" | grep -q -- '--execute' || {
      echo "ERROR: the rehearsal does not say how to run it for real" >&2; exit 1; }

    # And it proves it was a dry run: no step may have run. `nixos-facter` does not
    # even exist in the sandbox — if the installer tried, it would exit non-zero
    # and the check would already have died above at the `output=$(...)`.
    [ ! -e /tmp/disko-luks.key ] || {
      echo "ERROR: the rehearsal wrote the LUKS key" >&2; exit 1; }

    # The SAME plan in EVERY language: same number of steps, same commands. A
    # `.ftl` that lost a key would come out with `[inst-` and would already have
    # died above; what this catches is the subtler case of the language
    # changing what the installer DOES, and not only what it says.
    #
    # It used to run exactly two and compare them to each other, which is the
    # shape that cannot grow — and it also used `en_US`, which does not name a
    # UI language at all and so was really exercising the fallback. Each
    # language now runs under its OWN locale, derived the way `base.nix`
    # derives the list.
    steps=""
    howmany=""
    for language in ${lib.concatStringsSep " " languages}; do
      locale=$(echo "$language" | tr '-' '_').UTF-8
      n=$(LANG=$locale ${rust.workspace}/bin/ronoctua-install | grep -c '^[! ] [0-9]')
      steps="$steps $language=$n"
      if [ -z "$howmany" ]; then howmany=$n; fi
      [ "$n" = "$howmany" ] || {
        echo "ERROR: the plan is not the same in every language ($steps )" >&2; exit 1; }
    done

    echo "OK: $howmany steps in every language, four PCRs, a rehearsal by default"
  '';

  # The whole chain: signed UKI, Secure Boot and the proof of PCR 15 (milestone 8).
  secureBootVm = import ./secureboot-vm.nix {
    inherit pkgs lib sbKeys;
    lanzabooteModule = inputs.lanzaboote.nixosModules.lanzaboote;
  };

  # TPM2 sealing: it seals, unlocks, and refuses a volume with no token (milestone 8).
  tpmVm = import ./tpm-vm.nix { inherit pkgs lib; };

  # A native buffer in a window of its own, really drawing (milestone 7).
  bufferVm = import ./buffer-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
    bufferExample = buffers.example;
    bufferGlyphs = buffers.glyphs;
    bufferFormat = buffers.format;
  };

  # The memory panel on screen. A file of its own and not one more subtest of
  # the sibling: what it proves is the HOST reading a real `/proc` and a clock
  # that ticks, which no other buffer needs — and a failure there has nothing to
  # do with the mechanism `buffer-vm` guards.
  memoryVm = import ./memory-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
    bufferMemory = buffers.memory;
  };

  # The clipboard history: the native capture, the view and the re-copy (4.2).
  clipboardVm = import ./clipboard-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
  };

  # The terminal wired to the shell, with what is typed coming back to the screen (7.10).
  terminalVm = import ./terminal-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
  };

  # The leader as the Super key on its own: keyd standing and the compositor listening (7.4).
  #
  # The compositor module goes along because the test checks BOTH ends of the contract
  # — the key keyd emits and the one the compositor listens for.
  # The rescue console's second door: `Ctrl+Alt+Del` with no compositor at all.
  rescueVm = import ./rescue-vm.nix {
    inherit pkgs lib;
    ronoctua = {
      inherit fonts fontconfigConf iconSuperpack;
      # The theme list (the option's enum), the solved palettes and the
      # DEFAULT — base.nix and scroll.nix read all three.
      #
      # `defaultTheme` was missing here, and `ronoctua.theme`'s option reads it
      # for its `default`: every VM test that imports `base.nix` failed to
      # EVALUATE with "attribute 'defaultTheme' missing". It arrived when order
      # and default became two facts in `assets/themes/themes.nix`, and it went
      # unseen because these tests are in `most`, which had not been run since.
      inherit themes themed defaultTheme;
      inherit cursors;
      inherit scroll;
      shell = rust.shell;
    };
  };

  # The file manager's privileged half: the unit, the polkit rule, and the
  # refusals the helper makes before it acts. Only a booted machine answers any
  # of them.
  # The disk border's other half: what only a booted machine answers — that
  # udisks is D-Bus activatable, that its udev rules arrived, that upstream's
  # polkit defaults are still the two numbers the design rests on, and that a
  # SYSTEM volume refuses with a name instead of hanging. The removable half is
  # proved against a real pendrive; see the file for why neither can do both.
  # The slimmed udisks the disks module installs — the same expression, so the
  # check reads the artefact the system actually gets and not a lookalike.
  slimUdisks = self.nixosConfigurations.vm.config.services.udisks2.package;

  disksVm = import ./disks-vm.nix {
    inherit pkgs lib;
    formatDisk = rust.formatDisk;
    ronoctua = {
      inherit fonts fontconfigConf iconSuperpack;
      # The theme list (the option's enum), the solved palettes and the
      # DEFAULT — base.nix and scroll.nix read all three.
      #
      # `defaultTheme` was missing here, and `ronoctua.theme`'s option reads it
      # for its `default`: every VM test that imports `base.nix` failed to
      # EVALUATE with "attribute 'defaultTheme' missing". It arrived when order
      # and default became two facts in `assets/themes/themes.nix`, and it went
      # unseen because these tests are in `most`, which had not been run since.
      inherit themes themed defaultTheme;
      inherit cursors;
      inherit scroll;
      shell = rust.shell;
      filesRoot = rust.filesRoot;
    };
  };

  filesVm = import ./files-vm.nix {
    inherit pkgs lib;
    ronoctua = {
      inherit fonts fontconfigConf iconSuperpack;
      # The theme list (the option's enum), the solved palettes and the
      # DEFAULT — base.nix and scroll.nix read all three.
      #
      # `defaultTheme` was missing here, and `ronoctua.theme`'s option reads it
      # for its `default`: every VM test that imports `base.nix` failed to
      # EVALUATE with "attribute 'defaultTheme' missing". It arrived when order
      # and default became two facts in `assets/themes/themes.nix`, and it went
      # unseen because these tests are in `most`, which had not been run since.
      inherit themes themed defaultTheme;
      inherit cursors;
      inherit scroll;
      shell = rust.shell;
      filesRoot = rust.filesRoot;
    };
  };

  # The transfer queue reaching the SCREEN: the unit comes up, the footer finds
  # it, the segment resolves to columns in the modeline, and `LEADER t t` opens
  # the panel with the list the footer already had.
  transfersVm = import ./transfers-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
    ronoctua-transfers = rust.transfers;
  };

  extensionVm = import ./extension-vm.nix {
    inherit pkgs lib extension;
    ronoctua-shell = rust.shell;
    ronoctua-transfers = rust.transfers;
  };

  keyboardVm = import ./keyboard-vm.nix {
    inherit pkgs lib;
    ronoctua = {
      inherit fonts fontconfigConf iconSuperpack;
      # The theme list (the option's enum), the solved palettes and the
      # DEFAULT — base.nix and scroll.nix read all three.
      #
      # `defaultTheme` was missing here, and `ronoctua.theme`'s option reads it
      # for its `default`: every VM test that imports `base.nix` failed to
      # EVALUATE with "attribute 'defaultTheme' missing". It arrived when order
      # and default became two facts in `assets/themes/themes.nix`, and it went
      # unseen because these tests are in `most`, which had not been run since.
      inherit themes themed defaultTheme;
      inherit cursors;
      inherit scroll;
      shell = rust.shell;
    };
  };

  # One satellite per buffer scope, proved with TWO X11 apps (9.1).
  x11Vm = import ./x11-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
  };

  # The root's wipe, proved between two boots (milestone 7).
  impermanenceVm = import ./impermanence-vm.nix { inherit pkgs lib; };

  # Leader, which-key and the return to rest (milestone 5).
  leaderVm = import ./leader-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
  };

  # The app finder, and the footer that must not freeze when opening one.
  appsVm = import ./apps-vm.nix {
    inherit pkgs lib fonts;
    inherit scroll;
    ronoctua-shell = rust.shell;
  };

  # The contract against the pinned compositor (milestone 4). See the file
  # for why there is no second version any more.
  compositorContract = import ./compositor-contract.nix {
    inherit pkgs lib scroll;
    ronoctua-shell = rust.shell;
  };

  # -------------------------------------------------------------------
  # Granular checks of milestone 1
  # -------------------------------------------------------------------

  # THE FLAKE'S TREE MUST NOT GET FAT. It cost 793 GB to find out.
  #
  # This project is not a git repository (invariant 2), and it is git's index
  # that Nix uses to filter a flake's source. With no git, `nix flake check`
  # copies the WHOLE directory into the store — and since the path is
  # content-addressed, EVERY EDIT mints a new copy.
  #
  # With an 18 GB `target/` inside, that gave 44 copies and 793 GB: 94% of the
  # store and 42% of the disk, with nothing warning. The `nix/rust.nix` already
  # filtered the source `crane` compiles, but that filter runs LATER — the 19 GB
  # copy has already happened at evaluation time.
  #
  # The fix is keeping the build outside the tree (`CARGO_TARGET_DIR`, see
  # `nix/devshell.nix`). This check is what stops the fix from being lost: the
  # cost is invisible day to day and only shows up when the disk fills.
  #
  # THE DEPENDENCY LAYER SEES ONLY WHAT IT USES.
  #
  # `buildDepsOnly` compiles the 483 third-party crates against stubs — crane
  # replaces every crate of ours, `build.rs` included. So it reads none of the
  # generated inputs; and yet all 31 `RONOCTUA_*` were in its environment,
  # because it was handed the whole of `commonArgs`.
  #
  # Nix addresses a derivation by its inputs. With `RONOCTUA_BUFFER_MEMORY` in
  # there, editing a buffer changed the layer's hash and paid 4m46 of
  # compilation for a value nothing in it reads — and made the layer WAIT for
  # five wasm builds it never consumes. A `.ftl` or a token did the same.
  #
  # This reads the attributes of the generated derivation, at evaluation time:
  # no build, no import-from-derivation. It is the environment that is checked
  # because the environment is how they got in — the five buffers were never
  # named in `nix/rust.nix`'s deps call, they arrived carried by a variable.
  deps-layer-is-lean =
    let
      # BOTH LAYERS, because there are two: one per cargo profile, and the
      # loop's is the one the tests, clippy and `nix run .#dev` all wait on.
      # Checking only the first would leave the layer that is rebuilt most
      # often unguarded.
      of = layer: lib.filter (lib.hasPrefix "RONOCTUA_") (lib.attrNames layer.drvAttrs);
      leaked = of rust.cargoArtifacts ++ of rust.loopArtifacts;
    in
    mkCheck "deps-layer-is-lean" [ ] ''
      leaked="${lib.concatStringsSep " " leaked}"
      if [ -n "$leaked" ]; then
        echo "ERROR: a dependency layer was given variables it does not use:" >&2
        for v in $leaked; do echo "  $v" >&2; done
        echo >&2
        echo "      They come in through \`commonArgs\`; the layer has to take the" >&2
        echo "      \`buildBase\`. Each one of those costs 4m46 of recompilation" >&2
        echo "      every time its value changes — and a .wasm changes every time" >&2
        echo "      somebody edits the buffer." >&2
        exit 1
      fi
      echo "OK: neither dependency layer carries a RONOCTUA_* at all"
    '';

  lean-tree = mkCheck "lean-tree" [ ] ''
    cap=20480  # KiB — the real tree is ~1.3 MB
    tree_size=$(du -s --exclude=.git ${self} | cut -f1)
    echo "flake source: $tree_size KiB (ceiling $cap KiB)"
    if [ "$tree_size" -gt "$cap" ]; then
      echo >&2
      echo "ERROR: the tree copied into the store is $tree_size KiB." >&2
      echo >&2
      echo "Every edit to ANY file mints a copy of this size." >&2
      echo "Look for a build directory inside the tree:" >&2
      du -sh ${self}/* 2>/dev/null | sort -rh | head -5 >&2
      echo >&2
      echo "Builds go to \$CARGO_TARGET_DIR, outside the tree." >&2
      exit 1
    fi
  '';

  # The mistake section 1 of the document explicitly says to avoid: the
  # .gitignore swallowing the font files that come to live in the repo.
  #
  # We cannot run `git check-ignore` against the real repository (there is no
  # git, by the decision of section 1), so we assemble a throwaway repo with
  # OUR .gitignore and the real tree of paths.
  gitignore-keeps-fonts = mkCheck "gitignore-keeps-fonts" [ pkgs.git ] ''
    export HOME=$TMPDIR
    mkdir -p repo && cd repo
    git init -q .
    cp ${../.gitignore} .gitignore

    # Recreates the real paths as empty files. The fonts are NOT here any more
    # (they are a Release asset), so what has to survive the .gitignore is the
    # hand-kept content and the code.
    while IFS= read -r f; do
      mkdir -p "$(dirname "$f")"
      : > "$f"
    done < ${
      pkgs.writeText "tracked-paths.txt" (
        lib.concatStringsSep "\n" [
          "assets/lexicon/tags.en-pt.toml"
          "assets/lexicon/overlay.toml"
          "assets/icons/tray-glyphs.nix"
          "assets/tokens/.keep"
          "nix/fonts.nix"
          "nix/scripts/fix-font-names.py"
          "nix/scripts/make-console-psf.py"
          "docs/ARCHITECTURE.md"
          "tests/checks.nix"
          "flake.nix"
          "AGENTS.md"
          "CLAUDE.md"
          "README.md"
        ]
      )
    }

    failed=0
    while IFS= read -r f; do
      if git check-ignore -q "$f"; then
        echo "ERROR: .gitignore is swallowing $f" >&2
        failed=1
      fi
    done < <(find assets nix docs tests -type f 2>/dev/null; ls flake.nix AGENTS.md CLAUDE.md README.md)
    [ $failed -eq 0 ] || exit 1
    echo "OK: no versioned source is ignored"

    # And the other way round: what MUST be ignored.
    for f in .TEMP/x.ttf result nix/hosts/host.nix foo.qcow2 a.key some.age; do
      mkdir -p "$(dirname "$f")"; : > "$f"
      git check-ignore -q "$f" || { echo "ERROR: $f is not being ignored" >&2; exit 1; }
    done
    echo "OK: secrets, artefacts and host.nix are ignored"
  '';

  # Proof that the naming fix caught: ONE typographic family and 135 distinct
  # (family, subfamily) pairs, with no collision between SemiExtended
  # (usWidthClass 6) and Extended (7).
  #
  # The TTFs are fixed and MUST have a unique family. The WOFF2s pass through
  # untouched on purpose (see the note in nix/fonts.nix), so on them we only
  # take inventory — demanding a unique family there would assert something false.
  fonts-single-family = mkCheck "fonts-single-family" [ py ] ''
    echo "### corrected: one family, and it is required ###"
    python3 ${../nix/scripts/fix-font-names.py} ${fonts.corrected}/TTF-nerdfonts \
      --family "NoctuaIosevka Nerd Font Mono" --expect-count 135 --dry-run
    python3 ${../nix/scripts/fix-font-names.py} ${fonts.corrected}/TTF \
      --family "Noctua Iosevka" --expect-count 135 --dry-run

    echo
    echo "### intactos: so inventario ###"
    python3 ${../nix/scripts/fix-font-names.py} ${fonts.corrected}/WOFF2-nerdfonts \
      --family "NoctuaIosevka Nerd Font Mono" --expect-count 135 --inventory
    python3 ${../nix/scripts/fix-font-names.py} ${fonts.corrected}/WOFF2 \
      --family "Noctua Iosevka" --expect-count 135 --inventory
  '';

  # Invariants of the inventory, measured and not assumed. If the font is
  # swapped for another build, this fails and forces a review of the plan —
  # instead of the footer silently going out of alignment.
  fonts-metrics = mkCheck "fonts-metrics" [ py ] ''
    python3 - <<'PY'
    from fontTools.ttLib import TTFont
    import glob, sys

    failed = False
    expected_cp = 18053
    advances = {3: 456, 4: 548, 5: 600, 6: 658, 7: 720}

    for p in sorted(glob.glob("${fonts.corrected}/TTF-nerdfonts/*.ttf")):
        f = TTFont(p, lazy=True)
        cmap = f.getBestCmap()
        os2 = f["OS/2"]
        head = f["head"]

        if head.unitsPerEm != 1000:
            print(f"ERROR {p}: unitsPerEm {head.unitsPerEm} != 1000"); failed = True
        if len(cmap) != expected_cp:
            print(f"ERROR {p}: {len(cmap)} codepoints, expected {expected_cp}"); failed = True

        # Exact monospacing: ONE advance per face, that of its own width.
        width = os2.usWidthClass
        adv = {f["hmtx"][g][0] for g in cmap.values()}
        if len(adv) != 1:
            print(f"ERROR {p}: {len(adv)} distinct advances; it is not monospaced"); failed = True
        elif adv.pop() != advances[width]:
            print(f"ERROR {p}: the wrong advance for usWidthClass {width}"); failed = True
        f.close()

    if failed:
        sys.exit(1)
    print("OK: 135 faces, 18,053 codepoints each, monospaced, upem 1000")
    print("OK: cell = 0.600 em at the normal width — the footer's arithmetic holds")
    PY
  '';

  # THE ICON HAS TO BE THE SIZE OF THE TEXT NEXT TO IT — and it was not.
  #
  # Reported from the screen: "the bell looks much too small, smaller than the
  # rest of the letters and numbers". It was true and it is measurable: the ink
  # of `cod-bell` is 600 units tall against 751 for the digit `0`, so at the
  # same point size the bell comes out a fifth shorter. Nothing failed; it just
  # looked wrong, which is the class of defect that survives for months.
  #
  # The fix is the `font.size.icon` token, and this is what keeps it honest: the
  # two numbers come from the token file, the ink comes from the real face, and
  # a new chrome icon whose drawing is out of scale fails HERE instead of on
  # somebody's screen.
  #
  # 85%..115% and not "equal": these are different families of drawing (a bell,
  # a swap arrow, a pie) and they are not going to agree to the unit. What the
  # band excludes is what the eye reads as another size.
  chrome-icons-match-the-text =
    let
      typography = import ../assets/tokens/typography.nix;
    in
    mkCheck "chrome-icons-match-the-text" [ py pkgs.gnugrep ] ''
      python3 - <<'PY'
      from fontTools.ttLib import TTFont
      from fontTools.pens.boundsPen import BoundsPen
      import json, sys

      BASE = ${toString typography.size.base}
      TOLERANCE = ${toString typography.chromeTolerance}
      ICON = ${toString typography.size.icon}

      # THE ICONS THE CHROME DRAWS INLINE WITH TEXT, at `font.size.icon`.
      #
      # They are named here, and not derived by prefix, because the prefix is
      # not the property: `transfer-paused` and `transfer-running` share the
      # family and are drawn in the transfer PANEL, on the grid, next to a row
      # of their own. What this list holds is what sits shoulder to shoulder
      # with digits on one line.
      INLINE = [
          "notification-pending",
          # THE BATTERY'S LADDER AND THE PROFILE'S MARK sit beside the `NN%`
          # digits and the rest of the line, so they are measured here too.
          "battery-low",
          "battery-half",
          "battery-high",
          "battery-full",
          "battery-charging-empty",
          "battery-charging-low",
          "battery-charging-half",
          "battery-charging-high",
          "battery-charging-full",
          "battery-danger",
          "profile-power-saver",
          "profile-balanced",
          # THE DEVICE MARKS sit beside the same `NN%` digits, four at a time.
          "bluetooth-device-headphones",
          "bluetooth-device-headset",
          "bluetooth-device-speaker",
          "bluetooth-device-keyboard",
          "bluetooth-device-mouse",
          "bluetooth-device-gamepad",
          "bluetooth-device-tablet",
          "bluetooth-device-phone",
          "bluetooth-device-computer",
          "bluetooth-device-watch",
          "bluetooth-device-camera",
          "bluetooth-device-printer",
          "bluetooth-device-network",
          "bluetooth-device-display",
          "bluetooth-device-unknown",
          "bluetooth-connected",
          "bluetooth-off",
          # THE WAY OUT'S THREE, beside the same digits.
          "no-internet",
          "airplane",
          "vpn",
          "tailscale",
          "tor",
          # AND THE NETWORK VIEW'S ROWS, whose glyph is the first thing in the
          # row's LABEL — shoulder to shoulder with the interface's name and
          # the network's. It used to be a column of its own, which is why the
          # arc-shaped `wifi_strength` family went unmeasured for so long.
          "wifi-none",
          "wifi-weak",
          "wifi-fair",
          "wifi-good",
          "wifi-strong",
          "wifi-off",
          "network-secured",
          "ethernet",
          # The two things one does to a notification with the mouse, and the
          # second drawing of the first: the closed envelope that puts a row
          # back to unread.
          "notification-mark-read", "notification-mark-unread", "notification-delete",
          # And the generic marks, for what nobody named a glyph for.
          "info", "warning", "error",
          "transfer",
          "countdown-one", "countdown-two", "countdown-three", "countdown-four",
          "countdown-five", "countdown-six", "countdown-seven", "countdown-eight",
          # AND THE TWO FRAMES OF "AN UPDATE IS RUNNING", which sit in the
          # modeline beside the buffer's name and the marks beside it. They are
          # measured for the same reason the pie is: an animation whose frames
          # are 20% shorter than the text next to them does not read as one
          # drawing moving, it reads as the line twitching. Here the two frames
          # are the same circle filled and hollow, so the measurement is also
          # what keeps them the same drawing.
          "working-one", "working-two",
      ]

      face = "${fonts.corrected}/TTF-nerdfonts/NoctuaIosevkaNerdFontMono-Regular.ttf"
      f = TTFont(face, lazy=True)
      cmap = f.getBestCmap()
      glyphs = f.getGlyphSet()
      icons = json.load(open("${glyphdb.db}/icons.json"))

      # THE MARKS FACE IS ONE OF THE READERS TOO.
      #
      # A mark this repository draws is an icon on the same modeline, beside
      # the same text, and it has to answer the same band — but it lives in
      # another face (`nix/marksgen.nix`), so asking the Nerd Font for its
      # codepoint is a `KeyError` and not a measurement. Both faces are asked,
      # in the order the renderer asks them.
      marks_face = TTFont("${marksdb.db}/NoctuaMarks.ttf", lazy=True)
      marks_cmap = marks_face.getBestCmap()
      marks_glyphs = marks_face.getGlyphSet()

      def ink(cp):
          table, shapes = (cmap, glyphs) if cp in cmap else (marks_cmap, marks_glyphs)
          if cp not in table:
              raise SystemExit(
                  f"U+{cp:05X} is in no face this check knows: neither the Nerd "
                  "Font nor the marks."
              )
          pen = BoundsPen(shapes)
          shapes[table[cp]].draw(pen)
          return pen.bounds

      x0, y0, x1, y1 = ink(ord("0"))
      digit = (y1 - y0) * BASE / 1000.0
      # THE CELL, and how far into it the neighbouring digit's ink begins.
      #
      # A chrome glyph is drawn bigger than the grid and centred on its cell, so
      # its ink DOES leave the cell — by design, and harmlessly, as long as it
      # stops short of where the character beside it starts drawing. That is
      # what this number is: `0` has 80 units of left bearing, which at the base
      # size is 1,44 px of air the icon may borrow.
      cell = BASE * 0.6
      bearing = x0 * BASE / 1000.0
      print(f"digit `0` at {BASE} px: {digit:.2f} px of ink, bearing {bearing:.2f} px")

      # THE ONE SHAPE THE BAND CANNOT MEASURE, by name and with its reason.
      #
      # The band asks whether a drawing is as tall as the digit, because the
      # defect it was born from was a bell with room to grow that was not
      # using it. A WIDE drawing has no such room: its ink already spans the
      # cell, and a size that made it as tall as the digit would push it into
      # the character beside it. There is no square keyboard in the font, and
      # a keyboard is what the row is about — so this one is measured by the
      # other rule: it must FILL the cell and it must not be a sliver. The
      # `deviations` of `owl.reference.nix`, in another file.
      WIDE = {
          "bluetooth-device-keyboard": "a keyboard is drawn wide and flat; nothing square in the font means keyboard",
          "tailscale": "four dots, three across and one under the middle: three cells wide by two tall, and a dot has to stay round",
      }
      FLOOR = 0.60

      failed = False
      for token in INLINE:
          if token not in icons:
              print(f"ERROR: `{token}` is not an icon token (renamed?)")
              failed = True
              continue
          gx0, gy0, gx1, gy1 = ink(icons[token]["codepoint"])
          # THE SIZE THIS GLYPH IS DRAWN AT — measured by `gen-glyphdb.py`
          # against this same face, and generated into
          # `tokens::icon::chrome_size`. `font.size.icon` is its ceiling: a
          # small drawing is brought up to the digit; a tall one (the vertical
          # battery, 908 units against the digit's 751) is brought DOWN to
          # it, and this is where a drawing of another proportion is caught
          # instead of on somebody's screen.
          size = float(icons[token]["chrome"])
          if size > ICON:
              print(f"ERROR: `{token}` is drawn at {size} px, past font.size.icon ({ICON})")
              failed = True
              continue
          h = (gy1 - gy0) * size / 1000.0
          pct = 100.0 * h / digit
          # The run is placed so its ADVANCE is centred on the cell — see
          # `render::Size::OnTheCell` — and the ink rides wherever the font put
          # it inside that advance, which is not always the middle.
          shift = (cell - size * 0.6) / 2.0
          over = max(-(gx0 * size / 1000.0 + shift), gx1 * size / 1000.0 + shift - cell)
          ink_wide = (gx1 - gx0) * size / 1000.0
          if token in WIDE:
              # As large as the cell allows, and not a sliver.
              tall = ink_wide >= cell and h >= FLOOR * digit
              why = "  (wide: " + WIDE[token] + ")"
          else:
              tall = 100.0 - TOLERANCE <= pct <= 100.0 + TOLERANCE
              why = ""
          wide = over < bearing
          mark = "ok " if tall and wide else "NO "
          print(
              f"{mark} {token:24s} {icons[token]['glyph']:28s} "
              f"{size:4.0f} px -> {h:5.2f} px {pct:5.1f}%  overflows {over:5.2f} px{why}"
          )
          if not tall:
              failed = True
          if not wide:
              print(f"       `{token}` invades the ink of the character beside it")
              failed = True

      if failed:
          print("")
          print("ERROR: a chrome icon is out of scale with the text beside it.")
          print("      Either `font.size.icon` changed, or the new glyph has a drawing")
          print("      that no size within the ceiling brings to the digit's height —")
          print("      change the glyph, not the ceiling: it holds for all the others.")
          sys.exit(1)
      print("")
      # AND NOBODY WIDENS THE EXCEPTION QUIETLY: the list is named here, and
      # a token that stops being drawn inline has to leave both lists.
      unused = sorted(t for t in WIDE if t not in INLINE)
      if unused:
          print(f"ERROR: the wide exception names a glyph the chrome does not draw inline: {unused}")
          sys.exit(1)
      print(
          f"OK: {len(INLINE)} chrome icons at the digit's height "
          f"({len(WIDE)} wide by their own drawing), and none touches it"
      )
      PY

      # AND NOBODY introduces an inline size without passing through here.
      #
      # The list above only holds while OnTheCell is asked for with the sizes
      # this check measures: the token, or the generated `icon::chrome_size`,
      # which is the same measurement written into the Rust. A size written
      # loose would escape the measurement entirely — and the way to find out
      # would again be by looking at the screen.
      #
      # The shell is the whole scope on purpose: a wasm buffer cannot ask for a
      # size in px (invariant 11 gives it a Scale, and the host resolves it), so
      # every chrome glyph in the system is drawn from here.
      python3 - <<'PY'
      import pathlib, re, sys

      shell = pathlib.Path("${../crates/ronoctua-shell/src}")
      # BOTH SPELLINGS OF THE ONE ANSWER. `surface::chrome_size` takes the run's
      # text and `chrome_size_of` takes a `char` — the two chevrons hold one
      # already, and making them build a `String` for it to be taken apart again
      # was a cost per frame. They are the same measurement.
      MEASURED = re.compile(r"chrome_size(_of)?\(")

      # AND ONE EXCEPTION, NAMED, because it is not a chrome glyph at all.
      #
      # `files::run_size` is the size of a run standing in for a PICTURE: the
      # glyph a thumbnail shows when the file has none. Its size is the room the
      # picture would have had, not the digit's height, and holding it to the
      # digit's height is what the owner photographed — *"os glifos dos itens
      # que não tem thumbnail aparecem minúsculos em vez de adaptar o tamanho"*.
      #
      # It is centred for the reason every other `OnTheCell` is: a run bigger
      # than the grid has to be centred on the cells it covers or it hangs off
      # their left. And it is ONE function, so this exception is one line rather
      # than a hole: anything else that wants a loose size is still refused.
      EXCEPT = "run_size"

      exec(open("${pyPrelude}").read())

      # FILE-WIDE: a glyph centred in its cell with a loose size is an offence
      # wherever it is written — there is no function to narrow to, because the
      # point is that it may appear in one that does not exist yet. `whose` is
      # the prelude's copy of the `walls` idiom, and it is what names the
      # function a hit landed in.
      loose, sources = [], 0
      for f in sorted(shell.rglob("*.rs")):
          body = code_of(f.read_text())
          sources += 1
          for m in re.finditer(r"Size::OnTheCell\(", body):
              line = body[: m.start()].count("\n") + 1
              tail = body[m.start() : body.find("\n", m.start() + 200) + 1]
              if MEASURED.search(tail):
                  continue
              inside = whose(body, m.start())
              if inside == EXCEPT:
                  continue
              loose.append(f"{f.name}:{line} (in `{inside}`)")
      floor(sources, 30, "sources of the shell swept for a loose size")

      if loose:
          print("ERROR: a glyph centred in the cell with a size outside the measurement:")
          for l in loose:
              print("       " + l)
          print("      The chrome's size has ONE rule: font.size.icon as the ceiling, and")
          print("      icon::chrome_size for what the glyph generator measured.")
          print(f"      The one exception is `{EXCEPT}`, and it is named in this check.")
          sys.exit(1)
      print("OK: every glyph centred in a cell uses the measured size")
      PY
    '';

  # The guard of section 6.3: the Nerd Fonts version comes from the FILE ITSELF
  # (nameID 5), not from a constant. If the font is updated without the
  # matching glyphnames.json, the PUA codepoints move silently.
  fonts-nerdfonts-version = mkCheck "fonts-nerdfonts-version" [ py ] ''
    python3 - <<'PY'
    from fontTools.ttLib import TTFont
    import re, sys

    p = "${fonts.corrected}/TTF-nerdfonts/NoctuaIosevkaNerdFontMono-Regular.ttf"
    v = TTFont(p, lazy=True)["name"].getDebugName(5)
    m = re.search(r"Nerd Fonts (\d+\.\d+\.\d+)", v or "")
    if not m:
        print(f"ERROR: nameID 5 does not declare a Nerd Fonts version: {v!r}"); sys.exit(1)

    expected = "3.4.0"   # has to match the flake's `nerd-fonts` input
    if m.group(1) != expected:
        print(f"ERROR: the font has Nerd Fonts {m.group(1)}, the flake pins {expected}.")
        print("      Update the nerd-fonts input along with the font, or the")
        print("      PUA codepoints move with nobody noticing.")
        sys.exit(1)
    print(f"OK: Nerd Fonts {m.group(1)} matches the flake's input")
    PY
  '';

  # The icon table is generated from the REAL SOURCE FILE (section 6.3), never
  # hard-coded. This check proves that the generation happens and that the
  # result matches what the inventory measured.
  icons-table-generated = mkCheck "icons-table-generated" [ pkgs.jq ] ''
    db=${glyphdb.db}

    for f in icons.json glyphs.json coverage.md; do
      test -s "$db/$f" || { echo "ERROR: $f was not generated" >&2; exit 1; }
    done

    n=$(jq 'length' "$db/icons.json")
    echo "icon tokens: $n"
    [ "$n" -ge 40 ] || { echo "ERROR: the icon table is suspiciously small" >&2; exit 1; }

    # Every token has a glyph, a codepoint and a char — and the codepoint is in the PUA.
    jq -e 'to_entries | all(.value | has("glyph") and has("codepoint") and has("char"))' \
      "$db/icons.json" >/dev/null \
      || { echo "ERROR: an incomplete icon entry" >&2; exit 1; }

    g=$(jq 'length' "$db/glyphs.json")
    echo "glyphs indexed: $g"
    [ "$g" -eq 10473 ] || {
      echo "ERROR: expected 10473 Nerd Fonts glyphs, found $g." >&2
      echo "      If the font changed, the inventory in docs/ARCHITECTURE.md" >&2
      echo "      has to be redone before carrying on." >&2
      exit 1
    }

    # The 126 without a name have to stay in the index: dropping them would be
    # lying about what the font has (section 6.5).
    unnamed=$(jq '[.[] | select(.name == null)] | length' "$db/glyphs.json")
    echo "glyphs with no name in glyphnames.json: $unnamed"
    [ "$unnamed" -eq 126 ] || { echo "ERROR: expected 126 with no name" >&2; exit 1; }

    echo "OK: the icon table and the glyph database are generated from the real file"
  '';

  # THE NOTIFICATION CATALOGUE COMES OUT OF NIX, and the two vocabularies agree.
  #
  # `assets/notifications.nix` is the single place every notification and every
  # pre-created filter of the distro is declared (section 4.2). The generator
  # already refuses an invalid field at build time — this is the OTHER half:
  # that the words the generator accepts are the words the Rust knows.
  #
  # They are two lists, in two languages, and nothing but this compares them. A
  # `show = "brief"` the generator accepts and the Rust has never heard of would
  # come out as a table that does not compile — or worse, as a name the Rust
  # spells differently and silently reads as something else.
  notifications-table-generated = mkCheck "notifications-table-generated" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import pathlib, re, sys

    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the generator's sets and the generated table are both
    # module-level. `impl <enum>` and its `id()` are narrowed by `scope` and by
    # name below.
    #
    # `hashless` for the Python generator and `uncommented` for the Rust: every
    # name compared here is a string literal on both sides.
    generator = hashless(pathlib.Path("${../nix/scripts/gen-notifications.py}").read_text())
    table = uncommented(pathlib.Path("${notificationsRs}/notifications.rs").read_text())
    keys = pathlib.Path("${notificationsRs}/keys.txt").read_text().split()
    floor(len(generator), 1000, "characters of gen-notifications.py")
    floor(len(table), 1000, "characters of the generated table")
    floor(len(keys), 20, "keys the catalogue requires")

    failed = False

    # (a) the table was generated, and it is not empty.
    for wanted in ("fn generated_entries()", "fn generated_rules()"):
        if wanted not in table:
            print(f"ERROR: the table has no `{wanted}`")
            failed = True
    entries = table.count("Entry {")
    rules = table.count("Rule {")
    print(f"catalogue: {entries} entries, {rules} filters, {len(keys)} keys required")
    if entries < 1 or rules < 1 or not keys:
        print("ERROR: the generation came out empty or truncated")
        failed = True

    # (b) the vocabularies. The generator names them as sets of strings; the
    #     Rust names them in the `id()` of each enum. Both are parsed from the
    #     SOURCE, so a rename on either side shows up here.
    def from_generator(name):
        m = re.search(name + r" = \{([^}]*)\}", generator)
        assert m, name
        return set(re.findall(r'"([^"]+)"', m.group(1)))

    def from_rust(path, enum):
        """The names in the `id()` of one enum.

        Two levels of narrowing, and both are needed: `presentation.rs` holds
        `Show` AND `Life`, and `rule.rs` holds `Field` AND `Test`, so grabbing
        every arrow in the file gives one enum the other's names.
        """
        src = uncommented(pathlib.Path(path).read_text())
        impl = scope(src, rf"\nimpl {enum}\b")
        if not impl:
            print(f"ERROR: could not find `impl {enum}` in {path}")
            return set()
        fn = body_of(impl, "id")
        if not fn:
            print(f"ERROR: `{enum}` has no `id()` — the name would have no way of going and coming back")
            return set()
        return set(re.findall(r'=> "([^"]+)"', fn))

    NOTIFY = "${../crates/ronoctua-notify/src}"
    pairs = [
        ("SHOW", f"{NOTIFY}/presentation.rs", "Show"),
        ("LIFE", f"{NOTIFY}/presentation.rs", "Life"),
        ("FIELDS", f"{NOTIFY}/rule.rs", "Field"),
        ("PROGRAMS", f"{NOTIFY}/action.rs", "Program"),
    ]
    for name, path, enum in pairs:
        a, b = from_generator(name), from_rust(path, enum)
        if a != b:
            print(f"ERROR: `{name}` differs between the generator and the Rust")
            print(f"       only in the generator: {sorted(a - b)}")
            print(f"       only in the Rust:      {sorted(b - a)}")
            failed = True
        else:
            print(f"ok  {name:10s} {len(a)} identical names on both sides")

    # (c) every text key it demands has the shape the manager derives.
    for k in keys:
        if not re.fullmatch(r"notif-[a-z0-9-]+", k):
            print(f"ERROR: the key `{k}` is outside the `notif-<...>` shape")
            failed = True

    # (d) AND THE TAG THE SHELL STAMPS IS A TAG THE TABLE RECOGNISES.
    #
    # The out-of-memory notification is raised by the shell and recognised by
    # the catalogue through a tag — a string that has to be the same on both
    # sides with no compiler between them. Diverging, the notification arrives
    # as a stranger: quiet, short, with no action and no explanation of why a
    # window disappeared.
    surface = uncommented(pathlib.Path("${../crates/ronoctua-shell/src}/surface.rs").read_text())
    floor(len(surface), 100000, "characters of surface.rs")
    stamped = set(re.findall(r'pub const [A-Z_]+: &str = "([a-z-]+)";', surface))
    known = set(re.findall(r'Test::Is\("([a-z-]+)"\.to_owned\(\)\)', table))
    for tag in stamped:
        if tag not in known:
            print(f"ERROR: the shell stamps `{tag}` and no entry recognises it")
            failed = True
    if stamped:
        print(f"ok  tags stamped by the shell and recognised: {sorted(stamped)}")

    if failed:
        sys.exit(1)
    print("OK: the catalogue is generated from the Nix, and the two vocabularies match")
    PY
  '';

  # THE PROGRAMS THE CAPTURE NEEDS COME FROM THE ENVIRONMENT.
  #
  # This check used to be about somebody else's strings: the compositor raised
  # the screenshot notification itself, with its own app name and its own
  # English summary, and our catalogue entry FILTERED on all three. Upstream
  # changing any of them would have stopped the entry matching in silence.
  #
  # THAT HALF IS GONE, because the notification is ours now — this compositor
  # takes no screenshots at all, so `grim` takes the picture and the shell
  # raises the notification with words that were already in every language.
  #
  # WHAT SURVIVES IS THE HALF ABOUT OUR OWN CODE, and it is the half that has
  # actually caught something: three programs reach the shell through the
  # ENVIRONMENT rather than being baked in, and a store path compiled into the
  # binary is a reference no profile switch can remove — it would put the
  # program in every closure, including the minimal profile that has no media
  # at all, and make `ronoctua.media.enable = false` a switch that switches
  # nothing off.
  screenshot-notification-contract = mkCheck "screenshot-notification-contract" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import pathlib, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the offence is a NAME being absent from a whole
    # file, or present in the wrong one. There is no function to narrow to —
    # `RONOCTUA_GRIM` may be read anywhere in `surface.rs`, and what
    # `nix/rust.nix` must NOT contain it must not contain anywhere. A
    # `body_of` here would pass the day somebody moved the read one function
    # over.
    #
    # PROSE: and the subject IS the words — which name a path arrives under —
    # rather than the shape of any function.
    rust = uncommented(pathlib.Path("${../crates/ronoctua-shell/src}/surface.rs").read_text())
    built = hashless(pathlib.Path("${../nix/rust.nix}").read_text())
    module = hashless(pathlib.Path("${../nix/modules/scroll.nix}").read_text())
    floor(len(rust), 1000, "characters of surface.rs")
    floor(len(built), 1000, "characters of nix/rust.nix")
    floor(len(module), 1000, "characters of the compositor's module")

    failed = []

    # (a) THE CAPTURE READS ITS PROGRAM FROM THE ENVIRONMENT.
    if 'std::env::var("RONOCTUA_GRIM")' not in rust:
        failed.append("surface.rs does not read RONOCTUA_GRIM from the environment")

    # (b) AND IT IS NOT BAKED IN. `nix/rust.nix` is the compilation's
    # environment: a name there becomes an `option_env!` and a store
    # reference nothing can remove.
    for baked in ("RONOCTUA_GRIM", "RONOCTUA_SLURP", "RONOCTUA_SWAPPY"):
        if baked in built:
            failed.append(f"{baked} is in nix/rust.nix; it would be compiled in")

    # (c) AND THE MODULE PUTS THEM THERE, or the feature is offered and does
    # nothing — which is worse than not being offered.
    for given in ("RONOCTUA_GRIM", "RONOCTUA_SLURP", "RONOCTUA_SCREENSHOTS"):
        if given not in module:
            failed.append(f"{given} is not set by the compositor's module")

    if failed:
        print("ERROR: the capture's plumbing is wrong:", file=sys.stderr)
        for f in failed:
            print(f"  {f}", file=sys.stderr)
        sys.exit(1)
    print("OK: the capture's three programs come from the environment, and the module sets them")
    PY
  '';

  # A SWITCH THAT SWITCHES NOTHING OFF HAS TO SAY SO.
  #
  # The trap has a name in `AGENTS.md` — "interruptor que não interrompe" — and
  # the project has paid for it twice: `notoExtra` and `icons.superpack` were
  # both switches that turned nothing off, and the way anybody found out was by
  # measuring the closure.
  #
  # Two fields of the presentation are in that state ON PURPOSE: `vibrate` has
  # no device on a machine like this, and `audio` is not implemented (it is in
  # `docs/PENDING.md`). They exist because the external API the owner is going
  # to put online will set them, and dropping them at the door would make one
  # notification mean different things depending on where it came in.
  #
  # So they are not silent: each is in `ronoctua_notify::INERT` with a text key
  # saying why, the manager draws that next to the switch, and this check makes
  # sure the three lists — the field, the reason, and both `.ftl`s — agree.
  switches-that-do-nothing-say-so = mkCheck "switches-that-do-nothing-say-so" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    notify = pathlib.Path("${../crates/ronoctua-notify/src}")
    shell = pathlib.Path("${../crates/ronoctua-shell/src}")
    # FILE-WIDE: `INERT` and the fields of `Presentation` are module-level,
    # and what is asked of each door is whether it draws the reason anywhere.
    #
    # `uncommented` and never `code_of`: a field name and the key that explains
    # it are string literals inside the `INERT` table, and emptying them would
    # leave a check with nothing to read.
    presentation = uncommented((notify / "presentation.rs").read_text())
    manager = uncommented((shell / "notifications.rs").read_text())
    floor(len(presentation), 500, "characters of presentation.rs")
    floor(len(manager), 1000, "characters of notifications.rs")

    failed = False

    # THE LIST, from the Rust that declares it.
    inert = re.findall(
        r'Inert \{\s*field: "([a-z-]+)",\s*why: "([a-z-]+)",',
        presentation,
    )
    floor(len(inert), 2, "switches declared inert")
    print(f"switches declared inert: {[f for f, _ in inert]}")

    # (a) every one of them is a real field of `Presentation`.
    fields = set(re.findall(r"^    pub ([a-z_]+):", presentation, re.M))
    for field, why in inert:
        if field.replace("-", "_") not in fields:
            print(f"ERROR: `{field}` is not a field of Presentation")
            failed = True
        for language in ${builtins.toJSON languages}:
            ftl = pathlib.Path("${../assets/i18n}/" + language + ".ftl").read_text()
            if not re.search(rf"^{why} *=", ftl, re.M):
                print(f"ERROR: {language} does not explain `{field}` (`{why}` is missing)")
                failed = True

    # (b) AND THE MANAGER READS THAT LIST, rather than keeping a second one.
    #     Two lists is one more thing to keep in step, and the day they
    #     diverge is the day a switch goes quiet again.
    #
    #     THE COMMENTS DO NOT COUNT. The first version of this test looked for
    #     the name anywhere in the file and passed on a doc link — a check
    #     against the CRITERION and not against the CODE, which is the way
    #     `AGENTS.md` puts it. Only a line that is not a comment answers.
    # The `startswith` test is gone: `uncommented` took the comments off
    # already, and it takes one off the END of a line too.
    reads_it = "ronoctua_notify::INERT" in manager
    if not reads_it:
        print("ERROR: the manager does not read `INERT`; the reason would not reach the screen")
        failed = True
    # (b2) AND IT REACHES THE SCREEN. The reason used to be a third column on
    #      the row; the owner asked for it gone, so it moved to the message
    #      line — which means there has to be something that PUTS it there.
    #      Without this, "removed from the row" and "removed from the system"
    #      look the same to a check. It is `View::note` (the hint line is
    #      `View::hint`, generated from the key table, and the note wins
    #      over it on the same line).
    if "pub fn note(" not in manager:
        print("ERROR: the manager has no way of saying the reason")
        failed = True
    for door, name in (("footer", "surface.rs"), ("window", "notifications_window.rs")):
        drawn = uncommented((shell / name).read_text())
        floor(len(drawn), 1000, "characters of " + name)
        if "manager.note(" not in drawn and "view.note(" not in drawn:
            print(f"ERROR: the {door} does not draw the reason on the message line")
            failed = True

    # (c) and every knob it draws is either inert-with-a-reason or does
    #     something. A knob nobody can find in either list is the defect.
    knobs = set(re.findall(r'Self::(\w+) => "([a-z-]+)",', manager))
    names = {name for _, name in knobs}
    floor(len(names), 4, "knobs the manager draws")
    for field, _ in inert:
        if field not in names:
            print(f"ERROR: `{field}` is inert and the manager does not even draw it")
            failed = True

    if failed:
        sys.exit(1)
    print("OK: every switch with no effect says on screen why it has none")
    PY
  '';

  # THE DOOR TO BLUEZ IS UPSTREAM'S, AND IT IS ALREADY OPEN.
  #
  # BlueZ has no polkit actions: its bus policy lets `context="default"` send
  # to `org.bluez`, and that is the whole door. This check reads the INSTALLED
  # file rather than trusting the sentence — the day a release narrows it, the
  # radio would go quiet with nothing saying why, and this is what says why.
  # It also holds our own side: no module of ours writes a bluez polkit rule
  # (there is nothing to widen), and the crate spawns nothing privileged.
  bluetooth-bus-policy-is-open = mkCheck "bluetooth-bus-policy-is-open" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: what is asked of each of our own files is whether it spawns a
    # privileged program ANYWHERE in it, and whether it asks for a bus name at
    # all. Neither is a question about one function. The bluez policy is XML
    # and is narrowed by its own `<policy>` elements below.
    policy = pathlib.Path(
      "${pkgs.bluez}/share/dbus-1/system.d/bluetooth.conf"
    ).read_text()
    floor(len(policy), 500, "characters of bluez's bus policy")
    wrong = []

    # 1. ANY CLIENT MAY TALK TO THE DAEMON.
    default = re.search(r'<policy context="default">(.*?)</policy>', policy, re.S)
    if not default:
        wrong.append("bluez no longer has a default policy at all")
    elif 'send_destination="org.bluez"' not in default.group(1):
        wrong.append("bluez stopped letting an ordinary client talk to it")

    # 2. AND THE DAEMON MAY CALL BACK INTO AN AGENT OF OURS.
    root = re.search(r'<policy user="root">(.*?)</policy>', policy, re.S)
    if not root or 'send_interface="org.bluez.Agent1"' not in root.group(1):
        wrong.append("bluez may no longer call an agent; pairing would answer nothing")

    # 3. NOTHING OF OURS WIDENS IT, and nothing of ours asks.
    #
    # THE CODE, NOT THE PROSE. Every file here EXPLAINS that it writes no
    # rule and spawns nothing, and a check that read the whole text would
    # fail on the explanation — which is how this one first failed.
    # The hand-written stripper here took a comment off only where it BEGAN a
    # line. `hashless` and `uncommented` are the prelude's, and they take one
    # off the end of a line too.

    modules = pathlib.Path("${../nix/modules}")
    bluetooth = hashless((modules / "bluetooth.nix").read_text())
    floor(len(bluetooth), 200, "characters of nix/modules/bluetooth.nix")
    if "polkit" in bluetooth:
        wrong.append("nix/modules/bluetooth.nix writes a polkit rule")
    if "hardware.bluetooth" not in bluetooth:
        wrong.append("nix/modules/bluetooth.nix does not turn the radio on")
    crate = pathlib.Path("${../crates/ronoctua-bluetooth/src}")
    swept = 0
    for f in sorted(crate.glob("*.rs")):
        # `uncommented` and never `code_of`: the four programs below are named
        # in STRING literals — `Command::new("pkexec")` — and emptying the
        # strings would leave this loop unable to find any of them.
        body = uncommented(f.read_text())
        swept += 1
        for asked in ("pkexec", "pkttyagent", "sudo ", "systemd-run"):
            if asked in body:
                wrong.append(f"{f.name} spawns `{asked.strip()}`")
        # AND THE AGENT ASKS FOR NO NAME: dbus's default policy refuses one,
        # and the error reads exactly like an absent daemon. Two ways to ask
        # — a connection BUILDER carrying `.name`, or `request_name` on a
        # connection — and neither may appear. It looks for the builder and
        # not for the word: a THREAD's name is another thing entirely, and
        # both are spelled `.name(`, which is what the first version of this
        # guard matched — it also matches the four THREAD builders in this crate.
        if "connection::Builder" in body or "request_name" in body:
            wrong.append(f"{f.name} asks for a well-known bus name")

    floor(swept, 3, "sources of ronoctua-bluetooth swept for a privileged call")
    if wrong:
        for w in wrong:
            print("ERROR: " + w, file=sys.stderr)
        sys.exit(1)
    print("OK: bluez's own door is open, and nothing of ours touches it")
    END
  '';

  # THE POWER MODULE WRITES NO POLKIT RULE — the disks' argument, verbatim:
  # logind's and power-profiles-daemon's own actions already answer `yes` to
  # an active session, and a rule of ours could only widen a door that is the
  # right width. Both directions: the module has none, and the four that
  # MUST have one still do.
  power-adds-no-polkit-rule-of-its-own =
    mkCheck "power-adds-no-polkit-rule-of-its-own" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        modules = pathlib.Path("${../nix/modules}")
        # FILE-WIDE: a polkit rule anywhere in a module is the offence, and a
        # Nix module has no functions to narrow to. `hashless` is what stops a
        # rule written out in a `#` comment — the shape one is usually left
        # behind in — from reading as a rule.
        power = hashless((modules / "power.nix").read_text())
        floor(len(power), 200, "characters of nix/modules/power.nix")
        wrong = []
        swept = 0

        # 1. THE MODULE ACTUALLY TURNS THE DAEMONS ON.
        for daemon in ("services.upower", "services.power-profiles-daemon"):
            if daemon not in power:
                wrong.append(f"nix/modules/power.nix does not mention {daemon}")

        # 2. AND WRITES NO RULE.
        if "polkit" in power and "extraConfig" in power:
            wrong.append("nix/modules/power.nix writes a polkit rule")

        # 3. NOR DOES ANY OTHER MODULE NAME A LOGIND, UPOWER OR PROFILE ACTION.
        for f in sorted(modules.glob("*.nix")):
            body = hashless(f.read_text()).lower()
            swept += 1
            for action in ("org.freedesktop.login1.", "org.freedesktop.upower.", "powerprofiles."):
                if action in body and "polkit.addrule" in body and f.name != "rescue.nix":
                    wrong.append(f"{f.name} names a {action} action in a polkit rule")

        # 4. AND THE RULES THAT SHOULD EXIST STILL DO.
        for name in ["files.nix", "rescue.nix", "memory.nix", "keyboard.nix", "update.nix"]:
            floor(swept, 10, "modules swept for a power action")
            body = hashless((modules / name).read_text())
            if "polkit.addRule" not in body:
                wrong.append(f"{name} lost the polkit rule it MUST have")

        if wrong:
            for w in wrong:
                print("ERROR: " + w, file=sys.stderr)
            sys.exit(1)
        print("OK: the power module leaves polkit to logind and the profile daemon")
        END
      '';

  # THE FRAGMENT THE COMPOSITOR IS ASKED TO READ, READ BY THE COMPOSITOR.
  #
  # `ronoctua-display` writes `scroll-display.conf` at runtime and the compositor includes
  # it. A fragment the compositor cannot parse does not fail quietly on one monitor: it
  # fails the WHOLE config load, so every other monitor's settings go with it
  # and the person is left with a compositor on its defaults.
  #
  # NOTHING IN RUST CAN CATCH THAT. The grammar is the compositor's, it changes when
  # the compositor changes, and a unit test asserting our own string against our own
  # expectation proves only that we did not change our mind. What proves it is
  # `the compositor validate`, from the SAME binary the session runs.
  #
  # AND THE TEXT COMES OUT OF THE SOURCE, not out of a fixture beside it. The
  # test `the_whole_grammar_comes_out_at_once` already pins the writer's
  # output character for character; lifting that literal is what makes the two
  # halves impossible to drift apart — change the writer and the test's
  # expectation changes, and this validates the new one.
  #
  # THE WHOLE GENERATED CONFIG, READ BY THE COMPOSITOR THAT WILL RUN IT.
  #
  # # Why it exists
  #
  # Because the migration to this compositor shipped TWO defects that every
  # other gate in this repository passed over, and both were found by running
  # this command by hand:
  #
  #   - `bindsym Mod+Left focus left`. `Mod` is not a modifier here — the table
  #     is `Shift Lock Control Ctrl Mod1 Alt Mod2 Mod3 Mod4 Super Mod5`
  #     (`get_modifier_mask_by_name`) — so EVERY chord in the session was
  #     refused, one line at a time, while the leader and the emergency binds
  #     went on working. `nix/compositor-binds.nix` now refuses the prefix
  #     itself, which is earlier; this is what would have caught it anyway.
  #   - `bindsym Super+WheelScrollDown …`, the previous compositor's name for
  #     the wheel. Here it is `button5`.
  #
  # Neither is visible in any source: they are strings that only the
  # compositor's own parser can judge.
  #
  # # Why the failure mode is so quiet
  #
  # Because a bad line does NOT fail the load. `cmd_bindsym` returns
  # `CMD_INVALID` for that line and the rest of the file goes on — so the
  # symptom is one shortcut, or a whole family of them, doing nothing, with the
  # reason in a log nobody opens and in a nag window this distro refuses
  # (invariant 14). That is the defect class with no screen.
  #
  # # Why it runs in a sandbox, when it was written down that it could not
  #
  # `--validate` brings the SERVER up before it reads anything — libseat, a VT,
  # a backend, a renderer — and in a sandbox that ends in a core dump. Two
  # variables remove all of it: `WLR_BACKENDS=headless` takes away the seat and
  # the VT, `WLR_RENDERER=pixman` takes away EGL, GBM and the DRM node. With
  # both, the whole thing costs about ten milliseconds. `XDG_RUNTIME_DIR` still
  # has to exist, and a directory in the build tree is one.
  #
  # AND THE VERDICT IS THE OUTPUT, never `$?` — see
  # `display-fragment-validates`, which carries the measurement: an error
  # inside an `include` never reaches the exit status, because
  # `load_include_configs` returns `void`.
  # ONLY THE COMPOSITION ROOT NAMES THE COMPOSITOR.
  #
  # # What invariant 3 promises
  #
  # *"`ronoctua-scroll` é o ÚNICO crate da árvore que sabe qual compositor é,
  # e nenhum outro o nomeia."* That is the owner's constraint in his own words
  # — *"tudo que desenvolvermos deve funcionar como um contrato independente,
  # ou seja, não deve depender de externos como WMs"* — and a promise like that
  # is worth exactly what enforces it.
  #
  # # What it cost to be untrue
  #
  # Nine places across three crates each opened their own
  # `ronoctua_scroll::Scroll`, so the sentence above described a tree that did
  # not match it. The failure mode is slow and certain: the day a second
  # adapter exists, eight of the nine get updated and one does not, and what
  # that one does is connect to a compositor nobody is running.
  #
  # # What this counts, and what it deliberately does not
  #
  # It counts CONNECTIONS and allows exactly one per crate, which is that
  # crate's composition root. Everything downstream holds a `dyn Compositor`.
  #
  # It does NOT count the deeds table (`ronoctua_scroll::deeds`,
  # `ronoctua_scroll::wire`). That is a different kind of naming: the table is
  # generated from `assets/compositor-deeds.nix`, which is OURS, and what is
  # adapter-shaped about it is the command grammar the words are written in.
  # `ronoctua-compositor` owns the `Deed` and the `Arity`; the adapter owns the
  # spelling. Counting it would make the rule refuse the thing it protects.
  only-the-composition-root-names-the-compositor =
    mkCheck "only-the-composition-root-names-the-compositor" [ pkgs.python3 ]
      ''
        python3 - <<'PY'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        # FILE-WIDE: the offence is a connection opened ANYWHERE in a crate, and
        # narrowing to a function is what would miss it — a second one appears in
        # whichever function needed it that day.
        #
        # `code_of` and not `uncommented`: the needle is CODE, and the doc
        # comments beside each root name the very call being counted. A stripper
        # that left comments in would count the prose about the rule as a
        # breach of it.
        root = pathlib.Path("${../crates}")
        OPENS = re.compile(r"ronoctua_scroll::Scroll::(open|connect|connect_at)\b")

        seen = {}
        total = 0
        for f in sorted(root.rglob("*.rs")):
            crate = f.relative_to(root).parts[0]
            # THE ADAPTER ITSELF IS THE EXCEPTION, and it is the whole point:
            # it is where knowing which compositor this is belongs.
            if crate == "ronoctua-scroll":
                continue
            hits = OPENS.findall(code_of(f.read_text()))
            total += len(hits)
            if hits:
                seen.setdefault(crate, []).append((str(f.relative_to(root)), len(hits)))

        # A FLOOR, because zero would mean this check had stopped seeing the
        # tree — three crates talk to a compositor and each needs its one root.
        floor(total, 3, "connections opened outside the adapter")

        wrong = []
        for crate, files in sorted(seen.items()):
            count = sum(n for _, n in files)
            if count > 1:
                where = ", ".join(f"{q} ({n})" for q, n in files)
                wrong.append(f"{crate} opens {count} connections: {where}")

        if wrong:
            print("ERROR: a crate names the adapter in more than one place.", file=sys.stderr)
            for w in wrong:
                print(f"  {w}", file=sys.stderr)
            print(file=sys.stderr)
            print("       One per crate, and everything below it holds a", file=sys.stderr)
            print("       `dyn Compositor`. Invariant 3 says no crate but the", file=sys.stderr)
            print("       adapter knows which compositor this is; a second", file=sys.stderr)
            print("       opener is how that stops being true.", file=sys.stderr)
            sys.exit(1)

        print(f"OK: {len(seen)} crates reach a compositor, one composition root each")
        for crate, files in sorted(seen.items()):
            print(f"    {crate}: {files[0][0]}")
        PY
      '';

  # THE SESSION REACHES ITS TARGET, and every unit on the way RESOLVES.
  #
  # # The defect this exists for, which it has already caught
  #
  # `nix/modules/scroll.nix` reads `ronoctua.scroll` for one line — the unit's
  # `ExecStart` — and the flake was not passing it. Nothing said so for a whole
  # migration, because the thing everybody builds is the CONFIG FILE, and that
  # file never names the binary: `nix build …environment.etc."scroll/config"`
  # forces the text and not the program. The gap appeared only when some other
  # check happened to evaluate a whole system, and then it appeared as
  # `attribute 'scroll' missing` inside `services.dbus.packages`, which names
  # neither the module nor the cause.
  #
  # # Why a check and not a VM
  #
  # Because what broke is EVALUATION, and a VM would have to boot to find it —
  # minutes, for something a forced attribute answers in seconds. The VM tests
  # that do boot a session are the ones that prove it comes UP; this proves
  # there is something to bring up at all.
  #
  # # What it forces
  #
  # The whole chain a login walks: the compositor's unit, the target the
  # compositor's own `exec` starts, and the footer that hangs off it. Each is
  # read to a STRING, because an unforced attribute set is exactly what the
  # missing `scroll` hid behind.
  the-session-reaches-its-target =
    let
      vm = self.nixosConfigurations.vm.config;
      compositor = vm.systemd.user.services.scroll;
      footer = vm.systemd.user.services.ronoctua-footer;
      target = vm.systemd.user.targets.scroll-session;
      # A STORE PATH, forced. `ExecStart` is where the missing package landed,
      # and reading it is what turns "the attribute is absent" from a surprise
      # three modules away into this check's own message.
      started = compositor.serviceConfig.ExecStart;
      footerStarted = footer.serviceConfig.ExecStart;
    in
    mkCheck "the-session-reaches-its-target" [ pkgs.gnugrep ] ''
      # THE COMPOSITOR'S UNIT RUNS THE COMPOSITOR, by store path.
      #
      # A NAME here would be a unit with a minimal PATH looking for a binary
      # that is not on it — the trap `AGENTS.md` records for every spawn in a
      # unit, and the one that left production with no footer at all once.
      case "${started}" in
        /nix/store/*/bin/scroll\ -c\ /etc/scroll/config) ;;
        *)
          echo "ERROR: the compositor's unit does not run a store path:" >&2
          echo "       ${started}" >&2
          exit 1
          ;;
      esac

      # `Type=exec` AND NOT `notify`, which is a measurement rather than a
      # taste: this compositor has no `sd_notify` and no `--session`, so a
      # `notify` unit would sit waiting for a readiness message that never
      # comes and time out. `exec` means "started", which is the most systemd
      # can honestly know here — the rest is the config's own three `exec`
      # lines, which run after the backend, the renderer and the socket.
      if [ "${compositor.serviceConfig.Type}" != "exec" ]; then
        echo "ERROR: the compositor's unit is Type=${compositor.serviceConfig.Type}." >&2
        echo "       It has no sd_notify; anything but \`exec\` waits for a" >&2
        echo "       readiness message that is never sent." >&2
        exit 1
      fi

      # AND THE TARGET THE CONFIG STARTS EXISTS, with a description of its
      # own. A `systemctl --user start` of a target nobody declared succeeds
      # and starts nothing, which is the quietest possible way for a session
      # to come up with no footer.
      if [ -z "${target.description}" ]; then
        echo "ERROR: scroll-session.target has no description; is it declared?" >&2
        exit 1
      fi

      # AND THE CHAIN FROM THE TARGET TO THE FOOTER CLOSES.
      #
      # It is two links, and the first is the one worth writing down.
      # `scroll-session.target` carries `BindsTo=graphical-session.target`,
      # and `BindsTo=` includes the effect of `Requires=` — "if this unit gets
      # activated, the units listed will be activated as well"
      # (systemd.unit(5)) — so the config's `systemctl --user start
      # scroll-session.target` reaches `graphical-session.target` too, with
      # `Before=` putting them in that order. The second link is the footer
      # hanging off whichever of the two.
      #
      # Asserting only the second was this check's own first mistake: it
      # demanded the footer name `scroll-session.target` and called a working
      # chain broken. What matters is that SOMETHING the compositor starts
      # reaches the footer, and the ordering the module documents is real.
      echo "${builtins.concatStringsSep " " target.bindsTo}" | grep -qw "graphical-session.target" || {
        echo "ERROR: scroll-session.target does not bind graphical-session.target." >&2
        echo "       Then starting it reaches nothing: \`BindsTo=\` is what" >&2
        echo "       pulls the second target in, and the footer hangs off that." >&2
        exit 1
      }
      echo "${builtins.concatStringsSep " " footer.wantedBy}" \
        | grep -qE "(scroll-session|graphical-session)\.target" || {
        echo "ERROR: nothing on the compositor's chain starts the footer." >&2
        echo "       It is wanted by: ${builtins.concatStringsSep " " footer.wantedBy}" >&2
        echo "       The session would come up with no modeline, no minibuffer" >&2
        echo "       and no leader — which is what happened once already." >&2
        exit 1
      }

      case "${footerStarted}" in
        /nix/store/*/bin/ronoctua-shell*) ;;
        *)
          echo "ERROR: the footer's unit does not run a store path:" >&2
          echo "       ${footerStarted}" >&2
          exit 1
          ;;
      esac

      echo "OK: the compositor's unit, its target and the footer all resolve"
      echo "    compositor: ${started}"
      echo "    footer:     ${footerStarted}"
    '';

  compositor-config-valid = mkCheck "compositor-config-valid" [ scroll ] ''
    export XDG_RUNTIME_DIR="$PWD/run"
    mkdir -p "$XDG_RUNTIME_DIR"
    export WLR_BACKENDS=headless
    export WLR_RENDERER=pixman

    cp ${self.nixosConfigurations.vm.config.environment.etc."scroll/config".source} config
    chmod +w config

    scroll --validate --config config > said.txt 2>&1 || true
    if grep -q 'Error' said.txt; then
      echo "ERROR: the compositor refused a line of the config it will run." >&2
      echo "       A refused line does not fail the load — it is one" >&2
      echo "       shortcut, or one family of them, doing nothing." >&2
      cat said.txt >&2
      exit 1
    fi

    # AND A BROKEN ONE IS REFUSED, which is the half that makes it a gate.
    # `Mod` is the exact spelling the migration shipped, so the negative
    # half is the defect itself rather than a stand-in for it.
    sed 's/^bindsym --whole-window Super+/bindsym --whole-window Mod+/' config > broken
    sed -i 's/^bindsym --no-repeat Super+/bindsym --no-repeat Mod+/' broken
    sed -i 's/^bindsym Super+/bindsym Mod+/' broken
    if ! grep -q '^bindsym.*Mod+' broken; then
      echo "ERROR: the sabotage changed nothing, so the refusal below would" >&2
      echo "       prove nothing. Has the prefix stopped being \`Super\`?" >&2
      exit 1
    fi
    scroll --validate --config broken > broke.txt 2>&1 || true
    # `Unknown key or button 'Mod'` and not `Unknown modifier`: the parser
    # splits the chord on `+`, fails to find `Mod` in the modifier table, and
    # then tries the last-resort reading — that it is the KEY. Which is the
    # message a person would have to recognise in a log to ever find this.
    if ! grep -q "Unknown key or button 'Mod'" broke.txt; then
      echo "ERROR: the compositor said nothing about \`Mod\`, so the pass" >&2
      echo "       above proves nothing at all." >&2
      cat broke.txt >&2
      exit 1
    fi
    # AND THE NESTED LOOP'S, which is not the same file: its prefix is Alt,
    # and the `Super+Alt+…` shortcuts of the compositor's own configuration
    # take other keys there (`Chord::nested`). A line refused only in the
    # loop would be a shortcut that works installed and does nothing in
    # `.#dev`.
    cp ${devApp.config} nested
    chmod +w nested
    scroll --validate --config nested > nested.txt 2>&1 || true
    if grep -q 'Error' nested.txt; then
      echo "ERROR: the compositor refused a line of the NESTED loop's config." >&2
      cat nested.txt >&2
      exit 1
    fi
    echo "OK: the compositor reads every line of the config it will run, installed and nested"
  '';

  # THE POINTERS FRAGMENT, IN FRONT OF A REAL COMPOSITOR — the sibling of
  # `display-fragment-validates`, and for the same measured reason: an
  # `include` that fails to parse fails in silence (`load_include_configs` is
  # `void`), so a misspelt setting is a device that simply does not take it.
  #
  # What is validated is `every_line_the_writer_can_emit` — every one of the
  # nineteen settings, the seat lines and the header — pinned by the writer's
  # own test, so this reads what `text_of` really emits and not a copy.
  pointers-fragment-validates =
    mkCheck "pointers-fragment-validates"
      [
        pkgs.python3
        scroll
      ]
      ''
        python3 - <<'END'
        import pathlib, sys
        exec(open("${pyPrelude}").read())

        # FILE-WIDE: what is read here is a raw literal pinned inside a test,
        # found by the test's name, and `uncommented` keeps literals —
        # `code_of` would empty the very text being validated.
        source = uncommented(
            pathlib.Path("${../crates/ronoctua-pointers/src}/fragment.rs").read_text()
        )
        floor(len(source), 2000, "characters of the pointers fragment.rs")
        PINNED = "fn every_line_the_writer_can_emit"
        at = source.find(PINNED)
        begin = source.find('r#"', at)
        # FROM PAST THE OPENING: the fragment starts with its `#` header, so
        # `r#"#` itself contains the closing `"#`.
        end = source.find('"#', begin + 3)
        if at < 0 or begin < 0 or end < 0:
            print(f"ERROR: {PINNED} no longer pins a raw literal", file=sys.stderr)
            sys.exit(1)
        text = source[begin + 3 : end]
        # EVERY SPELLING HAS TO BE IN IT, or this validates a file that
        # exercises nothing. The list is `wire::input_command`'s own.
        missing = [
            w
            for w in (
                "focus_follows_mouse ", "hide_cursor ", "when-typing ", " attach ",
                "xcursor_theme ", " events ", "pointer_accel ", "accel_profile ",
                "natural_scroll ", "left_handed ", "scroll_factor ", " tap ",
                "tap_button_map ", " drag ", "drag_lock ", "three_finger_drag ",
                "click_method ", "clickfinger_button_map ", "middle_emulation ",
                "scroll_method ", "scroll_button ", "scroll_button_lock ", " dwt ",
                " dwtp ",
            )
            if w not in text
        ]
        if missing:
            print("ERROR: the pinned fragment does not exercise " + ", ".join(missing), file=sys.stderr)
            sys.exit(1)
        pathlib.Path("fragment.conf").write_text(text)
        print(text)
        END

        export XDG_RUNTIME_DIR="$PWD/run"
        mkdir -p "$XDG_RUNTIME_DIR"
        export WLR_BACKENDS=headless
        export WLR_RENDERER=pixman

        # THE VERDICT IS THE OUTPUT, not the exit status — an include's errors
        # never reach it (see `display-fragment-validates`).
        printf 'include "%s/fragment.conf"\n' "$PWD" > with-fragment.conf
        scroll --validate --config with-fragment.conf > said.txt 2>&1 || true
        if grep -q 'Error' said.txt; then
          echo "ERROR: the compositor REFUSED the fragment the pointer settings write." >&2
          echo "       Every line it could not read is a setting a device never took." >&2
          cat said.txt >&2
          exit 1
        fi

        # AND A BROKEN ONE IS REFUSED. `pointer_accel` is a `strtof` with a
        # range check, so a word there is certainly a refusal.
        sed 's/pointer_accel -0.250/pointer_accel fast/' fragment.conf > broken.conf
        if cmp -s fragment.conf broken.conf; then
          echo "ERROR: the sabotage changed nothing; the refusal below would prove nothing." >&2
          exit 1
        fi
        printf 'include "%s/broken.conf"\n' "$PWD" > with-broken.conf
        scroll --validate --config with-broken.conf > broke.txt 2>&1 || true
        if ! grep -q 'Error' broke.txt; then
          echo "ERROR: the compositor said nothing about a speed that is a word," >&2
          echo "       so the pass above proves nothing at all." >&2
          cat broke.txt >&2
          exit 1
        fi
        echo "OK: the compositor reads every line the pointer settings write, and refuses a broken one"
      '';

  display-fragment-validates =
    mkCheck "display-fragment-validates"
      [
        pkgs.python3
        scroll
      ]
      ''
        python3 - <<'END'
        import pathlib, re, sys
        exec(open("${pyPrelude}").read())

        # FILE-WIDE: what is read here is a raw literal pinned inside a test,
        # found by the test's own name — there is no function to narrow to that
        # is not the one already being searched for.
        #
        # `uncommented` and NEVER `code_of`: the payload IS a literal. This
        # check takes the fragment the writer pins and hands it to the compositor, so a
        # stripper that emptied it would validate an empty file and call that
        # a pass.
        source = uncommented(
            pathlib.Path("${../crates/ronoctua-display/src}/fragment.rs").read_text()
        )
        floor(len(source), 2000, "characters of fragment.rs")

        # THE ONE LITERAL, and not every literal that happens to start with
        # `output`. Other tests in that file pin FRAGMENTS of a block — the
        # escaping test pins a name and nothing else — and sweeping those in
        # would validate half a monitor's worth of config and call it proof. The
        # first version of this did exactly that.
        PINNED = "fn the_whole_grammar_comes_out_at_once"
        at = source.find(PINNED)
        if at < 0:
            print(
                f"ERROR: {PINNED} is gone from fragment.rs, so there is no "
                "pinned fragment to validate. That test is where the writer's "
                "output is written down; this check is the compositor reading "
                "it.",
                file=sys.stderr,
            )
            sys.exit(1)
        begin = source.find('r#"', at)
        end = source.find('"#', begin)
        if begin < 0 or end < 0:
            print(f"ERROR: {PINNED} no longer pins a raw literal", file=sys.stderr)
            sys.exit(1)
        text = source[begin + 3 : end] + "\n"

        # AND THE ESCAPED NAME GOES IN TOO, which is the one case where our own
        # expectation proving our own string is worth nothing. `escaped()` is
        # OUR answer to the config's grammar; monitors really are sold with a `"` in
        # the name, and a wrong answer takes the whole configuration load down
        # — every monitor unapplied, from one quote. Only the compositor can
        # say whether that answer is right, and this is the only place it is
        # asked.
        ESCAPED = "fn a_quote_in_a_model_name_cannot_break_the_file"
        at = source.find(ESCAPED)
        if at < 0:
            print(
                f"ERROR: {ESCAPED} is gone, so nothing pins what an escaped "
                "name comes out as.",
                file=sys.stderr,
            )
            sys.exit(1)
        # THE EXPECTATION, not the input: the `out.contains(r#"…"#)` beside it.
        # By FINDS and not a regular expression — the literal is full of quotes
        # and backslashes, which is the whole point of it.
        opens = source.find('assert!(out.contains(r#"', at)
        shuts = source.find('"#', opens + len('assert!(out.contains(r#"'))
        if opens < 0 or shuts < 0:
            print(f"ERROR: {ESCAPED} no longer pins the escaped output", file=sys.stderr)
            sys.exit(1)
        node = source[opens + len('assert!(out.contains(r#"') : shuts]
        text += node + " {\n    enable\n}\n"

        # AND THE HEADER THE WRITER PUTS ON TOP OF ALL OF IT.
        #
        # This check used to validate the BLOCKS and nothing else, and the
        # file `text_of` emits is a header plus those blocks. The header was
        # written with `//` comments — which this compositor does not have. It
        # answered every line with `Unknown/invalid command '//'` and then
        # `Error(s) loading config!`, so every monitor's settings were refused
        # over a comment, on every machine, with nothing saying so: `reload`
        # answers `success` whatever parsed and `scrollnag_command -` refuses
        # the window it would otherwise raise. The blocks were valid the whole
        # time, so this check was green.
        #
        # What is validated now is the file, not a piece of it.
        opens = source.find('String::from(')
        opens = source.find('"', opens)
        shuts = opens + 1
        while True:
            shuts = source.find('"', shuts)
            if shuts < 0 or source[shuts - 1] != "\\":
                break
            shuts += 1
        if opens < 0 or shuts < 0:
            print("ERROR: `text_of` no longer opens with a literal header", file=sys.stderr)
            sys.exit(1)
        # A RUST LITERAL, UNESCAPED: a `\` at the end of a line eats the newline
        # and the indentation after it, and `\n` is a newline.
        header = re.sub(r"\\\n\s*", "", source[opens + 1 : shuts]).replace("\\n", "\n")
        if not header.strip():
            print("ERROR: the header came out empty; it would validate nothing", file=sys.stderr)
            sys.exit(1)
        text = header + text

        pathlib.Path("fragment.conf").write_text(text)

        # EVERY NODE THE WRITER CAN EMIT HAS TO BE IN IT, or this would validate
        # a file that exercises nothing. The list is `text_of`'s own.
        missing = [
            node
            for node in (
                "disable",
                "enable",
                "mode ",
                "scale ",
                "transform ",
                "position ",
                "adaptive_sync ",
            )
            if node not in text
        ]
        if missing:
            print(
                "ERROR: the pinned fragment does not exercise " + ", ".join(missing),
                file=sys.stderr,
            )
            print("       Validating it would prove nothing about them.", file=sys.stderr)
            sys.exit(1)
        print(text)
        END

        # THE SANDBOX'S OWN RUNTIME DIRECTORY. The compositor aborts without
        # one, and on this path it never writes anything into it.
        export XDG_RUNTIME_DIR="$PWD/run"
        mkdir -p "$XDG_RUNTIME_DIR"
        export WLR_BACKENDS=headless
        export WLR_RENDERER=pixman

        # THE VERDICT IS THE OUTPUT AND NOT THE EXIT STATUS, and that is a
        # measurement rather than a preference.
        #
        # `--validate` returns what `load_config` returns, and an INCLUDE never
        # reaches it: `load_include_configs` returns `void` and throws away
        # every `load_include_config` result (`sway/config.c`). Measured — a
        # fragment carrying `scale not-a-number`, included from a main file,
        # prints `Error on line 2 ... Invalid scale.` and then `Error(s)
        # loading config!`, and exits ZERO. A gate on `$?` here would have
        # passed on every broken fragment there can be.
        printf 'include "%s/fragment.conf"\n' "$PWD" > with-fragment.conf
        scroll --validate --config with-fragment.conf > said.txt 2>&1 || true
        if grep -q 'Error' said.txt; then
          echo "ERROR: the compositor REFUSED the fragment the display view writes." >&2
          echo "       Every output line it could not read is a monitor left on" >&2
          echo "       the compositor's own choice, with only a log line." >&2
          cat said.txt >&2
          exit 1
        fi

        # AND A BROKEN ONE IS REFUSED, which is the half that makes it a gate.
        #
        # A SCALE THAT IS NOT A NUMBER, because `output_cmd_scale` is a
        # `strtof` and anything left over after it is `Invalid scale.` — the one
        # mutation of this grammar that is certainly a refusal rather than a
        # value the compositor quietly tolerates. `transform sideways` was
        # tried first and was ACCEPTED, which is exactly why a negative half
        # has to be RUN rather than assumed.
        sed 's/^    scale .*/    scale not-a-number/' fragment.conf > broken.conf
        printf 'include "%s/broken.conf"\n' "$PWD" > with-broken.conf
        scroll --validate --config with-broken.conf > broke.txt 2>&1 || true
        if ! grep -q 'Invalid scale' broke.txt; then
          echo "ERROR: the compositor said nothing about a scale that is not a" >&2
          echo "       number, so the pass above proves nothing at all." >&2
          cat broke.txt >&2
          exit 1
        fi
        echo "OK: the compositor reads the fragment the view writes, and refuses a broken one"
      '';

  # THE TEXT HAS ONE SIZE, AND THE PERSON CAN MOVE IT.
  #
  # `font.size.base` is the ANCHOR the chosen percentage is measured against,
  # not the size to draw at. A site that reads it directly draws at a size
  # nothing can move — and it does so silently: the pixel is right, the layout
  # is right, and the only symptom is one piece of the screen that ignores the
  # setting. That is a defect nobody reports as a defect, which is why it is a
  # check and not a test.
  #
  # It cost every draw call in the shell to make true once. What this stops is
  # the next one — and the count belongs HERE, printed on every build, because
  # three comments elsewhere once carried three different numbers and none of
  # them was right.
  #
  # COMMENTS MAY STILL NAME THE TOKEN — they are ABOUT it, and the story of
  # why there is one size is worth keeping. What may not happen is a line of
  # code reading it.
  #
  # And it checks the other direction too: a check that only forbade would
  # pass on the day somebody deleted the accessor.
  one-text-size = mkCheck "one-text-size" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    shell = pathlib.Path("${../crates/ronoctua-shell/src}")
    tokens = pathlib.Path("${../crates/ronoctua-tokens/src}/lib.rs").read_text()
    wrong = []

    # 1. NO CODE LINE IN THE SHELL READS THE ANCHOR.
    #
    # FILE-WIDE: the question is "does any line of any file in the shell read
    # the anchor", which is about the tree and not about one function. The
    # floor below is what keeps it honest — a sweep that stopped finding files
    # would otherwise report nothing wrong.
    #
    # THE PROSE COMES OFF FIRST, and the strings before it. A comment may NAME
    # the anchor — it is about the anchor — and a `//` inside a string literal
    # is not a comment at all: cutting there would hide everything after it,
    # so `let u = "http://x"; let s = SIZE_BASE;` was invisible. `code_of` in
    # the prelude is the one answer to both, and it knows about raw strings
    # and lifetimes besides, which this hand-written one did not.
    def code(line):
        return code_of(line)

    seen_files = 0
    asks = 0
    for f in sorted(shell.rglob("*.rs")):
        seen_files += 1
        body = f.read_text()
        asks += body.count("tokens::text::size()")
        for n, line in enumerate(body.splitlines(), 1):
            # THE BARE NAME TOO. `use ronoctua_tokens::font::{self, SIZE_BASE}`
            # and then `SIZE_BASE` reads the anchor without ever writing the
            # path, which the first version of this let through.
            if re.search(r"\bSIZE_BASE\b", code(line)):
                rest = f.relative_to(shell)
                wrong.append(
                    f"{rest}:{n} draws at `font::SIZE_BASE`, which the person cannot move. "
                    "Ask `ronoctua_tokens::text::size()`."
                )

    floor(seen_files, 30, "files of the shell swept for a fixed size")

    # 2. THE ACCESSOR EXISTS, AND IS THE ANCHOR SCALED.
    if "pub mod text {" not in tokens:
        wrong.append("ronoctua-tokens lost its `text` module")
    if not re.search(r"pub fn scaled\(size: f32\) -> f32 \{\s*size \* f32::from\(percent\(\)\) / 100\.0", tokens):
        wrong.append("`text::scaled` no longer moves a size by the chosen percentage")
    if not re.search(r"pub fn size\(\) -> f32 \{\s*scaled\(super::font::SIZE_BASE\)", tokens):
        wrong.append("`text::size` is no longer the scaled base")
    for name in ("SCALE_FLOOR", "SCALE_CEILING", "SCALE_STEP"):
        if name not in tokens:
            wrong.append(f"`font::{name}` is not read by the tokens crate any more")

    # 3. EVERY OTHER SIZE MOVES WITH IT, and only two files may name one.
    #
    #    `font.size.small` is 15 against a base of 18. Left unscaled it
    #    becomes the TALLER of the two below 84%, a small run takes two cells
    #    instead of one, and a picture loses runs on a grid that has not
    #    changed — measured, thirteen at 100% and eleven at 80%. What proves
    #    the arithmetic is a property test in the shell; what this keeps down
    #    is the number of PLACES a fixed size can be read from at all.
    # THE WHOLE PATH, not the file's name: keyed on the name, a new
    # `src/anywhere/paint.rs` would have been exempt by being called that.
    resolvers = {"paint.rs", "surface.rs"}
    for f in sorted(shell.rglob("*.rs")):
        body = f.read_text()
        here = str(f.relative_to(shell))
        names = [
            n
            for n, line in enumerate(body.splitlines(), 1)
            if re.search(r"\bfont::SIZE_", code(line))
        ]
        if names and here not in resolvers:
            wrong.append(
                f"{f.relative_to(shell)}:{names[0]} reads a fixed size. Only "
                + " and ".join(sorted(resolvers))
                + " resolve one, and they scale it."
            )
        # AND IN A RESOLVER, EVERY MENTION IS INSIDE A `text::scaled(` CALL.
        # The test was "the file says `text::scaled` somewhere", which a
        # 13 000-line `surface.rs` always does: a bare
        # `const _BIG: f32 = tokens::font::SIZE_XXLARGE;` added to it passed.
        # By PARENTHESES and not by line, because a resolver may spread the
        # call over five of them.
        if names and here in resolvers:
            text = "\n".join(code(l) for l in body.splitlines())
            depth, scaled_at = 0, []
            at = 0
            while at < len(text):
                if text.startswith("text::scaled(", at):
                    at += len("text::scaled(")
                    scaled_at.append(depth)
                    depth += 1
                    continue
                if text[at] == "(":
                    depth += 1
                elif text[at] == ")":
                    depth -= 1
                    if scaled_at and scaled_at[-1] == depth:
                        scaled_at.pop()
                elif text.startswith("font::SIZE_", at) and not scaled_at:
                    line = text.count("\n", 0, at) + 1
                    wrong.append(
                        f"{f.relative_to(shell)}:{line} names a fixed size outside a "
                        "`text::scaled(…)`, so it does not move with the size"
                    )
                at += 1
        if names and "text::scaled" not in body:
            wrong.append(f"{f.name} reads a fixed size and never scales one")

        # AND EVERY DOOR ASKS. Rule 1 forbids reading the ANCHOR; nothing
        # required a door to read the SIZE — so replacing every
        # `tokens::text::size()` in one door with a literal `18.0` passed, and
        # the only net left was the global floor, which has twenty sites of
        # slack against a door that has five. That is the defect this check
        # names in its own error string: "one piece of the screen that ignores
        # the setting".
        #
        # A DOOR IS A FILE WITH A `CompositorHandler`, the same population
        # `every-window-knows-its-scale` sweeps — ten of them, each asking five
        # or six times today, so the rule costs nothing and catches a door that
        # stops.
        # AGAINST THE CODE, not the prose. These two read `body` raw for a
        # round, so a door could replace every real call with a literal and
        # keep a doc line naming the accessor — a check about the CRITERION
        # and not about the CODE, inside a check written to refuse exactly
        # that.
        without_prose = "\n".join(code(l) for l in body.splitlines())
        if "impl CompositorHandler for" in body and "tokens::text::size()" not in without_prose:
            wrong.append(
                f"{f.name} draws a whole door and never asks for the size, so "
                "everything in it ignores the setting"
            )
        # AND EVERY DOOR HEARS THE SIZE MOVE. Asking once at start-up is a door
        # that is right until somebody changes the size, and then wrong beside
        # the nine that are not — which `toolkits.rs` records as the first
        # version of this, and calls "worse than no watch at all". An absent
        # call compiles, which is the shape three other checks in this file
        # exist for.
        # AND A PIXMAP CACHE IS EMPTIED WHERE THE SIZE CHANGES. An `Rgba` is
        # rasterised at a number of PIXELS, and every one of those numbers now
        # comes from `text::size()` — so a cache the size cannot reach keeps
        # the old texture on the GPU, which is the defect the theme's own cache
        # key exists for, on a second axis: a finder opened before a change to
        # 200% and again after it drew 18 px textures over 36 px boxes for the
        # life of the footer.
        #
        # A MAP OF THEM, not any mention: a channel carrying an `Rgba` and a
        # function answering one are not caches, and three files have those.
        #
        # INSIDE THE FUNCTION THAT RESHAPES THE TEXT, not anywhere in the file.
        # The first version asked for a `.clear()` somewhere, and a
        # 13 000-line file always has one — so deleting the real one passed.
        #
        # THE OTHER ANSWER is putting the size in the KEY, which `buffer.rs`
        # does: it has no size reaction to hang a clear on. What proves that
        # half is `the_svg_key_changes_with_the_theme`, which asserts two sizes
        # give two keys and goes red the moment the size leaves the format
        # string — a check cannot tell a key that carries a number from one
        # that names a variable, and a test can.
        #
        # AND A MISSING ANCHOR IS AN ERROR, NOT A SKIP. `at == -1` made `opens`
        # `-1` and the whole rule fell through in silence — so hoisting the
        # call (`let wanted = tokens::text::size(); … t.draw_at(wanted);`),
        # which is an ordinary refactor with no clippy complaint, turned this
        # rule off and the `.clear()` could then simply be deleted.
        if re.search(r"HashMap<[^>]*image::Rgba", without_prose):
            at = without_prose.find("draw_at(tokens::text::size())")
            # THE OTHER ANSWER, AND IT IS THE ONE THE FOOTER USES NOW: the key
            # carries the side. A file that builds its keys through such a
            # function needs no reaction to hang a clear on.
            keyed = any(
                name in without_prose
                for name in ("pixmap_key(", "svg_key(", "thumb_key(")
            )
            if at == -1 and not keyed:
                wrong.append(
                    f"{f.name} caches a rasterised pixmap, does not build its "
                    "key through one of the size-carrying key functions, and "
                    "has no `draw_at(tokens::text::size())` for this rule to "
                    "anchor on — so it was being skipped in silence"
                )
            opens = max(
                without_prose.rfind("\n    fn ", 0, at),
                without_prose.rfind("\n    pub fn ", 0, at),
            ) if at != -1 else -1
            if at != -1 and opens == -1 and not keyed:
                wrong.append(
                    f"{f.name}: the size reaction is not inside a method, so "
                    "this rule cannot read it"
                )
            if opens != -1:
                depth, i, reacts = 0, without_prose.find("{", opens), ""
                j = i
                while j < len(without_prose):
                    if without_prose[j] == "{":
                        depth += 1
                    elif without_prose[j] == "}":
                        depth -= 1
                        if depth == 0:
                            reacts = without_prose[i : j + 1]
                            break
                    j += 1
                if ".clear()" not in reacts and not keyed:
                    wrong.append(
                        f"{f.name} caches a rasterised pixmap and neither empties "
                        "it where the size changes nor keys it by the size"
                    )

        if "impl CompositorHandler for" in body and "toolkits::watch(" not in without_prose:
            wrong.append(
                f"{f.name} never watches `display.json`, so it keeps the size "
                "it started with while the rest of the shell moves"
            )

        # AND NOBODY PASSES A NUMBER WHERE THE SIZE GOES.
        #
        # Rule 3 forbids reading the ANCHOR (`font::SIZE_`) and requires each
        # door to ask for the SIZE at least ONCE — and neither of those reaches
        # a bare `18.0`. So replacing four of a door's five
        # `tokens::text::size()` with a literal left that door mostly ignoring
        # the setting, and the only net was the global floor, which has twenty
        # sites of slack against a door that has five. "One piece of the screen
        # that ignores the setting" is this check's own error string.
        #
        # What CONSUMES a size is a short closed list, and a number is never
        # the right argument to any of them: the whole point is that the number
        # comes from one place.
        for fn in (
            "metrics::line_height",
            "metrics::cell_width",
            "metrics::footer_height",
            "draw_at",
            "text::scaled",
        ):
            for m in re.finditer(
                re.escape(fn) + r"\(\s*([0-9][0-9_]*(?:\.[0-9_]*)?)(?:f32|f64)?\s*\)",
                without_prose,
            ):
                wrong.append(
                    f"{f.relative_to(shell)}: `{fn}({m.group(1)})` puts a number "
                    "where the chosen size goes, so that piece of the screen "
                    "ignores the setting"
                )

    # 3b. AND EVERY PIXMAP CACHE KEY CARRIES THE SIDE.
    #
    #     This is the rule the one above could not state. An `Rgba` is
    #     rasterised at a number of PIXELS and those numbers come from
    #     `text::size()`, so the same picture at 100% and at 200% is two
    #     pictures — and the GPU's own cache (`ronoctua_render::image::Images`)
    #     has NO per-key removal at all: its `clear()` empties the frame's
    #     batch and leaves the textures, its `dump()` only acts above a ceiling
    #     and then keeps what is on screen. Emptying a host-side map therefore
    #     cannot reach it. Only a key it has not seen can.
    #
    #     That is exactly how the first fix here failed: `icons.clear()` was
    #     added, this check's shape rule went green, and the finder went on
    #     drawing 18 px textures stretched into 36 px boxes for the life of the
    #     footer — the sentence the rule above describes, surviving the rule
    #     above.
    for where, fn in (("apps.rs", "pixmap_key"), ("buffer.rs", "svg_key")):
        src = (shell / where).read_text()
        m = re.search(r"fn " + fn + r"\(([^)]*)\)", "\n".join(code(l) for l in src.splitlines()))
        if not m:
            wrong.append(
                f"{where}: `{fn}` is gone, and it is what puts the size into the "
                "cache key that reaches the GPU"
            )
        elif "side" not in m.group(1):
            wrong.append(
                f"{where}: `{fn}` does not take a side, so one drawing at two "
                "sizes spells one key and the GPU keeps the first — which "
                "nothing downstream can undo"
            )

    # 3c. AND THE SIZE REACHES THE APPLICATIONS THAT ARE NOT OURS.
    #
    #     The size does not stop at our own windows, and the channel it takes
    #     was MEASURED rather than assumed. Two facts decided it, and both are
    #     in the binaries:
    #
    #     - `qgnomeplatform` 0.8.4 subscribes to `changed::font-name`,
    #       `changed::monospace-font-name` and five more on
    #       `org.gnome.desktop.interface` — and NOT to `text-scaling-factor`.
    #       So Qt never followed the multiplier, whatever the `full` profile
    #       paid for its platform theme.
    #     - GTK renders at `points x (gtk-xft-dpi/96)`, and `gtk-xft-dpi` comes
    #       from that same multiplier. So writing BOTH scales GTK twice.
    #
    #     There is no channel that reaches Qt and misses GTK. The size
    #     therefore travels in the font description, the multiplier is reset,
    #     and Ghostty — which reads neither, having a `font-size` of its own —
    #     is given a file. Each of those three is a rule here, because each of
    #     them can be silently undone by one line.
    #     READ WITH THE STRINGS KEPT. `code` above strips string literals as
    #     well as comments — right for the rules that hunt for identifiers, and
    #     wrong here, where the KEY NAMES and the dconf verbs are the evidence.
    #     Comments still go, so a sentence cannot satisfy any of this.
    toolkits = (shell / "toolkits.rs").read_text()
    plain = "\n".join(
        (l if (cut := l.find("//")) < 0 else l[:cut]) for l in toolkits.splitlines()
    )
    for what, why in (
        (
            "font-name",
            "the size no longer travels in the font description, so Qt stops "
            "following it",
        ),
        (
            '"reset", SCALING_KEY',
            "the multiplier is not put back, so GTK scales the font AND the "
            "multiplier — the square of what was asked for",
        ),
        (
            "SIZE_FILE",
            "Ghostty is not told its own size, and it reads neither of the "
            "other two channels",
        ),
        (
            "TERMINAL_POINTS",
            "the terminal's base size is a number written here instead of the "
            "token `nix/modules/terminal.nix` reads, so the two can drift",
        ),
    ):
        if what not in plain:
            wrong.append(f"toolkits.rs no longer names `{what}`: {why}")
    #     AND THE MULTIPLIER IS NEVER WRITTEN AGAIN. Resetting it and then
    #     writing it is the same defect with an extra step.
    if re.search(r'"write",\s*SCALING_KEY', plain):
        wrong.append(
            "toolkits.rs writes the scaling multiplier again; with the size in "
            "the font description that scales GTK twice"
        )

    # 4. ONE SHELL SOURCE SETS THE SIZE, for the reason `theme::set` carries:
    #    it is process-wide and the tests run in parallel, so a second one
    #    changes it under the first — and the failure is a FLAKE, which is the
    #    worst kind to hand somebody.
    setters = len(re.findall(r"\btext::set\(", tokens))
    if setters == 0:
        wrong.append("nothing ever sets the text size, so the range is untested")
    #    IT IS ABOUT TESTS, not about production code. The footer sets the
    #    size when the file says so, and must — the check counts only what
    #    comes AFTER a `#[cfg(test)]`, which is where a racing setter would
    #    be. `src/bin/` is exempt for a different reason: each of those is a
    #    SEPARATE PROCESS with its own atomic, so `render-png`'s `--text`
    #    cannot race anything at all.
    def setters_in_tests(body):
        # FROM THE LAST `#[cfg(test)]`, not the first. This repository puts the
        # test module at the END of a file, and a `#[cfg(test)]` HELPER
        # somewhere above — an ordinary thing in a fourteen-thousand-line
        # source — would otherwise sweep the production setters below it into
        # the count and accuse them of being a second test.
        at = body.rfind("#[cfg(test)]")
        return 0 if at < 0 else len(re.findall(r"\btext::set\(", body[at:]))

    loud = sorted(
        f.name
        for f in shell.rglob("*.rs")
        if "bin/" not in str(f.relative_to(shell)) and setters_in_tests(f.read_text())
    )
    if len(loud) > 1:
        wrong.append(
            "more than one shell TEST sets the text size, and the tests run in "
            "parallel: " + ", ".join(loud)
        )

    # 5. VACUITY. A rename of the accessor would leave this passing over a
    #    shell that reads the anchor everywhere under another name.
    if seen_files < 20:
        wrong.append(f"only {seen_files} shell sources were read; the glob is wrong")
    # THE FLOOR IS CLOSE TO THE REAL COUNT, not a quarter of it: at 60 a
    # regression could delete a fifth of the call sites and still pass. It is
    # a floor and not an equality because adding a draw call is ordinary and
    # should not fail a check about something else.
    if asks < 75:
        wrong.append(
            f"only {asks} sites ask for the size, and the shell asks far more "
            "often than that — something stopped asking"
        )

    if wrong:
        for w in wrong:
            print("ERROR: " + w, file=sys.stderr)
        sys.exit(1)
    print(f"OK: {asks} sites in {seen_files} shell sources ask for one size, and it moves")
    END
  '';

  # THE FRAGMENT'S NAME IS WRITTEN IN FOUR PLACES AND NOTHING TIED THEM.
  #
  # `fragment::FILE` is what the shell WRITES; `nix/modules/scroll.nix` and
  # `nix/dev.nix` are what the compositor INCLUDES; `tests/display-vm.nix`
  # writes its own config with its own copy. Renaming the constant left the
  # real machine including a file nobody writes — the feature stops persisting,
  # and every test stays green, because the VM includes its own hand-written
  # line rather than the one the module generates.
  #
  # `display-fragment-validates` cannot see it: it validates the CONTENT.
  # The contract test's syntax gate cannot either: it proves the generated config parses,
  # and an include of a file that is not there is `optional=true` and parses
  # fine. This is the same shape `MOST_SCALE` was given one home for.
  display-fragment-has-one-name = mkCheck "display-fragment-has-one-name" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: the name is a module-level constant and the includes are lines
    # of three configuration files. Neither is inside a function.
    #
    # `uncommented` for the Rust, because the NAME is the string literal being
    # read out; `hashless` for the Nix, whose comment is `#`.
    # TWO FRAGMENTS NOW, under the same rule: the screens (`ronoctua-display`)
    # and the pointers (`ronoctua-pointers`). One loop, so the second is held
    # to exactly what the first was — a sibling check copied beside it would
    # be the next thing to drift.
    for crate_label, fragment_rs, lib_rs in (
        ("crates/ronoctua-display", "${../crates/ronoctua-display/src/fragment.rs}", "${../crates/ronoctua-display/src}/lib.rs"),
        ("crates/ronoctua-pointers", "${../crates/ronoctua-pointers/src/fragment.rs}", "${../crates/ronoctua-pointers/src}/lib.rs"),
    ):
        rust = uncommented(pathlib.Path(fragment_rs).read_text())
        floor(len(rust), 200, "characters of fragment.rs")
        m = re.search(r'pub const FILE: &str = "([^"]+)";', rust)
        if not m:
            print("ERROR: `fragment::FILE` is not there to compare against in " + crate_label, file=sys.stderr)
            raise SystemExit(1)
        name = m.group(1)

        # AN `include` LINE, not a mention. `scroll-display.conf` appears in
        # `nix/modules/scroll.nix` twice — once inside an error message and once in
        # the real include — so deleting the include left the compositor reading
        # nothing while this check stayed green on the sentence. Same shape in the
        # VM test, where one of the two is a comment.
        # AND THE LINE IS CODE, NOT PROSE.
        #
        # The header above says "an `include` LINE, not a mention" and then read
        # raw text, so the sentence was not enforced: deleting the real include and
        # leaving `# we used to include scroll-display.conf here` kept this green,
        # which is exactly the state the error message below describes.
        # This was a local `code_of` that took a `#` off each line and handed back
        # a LIST. It is `hashless` now — the prelude's, which answers with text —
        # and the name no longer shadows the Rust-shaped stripper of the same name.

        # AND THE WHOLE PATH, NOT THE BASENAME.
        #
        # `name` is `scroll-display.conf`, and the shell writes it into
        # `ronoctua_store::config_dir()`. An include of the same basename in ANOTHER
        # directory — `~/.config/scroll/` is the plausible one, since the theme
        # fragment lives there — matches on the basename and reads a file nobody
        # writes. So the directory the shell writes to has to be in the line too.
        # THE SEGMENT, JOINED TO THE NAME, and not the word on its own: these
        # lines interpolate `config.ronoctua.user`, so a path through
        # `.config/scroll/` still has "ronoctua" somewhere in it and a bare word
        # test passes over exactly the swap it is meant to catch.
        where_written = "ronoctua/" + name
        wrong = []
        for label, path in (
            ("nix/modules/scroll.nix", "${../nix/modules/scroll.nix}"),
            ("nix/dev.nix", "${../nix/dev.nix}"),
            ("tests/display-vm.nix", "${../tests/display-vm.nix}"),
        ):
            lines = [
                l
                for l in hashless(pathlib.Path(path).read_text()).splitlines()
                if "include" in l and name in l
            ]
            if not lines:
                wrong.append(label)
            elif not any(where_written in l for l in lines):
                wrong.append(
                    label + f" (includes `{name}` from a directory that is not the "
                    f"one the shell writes to, which has `{where_written}` in it)"
                )

        # AND THE WRITER USES THE CONSTANT. Proving the constant exists says
        # nothing about the file the shell actually opens: a literal at the one
        # `write_atomically` reproduces the whole defect with every name in place.
        #
        # ASKED OF THE CALL, not of the file. `"fragment::FILE" in crate` is true
        # while the constant is merely MENTIONED — in the read-back one line above
        # the write, or in a comment — so swapping the write itself for a literal
        # left this green, and a later rename then writes one name and includes
        # another. That is the one scenario this whole check exists for.
        crate = code_of(pathlib.Path(lib_rs).read_text())
        floor(len(crate), 2000, crate_label + "'s lib.rs characters")
        writes = re.findall(r"write_atomically\(([^;]*?)\)\s*(?:\.|;|$)", crate, re.S)
        frag = [w for w in writes if "fragment::FILE" in w]
        if not writes:
            wrong.append(crate_label + " (no `write_atomically` to read)")
        elif not frag:
            wrong.append(
                crate_label + " (no `write_atomically` names "
                "`fragment::FILE`, so the fragment is written under some other name)"
            )
        if wrong:
            break
    if wrong:
        print(f"ERROR: the shell writes `{name}` and these do not include it:", file=sys.stderr)
        print("", file=sys.stderr)
        for w in wrong:
            print("       " + w, file=sys.stderr)
        print("", file=sys.stderr)
        print("       A rename that misses one of them leaves the compositor", file=sys.stderr)
        print("       including a file nobody writes: every setting is saved,", file=sys.stderr)
        print("       nothing survives a restart, and no other check can see it", file=sys.stderr)
        print("       — `display-fragment-validates` reads the CONTENT, and", file=sys.stderr)
        print("       the syntax gate is happy with an include of a file", file=sys.stderr)
        print("       include of a file that is not there.", file=sys.stderr)
        raise SystemExit(1)

    print(f"OK: `{name}` is the name the shell writes and all three configs include")
    END
  '';

  # THE PANEL'S BRIGHTNESS RULE LANDS, and it is the only privileged door the
  # display feature opens for a BUILT-IN screen. Read out of the evaluated
  # configuration, so the default the module promises is the one the machine
  # gets — the same shape as `power-thresholds-rule-lands` below, and for the
  # same reason: `GROUP=`/`MODE=` do not reach a sysfs attribute, so the rule
  # is a `RUN` of store paths, and getting the TARGET PATH wrong hands nothing
  # over while still looking like a rule.
  #
  # AND THE OTHER HALF OF THE FEATURE: an external monitor answers over I2C,
  # which needs `i2c-dev` loaded. It is checked here because it is the same
  # promise — "the brightness on this screen can be moved" — and because a
  # module that quietly stopped loading it would leave the view saying every
  # external monitor has its brightness on its own buttons.
  #
  # WHAT THIS CANNOT SAY, and `display-vm.nix` is where it is said: that the
  # module READS its own option. Both halves here compare the rule against the
  # same evaluated configuration the module wrote, and the option's default is
  # `users` — so a module that ignored `brightnessGroup` and hardcoded the
  # literal would pass. Proving it read would mean evaluating a second NixOS
  # configuration with an override, which is minutes against this check's
  # milliseconds. The VM node sets `brightnessGroup = "video"` instead, and
  # asserts the rule says so.
  display-brightness-rule-lands =
    let
      rules = self.nixosConfigurations.noctua.config.services.udev.extraRules;
      group = self.nixosConfigurations.noctua.config.ronoctua.display.brightnessGroup;
      i2c = self.nixosConfigurations.noctua.config.hardware.i2c.enable;
      modules = builtins.concatStringsSep " " self.nixosConfigurations.noctua.config.boot.kernelModules;
    in
    mkCheck "display-brightness-rule-lands" [ pkgs.python3 ] ''
      python3 - <<'END'
      import re, sys
      rules = """${rules}"""
      group = "${group}"
      wrong = []

      lines = [l for l in rules.splitlines() if "SUBSYSTEM==\"backlight\"" in l]
      if not lines:
          wrong.append("no udev rule for a backlight")
      for l in lines:
          # A RULE THAT FIRES ON A DEVICE WITHOUT THE FILE runs `chgrp` on a
          # path that is not there, once per boot, for nothing.
          if 'TEST=="brightness"' not in l:
              wrong.append("the backlight rule runs on a device with no `brightness`")
          # `change` AND `add`: a laptop that suspends comes back with the
          # ownership reset, and the symptom is a key that worked this morning.
          if 'ACTION=="add|change"' not in l:
              wrong.append("the backlight rule does not survive a resume")
          target = re.escape("/sys$devpath/brightness")
          if not re.search(r'RUN\+="/nix/store/[^"]*/chgrp ' + re.escape(group) + r' ' + target + r'"', l):
              wrong.append(f"the backlight rule does not hand THAT file to `{group}` by store path")
          if not re.search(r'RUN\+="/nix/store/[^"]*/chmod g\+w ' + target + r'"', l):
              wrong.append("the backlight rule does not make THAT file group-writable")

      # THE EXTERNAL HALF.
      if "${builtins.toString i2c}" != "1":
          wrong.append("hardware.i2c is off, so no external monitor's brightness can be reached")
      if "i2c-dev" not in "${modules}".split():
          wrong.append("`i2c-dev` is not loaded, so /dev/i2c-* never appears")

      if wrong:
          for w in wrong:
              print("ERROR: " + w, file=sys.stderr)
          sys.exit(1)
      print("OK: the backlight rule and the I2C door both land")
      END
    '';

  # THE DISPLAY MODULE WRITES NO POLKIT RULE — power's argument, verbatim, and
  # it applies here for a sharper reason: there is no daemon to ask. A panel's
  # brightness is a file, and a monitor's is a wire. A rule could only be a
  # door onto something that is not a service.
  display-adds-no-polkit-rule-of-its-own =
    mkCheck "display-adds-no-polkit-rule-of-its-own" [ pkgs.python3 ]
      ''
        python3 - <<'END'
        import pathlib, sys
        exec(open("${pyPrelude}").read())

        # FILE-WIDE: a reach for authority anywhere in the module is the
        # offence, and a Nix module has no functions to narrow to.
        #
        # `hashless`: a `pkexec` named in a comment is prose about a thing we
        # do not do, and it used to read as the thing itself.
        modules = pathlib.Path("${../nix/modules}")
        display = hashless((modules / "display.nix").read_text())
        floor(len(display), 200, "characters of nix/modules/display.nix")
        wrong = []

        # 1. THE MODULE ACTUALLY OPENS THE TWO DOORS.
        for what in ("services.udev.extraRules", "hardware.i2c.enable"):
            if what not in display:
                wrong.append(f"nix/modules/display.nix does not mention {what}")

        # 2. AND WRITES NO RULE.
        if "polkit" in display.lower() and "addrule" in display.lower():
            wrong.append("nix/modules/display.nix writes a polkit rule")

        # 3. NOR DOES IT REACH FOR ROOT ANOTHER WAY. The session has no polkit
        #    agent, so any of these is a prompt nobody sees.
        for reach in ("pkexec", "sudo ", "systemd-run"):
            if reach in display:
                wrong.append(f"nix/modules/display.nix reaches for root with `{reach.strip()}`")

        if wrong:
            for w in wrong:
                print("ERROR: " + w, file=sys.stderr)
            sys.exit(1)
        print("OK: the display module takes one file and one kernel module, and no authority")
        END
      '';

  # THE CHARGE THRESHOLDS' UDEV RULE LANDS, and it is the ONLY privileged
  # door the power feature opens: both attribute files, on a battery, for the
  # configured group, through store paths. Read out of the evaluated
  # configuration, so the default the module promises is the one the machine
  # gets.
  power-thresholds-rule-lands =
    let
      rules = self.nixosConfigurations.noctua.config.services.udev.extraRules;
      group = self.nixosConfigurations.noctua.config.ronoctua.power.thresholdsGroup;
    in
    mkCheck "power-thresholds-rule-lands" [ pkgs.python3 ] ''
      python3 - <<'END'
      import re, sys
      rules = """${rules}"""
      group = "${group}"
      wrong = []
      for attribute in ("charge_control_start_threshold", "charge_control_end_threshold"):
          lines = [l for l in rules.splitlines() if attribute in l]
          if not lines:
              wrong.append(f"no udev rule for {attribute}")
              continue
          for l in lines:
              if 'SUBSYSTEM=="power_supply"' not in l or 'ATTR{type}=="Battery"' not in l:
                  wrong.append(f"the rule for {attribute} is not limited to a battery")
              if f'TEST=="{attribute}"' not in l:
                  wrong.append(f"the rule for {attribute} runs on a battery without the file")
              # THE TARGET IS PART OF THE RULE. `chgrp users` with the wrong
              # path hands nothing over, and the check would still pass:
              # `/sys$devpath/<attribute>` is the file the crate writes.
              target = re.escape("/sys$devpath/" + attribute)
              if not re.search(r'RUN\+="/nix/store/[^"]*/chgrp ' + re.escape(group) + r' ' + target + r'"', l):
                  wrong.append(f"the rule for {attribute} does not hand THAT file to `{group}` by store path")
              if not re.search(r'RUN\+="/nix/store/[^"]*/chmod g\+w ' + target + r'"', l):
                  wrong.append(f"the rule for {attribute} does not make THAT file group-writable")
              if "chmod o+w" in l or "0666" in l:
                  wrong.append(f"the rule for {attribute} opens the file to everybody")
      if wrong:
          for w in wrong:
              print("ERROR: " + w, file=sys.stderr)
          sys.exit(1)
      print("OK: the two charge-threshold attributes are handed to the group, and nothing else")
      END
    '';

  # NOTHING IN THE POWER CRATE ASKS. Every logind call goes with
  # `interactive = false` — the `auth.no_user_interaction` of logind — and no
  # `sudo`, `pkexec`, `pkttyagent` or `systemd-run` is spawned: there is no
  # polkit agent in this session, and a call that could ask would hang. The
  # `updates-never-ask` shape, on the crate instead of the runner.
  power-never-asks = mkCheck "power-never-asks" [ pkgs.python3 ] ''
    python3 - <<'END'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())
    crate = pathlib.Path("${../crates/ronoctua-power/src}")
    shell = pathlib.Path("${../crates/ronoctua-shell/src}")
    wrong = []
    swept = 0
    # FILE-WIDE: what is asked of each file is whether a name appears in it at
    # all — a signature, a call, a program. None is a question about the inside
    # of one function.
    #
    # `uncommented` and never `code_of`: the last sweep looks for a program
    # named INSIDE a string literal, which is the only place one can be named.
    login = uncommented((crate / "login.rs").read_text())
    lib = uncommented((crate / "lib.rs").read_text())
    floor(len(login), 500, "characters of login.rs")
    floor(len(lib), 1000, "characters of lib.rs")
    # Every action method is declared with an `interactive` flag…
    for verb in ("suspend", "hibernate", "hybrid_sleep", "suspend_then_hibernate", "power_off", "reboot"):
        if not re.search(rf"fn {verb}\(&self, interactive: bool\)", login):
            wrong.append(f"login.rs: `{verb}` lost its `interactive` flag")
    # …and every call passes `false`.
    calls = re.findall(r"manager\.(suspend|hibernate|hybrid_sleep|suspend_then_hibernate|power_off|reboot)\(([^)]*)\)", lib)
    if not calls:
        wrong.append("lib.rs: no logind action is called at all")
    for verb, arg in calls:
        if arg.strip() != "false":
            wrong.append(f"lib.rs: `{verb}` is called with `{arg}`, which may ask")
    for f in list(crate.glob("*.rs")) + [shell / "power.rs", shell / "power_window.rs", shell / "power_words.rs"]:
        body = uncommented(f.read_text())
        swept += 1
        for word in ("sudo", "pkexec", "pkttyagent", "systemd-run"):
            for i, line in enumerate(body.splitlines(), 1):
                if re.search(rf'"[^"]*\b{re.escape(word)}\b', line) and not line.lstrip().startswith("//"):
                    wrong.append(f"{f.name}:{i} spawns `{word}`")
    floor(swept, 6, "sources swept for a privileged call")
    if wrong:
        for w in wrong:
            print("ERROR: " + w, file=sys.stderr)
        sys.exit(1)
    print("OK: the power crate asks nothing of anybody — every logind call is non-interactive")
    END
  '';

  # AND EVERY NOTIFICATION OF THE DISTRO EXISTS IN BOTH LANGUAGES.
  #
  # The owner asked for it in those words. It does not depend on discipline: the
  # generator emits the list of keys the table demands, and this compares that
  # list against the two `.ftl`s. Adding an entry to `assets/notifications.nix`
  # and forgetting its Portuguese fails here, with the key's name.
  notifications-have-text = mkCheck "notifications-have-text" [ pkgs.python3 ] ''
    python3 - <<'PY'
    import pathlib, re, sys
    exec(open("${pyPrelude}").read())

    # FILE-WIDE: a generated list of keys against a catalogue of sentences.
    # PROSE: and the second half is about the WORDS — whether an action's
    # sentence begins in upper case, which is how a button is written. That is
    # a question about the value and not about any code.
    keys = pathlib.Path("${notificationsRs}/keys.txt").read_text().split()
    floor(len(keys), 20, "keys the catalogue requires")
    failed = False
    for language in ${builtins.toJSON languages}:
        ftl = pathlib.Path("${../assets/i18n}/" + language + ".ftl").read_text()
        have = set(re.findall(r"^([a-z][a-z0-9-]*) *=", ftl, re.M))
        missing = [k for k in keys if k not in have]
        if missing:
            print(f"ERROR: {language} does not have: {', '.join(missing)}")
            failed = True
        else:
            print(f"ok  {language}: the catalogue's {len(keys)} keys are there")

        # AND AN ACTION READS AS A BUTTON, which starts with a capital.
        #
        # The owner read the screen: every action on a card began in lower
        # case, so a thing one PRESSES was punctuated like the tail of the
        # sentence above it. Nine were fixed by hand; this is what says the
        # tenth cannot arrive in lower case — the label is written in the
        # `.ftl`, so the `.ftl` is where it can be checked.
        #
        # A foreign application's label is NOT touched anywhere, here or in
        # the drawing: we do not know what it says, and capitalising somebody
        # else's first letter turns `gtk-update` into `Gtk-update`.
        for line in ftl.splitlines():
            m = re.match(r"^(notif-action-[a-z0-9-]+) *= *(\S)", line)
            if m and m.group(2).islower():
                print(f"ERROR: {language}: `{m.group(1)}` begins in lower case: {line}")
                failed = True

    if failed:
        print("")
        print("       Every notification and every filter of the distro has to exist")
        print("       in both languages (invariant 8). The list comes out of")
        print("       assets/notifications.nix itself — there is no forgetting without failing.")
        print("       And every action of theirs is a button, so it is written like one.")
        sys.exit(1)
    print("OK: the notification catalogue speaks both languages, and its actions read as buttons")
    PY
  '';

  # AND A BLUETOOTH SERVICE ID SAYS WHAT IT IS.
  #
  # # What the screen looked like without this
  #
  # The owner opened their keyboard's page and read five rows of
  # `00001812-0000-1000-8000-00805f9b34fb`. The table that names a service was
  # a `match` written by hand, it knew fifteen ids, and it knew the CLASSIC
  # profiles — not the GATT ones. A BLE keyboard announces `1812` and never
  # `1124`, so the one row that mattered was the one drawn raw.
  #
  # # Why it reads a generated list and not the `.ftl`
  #
  # Because the demand has to come from the DECLARATION. A hand-written list
  # here would go stale the day somebody added a service, and the failure would
  # be `[bluetooth-profile-…]` on a screen nobody audits — the exact shape of
  # defect `notifications-have-text` was written to remove, one file later.
  #
