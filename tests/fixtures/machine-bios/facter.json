{
  "version": 2,
  "system": "x86_64-linux",
  "virtualisation": "none",
  "uefi": {
    "supported": false
  },
  "hardware": {
    "cpu": [
      {
        "vendor_name": "AuthenticAMD",
        "family": 25,
        "model": 33,
        "features": [
          "fpu",
          "svm",
          "aes",
          "avx2"
        ]
      }
    ],
    "graphics_card": [
      {
        "driver_modules": [
          "amdgpu"
        ],
        "bus_type": {
          "name": "PCI"
        }
      }
    ],
    "monitor": [
      {
        "model": "probe monitor"
      }
    ],
    "network_controller": [
      {
        "driver_modules": [
          "r8169"
        ],
        "bus_type": {
          "name": "PCI"
        }
      }
    ],
    "network_interface": [
      {
        "sub_class": {
          "name": "Ethernet"
        },
        "unix_device_names": [
          "enp3s0"
        ]
      }
    ],
    "storage_controller": [
      {
        "driver_modules": [
          "ahci"
        ],
        "bus_type": {
          "name": "PCI"
        }
      }
    ],
    "disk": [
      {
        "driver_modules": [
          "ahci",
          "sd_mod"
        ]
      }
    ],
    "usb_controller": [
      {
        "driver_modules": [
          "xhci_pci",
          "ehci_pci"
        ],
        "bus_type": {
          "name": "PCI"
        }
      }
    ]
  }
}
